lif n in (138,140): bad['modes']['/var/log/audit/audit.log' if n==138 else '/var/log/audit']=0o777\n        elif n in (143,144):\n            if n==143: bad['modes']['/sbin/auditd']=0o777\n            else: bad['owners']['/sbin/auditd']=[0,1001]\n        else:\n            path=next(p for p in files if p not in ('/etc/login.defs','/proc/self/mountinfo','/usr/bin/test-privileged'))\n            bad['files'][path]='# test-only removed required configuration\\n'\n        result[str(900000+n)]={'positive':good,'negative':bad}\n    return result\n\n\ndef outputs():\n    result={}\n    for n,items in rules().items():\n        target=items[0][0];ok='ABSENT\\n' if n==92 else 'PASS\\n'\n        cases={'positive':{target:dict(stdout=ok,exit_code=0)},\n               'negative':{target:dict(stdout='INSTALLED\\n' if n==92 else '',exit_code=0)},\n               'missing':{},'empty':{target:dict(stdout='',exit_code=0)},\n               'error':{target:dict(error='test-only permission/command error')},\n               'nonzero_matching':{target:dict(stdout=ok,exit_code=2)}}\n        if n in AUDIT | {158,161,173,145}: cases['commented']={target:dict(stdout='',exit_code=0)}\n        if n in (92,96,99,100): cases['rpm_other_error']={target:dict(stdout='',exit_code=2)}\n        result[str(900000+n)]=cases\n    return result\n\n\ndef main():\n    path=ROOT/'tests/fixtures/p2b3/cases.json'\n    path.write_text(json.dumps(dict(label='SYNTHETIC TEST ONLY',inputs=inputs(),checks=outputs()),ensure_ascii=False,indent=2)+'\\n')\n\nif __name__=='__main__': main()\n\"\"\"python3 -m linuxgcb：完全離線，不執行 SCA 命令。\"\"\"\nimport argparse\nimport json\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom .catalog import write_registry\nfrom .policy import build, validate\nfrom .report import render\nfrom .collector import timestamp\nfrom .snapshot import convert\n\n\ndef main():\n    parser = argparse.ArgumentParser(description='LinuxGCB 離線工具（未完成真機驗收）')\n    sub = parser.add_subparsers(dest='command', required=True)\n    sub.add_parser('build', help='驗證來源並重建 registry 與候選政策')\n    sub.add_parser('validate', help='離線結構與來源檢查，非引擎驗收')\n    report = sub.add_parser('report', help='匯入離線 JSON，輸出 HTML/CSV 與稽核副本')\n    report.add_argument('snapshot')\n    report.add_argument('--out', required=True)\n    report.add_argument('--now', help='固定報表時間，ISO8601 含時區')\n    snapshot = sub.add_parser('snapshot', help='離線 Manager DB JSON 轉 snapshot v1')\n    snapshot.add_argument('manager_dump')\n    snapshot.add_argument('--out', required=True)\n    snapshot.add_argument('--scan-info', help='同次離線 sca_scan_info JSON，依 policy_id 對應 end_scan')\n    args = parser.parse_args()\n    if args.command == 'build':\n        rows = write_registry()\n        build()\n        print(f'314 項；307 候選／7 排除；{validate()} 項候選規則，UNVALIDATED／人工審查待完成')\n    elif args.command == 'validate':\n        print('UNVALIDATED：離線結構檢查通過，候選控制項數', validate())\n    elif args.command == 'snapshot':\n        validate()\n        result = convert(args.manager_dump, json.loads(Path(args.scan_info).read_text()) if args.scan_info else None)\n        target = Path(args.out)\n        target.parent.mkdir(parents=True, exist_ok=True)\n        target.write_text(json.dumps(result, ensure_ascii=False, indent=2)+'\\n')\n        print(json.dumps(result['warnings'], ensure_ascii=False))\n    else:\n        validate()\n        result = render(json.loads(Path(args.snapshot).read_text()), args.out,\n                        timestamp(args.now) if args.now else datetime.now(timezone.utc))\n        print(json.dumps(result, ensure_ascii=False, indent=2))\n\nif __name__ == '__main__':\n    main()\n                self.assertIn('UNVALIDATED',row['caveats'])\n\n    def test_all_49_fixture_output_matrix(self):\n        self.assertEqual(self.data['label'],'SYNTHETIC TEST ONLY')\n        self.assertEqual(self.data['inputs'],inputs());self.assertEqual(self.data['checks'],outputs())\n        for n in sorted(ADDED):\n            check=self.checks[900000+n];cases=self.data['checks'][str(900000+n)]\n            for case,obs in cases.items():\n                want='PASS' if case in ('positive','nonzero_matching') else 'UNRESOLVED' if case in ('missing','error') else 'FAIL'\n                with self.subTest(n=n,case=case): self.assertEqual(simulate(check,obs),want)\n            # All programs emit at most one result. 256-line truncation cannot hide a bad member.\n            for obs in cases['positive'].values(): self.assertLessEqual(len(obs['stdout'].splitlines()),1)\n            for rule in check['rules']: parse_rule(rule)\n\n    def test_real_parsers_positive_negative_missing_empty_error(self):\n        for n in sorted(ADDED-{92}):\n            cases=self.data['inputs'][str(900000+n)]\n            for name,want in (('positive','PASS\\n'),('negative','')):\n                with self.subTest(n=n,case=name): self.assertEqual(self.run_tree(n,cases[name]),want)\n            for name in ('missing','empty','error'):\n                data=self.tree(n)\n                if name=='missing': data['files']={};data['modes']={};data['commands']={}\n                elif name=='empty': data['files']={p:'' for p in data['files']};data['commands']={}\n                else: data['commands']={'rpm':2,'systemctl_error':1}\n                # Metadata-only checks need an explicit stat error, rather than empty file data.\n                if n in (143,144) and name in ('empty','error'): data['files']={};data['modes']={}\n                with self.subTest(n=n,case=name): self.assertEqual(self.run_tree(n,data,fail_read=name=='error' and n not in (95,96,99,100,143,144)), '')\n\n    def test_every_audit_predicate_comments_tokens_boundaries_uid_min(self):\n        for n in sorted(AUDIT):\n            data=self.tree(n);path='/etc/audit/rules.d/audit.rules';lines=audit_lines(n)\n            self.assertTrue(lines)\n            for line in lines:\n                for changed in ('# '+line, line+'-suffix',line.replace('-k ', '-k WRONG-',1).replace('key=execpriv','key=WRONG')):\n                    variant=copy.deepcopy(data);variant['files'][path]=variant['files'][path].replace(line+'\\n',changed+'\\n')\n                    with self.subTest(n=n,line=line,changed=changed): self.assertEqual(self.run_tree(n,variant),'')\n            if 'auid>=1000' in data['files'][path]:\n                data['files']['/etc/login.defs']='UID_MIN 500\\n# UID_MIN 1000\\nUID_MIN 2000\\n'\n                self.assertEqual(self.run_tree(n,data),'')\n                data['files'][path]=data['files'][path].replace('auid>=1000','auid>=2000')\n                self.assertEqual(self.run_tree(n,data),'PASS\\n')\n        data=self.tree(148);data['files']['/etc/audit/rules.d/audit.rules']='-w /etc/sudoers.d/ -p wa -k scope\\n'\n        self.assertEqual(self.run_tree(148,data),'')\n        # A missing rule beyond 256 lines must still cause failure; required late rules still count.\n        for n in (148,154,172):\n            data=self.tree(n);path='/etc/audit/rules.d/audit.rules';data['files'][path]='# padding\\n'*600+data['files'][path]\n            self.assertEqual(self.run_tree(n,data),'PASS\\n')\n            data['files'][path]+='\\n# unrelated trailing content'\n            data['files'][path]=data['files'][path].replace(audit_lines(n)[-1],'# removed')\n            self.assertEqual(self.run_tree(n,data),'')\n\n\"\"\"固定來源、候選範圍與保守分類。\"\"\"\nimport hashlib\nimport json\nfrom pathlib import Path\nfrom scripts.inventory import extract\nfrom .batch1 import ADDED\nfrom .quality import status\nfrom .batch3 import ADDED as BATCH3\nfrom .batch2 import ADDED as BATCH2\n\nROOT = Path(__file__).resolve().parents[1]\nXLSX_HASH = '7d752b639a1e780df08814c6252efadd3ea2711eaa5c9d91c070b84a296c0247'\nDOCX_HASH = '986effd9501b1fd97776129c6691cf8fc98246bd04514347322f3337508e0e5b'\nIMPLEMENTED = {45: 'base', 46: 'base', 108: 'base', 243: 'firewalld',\n               245: 'firewalld', 269: 'sshd', 270: 'sshd'}\nIMPLEMENTED.update({n: ('sshd' if n in (256,257) else 'firewalld' if n==242 else 'base') for n in ADDED})\nIMPLEMENTED.update({n: ('sshd' if n >= 254 else 'base') for n in BATCH2})\nIMPLEMENTED.update({n: 'base' for n in BATCH3})\nPARTIAL = {141: '僅來源設定方法明列 audit.rules；其餘 rules.d 規則檔集合尚未覆蓋',\n           108: '僅雙協定即時值；持久設定來源、覆寫順序與路由角色待審',\n           269: '僅 sshd -T 預設情境；Include/Match 與使用者/來源矩陣待審',\n           270: '僅 sshd -T 預設情境；Include/Match 與使用者/來源矩陣待審'}\n\n\ndef digest(path):\n    return hashlib.sha256(path.read_bytes()).hexdigest()\n\n\ndef registry():\n    source = next(ROOT.glob('*.xlsx'))\n    docx = next(ROOT.glob('*.docx'))\n    if digest(source) != XLSX_HASH or digest(docx) != DOCX_HASH:\n        raise ValueError('來源 hash 改變，停止產生')\n    records = extract(source)\n    result = []\n    for r in records:\n        n = int(r['gcb_id'][-4:])\n        included = r['sheet'] != 'Nftables防火牆'\n        profile = ('firewalld' if r['sheet'] == 'Firewalld防火牆' else\n                   'sshd' if r['sheet'] == 'SSH伺服器' else 'base')\n        if n in IMPLEMENTED:\n            classification, why = 'native_sca', '候選唯讀原生命令；完整語意與引擎驗收待人工審查'\n        elif profile != 'base' or any(k in r['title'] for k in ('GUI', '無線', '可攜', 'NFS')):\n            classification, why = 'conditional', '須先確認角色、服務與適用性，再選擇實作方式'\n        elif any(k in r['title'] for k in ('權限', '所有權', '擁有', '稽核', '密碼', '通行碼')):\n            classification, why = 'readonly_helper', '可能涉及集合、位元或載入鏈解析；尚未實作 helper'\n        else:\n            classification, why = 'manual_review', '尚未逐條語意審查，保守列人工待辦，非不可自動化結論'\n        result.append(dict(gcb_id=r['gcb_id'], source_file=r['source_file'],\n            source_sheet=r['sheet'], source_row=r['row'], source_sha256=XLSX_HASH,\ntests/test_snapshot.py:11:from linuxgcb.snapshot import convert, LABEL\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"cat linuxgcb/batch3.py; cat tests/test_fix3.py; sed -n '1,100p' tests/test_p2b3.py; sed -n '125,155p' linuxgcb/p2b3_runtime.py; cat docs/FIX3_REVIEW.md; ls docs; rg --files -g AGENTS.md /home/skycity1010/projects /home/skycity1010/.codex 2>/dev/null\"","aggregated_output":"\"\"\"P2B3: 49 offline, source-bound read-only candidates.\n\nPython runtime is embedded in -c (RHEL9 python3), never imported on the\nendpoint or executed by build. Every command commits exactly one PASS line only\nafter all reads and predicates finish, avoiding the engine's 256-line boundary.\n\"\"\"\nfrom functools import lru_cache\nimport inspect\nimport json\nimport re\nimport shlex\nfrom pathlib import Path\nfrom .argv import quote_argument\nfrom . import p2b3_runtime as runtime\n\nADDED = set(range(134,141)) | set(range(143,174)) | {176,177,181,182,308,92,93,95,96,99,100}\nPACKAGES = {92:'xinetd',96:'net-snmp',99:'vsftpd',100:'ypserv'}\nAUDIT = set(range(148,173)) - {158,161}\n\n\n@lru_cache(maxsize=1)\ndef sources():\n    return {int(r['gcb_id'][-4:]):r for r in json.loads((Path(__file__).resolve().parents[1]/'data/controls.json').read_text()) if int(r['gcb_id'][-4:]) in ADDED}\n\n\ndef audit_lines(n):\n    lines = [line.strip() for line in sources()[n]['configuration_method'].splitlines()\n             if line.startswith(('-a ', '-w ')) and '(' not in line]\n    # Source typo joins two -S flags; preserve intended five syscall semantics.\n    return [line.replace('renameat-S', 'renameat -S') for line in lines]\n\n\nDEPS = {\n    'active':[], 'setting':['active'], 'metadata':[], 'read':[], 'files':[],\n    'audit_matches':['active','read'], 'uid_min':['active','read'],\n    'audit_rules':['uid_min','audit_matches'], 'log_metadata':['setting','read','metadata'],\n    'service':[], 'package_state':[], 'optional_service':['package_state','service','active','read'],\n    'rsyslog_text':['read','files'], 'rsyslog_mode':['rsyslog_text','active'],\n    'rsyslog_rules':['rsyslog_text','active'], 'journal':['files','read','setting'],\n    'grub':['active','read'], 'sudo_log':['files','read','active','audit_matches'],\n    'privileged':['read','uid_min','audit_matches'], 'immutable':['files','active','read'],\n    'logrotate':['active','read','metadata'],\n}\n\n\ndef spec(n):\n    if n in AUDIT:\n        return ['audit_rules'], 'audit_rules('+repr(audit_lines(n))+')'\n    if n == 92:\n        return [], ''\n    if n == 93:\n        return ['active','read'], \"any(re.fullmatch(r'(server|pool)\\\\s+[^\\\\s#()]+(?:\\\\s+[^#]+)?', line) for line in active(read('/etc/chrony.conf')))\"\n    if n == 95:\n        return ['service'], \"service('avahi-daemon.service') and service('avahi-daemon.socket')\"\n    if n in (96,99,100):\n        return ['optional_service'], 'optional_service('+repr(PACKAGES[n])+', '+repr({96:'snmpd',99:'vsftpd',100:'ypserv'}[n]+'.service')+', '+repr(n==96)+')'\n    if n in (134,135):\n        return ['grub'], 'grub('+repr('audit' if n==134 else 'audit_backlog_limit')+', '+str(1 if n==134 else 8192)+')'\n    if n == 136:\n        return ['active','read'], \"(lambda lines: bool(lines) and re.fullmatch(r'postmaster:\\\\s*root', lines[-1]) is not None)([line for line in active(read('/etc/aliases')) if re.match(r'postmaster:', line)])\"\n    if n in (137,138,139,140):\n        return ['log_metadata'], 'log_metadata('+{137:'None',138:'0o600',139:'None',140:'0o700'}[n]+', '+repr(n in (139,140))+')'\n    if n in (143,144):\n        paths=['/sbin/'+name for name in ('auditctl','aureport','ausearch','autrace','auditd','audisp-remote','audisp-syslog','augenrules','rsyslogd')]\n        return ['metadata'], 'all(metadata(path, '+('0o750' if n==143 else 'None')+') for path in '+repr(paths)+')'\n    if n == 145:\n        paths=['/usr/sbin/'+name for name in ('auditctl','auditd','ausearch','aureport','autrace','audisp-remote','audisp-syslog','augenrules')]\n        return ['audit_matches'], \"audit_matches('/etc/aide.conf', [path + ' p+i+n+u+g+s+b+acl+xattrs+sha512' for path in \"+repr(paths)+'])'\n    if n in (146,147):\n        key='max_log_file' if n==146 else 'max_log_file_action'\n        expr=\"setting(read('/etc/audit/auditd.conf'), \"+repr(key)+')'\n        return ['setting','read'], ('(lambda v: v is not None and v.isdigit() and int(v) >= 32)('+expr+')' if n==146 else expr+\" == 'keep_logs'\")\n    name={158:'privileged',161:'sudo_log',173:'immutable',176:'rsyslog_mode',177:'rsyslog_rules',308:'logrotate'}.get(n)\n    if name:\n        return [name], name+'()'\n    if n in (181,182):\n        return ['journal'], \"journal('Compress', 'yes')\" if n==181 else \"journal('Storage', 'persistent')\"\n    raise ValueError(n)\n\n\n@lru_cache(maxsize=None)\ndef script(n):\n    functions, expr = spec(n)\n    used=[]\n    def add(name):\n        for dep in DEPS[name]: add(dep)\n        if name not in used: used.append(name)\n    for name in functions: add(name)\n    return (\"import glob, os, re, stat, subprocess\\nROOT = ''\\n\"+\n            '\\n'.join(inspect.getsource(getattr(runtime,name)) for name in used)+\n            '\\ntry:\\n    ok = '+expr+\"\\nexcept (OSError, ValueError, IndexError, KeyError):\\n    ok = False\\nif ok:\\n    print('PASS')\\n\")\n\n\n@lru_cache(maxsize=1)\ndef rules():\n    result={}\n    for n in sorted(ADDED):\n        if n == 92:\n            body='out=$(rpm -q xinetd 2>/dev/null); rc=$?; case $rc in 0) echo INSTALLED;; 1) echo ABSENT;; *) exit $rc;; esac'\n            result[n]=[('c:/bin/sh -c '+quote_argument(body), '^ABSENT$')]\n        else:\n            command='/usr/bin/python3 -c '+shlex.quote(script(n))\n            result[n]=[('c:/bin/sh -c '+quote_argument(command), '^PASS$')]\n    return result\n\n\ndef mechanism(n):\n    if n in AUDIT: return '持久 audit.rules 全行正則，逐條 all；UID_MIN 取最後有效值'\n    return {92:'定向 rpm -q 三態',93:'chrony 有效 server/pool',95:'FIX-1 systemctl service/socket 停用',\n            96:'定向 RPM 三態／停用服務／明確 authPriv SNMPv3 子集',99:'定向 RPM 三態＋FIX-1 停用 vsftpd',100:'定向 RPM 三態＋FIX-1 停用 ypserv',\n            134:'GRUB audit 開機參數',135:'GRUB backlog 數值下界',136:'aliases postmaster root',\n            137:'有效 log_file 檔案 owner',138:'有效 log_file 檔案 mode 位元遮罩',139:'有效 log_file 目錄 owner/type',140:'有效 log_file 目錄 mode/type',\n            143:'九個來源工具 mode 位元遮罩',144:'九個來源工具 UID/GID',145:'八個 AIDE 工具完整屬性正則',\n            146:'auditd.conf 最後有效值 >=32',147:'auditd.conf 最後有效值 keep_logs',158:'所有實體掛載點 xdev 特權程式逐一對 privileged.rules',\n            161:'sudoers logfile 路徑逐一對 actions.rules',173:'持久規則最後有效 -e 2 與 loginuid immutable',\n            176:'rsyslog 舊式預設與新式 action fileCreateMode 位元遮罩',177:'rsyslog 三類 selector 與 secure 目的地',\n            181:'Journal Compress 最後有效值與排序 drop-in',182:'Journal Storage 最後有效值與排序 drop-in',308:'指定 rsyslog logrotate 完整 stanza 與日誌目錄權限'}[n]\n\n\ndef caveat(n):\n    common='P2B3 UNVALIDATED；human_review_pending；execution_review=blocked。唯讀內嵌 Python，需 RHEL9 /usr/bin/python3 標準函式庫；不安裝 helper。完成所有讀取才輸出單行 PASS，錯誤/缺失無成功輸出；w_strtok、PCRE2、timeout 待真機驗證。'\n    detail=''\n    if n in AUDIT: detail='依來源 audit.rules 的完整 token 順序逐條比對；等價重排或合併 syscall 可能保守失敗；不代表核心已載入。auid 門檻依 login.defs UID_MIN。'\n    if n==159: detail+='來源 renameat-S 排版錯誤解讀為 renameat -S，保留五個 syscall，待人工核准。'\n    if n in (134,135): detail='僅來源 /etc/default/grub；已產生開機項/執行中核心待真機確認。'\n    if n in (137,138,139,140): detail='使用最後有效 log_file，缺失不採範例路徑預設；跟隨 symlink；檔案本體與實際目錄，ACL/輪替檔待審。'\n    if n in (143,144): detail='來源明列九個工具皆須存在；缺失不自動 N/A；stat 跟隨 /sbin symlink；ACL 待審。'\n    if n==145: detail='逐工具要求來源完整屬性序列；AIDE macro/Include 與資料庫初始化待審。'\n    if n in (95,96,99,100): detail='FIX-1 明確 not-found 且 inactive 視為停用；disabled/masked 且 inactive 合格；systemctl 錯誤不合格。套件 ABSENT 仍須確認服務 inactive，避免移除套件後程序仍存活。多次查詢非原子。'\n    if n==96: detail+='來源允許 v3；自動候選限明確 rouser priv，禁 v1/v2 access/include；SHA/AES 金鑰建立與實際協商仍須人工證據，不讀取或輸出私密使用者金鑰。'\n    if n in (92,96,99,100): detail+='僅定向 rpm -q，0=INSTALLED、1=ABSENT、其他錯誤無成功輸出；不查 rpm -qa。'\n    if n==158: detail='列舉 mountinfo 實體檔案系統（排除 proc/sysfs 等虛擬介面），每掛載點 xdev 查所有 regular setuid/setgid；空集合為全稱真但 privileged.rules 仍須可讀。大型/網路檔案系統成本與競態待審。'\n    if n==161: detail='只辨識 /etc/sudoers 與 sudoers.d 的明確 Defaults logfile；不假定 /var/log/sudo.log；條件 Defaults、外部 include 與覆寫完整語意待人工審查。'\n    if n==173: detail='來源 -e 2--loginuid-immutable 排版解讀為兩條指令；自然數字排序規則檔，最後 -e 必須為 2 且最後有效行為鎖定指令；核心狀態待審。'\n    if n==176: detail='保守要求所有明確 $FileCreateMode 與 action fileCreateMode 均不超過 0640；未設定不假定預設合格；複雜模板/include 待審。'\n    if n==177: detail='接受來源逗號與分號 selector，舊式 secure 路徑與新式 omfile action；複雜多行 action/模板/ruleset 待審。'\n    if n in (181,182): detail='來源要求新增明確設定；未設定（即使 Compress 套件預設 yes）不判 PASS。解析 [Journal]、最後值與 /usr/lib、/usr/local/lib、/run、/etc drop-in 同名優先/字典順序與 /dev/null mask；執行中狀態待審。'\n    if n==308: detail='依來源 /etc/logrotate.d/rsyslog 指定路徑、weekly/rotate 4/compress/missingok/notifempty/postrotate 及目錄 <=0750；不是任意 rsyslog 字樣即合格；複雜多 stanza、實際輪替待審。'\n    return detail+common\n\n\ndef expected(row):\n    suffix=row.get('gcb_id', '')[-4:]\n    if not suffix.isdigit(): return None\n    n=int(suffix)\n    if n not in ADDED: return None\n    if n in AUDIT: return '；'.join(audit_lines(n))\n    return {92:'xinetd 未安裝',93:'至少一個有效 server 或 pool',95:'avahi-daemon.service/socket disabled/masked 且 inactive',\n            96:'SNMP 停用或僅 SNMPv3（SHA/AES 需人工證據）',99:'vsftpd disabled/masked 或明確 not-found，且 inactive；RPM 三態無錯誤',100:'ypserv disabled/masked 或明確 not-found，且 inactive；RPM 三態無錯誤',\n            134:'audit=1',135:'audit_backlog_limit>=8192',136:'postmaster: root',137:'稽核日誌 root:root',138:'稽核日誌 <=0600（位元子集合）',\n            139:'稽核日誌目錄 root:root',140:'稽核日誌目錄 <=0700（位元子集合）',143:'九個稽核工具 <=0750（位元子集合）',144:'九個稽核工具 root:root',\n            145:'八個稽核工具 p+i+n+u+g+s+b+acl+xattrs+sha512',146:'max_log_file>=32',147:'max_log_file_action=keep_logs',\n            158:'每個磁區所有特權程式都有 privileged.rules 執行稽核',161:'sudo 實際 logfile 有 actions.rules wa/actions 稽核',\n            173:'-e 2；--loginuid-immutable',176:'$FileCreateMode/action fileCreateMode <=0640（位元子集合）',177:'auth.*、authpriv.*、daemon.* → /var/log/secure',\n            181:'[Journal] Compress=yes（明確設定）',182:'[Journal] Storage=persistent',308:'指定 rsyslog logrotate weekly/rotate 4/compress/missingok/notifempty/postrotate；目錄 <=0750'}[n]\n\"\"\"Offline FIX3 regressions; execute only synthetic shell builtins.\"\"\"\nimport json\nimport shlex\nimport subprocess\nimport unittest\nfrom unittest.mock import patch\n\nfrom linuxgcb.argv import w_strtok\nfrom linuxgcb.batch2 import ABSENT_PACKAGES, MARKER, guarded\nfrom linuxgcb.catalog import ROOT, digest\nfrom linuxgcb.policy import parse_rule, simulate\n\nCHANGED = {900000+n for n in ABSENT_PACKAGES} | {900205}\n\n\nclass Fix3Tests(unittest.TestCase):\n    @classmethod\n    def setUpClass(cls):\n        cls.checks = {c['id']: c for p in (ROOT/'policies').glob('*.yml')\n                      for c in json.loads(p.read_text())['checks']}\n        cls.before = json.loads((ROOT/'tests/fixtures/fix3_baseline.json').read_text())\n\n    def test_exact_seven_rules_changed_and_ninety_checks_untouched(self):\n        before = {c['id']: c for c in self.before['checks']}\n        self.assertEqual(len(before), 97)\n        self.assertTrue(before.keys() <= self.checks.keys())\n        self.assertEqual({n for n in before if before[n]['rules'] != self.checks[n]['rules']}, CHANGED)\n        for n, check in before.items():\n            actual = dict(self.checks[n])\n            if n in CHANGED:\n                actual['rules'] = check['rules']\n            self.assertEqual(actual, check)\n        for name, sha in self.before['protected_hashes'].items():\n            self.assertEqual(digest(ROOT/name), sha, name)\n\n    def test_engine_output_boundary_and_old_marker_failure(self):\n        # Same guard as FIX2, with an allowlisted unaffected package predicate.\n        old = next(c for c in self.before['checks'] if c['id'] == 900188)\n        target = parse_rule(old['rules'][0])[0]\n        for count, want in ((255, 'PASS'), (256, 'FAIL'), (500, 'FAIL')):\n            output = '\\n'.join(['bash']*count+[MARKER])\n            self.assertEqual(simulate(old, {target:dict(stdout=output)}), want)\n        # Historical rules are test-only allowlisted to exercise the real matcher.\n        historical = [c for c in self.before['checks'] if c['id'] in CHANGED-{900205}]\n        with patch('linuxgcb.policy.batch2_emitted', return_value={r for c in historical for r in c['rules']}):\n            for check in historical:\n                target = parse_rule(check['rules'][0])[0]\n                self.assertEqual(simulate(check, {target:dict(stdout='bash\\n'*500+MARKER)}), 'FAIL')\n        for n in ABSENT_PACKAGES:\n            check = self.checks[900000+n]\n            self.assertEqual(len(check['rules']), 1)\n            target, _ = parse_rule(check['rules'][0])\n            self.assertEqual(simulate(check, {target:dict(stdout='ABSENT\\n')}), 'PASS')\n        # Negated predicates also see only the first 256 lines.\n        target = parse_rule(old['rules'][0])[0]\n        self.assertEqual(simulate(old, {target:dict(stdout=MARKER+'\\n'+'bash\\n'*255+'setroubleshoot')}), 'PASS')\n\n    def test_each_package_tristate_and_argv_without_running_rpm(self):\n        for n, package in ABSENT_PACKAGES.items():\n            check = self.checks[900000+n]\n            target, _ = parse_rule(check['rules'][0])\n            argv = w_strtok(target[2:])\n            self.assertEqual(argv[:2], ['/bin/sh', '-c'])\n            self.assertEqual(len(argv), 3)\n            prefix = 'out=$(rpm -q '+package+' 2>/dev/null)'\n            self.assertTrue(argv[2].startswith(prefix))\n            for rc in (0, 1, 2, 3, 126, 127):\n                # Malicious-looking matching data must never escape buffering.\n                fake = 'printf %s '+shlex.quote('ABSENT\\n'+MARKER+'\\n'*500)+'; exit '+str(rc)\n                script = 'out=$('+fake+')'+argv[2][len(prefix):]\n                result = subprocess.run(['/bin/sh','-c',script], capture_output=True, text=True, timeout=5)\n                expected = 'INSTALLED\\n' if rc == 0 else 'ABSENT\\n' if rc == 1 else ''\n                self.assertEqual(result.stdout, expected)\n                self.assertEqual(result.returncode, 0 if rc in (0,1) else rc)\n                self.assertEqual(simulate(check, {target:dict(stdout=result.stdout)}), 'PASS' if rc == 1 else 'FAIL')\n\n    def test_cron_legacy_and_action_and_rejections(self):\n        check = self.checks[900205]\n        target, _ = parse_rule(check['rules'][0])\n        for line in ('cron.* /var/log/cron', 'cron.* action(type=\"omfile\" file=\"/var/log/cron\")',\n                     '\\tcron.*\\taction(type=\"omfile\"\\tfile=\"/var/log/cron\") '):\n            self.assertEqual(simulate(check, {target:dict(stdout=line+'\\n'+MARKER)}), 'PASS', line)\n        for line in ('#cron.* /var/log/cron', 'cron.none /var/log/cron',\n                     'cron.* action(type=\"omfwd\" file=\"/var/log/cron\")',\n                     'cron.* action(type=\"omfile\" file=\"/var/log/other\")',\n                     'cron.* action(type=\"omfile\" file=\"/var/log/cron\")junk'):\n            self.assertEqual(simulate(check, {target:dict(stdout=line+'\\n'+MARKER)}), 'FAIL', line)\n        self.assertEqual(simulate(check, {target:dict(stdout='cron.* /var/log/cron')}), 'FAIL')\n\"\"\"P2B3 test-only trees. Never execute endpoint commands or read host configs.\"\"\"\nimport contextlib\nimport copy\nimport io\nimport json\nimport os\nfrom pathlib import Path\nimport shlex\nimport stat\nimport subprocess\nimport sys\nimport tempfile\nimport unittest\nfrom unittest.mock import patch\n\nfrom linuxgcb.argv import w_strtok\nfrom linuxgcb.batch3 import ADDED, AUDIT, PACKAGES, audit_lines, rules, script\nfrom linuxgcb.catalog import ROOT, digest, registry\nfrom linuxgcb.policy import parse_rule, simulate, validate\nfrom scripts.p2b3_fixtures import inputs, outputs\n\n\nclass P2B3Tests(unittest.TestCase):\n    @classmethod\n    def setUpClass(cls):\n        cls.data=json.loads((ROOT/'tests/fixtures/p2b3/cases.json').read_text())\n        cls.checks={c['id']:c for p in (ROOT/'policies').glob('*.yml') for c in json.loads(p.read_text())['checks']}\n\n    def tree(self,n): return copy.deepcopy(self.data['inputs'][str(900000+n)]['positive'])\n\n    def run_tree(self,n,data,fail_read=False):\n        \"\"\"Execute actual embedded script against temp files and mocked systemctl/RPM.\n\n        stat uid/gid are test data because this test must not chown or use sudo.\n        All paths inside the emitted program are redirected to the test-only tree.\n        \"\"\"\n        self.assertNotEqual(n,92)\n        with tempfile.TemporaryDirectory(prefix='p2b3-test-only-', dir=ROOT) as folder:\n            for name,content in data['files'].items():\n                path=Path(folder+name);path.parent.mkdir(parents=True,exist_ok=True);path.write_text(content)\n            for name,mode in data['modes'].items():\n                path=Path(folder+name)\n                if not path.exists(): path.mkdir(parents=True)\n                if path.is_file(): path.chmod(mode)\n            real_stat=os.stat\n            def fake_stat(path,*args,**kwargs):\n                info=real_stat(path,*args,**kwargs)\n                name=os.fspath(path)\n                owner=data['owners'].get(name[len(folder):]) if isinstance(name,str) and name.startswith(folder) else None\n                fields=list(info)\n                if owner: fields[4:6]=owner\n                relative=name[len(folder):] if isinstance(name,str) and name.startswith(folder) else None\n                if relative in data['modes']: fields[0]=stat.S_IFMT(info.st_mode) | data['modes'][relative]\n                return os.stat_result(fields)\n            def fake_command(argv,**kwargs):\n                cmd=data['commands']\n                if argv[0]=='/bin/sh' and 'rpm -q ' in argv[2]:\n                    rc=cmd.get('rpm',127)\n                    return subprocess.CompletedProcess(argv,0 if rc in (0,1) else rc,\n                                                       'INSTALLED\\n' if rc==0 else 'ABSENT\\n' if rc==1 else '', '')\n                self.assertEqual(argv[:2],['/usr/bin/systemctl','show'])\n                self.assertTrue(argv[2].endswith(('.service','.socket')))\n                self.assertTrue(all(x.startswith('--property=') for x in argv[3:]))\n                cmd={**cmd, **cmd.get('units',{}).get(argv[2],{})}\n                return subprocess.CompletedProcess(argv,cmd.get('systemctl_error',0),\n                    'LoadState='+cmd.get('load','')+'\\nActiveState='+cmd.get('active','')+'\\nUnitFileState='+cmd.get('unit','')+'\\n','')\n            program=script(n).replace(\"ROOT = ''\",'ROOT = '+repr(folder),1)\n            # Check the exact shell and Python argument round trip before execution.\n            argv=w_strtok(rules()[n][0][0][2:]);self.assertEqual(argv[:2],['/bin/sh','-c'])\n            self.assertEqual(shlex.split(argv[2]),['/usr/bin/python3','-c',script(n)])\n            capture=io.StringIO()\n            with patch('os.stat',side_effect=fake_stat),patch('subprocess.run',side_effect=fake_command),contextlib.redirect_stdout(capture):\n                if fail_read:\n                    with patch('builtins.open',side_effect=PermissionError('test-only denied')): exec(compile(program,'<test-only emitted script>','exec'),{})\n                else: exec(compile(program,'<test-only emitted script>','exec'),{})\n            return capture.getvalue()\n\n    def test_scope_baseline_sources_and_status(self):\n        before=json.loads((ROOT/'tests/fixtures/p2b3/baseline.json').read_text())\n        self.assertEqual(len(before['checks']),97)\n        for c in before['checks']: self.assertEqual(self.checks[c['id']],c)\n        for name,sha in before['protected_hashes'].items(): self.assertEqual(digest(ROOT/name),sha,name)\n        self.assertEqual(len(ADDED),49);self.assertEqual(len(self.checks),146);self.assertEqual(validate(),146)\n        rows=registry();self.assertEqual((len(rows),sum(r['included'] for r in rows)),(314,307))\n        self.assertEqual({r['sca_id'] for r in rows if r['implementation']=='candidate'}-{c['id'] for c in before['checks']},{900000+n for n in ADDED})\n        for row in rows:\n            if row['sca_id']-900000 in ADDED:\n                self.assertEqual(row['review_status'],'human_review_pending')\n                self.assertEqual(row['execution_review'],'blocked');self.assertEqual(row['live_validation'],'UNVALIDATED')\n        manifest=json.loads((ROOT/'data/coverage_manifest.json').read_text())\n        self.assertEqual(manifest['counts']['implemented'],146)\n        for row in manifest['reviewed']:\n            if row['sca_id']-900000 in ADDED:\n                self.assertIn('tests/test_p2b3.py',row['tests'])\n                self.assertIn('UNVALIDATED',row['caveats'])\n\n    def test_all_49_fixture_output_matrix(self):\n        self.assertEqual(self.data['label'],'SYNTHETIC TEST ONLY')\n        self.assertEqual(self.data['inputs'],inputs());self.assertEqual(self.data['checks'],outputs())\n        for n in sorted(ADDED):\n    return bool(users) and all(re.fullmatch(r'rouser\\s+\\S+\\s+priv(?:\\s+\\S+)?', line,\n                                          re.I) for line in users)\n\n\ndef rsyslog_text():\n    return '\\n'.join(read(path) for path in ['/etc/rsyslog.conf'] + files('/etc/rsyslog.d/*.conf'))\n\n\ndef rsyslog_mode():\n    text = '\\n'.join(active(rsyslog_text()))\n    declarations = [line for line in text.splitlines() if re.match(r'^\\$FileCreateMode(?:\\s|$)', line)]\n    if any(not re.fullmatch(r'\\$FileCreateMode\\s+0?[0-7]{3}\\s*', line) for line in declarations):\n        return False\n    modes = [line.split()[1] for line in declarations]\n    overrides = re.findall(r'fileCreateMode\\s*=\\s*\"([^\"]*)\"', text, re.I)\n    return (bool(modes or overrides) and\n            all(re.fullmatch(r'0?[0-7]{3}', value) and int(value, 8) & ~0o640 == 0\n                for value in modes + overrides))\n\n\ndef rsyslog_rules():\n    lines = active(rsyslog_text())\n    # Accept source comma notation and conventional semicolon selector separators.\n    for facility in ('auth', 'authpriv', 'daemon'):\n        selector = r'(?:auth|authpriv|daemon)\\.\\*'\n        selectors = selector + r'(?:\\s*[,;]\\s*' + selector + r')*'\n        destination = r'(?:-?/var/log/secure|action\\(\\s*type=\"omfile\"\\s+file=\"/var/log/secure\"\\s*\\))'\n        if not any(re.fullmatch(selectors + r'\\s+' + destination, line) and\n                   re.search(r'(?:^|[,;])\\s*' + facility + r'\\.\\*(?:\\s*[,;]|\\s+)', line)\n                   for line in lines):\n            return False\n# FIX3 離線審查（2026-10-31）\n\n## R6 真機證據摘要\n\n依任務提供的 R6 證據：FIX-2 後 97 條全執行，22 項新 FAIL 中有 15 項真實缺失、7 項假陰性。本次未連線真機、未新增或改寫真機證據。\n\n900102/103/104/105/106/900189 使用 rpm -qa 全量清單；RHEL9 約 500 套件。wm_sca.c:1749 的 OS_StrBreak('\\n', out, 256) 只保留前 256 行，末尾 LINUXGCB_COMMAND_OK 被截斷，成功標記規則 FAIL，導致整條 FAIL。\n\n900205 的真機設定為 `cron.* action(type=\"omfile\" file=\"/var/log/cron\")`，舊正則只接受 `cron.* /var/log/cron`。\n\n15 項真實缺失 900187/188/203/204/258/263/265/266/272/273/275/276/277/280/315 規則完全不變，包含仍採全量查詢的 900188；本次沒有放寬或宣稱修復這些缺失。\n\n## 修正語意\n\n六條套件規則定向查詢，rpm 回 0 只輸出 INSTALLED；回 1 只輸出 ABSENT；其他退出碼保留且不發布 stdout。只接受 ^ABSENT$，不以空輸出或錯誤推論合格。外層沿用 FIX-2 quote_argument 與 w_strtok 三個 argv 契約，腳本無未跳脫的內層雙引號。\n\n900205 同時接受兩種指定語法，仍要求成功讀取來源設定與成功標記；註解、錯誤 facility、錯誤 action type 與錯誤路徑均不通過。JSON 政策內 action 雙引號以 `\\\"` 編碼，正則括號以 `\\\\` 編碼保留跳脫。\n\n## 七條前後對照\n\n以下為 emitted rules 的 JSON 字串表示，完整保留跳脫層級。\n\n### 900102\n\n修改前：\n```json\n[\n  \"not c:/bin/sh -c \\\"out=$(/usr/bin/rpm -qa --queryformat '%{NAME}\\\\\\\\n'); rc=$?; if [ \\\\\\\"$rc\\\\\\\" -eq 0 ]; then printf '%s\\\\\\\\n' \\\\\\\"$out\\\\\\\" 'LINUXGCB_COMMAND_OK'; else exit $rc; fi\\\" -> r:^ypbind$\",\n  \"c:/bin/sh -c \\\"out=$(/usr/bin/rpm -qa --queryformat '%
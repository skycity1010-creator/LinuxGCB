daemon]。headless 缺檔失敗，不當作不適用或 PASS。dconf update、系統 profile/lock 實際載入及桌面有效值留真機驗證。',\\n        '- 0235：依來源 UID_MIN 而非提示的 SYS_UID_MAX；root/+ 排除，shell 另排除 sync/shutdown/halt。檢查 nologin/false 與唯讀 passwd -S 的 L/LK；讀取或命令錯誤失敗。未自行採用固定999邊界。',\\n        '- 0236：bashrc 與 profile/profile.d 均要求有效 TMOUT 1–900。只支援來源明確 assignment 子集；shell 條件、載入順序及 readonly/export 有效性待審。',\\n        '- 0239/0240/0309：以遮罩包含027判更低權限；007不包含禁止同群組寫入的位元，不依提示放寬。0239 同查 bashrc 與 profile/profile.d；0309 同查 .bash_profile 與 .bashrc。shell 條件分支與載入效力待審。',\\n        '- 0241：pam_wheel required use_uid 與 wheel 包含 root；其他允許成員屬人工核准清單，不自行臆測。0310 要求 even_deny_root 與 root_unlock_time>=60。', '',\\n        '## 執行機轉與驗證', '',\\n        '所有候選均為 /usr/bin/python3 -c 直接三個 argv，使用 quote_argument 雙引號編碼並以 w_strtok 模型還原；不包 sh -c、不安裝端點 helper。純讀取標準庫程式在所有 predicate 完成後才單次輸出 PASS。missing/error 無成功標記，regex ^PASS$ 不把空輸出視為成功。數值在 predicate 做範圍判定；設定 key 精確比對、排除註解、去除值前後空白。', '',\\n        'tests/test_p2b6.py 涵蓋42條範圍、完整 argv/compile、全部缺失無 PASS、數值上下界、註解/key前綴反例、渲染堆疊 symlink、隔離配置正反例、RPM三態；既有測試改為限定歷史ID集合或更新總數，未修改既有 fixtures/證據。FIX5 對可重建 registry/manifest 改逐項核對本批外的舊內容，歷史來源 hash 仍核對。', '',\\n        '驗證命令：python3 -m linuxgcb build；python3 -m linuxgcb validate；python3 -m unittest discover -s tests -v。測試輸出見 docs/P2B6_TEST_OUTPUT.txt。新測試另比對 HEAD 的146條原始 rules，diff=0；既有 fixtures、來源、證據與其他兩份政策均未修改。', '',\\n        '全程 offline：無 SSH、生產 API、服務更動、sudo 或秘密存取。尚無 RHEL9/Wazuh PCRE2、timeout 與實際有效設定驗收。', '',\\n        '交付限制：本環境明列 .git 為唯讀且禁止權限升級；依任務例外保留工作目錄變更，不繞過限制建立 commit。未追蹤 codex_p2b6.log 為既有會話檔，未納入交付。', '']\\n    (ROOT/'docs/P2B6_REVIEW.md').write_text('\\\\n'.join(out))\\n\\nif __name__ == '__main__':\\n    main()\\n__init__.py\\n__main__.py\\nargv.py\\nbatch1.py\\nbatch2.py\\nbatch3.py\\nbatch6.py\\ncatalog.py\\ncollector.py\\ncoverage.py\\nexpected.py\\np2b3_runtime.py\\np2b6_runtime.py\\npolicy.py\\nquality.py\\nreport.py\\nsnapshot.py\\n\\\"\\\"\\\"Offline predicates against isolated trees; never read host configuration.\\\"\\\"\\\"\\nimport contextlib\\nimport io\\nimport json\\nfrom pathlib import Path\\nimport subprocess\\nimport tempfile\\nimport unittest\\nfrom unittest.mock import patch\\nfrom linuxgcb import batch6\\nfrom linuxgcb import p2b6_runtime as rt\\nfrom linuxgcb.argv import w_strtok\\n\\n\\nclass P2B6Tests(unittest.TestCase):\\n    def setUp(self):\\n        self.tmp = tempfile.TemporaryDirectory()\\n        self.addCleanup(self.tmp.cleanup)\\n        self.old = rt.ROOT\\n        rt.ROOT = self.tmp.name\\n        self.addCleanup(setattr, rt, 'ROOT', self.old)\\n\\n    def put(self, path, text):\\n        dest = Path(self.tmp.name + path)\\n        dest.parent.mkdir(parents=True, exist_ok=True)\\n        dest.write_text(text)\\n\\n    def test_scope_source_and_argv(self):\\n        self.assertEqual(len(batch6.ADDED), 42)\\n        for n, rules in batch6.rules().items():\\n            self.assertEqual(batch6.sources()[n]['category'], '帳號與存取控制')\\n            argv = w_strtok(rules[0][0][2:])\\n            self.assertEqual(argv[:2], ['/usr/bin/python3', '-c'])\\n            self.assertEqual(argv[2], batch6.script(n))\\n            self.assertEqual(argv[2].count(\\\"print('PASS')\\\"), 1)\\n            compile(argv[2], '<candidate>', 'exec')\\n\\n    def test_numeric_boundaries_and_comments(self):\\n        cases = {206:('retry',1,3),208:('minlen',12,None),209:('minclass',4,4),\\n                 210:('dcredit',None,-1),211:('ucredit',None,-1),212:('lcredit',None,-1),213:('ocredit',None,-1),\\n                 214:('difok',3,None),215:('maxclassrepeat',1,4),216:('maxrepeat',1,3),217:('dictcheck',1,1),311:('maxsequence',1,3)}\\n        self.put('/etc/login.defs','PASS_MIN_LEN 12\\\\n')\\n        for n,(key,low,high) in cases.items():\\n            good = low if low is not None else high\\n            path='/etc/security/pwquality.conf'\\n            for text, expected in [(f'  {key} = {good}  \\\\n',True),(f'# {key}={good}\\\\n',False),(f'{key}_wrong={good}\\\\n',False)]:\\n                self.put(path,text)\\n                self.assertEqual(rt.check(n),expected,(n,text))\\n            for bad in ([low-1] if low is not None else []) + ([high+1] if high is not None else []):\\n                self.put(path,f'{key}={bad}\\\\n')\\n                self.assertFalse(rt.check(n),n)\\n\\n    def test_source_defaults(self):\\n        cases={218:('/etc/security/faillock.conf','deny = 5','deny = 0'),219:('/etc/security/faillock.conf','unlock_time=900','unlock_time=899'),\\n               223:('/etc/login.defs','PASS_MIN_DAYS 1','PASS_MIN_DAYS 0'),224:('/etc/login.defs','PASS_WARN_AGE 14','PASS_WARN_AGE 13'),\\n               225:('/etc/login.defs','PASS_MAX_DAYS 90','PASS_MAX_DAYS 91'),226:('/etc/default/useradd','INACTIVE=30','INACTIVE=0'),\\n               227:('/etc/login.defs','FAIL_DELAY 4','FAIL_DELAY 3'),228:('/etc/login.defs','CREATE_HOME yes','CREATE_HOME no'),\\n               240:('/etc/login.defs','UMASK 027','UMASK 022'),310:('/etc/security/faillock.conf','even_deny_root\\\\nroot_unlock_time=60','even_deny_root\\\\nroot_unlock_time=59')}\\n        for n,(path,good,bad) in cases.items():\\n            self.put(path,good);self.assertTrue(rt.check(n),n)\\n            self.put(path,bad);self.assertFalse(rt.check(n),n)\\n            self.put(path,'# '+good.replace('\\\\n','\\\\n# '));self.assertFalse(rt.check(n),n)\\n\\n    def test_pam_and_symlink(self):\\n        good='password requisite pam_pwquality.so local_users_only enforce_for_root\\\\nauth sufficient pam_unix.so\\\\naccount required pam_unix.so\\\\npassword sufficient pam_unix.so sha512 shadow use_authtok\\\\nsession required pam_unix.so\\\\npassword required pam_pwhistory.so remember=3\\\\n'\\n        self.put('/etc/pam.d/system-auth',good)\\n        self.put('/etc/authselect/password-auth',good)\\n        Path(self.tmp.name+'/etc/pam.d/password-auth').symlink_to('../authselect/password-auth')\\n        for n in (207,220,312,313,314): self.assertTrue(rt.check(n),n)\\n        self.put('/etc/pam.d/system-auth',good.replace('pam_unix.so','pam_unix.so nullok'))\\n        self.assertFalse(rt.check(312))\\n        self.put('/etc/pam.d/system-auth',good.replace('remember=3','remember=2'))\\n        self.assertFalse(rt.check(220))\\n        self.put('/etc/libuser.conf','crypt_style = sha512')\\n        self.put('/etc/login.defs','ENCRYPT_METHOD SHA512')\\n        self.assertTrue(rt.check(222))\\n        self.put('/etc/pam.d/postlogin','session required pam_lastlog.so showfailed')\\n        self.assertTrue(rt.check(221))\\n        self.put('/etc/pam.d/su','auth required pam_wheel.so use_uid')\\n        self.put('/etc/group','wheel:x:10:root,user1')\\n        self.assertTrue(rt.check(241))\\n\\n    def test_desktop_and_account_and_shell(self):\\n        self.put('/etc/dconf/db/local.d/00-screensaver','[org/gnome/desktop/screensaver]\\\\nlock-enabled=true\\\\n[org/gnome/desktop/session]\\\\nidle-delay=uint32 900')\\n        for n in (232,233):self.assertTrue(rt.check(n))\\n        self.put('/etc/dconf/db/local.d/00-screensaver','[wrong]\\\\nlock-enabled=true\\\\nidle-delay=uint32 900')\\n        for n in (232,233):self.assertFalse(rt.check(n))\\n        self.put('/etc/dconf/db/local.d/locks/session','\\\\n'.join('/org/gnome/desktop/'+s for s in ('session/idle-delay','screensaver/lock-enabled','screensaver/lock-delay','lockdown/disable-lock-screen')))\\n        self.assertTrue(rt.check(237))\\n        self.put('/etc/gdm/custom.conf','[daemon]\\\\nAutomaticLoginEnable=false')\\n        self.assertTrue(rt.check(234))\\n        self.put('/etc/login.defs','UID_MIN 1000')\\n        self.put('/etc/passwd','root:x:0:0:root:/root:/bin/bash\\\\ndaemon:x:2:2::/:/sbin/nologin')\\n        with patch.object(rt.subprocess,'run',return_value=subprocess.CompletedProcess([],0,'daemon LK 2026-01-01','')):\\n            self.assertTrue(rt.check(235));self.assertTrue(rt.check(238))\\n        for p in ('/etc/bashrc','/etc/profile','/root/.bashrc','/root/.bash_profile'):\\n            self.put(p,'umask 027\\\\nreadonly TMOUT=900 ; export TMOUT')\\n        for n in (236,239,309):self.assertTrue(rt.check(n))\\n        self.put('/etc/bashrc','umask 022\\\\nTMOUT=0')\\n        for n in (236,239):self.assertFalse(rt.check(n))\\n        self.put('/etc/security/limits.conf','* hard maxlogins 10')\\n        self.assertTrue(rt.check(230))\\n        self.put('/etc/security/limits.conf','* hard maxlogins 11')\\n        self.assertFalse(rt.check(230))\\n        self.put('/etc/sudoers','# NOPASSWD\\\\nroot ALL=(ALL) ALL')\\n        self.assertTrue(rt.check(229))\\n        self.put('/etc/sudoers','root ALL=(ALL) NOPASSWD: ALL')\\n        self.assertFalse(rt.check(229))\\n\\n    def test_rpm_three_states(self):\\n        for rc,expect in ((0,True),(1,False)):\\n            with patch.object(rt.subprocess,'run',return_value=subprocess.CompletedProcess([],rc,'kbd-1' if rc==0 else 'not installed','')) as run:\\n                self.assertEqual(rt.check(231),expect)\\n                self.assertEqual(run.call_args.args[0],['/usr/bin/rpm','-q','kbd'])\\n        with patch.object(rt.subprocess,'run',return_value=subprocess.CompletedProcess([],2,'kbd-1','')):\\n            with self.assertRaises(ValueError):rt.check(231)\\n\\n    def test_missing_never_commits(self):\\n        for n in sorted(batch6.ADDED):\\n            script=batch6.script(n).replace(\\\"ROOT = ''\\\",'ROOT = '+repr(self.tmp.name),1)\\n            # Mock subprocess so no host package query is performed.\\n            namespace={}\\n            with patch('subprocess.run',side_effect=OSError('offline')),contextlib.redirect_stdout(io.StringIO()) as out:\\n                exec(script,namespace)\\n            self.assertEqual(out.getvalue(),'',n)\\n\\n    def test_original_146_rules_unchanged(self):\\n        root=Path(__file__).resolve().parents[1]\\n        baseline={}\\n        current={}\\n        for p in sorted((root/'policies').glob('*.yml')):\\n            old=json.loads(subprocess.check_output(['git','show','HEAD:policies/'+p.name],cwd=root))\\n            baseline.update({c['id']:c['rules'] for c in old['checks']})\\n            current.update({c['id']:c['rules'] for c in json.loads(p.read_text())['checks']})\\n        self.assertEqual(len(baseline),146)\\n        self.assertEqual(len(current),188)\\n        self.assertEqual(baseline,{n:current[n] for n in baseline})\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./codex_p2b7.log:15:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_7\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"cat linuxgcb/catalog.py | head -150; cat linuxgcb/quality.py | head -130; python3 - <<'PY'\\nfrom scripts.inventory import extract\\nfrom pathlib import Path\\nns={32,*range(34,45),*range(61,92),*range(303,308)}\\nfor r in extract(next(Path('.').glob('*.xlsx'))):\\n if int(r['gcb_id'][-4:]) in ns: print(r['gcb_id'],r['title'], '\\\\\\\\n',r['configuration_method'],'\\\\\\\\nEXPECTED',r['expected'],'\\\\\\\\n')\\nPY\\\"\",\"aggregated_output\":\"\\\"\\\"\\\"固定來源、候選範圍與保守分類。\\\"\\\"\\\"\\nimport hashlib\\nimport json\\nfrom pathlib import Path\\nfrom scripts.inventory import extract\\nfrom .batch1 import ADDED\\nfrom .quality import status\\nfrom .batch3 import ADDED as BATCH3\\nfrom .batch6 import ADDED as BATCH6\\nfrom .batch2 import ADDED as BATCH2\\n\\nROOT = Path(__file__).resolve().parents[1]\\nXLSX_HASH = '7d752b639a1e780df08814c6252efadd3ea2711eaa5c9d91c070b84a296c0247'\\nDOCX_HASH = '986effd9501b1fd97776129c6691cf8fc98246bd04514347322f3337508e0e5b'\\nIMPLEMENTED = {45: 'base', 46: 'base', 108: 'base', 243: 'firewalld',\\n               245: 'firewalld', 269: 'sshd', 270: 'sshd'}\\nIMPLEMENTED.update({n: ('sshd' if n in (256,257) else 'firewalld' if n==242 else 'base') for n in ADDED})\\nIMPLEMENTED.update({n: ('sshd' if n >= 254 else 'base') for n in BATCH2})\\nIMPLEMENTED.update({n: 'base' for n in BATCH3})\\nIMPLEMENTED.update({n: 'base' for n in BATCH6})\\nPARTIAL = {141: '僅來源設定方法明列 audit.rules；其餘 rules.d 規則檔集合尚未覆蓋',\\n           108: '僅雙協定即時值；持久設定來源、覆寫順序與路由角色待審',\\n           269: '僅 sshd -T 預設情境；Include/Match 與使用者/來源矩陣待審',\\n           270: '僅 sshd -T 預設情境；Include/Match 與使用者/來源矩陣待審'}\\n\\n\\ndef digest(path):\\n    return hashlib.sha256(path.read_bytes()).hexdigest()\\n\\n\\ndef registry():\\n    source = next(ROOT.glob('*.xlsx'))\\n    docx = next(ROOT.glob('*.docx'))\\n    if digest(source) != XLSX_HASH or digest(docx) != DOCX_HASH:\\n        raise ValueError('來源 hash 改變，停止產生')\\n    records = extract(source)\\n    result = []\\n    for r in records:\\n        n = int(r['gcb_id'][-4:])\\n        included = r['sheet'] != 'Nftables防火牆'\\n        profile = ('firewalld' if r['sheet'] == 'Firewalld防火牆' else\\n                   'sshd' if r['sheet'] == 'SSH伺服器' else 'base')\\n        if n in IMPLEMENTED:\\n            classification, why = 'native_sca', '候選唯讀原生命令；完整語意與引擎驗收待人工審查'\\n        elif profile != 'base' or any(k in r['title'] for k in ('GUI', '無線', '可攜', 'NFS')):\\n            classification, why = 'conditional', '須先確認角色、服務與適用性，再選擇實作方式'\\n        elif any(k in r['title'] for k in ('權限', '所有權', '擁有', '稽核', '密碼', '通行碼')):\\n            classification, why = 'readonly_helper', '可能涉及集合、位元或載入鏈解析；尚未實作 helper'\\n        else:\\n            classification, why = 'manual_review', '尚未逐條語意審查，保守列人工待辦，非不可自動化結論'\\n        result.append(dict(gcb_id=r['gcb_id'], source_file=r['source_file'],\\n            source_sheet=r['sheet'], source_row=r['row'], source_sha256=XLSX_HASH,\\n            category=r['category'], title=r['title'], expected=r['expected'],\\n            included=included, scope_reason='候選，仍須主機適用性核准' if included else '明確排除 Nftables 工作表',\\n            sca_id=900000+n, profile=profile, proposed_classification=classification,\\n            justification=why, review_status='human_review_pending',\\n            implementation='candidate' if n in IMPLEMENTED else 'pending' if included else 'excluded',\\n            policy_id='linuxgcb_rhel9_'+IMPLEMENTED[n]+'_v01' if n in IMPLEMENTED else None,\\n            coverage='partial' if n in PARTIAL else 'full' if n in IMPLEMENTED else 'unimplemented',\\n            live_validation='UNVALIDATED', execution_review='pending',\\n            pending=PARTIAL.get(n, '' if n in IMPLEMENTED else '未實作；待逐條 DOCX 語意審查')))\\n        if n in IMPLEMENTED:\\n            result[-1].update(status(n))\\n    if (len(result), sum(r['included'] for r in result), len({r['sca_id'] for r in result}),\\n        len({r['gcb_id'] for r in result})) != (314, 307, 314, 314):\\n        raise ValueError('範圍或唯一性不符')\\n    return result\\n\\n\\ndef write_registry():\\n    rows = registry()\\n    (ROOT/'data/scope_registry.json').write_text(json.dumps(rows, ensure_ascii=False, indent=2)+'\\\\n')\\n    return rows\\n\\\"\\\"\\\"Q1 離線審查結論；只涵蓋原有 53 ID，非來源或真機核准。\\\"\\\"\\\"\\nfrom .batch1 import FILES, PACKAGES, SERVICES\\nfrom .batch3 import ADDED as BATCH3, caveat as batch3_caveat\\nfrom .batch2 import ADDED as BATCH2, caveat as batch2_caveat\\n\\nfrom .batch6 import ADDED as BATCH6, caveat as batch6_caveat\\n\\nABSENCE_PENDING = {30,94,97,98,245}\\n\\ndef findings(n):\\n    issues = ['Q1-01']  # 非零但匹配 stdout，無已核准的原生執行狀態保護\\n    if n in FILES or n in (45,46): issues += ['Q1-03','Q1-04']\\n    if n in range(53,61) or n in (141,178,191,192): issues += ['Q1-05']\\n    if n in SERVICES or n in (243,245): issues += ['Q1-06']\\n    if n in ABSENCE_PENDING: issues += ['Q1-07']\\n    if n in (108,141,269,270): issues += ['Q1-08']\\n    return issues\\n\\ndef family(n):\\n    if n in FILES or n in (45,46): return '檔案 metadata'\\n    if n in PACKAGES: return 'RPM 存在'\\n    if n in SERVICES or n in (243,245): return 'systemd 服務'\\n    if n == 108: return 'sysctl 即時值'\\n    return 'SSH 預設有效設定'\\n\\ndef status(n):\\n    if n in BATCH6:\\n        return dict(offline_review=\\\"completed_with_findings\\\", execution_review=\\\"blocked\\\",\\n                    coverage=\\\"partial\\\", issue_ids=[\\\"B6-ENGINE\\\", \\\"B6-SCOPE\\\"],\\n                    family=\\\"P2B6 embedded read-only\\\", source_approval=\\\"pending\\\",\\n                    live_validation=\\\"UNVALIDATED\\\", pending=batch6_caveat(n))\\n    if n in BATCH3:\\n        return dict(offline_review='completed_with_findings', execution_review='blocked',\\n                    coverage='partial', issue_ids=['B3-ENGINE', 'B3-SCOPE'],\\n                    family='P2B3 embedded read-only', source_approval='pending',\\n                    live_validation='UNVALIDATED', pending=batch3_caveat(n))\\n    if n in BATCH2:\\n        return dict(offline_review='completed_with_findings', execution_review='blocked',\\n                    coverage='partial', issue_ids=['B2-ENGINE', 'B2-SCOPE'],\\n                    family='BATCH2 guarded read-only', source_approval='pending',\\n                    live_validation='UNVALIDATED', pending=batch2_caveat(n))\\n    return dict(offline_review='completed_with_findings',\\n                execution_review='blocked',\\n                coverage='blocked' if n in ABSENCE_PENDING else 'partial',\\n                issue_ids=findings(n), family=family(n),\\n                source_approval='pending', live_validation='UNVALIDATED')\\nTWGCB-01-012-0032 GPG簽章驗證 \\n 編輯/etc/yum.conf與/etc/dnf/dnf.conf檔案，在「main」段落新增或修改成以下內容：\\ngpgcheck=1\\nlocalpkg_gpgcheck=1\\n編輯/etc/yum.repos.d目錄下所有檔案，將全部之「gpgcheck」設定，修改成以下內容：\\ngpgcheck=1\\nlocalpkg_gpgcheck=1 \\nEXPECTED 1 \\n\\nTWGCB-01-012-0034 設定sudo指令使用pty \\n 開啟終端機，執行「visudo -f」指令編輯/etc/sudoers檔案或 /etc/sudoers.d/目錄下檔案，新增以下內容：\\nDefaults use_pty \\nEXPECTED Defaults use_pty \\n\\nTWGCB-01-012-0035 sudo自定義日誌檔案 \\n 開啟終端機，執行「visudo -f」指令編輯/etc/sudoers檔案或 /etc/sudoers.d/目錄下檔案，新增以下內容：\\nDefaults logfile=\\\"(日誌檔案路徑)\\\"\\n日誌檔案路徑使用「/var/log/sudo.log」之範例如下：\\nDefaults logfile=\\\"/var/log/sudo.log\\\" \\nEXPECTED 啟用 \\n\\nTWGCB-01-012-0036 AIDE套件 \\n 開啟終端機，執行以下指令安裝AIDE套件：\\n#dnf install aide\\n執行以下指令初始化AIDE：\\n#aide --init\\n#mv /var/lib/aide/aide.db.new.gz /var/lib/aide/aide.db.gz \\nEXPECTED 安裝 \\n\\nTWGCB-01-012-0037 定期檢查檔案系統完整性 \\n 開啟終端機，執行以下指令，編輯crontab：\\n#crontab -u root -e\\n在crontab新增以下內容，設定每天5點進行檔案系統完整性檢查：\\n0 5 * * * /usr/sbin/aide --check \\nEXPECTED 每天 \\n\\nTWGCB-01-012-0038 開機載入程式設定檔之所有權 \\n 若是基於BIOS的系統，開啟終端機，執行以下指令，設定GRUB設定檔之擁有者與群組：\\n#chown root:root /boot/grub2/grub.cfg\\n#chown root:root /boot/grub2/grubenv\\n#[ -f /boot/grub2/user.cfg ] && chown root:root /boot/grub2/user.cfg\\n若是基於UEFI的系統，編輯/etc/fstab檔案，在掛載點為「/boot/efi」列，於第4欄加入「uid=0, and gid=0」，設定GRUB設定檔之擁有者與群組，範例如下：\\n<device> /boot/efi vfat umask=0027,shortname=winnt, uid=0,gid=0 0 2 \\nEXPECTED root:root \\n\\nTWGCB-01-012-0039 開機載入程式設定檔之權限 \\n 若是基於BIOS的系統，開啟終端機，執行以下指令，設定GRUB設定檔之權限為600或更低權限：\\n#chmod 600 /boot/grub2/grub.cfg\\n#chmod 600 /boot/grub2/grubenv\\n#[ -f /boot/grub2/user.cfg ] && chmod 600 /boot/grub2/user.cfg\\n若是基於UEFI的系統，編輯/etc/fstab檔案，在掛載點為「/boot/efi」列，於第4欄加入「fmask=0177」，設定GRUB設定檔之權限，範例如下：\\n<device> /boot/efi vfat umask=0027,shortname=winnt,fmask=0177 0 2 \\nEXPECTED 600或更低權限 \\n\\nTWGCB-01-012-0040 開機載入程式之通行碼 \\n 開啟終端機，執行以下指令，使用grub2-setpassword建立一組通行碼：\\n#grub2-setpassword\\nEnter password: (輸入通行碼)\\nConfirm password: (再次輸入通行碼)\\n執行以下指令更新grub2設定檔：\\n#grub2-mkconfig -o \\\"$(dirname \\\"$(find /boot -type f \\\\( -name 'grubenv' -o -name 'grub.conf' -o -name 'grub.cfg' \\\\) -exec grep -Pl '^\\\\h*(kernelopts=|linux|kernel)' {} \\\\;)\\\")/grub.cfg\\\" \\nEXPECTED 設定通行碼 \\n\\nTWGCB-01-012-0041 單一使用者模式身分鑑別 \\n 編輯/usr/lib/systemd/system/rescue.service檔案，新增或修改成以下內容：\\nExecStart=-/usr/lib/systemd/systemd-sulogin-shell rescue\\n編輯/usr/lib/systemd/system/emergency.service檔案，新增或修改成以下內容：\\nExecStart=-/usr/lib/systemd/systemd-sulogin-shell emergency \\nEXPECTED 啟用 \\n\\nTWGCB-01-012-0042 核心傾印功能 \\n 編輯/etc/security/limits.conf檔案或/etc/security/limits.d/目錄下檔案，新增以下內容：\\n* hard core 0\\n編輯/etc/sysctl.conf或/etc/sysctl.d/目錄下檔案，設定參數如下：\\nfs.suid_dumpable = 0\\nkernel.core_pattern = |/bin/false\\n開啟終端機，執行以下指令，設定核心參數：\\n#sysctl -w fs.suid_dumpable=0\\n#sysctl -w kernel.core_pattern=|/bin/false\\n如果已安裝coredump服務，編輯/etc/systemd/coredump.conf檔案，新增或修改成以下內容：\\nStorage=none\\nProcessSizeMax=0\\n開啟終端機，執行以下指令重新載入systemd：\\n#systemctl daemon-reload\\n如果已安裝coredump服務，開啟終端機，執行以下指令，遮蔽coredump服務：\\n#systemctl mask systemd-coredump.socket \\nEXPECTED 停用 \\n\\nTWGCB-01-012-0043 記憶體位址空間配置隨機載入 \\n 編輯/etc/sysctl.conf檔案或/etc/sysctl.d/目錄下檔案，設定參數如下：\\nkernel.randomize_va_space = 2\\n開啟終端機，執行以下指令，設定核心參數：\\n#sysctl -w kernel.randomize_va_space=2 \\nEXPECTED 2 \\n\\nTWGCB-01-012-0044 設定全系統加密原則 \\n 開啟終端機，執行以下指令，確認全系統加密原則是否為FUTURE或FIPS：\\n#grep -E -i '^\\\\s*(FUTURE|FIPS)\\\\s*(\\\\s+#.*)?$' /etc/crypto-policies/config\\n若不是使用FUTURE或FIPS原則，請執行以下任一操作，變更全系統加密原則：\\n執行以下指令，將系統設定為「FUTURE」原則：\\n#update-crypto-policies --set FUTURE\\n接續執行以下指令，以套用更新後之全系統加密原則：\\n#update-crypto-policies\\n執行以下指令，將系統設定為「FIPS」原則，並重新開機，以使生效：\\n#fips-mode-setup --enable \\nEXPECTED FUTURE或FIPS \\n\\nTWGCB-01-012-0061 其他使用者寫入具有全域寫入權限之檔案 \\n 開啟終端機，執行以下指令，在系統上所有磁區(partition)，逐一檢查磁區所掛載之檔案目錄(如根目錄)，找出具有全域寫入權限(World-writable)之檔案：\\n#find (partition) -xdev -type f -perm -0002\\n針對所找到之檔案，執行下列指令，以移除其他身分寫入權限：\\n#chmod o-w (檔案名稱) \\nEXPECTED 禁止寫入 \\n\\nTWGCB-01-012-0062 檢查所有檔案與目錄之擁有者 \\n 開啟終端機，執行以下指令，在系統上所有磁區(partition)，逐一檢查磁區所掛載之檔案目錄(如根目錄)，找出擁有者不是合法使用者之檔案或目錄：\\n#find (partition) -xdev -nouser\\n針對所找到之檔案與目錄指定合法使用者或移除：\\n#chown (使用者) (檔案名稱或目錄名稱)\\n或\\n#rm (檔案名稱或目錄名稱) \\nEXPECTED 所有檔案與目錄擁有者皆為合法使用者 \\n\\nTWGCB-01-012-0063 檢查所有檔案與目錄之擁有群組 \\n 開啟終端機，執行以下指令，在系統上所有磁區(partition)，逐一檢查磁區所掛載之檔案目錄(如根目錄)，找出擁有群組不是合法群組之檔案或目錄：\\n#find (partition) -xdev -nogroup\\n針對所找到之檔案與目錄指定合法群組或移除：\\n#chgrp (群組) (檔案名稱或目錄名稱)\\n或\\n#rm (檔案名稱或目錄名稱) \\nEXPECTED 所有檔案與目錄擁有群組皆為合法群組 \\n\\nTWGCB-01-012-0064 所有具有全域寫入權限目錄之擁有者 \\n 開啟終端機，執行以下指令，在系統上所有磁區(partition)，逐一檢查磁區所掛載之檔案目錄(如根目錄)，找出一般使用者(UID大於999)具有全域寫入(World-writable)權限之目錄\\n#find (partition) -xdev -type d -perm -0002 -uid +999 -print\\n針對所找到之目錄，執行以下指令，設定目錄擁有者為root或其他系統帳號\\n#chown root (目錄名稱) \\nEXPECTED root或其他系統帳號 \\n\\nTWGCB-01-012-0065 所有具有全域寫入權限目錄之擁有群組 \\n 開啟終端機，執行以下指令，在系統上所有磁區(partition)，逐一檢查磁區所掛載之檔案目錄(如根目錄)，找出一般使用者群組(GID大於999)具有全域寫入(World-writable)權限之目錄\\n#find (partition) -xdev -type d -perm -0002 -gid +999 -print\\n針對所找到之目錄，執行以下指令，設定目錄擁有群組為root或其他系統群組(sys、bin或應用程式群組)：\\n#chgrp root (目錄名稱) \\nEXPECTED root或其他系統群組 \\n\\nTWGCB-01-012-0066 系統命令檔案權限 \\n 開啟終端機，執行以下指令，檢查系統命令檔案之權限：\\n#find -L /bin /sbin /usr/bin /usr/sbin /usr/local/bin /usr/local/sbin -perm /0022 -exec ls -l {} \\\\;\\n若找到系統命令檔案權限高於755，執行以下指令，設定系統命令檔案之權限為755或更低權限：\\n#chmod 755 (系統命令檔案名稱) \\nEXPECTED 755或更低權限 \\n\\nTWGCB-01-012-0067 系統命令檔案擁有者 \\n 開啟終端機，執行以下指令，檢查系統命令檔案擁有者：\\n#find -L /bin /sbin /usr/bin /usr/sbin /usr/local/bin /usr/local/sbin ! -user root -exec ls -l {} \\\\;\\n若找到系統命令檔案擁有者非root，執行以下指令，設定系統命令檔案擁有者為root：\\n#chown root (系統命令檔案名稱) \\nEXPECTED root \\n\\nTWGCB-01-012-0068 系統命令檔案擁有群組 \\n 開啟終端機，執行以下指令，檢查系統命令檔案擁有群組：\\n#find -L /bin /sbin /usr/bin /usr/sbin /usr/local/bin /usr/local/sbin ! -group root ! -group tty ! -group slocate ! -group lock -exec ls -l {} \\\\;\\n若找到系統命令檔案擁有群組非root，執行以下指令，設定系統命令檔案擁有群組為root：\\n#chgrp root (系統命令檔案名稱) \\nEXPECTED root \\n\\nTWGCB-01-012-0069 程式庫檔案權限 \\n 開啟終端機，執行以下指令，檢查程式庫檔案之權限：\\n#find -L /lib /lib64 /usr/lib /usr/lib64 -perm /0022 -type f -exec ls -l {} \\\\;\\n若找到程式庫檔案權限高於755，執行以下指令，設定程式庫檔案之權限為755或更低權限：\\n#chmod 755 (程式庫檔案名稱) \\nEXPECTED 755或更低權限 \\n\\nTWGCB-01-012-0070 程式庫檔案擁有者 \\n 開啟終端機，執行以下指令，檢查程式庫檔案擁有者：\\n#find -L /lib /lib64 /usr/lib /usr/lib64 ! -user root -exec ls -l {} \\\\;\\n若找到程式庫檔案擁有者非root，執行以下指令，設定程式庫檔案擁有者為root：\\n#chown root (程式庫檔案名稱) \\nEXPECTED root \\n\\nTWGCB-01-012-0071 程式庫檔案擁有群組 \\n 開啟終端機，執行以下指令，檢查程式庫檔案擁有群組：\\n#find -L /lib /lib64 /usr/lib /usr/lib64 ! -group root -exec ls -l {} \\\\;\\n若找到程式庫檔案擁有群組非root，執行以下指令，設定程式庫檔案擁有群組為root：\\n#chgrp root (程式庫檔案名稱) \\nEXPECTED root \\n\\nTWGCB-01-012-0072 帳號不使用空白通行碼 \\n 開啟終端機，執行以下指令，列出使用空白通行碼之帳號：\\n#awk -F: '($2 == \\\"\\\" ) { print $1 \\\" does not have a password \\\"}' /etc/shadow\\n若有使用空白通行碼之帳號，則執行下列指令以設定通行碼：\\n#passwd (帳號名稱)\\n或執行下列指令以鎖定帳號：\\n#passwd -l (帳號名稱) \\nEXPECTED 帳號必須具有通行碼或被鎖定 \\n\\nTWGCB-01-012-0073 root帳號之路徑變數 \\n 開啟終端機，執行以下指令，顯示PATH變數內容：\\n#echo $PATH\\n如出現「.」、「..」、路徑開頭不是「/」及空元素等內容，請編輯/etc/profile檔案進行修改 \\nEXPECTED 不允許「.」、「..」、路徑開頭不是「/」及空元素 \\n\\nTWGCB-01-012-0074 root帳號之路徑變數不包含world-writable或group-writable目錄 \\n 開啟終端機，執行以下指令，顯示PATH變數內容：\\n#echo $PATH\\n如出現具有world-writable權限或group-writable權限之目錄，請編輯/etc/profile檔案進行修改，或執行下列指令變更目錄權限：\\n#chmod o-w (目錄名稱)\\n或\\n#chmod g-w (目錄名稱) \\nEXPECTED 不包含world-writable或group-writable目錄 \\n\\nTWGCB-01-012-0075 /etc/passwd檔案行首之「+」符號 \\n 開啟終端機，執行以下指令，確認/etc/passwd檔案行首是否存在「+」符號：\\n#grep '^\\\\+:' /etc/passwd\\n如果有，則編輯/etc/passwd檔案，將行首為「+」符號之列移除 \\nEXPECTED 禁止 \\n\\nTWGCB-01-012-0076 /etc/shadow檔案行首之「+」符號 \\n 開啟終端機，執行以下指令，確認/etc/shadow檔案行首是否存在「+」符號：\\n#grep '^\\\\+:' /etc/shadow\\n如果有，則編輯/etc/shadow檔案，將行首為「+」符號之列移除 \\nEXPECTED 禁止 \\n\\nTWGCB-01-012-0077 /etc/group檔案行首之「+」符號 \\n 開啟終端機，執行以下指令，確認/etc/group檔案行首是否存在「+」符號：\\n#grep '^\\\\+:' /etc/group\\n如果有，則編輯/etc/group檔案，將行首為「+」符號之列移除 \\nEXPECTED 禁止 \\n\\nTWGCB-01-012-0078 UID=0之帳號 \\n 開啟終端機，執行以下指令，列出UID=0之帳號：\\n#awk -F: '($3 == 0) { print $1 }' /etc/passwd\\n若存在非root帳號，則執行以下指令，移除帳號或重新設定UID：\\n#userdel (帳號名稱)\\n或\\n#usermod -u (UID) (帳號名稱) \\nEXPECTED 僅root帳號之UID為0 \\n\\nTWGCB-01-012-0079 使用者家目錄權限 \\n 開啟終端機，執行以下腳本，檢查每個使用者家目錄權限：\\n#!/bin/bash\\ngrep -E -v '^(halt|sync|shutdown)' /etc/passwd | awk -F: '($7 != \\\"/sbin/nologin\\\" && $7 != \\\"/bin/false\\\") { print $1 \\\" \\\" $6 }' | while read user dir; do\\n  if [ ! -d \\\"$dir\\\" ]; then\\n    echo \\\"The home directory ($dir) of user $user does not exist.\\\"\\n  else\\n    dirperm=$(ls -ld $dir | cut -f1 -d\\\" \\\")\\n    if [ $(echo $dirperm | cut -c5) != \\\"-\\\" ]; then\\n      echo \\\"Group Read permission set on the home directory ($dir) of user $user\\\"\\n    fi\\n    if [ $(echo $dirperm | cut -c6) != \\\"-\\\" ]; then\\n      echo \\\"Group Write permission set on the home directory ($dir) of user $user\\\"\\n    fi\\n    if [ $(echo $dirperm | cut -c7) != \\\"-\\\" ]; then\\n      echo \\\"Group Execute permission set on the home directory ($dir) of user $user\\\"\\n    fi\\n    if [ $(echo $dirperm | cut -c8) != \\\"-\\\" ]; then\\n      echo \\\"Other Read permission set on the home directory ($dir) of user $user\\\"\\n    fi\\n    if [ $(echo $dirperm | cut -c9) != \\\"-\\\" ]; then\\n      echo \\\"Other Write permission set on the home directory ($dir) of user $user\\\"\\n    fi\\n    if [ $(echo $dirperm | cut -c10) != \\\"-\\\" ]; then\\n      echo \\\"Other Execute permission set on the home directory ($dir) of user $user\\\"\\n    fi\\n  fi\\ndone\\n若出現群組具寫入權限，其他使用者具讀取、寫入及執行權限之家目錄，則可執行以下指令，變更目錄權限為700或更低權限：\\n#chmod 700 /home/(使用者帳號名稱)\\n注意：請先通知使用者再變更家目錄相關設定，以避免影響使用者作業 \\nEXPECTED 700或更低權限 \\n\\nTWGCB-01-012-0080 使用者家目錄擁有者 \\n 開啟終端機，執行以下腳本，檢查每個使用者家目錄擁有者：\\n#!/bin/bash\\ngrep -E -v '^(halt|sync|shutdown)' /etc/passwd | awk -F: '($7 != \\\"/sbin/nologin\\\" && $7 != \\\"/bin/false\\\") { print $1 \\\" \\\" $6 }' | while read user dir; do\\n  if [ ! -d \\\"$dir\\\" ]; then\\n    echo \\\"The home directory ($dir) of user $user does not exist.\\\"\\n  else\\n    owner=$(stat -L -c \\\"%U\\\" \\\"$dir\\\")\\n    if [ \\\"$owner\\\" != \\\"$user\\\" ]; then\\n  echo \\\"The home directory ($dir) of user $user is owned by $owner.\\\"\\n  fi\\nfi\\ndone\\n若出現使用者之家目錄非使用者擁有，則可執行以下指令，變更家目錄擁有者為使用者：\\n#chown (使用者帳號名稱) /home/(使用者帳號名稱)\\n注意：請先通知使用者再變更家目錄相關設定，以避免影響使用者作業 \\nEXPECTED 使用者擁有 \\n\\nTWGCB-01-012-0081 使用者家目錄擁有群組 \\n 開啟終端機，執行以下腳本，檢查每個使用者家目錄之擁有群組GID：\\n#!/bin/bash\\ngrep -E -v '^(halt|sync|shutdown)' /etc/passwd | awk -F: '($7 != \\\"/sbin/nologin\\\" && $7 != \\\"/bin/false\\\") { print $1 \\\" \\\" $4 \\\" \\\" $6 }' | while read user gid dir; do\\n  if [ ! -d \\\"$dir\\\" ]; then\\n    echo \\\"The home directory ($dir) of user $user does not exist.\\\"\\n  else\\n    owner=$(stat -L -c \\\"%g\\\" \\\"$dir\\\")\\n    if [ \\\"$owner\\\" != \\\"$gid\\\" ]; then\\n  echo \\\"The home directory ($dir) of group $gid is owned by group $owner.\\\"\\n  fi\\nfi\\ndone\\n若出現使用者家目錄非使用者群組所擁有，則可執行以下指令，變更家目錄擁有者為使用者群組：\\n#chgrp (使用者群組名稱或GID) /home/(使用者帳號名稱)\\n注意：請先通知使用者再變更家目錄相關設定，以避免影響使用者作業 \\nEXPECTED 使用者群組擁有 \\n\\nTWGCB-01-012-0082 使用者家目錄之「.」檔案權限 \\n 開啟終端機，執行以下腳本，檢查每個使用者家目錄之「.」檔案權限：\\n#!/bin/bash\\ngrep -E -v '^(halt|sync|shutdown)' /etc/passwd | awk -F: '($7 != \\\"/sbin/nologin\\\" && $7 != \\\"/bin/false\\\") { print $1 \\\" \\\" $6 }' | while read user dir; do\\n  if [ ! -d \\\"$dir\\\" ]; then\\n    echo \\\"The home directory ($dir) of user $user does not exist.\\\"\\n  else\\n    for file in $dir/.[A-Za-z0-9]*; do\\n      if [ ! -h \\\"$file\\\" -a -f \\\"$file\\\" ]; then\\n        fileperm=$(ls -ld $file | cut -f1 -d\\\" \\\")\\n        if [ $(echo $fileperm | cut -c6) != \\\"-\\\" ]; then\\n          echo \\\"Group Write permission set on file $file\\\"\\n        fi\\n        if [ $(echo $fileperm | cut -c9) != \\\"-\\\" ]; then\\n          echo \\\"Other Write permission set on file $file\\\"\\n        fi\\n      fi\\n    done\\n  fi\\ndone\\n若出現具有world-writable或group-writable權限之「.」檔案，則可執行以下指令，移除群組與其他身分之寫入權限或更低權限：\\n#chmod go-w (檔案名稱)\\n注意：請先通知使用者再變更家目錄相關設定，以避免影響使用者作業 \\nEXPECTED go-w或更低權限 \\n\\nTWGCB-01-012-0083 使用者家目錄之「.forward」檔案 \\n 開啟終端機，執行以下腳本，檢查每個使用者家目錄是否存在「.forward」檔案：\\n#!/bin/bash\\ngrep -E -v '^(root|halt|sync|shutdown)' /etc/passwd | awk -F: '($7 != \\\"/sbin/nologin\\\" && $7 != \\\"/bin/false\\\") { print $1 \\\" \\\" $6 }' | while read user dir; do\\n  if [ ! -d \\\"$dir\\\" ]; then\\n    echo \\\"The home directory ($dir) of user $user does not exist.\\\"\\n  else\\n    if [ ! -h \\\"$dir/.forward\\\" -a -f \\\"$dir/.forward\\\" ]; then\\n      echo \\\".forward file $dir/.forward exists\\\"\\n    fi\\n  fi\\ndone\\n若存在「.forward」檔案，則可執行以下指令移除檔案：\\n#rm (檔案名稱)\\n注意：請先通知使用者再變更家目錄相關設定，以避免影響使用者作業 \\nEXPECTED 移除 \\n\\nTWGCB-01-012-0084 使用者家目錄之「.netrc」檔案 \\n 開啟終端機，執行以下腳本，檢查每個使用者家目錄是否存在「.netrc」檔案：\\n#!/bin/bash\\ngrep -E -v '^(root|halt|sync|shutdown)' /etc/passwd | awk -F: '($7 != \\\"/sbin/nologin\\\" && $7 != \\\"/bin/false\\\") { print $1 \\\" \\\" $6 }' | while read user dir; do\\n  if [ ! -d \\\"$dir\\\" ]; then\\n    echo \\\"The home directory ($dir) of user $user does not exist.\\\"\\n  else\\n    if [ ! -h \\\"$dir/.netrc\\\" -a -f \\\"$dir/.netrc\\\" ]; then\\n      echo \\\".netrc file $dir/.netrc exists\\\"\\n    fi\\n  fi\\ndone\\n若存在「.netrc」檔案，則可執行以下指令移除檔案：\\n#rm (檔案名稱)\\n注意：請先通知使用者再變更家目錄相關設定，以避免影響使用者作業 \\nEXPECTED 移除 \\n\\nTWGCB-01-012-0085 使用者家目錄之「.rhosts」檔案 \\n 開啟終端機，執行以下腳本，檢查每個使用者家目錄是否存在「.rhosts」檔案：\\n#!/bin/bash\\ngrep -E -v '^(root|halt|sync|shutdown)' /etc/passwd | awk -F: '($7 != \\\"/sbin/nologin\\\" && $7 != \\\"/bin/false\\\") { print $1 \\\" \\\" $6 }' | while read user dir; do\\n  if [ ! -d \\\"$dir\\\" ]; then\\n    echo \\\"The home directory ($dir) of user $user does not exist.\\\"\\n  else\\n    for file in $dir/.rhosts; do\\n      if [ ! -h \\\"$file\\\" -a -f \\\"$file\\\" ]; then\\n        echo \\\".rhosts file in $dir\\\"\\n      fi\\n    done\\n  fi\\ndone\\n若存在「.rhosts」檔案，則可執行以下指令移除檔案：\\n#rm (檔案名稱)\\n注意：請先通知使用者再變更家目錄相關設定，以避免影響使用者作業 \\nEXPECTED 移除 \\n\\nTWGCB-01-012-0086 檢查/etc/passwd檔案設定之群組 \\n 開啟終端機，執行以下腳本，檢查/etc/passwd檔案中帳號之群組是否都存在於/etc/group檔案中：\\n#!/bin/bash\\nfor i in $(cut -s -d: -f4 /etc/passwd | sort -u ); do\\n  grep -q -P \\\"^.*?:[^:]*:$i:\\\" /etc/group\\n  if [ $? -ne 0 ]; then\\n    echo \\\"Group $i is referenced by /etc/passwd but does not exist in /etc/group\\\"\\n  fi\\ndone\\n若有帳號之群組不存在於/etc/group檔案中，則編輯/etc/passwd檔案，或執行以下指令，修改帳號之群組(GID)：\\n#usermod -g (群組名稱或GID) (帳號名稱) \\nEXPECTED /etc/passwd檔案中帳號之群組皆須存在於/etc/group檔案中 \\n\\nTWGCB-01-012-0087 唯一之UID \\n 開啟終端機，執行以下腳本，尋找是否有不同帳號使用相同之UID：\\n#!/bin/bash\\ncut -f3 -d\\\":\\\" /etc/passwd | sort -n | uniq -c | while read x ; do\\n  [ -z \\\"$x\\\" ] && break\\n  set - $x\\n  if [ $1 -gt 1 ]; then\\n    users=$(awk -F: '($3 == n) { print $1 }' n=$2 /etc/passwd | xargs)\\n    echo \\\"Duplicate UID ($2): $users\\\"\\n  fi\\ndone\\n若有不同帳號使用相同之UID，則編輯/etc/passwd檔案，或執行以下指令，為帳號設定唯一之UID：\\n#usermod -u (UID) (帳號名稱) \\nEXPECTED 為每個帳號設定唯一之UID \\n\\nTWGCB-01-012-0088 唯一之GID \\n 開啟終端機，執行以下腳本，尋找是否有群組使用相同之GID：\\n#!/bin/bash\\ncut -d: -f3 /etc/group | sort | uniq -d | while read x ; do\\n  echo \\\"Duplicate GID ($x) in /etc/group\\\"\\ndone\\n若有不同群組使用相同GID，則編輯/etc/group檔案，或執行以下指令，為群組設定唯一之GID：\\n#groupmod -g (GID) (群組名稱) \\nEXPECTED 為每個群組設定唯一之GID \\n\\nTWGCB-01-012-0089 唯一之使用者帳號名稱 \\n 開啟終端機，執行以下腳本，尋找是否有帳號使用重複之帳號名稱：\\n#!/bin/bash\\ncut -d: -f1 /etc/passwd | sort | uniq -d | while read x\\ndo echo \\\"Duplicate login name ${x} in /etc/passwd\\\"\\ndone\\n若有帳號使用重複之帳號名稱，則編輯/etc/passwd檔案，為帳號設定唯一不重複之帳號名稱 \\nEXPECTED 為每個使用者帳號設定唯一之名稱 \\n\\nTWGCB-01-012-0090 唯一之群組名稱 \\n 開啟終端機，執行以下腳本，尋找是否有不同群組使用相同之群組名稱：\\n#!/bin/bash\\ncut -d: -f1 /etc/group | sort | uniq -d | while read x\\ndo echo \\\"Duplicate group name ${x} in /etc/group\\\"\\ndone\\n若有群組使用相同之群組名稱，則編輯/etc/group檔案，為每個群組設定唯一之群組名稱 \\nEXPECTED 為每個群組設定唯一之群組名稱 \\n\\nTWGCB-01-012-0091 shadow群組成員 \\n 開啟終端機，執行以下指令，列舉shadow群組中之使用者帳號：\\n#awk -F: '($1==\\\"shadow\\\") {print $NF}' /etc/group\\n如shadow群組有使用者帳號，請針對每個帳號執行下列步驟：\\n執行以下指令，從shadow群組移除使用者帳號：\\n#sed -ri 's/(^shadow:[^:]*:[^:]*:)([^:]+$)/\\\\1/' /etc/group\\n執行以下指令，將使用者帳號之主要群組，從shadow修改為預設群組：\\n#usermod -g (預設群組名稱) (帳號名稱) \\nEXPECTED shadow群組不包含任何使用者 \\n\\nTWGCB-01-012-0303 /etc/security/opasswd與 /etc/security/opasswd.old檔案所有權 \\n 開啟終端機，執行以下指令，設定/etc/security/opasswd與/etc/security/opasswd.old檔案所有權：\\n#chown root:root /etc/security/opasswd /etc/security/opasswd.old \\nEXPECTED root:root \\n\\nTWGCB-01-012-0304 /etc/security/opasswd與 /etc/security/opasswd.old檔案權限 \\n 開啟終端機，執行以下指令，設定/etc/security/opasswd與/etc/security/opasswd.old檔案權限為644或更低權限：\\n#chmod 644 /etc/security/opasswd /etc/security/opasswd.old \\nEXPECTED 644或更低權限 \\n\\nTWGCB-01-012-0305 /etc/shells中不應存在nologin \\n 開啟終端機，執行以下指令，尋找/etc/shells中是否含有nologin：\\n#grep -E '^[^#]*\\\\/nologin$' /etc/shells\\n開啟終端機，執行vim指令在/etc/shells移除含有nologin的行，範例如下：\\n#vim /etc/shells \\nEXPECTED 移除含有nologin的行 \\n\\nTWGCB-01-012-0306 禁止chrony以root權限執行 \\n 開啟終端機，執行vim指令，編輯/etc/sysconfig/chronyd，範例如下：\\n#vim /etc/sysconfig/chronyd\\n並在OPTIONS中移除「-u root」並加入以下內容：\\nOPTIONS=\\\"-F 2\\\"\\n開啟終端機，執行以下指令，重新啟動chrony，範例如下：\\n#systemctl restart chronyd.service \\nEXPECTED OPTIONS=\\\"-F 2\\\" \\n\\nTWGCB-01-012-0307 ptrace限制模式 \\n 開啟終端機，執行vim指令，編輯/etc/sysctl.conf或/etc/sysctl.d目錄下檔案，新增或修改以下內容：\\nkernel.yama.ptrace_scope=1\\n開啟終端機，執行以下指令，設定核心參數：\\n#sysctl -w kernel.yama.ptrace_scope=1 \\nEXPECTED 啟用 \\n\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./codex_p2b7.log:17:{\"type\":\"item.started\",\"item\":{\"id\":\"item_9\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"cat > linuxgcb/p2b7_runtime.py <<'PY'\\n\\\\\\\"\\\\\\\"\\\\\\\"Read-only source predicates. ROOT is only for isolated offline tests.\\\\\\\"\\\\\\\"\\\\\\\"\\nimport glob\\nimport os\\nimport re\\nimport shlex\\nimport stat\\nimport subprocess\\nROOT = ''\\n\\n\\ndef path(p):\\n    return ROOT + p\\n\\n\\ndef read(p):\\n    with open(path(p), encoding='utf-8') as f:\\n        return f.read()\\n\\n\\ndef files(pattern):\\n    return sorted(p[len(ROOT):] if ROOT else p for p in glob.iglob(path(pattern)))\\n\\n\\ndef lines(p):\\n    return [s.split('#', 1)[0].strip() for s in read(p).splitlines() if s.split('#', 1)[0].strip()]\\n\\n\\ndef values(paths, key):\\n    out = []\\n    for p in paths:\\n        for s in lines(p):\\n            m = re.fullmatch(re.escape(key) + r'\\\\\\\\s*=\\\\\\\\s*(.*?)\\\\\\\\s*', s)\\n            if m:\\n                out.append(m[1])\\n    return out\\n\\n\\ndef setting(paths, key, expected):\\n    v = values(paths, key)\\n    return bool(v) and all(x == expected for x in v)\\n\\n\\ndef meta(p, mode=None, uid=None, gid=None):\\n    s = os.stat(path(p))\\n    return (mode is None or stat.S_IMODE(s.st_mode) & ~mode == 0) and (uid is None or s.st_uid == uid) and (gid is None or s.st_gid == gid)\\n\\n\\ndef records(p, size):\\n    rows = [s.split(':') for s in read(p).splitlines() if s]\\n    if not rows or any(len(s) \\\"'!= size or not s[0] for s in rows):\\n        raise ValueError('\\\"'invalid account database')\\n    return rows\\n\\n\\ndef scan_argv(n, mount=None):\\n    commands = ['/bin','/sbin','/usr/bin','/usr/sbin','/usr/local/bin','/usr/local/sbin']\\n    libraries = ['/lib','/lib64','/usr/lib','/usr/lib64']\\n    roots = [mount] if n <= 65 else commands if n <= 68 else libraries\\n    predicates = {\\n        61:['-type','f','-perm','-0002'], 62:['-nouser'],63:['-nogroup'],\\n        64:['-type','d','-perm','-0002','-uid','+999'],65:['-type','d','-perm','-0002','-gid','+999'],\\n        66:['-perm','/0022'],67:['\\\"'!'\\\"','-user','root'],\\n        68:['\\\"'!'\\\"','-group','root','\\\"'!'\\\"','-group','tty','\\\"'!'\\\"','-group','slocate','\\\"'!'\\\"','-group','lock'],\\n        69:['-perm','/0022','-type','f'],70:['\\\"'!'\\\"','-user','root'],71:['\\\"'!'\\\"','-group','root']}\\n    return ['/usr/bin/find'] + ([] if n <= 65 else ['-L']) + [path(p) for p in roots] + ['-xdev','(','-path',path('/proc'),'-o','-path',path('/sys'),'-o','-path',path('/dev'),'-o','-path',path('/run'),')','-prune','-o','('] + predicates[n] + [')','-print','-quit']\\n\\n\\ndef scan(n):\\n    # Source partitions are read from mountinfo; pseudo/network filesystems excluded.\\n    if n <= 65:\\n        local = {'ext2','ext3','ext4','xfs','btrfs','vfat','f2fs','jfs','reiserfs'}\\n        roots = []\\n        for s in read('/proc/self/mountinfo').splitlines():\\n            left, right = s.split(' - ', 1)\\n            if right.split()[0] in local:\\n                mount = re.sub(r'\\\\\\\\\\\\\\\\([0-7]{3})', lambda m: chr(int(m[1],8)), left.split()[4])\\n                if not any(mount == p or mount.startswith(p+'/') for p in ('/proc','/sys','/dev','/run')):\\n                    roots.append(mount)\\n        if not roots:\\n            return False\\n    else:\\n        roots = [None]\\n    for mount in dict.fromkeys(roots):\\n        result = subprocess.run(scan_argv(n,mount), capture_output=True, text=True, timeout=24)\\n        if result.returncode \\\"'!= 0 or result.stdout or result.stderr:\\n            return False\\n    return True\\n\\n\\ndef root_path():\\n    # Do not execute shell startup files. Expand only literal PATH assignments.\\n    current = None\\n    for p in ['\\\"'/etc/profile','/root/.bash_profile','/root/.bashrc']:\\n        if not os.path.exists(path(p)):\\n            continue\\n        for s in lines(p):\\n            m = re.fullmatch(r'(?:export\\\\\\\\s+)?PATH\\\\\\\\s*=\\\\\\\\s*(.*?)(?:;\\\\\\\\s*export\\\\\\\\s+PATH)?',s)\\n            if not m:\\n                continue\\n            v = shlex.split(m[1])\\n            if len(v) \\\"'!= 1:\\n                raise ValueError('\\\"'ambiguous PATH')\\n            v = v[0]\\n            if '\\\"'$PATH'\\\"' in v or '\\\"'${PATH}'\\\"' in v:\\n                if current is None:\\n                    raise ValueError('unresolved PATH')\\n                v = v.replace('\\\"'${PATH}'\\\"',current).replace('\\\"'$PATH'\\\"',current)\\n            if any(c in v for c in '\\\"'$`;'\\\"\\\\\\\\\\\\\\\\'):\\n                raise ValueError('dynamic PATH')\\n            current = v\\n    if current is None:\\n        raise ValueError('missing PATH')\\n    return current.split(':')\\n\\n\\ndef check(n):\\n    if n == 32:\\n        for p in ['/etc/yum.conf','/etc/dnf/dnf.conf'] + files('/etc/yum.repos.d/*'):\\n            section = None\\n            seen = set()\\n            for s in lines(p):\\n                if s.startswith('[') and s.endswith(']'):\\n                    section = s[1:-1]\\n                for key in ('gpgcheck','localpkg_gpgcheck'):\\n                    m = re.fullmatch(key+r'\\\\\\\\s*=\\\\\\\\s*(.*?)\\\\\\\\s*',s)\\n                    if m and (p.startswith('/etc/yum.repos.d/') or section == 'main'):\\n                        if int(m[1]) \\\"'!= 1:\\n                            return False\\n                        seen.add(key)\\n            if seen != {'\\\"'gpgcheck','localpkg_gpgcheck'}:\\n                return False\\n        return True\\n    if n in (34,35):\\n        found = False\\n        for p in ['/etc/sudoers'] + files('/etc/sudoers.d/*'):\\n            for s in lines(p):\\n                if not re.match(r'\\\"'^Defaults'\\\"\\\\\\\\s+',s):\\n                    continue\\n                for token in re.split(r',\\\\\\\\s*',re.sub(r'\\\"'^Defaults'\\\"\\\\\\\\s+','',s)):\\n                    if n == 34 and token == '\\\"'!use_pty'\\\"':\\n                        return False\\n                    if n == 34 and token == 'use_pty':\\n                        found = True\\n                    if n == 35 and re.match(r'\\\"'^logfile'\\\"\\\\\\\\s*=',token):\\n                        v = shlex.split(token.split('=',1)[1].strip())\\n                        if len(v) \\\"'!= 1 or not v[0].startswith('\\\"'/'):\\n                            return False\\n                        found = True\\n        return found\\n    if n == 36:\\n        r = subprocess.run(['/usr/bin/rpm','-q','aide'],capture_output=True,text=True,timeout=5)\\n        if r.returncode not in (0,1):\\n            raise ValueError('rpm error')\\n        return r.returncode == 0 and bool(r.stdout.strip())\\n    if n == 37:\\n        # Root crontab is the actual source; daily directory is a task-requested alternative.\\n        p = '/var/spool/cron/root'\\n        if os.path.exists(path(p)) and any(re.fullmatch(r'\\\\\\\\d+\\\\\\\\s+\\\\\\\\d+\\\\\\\\s+\\\\\\\\*\\\\\\\\s+\\\\\\\\*\\\\\\\\s+\\\\\\\\*\\\\\\\\s+/usr/sbin/aide\\\\\\\\s+--check',s) for s in lines(p)):\\n            return True\\n        for p in files('/etc/cron.daily/*'):\\n            if os.path.isfile(path(p)) and os.stat(path(p)).st_mode & 0o111:\\n                if any(re.fullmatch(r'/usr/sbin/aide\\\\\\\\s+--check',s) for s in lines(p)):\\n                    return True\\n        return False\\n    if n 
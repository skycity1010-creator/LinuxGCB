{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'find .. -name AGENTS.md -print; cat linuxgcb/batch8.py; cat linuxgcb/p2b8_runtime.py; cat tests/test_p2b8.py'","aggregated_output":"find: ‘../soar-poc-candidate-p1/.scratch/p2’: Permission denied\n../open-slide-demo/AGENTS.md\n\"\"\"P2B8 source-bound offline candidates, direct w_strtok Python argv.\"\"\"\nimport inspect\nimport hashlib\nfrom zipfile import ZipFile\nfrom xml.etree import ElementTree as ET\nfrom functools import lru_cache\nfrom pathlib import Path\nfrom . import p2b8_runtime\nfrom .argv import quote_argument\nADDED = set(range(1,30)) | {31} | set(range(285,301))\nfrom .p2b8_runtime import MODULES\n\n\n@lru_cache(maxsize=1)\ndef sources():\n    from scripts.inventory import extract\n    root = Path(__file__).resolve().parents[1]\n    docx = root/'docs/references/gcb-rhel9-v1.2.docx'\n    if hashlib.sha256(docx.read_bytes()).hexdigest() != '986effd9501b1fd97776129c6691cf8fc98246bd04514347322f3337508e0e5b':\n        raise ValueError('GCB v1.2 reference hash changed')\n    ns = {'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}\n    xml = ET.fromstring(ZipFile(docx).read('word/document.xml'))\n    tables = [['\\n'.join(''.join(t.text or '' for t in p.findall('.//w:t',ns))\n              for p in cell.findall('.//w:p',ns)) for cell in tr.findall('w:tc',ns)]\n              for tr in xml.findall('.//w:tr',ns)]\n    out = {}\n    for r in extract(next(root.glob('*.xlsx'))):\n        n = int(r['gcb_id'][-4:])\n        if n not in ADDED:\n            continue\n        matches = [c for c in tables if r['gcb_id'] in c and c[-1] == r['expected'] and c[-2] == r['configuration_method']]\n        if not matches or any(c[-2:] != matches[0][-2:] for c in matches):\n            raise ValueError('GCB DOCX/XLSX source mismatch: '+r['gcb_id'])\n        out[n] = dict(r, configuration_method=matches[0][-2])\n    if set(out) != ADDED:\n        raise ValueError('incomplete P2B8 source set')\n    return out\n\n\ndef script(n):\n    return inspect.getsource(p2b8_runtime) + '\\ntry:\\n    ok = check(' + str(n) + \")\\nexcept (OSError, ValueError, IndexError, KeyError, subprocess.SubprocessError):\\n    ok = False\\nif ok is None:\\n    print('REVIEW')\\nelif ok:\\n    print('PASS')\\n\"\n\n\n@lru_cache(maxsize=1)\ndef rules():\n    return {n:[('c:/usr/bin/python3 -c ' + quote_argument(script(n)), '^PASS$|^REVIEW$')] for n in sorted(ADDED)}\n\n\ndef caveat(n):\n    if n in MODULES:\n        note = '精確 install 模組 /bin/true 與 blacklist 模組；不以模組不存在豁免；載入狀態與重新開機待真機。'\n    elif n in (8,9,13,14,15):\n        note = 'mountinfo 確認掛載點、裝置號不同於根與其他祖先、root=/，來源獨立裝置；bind/subpath 不算。'\n    elif n == 29:\n        note = '來源 df --local -P 逐本機磁區，find -xdev -type d -perm -0002 ! -perm -1000 -print -quit；24秒整體預算。'\n    elif 20 <= n <= 22:\n        note = '由 sysfs 裝置 removable 與父裝置辨識可攜式掛載；無對象或裝置無法分類輸出 REVIEW，並非符合或違規；USB 固定式及非 block 可攜式辨識待批。'\n    elif 23 <= n <= 25:\n        note = '來源 passwd UID>=1000 且非 nobody，只查家目錄本身獨立掛載；無對象輸出 REVIEW；以即時值取代來源 fstab 按任務要求，待批。'\n    elif 26 <= n <= 28:\n        note = '來源條件式 NFS；查即時 nfs/nfs4 掛載選項，無對象輸出 REVIEW；fstab 尚未掛載項之適用性另審。'\n    else:\n        note = '讀 /proc/mounts 精確掛載點、類型或完整 option token；缺掛載失敗；持久設定及生效差異待真機。'\n    return note + ' P2B8 UNVALIDATED；human_review_pending；execution_review=blocked；REVIEW 在輸出匹配層為 raw passed，但 coverage partial 且 blocked，必須人工判定適用性，不是已驗證 PASS。'\n\"\"\"Read-only source predicates; ROOT is used only by isolated tests.\"\"\"\nimport glob\nimport os\nimport re\nimport subprocess\nimport time\nROOT = ''\nMODULES = dict(zip([1,2,3,31]+list(range(285,301)),\n    ['cramfs','squashfs','udf','usb-storage','freevxfs','hfs','hfsplus','jffs2','afs','ceph','cifs','exfat','ext','fat','fscache','fuse','gfs2','nfs_common','nfsd','smbfs_common']))\nFIXED = {5:('/tmp','nodev'),6:('/tmp','nosuid'),7:('/tmp','noexec'),10:('/var/tmp','nodev'),11:('/var/tmp','nosuid'),12:('/var/tmp','noexec'),16:('/home','nodev'),17:('/dev/shm','nodev'),18:('/dev/shm','nosuid'),19:('/dev/shm','noexec')}\nPARTITIONS = {8:'/var',9:'/var/tmp',13:'/var/log',14:'/var/log/audit',15:'/home'}\n\n\ndef read(path):\n    with open(ROOT+path, encoding='utf-8') as f:\n        return f.read()\n\n\ndef unescape(s):\n    return re.sub(r'\\\\([0-7]{3})',lambda m:chr(int(m[1],8)),s)\n\n\ndef mounts():\n    out = []\n    for line in read('/proc/mounts').splitlines():\n        if not line.strip() or line.lstrip().startswith('#'): continue\n        f = line.split()\n        if len(f) != 6: raise ValueError('mount record')\n        out.append((unescape(f[0]),unescape(f[1]),f[2],set(f[3].split(','))))\n    if not out: raise ValueError('empty mount table')\n    return out\n\n\ndef mountinfo():\n    out = {}\n    for line in read('/proc/self/mountinfo').splitlines():\n        a,b = line.split(' - ',1)\n        f = a.split(); tail = b.split()\n        if len(f)<6 or len(tail)<3: raise ValueError('mountinfo record')\n        path=unescape(f[4])\n        if path in out: raise ValueError('stacked mount requires review')\n        out[path]=(f[2],unescape(f[3]),tail[0])\n    if '/' not in out: raise ValueError('no root')\n    return out\n\n\ndef independent(path, info):\n    if path not in info or info[path][1] != '/' or info[path][0].startswith('0:'): return False\n    return all(info[path][0]!=v[0] for p,v in info.items() if p!=path and (p=='/' or path.startswith(p.rstrip('/')+'/')))\n\n\ndef removable(source):\n    # Resolve kernel block class symlinks, then examine partition and disk ancestors.\n    if not source.startswith('/dev/'): return None\n    name=os.path.basename(os.path.realpath(ROOT+source))\n    base=ROOT+'/sys/class/block/'+name\n    if not os.path.exists(base): return None\n    base=os.path.realpath(base)\n    boundary=os.path.realpath(ROOT+'/sys')\n    while base.startswith(boundary+'/'):\n        p=base+'/removable'\n        if os.path.isfile(p):\n            with open(p) as f: value=f.read().strip()\n            if value not in ('0','1'): raise ValueError('removable flag')\n            return value=='1'\n        base=os.path.dirname(base)\n    return None\n\n\ndef scan_argv(path):\n    return ['/usr/bin/find',path,'-xdev','-type','d','-perm','-0002','!','-perm','-1000','-print','-quit']\n\n\ndef check(n):\n    if n in MODULES:\n        module=MODULES[n]; install=[]; blacklist=False\n        for path in sorted(glob.glob(ROOT+'/etc/modprobe.d/*.conf')):\n            with open(path) as f:\n                for line in f:\n                    fields=line.split('#',1)[0].strip().split()\n                    if len(fields)>=2 and fields[1]==module:\n                        if fields[0]=='install': install.append(fields[2:])\n                        if fields==['blacklist',module]: blacklist=True\n        return bool(install) and all(x==['/bin/true'] for x in install) and blacklist\n    if n==29:\n        end=time.monotonic()+24\n        df=subprocess.run(['/usr/bin/df','--local','-P'],capture_output=True,text=True,timeout= max(.01,end-time.monotonic()))\n        if df.returncode or df.stderr: return False\n        lines=df.stdout.splitlines()[1:]\n        if not lines: return False\n        for line in lines:\n            if time.monotonic() >= end: raise ValueError('scan budget exhausted')\n            f=line.split()\n            if len(f)!=6: raise ValueError('df record')\n            result=subprocess.run(scan_argv(unescape(f[5])),capture_output=True,text=True,timeout=max(.01,end-time.monotonic()))\n            if result.returncode or result.stdout or result.stderr: return False\n        return True\n    ms=mounts()\n    if n==4:\n        selected=[m for m in ms if m[1]=='/tmp']\n        return len(selected)==1 and selected[0][2]=='tmpfs'\n    if n in PARTITIONS: return independent(PARTITIONS[n],mountinfo())\n    if n in FIXED:\n        path,opt=FIXED[n]; selected=[m for m in ms if m[1]==path]\n        return len(selected)==1 and opt in selected[0][3]\n    opt=('nodev','nosuid','noexec')[(n-20)%3]\n    if 20<=n<=22:\n        selected=[]; unknown=False\n        for m in ms:\n            if m[0].startswith('/dev/'):\n                r=removable(m[0])\n                if r is None: unknown=True\n                if r: selected.append(m)\n        if any(opt not in m[3] for m in selected): return False\n        if unknown or not selected: return None\n    elif 23<=n<=25:\n        info=mountinfo(); homes=set()\n        for line in read('/etc/passwd').splitlines():\n            if not line.strip() or line.lstrip().startswith('#'): continue\n            f=line.split(':')\n            if len(f)!=7: raise ValueError('passwd record')\n            if int(f[2])>=1000 and f[0]!='nobody': homes.add(f[5])\n        selected=[m for m in ms if m[1] in homes and independent(m[1],info)]\n    elif 26<=n<=28:\n        selected=[m for m in ms if m[2] in ('nfs','nfs4')]\n    else: raise ValueError('unknown rule')\n    if not selected: return None\n    return all(opt in m[3] for m in selected)\n\"\"\"P2B8 predicates run on synthetic trees and mocked subprocesses only.\"\"\"\nimport contextlib\nimport io\nimport json\nfrom pathlib import Path\nimport subprocess\nimport tempfile\nimport unittest\nfrom unittest.mock import patch\nfrom linuxgcb import batch8 as b, p2b8_runtime as rt\nfrom linuxgcb.argv import w_strtok\nfrom linuxgcb.catalog import ROOT\nfrom linuxgcb.coverage import manifest\n\n\nclass P2B8Tests(unittest.TestCase):\n    def setUp(self):\n        self.tmp=tempfile.TemporaryDirectory(); self.addCleanup(self.tmp.cleanup)\n        old=rt.ROOT; rt.ROOT=self.tmp.name; self.addCleanup(setattr,rt,'ROOT',old)\n\n    def put(self,path,text):\n        p=Path(self.tmp.name+path);p.parent.mkdir(parents=True,exist_ok=True);p.write_text(text)\n\n    def tree(self):\n        self.put('/etc/modprobe.d/local.conf','\\n'.join('install '+m+' /bin/true\\nblacklist '+m for m in rt.MODULES.values()))\n        paths=['/','/tmp','/var','/var/tmp','/var/log','/var/log/audit','/home','/dev/shm','/media/disk','/home/alice','/mnt/nfs']\n        self.put('/proc/mounts','\\n'.join(f'/dev/d{i} {p} '+('tmpfs' if p in ('/tmp','/dev/shm') else 'nfs4' if p=='/mnt/nfs' else 'xfs')+' rw,nodev,nosuid,noexec 0 0' for i,p in enumerate(paths)))\n        self.put('/proc/self/mountinfo','\\n'.join(f'{i+1} 0 8:{i} / {p} rw - xfs /dev/d{i} rw' for i,p in enumerate(paths)))\n        for i in range(11): self.put('/sys/class/block/d'+str(i)+'/removable','1')\n        self.put('/etc/passwd','alice:x:1000:1000::/home/alice:/bin/bash\\nnobody:x:65534:65534::/nonexistent:/sbin/nologin')\n\n    def output(self,n):\n        with contextlib.redirect_stdout(io.StringIO()) as out:\n            exec(b.script(n).replace(\"ROOT = ''\",'ROOT = '+repr(self.tmp.name),1),{})\n        return out.getvalue()\n\n    def test_all_sources_argv_and_single_commit(self):\n        self.assertEqual(len(b.ADDED),46);self.assertEqual(len(rt.MODULES),20)\n        self.assertEqual(manifest()['counts']['implemented'],282)\n        self.tree()\n        def run(argv,**kwargs):\n            return subprocess.CompletedProcess(argv,0,'Filesystem 1024-blocks Used Available Capacity Mounted on\\n/dev/d0 10 1 9 10% /\\n' if argv[0].endswith('/df') else '','')\n        with patch.object(rt.subprocess,'run',side_effect=run):\n            for n in sorted(b.ADDED):\n                self.assertEqual(b.sources()[n]['category'],'磁碟與檔案系統')\n                argv=w_strtok(b.rules()[n][0][0][2:]); self.assertEqual(argv[:2],['/usr/bin/python3','-c']);self.assertEqual(len(argv),3)\n                self.assertEqual(argv[2],b.script(n));self.assertNotIn('->',argv[2]);self.assertEqual(argv[2].count(\"print('PASS')\"),1)\n                compile(argv[2],'<candidate>','exec')\n                self.assertEqual(self.output(n),'PASS\\n',n)\n\n    def test_module_exact_values_comments_missing_conflicts(self):\n        for n,module in rt.MODULES.items():\n            for text,expected in [('',False),('# install '+module+' /bin/true\\n# blacklist '+module,False),(' install '+module+' /bin/true  # ok\\n blacklist '+module+' ',True),('install '+module+'suffix /bin/true\\nblacklist '+module,False),('install '+module+' /bin/false\\nblacklist '+module,False),('install '+module+' /bin/true extra\\nblacklist '+module,False)]:\n                self.put('/etc/modprobe.d/test.conf',text);self.assertEqual(rt.check(n),expected,(n,text))\n        self.put('/etc/modprobe.d/test.conf','install cramfs /bin/true\\nblacklist cramfs')\n        self.put('/etc/modprobe.d/other.conf','install cramfs /bin/false')\n        self.assertFalse(rt.check(1))\n\n    def test_mount_tokens_missing_comments_and_bind(self):\n        self.tree()\n        for n,(path,opt) in rt.FIXED.items():\n            self.put('/proc/mounts',f'# /dev/x {path} xfs rw,{opt} 0 0\\n/dev/x / xfs rw 0 0')\n            self.assertFalse(rt.check(n))\n            self.put('/proc/mounts',f'/dev/x {path} xfs rw,{opt}_bad 0 0')\n            self.assertFalse(rt.check(n))\n            self.put('/proc/mounts',f'/dev/x {path} xfs rw,{opt} 0 0');self.assertTrue(rt.check(n))\n        self.tree()\n        for n,path in rt.PARTITIONS.items():\n            for dev,root in [('8:0','/'),('8:90','/subdir'),('0:90','/')]:\n                self.put('/proc/self/mountinfo',f'1 0 8:0 / / rw - xfs /dev/root rw\\n2 1 {dev} {root} {path} rw - xfs /dev/x rw')\n                self.assertFalse(rt.check(n),(n,dev,root))\n        self.put('/proc/mounts','/dev/x /tmp xfs rw 0 0');self.assertFalse(rt.check(4))\n\n    def test_conditional_review_and_option_fail(self):\n        self.tree()\n        self.put('/proc/mounts','/dev/root / xfs rw 0 0')\n        with patch.object(rt,'removable',return_value=False):\n            for n in range(20,29):self.assertIsNone(rt.check(n),n)\n        for n in range(20,29):self.assertEqual(self.output(n),'REVIEW\\n',n)\n        self.tree()\n        self.put('/proc/mounts','/dev/usb /media/x xfs rw 0 0\\nhost:/export /mnt/nfs nfs rw 0 0\\n/dev/d9 /home/alice xfs rw 0 0')\n        with patch.object(rt,'removable',return_value=True):\n            for n in range(20,29):self.assertFalse(rt.check(n),n)\n\n    def test_sysfs_partition_parent(self):\n        self.put('/sys/class/block/sdb/sdb1/partition','1')\n        self.put('/sys/class/block/sdb/removable','1\\n')\n        base=Path(self.tmp.name+'/sys/class/block');(base/'sdb1').symlink_to(base/'sdb/sdb1')\n        self.assertTrue(rt.removable('/dev/sdb1'))\n        self.put('/sys/class/block/sdb/removable','0');self.assertFalse(rt.removable('/dev/sdb1'))\n        self.assertIsNone(rt.removable('/dev/missing'))\n\n    def test_scan_fail_fast_errors_timeout(self):\n        argv=rt.scan_argv('/');self.assertIn('-xdev',argv);self.assertEqual(argv[-2:],['-print','-quit'])\n        df=subprocess.CompletedProcess([],0,'header\\n/dev/a 10 1 9 10% /\\n/dev/b 10 1 9 10% /home\\n','')\n        for code,out,err in [(0,'/bad\\n',''),(1,'',''),(0,'','denied')]:\n            with patch.object(rt.subprocess,'run',side_effect=[df,subprocess.CompletedProcess([],code,out,err)]) as run:\n                self.assertFalse(rt.check(29));self.assertEqual(run.call_count,2)\n        with patch.object(rt.subprocess,'run',side_effect=subprocess.TimeoutExpired('find',24)):\n            self.assertEqual(self.output(29),'')\n        for n in b.ADDED:\n            with patch('builtins.open',side_effect=PermissionError),patch('glob.glob',side_effect=PermissionError),patch('subprocess.run',side_effect=OSError):\n                self.assertEqual(self.output(n),'',n)\n\n    def test_original_236_rules_and_protected_artifacts(self):\n        count=0\n        for p in (ROOT/'policies').glob('*.yml'):\n            old=json.loads(subprocess.check_output(['git','show','d5e32f0:policies/'+p.name],cwd=ROOT))\n            new={c['id']:c for c in json.loads(p.read_text())['checks']}\n            for c in old['checks']:self.assertEqual(c,new[c['id']]);count+=1\n        self.assertEqual(count,236)\n        self.assertEqual(subprocess.check_output(['git','diff','--name-only','d5e32f0','--','tests/fixtures','tests/fix5_baseline.json','docs/*TEST_OUTPUT*'],cwd=ROOT,text=True),'')\n","exit_code":0,"status":"completed"}}

      filename = 'linuxgcb_'+profile+'.yml'\n        checks = []\n        for row in rows:\n            if row['implementation'] != 'candidate' or row['profile'] != profile:\n                continue\n            checks.append(dict(id=row['sca_id'], title=row['gcb_id']+' '+row['title'],\n                description=PREFIX+expected[row['gcb_id']]+(' ｜ P2B8 執行審查 ' if row['sca_id']-900000 in BATCH8 else ' ｜ P2B7 執行審查 ' if row['sca_id']-900000 in BATCH7 else ' ｜ P2B6 執行審查 ' if row['sca_id']-900000 in BATCH6 else ' ｜ P2B3 執行審查 ' if row['sca_id']-900000 in BATCH3 else ' ｜ BATCH2 執行審查 ' if row['sca_id']-900000 in BATCH2 else ' ｜ Q1 執行審查 ')+row['execution_review']+'；coverage='+row['coverage']+'；'+','.join(row['issue_ids'])+'；raw PASS 非已驗證符合。'+row['pending'],\n                compliance=[{'twgcb': [row['gcb_id']]}], regex_type='pcre2', condition='all',\n                rules=[emit_rule(target, pattern) for target, pattern in definitions()[int(row['gcb_id'][-4:])]]))\n        policy = dict(policy=dict(id='linuxgcb_rhel9_'+profile+'_v01', file=filename,\n                      name='RHEL9 GCB v1.2 '+profile+' v0.1 UNVALIDATED',\n                      description='未驗證候選政策；僅供核准 RHEL9 試點，非完整符合性檢核', regex_type='pcre2'),\n                      requirements=dict(title='僅 RHEL 9', description='角色由核准群組控制',\n                        condition='all', rules=['f:/etc/os-release -> r:^ID=\"?rhel\"?$',\n                                               'f:/etc/os-release -> r:^VERSION_ID=\"?9([.][0-9]+)*\"?$']),\n                      checks=checks)\n        (ROOT/'policies'/filename).write_text(json.dumps(policy, ensure_ascii=False, indent=2)+'\\n')\n    hashes = {p.name: digest(p) for p in sorted((ROOT/'policies').glob('*.yml'))}\n    (ROOT/'data/policy_hashes.json').write_text(json.dumps(hashes, indent=2)+'\\n')\n    from .coverage import write\n    write()\n    validate()\n\n\ndef require(condition):\n    if not condition:\n        raise ValueError('候選政策結構、mapping 或 hash 不符')\n\n\ndef validate():\n    rows = {r['sca_id']: r for r in registry()}\n    seen = set()\n    for path in sorted((ROOT/'policies').glob('*.yml')):\n        p = json.loads(path.read_text())\n        require(p['policy']['file'] == path.name and p['policy']['regex_type']=='pcre2')\n        require(p['requirements'] == dict(title='僅 RHEL 9', description='角色由核准群組控制',\n            condition='all', rules=['f:/etc/os-release -> r:^ID=\"?rhel\"?$',\n                                   'f:/etc/os-release -> r:^VERSION_ID=\"?9([.][0-9]+)*\"?$']))\n        for c in p['checks']:\n            require(c['id'] not in seen and rows[c['id']]['included'])\n            seen.add(c['id'])\n            require(parse_description(c.get('description')) == values()[rows[c['id']]['gcb_id']])\n            require((' ｜ P2B8 ' if c['id']-900000 in BATCH8 else ' ｜ P2B7 ' if c['id']-900000 in BATCH7 else ' ｜ P2B6 ' if c['id']-900000 in BATCH6 else ' ｜ P2B3 ' if c['id']-900000 in BATCH3 else ' ｜ BATCH2 ' if c['id']-900000 in BATCH2 else ' ｜ Q1 ') in c['description'])\n            require(c['regex_type'] == 'pcre2' and c['condition'] == 'all')\n            require(c['compliance'] == [{'twgcb': [rows[c['id']]['gcb_id']]}])\n            require(rows[c['id']]['policy_id'] == p['policy']['id'])\n            require(c['rules'] == [emit_rule(a,b) for a,b in definitions()[c['id']-900000]])\n            for rule in c['rules']:\n                target, _ = rule.split(' -> ', 1)\n                require(target.removeprefix('not ').startswith('c:/'))\n                if c['id']-900000 not in BATCH2 | BATCH3 | BATCH6 | BATCH7 | BATCH8:\n                    require(not any(x in target for x in ('|',';', '&&', '$', '`')))\n                parse_rule(rule)\n    require(seen == {900000+n for n in definitions()})\n    hashes = json.loads((ROOT/'data/policy_hashes.json').read_text())\n    require(hashes == {p.name:digest(p) for p in (ROOT/'policies').glob('*.yml')})\n    from .coverage import manifest\n    require(json.loads((ROOT/'data/coverage_manifest.json').read_text()) == manifest())\n    require(seen == {r['sca_id'] for r in rows.values() if r['implementation']=='candidate'})\n    return len(seen)\n\n\n@lru_cache(maxsize=1)\ndef supported_patterns():\n    return frozenset(p.lstrip('!') for rules in definitions().values() for _,p in rules) | {\n971fbc51601a08352ee80aadb15a23a68e4aab78\nTWGCB-01-012_Red Hat Enterprise Linux 9政府組態基準說明文件(伺服器)v1.2_1140612.docx\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"cat > linuxgcb/fix7_runtime.py <<'PY'\n\\\"\\\"\\\"Mountinfo overrides embedded only in the nine FIX7 candidates.\\\"\\\"\\\"\n\n\ndef mountinfo():\n    class MountInfo(dict):\n        pass\n    out = MountInfo()\n    out.duplicates = set()\n    for line in read('/proc/self/mountinfo').splitlines():\n        a,b = line.split(' - ',1)\n        f = a.split(); tail = b.split()\n        if len(f)<6 or len(tail)<3: raise ValueError('mountinfo record')\n        path=unescape(f[4])\n        if path in out: out.duplicates.add(path)\n        out[path]=(f[2],unescape(f[3]),tail[0])\n    if '/' not in out: raise ValueError('no root')\n    return out\n\n\ndef independent(path, info):\n    if any(p==path or p=='/' or path.startswith(p.rstrip('/')+'/') or\n           p.startswith(path.rstrip('/')+'/') for p in info.duplicates):\n        raise ValueError('stacked mount requires review')\n    if path not in info or info[path][1] \"'!= '\"'/' or info[path][0].startswith('0:'): return False\n    return all(info[path][0]\"'!=v[0] for p,v in info.items() if p!=path and (p=='\"'/' or path.startswith(p.rstrip('/')+'/')))\nPY\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('linuxgcb/batch8.py')\ns=p.read_text().replace('from . import p2b8_runtime','from . import p2b8_runtime, fix7_runtime')\ns=s.replace(\\\"    return inspect.getsource(p2b8_runtime) + '\\\\\\\\ntry:\\\",\\\"    runtime = inspect.getsource(p2b8_runtime)\\\\n    if n in {8,9,13,14,15,16,23,24,25}:\\\\n        runtime += '\\\\\\\\n' + inspect.getsource(fix7_runtime.mountinfo) + '\\\\\\\\n' + inspect.getsource(fix7_runtime.independent)\\\\n    return runtime + '\\\\\\\\ntry:\\\")\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

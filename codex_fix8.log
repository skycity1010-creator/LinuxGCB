lt['warnings'], ensure_ascii=False))\n    else:\n        validate()\n        result = render(json.loads(Path(args.snapshot).read_text()), args.out,\n                        timestamp(args.now) if args.now else datetime.now(timezone.utc))\n        print(json.dumps(result, ensure_ascii=False, indent=2))\n\nif __name__ == '__main__':\n    main()\n34:def build():\n54:        (ROOT/'policies'/filename).write_text(json.dumps(policy, ensure_ascii=False, indent=2)+'\\n')\n56:    (ROOT/'data/policy_hashes.json').write_text(json.dumps(hashes, indent=2)+'\\n')\n57:    from .coverage import write\n58:    write()\n92:    hashes = json.loads((ROOT/'data/policy_hashes.json').read_text())\n7a8a3dbaccffe64ae4c99dc186d28a7de3da316f\n\"\"\"Offline wm_exec argv subset: double quotes group; backslash escapes.\n\nSingle quotes are ordinary bytes. No shell expansion occurs at this layer.\nMalformed input is rejected rather than guessing an executable argv.\n\"\"\"\n\n\ndef w_strtok(command):\n    argv, word = [], []\n    quoted = active = False\n    i = 0\n    while i < len(command):\n        char = command[i]\n        if char == '\\\\':\n            i += 1\n            if i == len(command):\n                raise ValueError('Trailing escape')\n            word.append(command[i])\n            active = True\n        elif char == '\"':\n            quoted = not quoted\n            active = True\n        elif char in ' \\t\\r\\n' and not quoted:\n            if active:\n                argv.append(''.join(word))\n                word, active = [], False\n        else:\n            word.append(char)\n            active = True\n        i += 1\n    if quoted:\n        raise ValueError('Unpaired double quote')\n    if active:\n        argv.append(''.join(word))\n    return argv\n\n\ndef quote_argument(value):\n    \"\"\"Encode one argument and verify its round trip through the model.\"\"\"\n    encoded = '\"' + value.replace('\\\\', '\\\\\\\\').replace('\"', '\\\\\"') + '\"'\n    assert w_strtok(encoded) == [value]\n    return encoded\n","exit_code":0,"status":"completed"}}

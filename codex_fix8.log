{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'cat linuxgcb/p2b10_runtime.py; cat linuxgcb/batch10.py; cat tests/test_p2b10.py; cat tests/test_fix7.py; cat docs/FIX7_REVIEW.md'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'cat linuxgcb/p2b10_runtime.py; cat linuxgcb/batch10.py; cat tests/test_p2b10.py; cat tests/test_fix7.py; cat docs/FIX7_REVIEW.md'","aggregated_output":"\"\"\"Read-only observations; no shell or service mutations.\"\"\"\nimport os\nimport re\nimport subprocess\n\n\ndef observe(argv, states):\n    result = subprocess.run(argv, capture_output=True, text=True, timeout=8,\n                            env=dict(os.environ, LC_ALL='C'))\n    value = result.stdout.strip()\n    return not result.stderr and (value, result.returncode) in states\n\n\ndef check(n):\n    if n == 244:\n        for service in ('iptables', 'ip6tables'):\n            if not observe(['/usr/bin/systemctl', 'is-enabled', service], {('masked', 1)}):\n                return False\n            if not observe(['/usr/bin/systemctl', 'is-active', service], {('inactive', 3)}):\n                return False\n        return True\n    if n == 246:\n        result = subprocess.run(['/usr/bin/firewall-cmd', '--get-default-zone'],\n                                capture_output=True, text=True, timeout=8,\n                                env=dict(os.environ, LC_ALL='C'))\n        return (result.returncode == 0 and not result.stderr and\n                re.fullmatch(r'[A-Za-z0-9_][A-Za-z0-9_-]*', result.stdout.strip()) is not None)\n    return False\n\"\"\"P2B10 source-bound offline candidates, direct w_strtok Python argv.\"\"\"\nimport inspect\nimport hashlib\nfrom zipfile import ZipFile\nfrom xml.etree import ElementTree as ET\nfrom functools import lru_cache\nfrom pathlib import Path\nfrom . import p2b10_runtime\nfrom .argv import quote_argument\nADDED = {244, 246}\n\n\n@lru_cache(maxsize=1)\ndef sources():\n    from scripts.inventory import extract\n    root = Path(__file__).resolve().parents[1]\n    docx = root/'docs/references/gcb-rhel9-v1.2.docx'\n    if hashlib.sha256(docx.read_bytes()).hexdigest() != '986effd9501b1fd97776129c6691cf8fc98246bd04514347322f3337508e0e5b':\n        raise ValueError('GCB v1.2 reference hash changed')\n    ns = {'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}\n    xml = ET.fromstring(ZipFile(docx).read('word/document.xml'))\n    tables = [['\\n'.join(''.join(t.text or '' for t in p.findall('.//w:t',ns))\n              for p in cell.findall('.//w:p',ns)) for cell in tr.findall('w:tc',ns)]\n              for tr in xml.findall('.//w:tr',ns)]\n    out = {}\n    for r in extract(next(root.glob('*.xlsx'))):\n        n = int(r['gcb_id'][-4:])\n        if n not in ADDED:\n            continue\n        matches = [c for c in tables if r['gcb_id'] in c and c[-1] == r['expected'] and c[-2] == r['configuration_method']]\n        if not matches or any(c[-2:] != matches[0][-2:] for c in matches):\n            raise ValueError('GCB DOCX/XLSX source mismatch: '+r['gcb_id'])\n        out[n] = dict(r, configuration_method=matches[0][-2])\n    if set(out) != ADDED:\n        raise ValueError('incomplete P2B10 source set')\n    return out\n\n\ndef script(n):\n    return inspect.getsource(p2b10_runtime) + '\\ntry:\\n    ok = check(' + repr(n) + \")\\nexcept (OSError, ValueError, UnicodeError, subprocess.SubprocessError):\\n    ok = False\\nif ok:\\n    print('PASS')\\n\"\n\n\n@lru_cache(maxsize=1)\ndef rules():\n    sources()\n    return {n: [('c:/usr/bin/python3 -c '+quote_argument(script(n)), '^PASS$')] for n in sorted(ADDED)}\n\n\ndef caveat(n):\n    note = ('來源 --now mask 涵蓋 iptables 與 ip6tables；唯讀 is-enabled 須 masked/rc1，is-active 須 inactive/rc3；disabled 不等同遮蔽，缺服務不豁免。' if n == 244 else\n            '以 --get-default-zone 唯讀對應來源設定區域；有效非空區域名稱即可，public 為來源允許範例；不推論是否曾人工設定。')\n    return note + ' P2B10 UNVALIDATED；human_review_pending；execution_review=blocked；來源與引擎語意待批。'\n\"\"\"Synthetic source, argv, subprocess and unchanged baseline checks.\"\"\"\nimport contextlib\nimport io\nimport json\nimport subprocess\nimport unittest\nfrom unittest.mock import patch\nfrom linuxgcb import batch10 as b\nfrom linuxgcb.argv import w_strtok\nfrom linuxgcb.catalog import ROOT\nfrom linuxgcb.coverage import manifest\nfrom linuxgcb.policy import simulate\n\n\nclass P2B10Tests(unittest.TestCase):\n    def output(self, n, results):\n        with patch('subprocess.run', side_effect=results) as run, contextlib.redirect_stdout(io.StringIO()) as out:\n            exec(w_strtok(b.rules()[n][0][0][2:])[2], {})\n        for call in run.call_args_list:\n            self.assertNotIn('shell', call.kwargs)\n            self.assertEqual(call.kwargs['timeout'], 8)\n            self.assertEqual(call.kwargs['env']['LC_ALL'], 'C')\n        return out.getvalue(), run\n\n    def cp(self, value, rc=0, err=''):\n        return subprocess.CompletedProcess([], rc, value, err)\n\n    def good(self):\n        return [self.cp('masked\\n',1), self.cp('inactive\\n',3)] * 2\n\n    def test_source_and_argv(self):\n        self.assertEqual(set(b.sources()), {244,246})\n        self.assertIn('#systemctl --now mask ip6tables', b.sources()[244]['configuration_method'])\n        self.assertIn('--set-default-zone=public', b.sources()[246]['configuration_method'])\n        checks={c['id']:c for c in json.loads((ROOT/'policies/linuxgcb_firewalld.yml').read_text())['checks']}\n        for n in b.ADDED:\n            target, pattern=b.rules()[n][0]\n            argv=w_strtok(target[2:])\n            self.assertEqual(argv[:2], ['/usr/bin/python3','-c'])\n            self.assertEqual(len(argv),3)\n            self.assertEqual(argv[2], b.script(n))\n            self.assertNotIn('->', argv[2])\n            self.assertEqual(argv[2].count(\"print('PASS')\"),1)\n            for value, want in [('PASS\\n','PASS'), ('','FAIL')]:\n                self.assertEqual(simulate(checks[900000+n], {target:dict(stdout=value)}),want)\n        counts=manifest()['counts']\n        self.assertEqual((counts['implemented'],counts['remaining'],counts['included'],counts['excluded']), (307,0,307,7))\n\n    def test_both_services_and_status_rc(self):\n        out, run=self.output(244,self.good())\n        self.assertEqual(out,'PASS\\n')\n        self.assertEqual([c.args[0] for c in run.call_args_list], [\n            ['/usr/bin/systemctl', action, service]\n            for service in ('iptables','ip6tables') for action in ('is-enabled','is-active')])\n        for pos in range(4):\n            for value,rc in [('disabled',1),('enabled',0),('active',0),('failed',3),('not-found',4),('',1),('masked',0),('inactive',0),('masked\\ninactive',1)]:\n                results=self.good();results[pos]=self.cp(value,rc)\n                self.assertEqual(self.output(244,results)[0],'',(pos,value,rc))\n\n    def test_zone_including_public(self):\n        for value in ['public\\n','drop\\n','trusted\\n','custom-zone_1\\n']:\n            out,run=self.output(246,[self.cp(value)])\n            self.assertEqual(out,'PASS\\n')\n            self.assertEqual(run.call_args.args[0], ['/usr/bin/firewall-cmd','--get-default-zone'])\n        for value in ['', ' \\n', 'public\\ndrop\\n', 'Error: denied', 'not running']:\n            self.assertEqual(self.output(246,[self.cp(value)])[0],'')\n\n    def test_errors_are_mocked_and_never_commit(self):\n        for n in b.ADDED:\n            for error in [PermissionError(), FileNotFoundError(), UnicodeError(), ValueError(), subprocess.TimeoutExpired('mock',8), subprocess.SubprocessError()]:\n                self.assertEqual(self.output(n,[error])[0],'')\n            for pos in range(4 if n==244 else 1):\n                for result in [self.cp('masked',1,'denied'), self.cp('public',1),self.cp('',0)]:\n                    results=self.good() if n==244 else [self.cp('public')]\n                    results[pos]=result\n                    self.assertEqual(self.output(n,results)[0],'')\n\n    def test_original_305_checks_unchanged(self):\n        count=0\n        for p in (ROOT/'policies').glob('*.yml'):\n            old=json.loads(subprocess.check_output(['git','show','21e56dbc1040ce26defdb972bf7e12a37de382d2:policies/'+p.name],cwd=ROOT))\n            new=json.loads(p.read_text())\n            self.assertEqual(old['policy'],new['policy'])\n            self.assertEqual(old['requirements'],new['requirements'])\n            current={c['id']:c for c in new['checks']}\n            for c in old['checks']:\n                self.assertEqual(c,current[c['id']]); count+=1\n        self.assertEqual(count,305)\n        self.assertEqual(subprocess.check_output(['git','diff','--name-only','HEAD','--','tests/fixtures','tests/fix5_baseline.json','docs/*TEST_OUTPUT*'],cwd=ROOT,text=True),'')\nfrom linuxgcb.batch9 import ADDED as BATCH9\nfrom linuxgcb.batch10 import ADDED as BATCH10\n\"\"\"Synthetic R18 regressions; execute emitted candidates on isolated trees.\"\"\"\nimport json\nimport subprocess\nimport unittest\nfrom linuxgcb.catalog import ROOT\nimport test_p2b8 as p2b8\n\nBASELINE = '971fbc51601a08352ee80aadb15a23a68e4aab78'\nAFFECTED = {8,9,13,14,15,16,23,24,25}\n\n\nclass Fix7Tests(unittest.TestCase):\n    setUp = p2b8.P2B8Tests.setUp\n    put = p2b8.P2B8Tests.put\n    output = p2b8.P2B8Tests.output\n\n    def tree(self):\n        self.info = ('1 0 253:0 / / rw - xfs /dev/mapper/root rw\\n'\n                     '2 1 253:1 / /var rw - xfs /dev/mapper/var rw\\n'\n                     '3 1 253:2 / /home rw - xfs /dev/mapper/home rw\\n'\n                     '4 1 0:40 / /proc/sys/fs/binfmt_misc rw - autofs systemd-1 rw\\n'\n                     '5 4 0:41 / /proc/sys/fs/binfmt_misc rw - binfmt_misc binfmt_misc rw\\n')\n        self.put('/proc/self/mountinfo', self.info)\n        self.put('/proc/mounts', '/dev/mapper/root / xfs rw 0 0\\n'\n                 '/dev/mapper/var /var xfs rw 0 0\\n'\n                 '/dev/mapper/home /home xfs rw 0 0\\n'\n                 'tmpfs /dev/shm tmpfs rw,nodev,nosuid 0 0\\n')\n        self.put('/etc/passwd', 'alice:x:1000:1000::/home:/bin/bash\\n')\n\n    def test_r18_independent_lvs_and_real_missing_options(self):\n        self.tree()\n        for n in (8,15): self.assertEqual(self.output(n), 'PASS\\n', n)\n        for n in (9,13,14,16,19,23,24,25): self.assertEqual(self.output(n), '', n)\n        self.put('/proc/mounts', '/dev/mapper/home /home xfs rw,nodev,nosuid,noexec 0 0\\n')\n        for n in (16,23,24,25): self.assertEqual(self.output(n), 'PASS\\n', n)\n\n    def test_related_stacks_fail_in_either_order_and_with_component_boundaries(self):\n        for n,path in ((8,'/var'),(15,'/home'),(23,'/home'),(24,'/home'),(25,'/home')):\n            for duplicate in (path, '/', path+'/nested'):\n                for reverse in (False,True):\n                    self.tree()\n                    lines=self.info.splitlines()\n                    record=f'9 1 253:9 / {duplicate} rw - xfs /dev/other rw'\n                    if duplicate.endswith('/nested'):\n                        lines.append(record)\n                    lines.append(record)\n                    self.put('/proc/self/mountinfo', '\\n'.join(reversed(lines) if reverse else lines))\n                    self.assertEqual(self.output(n), '', (n,duplicate,reverse))\n        self.tree()\n        self.put('/proc/self/mountinfo', self.info+'6 1 253:3 / /var/tmp rw - xfs /dev/tmp rw\\n'\n                 '7 1 253:4 / /var/tmp rw - xfs /dev/other rw\\n')\n        self.assertEqual(self.output(9), '')\n        self.assertEqual(self.output(8), '')\n        self.assertEqual(self.output(15), 'PASS\\n')\n        self.tree()\n        self.put('/proc/self/mountinfo', self.info+'6 1 253:3 / /variable rw - xfs /dev/a rw\\n'\n                 '7 1 253:4 / /variable rw - xfs /dev/b rw\\n')\n        self.assertEqual(self.output(8), 'PASS\\n')\n\n    def test_partition_predicates_and_parse_errors_still_fail(self):\n        for n,path in ((8,'/var'),(15,'/home')):\n            for dev,root in (('253:0','/'),('253:9','/subdir'),('0:90','/')):\n                self.tree()\n                lines=[line for line in self.info.splitlines() if line.split()[4]!=path]\n                lines.append(f'9 1 {dev} {root} {path} rw - xfs /dev/x rw')\n                self.put('/proc/self/mountinfo','\\n'.join(lines))\n                self.assertEqual(self.output(n),'',(n,dev,root))\n            for text in ('bad record', self.info.replace('1 0 253:0 / / rw - xfs /dev/mapper/root rw\\n','')):\n                self.put('/proc/self/mountinfo',text)\n                self.assertEqual(self.output(n),'')\n\n    def test_exact_nine_rules_and_protected_artifacts(self):\n        old={}; new={}\n        for p in (ROOT/'policies').glob('*.yml'):\n            prior=json.loads(subprocess.check_output(['git','show',BASELINE+':policies/'+p.name],cwd=ROOT))\n            current=json.loads(p.read_text())\n            self.assertEqual(prior['policy'],current['policy'])\n            old.update({c['id']:c for c in prior['checks']})\n            new.update({c['id']:c for c in current['checks']})\n        self.assertEqual(len(new),307)\n        self.assertEqual({n-900000 for n in old if old[n]!=new[n]},AFFECTED)\n        for n in old: self.assertEqual(dict(new[n],rules=old[n]['rules']),old[n])\n        for name in ('data/coverage_manifest.json','data/scope_registry.json'):\n            prior=json.loads(subprocess.check_output(['git','show',BASELINE+':'+name],cwd=ROOT))\n            current=json.loads((ROOT/name).read_text())\n            if isinstance(prior,list):\n                self.assertEqual([r for r in prior if r['sca_id']-900000 not in (BATCH9 | BATCH10)],[r for r in current if r['sca_id']-900000 not in (BATCH9 | BATCH10)])\n            else:\n                self.assertEqual(prior['reviewed'],[r for r in current['reviewed'] if r['sca_id']-900000 not in (BATCH9 | BATCH10)])\n                for key,value in prior['counts'].items():\n                    delta={'implemented':25,'added':25,'remaining':-25,'partial':25,'reviewed':25,'execution_blocked':25}.get(key,0)\n                    self.assertEqual(current['counts'][key],value+delta)\n        self.assertEqual(subprocess.check_output(['git','diff','21e56dbc1040ce26defdb972bf7e12a37de382d2','--name-only','--','tests/fixtures','docs/references','tests/fix5_baseline.json','docs/*TEST_OUTPUT*'],cwd=ROOT,text=True),'')\n# FIX7：P2B8 mountinfo stacked-mount 守衛範圍\n\n基準 commit：`971fbc51601a08352ee80aadb15a23a68e4aab78`。僅 0008、0009、0013、0014、0015、0016、0023、0024、0025 的內嵌 runtime 更新；其餘 273 條完整 checks 與 rules 不變。\n\n## 前後對照與選擇理由\n\n修正前，mountinfo 任一重複掛載點立即拋出 ValueError，外層捕捉後不輸出 PASS，導致不相關的 binfmt_misc 雙掛載污染獨立分割檢查。\n\n採用任務選項二：記錄重複路徑，在 independent(path, info) 僅針對目標本身、祖先鏈或子樹的重複掛載拋出 ValueError。路徑以 `/` 邊界比較，`/variable` 不屬於 `/var` 子樹。解析時雖保存最後一筆資料，相關重複掛載一律先拒絕，絕不憑最後一筆給 PASS；不相關重複路徑不參與目標獨立性判定。這避免假定 mountinfo 列出順序能證明可見的頂層掛載，也符合目標重複掛載仍須保守 FAIL 的驗收要求。\n\n原 p2b8_runtime.py 保持原樣；batch8.script() 僅對指定九條加入 fix7_runtime.py 的兩個函式覆寫。0016 雖在指定名單內，實際仍使用原 FIXED 分支與 /proc/mounts，沒有改變掛載選項判斷。獨立分割仍要求精確掛載點、root=/、非 0: 裝置號，且裝置不同於所有祖先；bind/subpath、缺掛載及解析錯誤仍不通過。0023–0025 的帳號篩選、獨立家目錄選取及選項要求不變。\n\n## R18 證據與 .61 推導\n\n以下為任務提供的 R18 真機觀察，非本次離線執行所得；本工作區沒有找到 R18 原始輸出檔，未連線補採，也未製造完整真機紀錄。\n\n任務所述 mountinfo 掛載點欄位 `uniq -d` 輸出：\n\n```text\n/proc/sys/fs/binfmt_misc\n```\n\n任務指出這是 autofs 觸發與實際 binfmt_misc 兩筆，且 .61 的 /var、/home 為獨立 LV。離線合成相同結構（不同裝置號、root=/）重現，不將合成裝置號當作真機證據。\n\n| 規則 | 修正前 | 修正後預期及理由 |\n| --- | --- | --- |\n| 0008 /var | 不相關重複掛載引發 FAIL | PASS：獨立 LV，binfmt_misc 不在 /var 祖先或子樹 |\n| 0015 /home | 不相關重複掛載引發 FAIL | PASS：獨立 LV，binfmt_misc 不在 /home 祖先或子樹 |\n| 0009、0013、0014 | FAIL | 仍 FAIL：/var/tmp、/var/log、/var/log/audit 非獨立分割 |\n| 0016、0023–0025 | FAIL | 仍 FAIL：相關 /home 掛載缺 nodev/nosuid/noexec；0023–0025 依既有帳號家目錄適用條件判定 |\n| 0019 /dev/shm | FAIL | 仍 FAIL：缺 noexec，原 /proc/mounts runtime 完全未改 |\n| 目標、祖先或子樹重複掛載 | FAIL | 仍 FAIL：ValueError 經原外層捕捉，不輸出 PASS/REVIEW |\n\n0008/0015 轉 PASS 是根據任務給定真機條件與合成回歸的推導，並非本次重新驗證 .61。政策仍為 UNVALIDATED、partial、human_review_pending、execution_review=blocked。\n\n0020–0022、0026–0028 的 REVIEW 輸出、正則與 raw passed 計數語意全部不變，仍待批。本批未修改來源、TWGCB ID、307/7 scope、282 coverage_manifest、既有 fixtures 或證據檔。\n\n## 驗證\n\n`tests/test_fix7.py` 執行實際產出的內嵌程式，覆蓋 binfmt_misc 雙掛載與 /var、/home 獨立 LV、缺分割與選項、補足選項後 PASS、目標／祖先／子樹重複掛載（含逆序）、路徑邊界、bind/subpath、同祖先裝置、0: 裝置及解析錯誤。另以基準 commit 比較九條以外的完整 checks、九條的非 rules 欄位、coverage_manifest、scope_registry 與保護檔案。\n\n執行命令：\n\n```text\npython3 -m unittest discover -s tests -v\npython3 -m linuxgcb build\npython3 -m linuxgcb validate\ngit diff --check\n```\n\n完整 unittest：115 項全過（15.271 秒）。原 P2B7/P2B8 測試的證據差異基準更新至本次起點：舊基準早於 P2B8，會把已提交的 P2B8_TEST_OUTPUT.txt 新增誤報為本次變更；歷史規則比較保持原基準。證據檔內容未改。\n\nbuild/validate：314 來源、307 候選範圍／7 排除、282 候選規則，UNVALIDATED；其餘 273 條完整 checks diff=0。僅 base 政策及其 policy_hash 更新；coverage_manifest 與 scope_registry 位元組不變。\n\n全程離線，無 SSH、生產 API、服務變更、sudo、秘密讀取或網路操作。環境權限明列 .git 唯讀，依任務例外不嘗試寫入或繞過限制建立 commit，保留工作目錄變更。\n","exit_code":0,"status":"completed"}}

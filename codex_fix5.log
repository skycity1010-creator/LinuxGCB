{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"cat scripts/batch2_fixtures.py; sed -n '1,110p' tests/test_catalog_policy.py; cat tests/test_fix2.py; cat linuxgcb/__main__.py\"","aggregated_output":"\"\"\"Rebuild only BATCH2 synthetic observations from emitted targets; no execution.\"\"\"\nimport copy\nimport json\nfrom linuxgcb.catalog import ROOT\nfrom linuxgcb.batch2 import ABSENT_PACKAGES, ADDED, MARKER, guarded, specs\nfrom linuxgcb.policy import emit_rule\n\n\ndef generated():\n    checks={c['id']:c for p in (ROOT/'policies').glob('*.yml') for c in json.loads(p.read_text())['checks']}\n    result={}\n    for n,items in specs().items():\n        check=checks[900000+n]\n        targets={rule.split(' -> ',1)[0].removeprefix('not ') for rule in check['rules']}\n        positive={t:dict(stdout='',exit_code=0) for t in targets}\n        for cmd,pattern,good,bad in items:\n            rule=emit_rule(guarded(cmd),pattern)\n            assert rule in check['rules'], (n,rule)\n            target=rule.split(' -> ',1)[0].removeprefix('not ')\n            positive[target]['stdout']+='\\n'+good\n        for obs in positive.values():\n            obs['stdout']=obs['stdout'].strip('\\n')+('' if n in ABSENT_PACKAGES else '\\n'+MARKER)\n        # One counterexample per source predicate, preserving all other targets.\n        mutations=[]\n        for cmd,pattern,good,bad in items:\n            obs=copy.deepcopy(positive)\n            target=guarded(cmd)\n            # Keep other predicates on the same command intact; adding an extra\n            # invalid member is the decisive negative case for collection rules.\n            if pattern.startswith('!'):\n                obs[target]['stdout']+='\\n'+bad\n            else:\n                obs[target]['stdout']=obs[target]['stdout'].replace(good,bad)\n            mutations.append(dict(rule=emit_rule(target,pattern),observations=obs))\n        result[str(check['id'])]=dict(positive=positive,negative=mutations[0]['observations'],\n            missing={},empty={t:dict(stdout='',exit_code=0) for t in targets},\n            error={t:dict(error='SYNTHETIC command error') for t in targets},\n            nonzero_matching={t:dict(stdout=o['stdout'],exit_code=1,stderr='SYNTHETIC failure despite matching stdout') for t,o in positive.items()},\n            predicate_negatives=mutations)\n    return result\n\n\ndef main():\n    path=ROOT/'tests/fixtures/rule_outputs.json'\n    data=json.loads(path.read_text())\n    for key in list(data['checks']):\n        if int(key)-900000 in ADDED: del data['checks'][key]\n    data['checks'].update(generated())\n    path.write_text(json.dumps(data,ensure_ascii=False,indent=2)+'\\n')\n\nif __name__=='__main__': main()\nimport json\nimport unittest\nfrom pathlib import Path\nfrom linuxgcb.catalog import ROOT, registry, digest, XLSX_HASH\nfrom linuxgcb.policy import validate, simulate, definitions\nfrom linuxgcb.batch1 import FILES, ADDED\nfrom linuxgcb.coverage import manifest\nfrom linuxgcb.batch3 import ADDED as BATCH3\nfrom linuxgcb.batch2 import ADDED as BATCH2\nfrom scripts.inventory import extract\n\n\nclass CatalogTests(unittest.TestCase):\n    def test_scope_and_source_unchanged(self):\n        rows = registry()\n        self.assertEqual((len(rows), sum(r['included'] for r in rows)), (314,307))\n        self.assertEqual(len({r['sca_id'] for r in rows}),314)\n        self.assertEqual(len({r['gcb_id'] for r in rows}),314)\n        self.assertEqual({r['source_sheet'] for r in rows if not r['included']}, {'Nftables防火牆'})\n        self.assertTrue(next(r for r in rows if r['sca_id']==900245)['included'])\n        self.assertFalse(any(r['gcb_id'].endswith('-0180') for r in rows))\n        self.assertEqual(digest(next(ROOT.glob('*.xlsx'))), XLSX_HASH)\n        self.assertEqual(rows,json.loads((ROOT/'data/scope_registry.json').read_text()))\n\n    def test_raw_controls_unchanged(self):\n        self.assertEqual(extract(next(ROOT.glob('*.xlsx'))),json.loads((ROOT/'data/controls.json').read_text()))\n\n    def test_traceability(self):\n        source = {r['gcb_id']:r for r in extract(next(ROOT.glob('*.xlsx')))}\n        for r in registry():\n            self.assertEqual(r['source_row'],source[r['gcb_id']]['row'])\n            self.assertEqual(r['expected'],source[r['gcb_id']]['expected'])\n            self.assertEqual(r['review_status'],'human_review_pending')\n\n    def test_structural(self):\n        self.assertEqual(validate(),len(definitions()))\n\n    def test_all_positive_negative_missing_error(self):\n        fixtures=json.loads((ROOT/'tests/fixtures/rule_outputs.json').read_text())\n        fixtures['checks'].update(json.loads((ROOT/'tests/fixtures/p2b3/cases.json').read_text())['checks'])\n        self.assertEqual(fixtures['label'],'SYNTHETIC TEST ONLY')\n        checked = set()\n        for p in (ROOT/'policies').glob('*.yml'):\n            for c in json.loads(p.read_text())['checks']:\n                checked.add(str(c['id']))\n                for name, state in [('positive','PASS'),('negative','FAIL'),('missing','UNRESOLVED'),('empty','FAIL'),('error','UNRESOLVED'),('nonzero_matching','PASS')]:\n                    with self.subTest(id=c['id'],case=name):\n                        self.assertEqual(simulate(c,fixtures['checks'][str(c['id'])][name]), state)\n        self.assertEqual(checked,set(fixtures['checks']))\n\n    def test_permission_bit_subset_and_special_bits(self):\n        c=next(c for c in json.loads((ROOT/'policies/linuxgcb_base.yml').read_text())['checks'] if c['id']==900046)\n        target=c['rules'][0].split(' -> ')[0]\n        for mode in range(0o10000):\n            expected='PASS' if mode & ~0o644 == 0 else 'FAIL'\n            self.assertEqual(simulate(c,{target:dict(stdout=format(mode,'o'),exit_code=0)}),expected)\n\n    def test_exit_code_does_not_override_matching_output(self):\n        c=next(c for c in json.loads((ROOT/'policies/linuxgcb_base.yml').read_text())['checks'] if c['id']==900045)\n        target=c['rules'][0].split(' -> ')[0]\n        self.assertEqual(simulate(c,{target:dict(stdout='0:0',exit_code=1)}),'PASS')\n\n    def test_batch_manifest_reconciles_and_docx(self):\n        m=manifest();rows=registry()\n        self.assertEqual({e['sca_id'] for e in m['reviewed']},{900000+n for n in definitions()})\n        self.assertEqual(m['counts']['implemented'],len(definitions()))\n        self.assertEqual(m['counts']['remaining'],307-len(definitions()))\n        self.assertEqual(m['counts']['full']+m['counts']['partial']+m['counts']['blocked'],len(definitions()))\n        self.assertEqual((m['counts']['full'],m['counts']['partial'],m['counts']['blocked']),(0,48+len(BATCH2)+len(BATCH3),5))\n        for e in m['reviewed']:\n            self.assertTrue(all(e['expected'] == c[-1] for c in e['docx_all_cells']))\n            self.assertTrue(all(e['gcb_id'] in c for c in e['docx_all_cells']))\n            n=e['sca_id']-900000\n            method=e['docx_cells'][-2]\n            if n in FILES:\n                self.assertIn(FILES[n][0],method)\n\n    def test_all_mode_masks_exhaustive(self):\n        from linuxgcb.batch1 import mode_pattern\n        import re\n        masks={v for _,kind,v in FILES.values() if kind=='mode'}\n        for mask in masks:\n            pattern=re.compile(mode_pattern(mask))\n            for value in range(0o10000):\n                self.assertEqual(bool(pattern.search(format(value,'o'))),value & ~mask == 0)\n\n    def test_batch_edges_use_emitted_rules(self):\n        import copy\n        checks={c['id']:c for p in (ROOT/'policies').glob('*.yml') for c in json.loads(p.read_text())['checks']}\n        fixtures=json.loads((ROOT/'tests/fixtures/rule_outputs.json').read_text())['checks']\n        for n in sorted(ADDED):\n            check=checks[900000+n];base=fixtures[str(900000+n)]['positive']\n            # 每個子規則必須獨立參與 all；非第一個錯誤亦不可被第一個 PASS 掩蓋。\n            for target in base:\n                obs=copy.deepcopy(base);obs[target]['stdout']='WRONG'\n                self.assertEqual(simulate(check,obs),'FAIL')\n                obs=copy.deepcopy(base);obs[target]['stdout']+='\\nWRONG'\n                self.assertEqual(simulate(check,obs),'PASS') # SCA 逐行存在匹配，不是整個輸出相等\n            if n in FILES:\n                path,kind,value=FILES[n]\n                if kind=='owner':\n                    target='c:/usr/bin/stat -c %U:%G '+path\n                    for owner in ('root:shadow','root:wheel','nobody:root','root:UNKNOWN'):\n                        obs=copy.deepcopy(base);obs[target]['stdout']=owner\n                        self.assertEqual(simulate(check,obs),'PASS' if owner=='root:shadow' and 'shadow' in value else 'FAIL')\n                type_target='c:/usr/bin/stat -c %f '+path\n                if type_target in base:\n                    for mode in ('81a4','a1ff','11a4','21a4','61a4','c1a4'):\n                        obs=copy.deepcopy(base);obs[type_target]['stdout']=mode\n                        self.assertEqual(simulate(check,obs),'FAIL')\n\"\"\"FIX2 regression: execute only synthetic printf/exit, never inventory commands.\"\"\"\nimport json\nimport shlex\nimport subprocess\nimport unittest\n\nfrom linuxgcb.argv import quote_argument, w_strtok\nfrom linuxgcb.batch2 import ABSENT_PACKAGES, ADDED, MARKER, guarded, specs\nfrom linuxgcb.catalog import ROOT\nfrom linuxgcb.policy import simulate\n\n\nclass Fix2Tests(unittest.TestCase):\n    def test_tokenizer_contract(self):\n        self.assertEqual(w_strtok('a \"b c\" d\\\\ e'), ['a', 'b c', 'd e'])\n        self.assertEqual(w_strtok(\"a 'b c'\"), ['a', \"'b\", \"c'\"])\n        self.assertEqual(w_strtok(r'a \"b\\\"c\\\\d\"'), ['a', 'b\"c\\\\d'])\n        for value in ('', 'a b', \"'%s\\\\n'\", '$out; \"x\"'):\n            self.assertEqual(w_strtok(quote_argument(value)), [value])\n\n    def test_all_44_old_commands_fail_and_new_preserve_semantics(self):\n        checks = {c['id']: c for p in (ROOT/'policies').glob('*.yml')\n                  for c in json.loads(p.read_text())['checks']}\n        seen = set()\n        for n, items in specs().items():\n            if n in ABSENT_PACKAGES: continue  # Dedicated FIX3 tri-state tests.\n            check = checks[900000+n]\n            for command, pattern, good, bad in items:\n                old_script = ('out=$('+command+'); rc=$?; if [ \"$rc\" -eq 0 ]; then '\n                              'printf \"%s\\\\n\" \"$out\" \"'+MARKER+'\"; else exit \"$rc\"; fi')\n                old_argv = w_strtok('/bin/sh -c '+shlex.quote(old_script))\n                self.assertGreater(len(old_argv), 3)\n                # -n parses without running any source command, even if a regression\n                # unexpectedly makes the old script syntactically valid.\n                old = subprocess.run([old_argv[0], '-n', *old_argv[1:]],\n                                     capture_output=True, text=True, timeout=5)\n                self.assertNotEqual(old.returncode, 0)\n                empty = {r.split(' -> ', 1)[0].removeprefix('not '):\n                         dict(stdout=old.stdout, exit_code=old.returncode) for r in check['rules']}\n                self.assertEqual(simulate(check, empty), 'FAIL')\n                argv = w_strtok(guarded(command)[2:])\n                self.assertEqual(len(argv), 3)\n                self.assertEqual(argv[:2], ['/bin/sh', '-c'])\n                self.assertTrue(argv[2].startswith('out=$('+command+');'))\n                # Compare shell semantics independently to the former intended script.\n                for payload in (good, bad):\n                    fake = 'printf %s '+shlex.quote(payload)\n                    prefix = 'out=$('+command+')'\n                    outputs = []\n                    for script in (old_script, argv[2]):\n                        result = subprocess.run(['/bin/sh', '-c', 'out=$('+fake+')'+script[len(prefix):]],\n                                                capture_output=True, text=True, timeout=5)\n                        outputs.append((result.returncode, result.stdout))\n                    self.assertEqual(outputs[0], outputs[1])\n                seen.add(n)\n        self.assertEqual(seen, ADDED-set(ABSENT_PACKAGES))\n\"\"\"python3 -m linuxgcb：完全離線，不執行 SCA 命令。\"\"\"\nimport argparse\nimport json\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom .catalog import write_registry\nfrom .policy import build, validate\nfrom .report import render\nfrom .collector import timestamp\nfrom .snapshot import convert\n\n\ndef main():\n    parser = argparse.ArgumentParser(description='LinuxGCB 離線工具（未完成真機驗收）')\n    sub = parser.add_subparsers(dest='command', required=True)\n    sub.add_parser('build', help='驗證來源並重建 registry 與候選政策')\n    sub.add_parser('validate', help='離線結構與來源檢查，非引擎驗收')\n    report = sub.add_parser('report', help='匯入離線 JSON，輸出 HTML/CSV 與稽核副本')\n    report.add_argument('snapshot')\n    report.add_argument('--out', required=True)\n    report.add_argument('--now', help='固定報表時間，ISO8601 含時區')\n    snapshot = sub.add_parser('snapshot', help='離線 Manager DB JSON 轉 snapshot v1')\n    snapshot.add_argument('manager_dump')\n    snapshot.add_argument('--out', required=True)\n    snapshot.add_argument('--scan-info', help='同次離線 sca_scan_info JSON，依 policy_id 對應 end_scan')\n    args = parser.parse_args()\n    if args.command == 'build':\n        rows = write_registry()\n        build()\n        print(f'314 項；307 候選／7 排除；{validate()} 項候選規則，UNVALIDATED／人工審查待完成')\n    elif args.command == 'validate':\n        print('UNVALIDATED：離線結構檢查通過，候選控制項數', validate())\n    elif args.command == 'snapshot':\n        validate()\n        result = convert(args.manager_dump, json.loads(Path(args.scan_info).read_text()) if args.scan_info else None)\n        target = Path(args.out)\n        target.parent.mkdir(parents=True, exist_ok=True)\n        target.write_text(json.dumps(result, ensure_ascii=False, indent=2)+'\\n')\n        print(json.dumps(result['warnings'], ensure_ascii=False))\n    else:\n        validate()\n        result = render(json.loads(Path(args.snapshot).read_text()), args.out,\n                        timestamp(args.now) if args.now else datetime.now(timezone.utc))\n        print(json.dumps(result, ensure_ascii=False, indent=2))\n\nif __name__ == '__main__':\n    main()\n","exit_code":0,"status":"completed"}}

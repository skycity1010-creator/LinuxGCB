any(pattern.search(line) for line in obs['stdout'].split('\\n')[:256])\nlinuxgcb/batch2.py:70:        263:('^ciphers aes128-ctr,aes192-ctr,aes256-ctr$', 'ciphers aes128-ctr,aes192-ctr,aes256-ctr', 'ciphers aes128-cbc'),\nlinuxgcb/batch2.py:92:    result[263] += [(ssh,'^macs hmac-sha2-512,hmac-sha2-256$', 'macs hmac-sha2-512,hmac-sha2-256','macs hmac-md5'),\nlinuxgcb/batch2.py:93:                    (ssh,'^kexalgorithms ecdh-sha2-nistp256,ecdh-sha2-nistp384,ecdh-sha2-nistp521,diffie-hellman-group-exchange-sha256,diffie-hellman-group14-sha256,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512$',\nlinuxgcb/batch2.py:94:                     'kexalgorithms ecdh-sha2-nistp256,ecdh-sha2-nistp384,ecdh-sha2-nistp521,diffie-hellman-group-exchange-sha256,diffie-hellman-group14-sha256,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512','kexalgorithms diffie-hellman-group1-sha1')]\nlinuxgcb/batch2.py:153:        return 'Ciphers aes128-ctr,aes192-ctr,aes256-ctr；MACS=hmac-sha2-512,hmac-sha2-256；KexAlgorithms='+method.split('-oKexAlgorithms=',1)[1].splitlines()[0]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cat tests/test_fix3.py; cat tests/test_fix4.py; rg -n '188|189|ABSENT|rpm -qa' linuxgcb/*.py; cat docs/FIX4_REVIEW.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cat tests/test_fix3.py; cat tests/test_fix4.py; rg -n '188|189|ABSENT|rpm -qa' linuxgcb/*.py; cat docs/FIX4_REVIEW.md\"","aggregated_output":"\"\"\"Offline FIX3 regressions; execute only synthetic shell builtins.\"\"\"\nimport json\nimport shlex\nimport subprocess\nimport unittest\nfrom unittest.mock import patch\n\nfrom linuxgcb.argv import w_strtok\nfrom linuxgcb.batch2 import ABSENT_PACKAGES, MARKER, guarded\nfrom linuxgcb.catalog import ROOT, digest\nfrom linuxgcb.policy import parse_rule, simulate\n\nCHANGED = {900000+n for n in ABSENT_PACKAGES} | {900205}\n\n\nclass Fix3Tests(unittest.TestCase):\n    @classmethod\n    def setUpClass(cls):\n        cls.checks = {c['id']: c for p in (ROOT/'policies').glob('*.yml')\n                      for c in json.loads(p.read_text())['checks']}\n        cls.before = json.loads((ROOT/'tests/fixtures/fix3_baseline.json').read_text())\n\n    def test_exact_seven_rules_changed_and_ninety_checks_untouched(self):\n        before = {c['id']: c for c in self.before['checks']}\n        self.assertEqual(len(before), 97)\n        self.assertTrue(before.keys() <= self.checks.keys())\n        self.assertEqual({n for n in before if before[n]['rules'] != self.checks[n]['rules']}, CHANGED)\n        for n, check in before.items():\n            actual = dict(self.checks[n])\n            if n in CHANGED:\n                actual['rules'] = check['rules']\n            self.assertEqual(actual, check)\n        for name, sha in self.before['protected_hashes'].items():\n            self.assertEqual(digest(ROOT/name), sha, name)\n\n    def test_engine_output_boundary_and_old_marker_failure(self):\n        # Same guard as FIX2, with an allowlisted unaffected package predicate.\n        old = next(c for c in self.before['checks'] if c['id'] == 900188)\n        target = parse_rule(old['rules'][0])[0]\n        for count, want in ((255, 'PASS'), (256, 'FAIL'), (500, 'FAIL')):\n            output = '\\n'.join(['bash']*count+[MARKER])\n            self.assertEqual(simulate(old, {target:dict(stdout=output)}), want)\n        # Historical rules are test-only allowlisted to exercise the real matcher.\n        historical = [c for c in self.before['checks'] if c['id'] in CHANGED-{900205}]\n        with patch('linuxgcb.policy.batch2_emitted', return_value={r for c in historical for r in c['rules']}):\n            for check in historical:\n                target = parse_rule(check['rules'][0])[0]\n                self.assertEqual(simulate(check, {target:dict(stdout='bash\\n'*500+MARKER)}), 'FAIL')\n        for n in ABSENT_PACKAGES:\n            check = self.checks[900000+n]\n            self.assertEqual(len(check['rules']), 1)\n            target, _ = parse_rule(check['rules'][0])\n            self.assertEqual(simulate(check, {target:dict(stdout='ABSENT\\n')}), 'PASS')\n        # Negated predicates also see only the first 256 lines.\n        target = parse_rule(old['rules'][0])[0]\n        self.assertEqual(simulate(old, {target:dict(stdout=MARKER+'\\n'+'bash\\n'*255+'setroubleshoot')}), 'PASS')\n\n    def test_each_package_tristate_and_argv_without_running_rpm(self):\n        for n, package in ABSENT_PACKAGES.items():\n            check = self.checks[900000+n]\n            target, _ = parse_rule(check['rules'][0])\n            argv = w_strtok(target[2:])\n            self.assertEqual(argv[:2], ['/bin/sh', '-c'])\n            self.assertEqual(len(argv), 3)\n            prefix = 'out=$(rpm -q '+package+' 2>/dev/null)'\n            self.assertTrue(argv[2].startswith(prefix))\n            for rc in (0, 1, 2, 3, 126, 127):\n                # Malicious-looking matching data must never escape buffering.\n                fake = 'printf %s '+shlex.quote('ABSENT\\n'+MARKER+'\\n'*500)+'; exit '+str(rc)\n                script = 'out=$('+fake+')'+argv[2][len(prefix):]\n                result = subprocess.run(['/bin/sh','-c',script], capture_output=True, text=True, timeout=5)\n                expected = 'INSTALLED\\n' if rc == 0 else 'ABSENT\\n' if rc == 1 else ''\n                self.assertEqual(result.stdout, expected)\n                self.assertEqual(result.returncode, 0 if rc in (0,1) else rc)\n                self.assertEqual(simulate(check, {target:dict(stdout=result.stdout)}), 'PASS' if rc == 1 else 'FAIL')\n\n    def test_cron_legacy_and_action_and_rejections(self):\n        check = self.checks[900205]\n        target, _ = parse_rule(check['rules'][0])\n        for line in ('cron.* /var/log/cron', 'cron.* action(type=\"omfile\" file=\"/var/log/cron\")',\n                     '\\tcron.*\\taction(type=\"omfile\"\\tfile=\"/var/log/cron\") '):\n            self.assertEqual(simulate(check, {target:dict(stdout=line+'\\n'+MARKER)}), 'PASS', line)\n        for line in ('#cron.* /var/log/cron', 'cron.none /var/log/cron',\n                     'cron.* action(type=\"omfwd\" file=\"/var/log/cron\")',\n                     'cron.* action(type=\"omfile\" file=\"/var/log/other\")',\n                     'cron.* action(type=\"omfile\" file=\"/var/log/cron\")junk'):\n            self.assertEqual(simulate(check, {target:dict(stdout=line+'\\n'+MARKER)}), 'FAIL', line)\n        self.assertEqual(simulate(check, {target:dict(stdout='cron.* /var/log/cron')}), 'FAIL')\n\"\"\"FIX4 offline regressions using only synthetic file trees.\"\"\"\nimport copy\nimport json\nimport unittest\nimport test_p2b3 as p2b3\nfrom linuxgcb.catalog import ROOT, digest\nfrom linuxgcb.policy import parse_rule, simulate\n\nCHANGED = {900143, 900144, 900176}\n\n\nclass Fix4Tests(unittest.TestCase):\n    tree = p2b3.P2B3Tests.tree\n    run_tree = p2b3.P2B3Tests.run_tree\n\n    @classmethod\n    def setUpClass(cls):\n        cls.data = json.loads((ROOT/'tests/fixtures/p2b3/cases.json').read_text())\n        cls.checks = {c['id']: c for p in (ROOT/'policies').glob('*.yml')\n                      for c in json.loads(p.read_text())['checks']}\n\n    def assert_result(self, n, data, want):\n        output = self.run_tree(n, data)\n        self.assertEqual(output, 'PASS\\n' if want == 'PASS' else '')\n        check = self.checks[900000+n]\n        target, _ = parse_rule(check['rules'][0])\n        self.assertEqual(simulate(check, {target: dict(stdout=output)}), want)\n\n    def test_exact_three_rules_changed_and_protected_evidence(self):\n        before = json.loads((ROOT/'tests/fixtures/fix4_baseline.json').read_text())\n        old = {c['id']: c for c in before['checks']}\n        self.assertEqual(len(old), 146)\n        self.assertEqual(old.keys(), self.checks.keys())\n        self.assertEqual({n for n in old if old[n]['rules'] != self.checks[n]['rules']}, CHANGED)\n        for n in old.keys() - CHANGED:\n            self.assertEqual(old[n], self.checks[n])\n        for name, sha in before['protected_hashes'].items():\n            self.assertEqual(digest(ROOT/name), sha, name)\n\n    def test_imuxsock_and_omfile_matrix(self):\n        module = 'module(load=\"imuxsock\" SysSock.Use=\"off\" FileCreateMode=\"0644\")\\n'\n        cases = [\n            (module + '$FileCreateMode 0640\\n', 'PASS'),\n            (module, 'FAIL'),\n            (module + '$FileCreateMode 0640\\naction(type=\"omfile\" fileCreateMode=\"0666\")', 'FAIL'),\n            ('action(type=\"omfile\" fileCreateMode=\"0640\")', 'PASS'),\n            ('action(type=\"omfwd\" fileCreateMode=\"0640\")', 'FAIL'),\n            ('module(load=\"omfile\" fileCreateMode=\"0640\")', 'FAIL'),\n            ('module(load=\"imuxsock\" action(foo) omfile FileCreateMode=\"0666\")\\n$FileCreateMode 0640', 'PASS'),\n            (module + '$FileCreateMode 9999', 'FAIL'),\n        ]\n        for text, want in cases:\n            with self.subTest(text=text):\n                data = self.tree(176)\n                data['files']['/etc/rsyslog.conf'] = text\n                self.assert_result(176, data, want)\n\n    def test_existing_tools_keep_mode_and_owner_requirements(self):\n        for n in (143, 144):\n            all_tools = self.tree(n)\n            self.assertEqual(len(all_tools['files']), 9)\n            seven = copy.deepcopy(all_tools)\n            for path in ('/sbin/audisp-remote', '/sbin/audisp-syslog'):\n                for field in ('files', 'modes', 'owners'):\n                    del seven[field][path]\n            self.assertEqual(len(seven['files']), 7)\n            for base in (all_tools, seven):\n                with self.subTest(n=n, count=len(base['files'])):\n                    self.assert_result(n, base, 'PASS')\n                    for path in base['files']:\n                        bad = copy.deepcopy(base)\n                        if n == 143:\n                            bad['modes'][path] = 0o755\n                            self.assert_result(n, bad, 'FAIL')\n                        else:\n                            for owner in ([1001, 0], [0, 1001]):\n                                bad['owners'][path] = owner\n                                self.assert_result(n, bad, 'FAIL')\n                    denied = copy.deepcopy(base)\n                    denied['stat_error'] = '/sbin/auditctl'\n                    self.assert_result(n, denied, 'FAIL')\nlinuxgcb/p2b3_runtime.py:104:    command = 'out=$(rpm -q ' + package + ' 2>/dev/null); rc=$?; case $rc in 0) echo INSTALLED;; 1) echo ABSENT;; *) exit $rc;; esac'\nlinuxgcb/p2b3_runtime.py:106:    if result.returncode or result.stdout.strip() not in ('INSTALLED', 'ABSENT'):\nlinuxgcb/p2b3_runtime.py:115:    if state == 'ABSENT' or not snmp:\nlinuxgcb/batch3.py:99:            body='out=$(rpm -q xinetd 2>/dev/null); rc=$?; case $rc in 0) echo INSTALLED;; 1) echo ABSENT;; *) exit $rc;; esac'\nlinuxgcb/batch3.py:100:            result[n]=[('c:/bin/sh -c '+quote_argument(body), '^ABSENT$')]\nlinuxgcb/batch3.py:129:    if n in (95,96,99,100): detail='FIX-1 明確 not-found 且 inactive 視為停用；disabled/masked 且 inactive 合格；systemctl 錯誤不合格。套件 ABSENT 仍須確認服務 inactive，避免移除套件後程序仍存活。多次查詢非原子。'\nlinuxgcb/batch3.py:131:    if n in (92,96,99,100): detail+='僅定向 rpm -q，0=INSTALLED、1=ABSENT、其他錯誤無成功輸出；不查 rpm -qa。'\nlinuxgcb/batch2.py:14:ABSENT_PACKAGES = {102:'ypbind',103:'telnet',104:'telnet-server',105:'rsh-server',106:'tftp-server',189:'mcstrans'}\nlinuxgcb/batch2.py:18:    if command in ('rpm -q '+p+' 2>/dev/null' for p in ABSENT_PACKAGES.values()):\nlinuxgcb/batch2.py:20:                  '0) echo INSTALLED;; 1) echo ABSENT;; *) exit $rc;; esac')\nlinuxgcb/batch2.py:31:    for n,package in {188:'setroubleshoot'}.items():\nlinuxgcb/batch2.py:32:        result[n] = [('/usr/bin/rpm -qa --queryformat '+shlex.quote('%{NAME}\\\\n'),\nlinuxgcb/batch2.py:34:    for n,package in ABSENT_PACKAGES.items():\nlinuxgcb/batch2.py:35:        result[n] = [('rpm -q '+package+' 2>/dev/null', '^ABSENT$', 'ABSENT', 'INSTALLED')]\nlinuxgcb/batch2.py:117:        result[n]=list(dict.fromkeys(predicates+([] if n in ABSENT_PACKAGES else [(guarded(cmd),'^'+MARKER+'$') for cmd,_,_,_ in items])))\nlinuxgcb/batch2.py:150:    if n in (102,103,104,105,106,188,189):\n# FIX4 離線審查\n\n## R9 證據摘要\n\n依任務提供的 2026-11-01 R9 正向 fixture 驗證摘要：完整 GCB 合規 fixture 套用後，P2B3 的 38 條 FAIL 中 35 條經引擎驗證轉 PASS，剩餘 900176、900143、900144 為本次修正範圍。\n\n900176：RHEL9 預設 imuxsock module 的 FileCreateMode=\"0644\" 屬 state file 參數，舊規則誤當日誌模式，即使明確宣告 $FileCreateMode 0640 仍 FAIL。\n\n900143/144：來源九工具含 audisp-remote、audisp-syslog；依提供的真機證據，RHEL9 audit 3.x 已無這兩個 plugin 工具，舊規則對缺失路徑 stat 拋錯，導致 FAIL。\n\n任務引用的 docs/FIXTURE_VALIDATION_R9_R10.md 與 r8/r9/r10 scan JSON 未出現在本工作目錄；以上為使用者提供的證據摘要，未自行重驗或建立替代真機證據。此次僅離線開發，未做 SSH、生產 API、sudo、服務變更、秘密讀取、工作目錄以外外部寫入或 Excel 設定方法執行。\n\n## 三條前後對照\n\n| 規則 | 修改前 | 修改後 |\n| --- | --- | --- |\n| 900176 / 0176 | 從所有有效設定行抽取 fileCreateMode，誤納入 module 參數 | 只從同時含 action( 與 omfile、且不含 module( 的行抽取 override；原 $FileCreateMode 宣告格式與 <=0640 位元遮罩驗證完全保留 |\n| 900143 / 0143 | 九工具每個 stat 都必須成功，mode 位元子集合 <=0750 | 原九工具清單不變；僅 FileNotFoundError 跳過，存在工具仍逐一套用原 <=0750 遮罩；其他 OSError 仍失敗 |\n| 900144 / 0144 | 九工具每個 stat 都必須成功，UID/GID 均須 0 | 原九工具清單不變；僅 FileNotFoundError 跳過，存在工具 UID/GID 仍均須 0；其他 OSError 仍失敗 |\n\nmetadata() 本身未修改；新增 helper 僅由 0143/0144 引用。兩條分別檢查 mode 與 owner，未增加或刪除彼此的檢核責任。全數工具不存在時依「存在者必符合」的全稱語意 PASS。stat 沿用跟隨 symlink 的既有行為，失效 symlink 的 FileNotFoundError 亦跳過。\n\n0176 維持逐行解析；複雜多行 action、模板與 include 完整語意仍待人工審查。\n\n## 來源解讀待批\n\ncaveats 已記錄：「RHEL9 audit 3.x 無 audisp plugin；不存在工具跳過之來源解讀待批」。\n\n沿用 FIX-1 not-found 的解讀先例，工具缺失不代表權限不合規；此解讀仍待來源審查核准，未宣稱政策已完成真機驗收。政策 name 保持 UNVALIDATED，human_review_pending / execution_review=blocked 維持原值。\n\n## 回歸與範圍\n\ntests/test_fix4.py 執行實際 emitted Python、驗證 shell/Python argv round trip，並將輸出交給 simulate：\n\n- 0176：imuxsock 0644 + $FileCreateMode 0640 → PASS；僅 imuxsock 0644 → FAIL；加入 omfile action 0666 → FAIL；另涵蓋合規 action、非 omfile、module 排除與無效宣告。\n- 0143/0144：九工具全存在 0750/root → PASS；七存在、兩 audisp 缺失 → PASS；逐一讓任一存在工具 0755 → 0143 FAIL；逐一讓任一存在工具 UID 或 GID 非 0 → 0144 FAIL。兩種工具集合均覆蓋，stat PermissionError 仍 FAIL。\n- 原 P2B3 metadata 測試將全缺失預期同步為 PASS，錯誤情境改為實際模擬 stat PermissionError，避免以不存在冒充讀取錯誤。\n- fix4_baseline.json 保存任務開始的 146 checks 與既有非 P2B3 fixtures、來源檔案 hash。恰好指定三條 rules 有變，其餘 143 條完整 checks 相同；15 項 R6 真實缺失及 FIX-1/2/3 規則不變。\n- 原始來源、TWGCB ID、307/7 scope、既有真機與 R2/R3 fixtures 不變。coverage_manifest 仍為 146 候選；重建僅同步相關 caveats、政策與 hash。P2B3 合成輸出 fixture 僅同步三條 command key。\n\n驗收結果：\n\n- python3 -m unittest discover -s tests -v：77 tests，OK。\n- python3 -m linuxgcb build：314 項，307 候選範圍 / 7 排除，146 項候選規則，UNVALIDATED。\n- python3 -m linuxgcb validate：146 候選，通過。\n- 其餘 143 條 rules diff=0。\n\n提交結果：已嘗試 git add / git commit；因 .git 為唯讀，建立 .git/index.lock 時回報 Read-only file system，未產生 commit。所有變更保留於工作目錄；既有未追蹤 codex_fix4.log 未納入本次修改。\n","exit_code":0,"status":"completed"}}

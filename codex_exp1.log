{"type":"item.completed","item":{"id":"item_9","type":"agent_message","text":"53 項來源都有明確基準值。停用服務的來源分別要求 disable 或 mask，我會保留這個差異，不把既有規則接受的「未安裝」推成來源基準。\n\nR2／R3 是加入前綴前的真實匯出；報表會在原始 description 缺少前綴時，以目前政策的 description 補充 expected，並標記來源及原始前綴缺失，保留真實 fixture 原樣。\n"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"cat > linuxgcb/expected.py <<'PY'\n\\\"\\\"\\\"合規值僅作文字；從來源抽取，絕不執行設定方法。\\\"\\\"\\\"\nimport json\nimport re\nfrom .catalog import ROOT\n\nPREFIX = '合規值: '\nUNKNOWN = '待確認（來源未提供單一基準值）'\n\n\ndef source_expected(row):\n    value = (row.get('expected') or '').strip()\n    method = row.get('configuration_method') or ''\n    if value == '安裝':\n        match = re.search(r'#dnf install ([a-zA-Z0-9 -]+)', method)\n        return match.group(1).strip()+' 已安裝' if match else UNKNOWN\n    if value in ('啟用', '停用'):\n        match = re.search(r'#systemctl --now (enable|disable|mask) ([a-zA-Z0-9_.-]+)', method)\n        if not match:\n            return UNKNOWN\n        action, service = match.groups()\n        return service+' '+{'enable': 'enabled+active', 'disable': 'disabled+inactive',\n                              'mask': 'masked+inactive'}[action]\n    if row['gcb_id'].endswith('0108'):\n        return 'net.ipv4.ip_forward=0；net.ipv6.conf.all.forwarding=0'\n    if row['gcb_id'].endswith('0269'):\n        return 'PermitRootLogin '+value if value else UNKNOWN\n    if row['gcb_id'].endswith('0270'):\n        return 'PermitEmptyPasswords '+value if value else UNKNOWN\n    return value or UNKNOWN\n\n\ndef values():\n    return {r['gcb_id']: source_expected(r) for r in json.loads((ROOT/'data/controls.json').read_text())}\n\n\ndef parse_description(description):\n    if not isinstance(description, str) or not description.startswith(PREFIX):\n        return ''\n    return description[len(PREFIX):].split(' ｜ ', 1)[0].strip()\n\n\ndef report_expected(raw, policy):\n    \\\"\\\"\\\"歷史匯出可用本地政策補充，明示其非掃描時證據。\\\"\\\"\\\"\n    value = parse_description(raw.get('description'))\n    if value:\n        return value, 'raw_description'\n    value = parse_description(policy.get('description'))\n    if value:\n        return value, 'policy_description_fallback; raw_prefix_missing'\n    return '', 'prefix_missing'\nPY\npython3 - <<'PY'\np='linuxgcb/policy.py'\ns=open(p).read().replace('from .batch1 import rules as batch_rules, disabled_service_rules','from .batch1 import rules as batch_rules, disabled_service_rules\\\\nfrom .expected import PREFIX, values, parse_description')\ns=s.replace('    rows = registry()\\\\n', '    rows = registry()\\\\n    expected = values()\\\\n',1)\ns=s.replace(\\\"description='Q1 執行審查 '\\\",\\\"description=PREFIX+expected[row['gcb_id']]+' ｜ Q1 執行審查 '\\\")\ns=s.replace(\\\"            require(c['regex_type']\\\", \\\"            require(parse_description(c.get('description')) == values()[rows[c['id']]['gcb_id']])\\\\n            require(' ｜ Q1 ' in c['description'])\\\\n            require(c['regex_type']\\\")\nopen(p,'w').write(s)\np='linuxgcb/report.py';s=open(p).read().replace('from .collector import timestamp','from .collector import timestamp\\\\nfrom .expected import report_expected');s=s.replace(\\\"            all_rows.append(dict(\\\",\\\"            expected, expected_status = report_expected(c, policy_checks.get(control['sca_id'], {}))\\\\n            all_rows.append(dict(\\\")\ns=s.replace(\\\"title=control['title'], expected=control['expected'],\\\", \\\"title=control['title'], expected=expected, expected_status=expected_status,\\\")\nopen(p,'w').write(s)\np='linuxgcb/snapshot.py';s=open(p).read().replace('from .collector import timestamp','from .collector import timestamp\\\\nfrom .expected import report_expected');s=s.replace(\\\"{c['id'] for c in policy['checks']}\\\",\\\"{c['id']: c for c in policy['checks']}\\\")\ns=s.replace(\\\"            checks.append(check)\\\",\\\"            check['expected'], check['expected_status'] = report_expected(c, policies[pid][sid])\\\\n            checks.append(check)\\\")\nopen(p,'w').write(s)\nPY\npython3 -m linuxgcb build\npython3 -m linuxgcb validate\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

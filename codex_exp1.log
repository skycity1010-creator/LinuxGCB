name）；原 Q1 後綴逐字相同。'\"', '', '可重現 R3 驗收：', '', '\"'```bash'\"', 'python3 -m linuxgcb snapshot tests/fixtures/realhost_r3.json --out out/exp1-r3/snapshot.json', 'python3 -m linuxgcb report out/exp1-r3/snapshot.json --out out/exp1-r3/report --now 2026-10-31T23:00:00Z', '\"'```'\"']\nPath('docs/EXP1_REVIEW.md').write_text('\\\\n'.join(lines)+'\\\\n')\nfor p in Path('policies').glob('*.yml'):\n old=json.loads(subprocess.check_output(['git','show','HEAD:'+str(p)]));new=json.loads(p.read_text())\n for a,b in zip(old['checks'],new['checks']):\n  assert b.pop('description').split(' ｜ ',1)[1] == a.pop('description')\n assert old==new,p\nfor p in ['tests/fixtures/realhost_r2.json','tests/fixtures/realhost_r3.json','data/controls.json']:\n assert Path(p).read_bytes()==subprocess.check_output(['git','show','HEAD:'+p]),p\nprint('HEAD comparison: policy execution fields/Q1 suffix/source/real fixtures unchanged')\nPY\npython3 -m linuxgcb snapshot tests/fixtures/realhost_r3.json --out out/exp1-r3/snapshot.json\npython3 -m linuxgcb report out/exp1-r3/snapshot.json --out out/exp1-r3/report --now 2026-10-31T23:00:00Z\npython3 - <<'PY'\nimport csv\nwith open('out/exp1-r3/report/report.csv',encoding='utf-8-sig') as f: rows=list(csv.DictReader(f))\nraw=[r for r in rows if r['raw_result']]\nassert len(raw)==53 and all(r['expected'] for r in raw)\nprint('R3 CSV:',len(rows),'rows;',len(raw),'raw rows with expected')\nPY\ngit diff --stat\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

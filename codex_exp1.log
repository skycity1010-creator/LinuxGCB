{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nfrom linuxgcb.policy import definitions\nx=json.load(open('data/controls.json'));print(type(x));print(str(x)[:1800])\nPY\ncat tests/test_report.py; cat tests/test_snapshot.py\"","aggregated_output":"<class 'list'>\n[{'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': '基本項目', 'row': 5, 'ordinal': '1', 'gcb_id': 'TWGCB-01-012-0001', 'category': '磁碟與檔案系統', 'title': 'cramfs檔案系統', 'description': '這項原則設定決定是否支援cramfs檔案系統\\ncramfs(compressed ROM file system，壓縮唯讀閃存檔案系統)檔案系統是一開放式之Linux檔案系統，目的是更簡單更有效率\\ncramfs檔案系統以zlib壓縮資料，不需載入到記憶體中，因此可節省許多記憶體空間，可直接使用cramfs映像檔案無須先解壓，使用於某些舊系統或對記憶體有限制之地方\\n停止支援cramfs檔案系統，以減少系統被攻擊面', 'configuration_method': '開啟終端機，執行vim指令，在/etc/modprobe.d目錄新增或編輯「cramfs.conf」檔案，範例如下：\\n#vim /etc/modprobe.d/cramfs.conf\\n並在檔案中加入以下內容：\\ninstall cramfs /bin/true\\nblacklist cramfs\\n開啟終端機，執行下列指令，移除cramfs模組：\\n#rmmod cramfs\\n完成後，請重新開機', 'expected': '停用', 'implementation_status': 'unreviewed'}, {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': '基本項目', 'row': 6, 'ordinal': '2', 'gcb_id': 'TWGCB-01-012-0002', 'category': '磁碟與檔案系統', 'title': 'squashfs檔案系統', 'description': '這項原則設定決定是否支援squashfs檔案系統\\nsquashfs是一個即時解壓縮之檔案系統，專門為唯讀壓縮檔案系統之使用而設計，常見於各Linux發行版之LiveCD\\n停止支援squashfs檔案系統，以減少系統被攻擊面\\n停止支援squashfs檔案系統，將可能導致Snap套件無法正常運作', 'configuration_method': '開啟終端機，執行vim指令，在/etc/modprobe.d目錄，新增或編輯「squashfs.conf」檔案，範例如下：\\n#vim /etc/modprobe.d/squashfs.conf\\n並在檔案中加入以下內容：\\ninstall squashfs /bin/true\\nblacklist squashfs\\n開啟終端機，執行下列指令，移除squashfs模組：\\n#rmmod squashfs\\n完成後，請重新開機', 'expected': '停用', 'implementation_status': 'unreviewed'}, {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': '基本項目', 'row': 7, 'ordinal': '3', 'gcb_id': 'TWGCB-01-012-0003', 'category': '磁碟與檔案系統', 'title': 'udf檔案系統', 'description': '這項原則設定決定是否支援udf檔案系統\\nudf(Universal disk format，通用磁碟格式)是根據ISO/IEC 13346與ECMA-167標準所實作之檔案系統，由光學儲存技術協會(OSTA)開發與維護，廣泛應用在如CD-R/RW與DVD-R/RW等可寫光學儲存媒體\\n停止支援udf檔案系統，以減少系統被攻擊面\\n系統若運行在Microsot Azure上，將可能影響系統正常運作', 'configuration_method': '開啟終端機，執行vim指令，在/etc/modprobe.d目錄，\nimport copy\nimport csv\nimport json\nimport tempfile\nimport unittest\nfrom datetime import datetime,timezone\nfrom pathlib import Path\nfrom linuxgcb.catalog import ROOT\nfrom linuxgcb.report import normalize,metrics,render,safe_cell\n\nNOW=datetime(2026,10,30,tzinfo=timezone.utc)\n\n\nclass ReportTests(unittest.TestCase):\n    def setUp(self):\n        self.fixture=json.loads((ROOT/'tests/fixtures/snapshot.json').read_text())\n    def rows(self):return normalize(self.fixture,NOW)\n    def test_full_inventory_status_and_denominators(self):\n        rows=self.rows();by={r['sca_id']:r for r in rows};m=metrics(rows)\n        self.assertEqual(len(rows),314)\n        self.assertEqual(m['counts']['EXCLUDED'],7)\n        self.assertEqual(m['applicable'],307)\n        self.assertEqual(m['counts'].get('PASS',0),0)\n        self.assertEqual(m['counts']['FAIL'],1)\n        self.assertEqual(by[900243]['state'],'ERROR')\n        self.assertEqual(by[900108]['state'],'MANUAL_PENDING')\n        self.assertEqual(by[900269]['state'],'MANUAL_PENDING')\n        self.assertEqual(by[900270]['state'],'MANUAL_PENDING')\n        self.assertTrue(by[900046]['exception_approved'])\n        self.assertEqual(by[900046]['state'],'FAIL')\n        self.assertEqual(m['completeness'],0.0)\n        self.assertEqual(m['pass_rate'],None)\n    def test_no_scan_and_stale(self):\n        host=self.fixture['hosts'][0];host['checks']=[];host.pop('scanned_at')\n        rows=self.rows();self.assertTrue(all(r['stale'] for r in rows))\n        self.assertEqual(next(r for r in rows if r['sca_id']==900045)['state'],'NOT_SCANNED')\n        host['checks']=[dict(id=900045,result='passed')]\n        self.assertEqual(next(r for r in self.rows() if r['sca_id']==900045)['state'],'MANUAL_PENDING')\n    def test_zero_denominator(self):\n        m=metrics([])\n        self.assertIsNone(m['pass_rate']);self.assertIsNone(m['completeness']);self.assertIsNone(m['attainment'])\n    def test_approved_na_does_not_hide_failure_or_error(self):\n        h=self.fixture['hosts'][0]\n        approved=next(iter(h['exceptions'].values()))\n        h['not_applicable']={f'TWGCB-01-012-{n:04d}':copy.deepcopy(approved) for n in (45,46,243)}\n        by={r['sca_id']:r for r in self.rows()}\n        self.assertEqual(by[900045]['state'],'NOT_APPLICABLE')\n        self.assertEqual(by[900046]['state'],'FAIL')\n        self.assertEqual(by[900243]['state'],'NOT_APPLICABLE')\n        h['checks'][3]['execution_error']=True\n        self.assertEqual(next(r for r in self.rows() if r['sca_id']==900243)['state'],'ERROR')\n        h['not_applicable']['TWGCB-01-012-0045']['expires']='2020-01-01T00:00:00Z'\n        self.assertEqual(next(r for r in self.rows() if r['sca_id']==900045)['state'],'MANUAL_PENDING')\n    def test_unapproved_profiles_conservative(self):\n        self.fixture['hosts'][0]['approved_profiles']=[]\n        rows=self.rows();self.assertEqual(metrics(rows)['unresolved'],307)\n        self.assertEqual(next(r for r in rows if r['sca_id']==900045)['state'],'MANUAL_PENDING')\n    def test_invalid_snapshots_rejected(self):\n        mutations=[lambda s:s.update(source_sha256='bad'),lambda s:s.update(policy_hashes={}),\n            lambda s:s['hosts'].append(copy.deepcopy(s['hosts'][0])),\n            lambda s:s['hosts'][0]['checks'].append(dict(id=123,result='passed')),\n            lambda s:s['hosts'][0]['checks'].append(dict(id=900045,result='passed')),\n            lambda s:s['hosts'][0]['checks'].append(dict(id=900001,result='passed'))]\n        for mutate in mutations:\n            s=copy.deepcopy(self.fixture);mutate(s)\n            with self.assertRaises(ValueError):normalize(s,NOW)\n    def test_html_csv_raw_integrity(self):\n        before=copy.deepcopy(self.fixture)\n        with tempfile.TemporaryDirectory() as d:\n            render(self.fixture,d,NOW)\n            page=(Path(d)/'report.html').read_text()\n            self.assertNotIn('<script>',page)\n            self.assertIn('&lt;script&gt;',page)\n            self.assertIn('SYNTHETIC',page)\n            with (Path(d)/'report.csv').open(encoding='utf-8-sig',newline='') as f:\n                rows=list(csv.DictReader(f))\n            self.assertEqual(len(rows),314)\n            bad=next(r for r in rows if r['sca_id']=='900046')\n            self.assertTrue(bad['raw_reason'].startswith(\"'=\"))\n            self.assertEqual(json.loads((Path(d)/'snapshot.json').read_text()),before)\n        self.assertEqual(self.fixture,before)\n    def test_formula_vectors(self):\n        for text in ('=1',' +1','\\t@evil','\\r-1','\\n=1','\\ufeff=1','\\v=1','\\x00@evil','\\u2003=1'):\n            self.assertTrue(safe_cell(text).startswith(\"'\"))\n        self.assertEqual(safe_cell('普通文字'),'普通文字')\n    def test_multiple_host_weighted_counts(self):\n        other=copy.deepcopy(self.fixture['hosts'][0]);other['agent_id']='SYNTHETIC-002';other['checks']=[]\n        self.fixture['hosts'].append(other)\n        self.assertEqual(metrics(self.rows())['applicable'],614)\n        self.assertEqual(len(self.rows()),628)\n\n    def test_authored_controls_do_not_create_evidence(self):\n        from linuxgcb.batch1 import ADDED\n        by={r['sca_id']:r for r in self.rows()}\n        for n in ADDED:\n            self.assertIsNone(by[900000+n]['raw_result'])\n            self.assertEqual(by[900000+n]['state'],'MANUAL_PENDING' if n==141 else 'NOT_SCANNED')\n        self.fixture['hosts'][0]['checks'].append(dict(id=900141,result='passed'))\n        self.assertEqual(next(r for r in self.rows() if r['sca_id']==900141)['state'],'MANUAL_PENDING')\n        self.assertEqual(metrics(self.rows())['completeness'],0.0)\n\"\"\"REAL EVIDENCE agent010 R2；變異僅為記憶體中 test-only 負面測試。\"\"\"\nimport copy\nimport csv\nimport json\nimport tempfile\nimport unittest\nfrom collections import Counter\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom linuxgcb.catalog import ROOT, digest\nfrom linuxgcb.snapshot import convert, LABEL\nfrom linuxgcb.report import normalize, render\n\nFIXTURE = ROOT/'tests/fixtures/realhost_r2.json'\nFAIL_IDS = {900192,900194,900196,900198,900200,900202,900269}\nNOW = datetime(2026,10,31,6,tzinfo=timezone.utc)\n\n\nclass SnapshotTests(unittest.TestCase):\n    def test_real_evidence_roundtrip(self):\n        original = json.loads(FIXTURE.read_text())\n        s = convert(FIXTURE)\n        self.assertFalse(s['synthetic'])\n        self.assertEqual(s['label'], LABEL)\n        self.assertEqual(s['manager_dump_sha256'], digest(FIXTURE))\n        host = s['hosts'][0]\n        self.assertIsNone(host['scanned_at'])\n        self.assertEqual(len(s['warnings']),3)\n        self.assertEqual(Counter(c['result'] for c in host['checks']), {'passed':46,'failed':7})\n        for c in host['checks']:\n            self.assertEqual({k:v for k,v in c.items() if k!='policy_id'}, next(x for x in original[c['policy_id']]['checks'] if x['id']==c['id']))\n        with tempfile.TemporaryDirectory() as d:\n            summary=render(s,d,NOW)\n            self.assertEqual(summary['counts']['FAIL'],7)\n            self.assertEqual(summary['verified_decided'],0)\n            self.assertIsNone(summary['pass_rate'])\n            self.assertEqual(summary['completeness'],0)\n            with (Path(d)/'report.csv').open(encoding='utf-8-sig',newline='') as f:\n                failures=[r for r in csv.DictReader(f) if r['state']=='FAIL']\n            self.assertEqual({int(r['sca_id']) for r in failures},FAIL_IDS)\n            page=(Path(d)/'report.html').read_text()\n            for r in failures:\n                self.assertIn(r['gcb_id'],page)\n                self.assertTrue(r['title'])\n                self.assertTrue(r['command'])\n                self.assertEqual(r['remediation_status'],'政策未提供 remediation')\n            self.assertIn(LABEL,page)\n    def test_scan_info_time_and_invalid_results(self):\n        dump=json.loads(FIXTURE.read_text())\n        info={pid:{'end_scan':'2026-10-31T12:03:00+08:00'} for pid in dump}\n        s=convert(FIXTURE,info)\n        self.assertEqual(s['hosts'][0]['scanned_at'],'2026-10-31T04:03:00+00:00')\n        self.assertFalse(s['warnings'])\n        for result in ('invalid','error','unexpected'):\n            modified=copy.deepcopy(s)\n            c=modified['hosts'][0]['checks'][0]\n            c.update(result=result,reason='test-only raw reason')\n            row=next(r for r in normalize(modified,NOW) if r['sca_id']==c['id'])\n            self.assertEqual(row['state'],'ERROR')\n            self.assertEqual(row['raw_result'],result)\n            self.assertEqual(row['raw_reason'],'test-only raw reason')\n    def test_invalid_time_rejected(self):\n        pid=next(iter(json.loads(FIXTURE.read_text())))\n        with self.assertRaises(ValueError):\n            convert(FIXTURE,{pid:{'end_scan':'2026-10-31T12:03:00'}})\n","exit_code":0,"status":"completed"}}

om functools import lru_cache\nfrom pathlib import Path\nfrom . import p2b7_runtime\nfrom .argv import quote_argument\nfrom . import fix9_runtime\nADDED = {32} | set(range(34,45)) | set(range(61,92)) | set(range(303,308))\n\n\n@lru_cache(maxsize=1)\ndef sources():\n    from scripts.inventory import extract\n    root = Path(__file__).resolve().parents[1]\n    docx = root/'docs/references/gcb-rhel9-v1.2.docx'\n    if hashlib.sha256(docx.read_bytes()).hexdigest() != '986effd9501b1fd97776129c6691cf8fc98246bd04514347322f3337508e0e5b':\n        raise ValueError('GCB v1.2 reference hash changed')\n    ns = {'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}\n    xml = ET.fromstring(ZipFile(docx).read('word/document.xml'))\n    tables = [['\\n'.join(''.join(t.text or '' for t in p.findall('.//w:t',ns))\n              for p in cell.findall('.//w:p',ns)) for cell in tr.findall('w:tc',ns)]\n              for tr in xml.findall('.//w:tr',ns)]\n    out = {}\n    for r in extract(next(root.glob('*.xlsx'))):\n        n = int(r['gcb_id'][-4:])\n        if n not in ADDED:\n            continue\n        matches = [c for c in tables if r['gcb_id'] in c and c[-1] == r['expected'] and c[-2] == r['configuration_method']]\n        if not matches or any(c[-2:] != matches[0][-2:] for c in matches):\n            raise ValueError('GCB DOCX/XLSX source mismatch: '+r['gcb_id'])\n        out[n] = dict(r, configuration_method=matches[0][-2])\n    if set(out) != ADDED:\n        raise ValueError('incomplete P2B7 source set')\n    return out\n\n\ndef script(n):\n    source = inspect.getsource(p2b7_runtime)\n    # Preserve byte-identical embedded scripts outside the FIX6 ID family.\n    if n not in set(range(79,86)) | {303,304}:\n        source = source.replace(\"u[6].endswith(('/nologin','/false'))\", \"u[6] in ('/sbin/nologin','/bin/false')\")\n        source = source.replace(\"        for p in ('/etc/security/opasswd','/etc/security/opasswd.old'):\\n            try:\\n                ok = meta(p,uid=0,gid=0) if n == 303 else meta(p,mode=0o644)\\n            except FileNotFoundError:\\n                continue\\n            if not ok:\\n                return False\\n        return True\", \"        return all(meta(p,uid=0,gid=0) if n == 303 else meta(p,mode=0o644) for p in ('/etc/security/opasswd','/etc/security/opasswd.old'))\")\n    if n in {73,74,91}:\n        source += '\\n' + inspect.getsource(fix9_runtime.root_paths)\n        source += '\\n' + inspect.getsource(fix9_runtime.fix9_check)\n        source += '\\ncheck = fix9_check\\n'\n    return source + '\\ntry:\\n    ok = check(' + str(n) + \")\\nexcept (OSError, ValueError, IndexError, KeyError, subprocess.SubprocessError):\\n    ok = False\\nif ok:\\n    print('PASS')\\n\"\n\n\n@lru_cache(maxsize=1)\ndef rules():\n    return {n:[('c:/usr/bin/python3 -c ' + quote_argument(script(n)), '^PASS$')] for n in sorted(ADDED)}\n\n\ndef mechanism(n):\n    return '逐條來源唯讀 predicate；直接 python3 -c argv；單一 PASS commit'\n\n\ndef caveat(n):\n    notes = {\n        32:'main 與 repo 檔同查 gpgcheck/localpkg_gpgcheck=1；各repo section皆需雙key；繼承與生效待批。',\n        34:'只接受未限定 Defaults use_pty；限定使用者/主機、include、續行與覆寫待審。',\n        35:'logfile 要求非空絕對路徑；來源 /var/log/sudo.log 僅範例；複雜 sudoers 語意待審。',\n        36:'定向 rpm -q aide 三態；初始化資料庫動作未執行，資料庫生效另審。',\n        37:'來源 root crontab 每天5點；expected 每天允許合法固定分時；依任務另接受 cron.daily 可執行檔明確 /usr/sbin/aide --check。排程替代需批。',\n        38:'來源 BIOS grub.cfg/grubenv/選用user.cfg；UEFI fstab uid=0,gid=0；未自行增加 loader/entries。',\n        39:'來源 BIOS 600 位元子集；UEFI fmask=0177；未自行增加 loader/entries。',\n        40:'靜態確認 grub2-setpassword 產生之 user.cfg PBKDF2 宣告；grub.cfg 載入與重建效果留真機。',\n        41:'來源 rescue/emergency.service ExecStart 精確比對；systemd drop-in 實際生效留真機。',\n        42:'同查 suid_dumpable=0、core_pattern=|/bin/false 與 * hard core 0；條件性 coredump Storage/ProcessSizeMax/mask、即時值與載入效力待人工證據。',\n        43:'持久設定 randomize_va_space 精確2；即時值待真機。',\n        44:'來源明列 /etc/crypto-policies/config FUTURE/FIPS；未改查 CURRENT.pol；生效/重開機待真機。',\n        68:'來源 find 允許 root/tty/slocate/lock，但 expected 寫 root；依方法保留四群組，待批。',\n        72:'shadow 只判空欄；!/* 為非空鎖定；不輸出帳號/雜湊。',\n        73:'來源 echo $PATH；離線靜態讀 /etc/profile、/root/.bash_profile、.bashrc 的 literal PATH，受限展開 $PATH；拒絕動態語法；登入環境與其他載入來源待批。',\n        74:'沿用0073靜態PATH子集，逐目錄確認存在且無022寫入位元；登入有效環境待批。',\n        79:'依來源互動帳號集合，排除 halt/sync/shutdown 名稱前綴與 nologin/false；700位元子集，家目錄不限/home。',\n        80:'依來源 passwd 家目錄與 UID；跟隨stat symlink；缺目錄失敗。',\n        81:'依來源 passwd 家目錄與主要GID；缺目錄失敗。',\n        82:'依來源只查家目錄一層 .[A-Za-z0-9]* 普通檔、排除symlink、禁022；找到即返回。',\n        83:'依來源排除root/halt/sync/shutdown前綴，只禁非symlink普通.forward；未擴張成含root，待批。',\n        84:'依來源排除root/halt/sync/shutdown前綴，只禁非symlink普通.netrc；未讀檔案內容，待批。',\n        85:'依來源排除root/halt/sync/shutdown前綴，只禁非symlink普通.rhosts，待批。',\n        86:'passwd 所有主要GID需存在於本機group；NSS遠端群組不推測。',\n        87:'UID以整數唯一性判定。',88:'GID以整數唯一性判定。',\n        91:'要求shadow群組存在、補充成員空且無passwd主要GID引用；缺群組保守失敗，待批。',\n        303:'來源無缺檔豁免；opasswd與.old都必須存在且root:root，不讀內容。',\n        304:'來源無缺檔豁免；兩檔都必須存在且644位元子集。',\n        305:'排除註解與前後空白後禁止/nologin結尾。',\n        306:'來源OPTIONS含-F 2且不得-u root；服務執行身分/重啟生效留真機。',\n        307:'來源ptrace_scope精確1，未自行放寬2/3；即時值待真機。',\n    }.get(n,'依來源本機帳號檔唯讀解析。')\n    if 61 <= n <= 71:\n        notes += 'find -xdev、pseudo prune、-print -quit；0061–65依mountinfo逐本機磁區，0066–71固定來源目錄；24秒整體子程序預算，錯誤/逾時無PASS。分區範圍/白名單待真機。'\n    return notes + 'P2B7 UNVALIDATED；human_review_pending；execution_review=blocked；來源文字靜態唯讀子集，生效狀態/角色/覆寫需真機；缺失與錯誤無 PASS。'\n\"\"\"FIX9 emitted commands run only against temporary synthetic filesystems.\"\"\"\nimport contextlib\nimport io\nimport json\nimport os\nimport subprocess\nimport unittest\nfrom linuxgcb import batch7, batch8\nfrom linuxgcb.argv import w_strtok\nfrom linuxgcb.catalog import ROOT\nimport test_p2b8 as p2b8\n\nBASELINE = '3fb7feaf51722dc03caf88ea4d7a2c28d96a1930'\nAFFECTED = {900023,900024,900025,900073,900074,900091}\n\n\nclass Fix9Tests(unittest.TestCase):\n    setUp = p2b8.P2B8Tests.setUp\n    put = p2b8.P2B8Tests.put\n\n    def output(self, n):\n        batch = batch8 if n < 30 else batch7\n        argv = w_strtok(batch.rules()[n][0][0][2:])\n        self.assertEqual(argv[:2], ['/usr/bin/python3','-c'])\n        self.assertEqual(len(argv), 3)\n        self.assertNotIn('->', argv[2])\n        self.assertEqual(argv[2].count(\"print('PASS')\"), 1)\n        with contextlib.redirect_stdout(io.StringIO()) as out:\n            exec(argv[2].replace(\"ROOT = ''\", 'ROOT = '+repr(self.tmp.name), 1), {})\n        return out.getvalue()\n\n    def homes(self, options='rw'):\n        self.put('/etc/login.defs', 'UID_MIN 1000\\n')\n        self.put('/etc/passwd', 'alice:x:1000:1000::/home/alice:/bin/bash\\n')\n        self.info = ('1 0 253:0 / / rw - xfs /dev/mapper/root rw\\n'\n                     f'2 1 253:1 / /home {options} - xfs /dev/mapper/home rw\\n')\n        self.put('/proc/self/mountinfo', self.info)\n\n    def test_lv_longest_prefix_and_root_skip(self):\n        self.homes()\n        for n in (23,24,25): self.assertEqual(self.output(n), '')\n        self.homes('rw,nodev,nosuid,noexec')\n        for n in (23,24,25): self.assertEqual(self.output(n), 'PASS\\n')\n        self.put('/etc/passwd', 'alice:x:1000:1000::/home2/alice:/bin/bash\\n')\n        for n in (23,24,25): self.assertEqual(self.output(n), 'PASS\\n')\n        self.put('/etc/login.defs', 'UID_MIN 2000\\n')\n        self.put('/etc/passwd', 'alice:x:1000:1000::/home/alice:/bin/bash\\n')\n        for n in (23,24,25): self.assertEqual(self.output(n), 'PASS\\n')\n\n    def test_duplicate_last_pseudo_and_nested_mount(self):\n        self.homes()\n        self.put('/proc/self/mountinfo', self.info+'3 1 253:2 / /home rw,nodev,nosuid,noexec - xfs /dev/mapper/last rw\\n')\n        for n in (23,24,25): self.assertEqual(self.output(n), 'PASS\\n')\n        self.put('/proc/self/mountinfo', self.info+'3 1 0:4 / /home/alice rw - proc proc rw\\n')\n        for n in (23,24,25): self.assertEqual(self.output(n), 'PASS\\n')\n        self.put('/proc/self/mountinfo', self.info+'3 1 253:2 / /home/alice rw,nodev - xfs /dev/mapper/nested rw\\n')\n        self.assertEqual(self.output(23), 'PASS\\n')\n        self.assertEqual(self.output(24), '')\n\n    def test_path_expansion_all_assignments_and_missing_directories(self):\n        self.put('/root/.bashrc', 'PATH=\"$HOME/bin:${HOME}/sbin:$PATH:${PATH}\"\\n')\n        self.assertEqual(self.output(73), 'PASS\\n')\n        self.assertEqual(self.output(74), 'PASS\\n')\n        for value in ('.:/bin','..:/bin','relative:/bin',':/bin','/bin:', '/bin::/sbin',''):\n            self.put('/etc/profile.d/test.sh', 'PATH=\"'+value+'\"\\n')\n            self.assertEqual(self.output(73), '', value)\n        self.put('/etc/profile.d/test.sh', 'PATH=\"/missing\"\\n')\n        self.put('/root/bin/file', '')\n        os.chmod(self.tmp.name+'/root/bin', 0o755)\n        self.assertEqual(self.output(74), 'PASS\\n')\n        for mode in (0o775,0o757):\n            os.chmod(self.tmp.name+'/root/bin', mode)\n            self.assertEqual(self.output(74), '')\n\n    def test_shadow_absent_empty_members_and_primary_gid(self):\n        self.put('/etc/group', 'root:x:0:\\n')\n        self.assertEqual(self.output(91), 'PASS\\n')\n        self.put('/etc/passwd', 'alice:x:1000:1000::/home/alice:/bin/bash\\n')\n        self.put('/etc/group', 'shadow:x:42:\\n')\n        self.assertEqual(self.output(91), 'PASS\\n')\n        self.put('/etc/group', 'shadow:x:42:alice\\n')\n        self.assertEqual(self.output(91), '')\n        self.put('/etc/group', 'shadow:x:1000:\\n')\n        self.assertEqual(self.output(91), '')\n\n    def test_exact_six_rules_and_protected_artifacts(self):\n        old, new = {}, {}\n        for p in (ROOT/'policies').glob('*.yml'):\n            prior = json.loads(subprocess.check_output(['git','show',BASELINE+':policies/'+p.name],cwd=ROOT))\n            current = json.loads(p.read_text())\n            self.assertEqual(prior['policy'], current['policy'])\n            self.assertEqual(prior['requirements'], current['requirements'])\n            old.update({c['id']:c for c in prior['checks']})\n            new.update({c['id']:c for c in current['checks']})\n        self.assertEqual(len(new),307)\n        self.assertEqual(set(old),set(new))\n        self.assertEqual({n for n in old if old[n] != new[n]}, AFFECTED)\n        for n in old: self.assertEqual(dict(new[n],rules=old[n]['rules']),old[n])\n        protected = ['data/coverage_manifest.json','data/scope_registry.json','data/controls.json','data/inventory.json','docs/references','tests/fixtures','tests/fix5_baseline.json','docs/*TEST_OUTPUT*']\n        self.assertEqual(subprocess.check_output(['git','diff',BASELINE,'--name-only','--',*protected],cwd=ROOT,text=True),'')\n\"\"\"以 JSON（YAML 1.2 子集）產生候選 SCA；只模擬輸出匹配，不執行命令。\"\"\"\nfrom .batch10 import ADDED as BATCH10, rules as batch10_rules\nimport json\nimport re\nfrom functools import lru_cache\nfrom .catalog import ROOT, registry, digest\nfrom .batch1 import rules as batch_rules, disabled_service_rules\nfrom .expected import PREFIX, values, parse_description\nfrom .batch2 import rules as batch2_rules, ADDED as BATCH2\nfrom .batch3 import rules as batch3_rules, ADDED as BATCH3\nfrom .batch6 import rules as batch6_rules, ADDED as BATCH6\nfrom .batch7 import rules as batch7_rules, ADDED as BATCH7\nfrom .batch9 import ADDED as BATCH9, rules as batch9_rules\nfrom .batch8 import rules as batch8_rules, ADDED as BATCH8\nfrom .argv import w_strtok\n\n\ndef definitions():\n    modes = '|'.join(format(n, 'o') for n in range(0o1000) if n & ~0o644 == 0)\n    return {**batch_rules(), **batch2_rules(), **batch3_rules(), **batch6_rules(), **batch7_rules(), **batch8_rules(), **batch9_rules(), **batch10_rules(),\n        45: [('c:/usr/bin/stat -c %u:%g /etc/passwd', '^0:0$')],\n        46: [('c:/usr/bin/stat -c %a /etc/passwd', '^('+modes+')$')],\n        108: [('c:/usr/sbin/sysctl -n net.ipv4.ip_forward', '^0$'),\n              ('c:/usr/sbin/sysctl -n net.ipv6.conf.all.forwarding', '^0$')],\n        243: [('c:/usr/bin/systemctl show firewalld.service --property=LoadState', '^LoadState=loaded$'),\n              ('c:/usr/bin/systemctl show firewalld.service --property=ActiveState', '^ActiveState=active$'),\n              ('c:/usr/bin/systemctl show firewalld.service --property=UnitFileState', '^UnitFileState=enabled$')],\n        245: disabled_service_rules('nftables'),\n        269: [('c:/usr/sbin/sshd -T', '^permitrootlogin no$')],\n        270: [('c:/usr/sbin/sshd -T', '^permitemptypasswords no$')],\n    }\n\n\ndef build():\n    rows = registry()\n    expected = values()\n    for profile in ('base', 'firewalld', 'sshd'):\n        filename = 'linuxgcb_'+profile+'.yml'\n        checks = []\n        for row in rows:\n            if row['implementation'] != 'candidate' or row['profile'] != profile:\n                continue\n            checks.append(dict(id=row['sca_id'], title=row['gcb_id']+' '+row['title'],\n                description=PREFIX+expected[row['gcb_id']]+(' ｜ P2B10 執行審查 ' if row['sca_id']-900000 in BATCH10 else ' ｜ P2B9 執行審查 ' if row['sca_id']-900000 in BATCH9 else ' ｜ P2B8 執行審查 ' if row['sca_id']-900000 in BATCH8 else ' ｜ P2B7 執行審查 ' if row['sca_id']-900000 in BATCH7 else ' ｜ P2B6 執行審查 ' if row['sca_id']-900000 in BATCH6 else ' ｜ P2B3 執行審查 ' if row['sca_id']-900000 in BATCH3 else ' ｜ BATCH2 執行審查 ' if row['sca_id']-900000 in BATCH2 else ' ｜ Q1 執行審查 ')+row['execution_review']+'；coverage='+row['coverage']+'；'+','.join(row['issue_ids'])+'；raw PASS 非已驗證符合。'+row['pending'],\n                compliance=[{'twgcb': [row['gcb_id']]}], regex_type='pcre2', condition='all',\n                rules=[emit_rule(target, pattern) for target, pattern in definitions()[int(row['gcb_id'][-4:])]]))\n        policy = dict(policy=dict(id='linuxgcb_rhel9_'+profile+'_v01', file=filename,\n                      name='RHEL9 GCB v1.2 '+profile+' v0.1 UNVALIDATED',\n                      description='未驗證候選政策；僅供核准 RHEL9 試點，非完整符合性檢核', regex_type='pcre2'),\n                      requirements=dict(title='僅 RHEL 9', description='角色由核准群組控制',\n                        condition='all', rules=['f:/etc/os-release -> r:^ID=\"?rhel\"?$',\n                                               'f:/etc/os-release -> r:^VERSION_ID=\"?9([.][0-9]+)*\"?$']),\n                      checks=checks)\n        (ROOT/'policies'/filename).write_text(json.dumps(policy, ensure_ascii=False, indent=2)+'\\n')\n    hashes = {p.name: digest(p) for p in sorted((ROOT/'policies').glob('*.yml'))}\n    (ROOT/'data/policy_hashes.json').write_text(json.dumps(hashes, indent=2)+'\\n')\n    from .coverage import write\n    write()\n    validate()\n\n\ndef require(condition):\n    if not condition:\n        raise ValueError('候選政策結構、mapping 或 hash 不符')\n\n\ndef validate():\n    rows = {r['sca_id']: r for r in registry()}\n    seen = set()\n    for path in sorted((ROOT/'policies').glob('*.yml')):\n        p = json.loads(path.read_text())\n        require(p['policy']['file'] == path.name and p['policy']['regex_type']=='pcre2')\n        require(p['requirements'] == dict(title='僅 RHEL 9', description='角色由核准群組控制',\n            condition='all', rules=['f:/etc/os-release -> r:^ID=\"?rhel\"?$',\n                                   'f:/etc/os-release -> r:^VERSION_ID=\"?9([.][0-9]+)*\"?$']))\n        for c in p['checks']:\n            require(c['id'] not in seen and rows[c['id']]['included'])\n            seen.add(c['id'])\n            require(parse_description(c.get('description')) == values()[rows[c['id']]['gcb_id']])\n            require((' ｜ P2B10 ' if c['id']-900000 in BATCH10 else ' ｜ P2B9 ' if c['id']-900000 in BATCH9 else ' ｜ P2B8 ' if c['id']-900000 in BATCH8 else ' ｜ P2B7 ' if c['id']-900000 in BATCH7 else ' ｜ P2B6 ' if c['id']-900000 in BATCH6 else ' ｜ P2B3 ' if c['id']-900000 in BATCH3 else ' ｜ BATCH2 ' if c['id']-900000 in BATCH2 else ' ｜ Q1 ') in c['description'])\n            require(c['regex_type'] == 'pcre2' and c['condition'] == 'all')\n            require(c['compliance'] == [{'twgcb': [rows[c['id']]['gcb_id']]}])\n            require(rows[c['id']]['policy_id'] == p['policy']['id'])\n            require(c['rules'] == [emit_rule(a,b) for a,b in definitions()[c['id']-900000]])\n            for rule in c['rules']:\n                target, _ = rule.split(' -> ', 1)\n                require(target.removeprefix('not ').startswith('c:/'))\n                if c['id']-900000 not in BATCH2 | BATCH3 | BATCH6 | BATCH7 | BATCH8 | BATCH9 | BATCH10:\n                    require(not any(x in target for x in ('|',';', '&&', '$', '`')))\n                parse_rule(rule)\n    require(seen == {900000+n for n in definitions()})\n    hashes = json.loads((ROOT/'data/policy_hashes.json').read_text())\n    require(hashes == {p.name:digest(p) for p in (ROOT/'policies').glob('*.yml')})\n    from .coverage import manifest\n    require(json.loads((ROOT/'data/coverage_manifest.json').read_text()) == manifest())\n    require(seen == {r['sca_id'] for r in rows.values() if r['implementation']=='candidate'})\n    return len(seen)\n\n\n@lru_cache(maxsize=1)\nagent.conf.example\nindex-mapping.json\ndocs/FIX1_REVIEW.md\ndocs/FIX1_TEST_OUTPUT.txt\ndocs/FIX2_REVIEW.md\ndocs/FIX3_REVIEW.md\ndocs/FIX4_REVIEW.md\ndocs/FIX5_REVIEW.md\ndocs/FIX6_REVIEW.md\ndocs/FIX7_REVIEW.md\ndocs/FIX8_REVIEW.md\ndocs/FIX9_REVIEW.md\n","exit_code":0,"status":"completed"}}

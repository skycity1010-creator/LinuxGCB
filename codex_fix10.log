ttp://schemas.openxmlformats.org/wordprocessingml/2006/main'}\\n    xml = ET.fromstring(ZipFile(docx).read('word/document.xml'))\\n    tables = [['\\\\n'.join(''.join(t.text or '' for t in p.findall('.//w:t',ns))\\n              for p in cell.findall('.//w:p',ns)) for cell in tr.findall('w:tc',ns)]\\n              for tr in xml.findall('.//w:tr',ns)]\\n    out = {}\\n    for r in extract(next(root.glob('*.xlsx'))):\\n        n = int(r['gcb_id'][-4:])\\n        if n not in ADDED:\\n            continue\\n        matches = [c for c in tables if r['gcb_id'] in c and c[-1] == r['expected'] and c[-2] == r['configuration_method']]\\n        if not matches or any(c[-2:] != matches[0][-2:] for c in matches):\\n            raise ValueError('GCB DOCX/XLSX source mismatch: '+r['gcb_id'])\\n        out[n] = dict(r, configuration_method=matches[0][-2])\\n    if set(out) != ADDED:\\n        raise ValueError('incomplete P2B8 source set')\\n    return out\\n\\n\\ndef script(n):\\n    runtime = inspect.getsource(p2b8_runtime)\\n    if n in {8,9,13,14,15,16,23,24,25}:\\n        runtime += '\\\\n' + inspect.getsource(fix7_runtime.mountinfo) + '\\\\n' + inspect.getsource(fix7_runtime.independent)\\n    return runtime + '\\\\ntry:\\\\n    ok = check(' + str(n) + \\\")\\\\nexcept (OSError, ValueError, IndexError, KeyError, subprocess.SubprocessError):\\\\n    ok = False\\\\nif ok is None:\\\\n    print('REVIEW')\\\\nelif ok:\\\\n    print('PASS')\\\\n\\\"\\n\\n\\n@lru_cache(maxsize=1)\\ndef rules():\\n    return {n:[('c:/usr/bin/python3 -c ' + quote_argument(script(n)), '^PASS$|^REVIEW$')] for n in sorted(ADDED)}\\n\\n\\ndef caveat(n):\\n    if n in MODULES:\\n        note = '精確 install 模組 /bin/true 與 blacklist 模組；不以模組不存在豁免；載入狀態與重新開機待真機。'\\n    elif n in (8,9,13,14,15):\\n        note = 'mountinfo 確認掛載點、裝置號不同於根與其他祖先、root=/，來源獨立裝置；bind/subpath 不算。'\\n    elif n == 29:\\n        note = '來源 df --local -P 逐本機磁區，find -xdev -type d -perm -0002 ! -perm -1000 -print -quit；24秒整體預算。'\\n    elif 20 <= n <= 22:\\n        note = '由 sysfs 裝置 removable 與父裝置辨識可攜式掛載；無對象或裝置無法分類輸出 REVIEW，並非符合或違規；USB 固定式及非 block 可攜式辨識待批。'\\n    elif 23 <= n <= 25:\\n        note = '來源 passwd UID>=1000 且非 nobody，只查家目錄本身獨立掛載；無對象輸出 REVIEW；以即時值取代來源 fstab 按任務要求，待批。'\\n    elif 26 <= n <= 28:\\n        note = '來源條件式 NFS；查即時 nfs/nfs4 掛載選項，無對象輸出 REVIEW；fstab 尚未掛載項之適用性另審。'\\n    else:\\n        note = '讀 /proc/mounts 精確掛載點、類型或完整 option token；缺掛載失敗；持久設定及生效差異待真機。'\\n    return note + ' P2B8 UNVALIDATED；human_review_pending；execution_review=blocked；REVIEW 在輸出匹配層為 raw passed，但 coverage partial 且 blocked，必須人工判定適用性，不是已驗證 PASS。'\\n\\\"\\\"\\\"P2B7 source-bound offline candidates, direct w_strtok Python argv.\\\"\\\"\\\"\\nimport inspect\\nimport hashlib\\nfrom zipfile import ZipFile\\nfrom xml.etree import ElementTree as ET\\nfrom functools import lru_cache\\nfrom pathlib import Path\\nfrom . import p2b7_runtime\\nfrom .argv import quote_argument\\nADDED = {32} | set(range(34,45)) | set(range(61,92)) | set(range(303,308))\\n\\n\\n@lru_cache(maxsize=1)\\ndef sources():\\n    from scripts.inventory import extract\\n    root = Path(__file__).resolve().parents[1]\\n    docx = root/'docs/references/gcb-rhel9-v1.2.docx'\\n    if hashlib.sha256(docx.read_bytes()).hexdigest() != '986effd9501b1fd97776129c6691cf8fc98246bd04514347322f3337508e0e5b':\\n        raise ValueError('GCB v1.2 reference hash changed')\\n    ns = {'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}\\n    xml = ET.fromstring(ZipFile(docx).read('word/document.xml'))\\n    tables = [['\\\\n'.join(''.join(t.text or '' for t in p.findall('.//w:t',ns))\\n              for p in cell.findall('.//w:p',ns)) for cell in tr.findall('w:tc',ns)]\\n              for tr in xml.findall('.//w:tr',ns)]\\n    out = {}\\n    for r in extract(next(root.glob('*.xlsx'))):\\n        n = int(r['gcb_id'][-4:])\\n        if n not in ADDED:\\n            continue\\n        matches = [c for c in tables if r['gcb_id'] in c and c[-1] == r['expected'] and c[-2] == r['configuration_method']]\\n        if not matches or any(c[-2:] != matches[0][-2:] for c in matches):\\n            raise ValueError('GCB DOCX/XLSX source mismatch: '+r['gcb_id'])\\n        out[n] = dict(r, configuration_method=matches[0][-2])\\n    if set(out) != ADDED:\\n        raise ValueError('incomplete P2B7 source set')\\n    return out\\n\\n\\ndef script(n):\\n    source = inspect.getsource(p2b7_runtime)\\n    # Preserve byte-identical embedded scripts outside the FIX6 ID family.\\n    if n not in set(range(79,86)) | {303,304}:\\n        source = source.replace(\\\"u[6].endswith(('/nologin','/false'))\\\", \\\"u[6] in ('/sbin/nologin','/bin/false')\\\")\\n        source = source.replace(\\\"        for p in ('/etc/security/opasswd','/etc/security/opasswd.old'):\\\\n            try:\\\\n                ok = meta(p,uid=0,gid=0) if n == 303 else meta(p,mode=0o644)\\\\n            except FileNotFoundError:\\\\n                continue\\\\n            if not ok:\\\\n                return False\\\\n        return True\\\", \\\"        return all(meta(p,uid=0,gid=0) if n == 303 else meta(p,mode=0o644) for p in ('/etc/security/opasswd','/etc/security/opasswd.old'))\\\")\\n    return source + '\\\\ntry:\\\\n    ok = check(' + str(n) + \\\")\\\\nexcept (OSError, ValueError, IndexError, KeyError, subprocess.SubprocessError):\\\\n    ok = False\\\\nif ok:\\\\n    print('PASS')\\\\n\\\"\\n\\n\\n@lru_cache(maxsize=1)\\ndef rules():\\n    return {n:[('c:/usr/bin/python3 -c ' + quote_argument(script(n)), '^PASS$')] for n in sorted(ADDED)}\\n\\n\\ndef mechanism(n):\\n    return '逐條來源唯讀 predicate；直接 python3 -c argv；單一 PASS commit'\\n\\n\\ndef caveat(n):\\n    notes = {\\n        32:'main 與 repo 檔同查 gpgcheck/localpkg_gpgcheck=1；各repo section皆需雙key；繼承與生效待批。',\\n        34:'只接受未限定 Defaults use_pty；限定使用者/主機、include、續行與覆寫待審。',\\n        35:'logfile 要求非空絕對路徑；來源 /var/log/sudo.log 僅範例；複雜 sudoers 語意待審。',\\n        36:'定向 rpm -q aide 三態；初始化資料庫動作未執行，資料庫生效另審。',\\n        37:'來源 root crontab 每天5點；expected 每天允許合法固定分時；依任務另接受 cron.daily 可執行檔明確 /usr/sbin/aide --check。排程替代需批。',\\n        38:'來源 BIOS grub.cfg/grubenv/選用user.cfg；UEFI fstab uid=0,gid=0；未自行增加 loader/entries。',\\n        39:'來源 BIOS 600 位元子集；UEFI fmask=0177；未自行增加 loader/entries。',\\n        40:'靜態確認 grub2-setpassword 產生之 user.cfg PBKDF2 宣告；grub.cfg 載入與重建效果留真機。',\\n        41:'來源 rescue/emergency.service ExecStart 精確比對；systemd drop-in 實際生效留真機。',\\n        42:'同查 suid_dumpable=0、core_pattern=|/bin/false 與 * hard core 0；條件性 coredump Storage/ProcessSizeMax/mask、即時值與載入效力待人工證據。',\\n        43:'持久設定 randomize_va_space 精確2；即時值待真機。',\\n        44:'來源明列 /etc/crypto-policies/config FUTURE/FIPS；未改查 CURRENT.pol；生效/重開機待真機。',\\n        68:'來源 find 允許 root/tty/slocate/lock，但 expected 寫 root；依方法保留四群組，待批。',\\n        72:'shadow 只判空欄；!/* 為非空鎖定；不輸出帳號/雜湊。',\\n        73:'來源 echo $PATH；離線靜態讀 /etc/profile、/root/.bash_profile、.bashrc 的 literal PATH，受限展開 $PATH；拒絕動態語法；登入環境與其他載入來源待批。',\\n        74:'沿用0073靜態PATH子集，逐目錄確認存在且無022寫入位元；登入有效環境待批。',\\n        79:'依來源互動帳號集合，排除 halt/sync/shutdown 名稱前綴與 nologin/false；700位元子集，家目錄不限/home。',\\n        80:'依來源 passwd 家目錄與 UID；跟隨stat symlink；缺目錄失敗。',\\n        81:'依來源 passwd 家目錄與主要GID；缺目錄失敗。',\\n        82:'依來源只查家目錄一層 .[A-Za-z0-9]* 普通檔、排除symlink、禁022；找到即返回。',\\n        83:'依來源排除root/halt/sync/shutdown前綴，只禁非symlink普通.forward；未擴張成含root，待批。',\\n        84:'依來源排除root/halt/sync/shutdown前綴，只禁非symlink普通.netrc；未讀檔案內容，待批。',\\n        85:'依來源排除root/halt/sync/shutdown前綴，只禁非symlink普通.rhosts，待批。',\\n        86:'passwd 所有主要GID需存在於本機group；NSS遠端群組不推測。',\\n        87:'UID以整數唯一性判定。',88:'GID以整數唯一性判定。',\\n        91:'要求shadow群組存在、補充成員空且無passwd主要GID引用；缺群組保守失敗，待批。',\\n        303:'來源無缺檔豁免；opasswd與.old都必須存在且root:root，不讀內容。',\\n        304:'來源無缺檔豁免；兩檔都必須存在且644位元子集。',\\n        305:'排除註解與前後空白後禁止/nologin結尾。',\\n        306:'來源OPTIONS含-F 2且不得-u root；服務執行身分/重啟生效留真機。',\\n        307:'來源ptrace_scope精確1，未自行放寬2/3；即時值待真機。',\\n    }.get(n,'依來源本機帳號檔唯讀解析。')\\n    if 61 <= n <= 71:\\n        notes += 'find -xdev、pseudo prune、-print -quit；0061–65依mountinfo逐本機磁區，0066–71固定來源目錄；24秒整體子程序預算，錯誤/逾時無PASS。分區範圍/白名單待真機。'\\n    return notes + 'P2B7 UNVALIDATED；human_review_pending；execution_review=blocked；來源文字靜態唯讀子集，生效狀態/角色/覆寫需真機；缺失與錯誤無 PASS。'\\n\\\"\\\"\\\"Mountinfo overrides embedded only in the nine FIX7 candidates.\\\"\\\"\\\"\\n\\n\\ndef mountinfo():\\n    class MountInfo(dict):\\n        pass\\n    out = MountInfo()\\n    out.duplicates = set()\\n    for line in read('/proc/self/mountinfo').splitlines():\\n        a,b = line.split(' - ',1)\\n        f = a.split(); tail = b.split()\\n        if len(f)<6 or len(tail)<3: raise ValueError('mountinfo record')\\n        path=unescape(f[4])\\n        if path in out: out.duplicates.add(path)\\n        out[path]=(f[2],unescape(f[3]),tail[0])\\n    if '/' not in out: raise ValueError('no root')\\n    return out\\n\\n\\ndef independent(path, info):\\n    if any(p==path or p=='/' or path.startswith(p.rstrip('/')+'/') or\\n           p.startswith(path.rstrip('/')+'/') for p in info.duplicates):\\n        raise ValueError('stacked mount requires review')\\n    if path not in info or info[path][1] != '/' or info[path][0].startswith('0:'): return False\\n    return all(info[path][0]!=v[0] for p,v in info.items() if p!=path and (p=='/' or path.startswith(p.rstrip('/')+'/')))\\n\\\"\\\"\\\"Read-only source predicates; ROOT is used only by isolated tests.\\\"\\\"\\\"\\nimport glob\\nimport os\\nimport re\\nimport subprocess\\nimport time\\nROOT = ''\\nMODULES = dict(zip([1,2,3,31]+list(range(285,301)),\\n    ['cramfs','squashfs','udf','usb-storage','freevxfs','hfs','hfsplus','jffs2','afs','ceph','cifs','exfat','ext','fat','fscache','fuse','gfs2','nfs_common','nfsd','smbfs_common']))\\nFIXED = {5:('/tmp','nodev'),6:('/tmp','nosuid'),7:('/tmp','noexec'),10:('/var/tmp','nodev'),11:('/var/tmp','nosuid'),12:('/var/tmp','noexec'),16:('/home','nodev'),17:('/dev/shm','nodev'),18:('/dev/shm','nosuid'),19:('/dev/shm','noexec')}\\nPARTITIONS = {8:'/var',9:'/var/tmp',13:'/var/log',14:'/var/log/audit',15:'/home'}\\n\\n\\ndef read(path):\\n    with open(ROOT+path, encoding='utf-8') as f:\\n        return f.read()\\n\\n\\ndef unescape(s):\\n    return re.sub(r'\\\\\\\\([0-7]{3})',lambda m:chr(int(m[1],8)),s)\\n\\n\\ndef mounts():\\n    out = []\\n    for line in read('/proc/mounts').splitlines():\\n        if not line.strip() or line.lstrip().startswith('#'): continue\\n        f = line.split()\\n        if len(f) != 6: raise ValueError('mount record')\\n        out.append((unescape(f[0]),unescape(f[1]),f[2],set(f[3].split(','))))\\n    if not out: raise ValueError('empty mount table')\\n    return out\\n\\n\\ndef mountinfo():\\n    out = {}\\n    for line in read('/proc/self/mountinfo').splitlines():\\n        a,b = line.split(' - ',1)\\n        f = a.split(); tail = b.split()\\n        if len(f)<6 or len(tail)<3: raise ValueError('mountinfo record')\\n        path=unescape(f[4])\\n        if path in out: raise ValueError('stacked mount requires review')\\n        out[path]=(f[2],unescape(f[3]),tail[0])\\n    if '/' not in out: raise ValueError('no root')\\n    return out\\n\\n\\ndef independent(path, info):\\n    if path not in info or info[path][1] != '/' or info[path][0].startswith('0:'): return False\\n    return all(info[path][0]!=v[0] for p,v in info.items() if p!=path and (p=='/' or path.startswith(p.rstrip('/')+'/')))\\n\\n\\ndef removable(source):\\n    # Resolve kernel block class symlinks, then examine partition and disk ancestors.\\n    if not source.startswith('/dev/'): return None\\n    name=os.path.basename(os.path.realpath(ROOT+source))\\n    base=ROOT+'/sys/class/block/'+name\\n    if not os.path.exists(base): return None\\n    base=os.path.realpath(base)\\n    boundary=os.path.realpath(ROOT+'/sys')\\n    while base.startswith(boundary+'/'):\\n        p=base+'/removable'\\n        if os.path.isfile(p):\\n            with open(p) as f: value=f.read().strip()\\n            if value not in ('0','1'): raise ValueError('removable flag')\\n            return value=='1'\\n        base=os.path.dirname(base)\\n    return None\\n\\n\\ndef scan_argv(path):\\n    return ['/usr/bin/find',path,'-xdev','-type','d','-perm','-0002','!','-perm','-1000','-print','-quit']\\n\\n\\ndef check(n):\\n    if n in MODULES:\\n        module=MODULES[n]; install=[]; blacklist=False\\n        for path in sorted(glob.glob(ROOT+'/etc/modprobe.d/*.conf')):\\n            with open(path) as f:\\n                for line in f:\\n                    fields=line.split('#',1)[0].strip().split()\\n                    if len(fields)>=2 and fields[1]==module:\\n                        if fields[0]=='install': install.append(fields[2:])\\n                        if fields==['blacklist',module]: blacklist=True\\n        return bool(install) and all(x==['/bin/true'] for x in install) and blacklist\\n    if n==29:\\n        end=time.monotonic()+24\\n        df=subprocess.run(['/usr/bin/df','--local','-P'],capture_output=True,text=True,timeout= max(.01,end-time.monotonic()))\\n        if df.returncode or df.stderr: return False\\n        lines=df.stdout.splitlines()[1:]\\n        if not lines: return False\\n        for line in lines:\\n            if time.monotonic() >= end: raise ValueError('scan budget exhausted')\\n            f=line.split()\\n            if len(f)!=6: raise ValueError('df record')\\n            result=subprocess.run(scan_argv(unescape(f[5])),capture_output=True,text=True,timeout=max(.01,end-time.monotonic()))\\n            if result.returncode or result.stdout or result.stderr: return False\\n        return True\\n    ms=mounts()\\n    if n==4:\\n        selected=[m for m in ms if m[1]=='/tmp']\\n        return len(selected)==1 and selected[0][2]=='tmpfs'\\n    if n in PARTITIONS: return independent(PARTITIONS[n],mountinfo())\\n    if n in FIXED:\\n        path,opt=FIXED[n]; selected=[m for m in ms if m[1]==path]\\n        return len(selected)==1 and opt in selected[0][3]\\n    opt=('nodev','nosuid','noexec')[(n-20)%3]\\n    if 20<=n<=22:\\n        selected=[]; unknown=False\\n        for m in ms:\\n            if m[0].startswith('/dev/'):\\n                r=removable(m[0])\\n                if r is None: unknown=True\\n                if r: selected.append(m)\\n        if any(opt not in m[3] for m in selected): return False\\n        if unknown or not selected: return None\\n    elif 23<=n<=25:\\n        info=mountinfo(); homes=set()\\n        for line in read('/etc/passwd').splitlines():\\n            if not line.strip() or line.lstrip().startswith('#'): continue\\n            f=line.split(':')\\n            if len(f)!=7: raise ValueError('passwd record')\\n            if int(f[2])>=1000 and f[0]!='nobody': homes.add(f[5])\\n        selected=[m for m in ms if m[1] in homes and independent(m[1],info)]\\n    elif 26<=n<=28:\\n        selected=[m for m in ms if m[2] in ('nfs','nfs4')]\\n    else: raise ValueError('unknown rule')\\n    if not selected: return None\\n    return all(opt in m[3] for m in selected)\\n\\\"\\\"\\\"Read-only source predicates. ROOT is only for isolated offline tests.\\\"\\\"\\\"\\nimport glob\\nimport os\\nimport re\\nimport shlex\\nimport stat\\nimport subprocess\\nimport time\\nROOT = ''\\n\\n\\ndef path(p):\\n    return ROOT + p\\n\\n\\ndef read(p):\\n    with open(path(p), encoding='utf-8') as f:\\n        return f.read()\\n\\n\\ndef files(pattern):\\n    return sorted(p[len(ROOT):] if ROOT else p for p in glob.iglob(path(pattern)))\\n\\n\\ndef lines(p):\\n    return [s.split('#', 1)[0].strip() for s in read(p).splitlines() if s.split('#', 1)[0].strip()]\\n\\n\\ndef values(paths, key):\\n    out = []\\n    for p in paths:\\n        for s in lines(p):\\n            m = re.fullmatch(re.escape(key) + r'\\\\s*=\\\\s*(.*?)\\\\s*', s)\\n            if m:\\n                out.append(m[1])\\n    return out\\n\\n\\ndef setting(paths, key, expected):\\n    v = values(paths, key)\\n    return bool(v) and all(x == expected for x in v)\\n\\n\\ndef meta(p, mode=None, uid=None, gid=None):\\n    s = os.stat(path(p))\\n    return (mode is None or stat.S_IMODE(s.st_mode) & ~mode == 0) and (uid is None or s.st_uid == uid) and (gid is None or s.st_gid == gid)\\n\\n\\ndef records(p, size):\\n    rows = [s.split(':') for s in read(p).splitlines() if s]\\n    if not rows or any(len(s) != size or not s[0] for s in rows):\\n        raise ValueError('invalid account database')\\n    return rows\\n\\n\\ndef scan_argv(n, mount=None):\\n    commands = ['/bin','/sbin','/usr/bin','/usr/sbin','/usr/local/bin','/usr/local/sbin']\\n    libraries = ['/lib','/lib64','/usr/lib','/usr/lib64']\\n    roots = [mount] if n <= 65 else commands if n <= 68 else libraries\\n    predicates = {\\n        61:['-type','f','-perm','-0002'], 62:['-nouser'],63:['-nogroup'],\\n        64:['-type','d','-perm','-0002','-uid','+999'],65:['-type','d','-perm','-0002','-gid','+999'],\\n        66:['-perm','/0022'],67:['!','-user','root'],\\n        68:['!','-group','root','!','-group','tty','!','-group','slocate','!','-group','lock'],\\n        69:['-perm','/0022','-type','f'],70:['!','-user','root'],71:['!','-group','root']}\\n    return ['/usr/bin/find'] + ([] if n <= 65 else ['-L']) + [path(p) for p in roots] + ['-xdev','(','-path',path('/proc'),'-o','-path',path('/sys'),'-o','-path',path('/dev'),'-o','-path',path('/run'),')','-prune','-o','('] + predicates[n] + [')','-print','-quit']\\n\\n\\ndef scan(n):\\n    # Source partitions are read from mountinfo; pseudo/network filesystems excluded.\\n    if n <= 65:\\n        local = {'ext2','ext3','ext4','xfs','btrfs','vfat','f2fs','jfs','reiserfs'}\\n        roots = []\\n        for s in read('/proc/self/mountinfo').splitlines():\\n            left, right = s.split(' - ', 1)\\n            if right.split()[0] in local:\\n                mount = re.sub(r'\\\\\\\\([0-7]{3})', lambda m: chr(int(m[1],8)), left.split()[4])\\n                if not any(mount == p or mount.startswith(p+'/') for p in ('/proc','/sys','/dev','/run')):\\n                    roots.append(mount)\\n        if not roots:\\n            return False\\n    else:\\n        roots = [None]\\n    deadline = time.monotonic() + 24\\n    for mount in dict.fromkeys(roots):\\n        remaining = deadline - time.monotonic()\\n        if remaining <= 0:\\n            return False\\n        result = subprocess.run(scan_argv(n,mount), capture_output=True, text=True, timeout=remaining)\\n        if result.returncode != 0 or result.stdout or result.stderr:\\n            return False\\n    return True\\n\\n\\ndef root_path():\\n    # Do not execute shell startup files. Expand only literal PATH assignments.\\n    current = None\\n    for p in ['/etc/profile','/root/.bash_profile','/root/.bashrc']:\\n        if not os.path.exists(path(p)):\\n            continue\\n        for s in lines(p):\\n            m = re.fullmatch(r'(?:export\\\\s+)?PATH\\\\s*=\\\\s*(.*?)(?:;\\\\s*export\\\\s+PATH)?',s)\\n            if not m:\\n                continue\\n            v = shlex.split(m[1])\\n            if len(v) != 1:\\n                raise ValueError('ambiguous PATH')\\n            v = v[0]\\n            if '$PATH' in v or '${PATH}' in v:\\n                if current is None:\\n                    raise ValueError('unresolved PATH')\\n                v = re.sub(r'\\\\$\\\\{PATH\\\\}|\\\\$PATH(?![A-Za-z0-9_])',lambda m: current,v)\\n            if any(c in v for c in '$`;\\\\\\\\'):\\n                raise ValueError('dynamic PATH')\\n            current = v\\n        limits = (['/etc/security/limits.conf'] if os.path.exists(path('/etc/security/limits.conf')) else []) + files('/etc/security/limits.d/*.conf')\\n        core = [s.split() for p in limits for s in lines(p) if re.match(r'^\\\\*\\\\s+hard\\\\s+core\\\\s+',s)]\\n        return ok and setting(ps,'kernel.core_pattern','|/bin/false') and bool(core) and all(len(s)==4 and int(s[3])==0 for s in core)\\n    if n == 44:\\n        v = lines('/etc/crypto-policies/config')\\n        return bool(v) and all(s.upper() in ('FUTURE','FIPS') for s in v)\\n    if 61 <= n <= 71:\\n        return scan(n)\\n    if n == 72:\\n        return all(s[1] != '' for s in records('/etc/shadow',9))\\n    if n in (73,74):\\n        ps = root_path()\\n        if any(not p.startswith('/') or '..' in p.split('/') or p == '.' for p in ps):\\n            return False\\n        return True if n == 73 else all(os.path.isdir(path(p)) and meta(p,mode=0o7755) for p in ps)\\n    if n in (75,76,77):\\n        p = {75:'/etc/passwd',76:'/etc/shadow',77:'/etc/group'}[n]\\n        return not any(s.startswith('+:') for s in read(p).splitlines())\\n    if n == 78:\\n        return [s[0] for s in records('/etc/passwd',7) if int(s[2]) == 0] == ['root']\\n    if 79 <= n <= 85:\\n        users = records('/etc/passwd',7)\\n        for u in users:\\n            excluded = r'^(root|halt|sync|shutdown)' if n >= 83 else r'^(halt|sync|shutdown)'\\n            if re.match(excluded,u[0]) or u[6].endswith(('/nologin','/false')):\\n                continue\\n            home = u[5]\\n            if not home.startswith('/') or not os.path.isdir(path(home)):\\n                return False\\n            if n == 79 and not meta(home,mode=0o700): return False\\n            if n == 80 and not meta(home,uid=int(u[2])): return False\\n            if n == 81 and not meta(home,gid=int(u[3])): return False\\n            if n == 82:\\n                for p in files(home.rstrip('/')+'/.[A-Za-z0-9]*'):\\n                    if not os.path.islink(path(p)) and os.path.isfile(path(p)) and os.stat(path(p)).st_mode & 0o022:\\n                        return False\\n            if n >= 83:\\n                p = home.rstrip('/') + '/' + {83:'.forward',84:'.netrc',85:'.rhosts'}[n]\\n                if not os.path.islink(path(p)) and os.path.isfile(path(p)):\\n                    return False\\n        return True\\n    if n == 86:\\n        groups = {int(s[2]) for s in records('/etc/group',4)}\\n        return all(int(s[3]) in groups for s in records('/etc/passwd',7))\\n    if n in (87,88,89,90):\\n        p, size, col = {87:('/etc/passwd',7,2),88:('/etc/group',4,2),89:('/etc/passwd',7,0),90:('/etc/group',4,0)}[n]\\n        v = [int(s[col]) if col == 2 else s[col] for s in records(p,size)]\\n        return len(v) == len(set(v))\\n    if n == 91:\\n        groups = [s for s in records('/etc/group',4) if s[0] == 'shadow']\\n        return len(groups)==1 and groups[0][3]=='' and all(int(s[3]) != int(groups[0][2]) for s in records('/etc/passwd',7))\\n    if n in (303,304):\\n        for p in ('/etc/security/opasswd','/etc/security/opasswd.old'):\\n            try:\\n                ok = meta(p,uid=0,gid=0) if n == 303 else meta(p,mode=0o644)\\n            except FileNotFoundError:\\n                continue\\n            if not ok:\\n                return False\\n        return True\\n    if n == 305:\\n\\\"\\\"\\\"Rebuild only BATCH2 synthetic observations from emitted targets; no execution.\\\"\\\"\\\"\\nimport copy\\nimport json\\nfrom linuxgcb.catalog import ROOT\\nfrom linuxgcb.batch2 import ABSENT_PACKAGES, ADDED, MARKER, guarded, specs\\nfrom linuxgcb.policy import emit_rule\\n\\n\\ndef generated():\\n    checks={c['id']:c for p in (ROOT/'policies').glob('*.yml') for c in json.loads(p.read_text())['checks']}\\n    result={}\\n    for n,items in specs().items():\\n        check=checks[900000+n]\\n        targets={rule.split(' -> ',1)[0].removeprefix('not ') for rule in check['rules']}\\n        positive={t:dict(stdout='',exit_code=0) for t in targets}\\n        for cmd,pattern,good,bad in items:\\n            rule=emit_rule(guarded(cmd),pattern)\\n            assert rule in check['rules'], (n,rule)\\n            target=rule.split(' -> ',1)[0].removeprefix('not ')\\n            positive[target]['stdout']+='\\\\n'+good\\n        for obs in positive.values():\\n            obs['stdout']=obs['stdout'].strip('\\\\n')+('' if n in ABSENT_PACKAGES else '\\\\n'+MARKER)\\n        # One counterexample per source predicate, preserving all other targets.\\n        mutations=[]\\n        for cmd,pattern,good,bad in items:\\n            obs=copy.deepcopy(positive)\\n            target=guarded(cmd)\\n            # Keep other predicates on the same command intact; adding an extra\\n            # invalid member is the decisive negative case for collection rules.\\n            if pattern.startswith('!'):\\n                obs[target]['stdout']+='\\\\n'+bad\\n            else:\\n                obs[target]['stdout']=obs[target]['stdout'].replace(good,bad)\\n            mutations.append(dict(rule=emit_rule(target,pattern),observations=obs))\\n        result[str(check['id'])]=dict(positive=positive,negative=mutations[0]['observations'],\\n            missing={},empty={t:dict(stdout='',exit_code=0) for t in targets},\\n            error={t:dict(error='SYNTHETIC command error') for t in targets},\\n            nonzero_matching={t:dict(stdout=o['stdout'],exit_code=1,stderr='SYNTHETIC failure despite matching stdout') for t,o in positive.items()},\\n            predicate_negatives=mutations)\\n    return result\\n\\n\\ndef main():\\n    path=ROOT/'tests/fixtures/rule_outputs.json'\\n    data=json.loads(path.read_text())\\n    for key in list(data['checks']):\\n        if int(key)-900000 in ADDED: del data['checks'][key]\\n    data['checks'].update(generated())\\n    path.write_text(json.dumps(data,ensure_ascii=False,indent=2)+'\\\\n')\\n\\nif __name__=='__main__': main()\\n\\\"\\\"\\\"Author P2B3 test-only input trees and output-model cases; never run host checks.\\\"\\\"\\\"\\nimport copy\\nimport json\\nfrom linuxgcb.catalog import ROOT\\nfrom linuxgcb.batch3 import ADDED, AUDIT, audit_lines, rules\\n\\n\\ndef inputs():\\n    result={}\\n    for n in sorted(ADDED):\\n        files={}; modes={}; owners={}; commands={}\\n        if n in AUDIT:\\n            files['/etc/audit/rules.d/audit.rules']='\\\\n'.join(audit_lines(n))+'\\\\n'\\n            files['/etc/login.defs']='UID_MIN 1000\\\\n'\\n        elif n==92: commands={'rpm':1}\\n        elif n==93: files['/etc/chrony.conf']='server ntp.example.test iburst\\\\n'\\n        elif n in (95,96,99,100):\\n            commands={'rpm':0,'load':'loaded','active':'inactive','unit':'masked'}\\n        elif n in (134,135): files['/etc/default/grub']='GRUB_CMDLINE_LINUX=\\\"audit=1 audit_backlog_limit=8192\\\"\\\\n'\\n        elif n==136: files['/etc/aliases']='postmaster: root\\\\n'\\n        elif n in (137,138,139,140):\\n            files['/etc/audit/auditd.conf']='log_file = /var/log/audit/audit.log\\\\n'\\n            files['/var/log/audit/audit.log']='test-only audit content\\\\n'\\n            modes={'/var/log/audit':0o700,'/var/log/audit/audit.log':0o600}\\n            owners={'/var/log/audit': [0,0], '/var/log/audit/audit.log':[0,0]}\\n        elif n in (143,144):\\n            for name in ('auditctl','aureport','ausearch','autrace','auditd','audisp-remote','audisp-syslog','augenrules','rsyslogd'):\\n                path='/sbin/'+name;files[path]='test-only inert tool';modes[path]=0o750;owners[path]=[0,0]\\n        elif n==145:\\n            files['/etc/aide.conf']='\\\\n'.join('/usr/sbin/'+name+' p+i+n+u+g+s+b+acl+xattrs+sha512' for name in ('auditctl','auditd','ausearch','aureport','autrace','audisp-remote','audisp-syslog','augenrules'))+'\\\\n'\\n        elif n==146: files['/etc/audit/auditd.conf']='max_log_file = 32\\\\n'\\n        elif n==147: files['/etc/audit/auditd.conf']='max_log_file_action = keep_logs\\\\n'\\n        elif n==158:\\n            files={'/proc/self/mountinfo':'1 0 0:1 / / rw - ext4 /dev/test rw\\\\n','/etc/login.defs':'UID_MIN 1000\\\\n','/usr/bin/test-privileged':'test-only inert executable',\\n                   '/etc/audit/rules.d/privileged.rules':'-a always,exit -F path=/usr/bin/test-privileged -F perm=x -F auid>=1000 -F auid!=4294967295 -k privileged\\\\n'}\\n            modes['/usr/bin/test-privileged']=0o4750\\n        elif n==161:\\n            files={'/etc/sudoers':'Defaults logfile=\\\"/var/log/site-sudo.log\\\"\\\\n','/etc/audit/rules.d/actions.rules':'-w /var/log/site-sudo.log -p wa -k actions\\\\n'}\\n        elif n==173: files['/etc/audit/rules.d/99-finalize.rules']='-e 2\\\\n--loginuid-immutable\\\\n'\\n        elif n==176: files['/etc/rsyslog.conf']='$FileCreateMode 0640\\\\n'\\n        elif n==177: files['/etc/rsyslog.conf']='auth.*,authpriv.* ,daemon.* /var/log/secure\\\\n'\\n        elif n in (181,182): files['/etc/systemd/journald.conf']='[Journal]\\\\nCompress=yes\\\\nStorage=persistent\\\\n'\\n        elif n==308:\\n            files['/etc/logrotate.d/rsyslog']='/var/log/rsyslog/*.log {\\\\n weekly\\\\n rotate 4\\\\n compress\\\\n missingok\\\\n notifempty\\\\n postrotate /usr/bin/systemctl reload rsyslog.service >/dev/null || true\\\\n endscript\\\\n}\\\\n'\\n            modes['/var/log/rsyslog']=0o750\\n        good=dict(files=files,modes=modes,owners=owners,commands=commands)\\n        bad=copy.deepcopy(good)\\n        if n==92: bad['commands']['rpm']=0\\n        elif n in (95,96,99,100): bad['commands']['active']='active';bad['commands']['unit']='enabled'\\n        elif n in (137,139):\\n            path='/var/log/audit/audit.log' if n==137 else '/var/log/audit';bad['owners'][path]=[1001,0]\\n        elif n in (138,140): bad['modes']['/var/log/audit/audit.log' if n==138 else '/var/log/audit']=0o777\\n        elif n in (143,144):\\n            if n==143: bad['modes']['/sbin/auditd']=0o777\\n            else: bad['owners']['/sbin/auditd']=[0,1001]\\n        else:\\n            path=next(p for p in files if p not in ('/etc/login.defs','/proc/self/mountinfo','/usr/bin/test-privileged'))\\n            bad['files'][path]='# test-only removed required configuration\\\\n'\\n        result[str(900000+n)]={'positive':good,'negative':bad}\\n    return result\\n\\n\\ndef outputs():\\n    result={}\\n    for n,items in rules().items():\\n        target=items[0][0];ok='ABSENT\
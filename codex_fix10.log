rning'),\n                          self.cp('', 1, 'Failed to get unit file state: Permission denied'),\n                          self.cp('', 1, 'No such file or directory'),\n                          FileNotFoundError(), PermissionError(), subprocess.TimeoutExpired('mock', 8)):\n                results = self.good()\n                results[pos] = state\n                self.assertEqual(self.output(244, results)[0], '')\n\n    def test_only_900244_rules_change_and_protected_files_unchanged(self):\n        old, new = {}, {}\n        for path in (ROOT/'policies').glob('*.yml'):\n            prior = json.loads(subprocess.check_output(['git', 'show', BASELINE+':policies/'+path.name], cwd=ROOT))\n            current = json.loads(path.read_text())\n            self.assertEqual(prior['policy'], current['policy'])\n            self.assertEqual(prior['requirements'], current['requirements'])\n            old.update({c['id']: c for c in prior['checks']})\n            new.update({c['id']: c for c in current['checks']})\n        self.assertEqual(len(new), 307)\n        self.assertEqual(set(old), set(new))\n        self.assertEqual({n for n in old if old[n] != new[n]}, {900244,900023,900024,900025,900073,900074,900091})\n        self.assertEqual(dict(new[900244], rules=old[900244]['rules']), old[900244])\n        protected = ['data/coverage_manifest.json', 'data/scope_registry.json', 'data/controls.json',\n                     'docs/references', 'tests/fixtures', 'tests/fix5_baseline.json', 'docs/*TEST_OUTPUT*']\n        self.assertEqual(subprocess.check_output(['git', 'diff', BASELINE, '--name-only', '--', *protected], cwd=ROOT, text=True), '')\n            self.assertEqual(self.output(304), '')\n        for uid,gid in ((1,0),(0,1)):\n            with patch.object(rt.os, 'stat', return_value=os.stat_result((0o100600,0,0,1,uid,gid,0,0,0,0))):\n                self.assertEqual(self.output(303), '')\n        with patch.object(rt.os, 'stat', side_effect=PermissionError):\n            for n in (303,304): self.assertEqual(self.output(n), '')\n\n    def test_exact_scope_and_metadata(self):\n        old = {}; new = {}\n        for p in (ROOT/'policies').glob('*.yml'):\n            prior = json.loads(subprocess.check_output(['git','show','bc2cfbb:policies/'+p.name],cwd=ROOT))\n            now = json.loads(p.read_text())\n            self.assertEqual(prior['policy'], now['policy'])\n            old.update({c['id']:c for c in prior['checks']})\n            new.update({c['id']:c for c in now['checks']})\n        changed = {900000+n for n in range(79,86)} | {900303,900304}\n        self.assertEqual(len(new),307)\n        self.assertEqual({n for n in old if old[n]['rules'] != new[n]['rules']},changed | {900073,900074,900091})\n        for n in old:\n            actual = dict(new[n], rules=old[n]['rules'])\n            self.assertEqual(actual,old[n])\n        for name in ('data/coverage_manifest.json','data/scope_registry.json'):\n            prior = json.loads(subprocess.check_output(['git','show','bc2cfbb:'+name],cwd=ROOT))\n            current = json.loads((ROOT/name).read_text())\n            if isinstance(prior,list):\n                current = [r for r in current if r['sca_id']-900000 not in BATCH8 | (BATCH9 | BATCH10)]\n                prior = [r for r in prior if r['sca_id']-900000 not in BATCH8 | (BATCH9 | BATCH10)]\n                self.assertEqual(prior,current)\n            else:\n                self.assertEqual(prior['reviewed'],[r for r in current['reviewed'] if r['sca_id']-900000 not in BATCH8 | (BATCH9 | BATCH10)])\nfrom linuxgcb.batch9 import ADDED as BATCH9\nfrom linuxgcb.batch10 import ADDED as BATCH10\nfrom linuxgcb.batch8 import ADDED as BATCH8\nfrom linuxgcb.batch7 import ADDED as BATCH7\n\"\"\"FIX5: offline scope protection and synthetic rpm exit/output regression.\"\"\"\nimport json\nimport hashlib\nimport shlex\nimport subprocess\nimport unittest\n\nfrom linuxgcb.batch6 import ADDED as BATCH6\nfrom linuxgcb.argv import w_strtok\nfrom linuxgcb.catalog import ROOT, digest\nfrom linuxgcb.policy import parse_rule, simulate\n\n\nclass Fix5Tests(unittest.TestCase):\n    def test_only_900188_rules_changed_and_evidence_preserved(self):\n        before = json.loads((ROOT/'tests/fix5_baseline.json').read_text())\n        old = {c['id']: c for c in before['checks']}\n        current = {c['id']: c for p in (ROOT/'policies').glob('*.yml')\n                   for c in json.loads(p.read_text())['checks']}\n        self.assertEqual(len(current), 307)\n        current = {n:c for n,c in current.items() if n in old}\n        self.assertEqual(old.keys(), current.keys())\n        self.assertEqual({n for n in old if old[n]['rules'] != current[n]['rules']}, {900188})\n        for n in old:\n            actual = dict(current[n])\n            if n == 900188:\n                actual['rules'] = old[n]['rules']\n            self.assertEqual(actual, old[n])\n        for name, sha in before['protected_hashes'].items():\n            if name in ('data/scope_registry.json', 'data/coverage_manifest.json'):\n                original = subprocess.check_output(['git', 'show', 'd2bd3ae:'+name], cwd=ROOT)\n                self.assertEqual(hashlib.sha256(original).hexdigest(), sha, name)\n                prior = json.loads(original)\n                now = json.loads((ROOT/name).read_text())\n                if name.endswith('scope_registry.json'):\n                    self.assertEqual([r for r in prior if r['sca_id']-900000 not in BATCH6 | BATCH7 | BATCH8 | (BATCH9 | BATCH10)],\nfrom linuxgcb.batch9 import ADDED as BATCH9\nfrom linuxgcb.batch10 import ADDED as BATCH10\nfrom linuxgcb.batch8 import ADDED as BATCH8\nfrom linuxgcb.batch7 import ADDED as BATCH7\n\"\"\"FIX4 offline regressions using only synthetic file trees.\"\"\"\nfrom linuxgcb.batch6 import ADDED as BATCH6\nimport copy\nimport json\nimport unittest\nimport test_p2b3 as p2b3\nfrom linuxgcb.catalog import ROOT, digest\nfrom linuxgcb.policy import parse_rule, simulate\n\nCHANGED = {900143, 900144, 900176}\n\n\nclass Fix4Tests(unittest.TestCase):\n    tree = p2b3.P2B3Tests.tree\n    run_tree = p2b3.P2B3Tests.run_tree\n\n    @classmethod\n    def setUpClass(cls):\n        cls.data = json.loads((ROOT/'tests/fixtures/p2b3/cases.json').read_text())\n        cls.checks = {c['id']: c for p in (ROOT/'policies').glob('*.yml')\n                      for c in json.loads(p.read_text())['checks']}\n\n    def assert_result(self, n, data, want):\n        output = self.run_tree(n, data)\n        self.assertEqual(output, 'PASS\\n' if want == 'PASS' else '')\n        check = self.checks[900000+n]\n        target, _ = parse_rule(check['rules'][0])\n        self.assertEqual(simulate(check, {target: dict(stdout=output)}), want)\n\n    def test_exact_three_rules_changed_and_protected_evidence(self):\n        before = json.loads((ROOT/'tests/fixtures/fix4_baseline.json').read_text())\n        old = {c['id']: c for c in before['checks']}\n        self.assertEqual(len(old), 146)\n        self.assertEqual(set(old), set(self.checks) - {900000+n for n in BATCH6 | BATCH7 | BATCH8 | (BATCH9 | BATCH10)})\n        self.assertEqual({n for n in old if old[n]['rules'] != self.checks[n]['rules']}, CHANGED | {900188})\n        for n in old.keys() - CHANGED - {900188}:\n            self.assertEqual(old[n], self.checks[n])\n        for name, sha in before['protected_hashes'].items():\n            self.assertEqual(digest(ROOT/name), sha, name)\n\n    def test_imuxsock_and_omfile_matrix(self):\n        module = 'module(load=\"imuxsock\" SysSock.Use=\"off\" FileCreateMode=\"0644\")\\n'\n        cases = [\n            (module + '$FileCreateMode 0640\\n', 'PASS'),\n            (module, 'FAIL'),\n            (module + '$FileCreateMode 0640\\naction(type=\"omfile\" fileCreateMode=\"0666\")', 'FAIL'),\n\"\"\"Offline FIX3 regressions; execute only synthetic shell builtins.\"\"\"\nimport json\nimport shlex\nimport subprocess\nimport unittest\nfrom unittest.mock import patch\n\nfrom linuxgcb.argv import w_strtok\nfrom linuxgcb.batch2 import ABSENT_PACKAGES, MARKER, guarded\nfrom linuxgcb.catalog import ROOT, digest\nfrom linuxgcb.policy import parse_rule, simulate\n\nCHANGED = {900000+n for n in ABSENT_PACKAGES if n != 188} | {900205}\n\n\nclass Fix3Tests(unittest.TestCase):\n    @classmethod\n    def setUpClass(cls):\n        cls.checks = {c['id']: c for p in (ROOT/'policies').glob('*.yml')\n                      for c in json.loads(p.read_text())['checks']}\n        cls.before = json.loads((ROOT/'tests/fixtures/fix3_baseline.json').read_text())\n\n    def test_exact_seven_rules_changed_and_ninety_checks_untouched(self):\n        before = {c['id']: c for c in self.before['checks']}\n        self.assertEqual(len(before), 97)\n        self.assertTrue(before.keys() <= self.checks.keys())\n        self.assertEqual({n for n in before if before[n]['rules'] != self.checks[n]['rules']}, CHANGED | {900188})\n        for n, check in before.items():\n            actual = dict(self.checks[n])\n            if n in CHANGED | {900188}:\n                actual['rules'] = check['rules']\n            self.assertEqual(actual, check)\n        for name, sha in self.before['protected_hashes'].items():\n            self.assertEqual(digest(ROOT/name), sha, name)\n\n    def test_engine_output_boundary_and_old_marker_failure(self):\n        # Preserve the historical 900188 guard solely in the test allowlist.\n        from linuxgcb.policy import batch2_emitted\n        legacy = next(c for c in self.before['checks'] if c['id'] == 900188)\n        allowlist = batch2_emitted() | set(legacy['rules'])\n        patcher = patch('linuxgcb.policy.batch2_emitted', return_value=allowlist)\n        patcher.start()\n        self.addCleanup(patcher.stop)\n        old = next(c for c in self.before['checks'] if c['id'] == 900188)\n        target = parse_rule(old['rules'][0])[0]\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"cat linuxgcb/policy.py; cat scripts/make_fixtures.py; sed -n '100,145p' tests/test_catalog_policy.py; rg -n 'fixture|LoadState|caveat' scripts linuxgcb; rg -n 'condition|not |&&|command' docs/references/creating-custom-policies.md | head -35\"","aggregated_output":"\"\"\"以 JSON（YAML 1.2 子集）產生候選 SCA；只模擬輸出匹配，不執行命令。\"\"\"\nimport json\nimport re\nfrom functools import lru_cache\nfrom .catalog import ROOT, registry, digest\nfrom .batch1 import rules as batch_rules\n\n\ndef definitions():\n    modes = '|'.join(format(n, 'o') for n in range(0o1000) if n & ~0o644 == 0)\n    return {**batch_rules(),\n        45: [('c:/usr/bin/stat -c %u:%g /etc/passwd', '^0:0$')],\n        46: [('c:/usr/bin/stat -c %a /etc/passwd', '^('+modes+')$')],\n        108: [('c:/usr/sbin/sysctl -n net.ipv4.ip_forward', '^0$'),\n              ('c:/usr/sbin/sysctl -n net.ipv6.conf.all.forwarding', '^0$')],\n        243: [('c:/usr/bin/systemctl show firewalld.service --property=LoadState', '^LoadState=loaded$'),\n              ('c:/usr/bin/systemctl show firewalld.service --property=ActiveState', '^ActiveState=active$'),\n              ('c:/usr/bin/systemctl show firewalld.service --property=UnitFileState', '^UnitFileState=enabled$')],\n        245: [('c:/usr/bin/systemctl show nftables.service --property=LoadState', '^LoadState=masked$'),\n              ('c:/usr/bin/systemctl show nftables.service --property=ActiveState', '^ActiveState=inactive$'),\n              ('c:/usr/bin/systemctl show nftables.service --property=UnitFileState', '^UnitFileState=masked$')],\n        269: [('c:/usr/sbin/sshd -T', '^permitrootlogin no$')],\n        270: [('c:/usr/sbin/sshd -T', '^permitemptypasswords no$')],\n    }\n\n\ndef build():\n    rows = registry()\n    for profile in ('base', 'firewalld', 'sshd'):\n        filename = 'linuxgcb_'+profile+'.yml'\n        checks = []\n        for row in rows:\n            if row['implementation'] != 'candidate' or row['profile'] != profile:\n                continue\n            checks.append(dict(id=row['sca_id'], title=row['gcb_id']+' '+row['title'],\n                description='Q1 執行審查 '+row['execution_review']+'；coverage='+row['coverage']+'；'+','.join(row['issue_ids'])+'；raw PASS 非已驗證符合。'+row['pending'],\n                compliance=[{'twgcb': [row['gcb_id']]}], regex_type='pcre2', condition='all',\n                rules=[target+' -> r:'+pattern for target, pattern in definitions()[int(row['gcb_id'][-4:])]]))\n        policy = dict(policy=dict(id='linuxgcb_rhel9_'+profile+'_v01', file=filename,\n                      name='RHEL9 GCB v1.2 '+profile+' v0.1 UNVALIDATED',\n                      description='未驗證候選政策；僅供核准 RHEL9 試點，非完整符合性檢核', regex_type='pcre2'),\n                      requirements=dict(title='僅 RHEL 9', description='角色由核准群組控制',\n                        condition='all', rules=['f:/etc/os-release -> r:^ID=\"?rhel\"?$',\n                                               'f:/etc/os-release -> r:^VERSION_ID=\"?9([.][0-9]+)*\"?$']),\n                      checks=checks)\n        (ROOT/'policies'/filename).write_text(json.dumps(policy, ensure_ascii=False, indent=2)+'\\n')\n    hashes = {p.name: digest(p) for p in sorted((ROOT/'policies').glob('*.yml'))}\n    (ROOT/'data/policy_hashes.json').write_text(json.dumps(hashes, indent=2)+'\\n')\n    from .coverage import write\n    write()\n    validate()\n\n\ndef require(condition):\n    if not condition:\n        raise ValueError('候選政策結構、mapping 或 hash 不符')\n\n\ndef validate():\n    rows = {r['sca_id']: r for r in registry()}\n    seen = set()\n    for path in sorted((ROOT/'policies').glob('*.yml')):\n        p = json.loads(path.read_text())\n        require(p['policy']['file'] == path.name and p['policy']['regex_type']=='pcre2')\n        require(p['requirements'] == dict(title='僅 RHEL 9', description='角色由核准群組控制',\n            condition='all', rules=['f:/etc/os-release -> r:^ID=\"?rhel\"?$',\n                                   'f:/etc/os-release -> r:^VERSION_ID=\"?9([.][0-9]+)*\"?$']))\n        for c in p['checks']:\n            require(c['id'] not in seen and rows[c['id']]['included'])\n            seen.add(c['id'])\n            require(c['regex_type'] == 'pcre2' and c['condition'] == 'all')\n            require(c['compliance'] == [{'twgcb': [rows[c['id']]['gcb_id']]}])\n            require(rows[c['id']]['policy_id'] == p['policy']['id'])\n            require(c['rules'] == [a+' -> r:'+b for a,b in definitions()[c['id']-900000]])\n            for rule in c['rules']:\n                target, pattern = rule.split(' -> r:')\n                require(target.startswith('c:/') and not any(x in target for x in ('|',';', '&&', '$', '`')))\n                parse_rule(rule)\n    require(seen == {900000+n for n in definitions()})\n    hashes = json.loads((ROOT/'data/policy_hashes.json').read_text())\n    require(hashes == {p.name:digest(p) for p in (ROOT/'policies').glob('*.yml')})\n    from .coverage import manifest\n    require(json.loads((ROOT/'data/coverage_manifest.json').read_text()) == manifest())\n    require(seen == {r['sca_id'] for r in rows.values() if r['implementation']=='candidate'})\n    return len(seen)\n\n\n@lru_cache(maxsize=1)\ndef supported_patterns():\n    return frozenset(p for rules in definitions().values() for _,p in rules) | {\n        '^ID=\"?rhel\"?$', '^VERSION_ID=\"?9([.][0-9]+)*\"?$'}\n\n\ndef parse_rule(rule):\n    \"\"\"明確有界子集：絕對路徑 c:/f: + 單一正向 r:；拒絕其他運算子。\"\"\"\n    if not isinstance(rule, str) or rule.count(' -> r:') != 1:\n        raise ValueError('不支援的規則語法')\n    target, pattern = rule.split(' -> r:')\n    if not re.fullmatch(r'[cf]:/[^\\n\\r]+', target) or any(x in target for x in (' -> ', ' && ', '|', ';', '`', '$')):\n        raise ValueError('不支援的目標')\n    # Python 並非 PCRE2；只接受實際發出的固定模式與測試用 ASCII literal。\n    if pattern not in supported_patterns() and not re.fullmatch(r'\\^[A-Za-z0-9_ =:/-]+\\$', pattern):\n        raise ValueError('未驗證的 PCRE2 語法')\n    try:\n        return target, re.compile(pattern, re.ASCII)\n    except re.error as exc:\n        raise ValueError('無效模式') from exc\n\n\ndef simulate(check, observations):\n    \"\"\"僅輸出匹配模型；執行失敗資訊不足回 UNRESOLVED，不冒充 Wazuh。\n\n    exit_code 不參與 SCA 輸出匹配。明確 engine_result 可表示真機／fixture\n    的 Not applicable；error 只表示未取得可靠輸出，不能預測引擎結果。\n    \"\"\"\n    if check.get('regex_type', 'pcre2') != 'pcre2':\n        raise ValueError('只支援明確 PCRE2 候選子集')\n    if check.get('condition') != 'all':\n        raise ValueError('輸出模型只支援目前發出的 all 子集')\n    if not isinstance(check.get('rules'), list) or not check['rules']:\n        raise ValueError('規則不得為空')\n    parsed = [parse_rule(rule) for rule in check['rules']]\n    outcomes = []\n    for target, pattern in parsed:\n        obs = observations.get(target)\n        if target.startswith('f:') and obs is not None and obs.get('exists') is False:\n            outcomes.append('NOT_APPLICABLE')\n            continue\n        if obs is None or obs.get('error'):\n            outcomes.append('UNRESOLVED')\n        elif obs.get('engine_result') == 'NOT_APPLICABLE':\n            outcomes.append('NOT_APPLICABLE')\n        elif not isinstance(obs.get('stdout'), str):\n            raise ValueError('觀察必須提供字串 stdout')\n        else:\n            outcomes.append('PASS' if any(pattern.search(line) for line in obs['stdout'].split('\\n')) else 'FAIL')\n    # 官方 all：任何 FAIL 優先；未知執行不擅自轉成 N/A。\n    if 'FAIL' in outcomes:\n        return 'FAIL'\n    if 'UNRESOLVED' in outcomes:\n        return 'UNRESOLVED'\n    return 'NOT_APPLICABLE' if 'NOT_APPLICABLE' in outcomes else 'PASS'\ncat: scripts/make_fixtures.py: No such file or directory\n                    for owner in ('root:shadow','root:wheel','nobody:root','root:UNKNOWN'):\n                        obs=copy.deepcopy(base);obs[target]['stdout']=owner\n                        self.assertEqual(simulate(check,obs),'PASS' if owner=='root:shadow' and 'shadow' in value else 'FAIL')\n                type_target='c:/usr/bin/stat -c %f '+path\n                if type_target in base:\n                    for mode in ('81a4','a1ff','11a4','21a4','61a4','c1a4'):\n                        obs=copy.deepcopy(base);obs[type_target]['stdout']=mode\n                        self.assertEqual(simulate(check,obs),'FAIL')\n            from linuxgcb.batch1 import SERVICES,PACKAGES\n            if n in SERVICES:\n                target=next(t for t in base if 'UnitFileState' in t)\n                for value in ('enabled-runtime','static','alias','not-found'):\n                    obs=copy.deepcopy(base);obs[target]['stdout']='UnitFileState='+value\n                    self.assertEqual(simulate(check,obs),'FAIL')\n                obs=copy.deepcopy(base)\n                target=next(t for t in base if 'LoadState' in t);obs[target]['stdout']='LoadState=not-found'\n                self.assertEqual(simulate(check,obs),'FAIL')\n            if n in PACKAGES:\n                obs=copy.deepcopy(base);target=next(iter(base));obs[target]['stdout']='package missing is not installed'\n                obs[target]['exit_code']=1\n                self.assertEqual(simulate(check,obs),'FAIL')\n\n    def test_documented_file_and_all_semantics(self):\n        check=dict(condition='all',rules=['f:/SYNTHETIC -> r:^ID=rhel$'])\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(exists=False)}),'NOT_APPLICABLE')\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(stdout='')}),'FAIL')\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(error='permission denied')}),'UNRESOLVED')\n        check['rules'].append('c:/SYNTHETIC -> r:^good$')\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(exists=False),'c:/SYNTHETIC':dict(stdout='bad')}),'FAIL')\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(exists=False),'c:/SYNTHETIC':dict(stdout='good')}),'NOT_APPLICABLE')\n        self.assertEqual(simulate(check,{'c:/SYNTHETIC':dict(stdout='bad')}),'FAIL')\nlinuxgcb/coverage.py:7:from .batch1 import ADDED, caveat\nlinuxgcb/coverage.py:31:            caveats=caveat(n) if n in ADDED else row['pending'],tests=['tests/fixtures/rule_outputs.json#'+str(row['sca_id']), 'tests/test_quality_q1.py'],\nlinuxgcb/batch1.py:45:        props = [('LoadState','loaded' if state!='masked' else 'masked'),\nlinuxgcb/batch1.py:50:def caveat(n):\nlinuxgcb/policy.py:16:        243: [('c:/usr/bin/systemctl show firewalld.service --property=LoadState', '^LoadState=loaded$'),\nlinuxgcb/policy.py:19:        245: [('c:/usr/bin/systemctl show nftables.service --property=LoadState', '^LoadState=masked$'),\nlinuxgcb/policy.py:113:    exit_code 不參與 SCA 輸出匹配。明確 engine_result 可表示真機／fixture\n7:You need to consider the following four sections when creating custom policy files, although not all of them are required.\n43:  condition: any\n55:    title: \"SSH Hardening: Port should not be 22\"\n56:    description: \"The ssh daemon should not be listening on port 22 (the default value) for incoming connections.\"\n62:    condition: all\n64:      - 'f:$sshd_file -> !r:^# && r:Port && !r:\\s*\\t*22$'\n91:| condition | Yes | String | Any string |\n141:| condition | Yes | String | all, any, none |\n147:Check evaluation is governed by its rule result aggregation strategy, as set in its `condition` field, and the results of\n154:### Condition [Permalink to this headline](https://documentation.wazuh.com/current/user-manual/capabilities/sec-config-assessment/creating-custom-policies.html\\#condition \"Permalink to this headline\")\n156:The result of each SCA check is governed by the conditions set in the `condition` field, and the results of the evaluation of its rules. The condition field specifies how rule results are aggregated in order to calculate the final value of a check. There are three options:\n158:- `all`: The check is evaluated as **Passed** if all of its rules are satisfied and as **Failed** as soon as one rule is not satisfied.\n188:\\\\* This result does not affect the final result.\n192:Rules can check for the existence of files, directories, registry keys and values, running processes, and recursively test for the existence of files inside directories. When it comes to content checking, they are able to check for file contents, recursively check for the contents of files inside directories, command output, and registry value data.\n194:Abstractly, rules start with a location and a type of location that is the target of the test, followed by the actual test specification. Such tests fall into two categories: existence and content checks. The type of location is listed in the [Rule types](https://documentation.wazuh.com/current/user-manual/capabilities/sec-config-assessment/creating-custom-policies.html#rule-types) table below, and the location could be a file name, directory, process name, command, or a registry key.\n225:| not equal to | `!=` | `n:SomeProperty (\\d) compare != 42` |\n236:not f:/some_file -> some_text\n266:- `not p:sshd` tests the presence of processes called `sshd` and fails if one is found.\n289:- If the **target** of a rule that checks for contents does not exist, the result will be `Not applicable` as it could not be checked.\n302:Be careful when negating content operators as that makes them evaluate as **Passed** for anything that does not match with the check specified. For example, rule `f:/etc/ssh_config -> !r:PermitRootLogin` is evaluated as Passed if it finds any line that does not contain `PermitRootLogin`.\n304:Content check operators can be chained using the operator `&&` (AND) as follows:\n309:f:/etc/ssh_config -> !r:^# && r:Protocol && r:2\n312:This rule reads as **Pass** if there's a line whose first character is not `#` and contains `Protocol` and `2`.\n316:- It is mandatory to respect the spaces around the `&&` operator.\n318:- There's no particular order of evaluation between tests chained using the `&&` operator.\n323:- `c:systemctl is-enabled cups -> r:^enabled` checks that the output of the command contains a line starting with enabled.\n338:- Check that a file does not exist: `not f:/path/to/file`\n362:- Check if a process is **not** running `not p:process_name`\n365:##### Rule syntax for commands [Permalink to this headline](https://documentation.wazuh.com/current/user-manual/capabilities/sec-config-assessment/creating-custom-policies.html\\#rule-syntax-for-commands \"Permalink to this headline\")\n367:- Check the output of a command `c:command -> output`\n369:- Check the output of a command using regex `c:command -> r:REGEX`\n371:- Check a numeric value `c:command -> n:REGEX_WITH_A_CAPTURE_GROUP compare >= number`\n385:- Check if there is a line that does not begin with `#` and contains `Port 22``f:/etc/ssh/sshd_config -> !r:^# && r:Port\\.+22`\n387:- Check if there is no line that does not begin with `#` and contains `Port 22``not f:/etc/ssh/sshd_config -> !r:^# && r:Port\\.+22`\n406:- Check if root is the only account with UID 0: `f:/etc/passwd -> !r:^# && !r:^root: && r:^\\w+:\\w+:0:`\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"agent_message","text":"已確認 0094／0097／0098／0245 原本要求 masked，0101 更是要求 enabled＋active；本次會依你指定的 FIX-1 意圖調整這 6 項，並在文件特別記錄 kdump 與原始來源「啟用」的差異。\n\n規則會維持正向匹配與 `condition: all`，用同一次 `systemctl show` 輸出的 `LoadState=not-found` 或 `UnitFileState=disabled|masked` 接受合格狀態，再要求 inactive，避免把空輸出或錯誤訊息當成未安裝。\n"}}

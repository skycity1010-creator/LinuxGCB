_policy.CatalogTests.test_all_positive_negative_missing_error) (id=900212, case='empty') ... ERROR\n  test_all_positive_negative_missing_error (test_catalog_policy.CatalogTests.test_all_positive_negative_missing_error) (id=900212, case='error') ... ERROR\n  test_all_positive_negative_missing_error (test_catalog_policy.CatalogTests.test_all_positive_negative_missing_error) (id=900212, case='nonzero_matching') ... ERROR\n  test_all_positive_negative_missing_error (test_catalog_policy.CatalogTests.test_all_positive_negative_missing_error) (id=900213, case='positive') ... ERROR\n  test_all_positive_negative_missing_error (test_catalog_policy.CatalogTests.test_all_positive_negative_missing_error) (id=900213, case='negative') ... ERROR\n  test_all_positive_negative_missing_error (test_catalog_policy.CatalogTests.test_all_positive_negative_missing_error) (id=900213, case='missing') ... ERROR\n  test_all_positive_negative_missing_error (test_catalog_policy.CatalogTests.test_all_positive_negative_missing_error) (id=900213, case='empty') ... ERROR\n  test_all_positive_negative_missing_error (test_catalog_policy.CatalogTests.test_all_positive_negative_missing_error) (id=900213, case='error') ... ERROR\n  test_all_positive_negative_missing_error (test_catalog_policy.CatalogTests.test_all_positive_negative_missing_error) (id=900213, case='nonzero_matching') ... ERROR\n  test_all_positive_negative_missing_error (test_catalog_policy.CatalogTests.test_all_positive_negative_missing_error) (id=900214, case='positive') ... ERROR\n  test_all_positive_negative_missing_error (test_catalog_policy.CatalogTests.test_all_positive_negative_missing_error) (id=900214, case='negative') ... ERROR\n  test_all_positive_negative_missing_error (test_catalog_policy.CatalogTests.test_all_positive_negative_missing_error) (id=900214, case='missing') ... ERROR\n  test_all_positive_negative_missing_error (test_catalog_policy.CatalogTests.test_all_positive_negative_missing_error) (id=900214, case='empty') ... ERROR\n  test_all_positive_negative_missing_error (test_catalog_policy.CatalogTests.test_all_positive_negative_missing_error) (id=900214, case='error') ... ERROR\n  test_all_positive_negative_missing_error (test_catalog_policy.CatalogTests.test_all_positive_negative_missing_error) (id=900214, case='nonzero_matching') ... ERROR\n\"\"\"FIX5: offline scope protection and synthetic rpm exit/output regression.\"\"\"\nimport json\nimport shlex\nimport subprocess\nimport unittest\n\nfrom linuxgcb.argv import w_strtok\nfrom linuxgcb.catalog import ROOT, digest\nfrom linuxgcb.policy import parse_rule, simulate\n\n\nclass Fix5Tests(unittest.TestCase):\n    def test_only_900188_rules_changed_and_evidence_preserved(self):\n        before = json.loads((ROOT/'tests/fix5_baseline.json').read_text())\n        old = {c['id']: c for c in before['checks']}\n        current = {c['id']: c for p in (ROOT/'policies').glob('*.yml')\n                   for c in json.loads(p.read_text())['checks']}\n        self.assertEqual(len(current), 146)\n        self.assertEqual(old.keys(), current.keys())\n        self.assertEqual({n for n in old if old[n]['rules'] != current[n]['rules']}, {900188})\n        for n in old:\n            actual = dict(current[n])\n            if n == 900188:\n                actual['rules'] = old[n]['rules']\n            self.assertEqual(actual, old[n])\n        for name, sha in before['protected_hashes'].items():\n            self.assertEqual(digest(ROOT/name), sha, name)\n        for p in (ROOT/'policies').glob('*.yml'):\n            self.assertIn('UNVALIDATED', json.loads(p.read_text())['policy']['name'])\n\n    def test_exact_tristate_argv_and_buffered_large_output(self):\n        check = next(c for c in json.loads((ROOT/'policies/linuxgcb_base.yml').read_text())['checks']\n                     if c['id'] == 900188)\n        body = ('out=$(rpm -q setroubleshoot 2>/dev/null); rc=$?; case $rc in '\n                '0) echo INSTALLED;; 1) echo ABSENT;; *) exit $rc;; esac')\n        self.assertEqual(check['rules'], ['c:/bin/sh -c \"'+body+'\" -> r:^ABSENT$'])\n        target, _ = parse_rule(check['rules'][0])\n        self.assertEqual(w_strtok(target[2:]), ['/bin/sh', '-c', body])\n        prefix = 'out=$(rpm -q setroubleshoot 2>/dev/null)'\n        # Replace the complete rpm query; execute only synthetic printf/exit.\n        for rc in (0, 1, 2, 3, 126, 127):\n            with self.subTest(rc=rc):\n                payload = 'ABSENT\\n'*500+'LINUXGCB_COMMAND_OK\\n'\n                fake = 'printf %s '+shlex.quote(payload)+'; exit '+str(rc)\n                result = subprocess.run(['/bin/sh', '-c', 'out=$('+fake+')'+body[len(prefix):]],\n                                        capture_output=True, text=True, timeout=5)\n                expected = 'INSTALLED\\n' if rc == 0 else 'ABSENT\\n' if rc == 1 else ''\n                self.assertEqual(result.stdout, expected)\n                self.assertEqual(result.returncode, 0 if rc in (0, 1) else rc)\n                self.assertEqual(simulate(check, {target: dict(stdout=result.stdout, exit_code=result.returncode)}),\n                                 'PASS' if rc == 1 else 'FAIL')\n\"\"\"P2B3 test-only trees. Never execute endpoint commands or read host configs.\"\"\"\nimport contextlib\nimport copy\nimport io\nimport json\nimport os\nfrom pathlib import Path\nimport shlex\nimport stat\nimport subprocess\nimport sys\nimport tempfile\nimport unittest\nfrom unittest.mock import patch\n\nfrom linuxgcb.argv import w_strtok\nfrom linuxgcb.batch3 import ADDED, AUDIT, PACKAGES, audit_lines, rules, script\nfrom linuxgcb.catalog import ROOT, digest, registry\nfrom linuxgcb.policy import parse_rule, simulate, validate\nfrom scripts.p2b3_fixtures import inputs, outputs\n\n\nclass P2B3Tests(unittest.TestCase):\n    @classmethod\n    def setUpClass(cls):\n        cls.data=json.loads((ROOT/'tests/fixtures/p2b3/cases.json').read_text())\n        cls.checks={c['id']:c for p in (ROOT/'policies').glob('*.yml') for c in json.loads(p.read_text())['checks']}\n\n    def tree(self,n): return copy.deepcopy(self.data['inputs'][str(900000+n)]['positive'])\n\n    def run_tree(self,n,data,fail_read=False):\n        \"\"\"Execute actual embedded script against temp files and mocked systemctl/RPM.\n\n        stat uid/gid are test data because this test must not chown or use sudo.\n        All paths inside the emitted program are redirected to the test-only tree.\n        \"\"\"\n        self.assertNotEqual(n,92)\n        with tempfile.TemporaryDirectory(prefix='p2b3-test-only-', dir=ROOT) as folder:\n            for name,content in data['files'].items():\n                path=Path(folder+name);path.parent.mkdir(parents=True,exist_ok=True);path.write_text(content)\n            for name,mode in data['modes'].items():\n                path=Path(folder+name)\n                if not path.exists(): path.mkdir(parents=True)\n                if path.is_file(): path.chmod(mode)\n            real_stat=os.stat\n            def fake_stat(path,*args,**kwargs):\n                if data.get('stat_error') and os.fspath(path) == folder + data['stat_error']:\n                    raise PermissionError('test-only stat denied')\n                info=real_stat(path,*args,**kwargs)\n                name=os.fspath(path)\n                owner=data['owners'].get(name[len(folder):]) if isinstance(name,str) and name.startswith(folder) else None\n                fields=list(info)\n                if owner: fields[4:6]=owner\n                relative=name[len(folder):] if isinstance(name,str) and name.startswith(folder) else None\n                if relative in data['modes']: fields[0]=stat.S_IFMT(info.st_mode) | data['modes'][relative]\n                return os.stat_result(fields)\n            def fake_command(argv,**kwargs):\n                cmd=data['commands']\n                if argv[0]=='/bin/sh' and 'rpm -q ' in argv[2]:\n                    rc=cmd.get('rpm',127)\n                    return subprocess.CompletedProcess(argv,0 if rc in (0,1) else rc,\n                                                       'INSTALLED\\n' if rc==0 else 'ABSENT\\n' if rc==1 else '', '')\n                self.assertEqual(argv[:2],['/usr/bin/systemctl','show'])\n                self.assertTrue(argv[2].endswith(('.service','.socket')))\n                self.assertTrue(all(x.startswith('--property=') for x in argv[3:]))\n                cmd={**cmd, **cmd.get('units',{}).get(argv[2],{})}\n                return subprocess.CompletedProcess(argv,cmd.get('systemctl_error',0),\n                    'LoadState='+cmd.get('load','')+'\\nActiveState='+cmd.get('active','')+'\\nUnitFileState='+cmd.get('unit','')+'\\n','')\n            program=script(n).replace(\"ROOT = ''\",'ROOT = '+repr(folder),1)\n            # Check the exact shell and Python argument round trip before execution.\n            argv=w_strtok(rules()[n][0][0][2:]);self.assertEqual(argv[:2],['/bin/sh','-c'])\n            self.assertEqual(shlex.split(argv[2]),['/usr/bin/python3','-c',script(n)])\n            capture=io.StringIO()\n            with patch('os.stat',side_effect=fake_stat),patch('subprocess.run',side_effect=fake_command),contextlib.redirect_stdout(capture):\n                if fail_read:\n                    with patch('builtins.open',side_effect=PermissionError('test-only denied')): exec(compile(program,'<test-only emitted script>','exec'),{})\n                else: exec(compile(program,'<test-only emitted script>','exec'),{})\n            return capture.getvalue()\n\n    def test_scope_baseline_sources_and_status(self):\n        before=json.loads((ROOT/'tests/fixtures/p2b3/baseline.json').read_text())\n        self.assertEqual(len(before['checks']),97)\n        for c in before['checks']:\n            actual = dict(self.checks[c['id']])\n            if c['id'] == 900188:  # FIX5 verifies its sole rule change separately.\n                actual['rules'] = c['rules']\n            self.assertEqual(actual, c)\n        for name,sha in before['protected_hashes'].items(): self.assertEqual(digest(ROOT/name),sha,name)\n        self.assertEqual(len(ADDED),49);self.assertEqual(len(self.checks),146);self.assertEqual(validate(),146)\n        rows=registry();self.assertEqual((len(rows),sum(r['included'] for r in rows)),(314,307))\n        self.assertEqual({r['sca_id'] for r in rows if r['implementation']=='candidate'}-{c['id'] for c in before['checks']},{900000+n for n in ADDED})\n        for row in rows:\n            if row['sca_id']-900000 in ADDED:\n                self.assertEqual(row['review_status'],'human_review_pending')\n                self.assertEqual(row['execution_review'],'blocked');self.assertEqual(row['live_validation'],'UNVALIDATED')\n        manifest=json.loads((ROOT/'data/coverage_manifest.json').read_text())\n        self.assertEqual(manifest['counts']['implemented'],146)\n        for row in manifest['reviewed']:\n            if row['sca_id']-900000 in ADDED:\n                self.assertIn('tests/test_p2b3.py',row['tests'])\n                self.assertIn('UNVALIDATED',row['caveats'])\n\n    def test_all_49_fixture_output_matrix(self):\n        self.assertEqual(self.data['label'],'SYNTHETIC TEST ONLY')\n        self.assertEqual(self.data['inputs'],inputs());self.assertEqual(self.data['checks'],outputs())\n        for n in sorted(ADDED):\n            check=self.checks[900000+n];cases=self.data['checks'][str(900000+n)]\n            for case,obs in cases.items():\n                want='PASS' if case in ('positive','nonzero_matching') else 'UNRESOLVED' if case in ('missing','error') else 'FAIL'\n                with self.subTest(n=n,case=case): self.assertEqual(simulate(check,obs),want)\n            # All programs emit at most one result. 256-line truncation cannot hide a bad member.\n            for obs in cases['positive'].values(): self.assertLessEqual(len(obs['stdout'].splitlines()),1)\n            for rule in check['rules']: parse_rule(rule)\n\n    def test_real_parsers_positive_negative_missing_empty_error(self):\n        for n in sorted(ADDED-{92}):\n            cases=self.data['inputs'][str(900000+n)]\n            for name,want in (('positive','PASS\\n'),('negative','')):\n                with self.subTest(n=n,case=name): self.assertEqual(self.run_tree(n,cases[name]),want)\n            for name in ('missing','empty','error'):\n                data=self.tree(n)\n                if name=='missing': data['files']={};data['modes']={};data['commands']={}\n                elif name=='empty': data['files']={p:'' for p in data['files']};data['commands']={}\n                else: data['commands']={'rpm':2,'systemctl_error':1}\n                # Metadata-only checks need an explicit stat error, rather than empty file data.\n                if n in (143,144) and name=='empty': data['files']={};data['modes']={}\n                if n in (143,144) and name=='error': data['stat_error']='/sbin/auditctl'\n                with self.subTest(n=n,case=name): self.assertEqual(self.run_tree(n,data,fail_read=name=='error' and n not in (95,96,99,100,143,144)), 'PASS\\n' if n in (143,144) and name in ('missing','empty') else '')\n\n    def test_every_audit_predicate_comments_tokens_boundaries_uid_min(self):\n\"\"\"Rebuild P2B3 offline review inventory from the source-bound definitions.\"\"\"\nfrom linuxgcb.catalog import ROOT\nfrom linuxgcb.batch3 import ADDED, mechanism, caveat, sources\n\n\ndef main():\n    lines=['# P2B3 離線審查：日誌與稽核 43 + 系統服務 6', '',\n           '本批以工作區 FIX-3 起點為準新增 49 條：97 → 146 候選；來源 314、scope 307、Nftables 排除 7 不變，未實作 210 → 161。新增 49 條均為 partial、human_review_pending、execution_review=blocked、live_validation=UNVALIDATED；政策 name 保持 UNVALIDATED。候選數不等於已驗證符合數。', '',\n           '三份政策由 base 62／firewalld 3／sshd 32 變為 base 111／firewalld 3／sshd 32。以 tests/fixtures/p2b3/baseline.json 保存批次前 97 個完整 checks；新測試逐物件核對，既有 97 條 rules diff=0（description、ID、condition 亦相同）。firewalld 與 sshd 政策位元不變。來源 XLSX、DOCX、controls/inventory、全部原 fixtures 及真機證據檔依 baseline hash 保護；不修改歷史 FIX3/R2/R3，工作區沒有新增或捏造 R6/R7 證據。R7 的 22 個真實缺失不在本批修正範圍。', '',\n           '## 機轉與限制', '',\n           '0092 使用 FIX-3 定向 rpm -q shell 三態：0 → INSTALLED、1 → ABSENT、其他退出碼不輸出。0096／0099／0100 也使用相同三態子命令，已安裝時依來源檢核服務；0096 保留來源允許的 SNMPv3 分支。0095 同查 avahi service/socket。systemctl 僅 show，disabled/masked 且 inactive，明確 not-found 且 inactive 視為停用；不從錯誤訊息或空值推論。', '',\n           '其餘候選透過 sh -c 執行內嵌 /usr/bin/python3 標準函式庫解析器，沒有部署外部 helper。這是新增端點執行相依性，缺少解譯器即不合格，仍待 RHEL9/Wazuh 真機驗收。build 不執行這些命令。讀取或命令失敗、任一必要條件不成立均不輸出 PASS；成功才輸出一行 PASS，避免逐行存在匹配及 256 行截斷掩蓋集合內的違規項。SCA 使用精確 ^PASS$；規則主體以 fullmatch 檢查持久檔內每條來源規則，沒有以任意 audit 規則存在代替。', '',\n           'FIX-2 quote_argument 編碼全部 shell 引數並驗證 w_strtok 還原為三個 argv；測試再核對 shell 第二層 Python 引數，且對隔離 audit fixture 執行完整實際 shell。所有規則檔匹配排除行首空白後的 #，全行錨定 token/路徑/perm/key，避免 sudoers/sudoers.d、路徑後綴與 key 後綴誤匹配。UID_MIN 取 login.defs 最後有效設定，不擅自沿用 1000。', '',\n           'DOCX 0153 同時包含修訂前後且 expected 同為啟用；以 controls.json 的完整 configuration_method 選取現行 cells，歷史內容仍列 docx_historical_cells。0159 的 renameat-S 解讀為兩個 syscall flags；0173 的 -e 2--loginuid-immutable 解讀為兩行，均列為人工待核准差異。181/182 是 TWGCB ID 尾碼，不使用 Excel ordinal（來源沒有 0180）。', '',\n           'journald 來源明文要求「新增」Compress=yes／Storage=persistent，故即使套件預設 Compress=yes，未設定也不自動合格；解析主檔 [Journal]、同名 drop-in 目錄優先序、字典排序、最後值及 /dev/null mask。rsyslog 保留舊式與來源範圍內新式 omfile action，複雜模板等保守留待審查。0308 依來源指定 stanza 與目錄權限檢核，並非僅搜 rsyslog 字樣。', '',\n           '## 49 條逐項清單', '', '| TWGCB ID（SCA ID） | 標題／機轉 | Caveats |', '| --- | --- | --- |']\n    for n in sorted(ADDED):\n        row=sources()[n]\n        cells=[row['gcb_id']+' ('+str(900000+n)+')',row['title']+'；'+mechanism(n),caveat(n)]\n        lines.append('| '+' | '.join(c.replace('|','&#124;').replace('\\n',' ') for c in cells)+' |')\n    lines += ['', '## 檔案清單', '',\n              '- linuxgcb/batch3.py：49 個 ID、來源規則、內嵌程式組裝、機轉／合規值／caveats。',\n              '- linuxgcb/p2b3_runtime.py：唯讀解析與集合檢核；只嵌入各控制實際所需函式。',\n              '- linuxgcb/catalog.py、quality.py、expected.py、policy.py、coverage.py：registry、狀態、合規值、allowlist 與 manifest 整合。',\n              '- data/scope_registry.json、coverage_manifest.json、policy_hashes.json；policies/linuxgcb_base.yml：可重建產物。',\n              '- scripts/p2b3_fixtures.py、p2b3_review.py：重建 test-only fixtures 與本文件。',\n              '- tests/fixtures/p2b3/baseline.json、cases.json；tests/test_p2b3.py：97 條基線、49 條輸入樹與輸出矩陣。',\n              '- tests/test_batch2.py、test_catalog_policy.py、test_expected.py、test_fix3.py、test_quality_q1.py、test_report.py：既有測試限定歷史 ID 集合／新增總數；合成 snapshot 只在記憶體綁定當前 hash，保留報表拒絕錯誤 hash 的測試。',\n              '- README.md：本批入口；docs/P2B3_REVIEW.md、P2B3_TEST_OUTPUT.txt：審查與離線驗證結果。', '',\n              '## 驗證與交付', '',\n              '重建命令：python3 -m scripts.p2b3_fixtures；python3 -m scripts.p2b3_review；python3 -m linuxgcb build；python3 -m linuxgcb validate。完整測試（TMPDIR 指向工作區 out/p2b3-tmp）python3 -m unittest discover -s tests -v：74 tests，OK。輸出見 P2B3_TEST_OUTPUT.txt。', '',\n              '每條都有 positive／negative／missing／empty／error；另保留 nonzero_matching 顯示模擬器只看 stdout 的界線，不能把手寫 PASS+exit 2 當成真實 wrapper 行為。audit/AIDE/immutable 加註解反例，套件加 rpm_other_error；測試實際三態 shell 的退出碼 0/1/2/3/126/127，偽造匹配輸出也不能逸出失敗分支。', '',\n              '額外執行實際解析器：每個 audit 子規則逐一移除/註解/改 key/加後綴、UID_MIN 覆寫、超過 600 行前置內容、metadata 權限與特殊位元、auditd 最後值與數值邊界、journald sections/drop-in 覆寫、rsyslog 兩種語法、特權程式新增、sudo 路徑變更、不變模式覆寫及自然排序。所有讀取導向 test-only 暫存樹，UID/GID 與 systemctl/RPM 僅 mock，不讀真機設定、不執行服務操作。', '',\n              '本次離線驗收不等於 Wazuh PCRE2／wm_exec 或 RHEL9 真機驗收；Python regex 與 argv 模型的限制仍保留。未使用 SSH、生產 API、sudo、網路或秘密，也未執行 Excel 設定方法。', '',\n              '本環境 permission profile 將 .git 列為唯讀；依任務允許的例外保留工作目錄變更，不嘗試繞過限制建立 commit。既有未追蹤 codex_p2b3.log 為會話檔，不列入交付。', '']\n    (ROOT/'docs/P2B3_REVIEW.md').write_text('\\n'.join(lines))\n\nif __name__=='__main__': main()\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"cat > tests/test_p2b6.py <<'PY'\n\\\"\\\"\\\"Offline predicates against isolated trees; never read host configuration.\\\"\\\"\\\"\nimport contextlib\nimport io\nimport json\nfrom pathlib import Path\nimport subprocess\nimport tempfile\nimport unittest\nfrom unittest.mock import patch\nfrom linuxgcb import batch6\nfrom linuxgcb import p2b6_runtime as rt\nfrom linuxgcb.argv import w_strtok\n\n\nclass P2B6Tests(unittest.TestCase):\n    def setUp(self):\n        self.tmp = tempfile.TemporaryDirectory()\n        self.addCleanup(self.tmp.cleanup)\n        self.old = rt.ROOT\n        rt.ROOT = self.tmp.name\n        self.addCleanup(setattr, rt, 'ROOT', self.old)\n\n    def put(self, path, text):\n        dest = Path(self.tmp.name + path)\n        dest.parent.mkdir(parents=True, exist_ok=True)\n        dest.write_text(text)\n\n    def test_scope_source_and_argv(self):\n        self.assertEqual(len(batch6.ADDED), 42)\n        for n, rules in batch6.rules().items():\n            self.assertEqual(batch6.sources()[n]['category'], '帳號與存取控制')\n            argv = w_strtok(rules[0][0][2:])\n            self.assertEqual(argv[:2], ['/usr/bin/python3', '-c'])\n            self.assertEqual(argv[2], batch6.script(n))\n            self.assertEqual(argv[2].count(\\\"print('PASS')\\\"), 1)\n            compile(argv[2], '<candidate>', 'exec')\n\n    def test_numeric_boundaries_and_comments(self):\n        cases = {206:('retry',1,3),208:('minlen',12,None),209:('minclass',4,4),\n                 210:('dcredit',None,-1),211:('ucredit',None,-1),212:('lcredit',None,-1),213:('ocredit',None,-1),\n                 214:('difok',3,None),215:('maxclassrepeat',1,4),216:('maxrepeat',1,3),217:('dictcheck',1,1),311:('maxsequence',1,3)}\n        self.put('/etc/login.defs','PASS_MIN_LEN 12\\\\n')\n        for n,(key,low,high) in cases.items():\n            good = low if low is not None else high\n            path='/etc/security/pwquality.conf'\n            for text, expected in [(f'  {key} = {good}  \\\\n',True),(f'# {key}={good}\\\\n',False),(f'{key}_wrong={good}\\\\n',False)]:\n                self.put(path,text)\n                self.assertEqual(rt.check(n),expected,(n,text))\n            for bad in ([low-1] if low is not None else []) + ([high+1] if high is not None else []):\n                self.put(path,f'{key}={bad}\\\\n')\n                self.assertFalse(rt.check(n),n)\n\n    def test_source_defaults(self):\n        cases={218:('/etc/security/faillock.conf','deny = 5','deny = 0'),219:('/etc/security/faillock.conf','unlock_time=900','unlock_time=899'),\n               223:('/etc/login.defs','PASS_MIN_DAYS 1','PASS_MIN_DAYS 0'),224:('/etc/login.defs','PASS_WARN_AGE 14','PASS_WARN_AGE 13'),\n               225:('/etc/login.defs','PASS_MAX_DAYS 90','PASS_MAX_DAYS 91'),226:('/etc/default/useradd','INACTIVE=30','INACTIVE=0'),\n               227:('/etc/login.defs','FAIL_DELAY 4','FAIL_DELAY 3'),228:('/etc/login.defs','CREATE_HOME yes','CREATE_HOME no'),\n               240:('/etc/login.defs','UMASK 027','UMASK 022'),310:('/etc/security/faillock.conf','even_deny_root\\\\nroot_unlock_time=60','even_deny_root\\\\nroot_unlock_time=59')}\n        for n,(path,good,bad) in cases.items():\n            self.put(path,good);self.assertTrue(rt.check(n),n)\n            self.put(path,bad);self.assertFalse(rt.check(n),n)\n            self.put(path,'# '+good.replace('\\\\n','\\\\n# '));self.assertFalse(rt.check(n),n)\n\n    def test_pam_and_symlink(self):\n        good='password requisite pam_pwquality.so local_users_only enforce_for_root\\\\nauth sufficient pam_unix.so\\\\naccount required pam_unix.so\\\\npassword sufficient pam_unix.so sha512 shadow use_authtok\\\\nsession required pam_unix.so\\\\npassword required pam_pwhistory.so remember=3\\\\n'\n        self.put('/etc/pam.d/system-auth',good)\n        self.put('/etc/authselect/password-auth',good)\n        Path(self.tmp.name+'/etc/pam.d/password-auth').symlink_to('../authselect/password-auth')\n        for n in (207,220,312,313,314): self.assertTrue(rt.check(n),n)\n        self.put('/etc/pam.d/system-auth',good.replace('pam_unix.so','pam_unix.so nullok'))\n        self.assertFalse(rt.check(312))\n        self.put('/etc/pam.d/system-auth',good.replace('remember=3','remember=2'))\n        self.assertFalse(rt.check(220))\n        self.put('/etc/libuser.conf','crypt_style = sha512')\n        self.put('/etc/login.defs','ENCRYPT_METHOD SHA512')\n        self.assertTrue(rt.check(222))\n        self.put('/etc/pam.d/postlogin','session required pam_lastlog.so showfailed')\n        self.assertTrue(rt.check(221))\n        self.put('/etc/pam.d/su','auth required pam_wheel.so use_uid')\n        self.put('/etc/group','wheel:x:10:root,user1')\n        self.assertTrue(rt.check(241))\n\n    def test_desktop_and_account_and_shell(self):\n        self.put('/etc/dconf/db/local.d/00-screensaver','[org/gnome/desktop/screensaver]\\\\nlock-enabled=true\\\\n[org/gnome/desktop/session]\\\\nidle-delay=uint32 900')\n        for n in (232,233):self.assertTrue(rt.check(n))\n        self.put('/etc/dconf/db/local.d/00-screensaver','[wrong]\\\\nlock-enabled=true\\\\nidle-delay=uint32 900')\n        for n in (232,233):self.assertFalse(rt.check(n))\n        self.put('/etc/dconf/db/local.d/locks/session','\\\\n'.join('/org/gnome/desktop/'+s for s in ('session/idle-delay','screensaver/lock-enabled','screensaver/lock-delay','lockdown/disable-lock-screen')))\n        self.assertTrue(rt.check(237))\n        self.put('/etc/gdm/custom.conf','[daemon]\\\\nAutomaticLoginEnable=false')\n        self.assertTrue(rt.check(234))\n        self.put('/etc/login.defs','UID_MIN 1000')\n        self.put('/etc/passwd','root:x:0:0:root:/root:/bin/bash\\\\ndaemon:x:2:2::/:/sbin/nologin')\n        with patch.object(rt.subprocess,'run',return_value=subprocess.CompletedProcess([],0,'daemon LK 2026-01-01','')):\n            self.assertTrue(rt.check(235));self.assertTrue(rt.check(238))\n        for p in ('/etc/bashrc','/etc/profile','/root/.bashrc','/root/.bash_profile'):\n            self.put(p,'umask 027\\\\nreadonly TMOUT=900 ; export TMOUT')\n        for n in (236,239,309):self.assertTrue(rt.check(n))\n        self.put('/etc/bashrc','umask 022\\\\nTMOUT=0')\n        for n in (236,239):self.assertFalse(rt.check(n))\n        self.put('/etc/security/limits.conf','* hard maxlogins 10')\n        self.assertTrue(rt.check(230))\n        self.put('/etc/security/limits.conf','* hard maxlogins 11')\n        self.assertFalse(rt.check(230))\n        self.put('/etc/sudoers','# NOPASSWD\\\\nroot ALL=(ALL) ALL')\n        self.assertTrue(rt.check(229))\n        self.put('/etc/sudoers','root ALL=(ALL) NOPASSWD: ALL')\n        self.assertFalse(rt.check(229))\n\n    def test_rpm_three_states(self):\n        for rc,expect in ((0,True),(1,False)):\n            with patch.object(rt.subprocess,'run',return_value=subprocess.CompletedProcess([],rc,'kbd-1' if rc==0 else 'not installed','')) as run:\n                self.assertEqual(rt.check(231),expect)\n                self.assertEqual(run.call_args.args[0],['/usr/bin/rpm','-q','kbd'])\n        with patch.object(rt.subprocess,'run',return_value=subprocess.CompletedProcess([],2,'kbd-1','')):\n            with self.assertRaises(ValueError):rt.check(231)\n\n    def test_missing_never_commits(self):\n        for n in sorted(batch6.ADDED):\n            script=batch6.script(n).replace(\\\"ROOT = ''\\\",'ROOT = '+repr(self.tmp.name),1)\n            # Mock subprocess so no host package query is performed.\n            namespace={}\n            with patch('subprocess.run',side_effect=OSError('offline')),contextlib.redirect_stdout(io.StringIO()) as out:\n                exec(script,namespace)\n            self.assertEqual(out.getvalue(),'',n)\n\n    def test_original_146_rules_unchanged(self):\n        root=Path(__file__).resolve().parents[1]\n        baseline={}\n        current={}\n        for p in sorted((root/'policies').glob('*.yml')):\n            old=json.loads(subprocess.check_output(['git','show','HEAD:policies/'+p.name],cwd=root))\n            baseline.update({c['id']:c['rules'] for c in old['checks']})\n            current.update({c['id']:c['rules'] for c in json.loads(p.read_text())['checks']})\n        self.assertEqual(len(baseline),146)\n        self.assertEqual(len(current),188)\n        self.assertEqual(baseline,{n:current[n] for n in baseline})\nPY\npython3 -m unittest discover -s tests -v > /tmp/p2b6-tests.txt 2>&1\"","aggregated_output":"","exit_code":1,"status":"failed"}}

{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc 'cat linuxgcb/catalog.py linuxgcb/policy.py'","aggregated_output":"\"\"\"固定來源、候選範圍與保守分類。\"\"\"\nimport hashlib\nimport json\nfrom pathlib import Path\nfrom scripts.inventory import extract\nfrom .batch1 import ADDED\nfrom .quality import status\nfrom .batch3 import ADDED as BATCH3\nfrom .batch2 import ADDED as BATCH2\n\nROOT = Path(__file__).resolve().parents[1]\nXLSX_HASH = '7d752b639a1e780df08814c6252efadd3ea2711eaa5c9d91c070b84a296c0247'\nDOCX_HASH = '986effd9501b1fd97776129c6691cf8fc98246bd04514347322f3337508e0e5b'\nIMPLEMENTED = {45: 'base', 46: 'base', 108: 'base', 243: 'firewalld',\n               245: 'firewalld', 269: 'sshd', 270: 'sshd'}\nIMPLEMENTED.update({n: ('sshd' if n in (256,257) else 'firewalld' if n==242 else 'base') for n in ADDED})\nIMPLEMENTED.update({n: ('sshd' if n >= 254 else 'base') for n in BATCH2})\nIMPLEMENTED.update({n: 'base' for n in BATCH3})\nPARTIAL = {141: '僅來源設定方法明列 audit.rules；其餘 rules.d 規則檔集合尚未覆蓋',\n           108: '僅雙協定即時值；持久設定來源、覆寫順序與路由角色待審',\n           269: '僅 sshd -T 預設情境；Include/Match 與使用者/來源矩陣待審',\n           270: '僅 sshd -T 預設情境；Include/Match 與使用者/來源矩陣待審'}\n\n\ndef digest(path):\n    return hashlib.sha256(path.read_bytes()).hexdigest()\n\n\ndef registry():\n    source = next(ROOT.glob('*.xlsx'))\n    docx = next(ROOT.glob('*.docx'))\n    if digest(source) != XLSX_HASH or digest(docx) != DOCX_HASH:\n        raise ValueError('來源 hash 改變，停止產生')\n    records = extract(source)\n    result = []\n    for r in records:\n        n = int(r['gcb_id'][-4:])\n        included = r['sheet'] != 'Nftables防火牆'\n        profile = ('firewalld' if r['sheet'] == 'Firewalld防火牆' else\n                   'sshd' if r['sheet'] == 'SSH伺服器' else 'base')\n        if n in IMPLEMENTED:\n            classification, why = 'native_sca', '候選唯讀原生命令；完整語意與引擎驗收待人工審查'\n        elif profile != 'base' or any(k in r['title'] for k in ('GUI', '無線', '可攜', 'NFS')):\n            classification, why = 'conditional', '須先確認角色、服務與適用性，再選擇實作方式'\n        elif any(k in r['title'] for k in ('權限', '所有權', '擁有', '稽核', '密碼', '通行碼')):\n            classification, why = 'readonly_helper', '可能涉及集合、位元或載入鏈解析；尚未實作 helper'\n        else:\n            classification, why = 'manual_review', '尚未逐條語意審查，保守列人工待辦，非不可自動化結論'\n        result.append(dict(gcb_id=r['gcb_id'], source_file=r['source_file'],\n            source_sheet=r['sheet'], source_row=r['row'], source_sha256=XLSX_HASH,\n            category=r['category'], title=r['title'], expected=r['expected'],\n            included=included, scope_reason='候選，仍須主機適用性核准' if included else '明確排除 Nftables 工作表',\n            sca_id=900000+n, profile=profile, proposed_classification=classification,\n            justification=why, review_status='human_review_pending',\n            implementation='candidate' if n in IMPLEMENTED else 'pending' if included else 'excluded',\n            policy_id='linuxgcb_rhel9_'+IMPLEMENTED[n]+'_v01' if n in IMPLEMENTED else None,\n            coverage='partial' if n in PARTIAL else 'full' if n in IMPLEMENTED else 'unimplemented',\n            live_validation='UNVALIDATED', execution_review='pending',\n            pending=PARTIAL.get(n, '' if n in IMPLEMENTED else '未實作；待逐條 DOCX 語意審查')))\n        if n in IMPLEMENTED:\n            result[-1].update(status(n))\n    if (len(result), sum(r['included'] for r in result), len({r['sca_id'] for r in result}),\n        len({r['gcb_id'] for r in result})) != (314, 307, 314, 314):\n        raise ValueError('範圍或唯一性不符')\n    return result\n\n\ndef write_registry():\n    rows = registry()\n    (ROOT/'data/scope_registry.json').write_text(json.dumps(rows, ensure_ascii=False, indent=2)+'\\n')\n    return rows\n\"\"\"以 JSON（YAML 1.2 子集）產生候選 SCA；只模擬輸出匹配，不執行命令。\"\"\"\nimport json\nimport re\nfrom functools import lru_cache\nfrom .catalog import ROOT, registry, digest\nfrom .batch1 import rules as batch_rules, disabled_service_rules\nfrom .expected import PREFIX, values, parse_description\nfrom .batch2 import rules as batch2_rules, ADDED as BATCH2\nfrom .batch3 import rules as batch3_rules, ADDED as BATCH3\nfrom .argv import w_strtok\n\n\ndef definitions():\n    modes = '|'.join(format(n, 'o') for n in range(0o1000) if n & ~0o644 == 0)\n    return {**batch_rules(), **batch2_rules(), **batch3_rules(),\n        45: [('c:/usr/bin/stat -c %u:%g /etc/passwd', '^0:0$')],\n        46: [('c:/usr/bin/stat -c %a /etc/passwd', '^('+modes+')$')],\n        108: [('c:/usr/sbin/sysctl -n net.ipv4.ip_forward', '^0$'),\n              ('c:/usr/sbin/sysctl -n net.ipv6.conf.all.forwarding', '^0$')],\n        243: [('c:/usr/bin/systemctl show firewalld.service --property=LoadState', '^LoadState=loaded$'),\n              ('c:/usr/bin/systemctl show firewalld.service --property=ActiveState', '^ActiveState=active$'),\n              ('c:/usr/bin/systemctl show firewalld.service --property=UnitFileState', '^UnitFileState=enabled$')],\n        245: disabled_service_rules('nftables'),\n        269: [('c:/usr/sbin/sshd -T', '^permitrootlogin no$')],\n        270: [('c:/usr/sbin/sshd -T', '^permitemptypasswords no$')],\n    }\n\n\ndef build():\n    rows = registry()\n    expected = values()\n    for profile in ('base', 'firewalld', 'sshd'):\n        filename = 'linuxgcb_'+profile+'.yml'\n        checks = []\n        for row in rows:\n            if row['implementation'] != 'candidate' or row['profile'] != profile:\n                continue\n            checks.append(dict(id=row['sca_id'], title=row['gcb_id']+' '+row['title'],\n                description=PREFIX+expected[row['gcb_id']]+(' ｜ P2B3 執行審查 ' if row['sca_id']-900000 in BATCH3 else ' ｜ BATCH2 執行審查 ' if row['sca_id']-900000 in BATCH2 else ' ｜ Q1 執行審查 ')+row['execution_review']+'；coverage='+row['coverage']+'；'+','.join(row['issue_ids'])+'；raw PASS 非已驗證符合。'+row['pending'],\n                compliance=[{'twgcb': [row['gcb_id']]}], regex_type='pcre2', condition='all',\n                rules=[emit_rule(target, pattern) for target, pattern in definitions()[int(row['gcb_id'][-4:])]]))\n        policy = dict(policy=dict(id='linuxgcb_rhel9_'+profile+'_v01', file=filename,\n                      name='RHEL9 GCB v1.2 '+profile+' v0.1 UNVALIDATED',\n                      description='未驗證候選政策；僅供核准 RHEL9 試點，非完整符合性檢核', regex_type='pcre2'),\n                      requirements=dict(title='僅 RHEL 9', description='角色由核准群組控制',\n                        condition='all', rules=['f:/etc/os-release -> r:^ID=\"?rhel\"?$',\n                                               'f:/etc/os-release -> r:^VERSION_ID=\"?9([.][0-9]+)*\"?$']),\n                      checks=checks)\n        (ROOT/'policies'/filename).write_text(json.dumps(policy, ensure_ascii=False, indent=2)+'\\n')\n    hashes = {p.name: digest(p) for p in sorted((ROOT/'policies').glob('*.yml'))}\n    (ROOT/'data/policy_hashes.json').write_text(json.dumps(hashes, indent=2)+'\\n')\n    from .coverage import write\n    write()\n    validate()\n\n\ndef require(condition):\n    if not condition:\n        raise ValueError('候選政策結構、mapping 或 hash 不符')\n\n\ndef validate():\n    rows = {r['sca_id']: r for r in registry()}\n    seen = set()\n    for path in sorted((ROOT/'policies').glob('*.yml')):\n        p = json.loads(path.read_text())\n        require(p['policy']['file'] == path.name and p['policy']['regex_type']=='pcre2')\n        require(p['requirements'] == dict(title='僅 RHEL 9', description='角色由核准群組控制',\n            condition='all', rules=['f:/etc/os-release -> r:^ID=\"?rhel\"?$',\n                                   'f:/etc/os-release -> r:^VERSION_ID=\"?9([.][0-9]+)*\"?$']))\n        for c in p['checks']:\n            require(c['id'] not in seen and rows[c['id']]['included'])\n            seen.add(c['id'])\n            require(parse_description(c.get('description')) == values()[rows[c['id']]['gcb_id']])\n            require((' ｜ P2B3 ' if c['id']-900000 in BATCH3 else ' ｜ BATCH2 ' if c['id']-900000 in BATCH2 else ' ｜ Q1 ') in c['description'])\n            require(c['regex_type'] == 'pcre2' and c['condition'] == 'all')\n            require(c['compliance'] == [{'twgcb': [rows[c['id']]['gcb_id']]}])\n            require(rows[c['id']]['policy_id'] == p['policy']['id'])\n            require(c['rules'] == [emit_rule(a,b) for a,b in definitions()[c['id']-900000]])\n            for rule in c['rules']:\n                target, _ = rule.split(' -> ', 1)\n                require(target.removeprefix('not ').startswith('c:/'))\n                if c['id']-900000 not in BATCH2 | BATCH3:\n                    require(not any(x in target for x in ('|',';', '&&', '$', '`')))\n                parse_rule(rule)\n    require(seen == {900000+n for n in definitions()})\n    hashes = json.loads((ROOT/'data/policy_hashes.json').read_text())\n    require(hashes == {p.name:digest(p) for p in (ROOT/'policies').glob('*.yml')})\n    from .coverage import manifest\n    require(json.loads((ROOT/'data/coverage_manifest.json').read_text()) == manifest())\n    require(seen == {r['sca_id'] for r in rows.values() if r['implementation']=='candidate'})\n    return len(seen)\n\n\n@lru_cache(maxsize=1)\ndef supported_patterns():\n    return frozenset(p.lstrip('!') for rules in definitions().values() for _,p in rules) | {\n        '^ID=\"?rhel\"?$', '^VERSION_ID=\"?9([.][0-9]+)*\"?$'}\n\n\ndef emit_rule(target, pattern):\n    return ('not '+target+' -> r:'+pattern[1:]) if pattern.startswith('!') else target+' -> r:'+pattern\n\n\n@lru_cache(maxsize=1)\ndef batch2_emitted():\n    return {emit_rule(t,p) for rules in batch2_rules().values() for t,p in rules}\n\n\n@lru_cache(maxsize=1)\ndef batch3_emitted():\n    return {emit_rule(t,p) for rules in batch3_rules().values() for t,p in rules}\n\n\ndef parse_rule(rule):\n    \"\"\"Legacy bounded grammar plus exact allowlist of BATCH2 emitted rules.\"\"\"\n    if not isinstance(rule, str):\n        raise ValueError('不支援的規則語法')\n    if rule in batch2_emitted() or rule in batch3_emitted():\n        target, expression = rule.split(' -> ', 1)\n        argv = w_strtok(target.removeprefix('not ')[2:])\n        if len(argv) != 3 or argv[:2] != ['/bin/sh', '-c']:\n            raise ValueError('Invalid wm_exec shell argv')\n        return target.removeprefix('not '), re.compile(expression.split(':',1)[1], re.ASCII)\n    if rule.count(' -> r:') != 1:\n        raise ValueError('不支援的規則語法')\n    target, pattern = rule.split(' -> r:')\n    if not re.fullmatch(r'[cf]:/[^\\n\\r]+', target) or any(x in target for x in (' -> ', ' && ', '|', ';', '`', '$')):\n        raise ValueError('不支援的目標')\n    if pattern not in supported_patterns() and not re.fullmatch(r'\\^[A-Za-z0-9_ =:/-]+\\$', pattern):\n        raise ValueError('未驗證的 PCRE2 語法')\n    try:\n        return target, re.compile(pattern, re.ASCII)\n    except re.error as exc:\n        raise ValueError('無效模式') from exc\n\n\ndef simulate(check, observations):\n    \"\"\"僅輸出匹配模型；執行失敗資訊不足回 UNRESOLVED，不冒充 Wazuh。\n\n    FIX-3 模擬 OS_StrBreak 的前 256 行上限（wm_sca.c:1749）。\n    FIX-1 同一 command 的多行輸出仍按逐行存在匹配；alternation 是單一\n    正向 regex，規則間維持 all，不以空輸出或 stderr 推論 not-found。\n    所有項目 exit_code 不參與輸出匹配（wm_exec 正常結束仍回 0），\n    並以 emitted shell guard 確保失敗不發布輸出或成功標記。\n    明確 engine_result 可表示真機／fixture\n    的 Not applicable；error 只表示未取得可靠輸出，不能預測引擎結果。\n    \"\"\"\n    if check.get('regex_type', 'pcre2') != 'pcre2':\n        raise ValueError('只支援明確 PCRE2 候選子集')\n    if check.get('condition') != 'all':\n        raise ValueError('輸出模型只支援目前發出的 all 子集')\n    if not isinstance(check.get('rules'), list) or not check['rules']:\n        raise ValueError('規則不得為空')\n    parsed = [parse_rule(rule) for rule in check['rules']]\n    outcomes = []\n    for rule, (target, pattern) in zip(check['rules'], parsed):\n        obs = observations.get(target)\n        if target.startswith('f:') and obs is not None and obs.get('exists') is False:\n            outcomes.append('NOT_APPLICABLE')\n            continue\n        if obs is None or obs.get('error'):\n            outcomes.append('UNRESOLVED')\n        elif obs.get('engine_result') == 'NOT_APPLICABLE':\n            outcomes.append('NOT_APPLICABLE')\n        elif not isinstance(obs.get('stdout'), str):\n            raise ValueError('觀察必須提供字串 stdout')\n        else:\n            matched = any(pattern.search(line) for line in obs['stdout'].split('\\n')[:256])\n            if rule.startswith('not '):\n                matched = not matched\n            outcomes.append('PASS' if matched else 'FAIL')\n    # 官方 all：任何 FAIL 優先；未知執行不擅自轉成 N/A。\n    if 'FAIL' in outcomes:\n        return 'FAIL'\n    if 'UNRESOLVED' in outcomes:\n        return 'UNRESOLVED'\n    return 'NOT_APPLICABLE' if 'NOT_APPLICABLE' in outcomes else 'PASS'\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc 'cat linuxgcb/quality.py linuxgcb/expected.py linuxgcb/coverage.py linuxgcb/argv.py scripts/inventory.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc 'cat linuxgcb/quality.py linuxgcb/expected.py linuxgcb/coverage.py linuxgcb/argv.py scripts/inventory.py'","aggregated_output":"\"\"\"Q1 離線審查結論；只涵蓋原有 53 ID，非來源或真機核准。\"\"\"\nfrom .batch1 import FILES, PACKAGES, SERVICES\nfrom .batch3 import ADDED as BATCH3, caveat as batch3_caveat\nfrom .batch2 import ADDED as BATCH2, caveat as batch2_caveat\n\nABSENCE_PENDING = {30,94,97,98,245}\n\ndef findings(n):\n    issues = ['Q1-01']  # 非零但匹配 stdout，無已核准的原生執行狀態保護\n    if n in FILES or n in (45,46): issues += ['Q1-03','Q1-04']\n    if n in range(53,61) or n in (141,178,191,192): issues += ['Q1-05']\n    if n in SERVICES or n in (243,245): issues += ['Q1-06']\n    if n in ABSENCE_PENDING: issues += ['Q1-07']\n    if n in (108,141,269,270): issues += ['Q1-08']\n    return issues\n\ndef family(n):\n    if n in FILES or n in (45,46): return '檔案 metadata'\n    if n in PACKAGES: return 'RPM 存在'\n    if n in SERVICES or n in (243,245): return 'systemd 服務'\n    if n == 108: return 'sysctl 即時值'\n    return 'SSH 預設有效設定'\n\ndef status(n):\n    if n in BATCH3:\n        return dict(offline_review='completed_with_findings', execution_review='blocked',\n                    coverage='partial', issue_ids=['B3-ENGINE', 'B3-SCOPE'],\n                    family='P2B3 embedded read-only', source_approval='pending',\n                    live_validation='UNVALIDATED', pending=batch3_caveat(n))\n    if n in BATCH2:\n        return dict(offline_review='completed_with_findings', execution_review='blocked',\n                    coverage='partial', issue_ids=['B2-ENGINE', 'B2-SCOPE'],\n                    family='BATCH2 guarded read-only', source_approval='pending',\n                    live_validation='UNVALIDATED', pending=batch2_caveat(n))\n    return dict(offline_review='completed_with_findings',\n                execution_review='blocked',\n                coverage='blocked' if n in ABSENCE_PENDING else 'partial',\n                issue_ids=findings(n), family=family(n),\n                source_approval='pending', live_validation='UNVALIDATED')\n\"\"\"合規值僅作文字；從來源抽取，絕不執行設定方法。\"\"\"\nimport json\nimport re\nfrom .catalog import ROOT\n\nPREFIX = '合規值: '\nUNKNOWN = '待確認（來源未提供單一基準值）'\n\n\ndef source_expected(row):\n    from .batch3 import expected as batch3_expected\n    specific = batch3_expected(row)\n    if specific is not None:\n        return specific\n    from .batch2 import expected as batch2_expected\n    specific = batch2_expected(row)\n    if specific is not None:\n        return specific\n    value = (row.get('expected') or '').strip()\n    method = row.get('configuration_method') or ''\n    if value == '安裝':\n        match = re.search(r'#dnf install ([a-zA-Z0-9 -]+)', method)\n        return match.group(1).strip()+' 已安裝' if match else UNKNOWN\n    if value in ('啟用', '停用'):\n        match = re.search(r'#systemctl --now (enable|disable|mask) ([a-zA-Z0-9_.-]+)', method)\n        if not match:\n            return UNKNOWN\n        action, service = match.groups()\n        return service+' '+{'enable': 'enabled+active', 'disable': 'disabled+inactive',\n                              'mask': 'masked+inactive'}[action]\n    if row['gcb_id'].endswith('0108'):\n        return 'net.ipv4.ip_forward=0；net.ipv6.conf.all.forwarding=0'\n    if row['gcb_id'].endswith('0269'):\n        return 'PermitRootLogin '+value if value else UNKNOWN\n    if row['gcb_id'].endswith('0270'):\n        return 'PermitEmptyPasswords '+value if value else UNKNOWN\n    return value or UNKNOWN\n\n\ndef values():\n    return {r['gcb_id']: source_expected(r) for r in json.loads((ROOT/'data/controls.json').read_text())}\n\n\ndef parse_description(description):\n    if not isinstance(description, str) or not description.startswith(PREFIX):\n        return ''\n    return description[len(PREFIX):].split(' ｜ ', 1)[0].strip()\n\n\ndef report_expected(raw, policy):\n    \"\"\"歷史匯出可用本地政策補充，明示其非掃描時證據。\"\"\"\n    value = parse_description(raw.get('description'))\n    if value:\n        return value, 'raw_description'\n    value = parse_description(policy.get('description'))\n    if value:\n        return value, 'policy_description_fallback; raw_prefix_missing'\n    return '', 'prefix_missing'\n\"\"\"可重建的逐項來源對照與涵蓋 manifest；不執行候選命令。\"\"\"\nimport json\nfrom collections import Counter\nfrom zipfile import ZipFile\nfrom xml.etree import ElementTree as ET\nfrom .catalog import ROOT, registry, digest\nfrom .batch1 import ADDED, caveat\nfrom .quality import status\nfrom .batch3 import ADDED as BATCH3, caveat as batch3_caveat, mechanism as batch3_mechanism, sources as batch3_sources\nfrom .batch2 import ADDED as BATCH2, caveat as batch2_caveat\n\ndef manifest():\n    ns={'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}\n    docx=next(ROOT.glob('*.docx'))\n    xml=ET.fromstring(ZipFile(docx).read('word/document.xml'))\n    # ID 的 runs 必須在段落內接回，cell 再以換行串接段落。\n    tables=[]\n    for tr in xml.findall('.//w:tr',ns):\n        cells=['\\n'.join(''.join(t.text or '' for t in p.findall('.//w:t',ns))\n                         for p in cell.findall('.//w:p',ns)) for cell in tr.findall('w:tc',ns)]\n        tables.append(cells)\n    entries=[]\n    for row in registry():\n        n=row['sca_id']-900000\n        if row['implementation'] != 'candidate': continue\n        matches=[c for c in tables if row['gcb_id'] in c]\n        historical=[]\n        if n in BATCH3:\n            method=batch3_sources()[n]['configuration_method']\n            historical=[c for c in matches if c[-2] != method or c[-1] != row['expected']]\n            matches=[c for c in matches if c[-2] == method and c[-1] == row['expected']]\n        elif n in BATCH2:\n            historical=[c for c in matches if c[-1] != row['expected']]\n            matches=[c for c in matches if c[-1] == row['expected']]\n        if not matches or any(c[-2:] != matches[0][-2:] for c in matches) or row['expected'] not in matches[0]:\n            raise ValueError('DOCX ID／期望欄無法唯一核對：'+row['gcb_id'])\n        entries.append(dict(gcb_id=row['gcb_id'],sca_id=row['sca_id'],\n            source_sheet=row['source_sheet'],source_row=row['source_row'],expected=row['expected'],\n            docx_historical_cells=historical,docx_cells=matches[0],docx_occurrences=len(matches),docx_all_cells=matches,docx_sha256=digest(docx),\n            mechanism=(batch3_mechanism(n) if n in BATCH3 else 'BATCH2 c: shell 成功輸出保護、正向/否定逐行 PCRE2、all 聚合' if n in BATCH2 else '原生 c: 絕對路徑、正向逐行 PCRE2、all 聚合；無 shell'),\n            caveats=batch3_caveat(n) if n in BATCH3 else batch2_caveat(n) if n in BATCH2 else caveat(n) if n in ADDED else row['pending'],tests=[('tests/fixtures/p2b3/cases.json#' if n in BATCH3 else 'tests/fixtures/rule_outputs.json#')+str(row['sca_id']), 'tests/test_p2b3.py' if n in BATCH3 else 'tests/test_batch2.py' if n in BATCH2 else 'tests/test_quality_q1.py'],\n            cases=['positive','negative','missing','empty','error','nonzero_matching']+(['commented'] if n in BATCH3 and (148 <= n <= 173 or n==145) else [])+(['rpm_other_error'] if n in (92,96,99,100) else []),\n            review_status='human_review_pending',**status(n)))\n    rows=registry();counts=Counter(r['implementation'] for r in rows)\n    return dict(schema_version=2,label='離線候選涵蓋；非實機證據',\n        counts=dict(source=len(rows),included=sum(r['included'] for r in rows),excluded=counts['excluded'],\n                    before=7,added=len(ADDED)+len(BATCH2)+len(BATCH3),batch3_added=len(BATCH3),batch3_before=97,batch3_after=97+len(BATCH3),batch2_added=len(BATCH2),implemented=counts['candidate'],remaining=counts['pending'],\n                    full=sum(r['coverage']=='full' for r in rows),partial=sum(r['coverage']=='partial' for r in rows),\n                    blocked=sum(r['coverage']=='blocked' for r in rows),reviewed=len(entries),execution_blocked=len(entries),live_validated=0),\n        reviewed=entries)\n\ndef write():\n    m=manifest()\n    (ROOT/'data/coverage_manifest.json').write_text(json.dumps(m,ensure_ascii=False,indent=2)+'\\n')\n    return m\n\"\"\"Offline wm_exec argv subset: double quotes group; backslash escapes.\n\nSingle quotes are ordinary bytes. No shell expansion occurs at this layer.\nMalformed input is rejected rather than guessing an executable argv.\n\"\"\"\n\n\ndef w_strtok(command):\n    argv, word = [], []\n    quoted = active = False\n    i = 0\n    while i < len(command):\n        char = command[i]\n        if char == '\\\\':\n            i += 1\n            if i == len(command):\n                raise ValueError('Trailing escape')\n            word.append(command[i])\n            active = True\n        elif char == '\"':\n            quoted = not quoted\n            active = True\n        elif char in ' \\t\\r\\n' and not quoted:\n            if active:\n                argv.append(''.join(word))\n                word, active = [], False\n        else:\n            word.append(char)\n            active = True\n        i += 1\n    if quoted:\n        raise ValueError('Unpaired double quote')\n    if active:\n        argv.append(''.join(word))\n    return argv\n\n\ndef quote_argument(value):\n    \"\"\"Encode one argument and verify its round trip through the model.\"\"\"\n    encoded = '\"' + value.replace('\\\\', '\\\\\\\\').replace('\"', '\\\\\"') + '\"'\n    assert w_strtok(encoded) == [value]\n    return encoded\n#!/usr/bin/env python3\n\"\"\"Read XLSX with stdlib; preserve source cells and inventory GCB IDs.\"\"\"\nimport collections\nimport hashlib\nimport json\nfrom pathlib import Path\nimport re\nimport zipfile\nimport xml.etree.ElementTree as ET\n\nROOT = Path(__file__).resolve().parents[1]\nNS = {'s': 'http://schemas.openxmlformats.org/spreadsheetml/2006/main'}\n\ndef extract(path):\n    records = []\n    with zipfile.ZipFile(path) as z:\n        strings = []\n        if 'xl/sharedStrings.xml' in z.namelist():\n            strings = [''.join(n.itertext()) for n in ET.fromstring(z.read('xl/sharedStrings.xml')).findall('s:si', NS)]\n        rels = {r.attrib['Id']: r.attrib['Target'] for r in ET.fromstring(z.read('xl/_rels/workbook.xml.rels'))}\n        wb = ET.fromstring(z.read('xl/workbook.xml'))\n        for sheet in wb.findall('s:sheets/s:sheet', NS):\n            rid = sheet.attrib['{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id']\n            target = rels[rid]\n            target = target.lstrip('/') if target.startswith('/') else 'xl/' + target\n            for row in ET.fromstring(z.read(target)).findall('s:sheetData/s:row', NS):\n                cells = {}\n                for c in row.findall('s:c', NS):\n                    match = re.match(r'[A-Z]+', c.attrib['r'])\n                    if match is None:\n                        raise ValueError('Invalid XLSX cell reference')\n                    col = match.group()\n                    v = c.find('s:v', NS)\n                    value = (v.text or '') if v is not None else ''\n                    if c.attrib.get('t') == 's':\n                        value = strings[int(value)]\n                    elif c.attrib.get('t') == 'inlineStr':\n                        value = ''.join(t.text or '' for t in c.findall('.//s:t', NS))\n                    cells[col] = value\n                if re.fullmatch(r'TWGCB-\\d{2}-\\d{3}-\\d{4}', cells.get('B', '')):\n                    records.append(dict(source_file=path.name, sheet=sheet.attrib['name'], row=int(row.attrib['r']),\n                        ordinal=cells.get('A'), gcb_id=cells['B'], category=cells.get('C'), title=cells.get('D'),\n                        description=cells.get('E'), configuration_method=cells.get('F'), expected=cells.get('G'),\n                        implementation_status='unreviewed'))\n    return records\n\ndef main():\n    sources = sorted(ROOT.glob('*.xlsx'))\n    records = [r for p in sources for r in extract(p)]\n    counts = collections.Counter(r['gcb_id'] for r in records)\n    summary = dict(total=len(records), unique_ids=len(counts), duplicate_ids=[k for k,v in counts.items() if v>1],\n        categories=dict(collections.Counter(r['category'] for r in records)),\n        sheets=dict(collections.Counter(r['sheet'] for r in records)),\n        missing_required=[r['gcb_id'] for r in records if not all(r.get(k) for k in ('title','category','expected'))],\n        source_sha256={p.name:hashlib.sha256(p.read_bytes()).hexdigest() for p in sources})\n    out = ROOT/'data'\n    out.mkdir(exist_ok=True)\n    (out/'controls.json').write_text(json.dumps(records,ensure_ascii=False,indent=2)+'\\n')\n    (out/'inventory.json').write_text(json.dumps(summary,ensure_ascii=False,indent=2)+'\\n')\n    print(json.dumps(summary,ensure_ascii=False,indent=2))\n    assert records and not summary['duplicate_ids'] and not summary['missing_required']\n\nif __name__ == '__main__':\n    main()\n","exit_code":0,"status":"completed"}}

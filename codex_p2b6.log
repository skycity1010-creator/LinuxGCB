], 'sudo_log':['files','read','active','audit_matches'],\n    'privileged':['read','uid_min','audit_matches'], 'immutable':['files','active','read'],\n    'logrotate':['active','read','metadata'],\n}\n\n\ndef spec(n):\n    if n in AUDIT:\n        return ['audit_rules'], 'audit_rules('+repr(audit_lines(n))+')'\n    if n == 92:\n        return [], ''\n    if n == 93:\n        return ['active','read'], \"any(re.fullmatch(r'(server|pool)\\\\s+[^\\\\s#()]+(?:\\\\s+[^#]+)?', line) for line in active(read('/etc/chrony.conf')))\"\n    if n == 95:\n        return ['service'], \"service('avahi-daemon.service') and service('avahi-daemon.socket')\"\n    if n in (96,99,100):\n        return ['optional_service'], 'optional_service('+repr(PACKAGES[n])+', '+repr({96:'snmpd',99:'vsftpd',100:'ypserv'}[n]+'.service')+', '+repr(n==96)+')'\n    if n in (134,135):\n        return ['grub'], 'grub('+repr('audit' if n==134 else 'audit_backlog_limit')+', '+str(1 if n==134 else 8192)+')'\n    if n == 136:\n        return ['active','read'], \"(lambda lines: bool(lines) and re.fullmatch(r'postmaster:\\\\s*root', lines[-1]) is not None)([line for line in active(read('/etc/aliases')) if re.match(r'postmaster:', line)])\"\n    if n in (137,138,139,140):\n        return ['log_metadata'], 'log_metadata('+{137:'None',138:'0o600',139:'None',140:'0o700'}[n]+', '+repr(n in (139,140))+')'\n    if n in (143,144):\n        paths=['/sbin/'+name for name in ('auditctl','aureport','ausearch','autrace','auditd','audisp-remote','audisp-syslog','augenrules','rsyslogd')]\n        return ['optional_tool_metadata'], 'all(optional_tool_metadata(path, '+('0o750' if n==143 else 'None')+') for path in '+repr(paths)+')'\n    if n == 145:\n        paths=['/usr/sbin/'+name for name in ('auditctl','auditd','ausearch','aureport','autrace','audisp-remote','audisp-syslog','augenrules')]\n        return ['audit_matches'], \"audit_matches('/etc/aide.conf', [path + ' p+i+n+u+g+s+b+acl+xattrs+sha512' for path in \"+repr(paths)+'])'\n    if n in (146,147):\n        key='max_log_file' if n==146 else 'max_log_file_action'\n        expr=\"setting(read('/etc/audit/auditd.conf'), \"+repr(key)+')'\n        return ['setting','read'], ('(lambda v: v is not None and v.isdigit() and int(v) >= 32)('+expr+')' if n==146 else expr+\" == 'keep_logs'\")\n    name={158:'privileged',161:'sudo_log',173:'immutable',176:'rsyslog_mode',177:'rsyslog_rules',308:'logrotate'}.get(n)\n    if name:\n        return [name], name+'()'\n    if n in (181,182):\n        return ['journal'], \"journal('Compress', 'yes')\" if n==181 else \"journal('Storage', 'persistent')\"\n    raise ValueError(n)\n\n\n@lru_cache(maxsize=None)\ndef script(n):\n    functions, expr = spec(n)\n    used=[]\n    def add(name):\n        for dep in DEPS[name]: add(dep)\n        if name not in used: used.append(name)\n    for name in functions: add(name)\n    return (\"import glob, os, re, stat, subprocess\\nROOT = ''\\n\"+\n            '\\n'.join(inspect.getsource(getattr(runtime,name)) for name in used)+\n            '\\ntry:\\n    ok = '+expr+\"\\nexcept (OSError, ValueError, IndexError, KeyError):\\n    ok = False\\nif ok:\\n    print('PASS')\\n\")\n\n\n@lru_cache(maxsize=1)\ndef rules():\n    result={}\n    for n in sorted(ADDED):\n        if n == 92:\n            body='out=$(rpm -q xinetd 2>/dev/null); rc=$?; case $rc in 0) echo INSTALLED;; 1) echo ABSENT;; *) exit $rc;; esac'\n            result[n]=[('c:/bin/sh -c '+quote_argument(body), '^ABSENT$')]\n        else:\n            command='/usr/bin/python3 -c '+shlex.quote(script(n))\n            result[n]=[('c:/bin/sh -c '+quote_argument(command), '^PASS$')]\n    return result\n\n\ndef mechanism(n):\n    if n in AUDIT: return '持久 audit.rules 全行正則，逐條 all；UID_MIN 取最後有效值'\n    return {92:'定向 rpm -q 三態',93:'chrony 有效 server/pool',95:'FIX-1 systemctl service/socket 停用',\n            96:'定向 RPM 三態／停用服務／明確 authPriv SNMPv3 子集',99:'定向 RPM 三態＋FIX-1 停用 vsftpd',100:'定向 RPM 三態＋FIX-1 停用 ypserv',\n            134:'GRUB audit 開機參數',135:'GRUB backlog 數值下界',136:'aliases postmaster root',\n            137:'有效 log_file 檔案 owner',138:'有效 log_file 檔案 mode 位元遮罩',139:'有效 log_file 目錄 owner/type',140:'有效 log_file 目錄 mode/type',\n            143:'九個來源工具 mode 位元遮罩',144:'九個來源工具 UID/GID',145:'八個 AIDE 工具完整屬性正則',\n            146:'auditd.conf 最後有效值 >=32',147:'auditd.conf 最後有效值 keep_logs',158:'所有實體掛載點 xdev 特權程式逐一對 privileged.rules',\n            161:'sudoers logfile 路徑逐一對 actions.rules',173:'持久規則最後有效 -e 2 與 loginuid immutable',\n            176:'rsyslog 舊式預設與新式 action fileCreateMode 位元遮罩',177:'rsyslog 三類 selector 與 secure 目的地',\n            181:'Journal Compress 最後有效值與排序 drop-in',182:'Journal Storage 最後有效值與排序 drop-in',308:'指定 rsyslog logrotate 完整 stanza 與日誌目錄權限'}[n]\n\n\ndef caveat(n):\n    common='P2B3 UNVALIDATED；human_review_pending；execution_review=blocked。唯讀內嵌 Python，需 RHEL9 /usr/bin/python3 標準函式庫；不安裝 helper。完成所有讀取才輸出單行 PASS，錯誤/缺失無成功輸出；w_strtok、PCRE2、timeout 待真機驗證。'\n    detail=''\n    if n in AUDIT: detail='依來源 audit.rules 的完整 token 順序逐條比對；等價重排或合併 syscall 可能保守失敗；不代表核心已載入。auid 門檻依 login.defs UID_MIN。'\n    if n==159: detail+='來源 renameat-S 排版錯誤解讀為 renameat -S，保留五個 syscall，待人工核准。'\n    if n in (134,135): detail='僅來源 /etc/default/grub；已產生開機項/執行中核心待真機確認。'\n    if n in (137,138,139,140): detail='使用最後有效 log_file，缺失不採範例路徑預設；跟隨 symlink；檔案本體與實際目錄，ACL/輪替檔待審。'\n    if n in (143,144): detail='RHEL9 audit 3.x 無 audisp plugin；不存在工具跳過之來源解讀待批。存在工具仍須符合原 mode/owner 標準；僅 FileNotFoundError 跳過，其他 stat 錯誤失敗；stat 跟隨 /sbin symlink；ACL 待審。'\n    if n==145: detail='逐工具要求來源完整屬性序列；AIDE macro/Include 與資料庫初始化待審。'\n    if n in (95,96,99,100): detail='FIX-1 明確 not-found 且 inactive 視為停用；disabled/masked 且 inactive 合格；systemctl 錯誤不合格。套件 ABSENT 仍須確認服務 inactive，避免移除套件後程序仍存活。多次查詢非原子。'\n    if n==96: detail+='來源允許 v3；自動候選限明確 rouser priv，禁 v1/v2 access/include；SHA/AES 金鑰建立與實際協商仍須人工證據，不讀取或輸出私密使用者金鑰。'\n    if n in (92,96,99,100): detail+='僅定向 rpm -q，0=INSTALLED、1=ABSENT、其他錯誤無成功輸出；不查 rpm -qa。'\n    if n==158: detail='列舉 mountinfo 實體檔案系統（排除 proc/sysfs 等虛擬介面），每掛載點 xdev 查所有 regular setuid/setgid；空集合為全稱真但 privileged.rules 仍須可讀。大型/網路檔案系統成本與競態待審。'\n    if n==161: detail='只辨識 /etc/sudoers 與 sudoers.d 的明確 Defaults logfile；不假定 /var/log/sudo.log；條件 Defaults、外部 include 與覆寫完整語意待人工審查。'\n    if n==173: detail='來源 -e 2--loginuid-immutable 排版解讀為兩條指令；自然數字排序規則檔，最後 -e 必須為 2 且最後有效行為鎖定指令；核心狀態待審。'\n    if n==176: detail='保守要求所有明確 $FileCreateMode 與 action fileCreateMode 均不超過 0640；未設定不假定預設合格；複雜模板/include 待審。'\n    if n==177: detail='接受來源逗號與分號 selector，舊式 secure 路徑與新式 omfile action；複雜多行 action/模板/ruleset 待審。'\n    if n in (181,182): detail='來源要求新增明確設定；未設定（即使 Compress 套件預設 yes）不判 PASS。解析 [Journal]、最後值與 /usr/lib、/usr/local/lib、/run、/etc drop-in 同名優先/字典順序與 /dev/null mask；執行中狀態待審。'\n    if n==308: detail='依來源 /etc/logrotate.d/rsyslog 指定路徑、weekly/rotate 4/compress/missingok/notifempty/postrotate 及目錄 <=0750；不是任意 rsyslog 字樣即合格；複雜多 stanza、實際輪替待審。'\n    return detail+common\n\n\ndef expected(row):\n    suffix=row.get('gcb_id', '')[-4:]\n    if not suffix.isdigit(): return None\n    n=int(suffix)\n    if n not in ADDED: return None\n    if n in AUDIT: return '；'.join(audit_lines(n))\n    return {92:'xinetd 未安裝',93:'至少一個有效 server 或 pool',95:'avahi-daemon.service/socket disabled/masked 且 inactive',\n            96:'SNMP 停用或僅 SNMPv3（SHA/AES 需人工證據）',99:'vsftpd disabled/masked 或明確 not-found，且 inactive；RPM 三態無錯誤',100:'ypserv disabled/masked 或明確 not-found，且 inactive；RPM 三態無錯誤',\n            134:'audit=1',135:'audit_backlog_limit>=8192',136:'postmaster: root',137:'稽核日誌 root:root',138:'稽核日誌 <=0600（位元子集合）',\n            139:'稽核日誌目錄 root:root',140:'稽核日誌目錄 <=0700（位元子集合）',143:'九個稽核工具 <=0750（位元子集合）',144:'九個稽核工具 root:root',\n            145:'八個稽核工具 p+i+n+u+g+s+b+acl+xattrs+sha512',146:'max_log_file>=32',147:'max_log_file_action=keep_logs',\n            158:'每個磁區所有特權程式都有 privileged.rules 執行稽核',161:'sudo 實際 logfile 有 actions.rules wa/actions 稽核',\n            173:'-e 2；--loginuid-immutable',176:'$FileCreateMode/action fileCreateMode <=0640（位元子集合）',177:'auth.*、authpriv.*、daemon.* → /var/log/secure',\n            181:'[Journal] Compress=yes（明確設定）',182:'[Journal] Storage=persistent',308:'指定 rsyslog logrotate weekly/rotate 4/compress/missingok/notifempty/postrotate；目錄 <=0750'}[n]\n\"\"\"Read-only routines embedded in P2B3 commands; no endpoint helper installation.\n\nBuild imports this module but never invokes its readers. Tests redirect ROOT to\nan isolated test-only tree before executing any reader.\n\"\"\"\nimport glob\nimport os\nimport re\nimport stat\nimport subprocess\n\nROOT = ''\n\n\ndef read(path):\n    with open(ROOT + path, encoding='utf-8') as stream:\n        return stream.read()\n\n\ndef files(pattern):\n    parent = os.path.dirname(ROOT + pattern)\n    try:\n        os.stat(parent)\n    except FileNotFoundError:\n        return []\n    with os.scandir(parent) as entries:\n        list(entries)\n    return sorted(p[len(ROOT):] for p in glob.glob(ROOT + pattern))\n\n\ndef active(text):\n    return [line.strip() for line in text.splitlines()\n            if line.strip() and not line.lstrip().startswith(('#', ';'))]\n\n\ndef setting(text, key, section=None):\n    value = None\n    current = None\n    for line in active(text):\n        if line.startswith('['):\n            current = line\n        elif '=' in line and (section is None or current == '[' + section + ']'):\n            name, content = line.split('=', 1)\n            if name.strip().lower() == key.lower():\n                value = content.split('#', 1)[0].strip()\n    return value\n\n\ndef metadata(path, mask=None, directory=False):\n    info = os.stat(ROOT + path)\n    if directory and not stat.S_ISDIR(info.st_mode):\n        return False\n    return ((info.st_uid == 0 and info.st_gid == 0) if mask is None\n            else stat.S_IMODE(info.st_mode) & ~mask == 0)\n\n\ndef audit_matches(path, required):\n    lines = active(read(path))\n    for item in required:\n        pattern = r'\\s*' + r'\\s+'.join(re.escape(t) for t in item.split()) + r'\\s*'\n        if not any(re.fullmatch(pattern, line) for line in lines):\n            return False\n    return True\n\n\ndef uid_min():\n    values = [line.split()[1] for line in active(read('/etc/login.defs'))\n              if line.split()[0] == 'UID_MIN']\n    if not values or not values[-1].isdigit():\n        raise ValueError('UID_MIN unresolved')\n    return str(int(values[-1]))\n\n\ndef audit_rules(required):\n    if any('auid>=1000' in line for line in required):\n        required = [line.replace('auid>=1000', 'auid>=' + uid_min()) for line in required]\n    return audit_matches('/etc/audit/rules.d/audit.rules', required)\n\n\ndef log_metadata(mask=None, directory=False):\n    path = setting(read('/etc/audit/auditd.conf'), 'log_file')\n    if not path or not path.startswith('/'):\n        return False\n    if directory:\n        path = os.path.dirname(path)\n    return metadata(path, mask, directory)\n\n\ndef service(unit):\n    result = subprocess.run(['/usr/bin/systemctl', 'show', unit,\n                             '--property=LoadState', '--property=ActiveState',\n                             '--property=UnitFileState'], capture_output=True, text=True)\n    if result.returncode:\n        raise ValueError('systemctl failed')\n    props = dict(line.split('=', 1) for line in result.stdout.splitlines() if '=' in line)\n    # Source asks to disable; explicit not-found + inactive is also disabled.\n    return (props.get('ActiveState') == 'inactive' and\n            (props.get('LoadState') == 'not-found' or\n             (props.get('LoadState') in ('loaded', 'masked') and\n              props.get('UnitFileState') in ('disabled', 'masked'))))\n\n\ndef package_state(package):\n    command = 'out=$(rpm -q ' + package + ' 2>/dev/null); rc=$?; case $rc in 0) echo INSTALLED;; 1) echo ABSENT;; *) exit $rc;; esac'\n    result = subprocess.run(['/bin/sh', '-c', command], capture_output=True, text=True)\n    if result.returncode or result.stdout.strip() not in ('INSTALLED', 'ABSENT'):\n        raise ValueError('rpm failed')\n    return result.stdout.strip()\n\n\ndef optional_service(package, unit, snmp=False):\n    state = package_state(package)\n    if service(unit):\n        return True\n    if state == 'ABSENT' or not snmp:\n        return False\n    lines = active(read('/etc/snmp/snmpd.conf'))\n    # A conservative, explicit authPriv-only subset of the source's v3 branch.\n    forbidden = ('com2sec', 'com2sec6', 'group', 'view', 'access', 'rocommunity',\n                 'rwcommunity', 'rocommunity6', 'rwcommunity6', 'includeFile',\n                 'includeDir', 'includefile', 'includedir', 'rwuser')\n    if any(line.split()[0] in forbidden for line in lines):\n        return False\n    users = [line for line in lines if line.split()[0] == 'rouser']\n    return bool(users) and all(re.fullmatch(r'rouser\\s+\\S+\\s+priv(?:\\s+\\S+)?', line,\n                                          re.I) for line in users)\n\n\ndef optional_tool_metadata(path, mask=None):\n    try:\n        return metadata(path, mask)\n    except FileNotFoundError:\n        return True\n\n\ndef rsyslog_text():\n    return '\\n'.join(read(path) for path in ['/etc/rsyslog.conf'] + files('/etc/rsyslog.d/*.conf'))\n\n\ndef rsyslog_mode():\n    text = '\\n'.join(active(rsyslog_text()))\n    declarations = [line for line in text.splitlines() if re.match(r'^\\$FileCreateMode(?:\\s|$)', line)]\n    if any(not re.fullmatch(r'\\$FileCreateMode\\s+0?[0-7]{3}\\s*', line) for line in declarations):\n        return False\n    modes = [line.split()[1] for line in declarations]\n    action_lines = '\\n'.join(line for line in text.splitlines()\n                             if re.search(r'\\baction\\s*\\(', line, re.I)\n                             and re.search(r'\\bomfile\\b', line, re.I)\n                             and not re.search(r'\\bmodule\\s*\\(', line, re.I))\n    overrides = re.findall(r'fileCreateMode\\s*=\\s*\"([^\"]*)\"', action_lines, re.I)\n    return (bool(modes or overrides) and\n            all(re.fullmatch(r'0?[0-7]{3}', value) and int(value, 8) & ~0o640 == 0\n                for value in modes + overrides))\n\n\ndef rsyslog_rules():\n    lines = active(rsyslog_text())\n    # Accept source comma notation and conventional semicolon selector separators.\n    for facility in ('auth', 'authpriv', 'daemon'):\n        selector = r'(?:auth|authpriv|daemon)\\.\\*'\n        selectors = selector + r'(?:\\s*[,;]\\s*' + selector + r')*'\n        destination = r'(?:-?/var/log/secure|action\\(\\s*type=\"omfile\"\\s+file=\"/var/log/secure\"\\s*\\))'\n        if not any(re.fullmatch(selectors + r'\\s+' + destination, line) and\n                   re.search(r'(?:^|[,;])\\s*' + facility + r'\\.\\*(?:\\s*[,;]|\\s+)', line)\n                   for line in lines):\n            return False\n    return True\n\n\ndef journal(key, expected):\n    # /etc drop-ins take priority over equal basenames in /run and vendor dirs.\n    paths = {}\n    for folder in ('/usr/lib', '/usr/local/lib', '/run', '/etc'):\n        for path in files(folder + '/systemd/journald.conf.d/*.conf'):\n            paths[os.path.basename(path)] = path\n    text = read('/etc/systemd/journald.conf')\n    value = setting(text, key, 'Journal')\n    for name in sorted(paths):\n        path = paths[name]\n        if os.path.islink(ROOT + path) and os.readlink(ROOT + path) == '/dev/null':\n            continue\n        override = setting(read(path), key, 'Journal')\n        if override is not None:\n            value = override\n    return value == expected\n\n\ndef grub(key, minimum):\n    values = {}\n    for line in active(read('/etc/default/grub')):\n        match = re.fullmatch(r'(GRUB_CMDLINE_LINUX(?:_DEFAULT)?)\\s*=\\s*([\\'\"])(.*?)\\2', line)\n        if match:\n            values[match[1]] = match[3].split()\n    if 'GRUB_CMDLINE_LINUX' not in values:\n        return False\n    options = [word.split('=', 1)[1] for word in values['GRUB_CMDLINE_LINUX'] if word.startswith(key + '=')]\n    if not options:\n        return False\n    options += [word.split('=', 1)[1] for word in values.get('GRUB_CMDLINE_LINUX_DEFAULT', []) if word.startswith(key + '=')]\n    return all(value.isdigit() and (int(value) == 1 if key == 'audit' else int(value) >= minimum) for value in options)\n\n\ndef sudo_log():\n    paths = ['/etc/sudoers'] + files('/etc/sudoers.d/*')\n    logs = set()\n    for path in paths:\n        text = read(path)\n        for raw in text.splitlines():\n            include = re.match(r'\\s*(?:#|@)include(dir)?\\s+(.+)', raw)\n            if include and not (include[1] == 'dir' and include[2].strip() == '/etc/sudoers.d'):\n                return False\n        for line in active(text):\n            if line.startswith('Defaults'):\n                if re.search(r'!logfile\\b', line):\n                    return False\n                values = re.findall(r\"\\blogfile\\s*=\\s*(?:\\\"([^\\\"]+)\\\"|'([^']+)'|([^\\s,]+))\", line)\n                for parts in values:\n                    value = next(part for part in parts if part)\n                    if not value.startswith('/') or any(char.isspace() for char in value):\n                        return False\n                    logs.add(value)\n    return bool(logs) and all(audit_matches('/etc/audit/rules.d/actions.rules',\n                                          ['-w ' + path + ' -p wa -k actions']) for path in logs)\n\n\ndef privileged():\n    # Traverse each mounted real filesystem separately, preserving find -xdev.\n    pseudo = {'proc', 'sysfs', 'devtmpfs', 'devpts', 'cgroup', 'cgroup2', 'securityfs',\n              'debugfs', 'tracefs', 'configfs', 'pstore', 'mqueue', 'hugetlbfs',\n              'fusectl', 'autofs', 'binfmt_misc', 'rpc_pipefs'}\n    mounts = set()\n    for line in read('/proc/self/mountinfo').splitlines():\n        left, right = line.split(' - ', 1)\n        if right.split()[0] not in pseudo:\n            mount = re.sub(r'\\\\([0-7]{3})', lambda m: chr(int(m[1], 8)), left.split()[4])\n            mounts.add(mount)\n    if not mounts:\n        return False\n    required = set()\n    def fail(error):\n        raise error\n    for mount in sorted(mounts):\n        device = os.stat(ROOT + mount).st_dev\n        for folder, dirs, names in os.walk(ROOT + mount, onerror=fail, followlinks=False):\n            dirs[:] = [name for name in dirs if not os.path.islink(folder + '/' + name)\n                       and os.stat(folder + '/' + name).st_dev == device\n                       and (folder + '/' + name)[len(ROOT):] not in mounts]\n            for name in names:\n                path = folder + '/' + name\n                info = os.lstat(path)\n                if stat.S_ISREG(info.st_mode) and info.st_mode & 0o6000:\n                    required.add('-a always,exit -F path=' + path[len(ROOT):] +\n                                 ' -F perm=x -F auid>=' + uid_min() +\n                                 ' -F auid!=4294967295 -k privileged')\n    return audit_matches('/etc/audit/rules.d/privileged.rules', sorted(required))\n\n\ndef immutable():\n    paths = sorted(files('/etc/audit/rules.d/*.rules'),\n                   key=lambda path: [int(part) if part.isdigit() else part for part in re.split(r'(\\d+)', path)])\n    lines = [line for path in paths for line in active(read(path))]\n    controls = [line for line in lines if re.match(r'-e(?:\\s|$)', line)]\n    return (bool(controls) and controls[-1] == '-e 2' and\n            '--loginuid-immutable' in lines and lines[-1] in ('-e 2', '--loginuid-immutable'))\n\n\ndef logrotate():\n    text = '\\n'.join(active(read('/etc/logrotate.d/rsyslog')))\n    match = re.fullmatch(r'/var/log/rsyslog/\\*\\.log\\s*\\{(.*?)\\}', text, re.S)\n    if not match:\n        return False\n    lines = active(match[1])\n    required = {'weekly', 'rotate 4', 'compress', 'missingok', 'notifempty', 'endscript'}\n    return (required.issubset(set(lines)) and\n            any(re.fullmatch(r'postrotate\\s+/usr/bin/systemctl reload rsyslog.service\\s*>/dev/null\\s*\\|\\|\\s*true', line)\n                for line in lines) and metadata('/var/log/rsyslog', 0o750, True))\n","exit_code":0,"status":"completed"}}

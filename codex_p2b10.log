{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc 'cat linuxgcb/batch9.py; cat linuxgcb/catalog.py; cat linuxgcb/coverage.py; cat linuxgcb/quality.py; head -155 linuxgcb/policy.py'","aggregated_output":"\"\"\"P2B9 source-bound offline candidates, direct w_strtok Python argv.\"\"\"\nimport inspect\nimport hashlib\nfrom zipfile import ZipFile\nfrom xml.etree import ElementTree as ET\nfrom functools import lru_cache\nfrom pathlib import Path\nfrom . import p2b9_runtime\nfrom .argv import quote_argument\nADDED = set(range(109,132))\nimport re\n\n\n@lru_cache(maxsize=1)\ndef sources():\n    from scripts.inventory import extract\n    root = Path(__file__).resolve().parents[1]\n    docx = root/'docs/references/gcb-rhel9-v1.2.docx'\n    if hashlib.sha256(docx.read_bytes()).hexdigest() != '986effd9501b1fd97776129c6691cf8fc98246bd04514347322f3337508e0e5b':\n        raise ValueError('GCB v1.2 reference hash changed')\n    ns = {'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}\n    xml = ET.fromstring(ZipFile(docx).read('word/document.xml'))\n    tables = [['\\n'.join(''.join(t.text or '' for t in p.findall('.//w:t',ns))\n              for p in cell.findall('.//w:p',ns)) for cell in tr.findall('w:tc',ns)]\n              for tr in xml.findall('.//w:tr',ns)]\n    out = {}\n    for r in extract(next(root.glob('*.xlsx'))):\n        n = int(r['gcb_id'][-4:])\n        if n not in ADDED:\n            continue\n        matches = [c for c in tables if r['gcb_id'] in c and c[-1] == r['expected'] and c[-2] == r['configuration_method']]\n        if not matches or any(c[-2:] != matches[0][-2:] for c in matches):\n            raise ValueError('GCB DOCX/XLSX source mismatch: '+r['gcb_id'])\n        out[n] = dict(r, configuration_method=matches[0][-2])\n    if set(out) != ADDED:\n        raise ValueError('incomplete P2B9 source set')\n    return out\n\n\ndef script(n, key=None):\n    runtime = inspect.getsource(p2b9_runtime)\n    return runtime + '\\ntry:\\n    value = check(' + repr(n) + ', ' + repr(key) + \")\\nexcept (OSError, ValueError, UnicodeError, subprocess.SubprocessError):\\n    value = None\\nif value is not None:\\n    print('PASS') if value == 'PASS' else print(value)\\n\"\n\n\n@lru_cache(maxsize=1)\ndef rules():\n    out = {}\n    for n, row in sources().items():\n        keys = list(dict.fromkeys(re.findall(r'(?m)^net[.][a-zA-Z0-9_.]+(?=\\s*=)', row['configuration_method'])))\n        if n in (119,120,121,123):\n            keys = list(dict.fromkeys(re.findall(r'sysctl -w (net[.][a-zA-Z0-9_.]+)=', row['configuration_method'])))\n            keys = [k for k in keys if not k.endswith('.route.flush')]\n        if n <= 125 and not keys:\n            raise ValueError('missing source key')\n        out[n] = [('c:/usr/bin/python3 -c '+quote_argument(script(n,k)), '^'+row['expected']+'$') for k in keys] if n <= 125 else [('c:/usr/bin/python3 -c '+quote_argument(script(n)), '^PASS$')]\n    return out\n\n\ndef caveat(n):\n    if n <= 125:\n        note = '逐一精確來源 key，查 /etc/sysctl.conf 與 /etc/sysctl.d/*.conf，所有有效宣告須一致；數值於規則層等值判定。不讀 /proc/sys；sysctl -w 與 route.flush 為來源修復步驟，不執行。'\n        if n in (119,120,121,123):\n            note += '來源清理命令另含 /usr/lib/sysctl.d 與 /run/sysctl.d，故同時查這兩處有無衝突；不模擬載入優先序。'\n    elif n <= 129:\n        note = '精確 install 模組 /bin/true 與 blacklist 模組；不豁免不存在模組；重新開機及載入狀態待真機。'\n    elif n == 130:\n        note = '若 nmcli 存在，以 nmcli -t -f WIFI,WWAN radio all 唯讀查軟體 WIFI 與 WWAN 均 disabled；否則以 sysfs wireless 找 module 並檢查來源 install/blacklist。無無線對象不提交 PASS，適用性待批。'\n    else:\n        note = '依來源用 ip link 唯讀輸出，任一行不分大小寫含 promisc 即失敗；空輸出、缺介面、stderr、非零或逾時不提交 PASS；不執行來源 ip link set。'\n    return note + ' P2B9 UNVALIDATED；human_review_pending；execution_review=blocked；來源與引擎語意待批。'\n\"\"\"固定來源、候選範圍與保守分類。\"\"\"\nimport hashlib\nimport json\nfrom pathlib import Path\nfrom scripts.inventory import extract\nfrom .batch1 import ADDED\nfrom .quality import status\nfrom .batch3 import ADDED as BATCH3\nfrom .batch6 import ADDED as BATCH6\nfrom .batch9 import ADDED as BATCH9\nfrom .batch8 import ADDED as BATCH8\nfrom .batch7 import ADDED as BATCH7\nfrom .batch2 import ADDED as BATCH2\n\nROOT = Path(__file__).resolve().parents[1]\nXLSX_HASH = '7d752b639a1e780df08814c6252efadd3ea2711eaa5c9d91c070b84a296c0247'\nDOCX_HASH = '986effd9501b1fd97776129c6691cf8fc98246bd04514347322f3337508e0e5b'\nIMPLEMENTED = {45: 'base', 46: 'base', 108: 'base', 243: 'firewalld',\n               245: 'firewalld', 269: 'sshd', 270: 'sshd'}\nIMPLEMENTED.update({n: ('sshd' if n in (256,257) else 'firewalld' if n==242 else 'base') for n in ADDED})\nIMPLEMENTED.update({n: ('sshd' if n >= 254 else 'base') for n in BATCH2})\nIMPLEMENTED.update({n: 'base' for n in BATCH3})\nIMPLEMENTED.update({n: 'base' for n in BATCH6})\nIMPLEMENTED.update({n: 'base' for n in BATCH7})\nIMPLEMENTED.update({n: 'base' for n in BATCH8})\nIMPLEMENTED.update({n: 'base' for n in BATCH9})\nPARTIAL = {141: '僅來源設定方法明列 audit.rules；其餘 rules.d 規則檔集合尚未覆蓋',\n           108: '僅雙協定即時值；持久設定來源、覆寫順序與路由角色待審',\n           269: '僅 sshd -T 預設情境；Include/Match 與使用者/來源矩陣待審',\n           270: '僅 sshd -T 預設情境；Include/Match 與使用者/來源矩陣待審'}\n\n\ndef digest(path):\n    return hashlib.sha256(path.read_bytes()).hexdigest()\n\n\ndef registry():\n    source = next(ROOT.glob('*.xlsx'))\n    docx = next(ROOT.glob('*.docx'))\n    if digest(source) != XLSX_HASH or digest(docx) != DOCX_HASH:\n        raise ValueError('來源 hash 改變，停止產生')\n    records = extract(source)\n    result = []\n    for r in records:\n        n = int(r['gcb_id'][-4:])\n        included = r['sheet'] != 'Nftables防火牆'\n        profile = ('firewalld' if r['sheet'] == 'Firewalld防火牆' else\n                   'sshd' if r['sheet'] == 'SSH伺服器' else 'base')\n        if n in IMPLEMENTED:\n            classification, why = 'native_sca', '候選唯讀原生命令；完整語意與引擎驗收待人工審查'\n        elif profile != 'base' or any(k in r['title'] for k in ('GUI', '無線', '可攜', 'NFS')):\n            classification, why = 'conditional', '須先確認角色、服務與適用性，再選擇實作方式'\n        elif any(k in r['title'] for k in ('權限', '所有權', '擁有', '稽核', '密碼', '通行碼')):\n            classification, why = 'readonly_helper', '可能涉及集合、位元或載入鏈解析；尚未實作 helper'\n        else:\n            classification, why = 'manual_review', '尚未逐條語意審查，保守列人工待辦，非不可自動化結論'\n        result.append(dict(gcb_id=r['gcb_id'], source_file=r['source_file'],\n            source_sheet=r['sheet'], source_row=r['row'], source_sha256=XLSX_HASH,\n            category=r['category'], title=r['title'], expected=r['expected'],\n            included=included, scope_reason='候選，仍須主機適用性核准' if included else '明確排除 Nftables 工作表',\n            sca_id=900000+n, profile=profile, proposed_classification=classification,\n            justification=why, review_status='human_review_pending',\n            implementation='candidate' if n in IMPLEMENTED else 'pending' if included else 'excluded',\n            policy_id='linuxgcb_rhel9_'+IMPLEMENTED[n]+'_v01' if n in IMPLEMENTED else None,\n            coverage='partial' if n in PARTIAL else 'full' if n in IMPLEMENTED else 'unimplemented',\n            live_validation='UNVALIDATED', execution_review='pending',\n            pending=PARTIAL.get(n, '' if n in IMPLEMENTED else '未實作；待逐條 DOCX 語意審查')))\n        if n in IMPLEMENTED:\n            result[-1].update(status(n))\n    if (len(result), sum(r['included'] for r in result), len({r['sca_id'] for r in result}),\n        len({r['gcb_id'] for r in result})) != (314, 307, 314, 314):\n        raise ValueError('範圍或唯一性不符')\n    return result\n\n\ndef write_registry():\n    rows = registry()\n    (ROOT/'data/scope_registry.json').write_text(json.dumps(rows, ensure_ascii=False, indent=2)+'\\n')\n    return rows\n\"\"\"可重建的逐項來源對照與涵蓋 manifest；不執行候選命令。\"\"\"\nimport json\nfrom collections import Counter\nfrom zipfile import ZipFile\nfrom xml.etree import ElementTree as ET\nfrom .catalog import ROOT, registry, digest\nfrom .batch1 import ADDED, caveat\nfrom .quality import status\nfrom .batch3 import ADDED as BATCH3, caveat as batch3_caveat, mechanism as batch3_mechanism, sources as batch3_sources\nfrom .batch2 import ADDED as BATCH2, caveat as batch2_caveat\n\nfrom .batch6 import ADDED as BATCH6, caveat as batch6_caveat, sources as batch6_sources\n\nfrom .batch7 import ADDED as BATCH7, caveat as batch7_caveat, sources as batch7_sources\n\nfrom .batch9 import ADDED as BATCH9, caveat as batch9_caveat, sources as batch9_sources\nfrom .batch8 import ADDED as BATCH8, caveat as batch8_caveat, sources as batch8_sources\n\ndef manifest():\n    ns={'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}\n    docx=next(ROOT.glob('*.docx'))\n    xml=ET.fromstring(ZipFile(docx).read('word/document.xml'))\n    # ID 的 runs 必須在段落內接回，cell 再以換行串接段落。\n    tables=[]\n    for tr in xml.findall('.//w:tr',ns):\n        cells=['\\n'.join(''.join(t.text or '' for t in p.findall('.//w:t',ns))\n                         for p in cell.findall('.//w:p',ns)) for cell in tr.findall('w:tc',ns)]\n        tables.append(cells)\n    entries=[]\n    for row in registry():\n        n=row['sca_id']-900000\n        if row['implementation'] != 'candidate': continue\n        matches=[c for c in tables if row['gcb_id'] in c]\n        historical=[]\n        if n in BATCH9:\n            method=batch9_sources()[n]['configuration_method']\n            historical=[c for c in matches if c[-2] != method or c[-1] != row['expected']]\n            matches=[c for c in matches if c[-2] == method and c[-1] == row['expected']]\n        elif n in BATCH8:\n            method=batch8_sources()[n]['configuration_method']\n            historical=[c for c in matches if c[-2] != method or c[-1] != row['expected']]\n            matches=[c for c in matches if c[-2] == method and c[-1] == row['expected']]\n        elif n in BATCH7:\n            method=batch7_sources()[n]['configuration_method']\n            historical=[c for c in matches if c[-2] != method or c[-1] != row['expected']]\n            matches=[c for c in matches if c[-2] == method and c[-1] == row['expected']]\n        elif n in BATCH6:\n            method=batch6_sources()[n]['configuration_method']\n            historical=[c for c in matches if c[-2] != method or c[-1] != row['expected']]\n            matches=[c for c in matches if c[-2] == method and c[-1] == row['expected']]\n        elif n in BATCH3:\n            method=batch3_sources()[n]['configuration_method']\n            historical=[c for c in matches if c[-2] != method or c[-1] != row['expected']]\n            matches=[c for c in matches if c[-2] == method and c[-1] == row['expected']]\n        elif n in BATCH2:\n            historical=[c for c in matches if c[-1] != row['expected']]\n            matches=[c for c in matches if c[-1] == row['expected']]\n        if not matches or any(c[-2:] != matches[0][-2:] for c in matches) or row['expected'] not in matches[0]:\n            raise ValueError('DOCX ID／期望欄無法唯一核對：'+row['gcb_id'])\n        entries.append(dict(gcb_id=row['gcb_id'],sca_id=row['sca_id'],\n            source_sheet=row['source_sheet'],source_row=row['source_row'],expected=row['expected'],\n            docx_historical_cells=historical,docx_cells=matches[0],docx_occurrences=len(matches),docx_all_cells=matches,docx_sha256=digest(docx),\n            mechanism=('P2B9 direct Python argv source predicates' if n in BATCH9 else 'P2B8 direct Python argv source predicates' if n in BATCH8 else 'P2B7 direct Python argv source predicates' if n in BATCH7 else 'P2B6 direct Python argv source predicates' if n in BATCH6 else batch3_mechanism(n) if n in BATCH3 else 'BATCH2 c: shell 成功輸出保護、正向/否定逐行 PCRE2、all 聚合' if n in BATCH2 else '原生 c: 絕對路徑、正向逐行 PCRE2、all 聚合；無 shell'),\n            caveats=batch9_caveat(n) if n in BATCH9 else batch8_caveat(n) if n in BATCH8 else batch7_caveat(n) if n in BATCH7 else batch6_caveat(n) if n in BATCH6 else batch3_caveat(n) if n in BATCH3 else batch2_caveat(n) if n in BATCH2 else caveat(n) if n in ADDED else row['pending'],tests=[('tests/test_p2b9.py#' if n in BATCH9 else 'tests/test_p2b8.py#' if n in BATCH8 else 'tests/test_p2b7.py#' if n in BATCH7 else 'tests/test_p2b6.py#' if n in BATCH6 else 'tests/fixtures/p2b3/cases.json#' if n in BATCH3 else 'tests/fixtures/rule_outputs.json#')+str(row['sca_id']), 'tests/test_p2b9.py' if n in BATCH9 else 'tests/test_p2b8.py' if n in BATCH8 else 'tests/test_p2b7.py' if n in BATCH7 else 'tests/test_p2b6.py' if n in BATCH6 else 'tests/test_p2b3.py' if n in BATCH3 else 'tests/test_batch2.py' if n in BATCH2 else 'tests/test_quality_q1.py'],\n            cases=(['isolated_positive','isolated_negative','missing_no_commit','argv_roundtrip'] if n in BATCH6 | BATCH7 | BATCH8 | BATCH9 else ['positive','negative','missing','empty','error','nonzero_matching'])+(['commented'] if n in BATCH3 and (148 <= n <= 173 or n==145) else [])+(['rpm_other_error'] if n in (92,96,99,100) else []),\n            review_status='human_review_pending',**status(n)))\n        if n in BATCH8 and 20 <= n <= 28:\n            entries[-1]['cases'] += ['absence_review', 'conditional_negative']\n    rows=registry();counts=Counter(r['implementation'] for r in rows)\n    return dict(schema_version=2,label='離線候選涵蓋；非實機證據',\n        counts=dict(source=len(rows),included=sum(r['included'] for r in rows),excluded=counts['excluded'],\n                    before=7,batch9_before=282,batch9_added=23,batch9_after=305,batch8_before=236,batch8_added=46,batch8_after=282,added=len(BATCH9)+len(BATCH8)+len(ADDED)+len(BATCH2)+len(BATCH3)+len(BATCH6)+len(BATCH7),batch7_before=188,batch7_added=48,batch7_after=236,batch6_before=146,batch6_added=42,batch6_after=188,batch3_added=len(BATCH3),batch3_before=97,batch3_after=97+len(BATCH3),batch2_added=len(BATCH2),implemented=counts['candidate'],remaining=counts['pending'],\n                    full=sum(r['coverage']=='full' for r in rows),partial=sum(r['coverage']=='partial' for r in rows),\n                    blocked=sum(r['coverage']=='blocked' for r in rows),reviewed=len(entries),execution_blocked=len(entries),live_validated=0),\n        reviewed=entries)\n\ndef write():\n    m=manifest()\n    (ROOT/'data/coverage_manifest.json').write_text(json.dumps(m,ensure_ascii=False,indent=2)+'\\n')\n    return m\n\"\"\"Q1 離線審查結論；只涵蓋原有 53 ID，非來源或真機核准。\"\"\"\nfrom .batch1 import FILES, PACKAGES, SERVICES\nfrom .batch3 import ADDED as BATCH3, caveat as batch3_caveat\nfrom .batch2 import ADDED as BATCH2, caveat as batch2_caveat\n\nfrom .batch6 import ADDED as BATCH6, caveat as batch6_caveat\n\nfrom .batch7 import ADDED as BATCH7, caveat as batch7_caveat\n\nfrom .batch9 import ADDED as BATCH9, caveat as batch9_caveat\nfrom .batch8 import ADDED as BATCH8, caveat as batch8_caveat\n\nABSENCE_PENDING = {30,94,97,98,245}\n\ndef findings(n):\n    issues = ['Q1-01']  # 非零但匹配 stdout，無已核准的原生執行狀態保護\n    if n in FILES or n in (45,46): issues += ['Q1-03','Q1-04']\n    if n in range(53,61) or n in (141,178,191,192): issues += ['Q1-05']\n    if n in SERVICES or n in (243,245): issues += ['Q1-06']\n    if n in ABSENCE_PENDING: issues += ['Q1-07']\n    if n in (108,141,269,270): issues += ['Q1-08']\n    return issues\n\ndef family(n):\n    if n in FILES or n in (45,46): return '檔案 metadata'\n    if n in PACKAGES: return 'RPM 存在'\n    if n in SERVICES or n in (243,245): return 'systemd 服務'\n    if n == 108: return 'sysctl 即時值'\n    return 'SSH 預設有效設定'\n\ndef status(n):\n    if n in BATCH9:\n        return dict(offline_review='completed_with_findings', execution_review='blocked',\n                    coverage='partial', issue_ids=['B9-ENGINE', 'B9-SOURCE'],\n                    family='P2B9 embedded read-only', source_approval='pending',\n                    live_validation='UNVALIDATED', pending=batch9_caveat(n))\n    if n in BATCH8:\n        return dict(offline_review='completed_with_findings', execution_review='blocked',\n                    coverage='partial', issue_ids=['B8-ENGINE', 'B8-SOURCE'],\n                    family='P2B8 embedded read-only', source_approval='pending',\n                    live_validation='UNVALIDATED', pending=batch8_caveat(n))\n    if n in BATCH7:\n        return dict(offline_review='completed_with_findings', execution_review='blocked',\n                    coverage='partial', issue_ids=['B7-ENGINE', 'B7-SOURCE'],\n                    family='P2B7 embedded read-only', source_approval='pending',\n                    live_validation='UNVALIDATED', pending=batch7_caveat(n))\n    if n in BATCH6:\n        return dict(offline_review=\"completed_with_findings\", execution_review=\"blocked\",\n                    coverage=\"partial\", issue_ids=[\"B6-ENGINE\", \"B6-SCOPE\"],\n                    family=\"P2B6 embedded read-only\", source_approval=\"pending\",\n                    live_validation=\"UNVALIDATED\", pending=batch6_caveat(n))\n    if n in BATCH3:\n        return dict(offline_review='completed_with_findings', execution_review='blocked',\n                    coverage='partial', issue_ids=['B3-ENGINE', 'B3-SCOPE'],\n                    family='P2B3 embedded read-only', source_approval='pending',\n                    live_validation='UNVALIDATED', pending=batch3_caveat(n))\n    if n in BATCH2:\n        return dict(offline_review='completed_with_findings', execution_review='blocked',\n                    coverage='partial', issue_ids=['B2-ENGINE', 'B2-SCOPE'],\n                    family='BATCH2 guarded read-only', source_approval='pending',\n                    live_validation='UNVALIDATED', pending=batch2_caveat(n))\n    return dict(offline_review='completed_with_findings',\n                execution_review='blocked',\n                coverage='blocked' if n in ABSENCE_PENDING else 'partial',\n                issue_ids=findings(n), family=family(n),\n                source_approval='pending', live_validation='UNVALIDATED')\n\"\"\"以 JSON（YAML 1.2 子集）產生候選 SCA；只模擬輸出匹配，不執行命令。\"\"\"\nimport json\nimport re\nfrom functools import lru_cache\nfrom .catalog import ROOT, registry, digest\nfrom .batch1 import rules as batch_rules, disabled_service_rules\nfrom .expected import PREFIX, values, parse_description\nfrom .batch2 import rules as batch2_rules, ADDED as BATCH2\nfrom .batch3 import rules as batch3_rules, ADDED as BATCH3\nfrom .batch6 import rules as batch6_rules, ADDED as BATCH6\nfrom .batch7 import rules as batch7_rules, ADDED as BATCH7\nfrom .batch9 import ADDED as BATCH9, rules as batch9_rules\nfrom .batch8 import rules as batch8_rules, ADDED as BATCH8\nfrom .argv import w_strtok\n\n\ndef definitions():\n    modes = '|'.join(format(n, 'o') for n in range(0o1000) if n & ~0o644 == 0)\n    return {**batch_rules(), **batch2_rules(), **batch3_rules(), **batch6_rules(), **batch7_rules(), **batch8_rules(), **batch9_rules(),\n        45: [('c:/usr/bin/stat -c %u:%g /etc/passwd', '^0:0$')],\n        46: [('c:/usr/bin/stat -c %a /etc/passwd', '^('+modes+')$')],\n        108: [('c:/usr/sbin/sysctl -n net.ipv4.ip_forward', '^0$'),\n              ('c:/usr/sbin/sysctl -n net.ipv6.conf.all.forwarding', '^0$')],\n        243: [('c:/usr/bin/systemctl show firewalld.service --property=LoadState', '^LoadState=loaded$'),\n              ('c:/usr/bin/systemctl show firewalld.service --property=ActiveState', '^ActiveState=active$'),\n              ('c:/usr/bin/systemctl show firewalld.service --property=UnitFileState', '^UnitFileState=enabled$')],\n        245: disabled_service_rules('nftables'),\n        269: [('c:/usr/sbin/sshd -T', '^permitrootlogin no$')],\n        270: [('c:/usr/sbin/sshd -T', '^permitemptypasswords no$')],\n    }\n\n\ndef build():\n    rows = registry()\n    expected = values()\n    for profile in ('base', 'firewalld', 'sshd'):\n        filename = 'linuxgcb_'+profile+'.yml'\n        checks = []\n        for row in rows:\n            if row['implementation'] != 'candidate' or row['profile'] != profile:\n                continue\n            checks.append(dict(id=row['sca_id'], title=row['gcb_id']+' '+row['title'],\n                description=PREFIX+expected[row['gcb_id']]+(' ｜ P2B9 執行審查 ' if row['sca_id']-900000 in BATCH9 else ' ｜ P2B8 執行審查 ' if row['sca_id']-900000 in BATCH8 else ' ｜ P2B7 執行審查 ' if row['sca_id']-900000 in BATCH7 else ' ｜ P2B6 執行審查 ' if row['sca_id']-900000 in BATCH6 else ' ｜ P2B3 執行審查 ' if row['sca_id']-900000 in BATCH3 else ' ｜ BATCH2 執行審查 ' if row['sca_id']-900000 in BATCH2 else ' ｜ Q1 執行審查 ')+row['execution_review']+'；coverage='+row['coverage']+'；'+','.join(row['issue_ids'])+'；raw PASS 非已驗證符合。'+row['pending'],\n                compliance=[{'twgcb': [row['gcb_id']]}], regex_type='pcre2', condition='all',\n                rules=[emit_rule(target, pattern) for target, pattern in definitions()[int(row['gcb_id'][-4:])]]))\n        policy = dict(policy=dict(id='linuxgcb_rhel9_'+profile+'_v01', file=filename,\n                      name='RHEL9 GCB v1.2 '+profile+' v0.1 UNVALIDATED',\n                      description='未驗證候選政策；僅供核准 RHEL9 試點，非完整符合性檢核', regex_type='pcre2'),\n                      requirements=dict(title='僅 RHEL 9', description='角色由核准群組控制',\n                        condition='all', rules=['f:/etc/os-release -> r:^ID=\"?rhel\"?$',\n                                               'f:/etc/os-release -> r:^VERSION_ID=\"?9([.][0-9]+)*\"?$']),\n                      checks=checks)\n        (ROOT/'policies'/filename).write_text(json.dumps(policy, ensure_ascii=False, indent=2)+'\\n')\n    hashes = {p.name: digest(p) for p in sorted((ROOT/'policies').glob('*.yml'))}\n    (ROOT/'data/policy_hashes.json').write_text(json.dumps(hashes, indent=2)+'\\n')\n    from .coverage import write\n    write()\n    validate()\n\n\ndef require(condition):\n    if not condition:\n        raise ValueError('候選政策結構、mapping 或 hash 不符')\n\n\ndef validate():\n    rows = {r['sca_id']: r for r in registry()}\n    seen = set()\n    for path in sorted((ROOT/'policies').glob('*.yml')):\n        p = json.loads(path.read_text())\n        require(p['policy']['file'] == path.name and p['policy']['regex_type']=='pcre2')\n        require(p['requirements'] == dict(title='僅 RHEL 9', description='角色由核准群組控制',\n            condition='all', rules=['f:/etc/os-release -> r:^ID=\"?rhel\"?$',\n                                   'f:/etc/os-release -> r:^VERSION_ID=\"?9([.][0-9]+)*\"?$']))\n        for c in p['checks']:\n            require(c['id'] not in seen and rows[c['id']]['included'])\n            seen.add(c['id'])\n            require(parse_description(c.get('description')) == values()[rows[c['id']]['gcb_id']])\n            require((' ｜ P2B9 ' if c['id']-900000 in BATCH9 else ' ｜ P2B8 ' if c['id']-900000 in BATCH8 else ' ｜ P2B7 ' if c['id']-900000 in BATCH7 else ' ｜ P2B6 ' if c['id']-900000 in BATCH6 else ' ｜ P2B3 ' if c['id']-900000 in BATCH3 else ' ｜ BATCH2 ' if c['id']-900000 in BATCH2 else ' ｜ Q1 ') in c['description'])\n            require(c['regex_type'] == 'pcre2' and c['condition'] == 'all')\n            require(c['compliance'] == [{'twgcb': [rows[c['id']]['gcb_id']]}])\n            require(rows[c['id']]['policy_id'] == p['policy']['id'])\n            require(c['rules'] == [emit_rule(a,b) for a,b in definitions()[c['id']-900000]])\n            for rule in c['rules']:\n                target, _ = rule.split(' -> ', 1)\n                require(target.removeprefix('not ').startswith('c:/'))\n                if c['id']-900000 not in BATCH2 | BATCH3 | BATCH6 | BATCH7 | BATCH8 | BATCH9:\n                    require(not any(x in target for x in ('|',';', '&&', '$', '`')))\n                parse_rule(rule)\n    require(seen == {900000+n for n in definitions()})\n    hashes = json.loads((ROOT/'data/policy_hashes.json').read_text())\n    require(hashes == {p.name:digest(p) for p in (ROOT/'policies').glob('*.yml')})\n    from .coverage import manifest\n    require(json.loads((ROOT/'data/coverage_manifest.json').read_text()) == manifest())\n    require(seen == {r['sca_id'] for r in rows.values() if r['implementation']=='candidate'})\n    return len(seen)\n\n\n@lru_cache(maxsize=1)\ndef supported_patterns():\n    return frozenset(p.lstrip('!') for rules in definitions().values() for _,p in rules) | {\n        '^ID=\"?rhel\"?$', '^VERSION_ID=\"?9([.][0-9]+)*\"?$'}\n\n\ndef emit_rule(target, pattern):\n    return ('not '+target+' -> r:'+pattern[1:]) if pattern.startswith('!') else target+' -> r:'+pattern\n\n\n@lru_cache(maxsize=1)\ndef batch2_emitted():\n    return {emit_rule(t,p) for rules in batch2_rules().values() for t,p in rules}\n\n\n@lru_cache(maxsize=1)\ndef batch3_emitted():\n    return {emit_rule(t,p) for rules in batch3_rules().values() for t,p in rules}\n\n\ndef parse_rule(rule):\n    \"\"\"Legacy bounded grammar plus exact allowlist of BATCH2 emitted rules.\"\"\"\n    if not isinstance(rule, str):\n        raise ValueError('不支援的規則語法')\n    if rule in {emit_rule(t,p) for rs in [*batch6_rules().values(), *batch7_rules().values(), *batch8_rules().values(), *batch9_rules().values()] for t,p in rs}:\n        target, expression = rule.split(' -> ', 1)\n        argv = w_strtok(target[2:])\n        if len(argv) != 3 or argv[:2] != ['/usr/bin/python3', '-c']:\n            raise ValueError('Invalid Python argv')\n        return target, re.compile(expression.split(':',1)[1], re.ASCII)\n    if rule in batch2_emitted() or rule in batch3_emitted():\n        target, expression = rule.split(' -> ', 1)\n        argv = w_strtok(target.removeprefix('not ')[2:])\n        if len(argv) != 3 or argv[:2] != ['/bin/sh', '-c']:\n            raise ValueError('Invalid wm_exec shell argv')\n        return target.removeprefix('not '), re.compile(expression.split(':',1)[1], re.ASCII)\n    if rule.count(' -> r:') != 1:\n        raise ValueError('不支援的規則語法')\n    target, pattern = rule.split(' -> r:')\n    if not re.fullmatch(r'[cf]:/[^\\n\\r]+', target) or any(x in target for x in (' -> ', ' && ', '|', ';', '`', '$')):\n        raise ValueError('不支援的目標')\n    if pattern not in supported_patterns() and not re.fullmatch(r'\\^[A-Za-z0-9_ =:/-]+\\$', pattern):\n        raise ValueError('未驗證的 PCRE2 語法')\n    try:\n        return target, re.compile(pattern, re.ASCII)\n    except re.error as exc:\n        raise ValueError('無效模式') from exc\n\n\ndef simulate(check, observations):\n    \"\"\"僅輸出匹配模型；執行失敗資訊不足回 UNRESOLVED，不冒充 Wazuh。\n\n    FIX-3 模擬 OS_StrBreak 的前 256 行上限（wm_sca.c:1749）。\n    FIX-1 同一 command 的多行輸出仍按逐行存在匹配；alternation 是單一\n    正向 regex，規則間維持 all，不以空輸出或 stderr 推論 not-found。\n    所有項目 exit_code 不參與輸出匹配（wm_exec 正常結束仍回 0），\n    並以 emitted shell guard 確保失敗不發布輸出或成功標記。\n","exit_code":0,"status":"completed"}}

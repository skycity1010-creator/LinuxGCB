{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom scripts.inventory import extract\nfrom pathlib import Path\nfor r in extract(next(Path('.').glob('*.xlsx'))):\n if r['gcb_id'].endswith(('0244','0246')): print(r)\nPY\nhead -40 tests/test_catalog_policy.py; head -35 tests/test_quality_q1.py; cat linuxgcb/__main__.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom scripts.inventory import extract\nfrom pathlib import Path\nfor r in extract(next(Path('.').glob('*.xlsx'))):\n if r['gcb_id'].endswith(('0244','0246')): print(r)\nPY\nhead -40 tests/test_catalog_policy.py; head -35 tests/test_quality_q1.py; cat linuxgcb/__main__.py\"","aggregated_output":"{'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'Firewalld防火牆', 'row': 7, 'ordinal': '3', 'gcb_id': 'TWGCB-01-012-0244', 'category': 'Firewalld配置', 'title': 'iptables服務', 'description': '這項原則設定決定是否啟用iptables與ip6tables服務\\niptables與ip6tables為Linux作業系統本機端防火牆，藉由控制Linux核心之netfilter模組，進行封包過濾與處理\\n同時運行firewalld與iptables(或ip6tables)服務，可能因彼此間之規則衝突，導致系統運作異常或產生資安風險，因此在使用firewalld時，建議停用並遮蔽iptables與ip6tables服務', 'configuration_method': '開啟終端機，執行以下指令，停用並遮蔽iptables與ip6tables服務： \\n#systemctl --now mask iptables\\n#systemctl --now mask ip6tables', 'expected': '停用', 'implementation_status': 'unreviewed'}\n{'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'Firewalld防火牆', 'row': 9, 'ordinal': '5', 'gcb_id': 'TWGCB-01-012-0246', 'category': 'Firewalld配置', 'title': 'firewalld防火牆預設區域', 'description': '這項原則設定決定是否設定防火牆預設區域\\n防火牆區域定義了網路連線、介面或來源位址綁定之信任等級，這是一對多關係，意謂著網路連線、介面或來源位址只是區域中的一部分，但一個區域可包含多個網路連線、介面或來源位址\\n所有未明確分配給特定區域之網路連線、介面或來源位址，都將被歸至預設區域\\n設定預設區域，可確保所有網路連線、介面或來源位址皆被納管，以保護系統安全', 'configuration_method': '開啟終端機，執行以下指令設定預設區域：\\n#firewall-cmd --set-default-zone=(區域名稱)\\n設定預設區域為public之範例如下:\\n#firewall-cmd --set-default-zone=public', 'expected': '須設定預設區域', 'implementation_status': 'unreviewed'}\nfrom linuxgcb.batch9 import ADDED as BATCH9\nfrom linuxgcb.batch8 import ADDED as BATCH8\nfrom linuxgcb.batch7 import ADDED as BATCH7\nfrom linuxgcb.batch6 import ADDED as BATCH6\nimport json\nimport unittest\nfrom pathlib import Path\nfrom linuxgcb.catalog import ROOT, registry, digest, XLSX_HASH\nfrom linuxgcb.policy import validate, simulate, definitions\nfrom linuxgcb.batch1 import FILES, ADDED\nfrom linuxgcb.coverage import manifest\nfrom linuxgcb.batch3 import ADDED as BATCH3\nfrom linuxgcb.batch2 import ADDED as BATCH2\nfrom scripts.inventory import extract\n\n\nclass CatalogTests(unittest.TestCase):\n    def test_scope_and_source_unchanged(self):\n        rows = registry()\n        self.assertEqual((len(rows), sum(r['included'] for r in rows)), (314,307))\n        self.assertEqual(len({r['sca_id'] for r in rows}),314)\n        self.assertEqual(len({r['gcb_id'] for r in rows}),314)\n        self.assertEqual({r['source_sheet'] for r in rows if not r['included']}, {'Nftables防火牆'})\n        self.assertTrue(next(r for r in rows if r['sca_id']==900245)['included'])\n        self.assertFalse(any(r['gcb_id'].endswith('-0180') for r in rows))\n        self.assertEqual(digest(next(ROOT.glob('*.xlsx'))), XLSX_HASH)\n        self.assertEqual(rows,json.loads((ROOT/'data/scope_registry.json').read_text()))\n\n    def test_raw_controls_unchanged(self):\n        self.assertEqual(extract(next(ROOT.glob('*.xlsx'))),json.loads((ROOT/'data/controls.json').read_text()))\n\n    def test_traceability(self):\n        source = {r['gcb_id']:r for r in extract(next(ROOT.glob('*.xlsx')))}\n        for r in registry():\n            self.assertEqual(r['source_row'],source[r['gcb_id']]['row'])\n            self.assertEqual(r['expected'],source[r['gcb_id']]['expected'])\n            self.assertEqual(r['review_status'],'human_review_pending')\n\n    def test_structural(self):\n        self.assertEqual(validate(),len(definitions()))\nfrom linuxgcb.batch9 import ADDED as BATCH9\nfrom linuxgcb.batch8 import ADDED as BATCH8\nfrom linuxgcb.batch7 import ADDED as BATCH7\nfrom linuxgcb.batch6 import ADDED as BATCH6\n\"\"\"SYNTHETIC Q1 回歸；不執行任何政策命令。\"\"\"\nimport copy\nimport json\nimport stat\nimport tempfile\nimport unittest\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom linuxgcb.catalog import ROOT, registry\nfrom linuxgcb.batch3 import ADDED as BATCH3\nfrom linuxgcb.batch2 import ADDED as BATCH2\nfrom linuxgcb.policy import simulate, definitions\nfrom linuxgcb.report import normalize, metrics, render\n\nNOW = datetime(2026,10,30,tzinfo=timezone.utc)\n\nclass QualityQ1Tests(unittest.TestCase):\n    def check(self, n):\n        return dict(condition='all', regex_type='pcre2',\n                    rules=[a+' -> r:'+b for a,b in definitions()[n]])\n\n    def snapshot(self):\n        snapshot=json.loads((ROOT/'tests/fixtures/snapshot.json').read_text())\n        # Test-only hash binding; historical observations remain unchanged on disk.\n        snapshot['policy_hashes']=json.loads((ROOT/'data/policy_hashes.json').read_text())\n        return snapshot\n\n    def test_reject_unsupported_conditions_even_when_matching(self):\n        for condition in ('any','none','ALL',''):\n            with self.subTest(condition=condition), self.assertRaises(ValueError):\n                simulate(dict(condition=condition,rules=['c:/SYNTHETIC -> r:^good$']), {})\n\"\"\"python3 -m linuxgcb：完全離線，不執行 SCA 命令。\"\"\"\nimport argparse\nimport json\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom .catalog import write_registry\nfrom .policy import build, validate\nfrom .report import render\nfrom .collector import timestamp\nfrom .snapshot import convert\n\n\ndef main():\n    parser = argparse.ArgumentParser(description='LinuxGCB 離線工具（未完成真機驗收）')\n    sub = parser.add_subparsers(dest='command', required=True)\n    sub.add_parser('build', help='驗證來源並重建 registry 與候選政策')\n    sub.add_parser('validate', help='離線結構與來源檢查，非引擎驗收')\n    report = sub.add_parser('report', help='匯入離線 JSON，輸出 HTML/CSV 與稽核副本')\n    report.add_argument('snapshot')\n    report.add_argument('--out', required=True)\n    report.add_argument('--now', help='固定報表時間，ISO8601 含時區')\n    snapshot = sub.add_parser('snapshot', help='離線 Manager DB JSON 轉 snapshot v1')\n    snapshot.add_argument('manager_dump')\n    snapshot.add_argument('--out', required=True)\n    snapshot.add_argument('--scan-info', help='同次離線 sca_scan_info JSON，依 policy_id 對應 end_scan')\n    args = parser.parse_args()\n    if args.command == 'build':\n        rows = write_registry()\n        build()\n        print(f'314 項；307 候選／7 排除；{validate()} 項候選規則，UNVALIDATED／人工審查待完成')\n    elif args.command == 'validate':\n        print('UNVALIDATED：離線結構檢查通過，候選控制項數', validate())\n    elif args.command == 'snapshot':\n        validate()\n        result = convert(args.manager_dump, json.loads(Path(args.scan_info).read_text()) if args.scan_info else None)\n        target = Path(args.out)\n        target.parent.mkdir(parents=True, exist_ok=True)\n        target.write_text(json.dumps(result, ensure_ascii=False, indent=2)+'\\n')\n        print(json.dumps(result['warnings'], ensure_ascii=False))\n    else:\n        validate()\n        result = render(json.loads(Path(args.snapshot).read_text()), args.out,\n                        timestamp(args.now) if args.now else datetime.now(timezone.utc))\n        print(json.dumps(result, ensure_ascii=False, indent=2))\n\nif __name__ == '__main__':\n    main()\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"agent_message","text":"來源有兩個關鍵細節：0244 要求同時停用並遮蔽 `iptables`、`ip6tables`；0246 明列 `public` 為設定範例，因此不能因區域是 public 就判失敗。我會以唯讀查詢驗證兩個服務均為 masked、inactive，以及預設區域有有效非空名稱，並在審查文件列明查詢方式與來源修復指令的對應，保留待批。\n"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"cat > linuxgcb/p2b10_runtime.py <<'PY'\n\\\"\\\"\\\"Read-only observations; no shell or service mutations.\\\"\\\"\\\"\nimport os\nimport re\nimport subprocess\n\n\ndef observe(argv, states):\n    result = subprocess.run(argv, capture_output=True, text=True, timeout=8,\n                            env=dict(os.environ, LC_ALL='C'))\n    value = result.stdout.strip()\n    return not result.stderr and (value, result.returncode) in states\n\n\ndef check(n):\n    if n == 244:\n        for service in ('iptables', 'ip6tables'):\n            if not observe(['/usr/bin/systemctl', 'is-enabled', service], {('masked', 1)}):\n                return False\n            if not observe(['/usr/bin/systemctl', 'is-active', service], {('inactive', 3)}):\n                return False\n        return True\n    if n == 246:\n        result = subprocess.run(['/usr/bin/firewall-cmd', '--get-default-zone'],\n                                capture_output=True, text=True, timeout=8,\n                                env=dict(os.environ, LC_ALL='C'))\n        return (result.returncode == 0 and not result.stderr and\n                re.fullmatch(r'[A-Za-z0-9_][A-Za-z0-9_-]*', result.stdout.strip()) is not None)\n    return False\nPY\npython3 - <<'PY'\nfrom pathlib import Path\ns=Path('linuxgcb/batch9.py').read_text()\ns=s[:s.index('def script(')]\ns=s.replace('P2B9','P2B10').replace('p2b9_runtime','p2b10_runtime').replace('set(range(109,132))','{244, 246}')\ns+='''def script(n):\n    return inspect.getsource(p2b10_runtime) + '\\\\\\\\ntry:\\\\\\\\n    ok = check(' + repr(n) + \\\")\\\\\\\\nexcept (OSError, ValueError, UnicodeError, subprocess.SubprocessError):\\\\\\\\n    ok = False\\\\\\\\nif ok:\\\\\\\\n    print('PASS')\\\\\\\\n\\\"\n\n\n@lru_cache(maxsize=1)\ndef rules():\n    sources()\n    return {n: [('c:/usr/bin/python3 -c '+quote_argument(script(n)), '\"'^PASS$'\"')] for n in sorted(ADDED)}\n\n\ndef caveat(n):\n    note = ('來源 --now mask 涵蓋 iptables 與 ip6tables；唯讀 is-enabled 須 masked/rc1，is-active 須 inactive/rc3；disabled 不等同遮蔽，缺服務不豁免。' if n == 244 else\n            '以 --get-default-zone 唯讀對應來源設定區域；有效非空區域名稱即可，public 為來源允許範例；不推論是否曾人工設定。')\n    return note + ' P2B10 UNVALIDATED；human_review_pending；execution_review=blocked；來源與引擎語意待批。'\n'''\nPath('linuxgcb/batch10.py').write_text(s)\nfor name in ['catalog','quality','coverage','policy']:\n p=Path('linuxgcb/'+name+'.py');s=p.read_text();s='from .batch10 import ADDED as BATCH10, rules as batch10_rules, caveat as batch10_caveat, sources as batch10_sources\\\\n'+s\n if name=='catalog': s=s.replace('PARTIAL =',\\\"IMPLEMENTED.update({n: 'firewalld' for n in BATCH10})\\\\nPARTIAL =\\\")\n if name=='quality': s=s.replace('    if n in BATCH9:', '''    if n in BATCH10:\n        return dict(offline_review='completed_with_findings', execution_review='blocked',\n                    coverage='partial', issue_ids=['B10-ENGINE', 'B10-SOURCE'],\n                    family='P2B10 embedded read-only', source_approval='pending',\n                    live_validation='UNVALIDATED', pending=batch10_caveat(n))\n    if n in BATCH9:''')\n if name=='coverage':\n  s=s.replace('        if n in BATCH9:', '''        if n in BATCH10:\n            method=batch10_sources()[n]['configuration_method']\n            historical=[c for c in matches if c[-2] \"'!= method or c[-1] != row['\"'expected']]\n            matches=[c for c in matches if c[-2] == method and c[-1] == row['expected']]\n        elif n in BATCH9:''')\n  s=s.replace(\\\"('P2B9 direct\\\", \\\"('P2B10 direct Python argv source predicates' if n in BATCH10 else 'P2B9 direct\\\")\n  s=s.replace('caveats=batch9_caveat(n)', 'caveats=batch10_caveat(n) if n in BATCH10 else batch9_caveat(n)')\n  s=s.replace(\\\"('tests/test_p2b9.py#'\\\", \\\"('tests/test_p2b10.py#' if n in BATCH10 else 'tests/test_p2b9.py#'\\\")\n  s=s.replace(\\\" 'tests/test_p2b9.py' if\\\", \\\" 'tests/test_p2b10.py' if n in BATCH10 else 'tests/test_p2b9.py' if\\\")\n  s=s.replace('BATCH8 | BATCH9 else','BATCH8 | BATCH9 | BATCH10 else').replace('before=7,batch9_before','before=7,batch10_before=305,batch10_added=2,batch10_after=307,batch9_before').replace('added=len(BATCH9)+','added=len(BATCH10)+len(BATCH9)+')\n if name=='policy':\n  s=s.replace('**batch9_rules(),','**batch9_rules(), **batch10_rules(),')\n  s=s.replace(\\\"(' ｜ P2B9 執行審查 '\\\",\\\"(' ｜ P2B10 執行審查 ' if row['sca_id']-900000 in BATCH10 else ' ｜ P2B9 執行審查 '\\\")\n  s=s.replace(\\\"(' ｜ P2B9 '\\\",\\\"(' ｜ P2B10 ' if c['id']-900000 in BATCH10 else ' ｜ P2B9 '\\\")\n  s=s.replace('BATCH8 | BATCH9:', 'BATCH8 | BATCH9 | BATCH10:').replace('*batch9_rules().values()]','*batch9_rules().values(), *batch10_rules().values()]')\n p.write_text(s)\n# Existing historical baseline exclusions include the new batch.\nfor p in Path('tests').glob('test_*.py'):\n s=p.read_text()\n if 'from linuxgcb.batch9 import ADDED as BATCH9' in s:\n  s=s.replace('from linuxgcb.batch9 import ADDED as BATCH9','from linuxgcb.batch9 import ADDED as BATCH9\\\\nfrom linuxgcb.batch10 import ADDED as BATCH10\\\\nBATCH9 = BATCH9 | BATCH10')\n # only count assertions, never control 0305\n s=s.replace(',305)',',307)').replace(', 305)',', 307)').replace(\\\"['implemented'],305)\\\",\\\"['implemented'],307)\\\")\n p.write_text(s)\nPY\npython3 -m linuxgcb build\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

elf.assertEqual(manifest['counts']['implemented'],282)\ntests/test_report.py:65:            lambda s:s['hosts'][0]['checks'].append(dict(id=900109,result='passed'))]\ntests/test_fix5.py:1:from linuxgcb.batch8 import ADDED as BATCH8\ntests/test_fix5.py:22:        self.assertEqual(len(current), 282)\ntests/test_fix5.py:38:                    self.assertEqual([r for r in prior if r['sca_id']-900000 not in BATCH6 | BATCH7 | BATCH8],\ntests/test_fix5.py:39:                                     [r for r in now if r['sca_id']-900000 not in BATCH6 | BATCH7 | BATCH8])\ntests/test_fix5.py:41:                    self.assertEqual(prior['reviewed'], [r for r in now['reviewed'] if r['sca_id']-900000 not in BATCH6 | BATCH7 | BATCH8])\ntests/test_expected.py:1:from linuxgcb.batch8 import ADDED as BATCH8\ntests/test_expected.py:23:        checks = [c for c in checks if c['id']-900000 not in BATCH2 | BATCH3 | BATCH6 | BATCH7 | BATCH8]\ntests/test_batch2.py:1:from linuxgcb.batch8 import ADDED as BATCH8\ntests/test_batch2.py:42:        self.assertEqual(len(self.checks),282)\ntests/test_batch2.py:48:            if row['sca_id'] not in before and row['category'] not in CATEGORIES and row['sca_id']-900000 not in BATCH3 | BATCH6 | BATCH7 | BATCH8:\ntests/test_quality_q1.py:1:from linuxgcb.batch8 import ADDED as BATCH8\ntests/test_quality_q1.py:83:        rows=[r for r in rows if r['sca_id']-900000 not in BATCH2 | BATCH3 | BATCH6 | BATCH7 | BATCH8]\ntests/test_catalog_policy.py:1:from linuxgcb.batch8 import ADDED as BATCH8\ntests/test_catalog_policy.py:50:                if c['id']-900000 in BATCH6 | BATCH7 | BATCH8:\ntests/test_catalog_policy.py:76:        self.assertEqual((m['counts']['full'],m['counts']['partial'],m['counts']['blocked']),(0,48+len(BATCH2)+len(BATCH3)+len(BATCH6)+len(BATCH7)+len(BATCH8),5))\ntests/fixtures/fix4_baseline.json:2460:      \"id\": 900282,\ntests/fixtures/fix4_baseline.json:2461:      \"title\": \"TWGCB-01-012-0282 shosts.equiv檔案\",\ntests/fixtures/fix4_baseline.json:2466:            \"TWGCB-01-012-0282\"\ntests/fixtures/p2b3/baseline.json:1628:      \"id\": 900282,\ntests/fixtures/p2b3/baseline.json:1629:      \"title\": \"TWGCB-01-012-0282 shosts.equiv檔案\",\ntests/fixtures/p2b3/baseline.json:1634:            \"TWGCB-01-012-0282\"\ntests/fix5_baseline.json:2460:      \"id\": 900282,\ntests/fix5_baseline.json:2461:      \"title\": \"TWGCB-01-012-0282 shosts.equiv檔案\",\ntests/fix5_baseline.json:2466:            \"TWGCB-01-012-0282\"\ntests/fixtures/batch2_baseline.json:980:    \"900178\": \"df96de4e746b20d03f68a04676c4356bbfe28255efb52ff01fefb79feae910de\",\ntests/fixtures/rule_outputs.json:5165:    \"900282\": {\ntests/fixtures/fix3_baseline.json:1688:      \"id\": 900282,\ntests/fixtures/fix3_baseline.json:1689:      \"title\": \"TWGCB-01-012-0282 shosts.equiv檔案\",\ntests/fixtures/fix3_baseline.json:1694:            \"TWGCB-01-012-0282\"\n","exit_code":0,"status":"completed"}}

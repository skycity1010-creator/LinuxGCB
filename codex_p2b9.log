{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc 'cat linuxgcb/batch8.py; cat linuxgcb/coverage.py; cat linuxgcb/policy.py'","aggregated_output":"\"\"\"P2B8 source-bound offline candidates, direct w_strtok Python argv.\"\"\"\nimport inspect\nimport hashlib\nfrom zipfile import ZipFile\nfrom xml.etree import ElementTree as ET\nfrom functools import lru_cache\nfrom pathlib import Path\nfrom . import p2b8_runtime, fix7_runtime\nfrom .argv import quote_argument\nADDED = set(range(1,30)) | {31} | set(range(285,301))\nfrom .p2b8_runtime import MODULES\n\n\n@lru_cache(maxsize=1)\ndef sources():\n    from scripts.inventory import extract\n    root = Path(__file__).resolve().parents[1]\n    docx = root/'docs/references/gcb-rhel9-v1.2.docx'\n    if hashlib.sha256(docx.read_bytes()).hexdigest() != '986effd9501b1fd97776129c6691cf8fc98246bd04514347322f3337508e0e5b':\n        raise ValueError('GCB v1.2 reference hash changed')\n    ns = {'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}\n    xml = ET.fromstring(ZipFile(docx).read('word/document.xml'))\n    tables = [['\\n'.join(''.join(t.text or '' for t in p.findall('.//w:t',ns))\n              for p in cell.findall('.//w:p',ns)) for cell in tr.findall('w:tc',ns)]\n              for tr in xml.findall('.//w:tr',ns)]\n    out = {}\n    for r in extract(next(root.glob('*.xlsx'))):\n        n = int(r['gcb_id'][-4:])\n        if n not in ADDED:\n            continue\n        matches = [c for c in tables if r['gcb_id'] in c and c[-1] == r['expected'] and c[-2] == r['configuration_method']]\n        if not matches or any(c[-2:] != matches[0][-2:] for c in matches):\n            raise ValueError('GCB DOCX/XLSX source mismatch: '+r['gcb_id'])\n        out[n] = dict(r, configuration_method=matches[0][-2])\n    if set(out) != ADDED:\n        raise ValueError('incomplete P2B8 source set')\n    return out\n\n\ndef script(n):\n    runtime = inspect.getsource(p2b8_runtime)\n    if n in {8,9,13,14,15,16,23,24,25}:\n        runtime += '\\n' + inspect.getsource(fix7_runtime.mountinfo) + '\\n' + inspect.getsource(fix7_runtime.independent)\n    return runtime + '\\ntry:\\n    ok = check(' + str(n) + \")\\nexcept (OSError, ValueError, IndexError, KeyError, subprocess.SubprocessError):\\n    ok = False\\nif ok is None:\\n    print('REVIEW')\\nelif ok:\\n    print('PASS')\\n\"\n\n\n@lru_cache(maxsize=1)\ndef rules():\n    return {n:[('c:/usr/bin/python3 -c ' + quote_argument(script(n)), '^PASS$|^REVIEW$')] for n in sorted(ADDED)}\n\n\ndef caveat(n):\n    if n in MODULES:\n        note = '精確 install 模組 /bin/true 與 blacklist 模組；不以模組不存在豁免；載入狀態與重新開機待真機。'\n    elif n in (8,9,13,14,15):\n        note = 'mountinfo 確認掛載點、裝置號不同於根與其他祖先、root=/，來源獨立裝置；bind/subpath 不算。'\n    elif n == 29:\n        note = '來源 df --local -P 逐本機磁區，find -xdev -type d -perm -0002 ! -perm -1000 -print -quit；24秒整體預算。'\n    elif 20 <= n <= 22:\n        note = '由 sysfs 裝置 removable 與父裝置辨識可攜式掛載；無對象或裝置無法分類輸出 REVIEW，並非符合或違規；USB 固定式及非 block 可攜式辨識待批。'\n    elif 23 <= n <= 25:\n        note = '來源 passwd UID>=1000 且非 nobody，只查家目錄本身獨立掛載；無對象輸出 REVIEW；以即時值取代來源 fstab 按任務要求，待批。'\n    elif 26 <= n <= 28:\n        note = '來源條件式 NFS；查即時 nfs/nfs4 掛載選項，無對象輸出 REVIEW；fstab 尚未掛載項之適用性另審。'\n    else:\n        note = '讀 /proc/mounts 精確掛載點、類型或完整 option token；缺掛載失敗；持久設定及生效差異待真機。'\n    return note + ' P2B8 UNVALIDATED；human_review_pending；execution_review=blocked；REVIEW 在輸出匹配層為 raw passed，但 coverage partial 且 blocked，必須人工判定適用性，不是已驗證 PASS。'\n\"\"\"可重建的逐項來源對照與涵蓋 manifest；不執行候選命令。\"\"\"\nimport json\nfrom collections import Counter\nfrom zipfile import ZipFile\nfrom xml.etree import ElementTree as ET\nfrom .catalog import ROOT, registry, digest\nfrom .batch1 import ADDED, caveat\nfrom .quality import status\nfrom .batch3 import ADDED as BATCH3, caveat as batch3_caveat, mechanism as batch3_mechanism, sources as batch3_sources\nfrom .batch2 import ADDED as BATCH2, caveat as batch2_caveat\n\nfrom .batch6 import ADDED as BATCH6, caveat as batch6_caveat, sources as batch6_sources\n\nfrom .batch7 import ADDED as BATCH7, caveat as batch7_caveat, sources as batch7_sources\n\nfrom .batch8 import ADDED as BATCH8, caveat as batch8_caveat, sources as batch8_sources\n\ndef manifest():\n    ns={'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}\n    docx=next(ROOT.glob('*.docx'))\n    xml=ET.fromstring(ZipFile(docx).read('word/document.xml'))\n    # ID 的 runs 必須在段落內接回，cell 再以換行串接段落。\n    tables=[]\n    for tr in xml.findall('.//w:tr',ns):\n        cells=['\\n'.join(''.join(t.text or '' for t in p.findall('.//w:t',ns))\n                         for p in cell.findall('.//w:p',ns)) for cell in tr.findall('w:tc',ns)]\n        tables.append(cells)\n    entries=[]\n    for row in registry():\n        n=row['sca_id']-900000\n        if row['implementation'] != 'candidate': continue\n        matches=[c for c in tables if row['gcb_id'] in c]\n        historical=[]\n        if n in BATCH8:\n            method=batch8_sources()[n]['configuration_method']\n            historical=[c for c in matches if c[-2] != method or c[-1] != row['expected']]\n            matches=[c for c in matches if c[-2] == method and c[-1] == row['expected']]\n        elif n in BATCH7:\n            method=batch7_sources()[n]['configuration_method']\n            historical=[c for c in matches if c[-2] != method or c[-1] != row['expected']]\n            matches=[c for c in matches if c[-2] == method and c[-1] == row['expected']]\n        elif n in BATCH6:\n            method=batch6_sources()[n]['configuration_method']\n            historical=[c for c in matches if c[-2] != method or c[-1] != row['expected']]\n            matches=[c for c in matches if c[-2] == method and c[-1] == row['expected']]\n        elif n in BATCH3:\n            method=batch3_sources()[n]['configuration_method']\n            historical=[c for c in matches if c[-2] != method or c[-1] != row['expected']]\n            matches=[c for c in matches if c[-2] == method and c[-1] == row['expected']]\n        elif n in BATCH2:\n            historical=[c for c in matches if c[-1] != row['expected']]\n            matches=[c for c in matches if c[-1] == row['expected']]\n        if not matches or any(c[-2:] != matches[0][-2:] for c in matches) or row['expected'] not in matches[0]:\n            raise ValueError('DOCX ID／期望欄無法唯一核對：'+row['gcb_id'])\n        entries.append(dict(gcb_id=row['gcb_id'],sca_id=row['sca_id'],\n            source_sheet=row['source_sheet'],source_row=row['source_row'],expected=row['expected'],\n            docx_historical_cells=historical,docx_cells=matches[0],docx_occurrences=len(matches),docx_all_cells=matches,docx_sha256=digest(docx),\n            mechanism=('P2B8 direct Python argv source predicates' if n in BATCH8 else 'P2B7 direct Python argv source predicates' if n in BATCH7 else 'P2B6 direct Python argv source predicates' if n in BATCH6 else batch3_mechanism(n) if n in BATCH3 else 'BATCH2 c: shell 成功輸出保護、正向/否定逐行 PCRE2、all 聚合' if n in BATCH2 else '原生 c: 絕對路徑、正向逐行 PCRE2、all 聚合；無 shell'),\n            caveats=batch8_caveat(n) if n in BATCH8 else batch7_caveat(n) if n in BATCH7 else batch6_caveat(n) if n in BATCH6 else batch3_caveat(n) if n in BATCH3 else batch2_caveat(n) if n in BATCH2 else caveat(n) if n in ADDED else row['pending'],tests=[('tests/test_p2b8.py#' if n in BATCH8 else 'tests/test_p2b7.py#' if n in BATCH7 else 'tests/test_p2b6.py#' if n in BATCH6 else 'tests/fixtures/p2b3/cases.json#' if n in BATCH3 else 'tests/fixtures/rule_outputs.json#')+str(row['sca_id']), 'tests/test_p2b8.py' if n in BATCH8 else 'tests/test_p2b7.py' if n in BATCH7 else 'tests/test_p2b6.py' if n in BATCH6 else 'tests/test_p2b3.py' if n in BATCH3 else 'tests/test_batch2.py' if n in BATCH2 else 'tests/test_quality_q1.py'],\n            cases=(['isolated_positive','isolated_negative','missing_no_commit','argv_roundtrip'] if n in BATCH6 | BATCH7 | BATCH8 else ['positive','negative','missing','empty','error','nonzero_matching'])+(['commented'] if n in BATCH3 and (148 <= n <= 173 or n==145) else [])+(['rpm_other_error'] if n in (92,96,99,100) else []),\n            review_status='human_review_pending',**status(n)))\n        if n in BATCH8 and 20 <= n <= 28:\n            entries[-1]['cases'] += ['absence_review', 'conditional_negative']\n    rows=registry();counts=Counter(r['implementation'] for r in rows)\n    return dict(schema_version=2,label='離線候選涵蓋；非實機證據',\n        counts=dict(source=len(rows),included=sum(r['included'] for r in rows),excluded=counts['excluded'],\n                    before=7,batch8_before=236,batch8_added=46,batch8_after=282,added=len(BATCH8)+len(ADDED)+len(BATCH2)+len(BATCH3)+len(BATCH6)+len(BATCH7),batch7_before=188,batch7_added=48,batch7_after=236,batch6_before=146,batch6_added=42,batch6_after=188,batch3_added=len(BATCH3),batch3_before=97,batch3_after=97+len(BATCH3),batch2_added=len(BATCH2),implemented=counts['candidate'],remaining=counts['pending'],\n                    full=sum(r['coverage']=='full' for r in rows),partial=sum(r['coverage']=='partial' for r in rows),\n                    blocked=sum(r['coverage']=='blocked' for r in rows),reviewed=len(entries),execution_blocked=len(entries),live_validated=0),\n        reviewed=entries)\n\ndef write():\n    m=manifest()\n    (ROOT/'data/coverage_manifest.json').write_text(json.dumps(m,ensure_ascii=False,indent=2)+'\\n')\n    return m\n\"\"\"以 JSON（YAML 1.2 子集）產生候選 SCA；只模擬輸出匹配，不執行命令。\"\"\"\nimport json\nimport re\nfrom functools import lru_cache\nfrom .catalog import ROOT, registry, digest\nfrom .batch1 import rules as batch_rules, disabled_service_rules\nfrom .expected import PREFIX, values, parse_description\nfrom .batch2 import rules as batch2_rules, ADDED as BATCH2\nfrom .batch3 import rules as batch3_rules, ADDED as BATCH3\nfrom .batch6 import rules as batch6_rules, ADDED as BATCH6\nfrom .batch7 import rules as batch7_rules, ADDED as BATCH7\nfrom .batch8 import rules as batch8_rules, ADDED as BATCH8\nfrom .argv import w_strtok\n\n\ndef definitions():\n    modes = '|'.join(format(n, 'o') for n in range(0o1000) if n & ~0o644 == 0)\n    return {**batch_rules(), **batch2_rules(), **batch3_rules(), **batch6_rules(), **batch7_rules(), **batch8_rules(),\n        45: [('c:/usr/bin/stat -c %u:%g /etc/passwd', '^0:0$')],\n        46: [('c:/usr/bin/stat -c %a /etc/passwd', '^('+modes+')$')],\n        108: [('c:/usr/sbin/sysctl -n net.ipv4.ip_forward', '^0$'),\n              ('c:/usr/sbin/sysctl -n net.ipv6.conf.all.forwarding', '^0$')],\n        243: [('c:/usr/bin/systemctl show firewalld.service --property=LoadState', '^LoadState=loaded$'),\n              ('c:/usr/bin/systemctl show firewalld.service --property=ActiveState', '^ActiveState=active$'),\n              ('c:/usr/bin/systemctl show firewalld.service --property=UnitFileState', '^UnitFileState=enabled$')],\n        245: disabled_service_rules('nftables'),\n        269: [('c:/usr/sbin/sshd -T', '^permitrootlogin no$')],\n        270: [('c:/usr/sbin/sshd -T', '^permitemptypasswords no$')],\n    }\n\n\ndef build():\n    rows = registry()\n    expected = values()\n    for profile in ('base', 'firewalld', 'sshd'):\n        filename = 'linuxgcb_'+profile+'.yml'\n        checks = []\n        for row in rows:\n            if row['implementation'] != 'candidate' or row['profile'] != profile:\n                continue\n            checks.append(dict(id=row['sca_id'], title=row['gcb_id']+' '+row['title'],\n                description=PREFIX+expected[row['gcb_id']]+(' ｜ P2B8 執行審查 ' if row['sca_id']-900000 in BATCH8 else ' ｜ P2B7 執行審查 ' if row['sca_id']-900000 in BATCH7 else ' ｜ P2B6 執行審查 ' if row['sca_id']-900000 in BATCH6 else ' ｜ P2B3 執行審查 ' if row['sca_id']-900000 in BATCH3 else ' ｜ BATCH2 執行審查 ' if row['sca_id']-900000 in BATCH2 else ' ｜ Q1 執行審查 ')+row['execution_review']+'；coverage='+row['coverage']+'；'+','.join(row['issue_ids'])+'；raw PASS 非已驗證符合。'+row['pending'],\n                compliance=[{'twgcb': [row['gcb_id']]}], regex_type='pcre2', condition='all',\n                rules=[emit_rule(target, pattern) for target, pattern in definitions()[int(row['gcb_id'][-4:])]]))\n        policy = dict(policy=dict(id='linuxgcb_rhel9_'+profile+'_v01', file=filename,\n                      name='RHEL9 GCB v1.2 '+profile+' v0.1 UNVALIDATED',\n                      description='未驗證候選政策；僅供核准 RHEL9 試點，非完整符合性檢核', regex_type='pcre2'),\n                      requirements=dict(title='僅 RHEL 9', description='角色由核准群組控制',\n                        condition='all', rules=['f:/etc/os-release -> r:^ID=\"?rhel\"?$',\n                                               'f:/etc/os-release -> r:^VERSION_ID=\"?9([.][0-9]+)*\"?$']),\n                      checks=checks)\n        (ROOT/'policies'/filename).write_text(json.dumps(policy, ensure_ascii=False, indent=2)+'\\n')\n    hashes = {p.name: digest(p) for p in sorted((ROOT/'policies').glob('*.yml'))}\n    (ROOT/'data/policy_hashes.json').write_text(json.dumps(hashes, indent=2)+'\\n')\n    from .coverage import write\n    write()\n    validate()\n\n\ndef require(condition):\n    if not condition:\n        raise ValueError('候選政策結構、mapping 或 hash 不符')\n\n\ndef validate():\n    rows = {r['sca_id']: r for r in registry()}\n    seen = set()\n    for path in sorted((ROOT/'policies').glob('*.yml')):\n        p = json.loads(path.read_text())\n        require(p['policy']['file'] == path.name and p['policy']['regex_type']=='pcre2')\n        require(p['requirements'] == dict(title='僅 RHEL 9', description='角色由核准群組控制',\n            condition='all', rules=['f:/etc/os-release -> r:^ID=\"?rhel\"?$',\n                                   'f:/etc/os-release -> r:^VERSION_ID=\"?9([.][0-9]+)*\"?$']))\n        for c in p['checks']:\n            require(c['id'] not in seen and rows[c['id']]['included'])\n            seen.add(c['id'])\n            require(parse_description(c.get('description')) == values()[rows[c['id']]['gcb_id']])\n            require((' ｜ P2B8 ' if c['id']-900000 in BATCH8 else ' ｜ P2B7 ' if c['id']-900000 in BATCH7 else ' ｜ P2B6 ' if c['id']-900000 in BATCH6 else ' ｜ P2B3 ' if c['id']-900000 in BATCH3 else ' ｜ BATCH2 ' if c['id']-900000 in BATCH2 else ' ｜ Q1 ') in c['description'])\n            require(c['regex_type'] == 'pcre2' and c['condition'] == 'all')\n            require(c['compliance'] == [{'twgcb': [rows[c['id']]['gcb_id']]}])\n            require(rows[c['id']]['policy_id'] == p['policy']['id'])\n            require(c['rules'] == [emit_rule(a,b) for a,b in definitions()[c['id']-900000]])\n            for rule in c['rules']:\n                target, _ = rule.split(' -> ', 1)\n                require(target.removeprefix('not ').startswith('c:/'))\n                if c['id']-900000 not in BATCH2 | BATCH3 | BATCH6 | BATCH7 | BATCH8:\n                    require(not any(x in target for x in ('|',';', '&&', '$', '`')))\n                parse_rule(rule)\n    require(seen == {900000+n for n in definitions()})\n    hashes = json.loads((ROOT/'data/policy_hashes.json').read_text())\n    require(hashes == {p.name:digest(p) for p in (ROOT/'policies').glob('*.yml')})\n    from .coverage import manifest\n    require(json.loads((ROOT/'data/coverage_manifest.json').read_text()) == manifest())\n    require(seen == {r['sca_id'] for r in rows.values() if r['implementation']=='candidate'})\n    return len(seen)\n\n\n@lru_cache(maxsize=1)\ndef supported_patterns():\n    return frozenset(p.lstrip('!') for rules in definitions().values() for _,p in rules) | {\n        '^ID=\"?rhel\"?$', '^VERSION_ID=\"?9([.][0-9]+)*\"?$'}\n\n\ndef emit_rule(target, pattern):\n    return ('not '+target+' -> r:'+pattern[1:]) if pattern.startswith('!') else target+' -> r:'+pattern\n\n\n@lru_cache(maxsize=1)\ndef batch2_emitted():\n    return {emit_rule(t,p) for rules in batch2_rules().values() for t,p in rules}\n\n\n@lru_cache(maxsize=1)\ndef batch3_emitted():\n    return {emit_rule(t,p) for rules in batch3_rules().values() for t,p in rules}\n\n\ndef parse_rule(rule):\n    \"\"\"Legacy bounded grammar plus exact allowlist of BATCH2 emitted rules.\"\"\"\n    if not isinstance(rule, str):\n        raise ValueError('不支援的規則語法')\n    if rule in {emit_rule(t,p) for rs in [*batch6_rules().values(), *batch7_rules().values(), *batch8_rules().values()] for t,p in rs}:\n        target, expression = rule.split(' -> ', 1)\n        argv = w_strtok(target[2:])\n        if len(argv) != 3 or argv[:2] != ['/usr/bin/python3', '-c']:\n            raise ValueError('Invalid Python argv')\n        return target, re.compile(expression.split(':',1)[1], re.ASCII)\n    if rule in batch2_emitted() or rule in batch3_emitted():\n        target, expression = rule.split(' -> ', 1)\n        argv = w_strtok(target.removeprefix('not ')[2:])\n        if len(argv) != 3 or argv[:2] != ['/bin/sh', '-c']:\n            raise ValueError('Invalid wm_exec shell argv')\n        return target.removeprefix('not '), re.compile(expression.split(':',1)[1], re.ASCII)\n    if rule.count(' -> r:') != 1:\n        raise ValueError('不支援的規則語法')\n    target, pattern = rule.split(' -> r:')\n    if not re.fullmatch(r'[cf]:/[^\\n\\r]+', target) or any(x in target for x in (' -> ', ' && ', '|', ';', '`', '$')):\n        raise ValueError('不支援的目標')\n    if pattern not in supported_patterns() and not re.fullmatch(r'\\^[A-Za-z0-9_ =:/-]+\\$', pattern):\n        raise ValueError('未驗證的 PCRE2 語法')\n    try:\n        return target, re.compile(pattern, re.ASCII)\n    except re.error as exc:\n        raise ValueError('無效模式') from exc\n\n\ndef simulate(check, observations):\n    \"\"\"僅輸出匹配模型；執行失敗資訊不足回 UNRESOLVED，不冒充 Wazuh。\n\n    FIX-3 模擬 OS_StrBreak 的前 256 行上限（wm_sca.c:1749）。\n    FIX-1 同一 command 的多行輸出仍按逐行存在匹配；alternation 是單一\n    正向 regex，規則間維持 all，不以空輸出或 stderr 推論 not-found。\n    所有項目 exit_code 不參與輸出匹配（wm_exec 正常結束仍回 0），\n    並以 emitted shell guard 確保失敗不發布輸出或成功標記。\n    明確 engine_result 可表示真機／fixture\n    的 Not applicable；error 只表示未取得可靠輸出，不能預測引擎結果。\n    \"\"\"\n    if check.get('regex_type', 'pcre2') != 'pcre2':\n        raise ValueError('只支援明確 PCRE2 候選子集')\n    if check.get('condition') != 'all':\n        raise ValueError('輸出模型只支援目前發出的 all 子集')\n    if not isinstance(check.get('rules'), list) or not check['rules']:\n        raise ValueError('規則不得為空')\n    parsed = [parse_rule(rule) for rule in check['rules']]\n    outcomes = []\n    for rule, (target, pattern) in zip(check['rules'], parsed):\n        obs = observations.get(target)\n        if target.startswith('f:') and obs is not None and obs.get('exists') is False:\n            outcomes.append('NOT_APPLICABLE')\n            continue\n        if obs is None or obs.get('error'):\n            outcomes.append('UNRESOLVED')\n        elif obs.get('engine_result') == 'NOT_APPLICABLE':\n            outcomes.append('NOT_APPLICABLE')\n        elif not isinstance(obs.get('stdout'), str):\n            raise ValueError('觀察必須提供字串 stdout')\n        else:\n            matched = any(pattern.search(line) for line in obs['stdout'].split('\\n')[:256])\n            if rule.startswith('not '):\n                matched = not matched\n            outcomes.append('PASS' if matched else 'FAIL')\n    # 官方 all：任何 FAIL 優先；未知執行不擅自轉成 N/A。\n    if 'FAIL' in outcomes:\n        return 'FAIL'\n    if 'UNRESOLVED' in outcomes:\n        return 'UNRESOLVED'\n    return 'NOT_APPLICABLE' if 'NOT_APPLICABLE' in outcomes else 'PASS'\n","exit_code":0,"status":"completed"}}

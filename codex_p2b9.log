        note = '依來源用 ip link 唯讀輸出，任一行不分大小寫含 promisc 即失敗；空輸出、缺介面、stderr、非零或逾時不提交 PASS；不執行來源 ip link set。'\n    return note + ' P2B9 UNVALIDATED；human_review_pending；execution_review=blocked；來源與引擎語意待批。'\n'''\np=p.replace('p2b8_runtime, fix7_runtime','p2b9_runtime').replace('from .p2b8_runtime import MODULES','import re').replace('ADDED = set(range(1,30)) | {31} | set(range(285,301))','ADDED = set(range(109,132))').replace('P2B8','P2B9')\nPath('linuxgcb/batch9.py').write_text(p)\nfor file in ['catalog.py','quality.py','coverage.py','policy.py']:\n path=Path('linuxgcb')/file;s=path.read_text()\n s=s.replace('from .batch8 import', 'from .batch9 import ADDED as BATCH9, caveat as batch9_caveat, sources as batch9_sources, rules as batch9_rules\\\\nfrom .batch8 import',1)\n if file=='catalog.py':s=s.replace('PARTIAL =','IMPLEMENTED.update({n: \\\\'base\\\\' for n in BATCH9})\\\\nPARTIAL =',1)\n if file=='quality.py':s=s.replace('    if n in BATCH8:', '''    if n in BATCH9:\n        return dict(offline_review='completed_with_findings', execution_review='blocked',\n                    coverage='partial', issue_ids=['B9-ENGINE', 'B9-SOURCE'],\n                    family='P2B9 embedded read-only', source_approval='pending',\n                    live_validation='UNVALIDATED', pending=batch9_caveat(n))\n    if n in BATCH8:''',1)\n if file=='policy.py':\n  s=s.replace('**batch8_rules(),','**batch8_rules(), **batch9_rules(),')\n  s=s.replace(\\\"(' ｜ P2B8\\\", \\\"(' ｜ P2B9 執行審查 ' if row['sca_id']-900000 in BATCH9 else ' ｜ P2B8\\\",1)\n  s=s.replace(\\\"(' ｜ P2B8 ' if c\\\", \\\"(' ｜ P2B9 ' if c['id']-900000 in BATCH9 else ' ｜ P2B8 ' if c\\\",1)\n  s=s.replace('BATCH7 | BATCH8:', 'BATCH7 | BATCH8 | BATCH9:')\n  s=s.replace('*batch8_rules().values()]','*batch8_rules().values(), *batch9_rules().values()]')\n if file=='coverage.py':\n  s=s.replace('        if n in BATCH8:', '''        if n in BATCH9:\n            method=batch9_sources()[n]['configuration_method']\n            historical=[c for c in matches if c[-2] \"'!= method or c[-1] != row['\"'expected']]\n            matches=[c for c in matches if c[-2] == method and c[-1] == row['expected']]\n        elif n in BATCH8:''',1)\n  s=s.replace(\\\"mechanism=('P2B8\\\", \\\"mechanism=('P2B9 direct Python argv source predicates' if n in BATCH9 else 'P2B8\\\")\n  s=s.replace('caveats=batch8_caveat(n)', 'caveats=batch9_caveat(n) if n in BATCH9 else batch8_caveat(n)')\n  s=s.replace(\\\"('tests/test_p2b8.py#'\\\", \\\"('tests/test_p2b9.py#' if n in BATCH9 else 'tests/test_p2b8.py#'\\\")\n  s=s.replace(\\\"'tests/test_p2b8.py' if\\\", \\\"'tests/test_p2b9.py' if n in BATCH9 else 'tests/test_p2b8.py' if\\\")\n  s=s.replace('BATCH6 | BATCH7 | BATCH8 else', 'BATCH6 | BATCH7 | BATCH8 | BATCH9 else')\n  s=s.replace('before=7,batch8_before', 'before=7,batch9_before=282,batch9_added=23,batch9_after=305,batch8_before')\n  s=s.replace('added=len(BATCH8)+','added=len(BATCH9)+len(BATCH8)+')\n path.write_text(s)\nPY\npython3 /tmp/p2b9_edit.py\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"cat > linuxgcb/p2b9_runtime.py <<'PY'\n\\\"\\\"\\\"Read-only P2B9 predicates; isolated tests replace ROOT and subprocess.\\\"\\\"\\\"\nimport glob\nimport os\nimport re\nimport shutil\nimport subprocess\nROOT = ''\nMODULES = {126:'dccp',127:'sctp',128:'rds',129:'tipc'}\n\n\ndef read(path):\n    with open(ROOT+path, encoding='utf-8') as f:\n        return f.read()\n\n\ndef lines(paths):\n    for path in paths:\n        with open(path, encoding='utf-8') as f:\n            for line in f:\n                text = re.split(r'[#;]', line, maxsplit=1)[0].strip()\n                if text:\n                    yield text\n\n\ndef module_ok(module):\n    install = False\n    blacklist = False\n    for text in lines(sorted(glob.glob(ROOT+'/etc/modprobe.d/*.conf'))):\n        fields = text.split()\n        if len(fields) >= 2 and fields[1] == module:\n            if fields[0] == 'install':\n                if fields \"'!= ['\"'install',module,'/bin/true']:\n                    return False\n                install = True\n            if fields == ['blacklist',module]:\n                blacklist = True\n    return install and blacklist\n\n\ndef command(argv):\n    result = subprocess.run(argv, capture_output=True, text=True, timeout=8, check=False)\n    if result.returncode or result.stderr or not result.stdout.strip():\n        raise ValueError('unreliable command output')\n    return result.stdout\n\n\ndef check(n, key=None):\n    if n <= 125:\n        paths = sorted(glob.glob(ROOT+'/etc/sysctl.d/*.conf'))\n        if os.path.lexists(ROOT+'/etc/sysctl.conf'):\n            paths.insert(0,ROOT+'/etc/sysctl.conf')\n        if n in (119,120,121,123):\n            for directory in ('/usr/lib/sysctl.d/','/run/sysctl.d/'):\n                paths += sorted(glob.glob(ROOT+directory+'*.conf'))\n        value = None\n        pattern = re.compile(r'\"'^'\"'+re.escape(key)+r'\\\\s*=\\\\s*(.*?)\\\\s*\"'$'\"')\n        for text in lines(paths):\n            match = pattern.fullmatch(text)\n            if match:\n                current = match[1]\n                if not re.fullmatch(r'[0-9]+',current) or (value is not None and current \"'!= value):\n                    return None\n                value = current\n        return value\n    if n in MODULES:\n        return '\"'PASS' if module_ok(MODULES[n]) else None\n    if n == 130:\n        nmcli = shutil.which('nmcli')\n        if nmcli:\n            output = command([nmcli,'-t','-f','WIFI,WWAN','radio','all']).strip()\n            return 'PASS' if output == 'disabled:disabled' else None\n        interfaces = sorted(glob.glob(ROOT+'/sys/class/net/*/wireless'))\n        if not interfaces:\n            return None\n        for wireless in interfaces:\n            link = os.path.dirname(wireless)+'/device/driver/module'\n            if not os.path.islink(link) or not os.path.isdir(link):\n                return None\n            module = os.path.basename(os.path.realpath(link))\n            if not module_ok(module):\n                return None\n        return 'PASS'\n    if n == 131:\n        output = command(['/usr/sbin/ip','link'])\n        found = False\n        for line in output.splitlines():\n            if 'promisc' in line.lower():\n                return None\n            if re.match(r'\"'^'\"\\\\d+:\\\\s+\\\\S+:\\\\s+<[\"'^>]*>'\"', line):\n                found = True\n        return 'PASS' if found else None\n    raise ValueError('unknown candidate')\nPY\npython3 -m linuxgcb build\npython3 -m linuxgcb validate\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

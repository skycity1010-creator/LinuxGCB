 Path\\nfrom scripts.inventory import extract\\nfrom .batch1 import ADDED\\nfrom .quality import status\\n\\nROOT = Path(__file__).resolve().parents[1]\\nXLSX_HASH = '7d752b639a1e780df08814c6252efadd3ea2711eaa5c9d91c070b84a296c0247'\\nDOCX_HASH = '986effd9501b1fd97776129c6691cf8fc98246bd04514347322f3337508e0e5b'\\nIMPLEMENTED = {45: 'base', 46: 'base', 108: 'base', 243: 'firewalld',\\n               245: 'firewalld', 269: 'sshd', 270: 'sshd'}\\nIMPLEMENTED.update({n: ('sshd' if n in (256,257) else 'firewalld' if n==242 else 'base') for n in ADDED})\\nPARTIAL = {141: '僅來源設定方法明列 audit.rules；其餘 rules.d 規則檔集合尚未覆蓋',\\n           108: '僅雙協定即時值；持久設定來源、覆寫順序與路由角色待審',\\n           269: '僅 sshd -T 預設情境；Include/Match 與使用者/來源矩陣待審',\\n           270: '僅 sshd -T 預設情境；Include/Match 與使用者/來源矩陣待審'}\\n\\n\\ndef digest(path):\\n    return hashlib.sha256(path.read_bytes()).hexdigest()\\n\\n\\ndef registry():\\n    source = next(ROOT.glob('*.xlsx'))\\n    docx = next(ROOT.glob('*.docx'))\\n    if digest(source) != XLSX_HASH or digest(docx) != DOCX_HASH:\\n        raise ValueError('來源 hash 改變，停止產生')\\n    records = extract(source)\\n    result = []\\n    for r in records:\\n        n = int(r['gcb_id'][-4:])\\n        included = r['sheet'] != 'Nftables防火牆'\\n        profile = ('firewalld' if r['sheet'] == 'Firewalld防火牆' else\\n                   'sshd' if r['sheet'] == 'SSH伺服器' else 'base')\\n        if n in IMPLEMENTED:\\n            classification, why = 'native_sca', '候選唯讀原生命令；完整語意與引擎驗收待人工審查'\\n        elif profile != 'base' or any(k in r['title'] for k in ('GUI', '無線', '可攜', 'NFS')):\\n            classification, why = 'conditional', '須先確認角色、服務與適用性，再選擇實作方式'\\n        elif any(k in r['title'] for k in ('權限', '所有權', '擁有', '稽核', '密碼', '通行碼')):\\n            classification, why = 'readonly_helper', '可能涉及集合、位元或載入鏈解析；尚未實作 helper'\\n        else:\\n            classification, why = 'manual_review', '尚未逐條語意審查，保守列人工待辦，非不可自動化結論'\\n        result.append(dict(gcb_id=r['gcb_id'], source_file=r['source_file'],\\n            source_sheet=r['sheet'], source_row=r['row'], source_sha256=XLSX_HASH,\\n            category=r['category'], title=r['title'], expected=r['expected'],\\n            included=included, scope_reason='候選，仍須主機適用性核准' if included else '明確排除 Nftables 工作表',\\n            sca_id=900000+n, profile=profile, proposed_classification=classification,\\n            justification=why, review_status='human_review_pending',\\n            implementation='candidate' if n in IMPLEMENTED else 'pending' if included else 'excluded',\\n            policy_id='linuxgcb_rhel9_'+IMPLEMENTED[n]+'_v01' if n in IMPLEMENTED else None,\\n            coverage='partial' if n in PARTIAL else 'full' if n in IMPLEMENTED else 'unimplemented',\\n            live_validation='UNVALIDATED', execution_review='pending',\\n            pending=PARTIAL.get(n, '' if n in IMPLEMENTED else '未實作；待逐條 DOCX 語意審查')))\\n        if n in IMPLEMENTED:\\n            result[-1].update(status(n))\\n    if (len(result), sum(r['included'] for r in result), len({r['sca_id'] for r in result}),\\n        len({r['gcb_id'] for r in result})) != (314, 307, 314, 314):\\n        raise ValueError('範圍或唯一性不符')\\n    return result\\n\\n\\ndef write_registry():\\n    rows = registry()\\n    (ROOT/'data/scope_registry.json').write_text(json.dumps(rows, ensure_ascii=False, indent=2)+'\\\\n')\\n    return rows\\n\\\"\\\"\\\"合規值僅作文字；從來源抽取，絕不執行設定方法。\\\"\\\"\\\"\\nimport json\\nimport re\\nfrom .catalog import ROOT\\n\\nPREFIX = '合規值: '\\nUNKNOWN = '待確認（來源未提供單一基準值）'\\n\\n\\ndef source_expected(row):\\n    value = (row.get('expected') or '').strip()\\n    method = row.get('configuration_method') or ''\\n    if value == '安裝':\\n        match = re.search(r'#dnf install ([a-zA-Z0-9 -]+)', method)\\n        return match.group(1).strip()+' 已安裝' if match else UNKNOWN\\n    if value in ('啟用', '停用'):\\n        match = re.search(r'#systemctl --now (enable|disable|mask) ([a-zA-Z0-9_.-]+)', method)\\n        if not match:\\n            return UNKNOWN\\n        action, service = match.groups()\\n        return service+' '+{'enable': 'enabled+active', 'disable': 'disabled+inactive',\\n                              'mask': 'masked+inactive'}[action]\\n    if row['gcb_id'].endswith('0108'):\\n        return 'net.ipv4.ip_forward=0；net.ipv6.conf.all.forwarding=0'\\n    if row['gcb_id'].endswith('0269'):\\n        return 'PermitRootLogin '+value if value else UNKNOWN\\n    if row['gcb_id'].endswith('0270'):\\n        return 'PermitEmptyPasswords '+value if value else UNKNOWN\\n    return value or UNKNOWN\\n\\n\\ndef values():\\n    return {r['gcb_id']: source_expected(r) for r in json.loads((ROOT/'data/controls.json').read_text())}\\n\\n\\ndef parse_description(description):\\n    if not isinstance(description, str) or not description.startswith(PREFIX):\\n        return ''\\n    return description[len(PREFIX):].split(' ｜ ', 1)[0].strip()\\n\\n\\ndef report_expected(raw, policy):\\n    \\\"\\\"\\\"歷史匯出可用本地政策補充，明示其非掃描時證據。\\\"\\\"\\\"\\n    value = parse_description(raw.get('description'))\\n    if value:\\n        return value, 'raw_description'\\n    value = parse_description(policy.get('description'))\\n    if value:\\n        return value, 'policy_description_fallback; raw_prefix_missing'\\n    return '', 'prefix_missing'\\n\\\"\\\"\\\"可重建的逐項來源對照與涵蓋 manifest；不執行候選命令。\\\"\\\"\\\"\\nimport json\\nfrom collections import Counter\\nfrom zipfile import ZipFile\\nfrom xml.etree import ElementTree as ET\\nfrom .catalog import ROOT, registry, digest\\nfrom .batch1 import ADDED, caveat\\nfrom .quality import status\\n\\ndef manifest():\\n    ns={'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}\\n    docx=next(ROOT.glob('*.docx'))\\n    xml=ET.fromstring(ZipFile(docx).read('word/document.xml'))\\n    # ID 的 runs 必須在段落內接回，cell 再以換行串接段落。\\n    tables=[]\\n    for tr in xml.findall('.//w:tr',ns):\\n        cells=['\\\\n'.join(''.join(t.text or '' for t in p.findall('.//w:t',ns))\\n                         for p in cell.findall('.//w:p',ns)) for cell in tr.findall('w:tc',ns)]\\n        tables.append(cells)\\n    entries=[]\\n    for row in registry():\\n        n=row['sca_id']-900000\\n        if row['implementation'] != 'candidate': continue\\n        matches=[c for c in tables if row['gcb_id'] in c]\\n        if not matches or any(c[-2:] != matches[0][-2:] for c in matches) or row['expected'] not in matches[0]:\\n            raise ValueError('DOCX ID／期望欄無法唯一核對：'+row['gcb_id'])\\n        entries.append(dict(gcb_id=row['gcb_id'],sca_id=row['sca_id'],\\n            source_sheet=row['source_sheet'],source_row=row['source_row'],expected=row['expected'],\\n            docx_cells=matches[0],docx_occurrences=len(matches),docx_all_cells=matches,docx_sha256=digest(docx),\\n            mechanism='原生 c: 絕對路徑、正向逐行 PCRE2、all 聚合；無 shell',\\n            caveats=caveat(n) if n in ADDED else row['pending'],tests=['tests/fixtures/rule_outputs.json#'+str(row['sca_id']), 'tests/test_quality_q1.py'],\\n            cases=['positive','negative','missing','empty','error','nonzero_matching'],\\n            review_status='human_review_pending',**status(n)))\\n    rows=registry();counts=Counter(r['implementation'] for r in rows)\\n    return dict(schema_version=2,label='離線候選涵蓋；非實機證據',\\n        counts=dict(source=len(rows),included=sum(r['included'] for r in rows),excluded=counts['excluded'],\\n                    before=7,added=len(ADDED),implemented=counts['candidate'],remaining=counts['pending'],\\n                    full=sum(r['coverage']=='full' for r in rows),partial=sum(r['coverage']=='partial' for r in rows),\\n                    blocked=sum(r['coverage']=='blocked' for r in rows),reviewed=len(entries),execution_blocked=len(entries),live_validated=0),\\n        reviewed=entries)\\n\\ndef write():\\n    m=manifest()\\n    (ROOT/'data/coverage_manifest.json').write_text(json.dumps(m,ensure_ascii=False,indent=2)+'\\\\n')\\n    return m\\n\\\"\\\"\\\"有界批次：明列來源路徑，不以標題啟發式生成控制。\\\"\\\"\\\"\\n# (路徑, owner 或 mode, 允許值)；mode 是位元子集合，非 umask。\\nFILES = {\\n 47:('/etc/shadow','owner','root:(root|shadow)'),48:('/etc/shadow','mode',0),\\n 49:('/etc/group','owner','root:root'),50:('/etc/group','mode',0o644),\\n 51:('/etc/gshadow','owner','root:(root|shadow)'),52:('/etc/gshadow','mode',0),\\n 53:('/etc/passwd-','owner','root:root'),54:('/etc/passwd-','mode',0o644),\\n 55:('/etc/shadow-','owner','root:(root|shadow)'),56:('/etc/shadow-','mode',0),\\n 57:('/etc/group-','owner','root:root'),58:('/etc/group-','mode',0o644),\\n 59:('/etc/gshadow-','owner','root:(root|shadow)'),60:('/etc/gshadow-','mode',0),\\n 141:('/etc/audit/rules.d/audit.rules','mode',0o600),142:('/etc/audit/auditd.conf','mode',0o640),\\n 178:('/var/log/messages','owner','root:root'),179:('/var/log','owner','root:root'),\\n 191:('/etc/crontab','owner','root:root'),192:('/etc/crontab','mode',0o600),\\n 193:('/etc/cron.hourly','owner','root:root'),194:('/etc/cron.hourly','mode',0o700),\\n 195:('/etc/cron.daily','owner','root:root'),196:('/etc/cron.daily','mode',0o700),\\n 197:('/etc/cron.weekly','owner','root:root'),198:('/etc/cron.weekly','mode',0o700),\\n 199:('/etc/cron.monthly','owner','root:root'),200:('/etc/cron.monthly','mode',0o700),\\n 201:('/etc/cron.d','owner','root:root'),202:('/etc/cron.d','mode',0o700),\\n 256:('/etc/ssh/sshd_config','owner','root:root'),257:('/etc/ssh/sshd_config','mode',0o600),\\n 301:('/etc/shells','owner','root:root'),302:('/etc/shells','mode',0o644),\\n}\\nPACKAGES = {33:['sudo'],132:['audit','audit-libs'],174:['rsyslog'],183:['libselinux'],242:['firewalld']}\\n# 0036 AIDE 初始化另有要求，0231 架構需審查，本批不以套件存在充當完整實作。\\nSERVICES = {30:('autofs','disabled'),94:('rsyncd','masked'),97:('squid','masked'),\\n            98:('smb','masked'),101:('kdump','disabled'),133:('auditd','enabled'),\\n            175:('rsyslog','enabled')}\\nADDED = set(FILES) | set(PACKAGES) | set(SERVICES)\\n\\ndef mode_pattern(mask):\\n    return '^('+'|'.join(format(n,'o') for n in range(0o10000) if n & ~mask == 0)+')$'\\n\\n# FIX-1: positive predicates only; no stderr/exit-code or negative-match inference.\\nDISABLED_SERVICES = {30: ('autofs',), 94: ('rsyncd',), 97: ('squid',),\\n                     98: ('smb', 'nmb'), 101: ('kdump',), 245: ('nftables',)}\\n\\ndef disabled_service_rules(unit):\\n    command = 'c:/usr/bin/systemctl show '+unit+'.service'\\n    return [(command+' --property=LoadState', '^LoadState=(loaded|masked|not-found)$'),\\n            (command+' --property=ActiveState', '^ActiveState=inactive$'),\\n            # Same output contains either explicit absence or a safe unit-file state.\\n            # Empty UnitFileState on absent units is never itself a PASS marker.\\n            (command+' --property=LoadState --property=UnitFileState',\\n             '^(LoadState=not-found|UnitFileState=(disabled|masked))$')]\\n\\ndef rules():\\n    result = {}\\n    for n,(path,kind,value) in FILES.items():\\n        result[n] = [('c:/usr/bin/stat -c '+('%U:%G' if kind=='owner' else '%a')+' '+path,\\n                      '^'+value+'$' if kind=='owner' else mode_pattern(value)),\\n]\\n        # 來源明列目錄才限制型態；檔案來源未明定必須 regular，交由來源審查。\\n        if n in (179,193,194,195,196,197,198,199,200,201,202):\\n            result[n].append(('c:/usr/bin/stat -c %f '+path, '^4[0-9a-f]{3}$'))\\n    for n,packages in PACKAGES.items():\\n        # RPM 的成功輸出必須含正向標記；不依賴退出碼或空輸出。\\n        result[n] = [('c:/usr/bin/rpm -q --queryformat %{NAME}:installed '+p,'^'+p+':installed$') for p in packages]\\n    for n,(unit,state) in SERVICES.items():\\n        if n in DISABLED_SERVICES:\\n            result[n] = [rule for service in DISABLED_SERVICES[n] for rule in disabled_service_rules(service)]\\n            continue\\n        props = [('LoadState','loaded' if state!='masked' else 'masked'),\\n                 ('ActiveState','active' if state=='enabled' else 'inactive'),('UnitFileState',state)]\\n        result[n] = [('c:/usr/bin/systemctl show '+unit+'.service --property='+k,'^'+k+'='+v+'$') for k,v in props]\\n    return result\\n\\ndef caveat(n):\\n    common='命令啟動／stderr／權限錯誤與非零但匹配輸出之行為待真機驗證；不依賴退出碼。'\\n    if n in FILES:\\n        path,kind,_=FILES[n]\\n        text='固定路徑 lstat；來源明列目錄才用 %f 數值型態，檔案不額外限制 regular。連結是否應解參照、NSS 與 ACL 語意未核准；不可據此宣稱完整符合。'\\n        if path.endswith('-'): text+='備份檔缺失不自動視為不適用，需核准適用性。'\\n        if n==141: text+='僅來源明列 audit.rules，其他 rules.d 檔案覆蓋待審。'\\n        if n in (256,257): text+='僅 sshd_config metadata，不代表 Include 或 SSH 內容符合。'\\n        return text+common\\n    if n in PACKAGES: return '僅 RPM 資料庫套件存在；不代表服務或內容規則通過。RPM 資料庫錯誤不得以未安裝推論。'+common\\n    if n in DISABLED_SERVICES:\\n        detail = 'Samba 同查 smb/nmb。' if n == 98 else ''\\n        if n == 101:\\n            detail += '0101 依 FIX-1 任務改為停用意圖，來源啟用差異待核准。'\\n        return 'FIX-1：明確 not-found 或 disabled/masked 且 inactive；'+detail+'多次查詢非原子、socket/alias 未覆蓋；UNVALIDATED。'+common\\n    return '分開確認開機狀態與即時狀態；不接受 not-found、static、alias、enabled-runtime；不存在不自動通過；多次查詢非原子。'+common\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./codex_p2b2.log:22:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_11\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"python3 - <<'PY'\\nimport json\\nrs=json.load(open('data/scope_registry.json')); cs={x['gcb_id']:x for x in json.load(open('data/controls.json'))}\\nprint(sorted({(x['category'],x['source_sheet']) for x in rs}))\\nfor x in rs:\\n if x['coverage']=='unimplemented' and (x['category'] in ['SSH設定','cron設定','SELinux','安裝與維護軟體'] or x['source_sheet'] in ['SSH伺服器','SELinux']):\\n  c=cs[x['gcb_id']];print(x['sca_id'],x['category'],x['source_sheet'],x['title'],repr(c))\\nPY\\\"\",\"aggregated_output\":\"[('Firewalld配置', 'Firewalld防火牆'), ('Nftables配置', 'Nftables防火牆'), ('SELinux', '基本項目'), ('SSH設定', 'SSH伺服器'), ('cron設定', '基本項目'), ('安裝與維護軟體', '基本項目'), ('帳號與存取控制', '基本項目'), ('日誌與稽核', '基本項目'), ('磁碟與檔案系統', '基本項目'), ('系統服務', '基本項目'), ('系統設定與維護', '基本項目'), ('網路設定', '基本項目')]\\n900102 安裝與維護軟體 基本項目 NIS用戶端套件 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': '基本項目', 'row': 106, 'ordinal': '102', 'gcb_id': 'TWGCB-01-012-0102', 'category': '安裝與維護軟體', 'title': 'NIS用戶端套件', 'description': '這項原則設定決定是否安裝NIS用戶端套件(ypbind)\\\\nNIS(Network Information System，網路資訊服務)可提供帳號、通行碼、主機名稱或群組等資訊進行登入鑑別，NIS使用較不嚴謹之身分鑑別機制，易受到服務阻斷攻擊\\\\n移除NIS用戶端套件，以避免使用較不安全之NIS服務', 'configuration_method': '開啟終端機，執行以下指令移除ypbind套件：\\\\n#dnf remove ypbind', 'expected': '移除', 'implementation_status': 'unreviewed'}\\n900103 安裝與維護軟體 基本項目 telnet用戶端套件 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': '基本項目', 'row': 107, 'ordinal': '103', 'gcb_id': 'TWGCB-01-012-0103', 'category': '安裝與維護軟體', 'title': 'telnet用戶端套件', 'description': '這項原則設定決定是否安裝telnet用戶端套件\\\\ntelnet協定不安全且未加密傳輸，將可能導致機敏資料外洩\\\\n移除telnet用戶端套件，以避免使用不安全之telnet服務', 'configuration_method': '開啟終端機，執行以下指令移除telnet套件：\\\\n#dnf remove telnet', 'expected': '移除', 'implementation_status': 'unreviewed'}\\n900104 安裝與維護軟體 基本項目 telnet伺服器套件 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': '基本項目', 'row': 108, 'ordinal': '104', 'gcb_id': 'TWGCB-01-012-0104', 'category': '安裝與維護軟體', 'title': 'telnet伺服器套件', 'description': '這項原則設定決定是否安裝telnet伺服器套件(telnet-server)\\\\ntelnet協定不安全且未加密傳輸，將可能導致機敏資料外洩\\\\n移除telnet伺服器套件，以避免使用不安全之telnet服務', 'configuration_method': '開啟終端機，執行以下指令移除telnet-server套件：\\\\n#dnf remove telnet-server', 'expected': '移除', 'implementation_status': 'unreviewed'}\\n900105 安裝與維護軟體 基本項目 rsh伺服器套件 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': '基本項目', 'row': 109, 'ordinal': '105', 'gcb_id': 'TWGCB-01-012-0105', 'category': '安裝與維護軟體', 'title': 'rsh伺服器套件', 'description': '這項原則設定決定是否安裝rsh伺服器套件(rsh-server)\\\\nrsh伺服器提供未加密之遠端存取服務，將可能導致機敏資料外洩\\\\n移除rsh伺服器套件，以避免使用不安全之rsh服務', 'configuration_method': '開啟終端機，執行以下指令移除rsh-server套件：\\\\n#dnf remove rsh-server', 'expected': '移除', 'implementation_status': 'unreviewed'}\\n900106 安裝與維護軟體 基本項目 tftp伺服器套件 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': '基本項目', 'row': 110, 'ordinal': '106', 'gcb_id': 'TWGCB-01-012-0106', 'category': '安裝與維護軟體', 'title': 'tftp伺服器套件', 'description': '這項原則設定決定是否安裝tftp伺服器套件(tftp-server)\\\\ntftp(Trivial File Transfer Protocol，簡單檔案傳輸協定)可 讓使用者在用戶端與伺服器之間使用tftp通訊協定來傳輸檔案。tftp通訊協定不支援任何身分鑑別或加密機制，將可能導致資料外洩\\\\n移除tftp伺服器套件，以減少系統被攻擊面', 'configuration_method': '開啟終端機，執行以下指令移除tftp-server套件：\\\\n#dnf remove tftp-server', 'expected': '移除', 'implementation_status': 'unreviewed'}\\n900107 安裝與維護軟體 基本項目 更新套件後移除舊版本元件 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': '基本項目', 'row': 111, 'ordinal': '107', 'gcb_id': 'TWGCB-01-012-0107', 'category': '安裝與維護軟體', 'title': '更新套件後移除舊版本元件', 'description': '這項原則設定決定系統更新套件後是否移除舊版本元件\\\\n安裝更新後，若未從系統中移除舊版本元件，可能遭攻擊者利用舊版本元件漏洞進行攻擊', 'configuration_method': '編輯/etc/yum.conf與/etc/dnf/dnf.conf檔案，新增或修改成以下內容：\\\\nclean_requirements_on_remove=True', 'expected': 'True', 'implementation_status': 'unreviewed'}\\n900184 SELinux 基本項目 開機載入程式啟用SELinux {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': '基本項目', 'row': 187, 'ordinal': '183', 'gcb_id': 'TWGCB-01-012-0184', 'category': 'SELinux', 'title': '開機載入程式啟用SELinux', 'description': '這項原則設定決定是否在開機載入程式中啟用SELinux\\\\n在開機載入程式中啟用SELinux，確保SELinux正常運作，以提升伺服器安全性', 'configuration_method': '編輯/etc/default/grub檔案，檢查所有CMDLINE_LINUX參數設定，並移除所有「selinux=0」與「enforcing=0」內容，範例如下：\\\\nGRUB_CMDLINE_LINUX_DEFAULT=\\\"quiet\\\"\\\\nGRUB_CMDLINE_LINUX=\\\"\\\"\\\\n開啟終端機，執行以下指令更新grub2設定檔：\\\\n#grub2-mkconfig -o \\\"$(dirname \\\"$(find /boot -type f \\\\\\\\( -name \\\\'grubenv\\\\' -o -name \\\\'grub.conf\\\\' -o -name \\\\'grub.cfg\\\\' \\\\\\\\) -exec grep -Pl \\\\'^\\\\\\\\h*(kernelopts=|linux|kernel)\\\\' {} \\\\\\\\;)\\\")/grub.cfg\\\" ', 'expected': '啟用', 'implementation_status': 'unreviewed'}\\n900185 SELinux 基本項目 SELinux政策 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': '基本項目', 'row': 188, 'ordinal': '184', 'gcb_id': 'TWGCB-01-012-0185', 'category': 'SELinux', 'title': 'SELinux政策', 'description': '這項原則設定決定SELinux運作時所採用之政策\\\\n設定SELinux使用預設之targeted政策，針對守護程序與系統軟體加以管制\\\\n可設定政策如下：\\\\ntargeted：預設使用的政策，對大部分網路服務程序進行管制\\\\nminimum：以targeted政策為基礎，僅對選定的網路服務程序進行管制\\\\nmls：多層級安全保護，對所有程序進行管制，是最嚴格的政策', 'configuration_method': '編輯/etc/selinux/config檔案，設定SELINUXTYPE參數如下：\\\\nSELINUXTYPE=targeted', 'expected': 'targeted或更嚴格之政策', 'implementation_status': 'unreviewed'}\\n900186 SELinux 基本項目 SELinux啟用狀態 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': '基本項目', 'row': 189, 'ordinal': '185', 'gcb_id': 'TWGCB-01-012-0186', 'category': 'SELinux', 'title': 'SELinux啟用狀態', 'description': '這項原則設定決定系統開機時是否啟用SELinux，以及啟用的模式\\\\n模式選項如下：\\\\nenforcing：強制模式，依據設定來限制檔案資源存取\\\\npermissive：寬容模式，不限制檔案資源存取，但仍會依據設定檢查並記錄相關訊息\\\\ndisabled：停用模式，停用SELinux\\\\n注意：建議先進行測試再啟用SELinux，並於啟用後確認各項系統服務可正常運作', 'configuration_method': '編輯/etc/selinux/config檔案，設定SELINUX參數如下：\\\\nSELINUX=enforcing \\\\n開啟終端機，執行以下指令啟用強制(enforcing)模式：\\\\n#setenforce 1', 'expected': 'enforcing', 'implementation_status': 'unreviewed'}\\n900187 SELinux 基本項目 未受限程序 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': '基本項目', 'row': 190, 'ordinal': '186', 'gcb_id': 'TWGCB-01-012-0187', 'category': 'SELinux', 'title': '未受限程序', 'description': '這項原則設定決定是否允許存在未受限程序\\\\n未受限程序在SELinux的「unconfined_service_t」區域中執行，幾乎擁有全部的存取權限\\\\n若未受限程序被攻陷，SELinux將無法阻止攻擊者取得系統資源與資料\\\\n注意：建議先進行測試再變更程序類型，並於啟用後確認各項系統服務可正常運作', 'configuration_method': '開啟終端機，執行以下指令，檢查是否有未受限程序在執行：\\\\n#ps -eZf | grep unconfined_service_t | grep -v grep\\\\n檢視上一步驟的輸出結果，若有未受限程序在執行，須執行chcon指令，將該程序設定至非「unconfined_service_t」之區域。以將「/usr/sbin/httpd」程序設定至「httpd_exec_t」區域為例，chcon指令範例如下：\\\\n#chcon -t httpd_exec_t /usr/sbin/httpd', 'expected': '無未受限程序', 'implementation_status': 'unreviewed'}\\n900188 SELinux 基本項目 setroubleshoot套件 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': '基本項目', 'row': 191, 'ordinal': '187', 'gcb_id': 'TWGCB-01-012-0188', 'category': 'SELinux', 'title': 'setroubleshoot套件', 'description': '這項原則設定決定是否移除setroubleshoot套件\\\\nsetroubleshoot為SELinux問題診斷套件，此服務會將SELinux執行時所產生包含設定錯誤、未授權存取等錯誤資訊通知給使用者，將可能暴露機敏資訊，或遭使用者惡意變更SELinux設定', 'configuration_method': '開啟終端機，執行以下指令移除setroubleshoot套件：\\\\n#dnf remove setroubleshoot', 'expected': '移除', 'implementation_status': 'unreviewed'}\\n900189 SELinux 基本項目 mcstrans套件 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': '基本項目', 'row': 192, 'ordinal': '188', 'gcb_id': 'TWGCB-01-012-0189', 'category': 'SELinux', 'title': 'mcstrans套件', 'description': '這項原則設定決定是否使用mcstrans套件\\\\nmcstrans(Multi category security translation service)套件主要用於將SELinux的多重類別安全性(MCS)標籤轉換為人類可讀的格式\\\\n此套件非經常使用，移除mcstrans套件可減少系統被攻擊面', 'configuration_method': '開啟終端機，執行以下指令移除mcstrans套件：\\\\n#dnf remove mcstrans', 'expected': '移除', 'implementation_status': 'unreviewed'}\\n900190 cron設定 基本項目 cron守護程序 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': '基本項目', 'row': 193, 'ordinal': '189', 'gcb_id': 'TWGCB-01-012-0190', 'category': 'cron設定', 'title': 'cron守護程序', 'description': '這項原則設定決定是否啟用cron守護程序\\\\ncron守護程序是Linux系統上基於時間的任務管理系統，可透過cron以排程方式於固定時間、日期及間隔執行任務\\\\n啟用cron守護程序，以執行包含安全監控等系統維護作業', 'configuration_method': '開啟終端機，執行以下指令，啟用cron守護程序：\\\\n#systemctl --now enable crond', 'expected': '啟用', 'implementation_status': 'unreviewed'}\\n900203 cron設定 基本項目 at.allow與cron.allow檔案所有權 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': '基本項目', 'row': 206, 'ordinal': '202', 'gcb_id': 'TWGCB-01-012-0203', 'category': 'cron設定', 'title': 'at.allow與cron.allow檔案所有權', 'description': '這項原則設定決定at.allow與cron.allow檔案所有權\\\\n刪除/etc/at.deny與/etc/cron.deny檔案的拒絕清單，並設定/etc/cron.allow與/etc/at.allow檔案所有權，限制僅系統管理者可授權誰可以使用at與cron建立排程工作', 'configuration_method': '開啟終端機，執行以下指令，移除/etc/cron.deny與/etc/at.deny，並建立/etc/cron.allow與/etc/at.allow後，設定其所有權：\\\\n#rm /etc/cron.deny\\\\n#rm /etc/at.deny\\\\n#touch /etc/cron.allow\\\\n#touch /etc/at.allow\\\\n#chown root:root /etc/cron.allow\\\\n#chown root:root /etc/at.allow', 'expected': 'root:root', 'implementation_status': 'unreviewed'}\\n900204 cron設定 基本項目 at.allow與cron.allow檔案權限 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': '基本項目', 'row': 207, 'ordinal': '203', 'gcb_id': 'TWGCB-01-012-0204', 'category': 'cron設定', 'title': 'at.allow與cron.allow檔案權限', 'description': '這項原則設定決定是否設定at.allow與cron.allow檔案權限\\\\n刪除/etc/at.deny與/etc/cron.deny檔案的拒絕清單，並設定/etc/cron.allow與/etc/at.allow檔案權限，限制僅系統管理者可授權誰可以使用at與cron建立排程工作', 'configuration_method': '開啟終端機，執行以下指令，移除/etc/cron.deny與/etc/at.deny，並建立/etc/cron.allow與/etc/at.allow後，設定其權限為600或更低權限：\\\\n#rm /etc/cron.deny\\\\n#rm /etc/at.deny\\\\n#touch /etc/cron.allow\\\\n#touch /etc/at.allow\\\\n#chmod 600 /etc/cron.allow\\\\n#chmod 600 /etc/at.allow', 'expected': '600或更低權限', 'implementation_status': 'unreviewed'}\\n900205 cron設定 基本項目 cron日誌記錄功能 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': '基本項目', 'row': 208, 'ordinal': '204', 'gcb_id': 'TWGCB-01-012-0205', 'category': 'cron設定', 'title': 'cron日誌記錄功能', 'description': '這項原則設定決定是否啟用cron日誌記錄功能\\\\n啟用cron日誌記錄功能時，可查看cron作業之成功或失敗執行紀錄，供系統管理者及早發現未經授權存取與惡意使用cron工具之行為', 'configuration_method': '開啟終端機，執行以下指令，檢查cron日誌記錄功能設定：\\\\n#grep cron /etc/rsyslog.conf /etc/rsyslog.d/*.conf\\\\n若無發現cron日誌記錄功能設定，請編輯/etc/rsyslog.conf檔案或/etc/rsyslog.d/目錄下的檔案，新增或修改成以下內容，以記錄所有cron訊息：\\\\ncron.* /var/log/cron\\\\n開啟終端機，執行以下指令重新啟動rsyslog服務：\\\\n#systemctl restart rsyslog.service', 'expected': '啟用', 'implementation_status': 'unreviewed'}\\n900254 SSH設定 SSH伺服器 sshd守護程序 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 5, 'ordinal': '1', 'gcb_id': 'TWGCB-01-012-0254', 'category': 'SSH設定', 'title': 'sshd守護程序', 'description': '這項原則設定決定是否啟用sshd守護程序\\\\nsshd(Openssh Server程式)實作SSH(Secure Shell)協定，可在兩個主機之間提供安全加密通訊\\\\n啟用sshd守護程序，以加密方式保護傳輸資訊，以防攻擊者藉由封包攔截取得明文機敏資訊', 'configuration_method': '開啟終端機，執行以下指令，安裝openssh-server套件：\\\\n#dnf install openssh-server.x86_64\\\\n執行以下指令，啟用sshd守護程序：\\\\n#systemctl --now enable sshd.service', 'expected': '啟用', 'implementation_status': 'unreviewed'}\\n900255 SSH設定 SSH伺服器 SSH協定版本 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 6, 'ordinal': '2', 'gcb_id': 'TWGCB-01-012-0255', 'category': 'SSH設定', 'title': 'SSH協定版本', 'description': '這項原則設定決定使用何種SSH協定版本\\\\nSSH支援兩種不同且不相容的協定，分別為SSH-1與SSH-2協定，SSH-1為SSH原始協定且存在安全問題，SSH-2協定為新版本，提供功能改進並增強安全性\\\\n設定使用SSH-2協定，以提供系統更安全的SSH使用環境', 'configuration_method': '編輯/etc/ssh/sshd_config檔案，新增或修改成以下內容，以設定使用SSH-2：\\\\nProtocol 2\\\\n開啟終端機，執行以下指令，重新啟動SSH服務使其生效：\\\\n#systemctl restart sshd\\\\n注意：請先通知SSH服務使用者，再重啟SSH服務，以避免影響使用者作業', 'expected': 'Protocol 2', 'implementation_status': 'unreviewed'}\\n900258 SSH設定 SSH伺服器 限制存取SSH {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 9, 'ordinal': '5', 'gcb_id': 'TWGCB-01-012-0258', 'category': 'SSH設定', 'title': '限制存取SSH', 'description': '這項原則設定決定是否啟用限制存取SSH功能\\\\n/etc/ssh/sshd_config檔案可設定以下參數，以限制可透過SSH存取系統的使用者與群組：\\\\nAllowUsers：由空格分隔的使用者名稱組成，設定允許登入的使用者\\\\nAllowGroups：由空格分隔的群組名稱組成，設定允許登入的群組\\\\nDenyUsers：由空格分隔的使用者名稱組成，設定拒絕登入的使用者\\\\nDenyGroups：由空格分隔的群組名稱組成，設定拒絕登入的群組\\\\n啟用限制存取SSH功能，有助於確保只有授權使用者才能透過SSH遠端存取系統', 'configuration_method': '編輯/etc/ssh/sshd_config檔案，設定參數如下：\\\\nAllowUsers (使用者清單)\\\\nAllowGroups (群組清單)\\\\nDenyUsers (使用者清單)\\\\nDenyGroups (使用者清單)\\\\nAllowUsers參數設定smith與jones使用者的範例如下：\\\\nAllowUsers smith jones\\\\n開啟終端機，執行以下指令，重新啟動SSH服務使其生效：\\\\n#systemctl restart sshd\\\\n注意：請先通知SSH服務使用者，再重啟SSH服務，以避免影響使用者作業', 'expected': '啟用', 'implementation_status': 'unreviewed'}\\n900259 SSH設定 SSH伺服器 SSH主機私鑰檔案所有權 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 10, 'ordinal': '6', 'gcb_id': 'TWGCB-01-012-0259', 'category': 'SSH設定', 'title': 'SSH主機私鑰檔案所有權', 'description': '這項原則設定決定SSH主機私鑰檔案擁有者與群組\\\\nSSH主機私鑰是SSH協定中驗證主機所使用的加密金鑰，搭配公鑰與私鑰可鑑別使用者身分\\\\n設定SSH主機私鑰檔案擁有者與群組，避免遭未經授權的使用者取得檔案，用以假冒主機對用戶端進行中間人攻擊', 'configuration_method': \\\"開啟終端機，執行以下指令，設定SSH主機私鑰檔案擁有者與群組：\\\\n#find /etc/ssh -xdev -type f -name 'ssh_host_*_key' -exec chown root:ssh_keys {} \\\\\\\\;\\\", 'expected': 'root:ssh_keys', 'implementation_status': 'unreviewed'}\\n900260 SSH設定 SSH伺服器 SSH主機私鑰檔案權限 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 11, 'ordinal': '7', 'gcb_id': 'TWGCB-01-012-0260', 'category': 'SSH設定', 'title': 'SSH主機私鑰檔案權限', 'description': '這項原則設定決定是否設定SSH主機私鑰檔案權限\\\\nSSH主機私鑰是SSH協定中驗證主機所使用的加密金鑰，搭配公鑰與私鑰可鑑別使用者身分\\\\n設定SSH主機私鑰檔案權限，避免遭未經授權的使用者取得檔案，用以假冒主機對用戶端進行中間人攻擊', 'configuration_method': \\\"開啟終端機，執行以下指令，設定SSH主機私鑰檔案權限為600或更低權限：\\\\n#find /etc/ssh -xdev -type f -name 'ssh_host_*_key' -exec chmod 640 {} \\\\\\\\;\\\", 'expected': '640或更低權限', 'implementation_status': 'unreviewed'}\\n900261 SSH設定 SSH伺服器 SSH主機公鑰檔案所有權 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 12, 'ordinal': '8', 'gcb_id': 'TWGCB-01-012-0261', 'category': 'SSH設定', 'title': 'SSH主機公鑰檔案所有權', 'description': '這項原則設定決定SSH主機公鑰檔案擁有者與群組\\\\nSSH主機公鑰是SSH協定中驗證主機所使用的加密金鑰，搭配公鑰與私鑰可鑑別使用者身分\\\\n設定SSH主機公鑰檔案擁有者與群組，避免遭未經授權的使用者修改檔案，導致主機SSH服務無法正常運作', 'configuration_method': \\\"開啟終端機，執行以下指令，設定SSH主機公鑰檔案擁有者與群組：\\\\n#find /etc/ssh -xdev -type f -name 'ssh_host_*_key.pub' -exec chown root:root {} \\\\\\\\;\\\", 'expected': 'root:root', 'implementation_status': 'unreviewed'}\\n900262 SSH設定 SSH伺服器 SSH主機公鑰檔案權限 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 13, 'ordinal': '9', 'gcb_id': 'TWGCB-01-012-0262', 'category': 'SSH設定', 'title': 'SSH主機公鑰檔案權限', 'description': '這項原則設定決定是否設定SSH主機公鑰檔案權限\\\\nSSH主機公鑰是SSH協定中驗證主機所使用的加密金鑰，搭配公鑰與私鑰可鑑別使用者身分\\\\n設定SSH主機公鑰檔案權限，避免遭未經授權的使用者修改檔案，導致主機SSH服務無法正常運作', 'configuration_method': \\\"開啟終端機，執行以下指令，設定SSH主機公鑰檔案權限為644或更低權限：\\\\n#find /etc/ssh -xdev -type f -name 'ssh_host_*_key.pub' -exec chmod 644 {} \\\\\\\\;\\\", 'expected': '644或更低權限', 'implementation_status': 'unreviewed'}\\n900263 SSH設定 SSH伺服器 SSH加密演算法 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 14, 'ordinal': '10', 'gcb_id': 'TWGCB-01-012-0263', 'category': 'SSH設定', 'title': 'SSH加密演算法', 'description': '這項原則設定決定SSH所採用之加密演算法\\\\nCiphers參數可設定SSH-2協定可使用的加密演算法，支援演算法包含3des-cbc、aes128-cbc、aes192-cbc、aes256-cbc、aes128-ctr、aes192-ctr、aes256-ctr、arcfour128、arcfour256、arcfour、blowfish-cbc及st128-cbc\\\\nMACS參數可設定MAC(Message Authentication Codes)可使用的雜湊演算法\\\\nKexAlgorithm參數可設定金鑰交換演算法\\\\n設定SSH加密演算法，以加密方式保護傳輸資訊，以防攻擊者藉由封包攔截進而取得明文機敏資訊', 'configuration_method': '編輯/etc/crypto-policies/back-ends/opensshserver.config檔案，新增或修改成以下內容：\\\\n-oCiphers aes128-ctr,aes192-ctr,aes256-ctr\\\\n-oMACS=hmac-sha2-512,hmac-sha2-256\\\\n-oKexAlgorithms=ecdh-sha2-nistp256,ecdh-sha2-nistp384,ecdh-sha2-nistp521,diffie-hellman-group-exchange-sha256,diffie-hellman-group14-sha256,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512\\\\n開啟終端機，執行以下指令，重新啟動SSH服務使其生效：\\\\n#systemctl restart sshd\\\\n注意：請先通知SSH服務使用者，再重啟SSH服務，以避免影響使用者作業', 'expected': 'aes128-ctr,aes192-ctr,aes256-ctr', 'implementation_status': 'unreviewed'}\\n900264 SSH設定 SSH伺服器 SSH日誌記錄等級 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 15, 'ordinal': '11', 'gcb_id': 'TWGCB-01-012-0264', 'category': 'SSH設定', 'title': 'SSH日誌記錄等級', 'description': '這項原則設定決定SSH日誌記錄等級，在/etc/ssh/sshd_config檔案中，使用LogLevel參數可設定SSH日誌的記錄等級，選項依照紀錄詳細程度由上至下排序如下，QUIET等級為基本紀錄，DEBUG3等級將包含最詳細紀錄：\\\\nQUIET\\\\nFATAL\\\\nERROR\\\\nINFO\\\\nVERBOSE\\\\nDEBUG\\\\nDEBUG1\\\\nDEBUG2\\\\nDEBUG3\\\\nINFO等級為記錄SSH使用者登入活動的基本級別，可用於確定特定使用者何時在系統上處於活動狀態\\\\nVERBOSE等級為記錄登入與登出活動，以及用於登入的任何SSH金鑰指紋，可使用於管理SSH金鑰', 'configuration_method': '編輯/etc/ssh/sshd_config檔案，設定參數如下：\\\\nLogLevel VERBOSE\\\\n或\\\\nLogLevel INFO\\\\n開啟終端機，執行以下指令，重新啟動SSH服務使其生效：\\\\n#systemctl restart sshd\\\\n注意：請先通知SSH服務使用者，再重啟SSH服務，以避免影響使用者作業', 'expected': 'VERBOSE或INFO', 'implementation_status': 'unreviewed'}\\n900265 SSH設定 SSH伺服器 SSH X11Forwarding功能 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 16, 'ordinal': '12', 'gcb_id': 'TWGCB-01-012-0265', 'category': 'SSH設定', 'title': 'SSH X11Forwarding功能', 'description': '這項原則設定決定SSH是否啟用X11Forwarding功能\\\\nX11Forwarding功能用於與X11建立通道，以啟用遠端圖形介面連線\\\\n設定X11Forwarding參數為no，以停用遠端圖形介面連線功能\\\\n對於允許使用者登入的X11遠端伺服器而言，可能遭伺服器上其他使用者攻擊', 'configuration_method': '編輯/etc/ssh/sshd_config檔案，設定參數如下：\\\\nX11Forwarding no\\\\n開啟終端機，執行以下指令，重新啟動SSH服務使其生效：\\\\n#systemctl restart sshd\\\\n注意：請先通知SSH服務使用者，再重啟SSH服務，以避免影響使用者作業', 'expected': 'no', 'implementation_status': 'unreviewed'}\\n900266 SSH設定 SSH伺服器 SSH MaxAuthTries參數 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 17, 'ordinal': '13', 'gcb_id': 'TWGCB-01-012-0266', 'category': 'SSH設定', 'title': 'SSH MaxAuthTries參數', 'description': '這項原則設定決定SSH是否設定MaxAuthTries參數\\\\nMaxAuthTries參數用以指定每個連接允許的驗證登入失敗次數，當登入失敗次數達到一半時，錯誤訊息將會寫入日誌檔案，詳細說明登入失敗過程\\\\n建議將MaxAuthTries參數設定為較小的值，以降低針對SSH伺服器成功進行暴力攻擊之風險', 'configuration_method': '編輯/etc/ssh/sshd_config檔案，設定參數如下：\\\\nMaxAuthTries 4\\\\n開啟終端機，執行以下指令，重新啟動SSH服務使其生效：\\\\n#systemctl restart sshd\\\\n注意：請先通知SSH服務使用者，再重啟SSH服務，以避免影響使用者作業', 'expected': '4以下，但須大於0', 'implementation_status': 'unreviewed'}\\n900267 SSH設定 SSH伺服器 SSH IgnoreRhosts參數 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 18, 'ordinal': '14', 'gcb_id': 'TWGCB-01-012-0267', 'category': 'SSH設定', 'title': 'SSH IgnoreRhosts參數', 'description': '這項原則設定決定SSH是否設定IgnoreRhosts參數\\\\nIgnoreRhosts參數指定在RhostsRSAAuthentication或HostbasedAuthentication鑑別過程中，將不使用.rhosts與.shosts檔案\\\\n設定IgnoreRhosts參數為yes，強制使用者在使用SSH進行身分鑑別時須輸入通行碼', 'configuration_method': '編輯/etc/ssh/sshd_config檔案，設定參數如下：\\\\nIgnoreRhosts yes\\\\n開啟終端機，執行以下指令，重新啟動SSH服務使其生效：\\\\n#systemctl restart sshd\\\\n注意：請先通知SSH服務使用者，再重啟SSH服務，以避免影響使用者作業', 'expected': 'yes', 'implementation_status': 'unreviewed'}\\n900268 SSH設定 SSH伺服器 SSH HostbasedAuthentication參數 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 19, 'ordinal': '15', 'gcb_id': 'TWGCB-01-012-0268', 'category': 'SSH設定', 'title': 'SSH HostbasedAuthentication參數', 'description': '這項原則設定決定SSH是否設定HostbasedAuthentication參數，以指定是否使用基於主機之身分鑑別方式\\\\n此參數僅適用於SSH-2協定\\\\n基於主機的身分鑑別方式較不安全，建議停用', 'configuration_method': '編輯/etc/ssh/sshd_config檔案，設定參數如下：\\\\nHostbasedAuthentication no\\\\n開啟終端機，執行以下指令，重新啟動SSH服務使其生效：\\\\n#systemctl restart sshd\\\\n注意：請先通知SSH服務使用者，再重啟SSH服務，以避免影響使用者作業', 'expected': 'no', 'implementation_status': 'unreviewed'}\\n900271 SSH設定 SSH伺服器 SSH PermitUserEnvironment參數 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 22, 'ordinal': '18', 'gcb_id': 'TWGCB-01-012-0271', 'category': 'SSH設定', 'title': 'SSH PermitUserEnvironment參數', 'description': '這項原則設定決定SSH是否設定PermitUserEnvironment參數\\\\nPermitUserEnvironment參數決定是否允許使用者可藉由SSH守護程序變更環境設定\\\\n禁止使用者藉由SSH守護程序變更環境設定，以避免使用者得以繞過系統存取限制', 'configuration_method': '編輯/etc/ssh/sshd_config檔案，設定參數如下：\\\\nPermitUserEnvironment no\\\\n開啟終端機，執行以下指令，重新啟動SSH服務使其生效：\\\\n#systemctl restart sshd\\\\n注意：請先通知SSH服務使用者，再重啟SSH服務，以避免影響使用者作業', 'expected': 'no', 'implementation_status': 'unreviewed'}\\n900272 SSH設定 SSH伺服器 SSH逾時時間 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 23, 'ordinal': '19', 'gcb_id': 'TWGCB-01-012-0272', 'category': 'SSH設定', 'title': 'SSH逾時時間', 'description': '這項原則設定決定是否設定SSH逾時時間\\\\nClientAliveInterval與ClientAliveCountMax參數可控制SSH連線逾時時間\\\\n設定ClientAliveInterval參數後，在指定的時間內沒有任何活動將中斷SSH連線\\\\n設定ClientAliveCountMax參數後，SSH守護程序將在每個ClientAliveInterval指定時間到達時，向用戶端發送訊息，若發送訊息次數到達該參數設定值時，用戶端都沒有回應，則中斷SSH連線\\\\n舉例若ClientAliveInterval設為15秒，ClientAliveCountMax設為3時，用戶端若連續45秒都沒有回應，則中斷SSH連線', 'configuration_method': '編輯/etc/ssh/sshd_config檔案，設定參數如下：\\\\nClientAliveInterval 600\\\\nClientAliveCountMax 1\\\\n開啟終端機，執行以下指令，重新啟動SSH服務使其生效：\\\\n#systemctl restart sshd\\\\n注意：請先通知SSH服務使用者，再重啟SSH服務，以避免影響使用者作業', 'expected': 'ClientAliveInterval設為600以下，但須大於0，且ClientAliveCountMax設為1', 'implementation_status': 'unreviewed'}\\n900273 SSH設定 SSH伺服器 SSH LoginGraceTime參數 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 24, 'ordinal': '20', 'gcb_id': 'TWGCB-01-012-0273', 'category': 'SSH設定', 'title': 'SSH LoginGraceTime參數', 'description': '這項原則設定決定SSH是否設定LoginGraceTime參數，用以限定當使用者連上SSH伺服器後，多少時間內若未成功登入，則中斷SSH連線\\\\n設定登入逾時時間(單位為秒)，以避免未經授權使用者長久占據連線資源，導致其他使用者無法連線', 'configuration_method': '編輯/etc/ssh/sshd_config檔案，設定參數如下：\\\\nLoginGraceTime 60\\\\n開啟終端機，執行以下指令，重新啟動SSH服務使其生效：\\\\n#systemctl restart sshd\\\\n注意：請先通知SSH服務使用者，再重啟SSH服務，以避免影響使用者作業', 'expected': '60以下，但須大於0', 'implementation_status': 'unreviewed'}\\n900274 SSH設定 SSH伺服器 SSH UsePAM參數 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 25, 'ordinal': '21', 'gcb_id': 'TWGCB-01-012-0274', 'category': 'SSH設定', 'title': 'SSH UsePAM參數', 'description': '這項原則設定決定SSH是否啟用PAM(Pluggable Authentication Module，啟用插入式鑑別模組) 鑑別\\\\n啟用PAM身分鑑別可提升系統鑑別功能與安全性', 'configuration_method': '編輯/etc/ssh/sshd_config檔案，設定參數如下：\\\\nUsePAM yes\\\\n開啟終端機，執行以下指令，重新啟動SSH服務使其生效：\\\\n#systemctl restart sshd\\\\n注意：請先通知SSH服務使用者，再重啟SSH服務，以避免影響使用者作業', 'expected': 'yes', 'implementation_status': 'unreviewed'}\\n900275 SSH設定 SSH伺服器 SSH AllowTcpForwarding參數 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 26, 'ordinal': '22', 'gcb_id': 'TWGCB-01-012-0275', 'category': 'SSH設定', 'title': 'SSH AllowTcpForwarding參數', 'description': '這項原則設定決定SSH是否設定AllowTcpForwarding參數\\\\nAllowTcpForwarding參數用於設定SSH埠轉發(port forwarding)功能，將應用程序埠從用戶端隧道傳輸到伺服器，或將伺服器傳輸到用戶端\\\\n停用SSH埠轉發功能，避免攻擊者或惡意程式利用SSH隱藏未經授權連線，或將竊取資料傳出', 'configuration_method': '編輯/etc/ssh/sshd_config檔案，設定參數如下：\\\\nAllowTcpForwarding no\\\\n開啟終端機，執行以下指令，重新啟動SSH服務使其生效：\\\\n#systemctl restart sshd\\\\n注意：請先通知SSH服務使用者，再重啟SSH服務，以避免影響使用者作業', 'expected': 'no', 'implementation_status': 'unreviewed'}\\n900276 SSH設定 SSH伺服器 SSH MaxStartups參數 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 27, 'ordinal': '23', 'gcb_id': 'TWGCB-01-012-0276', 'category': 'SSH設定', 'title': 'SSH MaxStartups參數', 'description': '這項原則設定決定SSH是否設定MaxStartups參數，用以指定SSH守護程序同一時間可接受未經身分鑑別連線之最大數量\\\\n限制同一時間可接受之未經身分鑑別連線數量，以避免未經授權使用者長久占據連線資源，導致其他使用者無法連線', 'configuration_method': '編輯/etc/ssh/sshd_config檔案，設定參數如下，當未經身分鑑別連線數量達到10個後，將以30%機率拒絕後續連線；當未經身分鑑別連線數量達到60個後，將全部拒絕後續連線： \\\\nmaxstartups 10:30:60\\\\n開啟終端機，執行以下指令，重新啟動SSH服務使其生效：\\\\n#systemctl restart sshd\\\\n注意：請先通知SSH服務使用者，再重啟SSH服務，以避免影響使用者作業', 'expected': '10:30:60', 'implementation_status': 'unreviewed'}\\n900277 SSH設定 SSH伺服器 SSH MaxSessions參數 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 28, 'ordinal': '24', 'gcb_id': 'TWGCB-01-012-0277', 'category': 'SSH設定', 'title': 'SSH MaxSessions參數', 'description': '這項原則設定決定SSH是否設定MaxSessions參數，用以指定每個網路連線允許的最大會談數\\\\n限制每個網路連線允許的最大會談數，以保護系統避免由於同時間建立大量連線，而導致系統無法繼續提供服務', 'configuration_method': '編輯/etc/ssh/sshd_config檔案，設定參數如下：\\\\nMaxSessions 4\\\\n開啟終端機，執行以下指令，重新啟動SSH服務使其生效：\\\\n#systemctl restart sshd\\\\n注意：請先通知SSH服務使用者，再重啟SSH服務，以避免影響使用者作業', 'expected': '4以下，但須大於0', 'implementation_status': 'unreviewed'}\\n900278 SSH設定 SSH伺服器 SSH StrictModes參數 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 29, 'ordinal': '25', 'gcb_id': 'TWGCB-01-012-0278', 'category': 'SSH設定', 'title': 'SSH StrictModes參數', 'description': '這項原則設定決定SSH是否設定StrictModes參數，用以指定SSH守護程序在接受登入之前，是否檢查使用者家目錄與檔案之所有權與權限\\\\n設定SSH守護程序檢查使用者家目錄與檔案之所有權與權限，以避免使用者目錄或檔案具有全域寫入權限，而導致遭竄改設定', 'configuration_method': '編輯/etc/ssh/sshd_config檔案，新增或修改StrictModes參數為以下內容：\\\\nStrictModes yes\\\\n開啟終端機，執行以下指令，重新啟動SSH服務使其生效：\\\\n#systemctl restart sshd\\\\n注意：請先通知SSH服務使用者，再重啟SSH服務，以避免影響使用者作業', 'expected': 'yes', 'implementation_status': 'unreviewed'}\\n900279 SSH設定 SSH伺服器 SSH Compression參數 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 30, 'ordinal': '26', 'gcb_id': 'TWGCB-01-012-0279', 'category': 'SSH設定', 'title': 'SSH Compression參數', 'description': '這項原則設定決定SSH是否設定Compression參數，用以指定在使用者成功認證之前是否支援壓縮\\\\n設定SSH守護程序在使用者通過身分鑑別前不能執行壓縮，避免因壓縮軟體漏洞而導致系統遭受攻擊', 'configuration_method': '編輯/etc/ssh/sshd_config檔案，新增或修改Compression參數為「delayed」或「no」，範例如下：\\\\nCompression no\\\\n開啟終端機，執行以下指令，重新啟動SSH服務使其生效：\\\\n#systemctl restart sshd\\\\n注意：請先通知SSH服務使用者，再重啟SSH服務，以避免影響使用者作業', 'expected': 'delayed或no', 'implementation_status': 'unreviewed'}\\n900280 SSH設定 SSH伺服器 SSH IgnoreUserKnownHosts參數 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 31, 'ordinal': '27', 'gcb_id': 'TWGCB-01-012-0280', 'category': 'SSH設定', 'title': 'SSH IgnoreUserKnownHosts參數', 'description': '這項原則設定決定SSH是否設定IgnoreUserKnownHosts參數，用以指定在RhostsRSAAuthentication或HostbasedAuthentication鑑別過程中，不使用已知主機之身分鑑別\\\\n不使用已知主機之身分鑑別，以強制使用者在使用SSH遠端登入時須輸入通行碼', 'configuration_method': '編輯/etc/ssh/sshd_config檔案，新增或修改成以下內容：\\\\nIgnoreUserKnownHosts yes\\\\n開啟終端機，執行以下指令，重新啟動SSH服務使其生效：\\\\n#systemctl restart sshd\\\\n注意：請先通知SSH服務使用者，再重啟SSH服務，以避免影響使用者作業', 'expected': 'yes', 'implementation_status': 'unreviewed'}\\n900281 SSH設定 SSH伺服器 SSH PrintLastLog參數 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 32, 'ordinal': '28', 'gcb_id': 'TWGCB-01-012-0281', 'category': 'SSH設定', 'title': 'SSH PrintLastLog參數', 'description': '這項原則設定決定SSH是否設定PrintLastLog參數，用以指定當使用者登入系統時，SSH守護程序是否顯示上次使用者登入之日期與時間\\\\n顯示使用者上次以SSH登入之日期與時間，有助於使用者及早發現帳號被盜用之情形', 'configuration_method': '編輯/etc/ssh/sshd_config檔案，新增或修改成以下內容：\\\\nPrintLastLog yes\\\\n開啟終端機，執行以下指令，重新啟動SSH服務使其生效：\\\\n#systemctl restart sshd\\\\n注意：請先通知SSH服務使用者，再重啟SSH服務，以避免影響使用者作業', 'expected': 'yes', 'implementation_status': 'unreviewed'}\\n900282 SSH設定 SSH伺服器 shosts.equiv檔案 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 33, 'ordinal': '29', 'gcb_id': 'TWGCB-01-012-0282', 'category': 'SSH設定', 'title': 'shosts.equiv檔案', 'description': '這項原則設定決定是否移除shosts.equiv檔案\\\\n當使用者進行SSH連線所使用電腦之名稱已經列在shosts.equiv檔案中時，若兩端的使用者名稱相同，則立即允許該使用者登入，此種基於主機之身分鑑別方式無需使用者輸入通行碼，容易遭偽冒身分\\\\n移除shosts.equiv檔案，以強化使用者登入身分鑑別機制', 'configuration_method': '開啟終端機，執行以下指令，尋找任何「shosts.equiv」檔案：\\\\n#find / -name shosts.equiv\\\\n若發現「shosts.equiv」檔案，執行指令移除檔案，範例如下：\\\\n#rm /etc/ssh/shosts.equiv', 'expected': '移除', 'implementation_status': 'unreviewed'}\\n900283 SSH設定 SSH伺服器 .shosts檔案 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 34, 'ordinal': '30', 'gcb_id': 'TWGCB-01-012-0283', 'category': 'SSH設定', 'title': '.shosts檔案', 'description': '這項原則設定決定是否移除「.shosts」檔案\\\\n「.shosts」檔案用於設定SSH為單一使用者或使用基於主機之身分鑑別方式，因登入過程中無需使用者輸入通行碼，容易遭偽冒身分\\\\n移除「.shosts」檔案，以強化使用者登入身分鑑別機制', 'configuration_method': \\\"開啟終端機，執行以下指令，尋找任何「.shosts」檔案：\\\\n#find / -name '*.shosts'\\\\n若發現「.shosts」檔案，執行指令移除檔案，範例如下：\\\\n#rm $HOME/.shosts\\\", 'expected': '移除', 'implementation_status': 'unreviewed'}\\n900284 SSH設定 SSH伺服器 覆寫全系統加密原則 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 35, 'ordinal': '31', 'gcb_id': 'TWGCB-01-012-0284', 'category': 'SSH設定', 'title': '覆寫全系統加密原則', 'description': '這項原則設定決定是否覆寫全系統加密原則，在SSH系統可設為覆寫或不使用全系統加密原則\\\\n設定SSH系統停用覆寫全系統加密原則，以避免SSH使用到安全強度較低之加密演算法', 'configuration_method': '開啟終端機，執行以下指令，以停用覆寫全系統加密原則：\\\\n#sed -ri \\\"s/^\\\\\\\\s*(CRYPTO_POLICY\\\\\\\\s*=.*)$/# \\\\\\\\1/\\\" /etc/sysconfig/sshd\\\\n執行以下指令，重新啟動SSH服務使其生效：\\\\n#systemctl restart sshd\\\\n注意：請先通知SSH服務使用者，再重啟SSH服務，以避免影響使用者作業', 'expected': '停用', 'implementation_status': 'unreviewed'}\\n900315 SSH設定 SSH伺服器 停用GSSAPI驗證 {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 36, 'ordinal': '32', 'gcb_id': 'TWGCB-01-012-0315', 'category': 'SSH設定', 'title': '停用GSSAPI驗證', 'description': '這項原則設定決定是否停用GSSAPI驗證\\\\nGSSAPI允許使用者透過現有網路憑證進行身分驗證，無需在每次連接時輸入密碼，主要用於跨多系統之身分驗證環境\\\\n停用GSSAPI，可能會導致無法使用Kerberos驗證', 'configuration_method': '編輯/etc/ssh/sshd_config檔案，新增或修改成以下內容：\\\\nGSSAPIAuthentication no', 'expected': '停用', 'implementation_status': 'unreviewed'}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./codex_p2b2.log:24:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_12\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"python3 - <<'PY'\\nimport json,collections\\nr=json.load(open('data/scope_registry.json'))\\nfor cat in ['SSH設定','cron設定','SELinux','安裝與維護軟體']:\\n a=[x for x in r if x['category']==cat]; print(cat,len(a),collections.Counter(x['implementation'] for x in a))\\nfor x in json.load(open('data/controls.json')):\\n if int(x['gcb_id'][-4:]) in [261,262,263,183]:print(x)\\nPY\\ncat linuxgcb/__main__.py; cat tests/test_report.py | head -100; git status --short\\\"\",\"aggregated_output\":\"SSH設定 32 Counter({'pending': 28, 'candidate': 4})\\ncron設定 16 Counter({'candidate': 12, 'pending': 4})\\nSELinux 7 Counter({'pending': 6, 'candidate': 1})\\n安裝與維護軟體 6 Counter({'pending': 6})\\n{'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': '基本項目', 'row': 186, 'ordinal': '182', 'gcb_id': 'TWGCB-01-012-0183', 'category': 'SELinux', 'title': 'SELinux套件', 'description': '這項原則設定決定是否安裝SELinux(Security-Enhanced Linux，安全增強Linux)套件\\\\nSELinux是一個Linux核心安全模組，提供強制存取控制(MAC)安全性原則，可強制Linux系統中的檔案與程序依據定義的原則限制存取行為，啟用SELinux有助於提升伺服器安全性', 'configuration_method': '開啟終端機，執行以下指令安裝SELinux：\\\\n#dnf install libselinux', 'expected': '安裝', 'implementation_status': 'unreviewed'}\\n{'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 12, 'ordinal': '8', 'gcb_id': 'TWGCB-01-012-0261', 'category': 'SSH設定', 'title': 'SSH主機公鑰檔案所有權', 'description': '這項原則設定決定SSH主機公鑰檔案擁有者與群組\\\\nSSH主機公鑰是SSH協定中驗證主機所使用的加密金鑰，搭配公鑰與私鑰可鑑別使用者身分\\\\n設定SSH主機公鑰檔案擁有者與群組，避免遭未經授權的使用者修改檔案，導致主機SSH服務無法正常運作', 'configuration_method': \\\"開啟終端機，執行以下指令，設定SSH主機公鑰檔案擁有者與群組：\\\\n#find /etc/ssh -xdev -type f -name 'ssh_host_*_key.pub' -exec chown root:root {} \\\\\\\\;\\\", 'expected': 'root:root', 'implementation_status': 'unreviewed'}\\n{'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 13, 'ordinal': '9', 'gcb_id': 'TWGCB-01-012-0262', 'category': 'SSH設定', 'title': 'SSH主機公鑰檔案權限', 'description': '這項原則設定決定是否設定SSH主機公鑰檔案權限\\\\nSSH主機公鑰是SSH協定中驗證主機所使用的加密金鑰，搭配公鑰與私鑰可鑑別使用者身分\\\\n設定SSH主機公鑰檔案權限，避免遭未經授權的使用者修改檔案，導致主機SSH服務無法正常運作', 'configuration_method': \\\"開啟終端機，執行以下指令，設定SSH主機公鑰檔案權限為644或更低權限：\\\\n#find /etc/ssh -xdev -type f -name 'ssh_host_*_key.pub' -exec chmod 644 {} \\\\\\\\;\\\", 'expected': '644或更低權限', 'implementation_status': 'unreviewed'}\\n{'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': 'SSH伺服器', 'row': 14, 'ordinal': '10', 'gcb_id': 'TWGCB-01-012-0263', 'category': 'SSH設定', 'title': 'SSH加密演算法', 'description': '這項原則設定決定SSH所採用之加密演算法\\\\nCiphers參數可設定SSH-2協定可使用的加密演算法，支援演算法包含3des-cbc、aes128-cbc、aes192-cbc、aes256-cbc、aes128-ctr、aes192-ctr、aes256-ctr、arcfour128、arcfour256、arcfour、blowfish-cbc及st128-cbc\\\\nMACS參數可設定MAC(Message Authentication Codes)可使用的雜湊演算法\\\\nKexAlgorithm參數可設定金鑰交換演算法\\\\n設定SSH加密演算法，以加密方式保護傳輸資訊，以防攻擊者藉由封包攔截進而取得明文機敏資訊', 'configuration_method': '編輯/etc/crypto-policies/back-ends/opensshserver.config檔案，新增或修改成以下內容：\\\\n-oCiphers aes128-ctr,aes192-ctr,aes256-ctr\\\\n-oMACS=hmac-sha2-512,hmac-sha2-256\\\\n-oKexAlgorithms=ecdh-sha2-nistp256,ecdh-sha2-nistp384,ecdh-sha2-nistp521,diffie-hellman-group-exchange-sha256,diffie-hellman-group14-sha256,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512\\\\n開啟終端機，執行以下指令，重新啟動SSH服務使其生效：\\\\n#systemctl restart sshd\\\\n注意：請先通知SSH服務使用者，再重啟SSH服務，以避免影響使用者作業', 'expected': 'aes128-ctr,aes192-ctr,aes256-ctr', 'implementation_status': 'unreviewed'}\\n\\\"\\\"\\\"python3 -m linuxgcb：完全離線，不執行 SCA 命令。\\\"\\\"\\\"\\nimport argparse\\nimport json\\nfrom datetime import datetime, timezone\\nfrom pathlib import Path\\nfrom .catalog import write_registry\\nfrom .policy import build, validate\\nfrom .report import render\\nfrom .collector import timestamp\\nfrom .snapshot import convert\\n\\n\\ndef main():\\n    parser = argparse.ArgumentParser(description='LinuxGCB 離線工具（未完成真機驗收）')\\n    sub = parser.add_subparsers(dest='command', required=True)\\n    sub.add_parser('build', help='驗證來源並重建 registry 與候選政策')\\n    sub.add_parser('validate', help='離線結構與來源檢查，非引擎驗收')\\n    report = sub.add_parser('report', help='匯入離線 JSON，輸出 HTML/CSV 與稽核副本')\\n    report.add_argument('snapshot')\\n    report.add_argument('--out', required=True)\\n    report.add_argument('--now', help='固定報表時間，ISO8601 含時區')\\n    snapshot = sub.add_parser('snapshot', help='離線 Manager DB JSON 轉 snapshot v1')\\n    snapshot.add_argument('manager_dump')\\n    snapshot.add_argument('--out', required=True)\\n    snapshot.add_argument('--scan-info', help='同次離線 sca_scan_info JSON，依 policy_id 對應 end_scan')\\n    args = parser.parse_args()\\n    if args.command == 'build':\\n        rows = write_registry()\\n        build()\\n        print(f'314 項；307 候選／7 排除；{validate()} 項候選規則，UNVALIDATED／人工審查待完成')\\n    elif args.command == 'validate':\\n        print('UNVALIDATED：離線結構檢查通過，候選控制項數', validate())\\n    elif args.command == 'snapshot':\\n        validate()\\n        result = convert(args.manager_dump, json.loads(Path(args.scan_info).read_text()) if args.scan_info else None)\\n        target = Path(args.out)\\n        target.parent.mkdir(parents=True, exist_ok=True)\\n        target.write_text(json.dumps(result, ensure_ascii=False, indent=2)+'\\\\n')\\n        print(json.dumps(result['warnings'], ensure_ascii=False))\\n    else:\\n        validate()\\n        result = render(json.loads(Path(args.snapshot).read_text()), args.out,\\n                        timestamp(args.now) if args.now else datetime.now(timezone.utc))\\n        print(json.dumps(result, ensure_ascii=False, indent=2))\\n\\nif __name__ == '__main__':\\n    main()\\nimport copy\\nimport csv\\nimport json\\nimport tempfile\\nimport unittest\\nfrom datetime import datetime,timezone\\nfrom pathlib import Path\\nfrom linuxgcb.catalog import ROOT\\nfrom linuxgcb.report import normalize,metrics,render,safe_cell\\n\\nNOW=datetime(2026,10,30,tzinfo=timezone.utc)\\n\\n\\nclass ReportTests(unittest.TestCase):\\n    def setUp(self):\\n        self.fixture=json.loads((ROOT/'tests/fixtures/snapshot.json').read_text())\\n    def rows(self):return normalize(self.fixture,NOW)\\n    def test_full_inventory_status_and_denominators(self):\\n        rows=self.rows();by={r['sca_id']:r for r in rows};m=metrics(rows)\\n        self.assertEqual(len(rows),314)\\n        self.assertEqual(m['counts']['EXCLUDED'],7)\\n        self.assertEqual(m['applicable'],307)\\n        self.assertEqual(m['counts'].get('PASS',0),0)\\n        self.assertEqual(m['counts']['FAIL'],1)\\n        self.assertEqual(by[900243]['state'],'ERROR')\\n        self.assertEqual(by[900108]['state'],'MANUAL_PENDING')\\n        self.assertEqual(by[900269]['state'],'MANUAL_PENDING')\\n        self.assertEqual(by[900270]['state'],'MANUAL_PENDING')\\n        self.assertTrue(by[900046]['exception_approved'])\\n        self.assertEqual(by[900046]['state'],'FAIL')\\n        self.assertEqual(m['completeness'],0.0)\\n        self.assertEqual(m['pass_rate'],None)\\n    def test_no_scan_and_stale(self):\\n        host=self.fixture['hosts'][0];host['checks']=[];host.pop('scanned_at')\\n        rows=self.rows();self.assertTrue(all(r['stale'] for r in rows))\\n        self.assertEqual(next(r for r in rows if r['sca_id']==900045)['state'],'NOT_SCANNED')\\n        host['checks']=[dict(id=900045,result='passed')]\\n        self.assertEqual(next(r for r in self.rows() if r['sca_id']==900045)['state'],'MANUAL_PENDING')\\n    def test_zero_denominator(self):\\n        m=metrics([])\\n        self.assertIsNone(m['pass_rate']);self.assertIsNone(m['completeness']);self.assertIsNone(m['attainment'])\\n    def test_approved_na_does_not_hide_failure_or_error(self):\\n        h=self.fixture['hosts'][0]\\n        approved=next(iter(h['exceptions'].values()))\\n        h['not_applicable']={f'TWGCB-01-012-{n:04d}':copy.deepcopy(approved) for n in (45,46,243)}\\n        by={r['sca_id']:r for r in self.rows()}\\n        self.assertEqual(by[900045]['state'],'NOT_APPLICABLE')\\n        self.assertEqual(by[900046]['state'],'FAIL')\\n        self.assertEqual(by[900243]['state'],'NOT_APPLICABLE')\\n        h['checks'][3]['execution_error']=True\\n        self.assertEqual(next(r for r in self.rows() if r['sca_id']==900243)['state'],'ERROR')\\n        h['not_applicable']['TWGCB-01-012-0045']['expires']='2020-01-01T00:00:00Z'\\n        self.assertEqual(next(r for r in self.rows() if r['sca_id']==900045)['state'],'MANUAL_PENDING')\\n    def test_unapproved_profiles_conservative(self):\\n        self.fixture['hosts'][0]['approved_profiles']=[]\\n        rows=self.rows();self.assertEqual(metrics(rows)['unresolved'],307)\\n        self.assertEqual(next(r for r in rows if r['sca_id']==900045)['state'],'MANUAL_PENDING')\\n    def test_invalid_snapshots_rejected(self):\\n        mutations=[lambda s:s.update(source_sha256='bad'),lambda s:s.update(policy_hashes={}),\\n            lambda s:s['hosts'].append(copy.deepcopy(s['hosts'][0])),\\n            lambda s:s['hosts'][0]['checks'].append(dict(id=123,result='passed')),\\n            lambda s:s['hosts'][0]['checks'].append(dict(id=900045,result='passed')),\\n            lambda s:s['hosts'][0]['checks'].append(dict(id=900001,result='passed'))]\\n        for mutate in mutations:\\n            s=copy.deepcopy(self.fixture);mutate(s)\\n            with self.assertRaises(ValueError):normalize(s,NOW)\\n    def test_html_csv_raw_integrity(self):\\n        before=copy.deepcopy(self.fixture)\\n        with tempfile.TemporaryDirectory() as d:\\n            render(self.fixture,d,NOW)\\n            page=(Path(d)/'report.html').read_text()\\n            self.assertNotIn('<script>',page)\\n            self.assertIn('&lt;script&gt;',page)\\n            self.assertIn('SYNTHETIC',page)\\n            with (Path(d)/'report.csv').open(encoding='utf-8-sig',newline='') as f:\\n                rows=list(csv.DictReader(f))\\n            self.assertEqual(len(rows),314)\\n            bad=next(r for r in rows if r['sca_id']=='900046')\\n            self.assertTrue(bad['raw_reason'].startswith(\\\"'=\\\"))\\n            self.assertEqual(json.loads((Path(d)/'snapshot.json').read_text()),before)\\n        self.assertEqual(self.fixture,before)\\n    def test_formula_vectors(self):\\n        for text in ('=1',' +1','\\\\t@evil','\\\\r-1','\\\\n=1','\\\\ufeff=1','\\\\v=1','\\\\x00@evil','\\\\u2003=1'):\\n            self.assertTrue(safe_cell(text).startswith(\\\"'\\\"))\\n        self.assertEqual(safe_cell('普通文字'),'普通文字')\\n    def test_multiple_host_weighted_counts(self):\\n        other=copy.deepcopy(self.fixture['hosts'][0]);other['agent_id']='SYNTHETIC-002';other['checks']=[]\\n        self.fixture['hosts'].append(other)\\n        self.assertEqual(metrics(self.rows())['applicable'],614)\\n        self.assertEqual(len(self.rows()),628)\\n\\n    def test_authored_controls_do_not_create_evidence(self):\\n        from linuxgcb.batch1 import ADDED\\n        by={r['sca_id']:r for r in self.rows()}\\n        for n in ADDED:\\n            self.assertIsNone(by[900000+n]['raw_result'])\\n            self.assertEqual(by[900000+n]['state'],'MANUAL_PENDING' if n==141 else 'NOT_SCANNED')\\n        self.fixture['hosts'][0]['checks'].append(dict(id=900141,result='passed'))\\n        self.assertEqual(next(r for r in self.rows() if r['sca_id']==900141)['state'],'MANUAL_PENDING')\\n        self.assertEqual(metrics(self.rows())['completeness'],0.0)\\n?? codex_p2b2.log\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./codex_p2b2.log:27:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_14\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc 'find .. -name AGENTS.md -print; cat tests/test_snapshot.py | head -70; cat linuxgcb/collector.py | head -130; cat scripts/inventory.py | head -110'\",\"aggregated_output\":\"../open-slide-demo/AGENTS.md\\nfind: ‘../soar-poc-candidate-p1/.scratch/p2’: Permission denied\\nfind: ‘../soar-poc-candidate-p1/.scratch/w4b-live’: Permission denied\\n\\\"\\\"\\\"REAL EVIDENCE agent010 R2；變異僅為記憶體中 test-only 負面測試。\\\"\\\"\\\"\\nimport copy\\nimport csv\\nimport json\\nimport tempfile\\nimport unittest\\nfrom collections import Counter\\nfrom datetime import datetime, timezone\\nfrom pathlib import Path\\nfrom linuxgcb.catalog import ROOT, digest\\nfrom linuxgcb.snapshot import convert, LABEL\\nfrom linuxgcb.report import normalize, render\\n\\nFIXTURE = ROOT/'tests/fixtures/realhost_r2.json'\\nFAIL_IDS = {900192,900194,900196,900198,900200,900202,900269}\\nNOW = datetime(2026,10,31,6,tzinfo=timezone.utc)\\n\\n\\nclass SnapshotTests(unittest.TestCase):\\n    def test_real_evidence_roundtrip(self):\\n        original = json.loads(FIXTURE.read_text())\\n        s = convert(FIXTURE)\\n        self.assertFalse(s['synthetic'])\\n        self.assertEqual(s['label'], LABEL)\\n        self.assertEqual(s['manager_dump_sha256'], digest(FIXTURE))\\n        host = s['hosts'][0]\\n        self.assertIsNone(host['scanned_at'])\\n        self.assertEqual(len(s['warnings']),3)\\n        self.assertEqual(Counter(c['result'] for c in host['checks']), {'passed':46,'failed':7})\\n        for c in host['checks']:\\n            self.assertEqual({k:v for k,v in c.items() if k not in ('policy_id', 'expected', 'expected_status')}, next(x for x in original[c['policy_id']]['checks'] if x['id']==c['id']))\\n        with tempfile.TemporaryDirectory() as d:\\n            summary=render(s,d,NOW)\\n            self.assertEqual(summary['counts']['FAIL'],7)\\n            self.assertEqual(summary['verified_decided'],0)\\n            self.assertIsNone(summary['pass_rate'])\\n            self.assertEqual(summary['completeness'],0)\\n            with (Path(d)/'report.csv').open(encoding='utf-8-sig',newline='') as f:\\n                failures=[r for r in csv.DictReader(f) if r['state']=='FAIL']\\n            self.assertEqual({int(r['sca_id']) for r in failures},FAIL_IDS)\\n            page=(Path(d)/'report.html').read_text()\\n            for r in failures:\\n                self.assertIn(r['gcb_id'],page)\\n                self.assertTrue(r['title'])\\n                self.assertTrue(r['command'])\\n                self.assertEqual(r['remediation_status'],'政策未提供 remediation')\\n            self.assertIn(LABEL,page)\\n    def test_scan_info_time_and_invalid_results(self):\\n        dump=json.loads(FIXTURE.read_text())\\n        info={pid:{'end_scan':'2026-10-31T12:03:00+08:00'} for pid in dump}\\n        s=convert(FIXTURE,info)\\n        self.assertEqual(s['hosts'][0]['scanned_at'],'2026-10-31T04:03:00+00:00')\\n        self.assertFalse(s['warnings'])\\n        for result in ('invalid','error','unexpected'):\\n            modified=copy.deepcopy(s)\\n            c=modified['hosts'][0]['checks'][0]\\n            c.update(result=result,reason='test-only raw reason')\\n            row=next(r for r in normalize(modified,NOW) if r['sca_id']==c['id'])\\n            self.assertEqual(row['state'],'ERROR')\\n            self.assertEqual(row['raw_result'],result)\\n            self.assertEqual(row['raw_reason'],'test-only raw reason')\\n    def test_invalid_time_rejected(self):\\n        pid=next(iter(json.loads(FIXTURE.read_text())))\\n        with self.assertRaises(ValueError):\\n            convert(FIXTURE,{pid:{'end_scan':'2026-10-31T12:03:00'}})\\n\\\"\\\"\\\"Manager SCA 唯讀收集抽象；無網路實作、憑證、排程或發佈副作用。\\\"\\\"\\\"\\nimport copy\\nimport hashlib\\nimport json\\nfrom datetime import datetime, timezone\\nfrom urllib.parse import quote\\n\\n\\nclass CollectionError(ValueError):\\n    pass\\n\\n\\ndef timestamp(value):\\n    t = datetime.fromisoformat(str(value).replace('Z', '+00:00'))\\n    if t.tzinfo is None:\\n        raise CollectionError('時間缺少時區，須先依已驗證 API schema 正規化')\\n    return t.astimezone(timezone.utc)\\n\\n\\nclass Collector:\\n    \\\"\\\"\\\"transport.get(path, params) -> Wazuh data envelope。\\n\\n    未來 transport 必須啟用 TLS 憑證與 hostname 驗證及逾時；此版只注入離線 fake。\\n    完整快照是回傳值；失敗以例外拒絕回傳，不發佈部分頁面。\\n    \\\"\\\"\\\"\\n    def __init__(self, transport, page_size=100, max_pages=10000):\\n        if page_size < 1 or max_pages < 1:\\n            raise ValueError('分頁界限必須為正數')\\n        self.transport, self.page_size, self.max_pages = transport, page_size, max_pages\\n\\n    def pages(self, path):\\n        items, raw, expected, offset = [], [], None, 0\\n        for _ in range(self.max_pages):\\n            try:\\n                response = copy.deepcopy(self.transport.get(path, {'offset': offset, 'limit': self.page_size}))\\n                data = response['data']\\n                batch, total = data['affected_items'], data['total_affected_items']\\n                if response.get('error', 0) or data.get('total_failed_items', 0) or data.get('failed_items'):\\n                    raise CollectionError('API 部分失敗')\\n                if not isinstance(total, int) or isinstance(total, bool) or total < 0 or not isinstance(batch, list):\\n                    raise CollectionError('分頁 schema 錯誤')\\n                if expected is None:\\n                    expected = total\\n                if total != expected or len(batch) > self.page_size or len(items)+len(batch) > total:\\n                    raise CollectionError('分頁總數不一致')\\n                raw.append(response)\\n                items.extend(batch)\\n                if len(items) == total:\\n                    return items, raw\\n                if not batch:\\n                    raise CollectionError('分頁提早結束')\\n                offset += len(batch)\\n            except CollectionError:\\n                raise\\n            except Exception as e:\\n                raise CollectionError('API/transport 讀取失敗') from e\\n        raise CollectionError('超出最大頁數')\\n\\n    def collect(self, agent_id, policy_id, policy_hash, now=None, max_age_seconds=86400):\\n        if not agent_id or not policy_id or not policy_hash or max_age_seconds < 0:\\n            raise CollectionError('缺少識別、政策 hash 或時效設定錯誤')\\n        now = now or datetime.now(timezone.utc)\\n        if now.tzinfo is None:\\n            raise CollectionError('擷取時間缺時區')\\n        path = '/sca/'+quote(str(agent_id), safe='')\\n        before, raw_before = self.pages(path)\\n        def select(rows):\\n            found = [r for r in rows if str(r.get('policy_id')) == policy_id]\\n            if len(found) != 1:\\n                raise CollectionError('政策不存在或重複')\\n            return found[0]\\n        summary = select(before)\\n        try:\\n            start, end = timestamp(summary['start_scan']), timestamp(summary['end_scan'])\\n            if start > end or end > now:\\n                raise CollectionError('掃描進行中或時間不合理')\\n            if summary['hash_file'] != policy_hash:\\n                raise CollectionError('政策 hash 不符')\\n            expected_count = summary['total_checks']\\n            if not isinstance(expected_count, int) or isinstance(expected_count, bool) or expected_count < 1:\\n                raise CollectionError('摘要控制項數量不合法')\\n        except (KeyError, TypeError, ValueError) as e:\\n            raise CollectionError('摘要缺少已驗證掃描時間/hash/數量') from e\\n        checks, raw_checks = self.pages(path+'/checks/'+quote(policy_id, safe=''))\\n        ids = [str(c.get('id')) for c in checks]\\n        if len(checks) != expected_count or len(set(ids)) != len(ids) or 'None' in ids:\\n            raise CollectionError('控制項缺漏或重複')\\n        after, raw_after = self.pages(path)\\n        if summary != select(after):\\n            raise CollectionError('掃描摘要變更；丟棄快照，呼叫端可有限次重試')\\n        canonical = json.dumps(dict(agent_id=agent_id, policy_id=policy_id, summary=summary,\\n            policy_hash=policy_hash, checks=sorted(checks, key=lambda c: str(c['id']))), sort_keys=True, separators=(',', ':'))\\n        return dict(snapshot_id=hashlib.sha256(canonical.encode()).hexdigest(), agent_id=agent_id,\\n                    policy_id=policy_id, policy_hash=policy_hash, summary=summary, checks=checks,\\n                    collected_at=now.isoformat(), stale=(now-end).total_seconds() > max_age_seconds,\\n                    complete=True, raw_pages=dict(before=raw_before, checks=raw_checks, after=raw_after))\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"Read XLSX with stdlib; preserve source cells and inventory GCB IDs.\\\"\\\"\\\"\\nimport collections\\nimport hashlib\\nimport json\\nfrom pathlib import Path\\nimport re\\nimport zipfile\\nimport xml.etree.ElementTree as ET\\n\\nROOT = Path(__file__).resolve().parents[1]\\nNS = {'s': 'http://schemas.openxmlformats.org/spreadsheetml/2006/main'}\\n\\ndef extract(path):\\n    records = []\\n    with zipfile.ZipFile(path) as z:\\n        strings = []\\n        if 'xl/sharedStrings.xml' in z.namelist():\\n            strings = [''.join(n.itertext()) for n in ET.fromstring(z.read('xl/sharedStrings.xml')).findall('s:si', NS)]\\n        rels = {r.attrib['Id']: r.attrib['Target'] for r in ET.fromstring(z.read('xl/_rels/workbook.xml.rels'))}\\n        wb = ET.fromstring(z.read('xl/workbook.xml'))\\n        for sheet in wb.findall('s:sheets/s:sheet', NS):\\n            rid = sheet.attrib['{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id']\\n            target = rels[rid]\\n            target = target.lstrip('/') if target.startswith('/') else 'xl/' + target\\n            for row in ET.fromstring(z.read(target)).findall('s:sheetData/s:row', NS):\\n                cells = {}\\n                for c in row.findall('s:c', NS):\\n                    match = re.match(r'[A-Z]+', c.attrib['r'])\\n                    if match is None:\\n                        raise ValueError('Invalid XLSX cell reference')\\n                    col = match.group()\\n                    v = c.find('s:v', NS)\\n                    value = (v.text or '') if v is not None else ''\\n                    if c.attrib.get('t') == 's':\\n                        value = strings[int(value)]\\n                    elif c.attrib.get('t') == 'inlineStr':\\n                        value = ''.join(t.text or '' for t in c.findall('.//s:t', NS))\\n                    cells[col] = value\\n                if re.fullmatch(r'TWGCB-\\\\d{2}-\\\\d{3}-\\\\d{4}', cells.get('B', '')):\\n                    records.append(dict(source_file=path.name, sheet=sheet.attrib['name'], row=int(row.attrib['r']),\\n                        ordinal=cells.get('A'), gcb_id=cells['B'], category=cells.get('C'), title=cells.get('D'),\\n                        description=cells.get('E'), configuration_method=cells.get('F'), expected=cells.get('G'),\\n                        implementation_status='unreviewed'))\\n    return records\\n\\ndef main():\\n    sources = sorted(ROOT.glob('*.xlsx'))\\n    records = [r for p in sources for r in extract(p)]\\n    counts = collections.Counter(r['gcb_id'] for r in records)\\n    summary = dict(total=len(records), unique_ids=len(counts), duplicate_ids=[k for k,v in counts.items() if v>1],\\n        categories=dict(collections.Counter(r['category'] for r in records)),\\n        sheets=dict(collections.Counter(r['sheet'] for r in records)),\\n        missing_required=[r['gcb_id'] for r in records if not all(r.get(k) for k in ('title','category','expected'))],\\n        source_sha256={p.name:hashlib.sha256(p.read_bytes()).hexdigest() for p in sources})\\n    out = ROOT/'data'\\n    out.mkdir(exist_ok=True)\\n    (out/'controls.json').write_text(json.dumps(records,ensure_ascii=False,indent=2)+'\\\\n')\\n    (out/'inventory.json').write_text(json.dumps(summary,ensure_ascii=False,indent=2)+'\\\\n')\\n    print(json.dumps(summary,ensure_ascii=False,indent=2))\\n    assert records and not summary['duplicate_ids'] and not summary['missing_required']\\n\\nif __name__ == '__main__':\\n    main()\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./codex_p2b2.log:28:{\"type\":\"item.started\",\"item\":{\"id\":\"item_15\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"mkdir -p /tmp/linuxgcb-batch2; python3 - <<'PY'\\nimport json,pathlib,hashlib\\nr=pathlib.Path('.')\\nchecks=[c for p in (r/'policies').glob('*.yml') for c in json.load(open(p))['checks']]\\n(r/'tests/fixtures/batch2_baseline.json').write_text(json.dumps({'
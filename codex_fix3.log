    continue\\n            checks.append(dict(id=row['sca_id'], title=row['gcb_id']+' '+row['title'],\\n                description=PREFIX+expected[row['gcb_id']]+(' ｜ BATCH2 執行審查 ' if row['sca_id']-900000 in BATCH2 else ' ｜ Q1 執行審查 ')+row['execution_review']+'；coverage='+row['coverage']+'；'+','.join(row['issue_ids'])+'；raw PASS 非已驗證符合。'+row['pending'],\\n                compliance=[{'twgcb': [row['gcb_id']]}], regex_type='pcre2', condition='all',\\n                rules=[emit_rule(target, pattern) for target, pattern in definitions()[int(row['gcb_id'][-4:])]]))\\n        policy = dict(policy=dict(id='linuxgcb_rhel9_'+profile+'_v01', file=filename,\\n                      name='RHEL9 GCB v1.2 '+profile+' v0.1 UNVALIDATED',\\n                      description='未驗證候選政策；僅供核准 RHEL9 試點，非完整符合性檢核', regex_type='pcre2'),\\n                      requirements=dict(title='僅 RHEL 9', description='角色由核准群組控制',\\n                        condition='all', rules=['f:/etc/os-release -> r:^ID=\\\"?rhel\\\"?$',\\n                                               'f:/etc/os-release -> r:^VERSION_ID=\\\"?9([.][0-9]+)*\\\"?$']),\\n                      checks=checks)\\n        (ROOT/'policies'/filename).write_text(json.dumps(policy, ensure_ascii=False, indent=2)+'\\\\n')\\n    hashes = {p.name: digest(p) for p in sorted((ROOT/'policies').glob('*.yml'))}\\n    (ROOT/'data/policy_hashes.json').write_text(json.dumps(hashes, indent=2)+'\\\\n')\\n    from .coverage import write\\n    write()\\n    validate()\\n\\n\\ndef require(condition):\\n    if not condition:\\n        raise ValueError('候選政策結構、mapping 或 hash 不符')\\n\\n\\ndef validate():\\n    rows = {r['sca_id']: r for r in registry()}\\n    seen = set()\\n    for path in sorted((ROOT/'policies').glob('*.yml')):\\n        p = json.loads(path.read_text())\\n        require(p['policy']['file'] == path.name and p['policy']['regex_type']=='pcre2')\\n        require(p['requirements'] == dict(title='僅 RHEL 9', description='角色由核准群組控制',\\n            condition='all', rules=['f:/etc/os-release -> r:^ID=\\\"?rhel\\\"?$',\\n                                   'f:/etc/os-release -> r:^VERSION_ID=\\\"?9([.][0-9]+)*\\\"?$']))\\n        for c in p['checks']:\\n            require(c['id'] not in seen and rows[c['id']]['included'])\\n            seen.add(c['id'])\\n            require(parse_description(c.get('description')) == values()[rows[c['id']]['gcb_id']])\\n            require((' ｜ BATCH2 ' if c['id']-900000 in BATCH2 else ' ｜ Q1 ') in c['description'])\\n            require(c['regex_type'] == 'pcre2' and c['condition'] == 'all')\\n            require(c['compliance'] == [{'twgcb': [rows[c['id']]['gcb_id']]}])\\n            require(rows[c['id']]['policy_id'] == p['policy']['id'])\\n            require(c['rules'] == [emit_rule(a,b) for a,b in definitions()[c['id']-900000]])\\n            for rule in c['rules']:\\n                target, _ = rule.split(' -> ', 1)\\n                require(target.removeprefix('not ').startswith('c:/'))\\n                if c['id']-900000 not in BATCH2:\\n                    require(not any(x in target for x in ('|',';', '&&', '$', '`')))\\n                parse_rule(rule)\\n    require(seen == {900000+n for n in definitions()})\\n    hashes = json.loads((ROOT/'data/policy_hashes.json').read_text())\\n    require(hashes == {p.name:digest(p) for p in (ROOT/'policies').glob('*.yml')})\\n    from .coverage import manifest\\n    require(json.loads((ROOT/'data/coverage_manifest.json').read_text()) == manifest())\\n    require(seen == {r['sca_id'] for r in rows.values() if r['implementation']=='candidate'})\\n    return len(seen)\\n\\n\\n@lru_cache(maxsize=1)\\ndef supported_patterns():\\n    return frozenset(p.lstrip('!') for rules in definitions().values() for _,p in rules) | {\\n        '^ID=\\\"?rhel\\\"?$', '^VERSION_ID=\\\"?9([.][0-9]+)*\\\"?$'}\\n\\n\\ndef emit_rule(target, pattern):\\n    return ('not '+target+' -> r:'+pattern[1:]) if pattern.startswith('!') else target+' -> r:'+pattern\\n\\n\\n@lru_cache(maxsize=1)\\ndef batch2_emitted():\\n    return {emit_rule(t,p) for rules in batch2_rules().values() for t,p in rules}\\n\\n\\ndef parse_rule(rule):\\n    \\\"\\\"\\\"Legacy bounded grammar plus exact allowlist of BATCH2 emitted rules.\\\"\\\"\\\"\\n    if not isinstance(rule, str):\\n        raise ValueError('不支援的規則語法')\\n    if rule in batch2_emitted():\\n        target, expression = rule.split(' -> ', 1)\\n        return target.removeprefix('not '), re.compile(expression.split(':',1)[1], re.ASCII)\\n    if rule.count(' -> r:') != 1:\\n        raise ValueError('不支援的規則語法')\\n    target, pattern = rule.split(' -> r:')\\n    if not re.fullmatch(r'[cf]:/[^\\\\n\\\\r]+', target) or any(x in target for x in (' -> ', ' && ', '|', ';', '`', '$')):\\n        raise ValueError('不支援的目標')\\n    if pattern not in supported_patterns() and not re.fullmatch(r'\\\\^[A-Za-z0-9_ =:/-]+\\\\$', pattern):\\n        raise ValueError('未驗證的 PCRE2 語法')\\n    try:\\n        return target, re.compile(pattern, re.ASCII)\\n    except re.error as exc:\\n        raise ValueError('無效模式') from exc\\n\\n\\ndef simulate(check, observations):\\n    \\\"\\\"\\\"僅輸出匹配模型；執行失敗資訊不足回 UNRESOLVED，不冒充 Wazuh。\\n\\n    FIX-1 同一 command 的多行輸出仍按逐行存在匹配；alternation 是單一\\n    正向 regex，規則間維持 all，不以空輸出或 stderr 推論 not-found。\\n    舊 53 項保留 exit_code 不參與輸出匹配；BATCH2 非零則 UNRESOLVED，\\n    並以 emitted shell guard 確保失敗不發布輸出或成功標記。\\n    明確 engine_result 可表示真機／fixture\\n    的 Not applicable；error 只表示未取得可靠輸出，不能預測引擎結果。\\n    \\\"\\\"\\\"\\n    if check.get('regex_type', 'pcre2') != 'pcre2':\\n        raise ValueError('只支援明確 PCRE2 候選子集')\\n    if check.get('condition') != 'all':\\n        raise ValueError('輸出模型只支援目前發出的 all 子集')\\n    if not isinstance(check.get('rules'), list) or not check['rules']:\\n        raise ValueError('規則不得為空')\\n    parsed = [parse_rule(rule) for rule in check['rules']]\\n    outcomes = []\\n    for rule, (target, pattern) in zip(check['rules'], parsed):\\n        obs = observations.get(target)\\n        if target.startswith('f:') and obs is not None and obs.get('exists') is False:\\n            outcomes.append('NOT_APPLICABLE')\\n            continue\\n        if obs is None or obs.get('error'):\\n            outcomes.append('UNRESOLVED')\\n        elif rule in batch2_emitted() and obs.get('exit_code', 0) != 0:\\n            outcomes.append('UNRESOLVED')\\n        elif obs.get('engine_result') == 'NOT_APPLICABLE':\\n            outcomes.append('NOT_APPLICABLE')\\n        elif not isinstance(obs.get('stdout'), str):\\n            raise ValueError('觀察必須提供字串 stdout')\\n        else:\\n            matched = any(pattern.search(line) for line in obs['stdout'].split('\\\\n'))\\n            if rule.startswith('not '):\\n                matched = not matched\\n            outcomes.append('PASS' if matched else 'FAIL')\\n    # 官方 all：任何 FAIL 優先；未知執行不擅自轉成 N/A。\\n    if 'FAIL' in outcomes:\\n        return 'FAIL'\\n    if 'UNRESOLVED' in outcomes:\\n        return 'UNRESOLVED'\\n    return 'NOT_APPLICABLE' if 'NOT_APPLICABLE' in outcomes else 'PASS'\\n\\\"\\\"\\\"可重建的逐項來源對照與涵蓋 manifest；不執行候選命令。\\\"\\\"\\\"\\nimport json\\nfrom collections import Counter\\nfrom zipfile import ZipFile\\nfrom xml.etree import ElementTree as ET\\nfrom .catalog import ROOT, registry, digest\\nfrom .batch1 import ADDED, caveat\\nfrom .quality import status\\nfrom .batch2 import ADDED as BATCH2, caveat as batch2_caveat\\n\\ndef manifest():\\n    ns={'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}\\n    docx=next(ROOT.glob('*.docx'))\\n    xml=ET.fromstring(ZipFile(docx).read('word/document.xml'))\\n    # ID 的 runs 必須在段落內接回，cell 再以換行串接段落。\\n    tables=[]\\n    for tr in xml.findall('.//w:tr',ns):\\n        cells=['\\\\n'.join(''.join(t.text or '' for t in p.findall('.//w:t',ns))\\n                         for p in cell.findall('.//w:p',ns)) for cell in tr.findall('w:tc',ns)]\\n        tables.append(cells)\\n    entries=[]\\n    for row in registry():\\n        n=row['sca_id']-900000\\n        if row['implementation'] != 'candidate': continue\\n        matches=[c for c in tables if row['gcb_id'] in c]\\n        historical=[]\\n        if n in BATCH2:\\n            historical=[c for c in matches if c[-1] != row['expected']]\\n            matches=[c for c in matches if c[-1] == row['expected']]\\n        if not matches or any(c[-2:] != matches[0][-2:] for c in matches) or row['expected'] not in matches[0]:\\n            raise ValueError('DOCX ID／期望欄無法唯一核對：'+row['gcb_id'])\\n        entries.append(dict(gcb_id=row['gcb_id'],sca_id=row['sca_id'],\\n            source_sheet=row['source_sheet'],source_row=row['source_row'],expected=row['expected'],\\n            docx_historical_cells=historical,docx_cells=matches[0],docx_occurrences=len(matches),docx_all_cells=matches,docx_sha256=digest(docx),\\n            mechanism=('BATCH2 c: shell 成功輸出保護、正向/否定逐行 PCRE2、all 聚合' if n in BATCH2 else '原生 c: 絕對路徑、正向逐行 PCRE2、all 聚合；無 shell'),\\n            caveats=batch2_caveat(n) if n in BATCH2 else caveat(n) if n in ADDED else row['pending'],tests=['tests/fixtures/rule_outputs.json#'+str(row['sca_id']), 'tests/test_batch2.py' if n in BATCH2 else 'tests/test_quality_q1.py'],\\n            cases=['positive','negative','missing','empty','error','nonzero_matching'],\\n            review_status='human_review_pending',**status(n)))\\n    rows=registry();counts=Counter(r['implementation'] for r in rows)\\n    return dict(schema_version=2,label='離線候選涵蓋；非實機證據',\\n        counts=dict(source=len(rows),included=sum(r['included'] for r in rows),excluded=counts['excluded'],\\n                    before=7,added=len(ADDED)+len(BATCH2),batch2_added=len(BATCH2),implemented=counts['candidate'],remaining=counts['pending'],\\n                    full=sum(r['coverage']=='full' for r in rows),partial=sum(r['coverage']=='partial' for r in rows),\\n                    blocked=sum(r['coverage']=='blocked' for r in rows),reviewed=len(entries),execution_blocked=len(entries),live_validated=0),\\n        reviewed=entries)\\n\\ndef write():\\n    m=manifest()\\n    (ROOT/'data/coverage_manifest.json').write_text(json.dumps(m,ensure_ascii=False,indent=2)+'\\\\n')\\n    return m\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./docs/QUALITY_REVIEW_Q1.md:106:| 0256 | 900256 | 檔案 metadata / /etc/ssh/sshd_config | root:root | partial | Q1-01, Q1-03, Q1-04 |\n./docs/QUALITY_REVIEW_Q1.md:131:| 來源 | SHA256 |\n./codex_fix3.log:8:{\"type\":\"item.started\",\"item\":{\"id\":\"item_4\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"ls -a; find .. -name AGENTS.md -print; rg -n '900102|900103|900104|900105|900106|900189|900205|OS_StrBreak|256' . --glob '\\\"'!*.csv'\\\"' --glob '\\\"'!*.json'\\\"'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n./codex_report1.log:11:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_5\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc 'ls -la; find .. -name AGENTS.md -print; cat linuxgcb/collector.py linuxgcb/__main__.py'\",\"aggregated_output\":\"total 656\\ndrwxrwxr-x 13 skycity1010 skycity1010   4096 Oct 31 12:04 .\\ndrwxrwxr-x 12 skycity1010 skycity1010   4096 Oct 31 12:04 ..\\ndr-xr-xr-x  2 skycity1010 skycity1010     40 Oct 31 12:04 .agents\\ndr-xr-xr-x  2 skycity1010 skycity1010     40 Oct 31 12:04 .aws\\ndr-xr-xr-x  2 skycity1010 skycity1010     40 Oct 31 12:04 .codex\\ndrwxrwxr-x  8 skycity1010 skycity1010   4096 Oct 31 12:04 .git\\n-rw-rw-r--  1 skycity1010 skycity1010     24 Oct 31 12:04 .gitignore\\n-rw-rw-r--  1 skycity1010 skycity1010   1203 Oct 31 12:04 CODEX_BATCH1_HANDOFF.md\\n-rw-rw-r--  1 skycity1010 skycity1010   1087 Oct 31 12:04 CODEX_HANDOFF.md\\n-rw-rw-r--  1 skycity1010 skycity1010   1188 Oct 31 12:04 CODEX_HANDOFF_FIX1.md\\n-rw-rw-r--  1 skycity1010 skycity1010   1033 Oct 31 12:04 CODEX_QUALITY1_HANDOFF.md\\n-rw-rw-r--  1 skycity1010 skycity1010   2085 Oct 31 12:04 NEXT_STEPS.md\\n-rw-rw-r--  1 skycity1010 skycity1010  13993 Oct 31
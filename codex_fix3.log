{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"ls -a; find .. -name AGENTS.md -print; rg -n '900102|900103|900104|900105|900106|900189|900205|OS_StrBreak|256' . --glob '\"'!*.csv'\"' --glob '\"'!*.json'\"'\"","aggregated_output":".\n..\n.agents\n.aws\n.codex\n.git\n.gitignore\nCODEX_BATCH1_HANDOFF.md\nCODEX_HANDOFF.md\nCODEX_HANDOFF_EXP1.md\nCODEX_HANDOFF_FIX1.md\nCODEX_HANDOFF_FIX2.md\nCODEX_HANDOFF_P2B2.md\nCODEX_HANDOFF_REPORT1.md\nCODEX_QUALITY1_HANDOFF.md\nNEXT_STEPS.md\nPLAN.md\nREADME.md\nRed Hat Enterprise Linux 9政府組態基準列表.xlsx\nTWGCB-01-012_Red Hat Enterprise Linux 9政府組態基準說明文件(伺服器)v1.2_1140612.docx\ncodex_exp1.log\ncodex_fix1.log\ncodex_fix2.log\ncodex_fix3.log\ncodex_p2b2.log\ncodex_report1.log\ndata\ndocs\nlinuxgcb\npolicies\nscripts\ntemplates\ntests\nfind: ‘../soar-poc-candidate-p1/.scratch/p2’: Permission denied\n../open-slide-demo/AGENTS.md\nfind: ‘../soar-poc-candidate-p1/.scratch/w4b-live’: Permission denied\n./scripts/inventory.py:55:        source_sha256={p.name:hashlib.sha256(p.read_bytes()).hexdigest() for p in sources})\n./codex_fix1.log:13:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_6\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc 'cat linuxgcb/batch1.py; cat linuxgcb/quality.py; cat tests/test_quality_q1.py; cat tests/test_catalog_policy.py'\",\"aggregated_output\":\"\\\"\\\"\\\"有界批次：明列來源路徑，不以標題啟發式生成控制。\\\"\\\"\\\"\\n# (路徑, owner 或 mode, 允許值)；mode 是位元子集合，非 umask。\\nFILES = {\\n 47:('/etc/shadow','owner','root:(root|shadow)'),48:('/etc/shadow','mode',0),\\n 49:('/etc/group','owner','root:root'),50:('/etc/group','mode',0o644),\\n 51:('/etc/gshadow','owner','root:(root|shadow)'),52:('/etc/gshadow','mode',0),\\n 53:('/etc/passwd-','owner','root:root'),54:('/etc/passwd-','mode',0o644),\\n 55:('/etc/shadow-','owner','root:(root|shadow)'),56:('/etc/shadow-','mode',0),\\n 57:('/etc/group-','owner','root:root'),58:('/etc/group-','mode',0o644),\\n 59:('/etc/gshadow-','owner','root:(root|shadow)'),60:('/etc/gshadow-','mode',0),\\n 141:('/etc/audit/rules.d/audit.rules','mode',0o600),142:('/etc/audit/auditd.conf','mode',0o640),\\n 178:('/var/log/messages','owner','root:root'),179:('/var/log','owner','root:root'),\\n 191:('/etc/crontab','owner','root:root'),192:('/etc/crontab','mode',0o600),\\n 193:('/etc/cron.hourly','owner','root:root'),194:('/etc/cron.hourly','mode',0o700),\\n 195:('/etc/cron.daily','owner','root:root'),196:('/etc/cron.daily','mode',0o700),\\n 197:('/etc/cron.weekly','owner','root:root'),198:('/etc/cron.weekly','mode',0o700),\\n 199:('/etc/cron.monthly','owner','root:root'),200:('/etc/cron.monthly','mode',0o700),\\n 201:('/etc/cron.d','owner','root:root'),202:('/etc/cron.d','mode',0o700),\\n 256:('/etc/ssh/sshd_config','owner','root:root'),257:('/etc/ssh/sshd_config','mode',0o600),\\n 301:('/etc/shells','owner','root:root'),302:('/etc/shells','mode',0o644),\\n}\\nPACKAGES = {33:['sudo'],132:['audit','audit-libs'],174:['rsyslog'],183:['libselinux'],242:['firewalld']}\\n# 0036 AIDE 初始化另有要求，0231 架構需審查，本批不以套件存在充當完整實作。\\nSERVICES = {30:('autofs','disabled'),94:('rsyncd','masked'),97:('squid','masked'),\\n            98:('smb','masked'),101:('kdump','enabled'),133:('auditd','enabled'),\\n            175:('rsyslog','enabled')}\\nADDED = set(FILES) | set(PACKAGES) | set(SERVICES)\\n\\ndef mode_pattern(mask):\\n    return '^('+'|'.join(format(n,'o') for n in range(0o10000) if n & ~mask == 0)+')$'\\n\\ndef rules():\\n    result = {}\\n    for n,(path,kind,value) in FILES.items():\\n        result[n] = [('c:/usr/bin/stat -c '+('%U:%G' if kind=='owner' else '%a')+' '+path,\\n                      '^'+value+'$' if kind=='owner' else mode_pattern(value)),\\n]\\n        # 來源明列目錄才限制型態；檔案來源未明定必須 regular，交由來源審查。\\n        if n in (179,193,194,195,196,197,198,199,200,201,202):\\n            result[n].append(('c:/usr/bin/stat -c %f '+path, '^4[0-9a-f]{3}$'))\\n    for n,packages in PACKAGES.items():\\n        # RPM 的成功輸出必須含正向標記；不依賴退出碼或空輸出。\\n        result[n] = [('c:/usr/bin/rpm -q --queryformat %{NAME}:installed '+p,'^'+p+':installed$') for p in packages]\\n    for n,(unit,state) in SERVICES.items():\\n        props = [('LoadState','loaded' if state!='masked' else 'masked'),\\n                 ('ActiveState','active' if state=='enabled' else 'inactive'),('UnitFileState',state)]\\n        result[n] = [('c:/usr/bin/systemctl show '+unit+'.service --property='+k,'^'+k+'='+v+'$') for k,v in props]\\n    return result\\n\\ndef caveat(n):\\n    common='命令啟動／stderr／權限錯誤與非零但匹配輸出之行為待真機驗證；不依賴退出碼。'\\n    if n in FILES:\\n        path,kind,_=FILES[n]\\n        text='固定路徑 lstat；來源明列目錄才用 %f 數值型態，檔案不額外限制 regular。連結是否應解參照、NSS 與 ACL 語意未核准；不可據此宣稱完整符合。'\\n        if path.endswith('-'): text+='備份檔缺失不自動視為不適用，需核准適用性。'\\n        if n==141: text+='僅來源明列 audit.rules，其他 rules.d 檔案覆蓋待審。'\\n        if n in (256,257): text+='僅 sshd_config metadata，不代表 Include 或 SSH 內容符合。'\\n        return text+common\\n    if n in PACKAGES: return '僅 RPM 資料庫套件存在；不代表服務或內容規則通過。RPM 資料庫錯誤不得以未安裝推論。'+common\\n    return '分開確認開機狀態與即時狀態；不接受 not-found、static、alias、enabled-runtime；不存在不自動通過；多次查詢非原子。'+common\\n\\\"\\\"\\\"Q1 離線審查結論；只涵蓋原有 53 ID，非來源或真機核准。\\\"\\\"\\\"\\nfrom .batch1 import FILES, PACKAGES, SERVICES\\n\\nABSENCE_PENDING = {30,94,97,98,245}\\n\\ndef findings(n):\\n    issues = ['Q1-01']  # 非零但匹配 stdout，無已核准的原生執行狀態保護\\n    if n in FILES or n in (45,46): issues += ['Q1-03','Q1-04']\\n    if n in range(53,61) or n in (141,178,191,192): issues += ['Q1-05']\\n    if n in SERVICES or n in (243,245): issues += ['Q1-06']\\n    if n in ABSENCE_PENDING: issues += ['Q1-07']\\n    if n in (108,141,269,270): issues += ['Q1-08']\\n    return issues\\n\\ndef family(n):\\n    if n in FILES or n in (45,46): return '檔案 metadata'\\n    if n in PACKAGES: return 'RPM 存在'\\n    if n in SERVICES or n in (243,245): return 'systemd 服務'\\n    if n == 108: return 'sysctl 即時值'\\n    return 'SSH 預設有效設定'\\n\\ndef status(n):\\n    return dict(offline_review='completed_with_findings',\\n                execution_review='blocked',\\n                coverage='blocked' if n in ABSENCE_PENDING else 'partial',\\n                issue_ids=findings(n), family=family(n),\\n                source_approval='pending', live_validation='UNVALIDATED')\\n\\\"\\\"\\\"SYNTHETIC Q1 回歸；不執行任何政策命令。\\\"\\\"\\\"\\nimport copy\\nimport json\\nimport stat\\nimport tempfile\\nimport unittest\\nfrom datetime import datetime, timezone\\nfrom pathlib import Path\\nfrom linuxgcb.catalog import ROOT, registry\\nfrom linuxgcb.policy import simulate, definitions\\nfrom linuxgcb.report import normalize, metrics, render\\n\\nNOW = datetime(2026,10,30,tzinfo=timezone.utc)\\n\\nclass QualityQ1Tests(unittest.TestCase):\\n    def check(self, n):\\n        return dict(condition='all', regex_type='pcre2',\\n                    rules=[a+' -> r:'+b for a,b in definitions()[n]])\\n\\n    def snapshot(self):\\n        return json.loads((ROOT/'tests/fixtures/snapshot.json').read_text())\\n\\n    def test_reject_unsupported_conditions_even_when_matching(self):\\n        for condition in ('any','none','ALL',''):\\n            with self.subTest(condition=condition), self.assertRaises(ValueError):\\n                simulate(dict(condition=condition,rules=['c:/SYNTHETIC -> r:^good$']), {})\\n\\n    def test_reject_unsupported_rule_and_regex_syntax(self):\\n        for rule in ('p:daemon -> r:^good$', 'c:/SYNTHETIC -> r:^good$ && r:bad',\\n                     'c:/SYNTHETIC -> r:^(?=good)good$', 'c:/SYNTHETIC -> r:^\\\\\\\\w+$',\\n                     'c:/SYNTHETIC -> r:^good.$|bad', 'c:/SYNTHETIC -> n:(\\\\\\\\d+) compare == 1'):\\n            with self.subTest(rule=rule), self.assertRaises(ValueError):\\n                simulate(dict(condition='all',rules=[rule]), {})\\n        for check in (dict(condition='all',rules=[]),dict(condition='all',regex_type='osregex',rules=['c:/SYNTHETIC -> r:^good$'])):\\n            with self.assertRaises(ValueError): simulate(check,{})\\n\\n    def test_stat_uses_numeric_directory_type_only(self):\\n        from linuxgcb.batch1 import FILES\\n        for n,(path,_,_) in FILES.items():\\n            rules=self.check(n)['rules']\\n            self.assertFalse(any('%F' in r for r in rules))\\n            directory=n in (179,193,194,195,196,197,198,199,200,201,202)\\n            self.assertEqual(any('%f ' in r for r in rules),directory)\\n            # regular 是舊版額外要求；來源沒有明文限定，不能默默加嚴。\\n            self.assertFalse(any('regular' in r for r in rules))\\n\\n    def test_numeric_type_locale_and_all_file_types(self):\\n        # locale 為具名合成情境，未宣稱本機安裝這些 locale。\\n        for locale in ('C','zh_TW.UTF-8','de_DE.UTF-8'):\\n            for kind in (stat.S_IFDIR,stat.S_IFREG,stat.S_IFLNK,stat.S_IFIFO,stat.S_IFSOCK,stat.S_IFCHR,stat.S_IFBLK):\\n                for mode in (0,0o700,0o755,0o7777):\\n                    obs={'c:/usr/bin/stat -c %U:%G /var/log':dict(stdout='root:root'),\\n                         'c:/usr/bin/stat -c %f /var/log':dict(stdout=format(kind|mode,'x'))}\\n                    with self.subTest(locale=locale,kind=kind,mode=mode):\\n                        self.assertEqual(simulate(self.check(179),obs),'PASS' if kind==stat.S_IFDIR else 'FAIL')\\n\\n    def test_stderr_exit_and_multiline_are_not_runtime_protection(self):\\n        check=dict(condition='all',rules=['c:/SYNTHETIC -> r:^good$'])\\n        for code in (0,1,127):\\n            self.assertEqual(simulate(check,{'c:/SYNTHETIC':dict(stdout='bad\\\\ngood\\\\nbad',stderr='SYNTHETIC error',exit_code=code)}),'PASS')\\n        for stdout in ('','bad','good bad','good\\\\rbad'):\\n            self.assertEqual(simulate(check,{'c:/SYNTHETIC':dict(stdout=stdout,stderr='good',exit_code=1)}),'FAIL')\\n        self.assertEqual(simulate(check,{}),'UNRESOLVED')\\n        self.assertEqual(simulate(check,{'c:/SYNTHETIC':dict(error='SYNTHETIC unknown execution')}),'UNRESOLVED')\\n\\n    def test_all_aggregates_error_na_and_failure(self):\\n        check=dict(condition='all',rules=['c:/A -> r:^good$','c:/B -> r:^good$'])\\n        for second,want in ((dict(stdout='bad'),'FAIL'),(dict(stdout='good'),'UNRESOLVED'),(dict(engine_result='NOT_APPLICABLE'),'UNRESOLVED')):\\n            self.assertEqual(simulate(check,{'c:/B':second}),want)\\n        self.assertEqual(simulate(check,{'c:/A':dict(stdout='good'),'c:/B':dict(engine_result='NOT_APPLICABLE')}),'NOT_APPLICABLE')\\n\\n    def test_review_reconciles_exact_existing_ids(self):\\n        rows=[r for r in registry() if r['implementation']=='candidate']\\n        self.assertEqual({r['sca_id'] for r in rows},{900000+n for n in definitions()})\\n        self.assertEqual(len(rows),53)\\n        self.assertTrue(all(r['execution_review']=='blocked' for r in rows))\\n        self.assertTrue(all('Q1-01' in r['issue_ids'] for r in rows))\\n        self.assertEqual(sum(r['coverage']=='full' for r in rows),0)\\n\\n    def test_all_raw_pass_never_becomes_verified_compliance(self):\\n        snapshot=self.snapshot()\\n        snapshot['hosts'][0]['checks']=[dict(id=900000+n,result='passed') for n in definitions()]\\n        rows=normalize(snapshot,NOW);summary=metrics(rows)\\n        self.assertEqual(summary['counts'].get('PASS',0),0)\\n        self.assertEqual(summary['completeness'],0)\\n        self.assertEqual(summary['raw_observed'],53)\\n        self.assertFalse(any(r['verified_compliance'] for r in rows))\\n        self.assertEqual(sum(r['state']=='NOT_SCANNED' for r in rows if r['raw_result'] is not None),0)\\n\\n    def test_missing_backup_and_service_are_pending_errors_are_errors(self):\\n        for n in (53,54,55,56,57,58,59,60,30,94,97,98,245):\\n            for evidence,want in (('missing','MANUAL_PENDING'),('absence_unverified','MANUAL_PENDING'),('symlink_unresolved','MANUAL_PENDING'),('tool_error','ERROR'),('permission_error','ERROR'),('timeout','ERROR')):\\n                snapshot=self.snapshot();snapshot['hosts'][0]['checks']=[dict(id=900000+n,result='failed',evidence_status=evidence,reason='SYNTHETIC metadata only')]\\n                row=next(r for r in normalize(snapshot,NOW) if r['sca_id']==900000+n)\\n                self.assertEqual((row['state'],row['raw_result']),(want,'failed'))\\n                self.assertFalse(row['verified_compliance'])\\n\\n    def test_synthetic_report_end_to_end_no_complete_elevation(self):\\n        snapshot=self.snapshot()\\n        with tempfile.TemporaryDirectory() as directory:\\n            summary=render(snapshot,directory,NOW)\\n            self.assertEqual(summary['raw_observed'],6)\\n            self.assertEqual(summary['verified_decided'],0)\\n            self.assertEqual(summary['completeness'],0)\\n            self.assertEqual(json.loads((Path(directory)/'snapshot.json').read_text()),snapshot)\\n            self.assertIn('verified_compliance',(Path(directory)/'report.csv').read_text(encoding='utf-8-sig'))\\n\\n    def test_all_service_states_preserve_raw_distinctions(self):\\n        from linuxgcb.batch1 import SERVICES\\n        fixtures=json.loads((ROOT/'tests/fixtures/rule_outputs.json').read_text())['checks']\\n        for n in set(SERVICES)|{243,245}:\\n            base=fixtures[str(900000+n)]['positive']\\n            for prop,values in {'LoadState':['not-found','error','bad-setting'],\\n                                'ActiveState':['active','inactive','failed','activating'],\\n                                'UnitFileState':['enabled','disabled','masked','masked-runtime','enabled-runtime','static','alias','indirect']}.items():\\n                target=next(k for k in base if '--property='+prop in k)\\n                expected=base[target]['stdout']\\n                for value in values:\\n                    obs=copy.deepcopy(base);obs[target]['stdout']=prop+'='+value\\n                    self.assertEqual(simulate(self.check(n),obs),'PASS' if obs[target]['stdout']==expected else 'FAIL')\\n            # 查詢 .service 沒有 socket、alias 與原子快照證據；不得計完整符合。\\n            snapshot=self.snapshot();snapshot['hosts'][0]['checks']=[dict(id=900000+n,result='passed')]\\n            row=next(r for r in normalize(snapshot,NOW) if r['sca_id']==900000+n)\\n            self.assertEqual(row['state'],'MANUAL_PENDING')\\nimport json\\nimport unittest\\nfrom pathlib import Path\\nfrom linuxgcb.catalog import ROOT, registry, digest, XLSX_HASH\\nfrom linuxgcb.policy import validate, simulate, definitions\\nfrom linuxgcb.batch1 import FILES, ADDED\\nfrom linuxgcb.coverage import manifest\\nfrom scripts.inventory import extract\\n\\n\\nclass CatalogTests(unittest.TestCase):\\n    def test_scope_and_source_unchanged(self):\\n        rows = registry()\\n        self.assertEqual((len(rows), sum(r['included'] for r in rows)), (314,307))\\n        self.assertEqual(len({r['sca_id'] for r in rows}),314)\\n        self.assertEqual(len({r['gcb_id'] for r in rows}),314)\\n        self.assertEqual({r['source_sheet'] for r in rows if not r['included']}, {'Nftables防火牆'})\\n        self.assertTrue(next(r for r in rows if r['sca_id']==900245)['included'])\\n        self.assertFalse(any(r['gcb_id'].endswith('-0180') for r in rows))\\n        self.assertEqual(digest(next(ROOT.glob('*.xlsx'))), XLSX_HASH)\\n        self.assertEqual(rows,json.loads((ROOT/'data/scope_registry.json').read_text()))\\n\\n    def test_raw_controls_unchanged(self):\\n        self.assertEqual(extract(next(ROOT.glob('*.xlsx'))),json.loads((ROOT/'data/controls.json').read_text()))\\n\\n    def test_traceability(self):\\n        source = {r['gcb_id']:r for r in extract(next(ROOT.glob('*.xlsx')))}\\n        for r in registry():\\n            self.assertEqual(r['source_row'],source[r['gcb_id']]['row'])\\n            self.assertEqual(r['expected'],source[r['gcb_id']]['expected'])\\n            self.assertEqual(r['review_status'],'human_review_pending')\\n\\n    def test_structural(self):\\n        self.assertEqual(validate(),len(definitions()))\\n\\n    def test_all_positive_negative_missing_error(self):\\n        fixtures=json.loads((ROOT/'tests/fixtures/rule_outputs.json').read_text())\\n        self.assertEqual(fixtures['label'],'SYNTHETIC TEST ONLY')\\n        checked = set()\\n        for p in (ROOT/'policies').glob('*.yml'):\\n            for c in json.loads(p.read_text())['checks']:\\n                checked.add(str(c['id']))\\n                for name, state in [('positive','PASS'),('negative','FAIL'),('missing','UNRESOLVED'),('empty','FAIL'),('error','UNRESOLVED'),('nonzero_matching','PASS')]:\\n                    with self.subTest(id=c['id'],case=name):\\n                        self.assertEqual(simulate(c,fixtures['checks'][str(c['id'])][name]),state)\\n        self.assertEqual(checked,set(fixtures['checks']))\\n\\n    def test_permission_bit_subset_and_special_bits(self):\\n        c=next(c for c in json.loads((ROOT/'policies/linuxgcb_base.yml').read_text())['checks'] if c['id']==900046)\\n        target=c['rules'][0].split(' -> ')[0]\\n        for mode in range(0o10000):\\n            expected='PASS' if mode & ~0o644 == 0 else 'FAIL'\\n            self.assertEqual(simulate(c,{target:dict(stdout=format(mode,'o'),exit_code=0)}),expected)\\n\\n    def test_exit_code_does_not_override_matching_output(self):\\n        c=next(c for c in json.loads((ROOT/'policies/linuxgcb_base.yml').read_text())['checks'] if c['id']==900045)\\n        target=c['rules'][0].split(' -> ')[0]\\n        self.assertEqual(simulate(c,{target:dict(stdout='0:0',exit_code=1)}),'PASS')\\n\\n    def test_batch_manifest_reconciles_and_docx(self):\\n        m=manifest();rows=registry()\\n        self.assertEqual({e['sca_id'] for e in m['reviewed']},{900000+n for n in definitions()})\\n        self.assertEqual(m['counts']['implemented'],len(definitions()))\\n        self.assertEqual(m['counts']['remaining'],307-len(definitions()))\\n        self.assertEqual(m['counts']['full']+m['counts']['partial']+m['counts']['blocked'],len(definitions()))\\n        self.assertEqual((m['counts']['full'],m['counts']['partial'],m['counts']['blocked']),(0,48,5))\\n        for e in m['reviewed']:\\n            self.assertTrue(all(e['expected'] == c[-1] for c in e['docx_all_cells']))\\n            self.assertTrue(all(e['gcb_id'] in c for c in e['docx_all_cells']))\\n            n=e['sca_id']-900000\\n            method=e['docx_cells'][-2]\\n            if n in FILES:\\n                self.assertIn(FILES[n][0],method)\\n\\n    def test_all_mode_masks_exhaustive(self):\\n        from linuxgcb.batch1 import mode_pattern\\n        import re\\n        masks={v for _,kind,v in FILES.values() if kind=='mode'}\\n        for mask in masks:\\n            pattern=re.compile(mode_pattern(mask))\\n            for value in range(0o10000):\\n                self.assertEqual(bool(pattern.search(format(value,'o'))),value & ~mask == 0)\\n\\n    def test_batch_edges_use_emitted_rules(self):\\n        import copy\\n        checks={c['id']:c for p in (ROOT/'policies').glob('*.yml') for c in json.loads(p.read_text())['checks']}\\n        fixtures=json.loads((ROOT/'tests/fixtures/rule_outputs.json').read_text())['checks']\\n        for n in sorted(ADDED):\\n            check=checks[900000+n];base=fixtures[str(900000+n)]['positive']\\n            # 每個子規則必須獨立參與 all；非第一個錯誤亦不可被第一個 PASS 掩蓋。\\n            for target in base:\\n                obs=copy.deepcopy(base);obs[target]['stdout']='WRONG'\\n                self.assertEqual(simulate(check,obs),'FAIL')\\n                obs=copy.deepcopy(base);obs[target]['stdout']+='\\\\nWRONG'\\n                self.assertEqual(simulate(check,obs),'PASS') # SCA 逐行存在匹配，不是整個輸出相等\\n            if n in FILES:\\n                path,kind,value=FILES[n]\\n                if kind=='owner':\\n                    target='c:/usr/bin/stat -c %U:%G '+path\\n                    for owner in ('root:shadow','root:wheel','nobody:root','root:UNKNOWN'):\\n                        obs=copy.deepcopy(base);obs[target]['stdout']=owner\\n                        self.assertEqual(simulate(check,obs),'PASS' if owner=='root:shadow' and 'shadow' in value else 'FAIL')\\n                type_target='c:/usr/bin/stat -c %f '+path\\n                if type_target in base:\\n                    for mode in ('81a4','a1ff','11a4','21a4','61a4','c1a4'):\\n                        obs=copy.deepcopy(base);obs[type_target]['stdout']=mode\\n                        self.assertEqual(simulate(check,obs),'FAIL')\\n            from linuxgcb.batch1 import SERVICES,PACKAGES\\n            if n in SERVICES:\\n                target=next(t for t in base if 'UnitFileState' in t)\\n                for value in ('enabled-runtime','static','alias','not-found'):\\n                    obs=copy.deepcopy(base);obs[target]['stdout']='UnitFileState='+value\\n                    self.assertEqual(simulate(check,obs),'FAIL')\\n                obs=copy.deepcopy(base)\\n                target=next(t for t in base if 'LoadState' in t);obs[target]['stdout']='LoadState=not-found'\\n                self.assertEqual(simulate(check,obs),'FAIL')\\n            if n in PACKAGES:\\n                obs=copy.deepcopy(base);target=next(iter(base));obs[target]['stdout']='package missing is not installed'\\n                obs[target]['exit_code']=1\\n                self.assertEqual(simulate(check,obs),'FAIL')\\n\\n    def test_documented_file_and_all_semantics(self):\\n        check=dict(condition='all',rules=['f:/SYNTHETIC -> r:^ID=rhel$'])\\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(exists=False)}),'NOT_APPLICABLE')\\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(stdout='')}),'FAIL')\\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(error='permission denied')}),'UNRESOLVED')\\n        check['rules'].append('c:/SYNTHETIC -> r:^good$')\\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(exists=False),'c:/SYNTHETIC':dict(stdout='bad')}),'FAIL')\\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(exists=False),'c:/SYNTHETIC':dict(stdout='good')}),'NOT_APPLICABLE')\\n        self.assertEqual(simulate(check,{'c:/SYNTHETIC':dict(stdout='bad')}),'FAIL')\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./codex_fix1.log:15:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_7\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc 'cat linuxgcb/policy.py; cat linuxgcb/__main__.py; cat docs/QUALITY_REVIEW_Q1.md'\",\"aggregated_output\":\"\\\"\\\"\\\"以 JSON（YAML 1.2 子集）產生候選 SCA；只模擬輸出匹配，不執行命令。\\\"\\\"\\\"\\nimport json\\nimport re\\nfrom functools import lru_cache\\nfrom .catalog import ROOT, registry, digest\\nfrom .batch1 import rules as batch_rules\\n\\n\\ndef definitions():\\n    modes = '|'.join(format(n, 'o') for n in range(0o1000) if n & ~0o644 == 0)\\n    return {**batch_rules(),\\n        45: [('c:/usr/bin/stat -c %u:%g /etc/passwd', '^0:0$')],\\n        46: [('c:/usr/bin/stat -c %a /etc/passwd', '^('+modes+')$')],\\n        108: [('c:/usr/sbin/sysctl -n net.ipv4.ip_forward', '^0$'),\\n              ('c:/usr/sbin/sysctl -n net.ipv6.conf.all.forwarding', '^0$')],\\n        243: [('c:/usr/bin/systemctl show firewalld.service --property=LoadState', '^LoadState=loaded$'),\\n              ('c:/usr/bin/systemctl show firewalld.service --property=ActiveState', '^ActiveState=active$'),\\n              ('c:/usr/bin/systemctl show firewalld.service --property=UnitFileState', '^UnitFileState=enabled$')],\\n        245: [('c:/usr/bin/systemctl show nftables.service --property=LoadState', '^LoadState=masked$'),\\n              ('c:/usr/bin/systemctl show nftables.service --property=ActiveState', '^ActiveState=inactive$'),\\n              ('c:/usr/bin/systemctl show nftables.service --property=UnitFileState', '^UnitFileState=masked$')],\\n        269: [('c:/usr/sbin/sshd -T', '^permitrootlogin no$')],\\n        270: [('c:/usr/sbin/sshd -T', '^permitemptypasswords no$')],\\n    }\\n\\n\\ndef build():\\n    rows = registry()\\n    for profile in ('base', 'firewalld', 'sshd'):\\n        filename = 'linuxgcb_'+profile+'.yml'\\n        checks = []\\n        for row in rows:\\n            if row['implementation'] != 'candidate' or row['profile'] != profile:\\n                continue\\n            checks.append(dict(id=row['sca_id'], title=row['gcb_id']+' '+row['title'],\\n                description='Q1 執行審查 '+row['execution_review']+'；coverage='+row['coverage']+'；'+','.join(row['issue_ids'])+'；raw PASS 非已驗證符合。'+row['pending'],\\n                compliance=[{'twgcb': [row['gcb_id']]}], regex_type='pcre2', condition='all',\\n                rules=[target+' -> r:'+pattern for target, pattern in definitions()[int(row['gcb_id'][-4:])]]))\\n        policy = dict(policy=dict(id='linuxgcb_rhel9_'+profile+'_v01', file=filename,\\n                      name='RHEL9 GCB v1.2 '+profile+' v0.1 UNVALIDATED',\\n                      description='未驗證候選政策；僅供核准 RHEL9 試點，非完整符合性檢核', regex_type='pcre2'),\\n                      requirements=dict(title='僅 RHEL 9', description='角色由核准群組控制',\\n                        condition='all', rules=['f:/etc/os-release -> r:^ID=\\\"?rhel\\\"?$',\\n                                               'f:/etc/os-release -> r:^VERSION_ID=\\\"?9([.][0-9]+)*\\\"?$']),\\n                      checks=checks)\\n        (ROOT/'policies'/filename).write_text(json.dumps(policy, ensure_ascii=False, indent=2)+'\\\\n')\\n    hashes = {p.name: digest(p) for p in sorted((ROOT/'policies').glob('*.yml'))}\\n    (ROOT/'data/policy_hashes.json').write_text(json.dumps(hashes, indent=2)+'\\\\n')\\n    from .coverage import write\\n    write()\\n    validate()\\n\\n\\ndef require(condition):\\n    if not condition:\\n        raise ValueError('候選政策結構、mapping 或 hash 不符')\\n\\n\\ndef validate():\\n    rows = {r['sca_id']: r for r in registry()}\\n    seen = set()\\n    for path in sorted((ROOT/'policies').glob('*.yml')):\\n        p = json.loads(path.read_text())\\n        require(p['policy']['file'] == path.name and p['policy']['regex_type']=='pcre2')\\n        require(p['requirements'] == dict(title='僅 RHEL 9', description='角色由核准群組控制',\\n            condition='all', rules=['f:/etc/os-release -> r:^ID=\\\"?rhel\\\"?$',\\n                                   'f:/etc/os-release -> r:^VERSION_ID=\\\"?9([.][0-9]+)*\\\"?$']))\\n        for c in p['checks']:\\n            require(c['id'] not in seen and rows[c['id']]['included'])\\n            seen.add(c['id'])\\n            require(c['regex_type'] == 'pcre2' and c['condition'] == 'all')\\n            require(c['compliance'] == [{'twgcb': [rows[c['id']]['gcb_id']]}])\\n            require(rows[c['id']]['policy_id'] == p['policy']['id'])\\n            require(c['rules'] == [a+' -> r:'+b for a,b in definitions()[c['id']-900000]])\\n            for rule in c['rules']:\\n                target, pattern = rule.split(' -> r:')\\n                require(target.startswith('c:/') and not any(x in target for x in ('|',';', '&&', '$', '`')))\\n                parse_rule(rule)\\n    require(seen == {900000+n for n in definitions()})\\n    hashes = json.loads((ROOT/'data/policy_hashes.json').read_text())\\n    require(hashes == {p.name:digest(p) for p in (ROOT/'policies').glob('*.yml')})\\n    from .coverage import manifest\\n    require(json.loads((ROOT/'data/coverage_manifest.json').read_text()) == manifest())\\n    require(seen == {r['sca_id'] for r in rows.values() if r['implementation']=='candidate'})\\n    return len(seen)\\n\\n\\n@lru_cache(maxsize=1)\\ndef supported_patterns():\\n    return frozenset(p for rules in definitions().values() for _,p in rules) | {\\n        '^ID=\\\"?rhel\\\"?$', '^VERSION_ID=\\\"?9([.][0-9]+)*\\\"?$'}\\n\\n\\ndef parse_rule(rule):\\n    \\\"\\\"\\\"明確有界子集：絕對路徑 c:/f: + 單一正向 r:；拒絕其他運算子。\\\"\\\"\\\"\\n    if not isinstance(rule, str) or rule.count(' -> r:') != 1:\\n        raise ValueError('不支援的規則語法')\\n    target, pattern = rule.split(' -> r:')\\n    if not re.fullmatch(r'[cf]:/[^\\\\n\\\\r]+', target) or any(x in target for x in (' -> ', ' && ', '|', ';', '`', '$')):\\n        raise ValueError('不支援的目標')\\n    # Python 並非 PCRE2；只接受實際發出的固定模式與測試用 ASCII literal。\\n    if pattern not in supported_patterns() and not re.fullmatch(r'\\\\^[A-Za-z0-9_ =:/-]+\\\\$', pattern):\\n        raise ValueError('未驗證的 PCRE2 語法')\\n    try:\\n        return target, re.compile(pattern, re.ASCII)\\n    except re.error as exc:\\n        raise ValueError('無效模式') from exc\\n\\n\\ndef simulate(check, observations):\\n    \\\"\\\"\\\"僅輸出匹配模型；執行失敗資訊不足回 UNRESOLVED，不冒充 Wazuh。\\n\\n    exit_code 不參與 SCA 輸出匹配。明確 engine_result 可表示真機／fixture\\n    的 Not applicable；error 只表示未取得可靠輸出，不能預測引擎結果。\\n    \\\"\\\"\\\"\\n    if check.get('regex_type', 'pcre2') != 'pcre2':\\n        raise ValueError('只支援明確 PCRE2 候選子集')\\n    if check.get('condition') != 'all':\\n        raise ValueError('輸出模型只支援目前發出的 all 子集')\\n    if not isinstance(check.get('rules'), list) or not check['rules']:\\n        raise ValueError('規則不得為空')\\n    parsed = [parse_rule(rule) for rule in check['rules']]\\n    outcomes = []\\n    for target, pattern in parsed:\\n        obs = observations.get(target)\\n        if target.startswith('f:') and obs is not None and obs.get('exists') is False:\\n            outcomes.append('NOT_APPLICABLE')\\n            continue\\n        if obs is None or obs.get('error'):\\n            outcomes.append('UNRESOLVED')\\n        elif obs.get('engine_result') == 'NOT_APPLICABLE':\\n            outcomes.append('NOT_APPLICABLE')\\n        elif not isinstance(obs.get('stdout'), str):\\n            raise ValueError('觀察必須提供字串 stdout')\\n        else:\\n            outcomes.append('PASS' if any(pattern.search(line) for line in obs['stdout'].split('\\\\n')) else 'FAIL')\\n    # 官方 all：任何 FAIL 優先；未知執行不擅自轉成 N/A。\\n    if 'FAIL' in outcomes:\\n        return 'FAIL'\\n    if 'UNRESOLVED' in outcomes:\\n        return 'UNRESOLVED'\\n    return 'NOT_APPLICABLE' if 'NOT_APPLICABLE' in outcomes else 'PASS'\\n\\\"\\\"\\\"python3 -m linuxgcb：完全離線，不執行 SCA 命令。\\\"\\\"\\\"\\nimport argparse\\nimport json\\nfrom datetime import datetime, timezone\\nfrom pathlib import Path\\nfrom .catalog import write_registry\\nfrom .policy import build, validate\\nfrom .report import render\\nfrom .collector import timestamp\\n\\n\\ndef main():\\n    parser = argparse.ArgumentParser(description='LinuxGCB 離線工具（未完成真機驗收）')\\n    sub = parser.add_subparsers(dest='command', required=True)\\n    sub.add_parser('build', help='驗證來源並重建 registry 與候選政策')\\n    sub.add_parser('validate', help='離線結構與來源檢查，非引擎驗收')\\n    report = sub.add_parser('report', help='匯入離線 JSON，輸出 HTML/CSV 與稽核副本')\\n    report.add_argument('snapshot')\\n    report.add_argument('--out', required=True)\\n    report.add_argument('--now', help='固定報表時間，ISO8601 含時區')\\n    args = parser.parse_args()\\n    if args.command == 'build':\\n        rows = write_registry()\\n        build()\\n        print(f'314 項；307 候選／7 排除；{validate()} 項候選規則，UNVALIDATED／人工審查待完成')\\n    elif args.command == 'validate':\\n        print('UNVALIDATED：離線結構檢查通過，候選控制項數', validate())\\n    else:\\n        validate()\\n        result = render(json.loads(Path(args.snapshot).read_text()), args.out,\\n                        timestamp(args.now) if args.now else datetime.now(timezone.utc))\\n        print(json.dumps(result, ensure_ascii=False, indent=2))\\n\\nif __name__ == '__main__':\\n    main()\\n# Q1 既有 53 項候選品質審查\\n\\n日期：2026-10-30。工作目錄 `/home/skycity1010/projects/LinuxGCB-codex-quality1`，分支 `codex/linuxgcb-quality1`。基線為 HEAD 的未驗證候選，並非已接受產品。僅離線程式／來源審查；未執行政策、連線或變更端點，未新增 ID、helper、daemon、套件或人工端點步驟。Hermes 保有獨立接受、整合與溝通責任。\\n\\n本次 53/53 已完成程式與來源對照並列出發現，**不是 review pass**。offline-test pass 僅表示合成案例符合本程式契約；真正 Wazuh 驗證、來源解讀核准與父代理接受均未完成。母體仍 314 = 307 候選 + 7 排除，實作 ID 仍 53，其餘 254 未實作。coverage full 0／partial 48／blocked 5；execution_review blocked 53；live validated 0。\\n\\n## 依據與審查方式\\n\\n讀取 PLAN、原始 controls.json、全部 53 項 DOCX cells、BATCH1_REVIEW、三份 emitted policies、batch1/policy/catalog/coverage/report 與相關測試程式；不是沿用歷史摘要。manifest schema v2 的 `reviewed` 保存全部 53 項 source sheet/row、DOCX 每次出現的 cells 與 hash、逐項問題與狀態。0301／0302 修訂表重複出現的來源保留。0141 不擴充為所有規則集合的完成宣告。\\n\\nWazuh 依據限既有有效快照：creating-custom-policies 的 rule syntax／condition／regex_type／缺失內容目標，how-it-works 的錯誤 N/A 與差異傳送，how-to-configure／internal-options 的集中下發、安全開關與 timeout。sca-custom-policies 是 soft404，未引用。沒有為此次離線工作瀏覽外網；部署版本差異仍是 gate。\\n\\n數值 stat 依據為本機 GNU coreutils `stat(1)` 手冊：`%f` raw mode in hex、`%a` 八進位 mode、`%u/%g` 數字身分、`%U/%G` 名稱、`-L` follow links；已讀取 `/usr/share/man/man1/stat.1.gz`，未執行 generated commands。以 Python stat 常數生成明示 SYNTHETIC 型態案例，不把本機文件或常數當成目標 RHEL9 真機證據。\\n\\n## 發現與處置\\n\\n共 9 類：高 6、中 3、重大 0。嚴重度按可能錯誤符合宣告與適用性影響，非 53 項的相加項數。規則 ID 可直接定位 policies；函式定位可用 `rg -n`，避免重建後行號漂移。\\n\\n| 問題 | 程度／位置與影響 | 可重現 SYNTHETIC 案例 | 處置與殘餘風險 |\\n| --- | --- | --- | --- |\\n| Q1-01 | 高；policy.definitions／batch1.rules，全部 53 ID | 每個 rule 的正向 stdout 配 exit_code=1/127、stderr=error，仍匹配 PASS | 不假造退出碼保護。現有正向匹配無法證明命令完整成功；53 項 execution_review blocked、描述逐項列問題，報表阻止 raw PASS 成為 verified compliance。需目標引擎錯誤辨識證據；若要可靠狀態標記須另提核准架構。 |\\n| Q1-02 | 高；report.normalize／metrics | 全部 53 回 passed，舊版把 full 候選計為 PASS／完整率 | 已修正：raw_result 保留，blocked／partial passed 為 MANUAL_PENDING；候選 FAIL 保留，但完整率不計未驗證判定。新增 verified_compliance／raw_observed／verified_decided。未著作虛構掃描。 |\\n| Q1-03 | 中；batch1.rules，FILES 全部 | 中文／德文型態不是英文 regular file；舊版 false FAIL。舊版額外拒絕非 regular | 已移除所有 %F。來源明列目錄的 0179、0193–0202 以 `%f` 的 `^4[0-9a-f]{3}$` 核對型態；不附加來源未明定的 regular 限制。多語系為具名合成情境，非已安裝 locale 真測。 |\\n| Q1-04 | 高；0045/0046 與 FILES metadata | root 擁有的 symlink 可有 root:root；NSS 名稱 root 不必證明 uid=0；ACL 可能有額外或 default entries | 來源明列 chown/chmod，未明定 regular-only 或 symlink 的符合性；不猜解參照、不固定 shadow GID、不把 %U:%G 名稱當完整身分保證。0045 數字 0:0 與其他名稱規則差異保留待來源核准。mode mask 窮舉 0000–7777，拒絕額外 special bits；ACL mask 對 effective 權限與 default ACL、特殊位元是否額外要求均待審，不宣稱已檢查 ACL。 |\\n| Q1-05 | 高；0053–0060、0141、0178、0191/0192，report.normalize | 備份／角色相關檔案缺失，stat 空輸出、N/A、權限錯誤不可混同 | 不創建或讀取秘密檔內容。新 evidence_status missing 為 MANUAL_PENDING，tool_error／permission_error／timeout 為 ERROR，raw 原樣保存；缺失需明確證據與適用性核准才 N/A。無分類的 raw failed 仍是候選 FAIL 觀察，非已驗證不符合或自動核准 N/A。 |\\n| Q1-06 | 高；0030/0094/0097/0098/0101/0133/0175/0243/0245 systemctl show | 各 property 分次讀取可混合狀態；service inactive 不能證明無 socket／alias 啟動路徑；錯誤 stdout 也可匹配 | 保留實際 unit 身分與嚴格 raw predicate，不把 disabled/masked、active/inactive/failed 混為一談。沒有已驗證的無相依原生命令組合解決原子性、啟動閉包與錯誤區分；execution blocked。enabled-runtime、masked-runtime、static、alias、indirect 不自動批准。 |\\n| Q1-07 | 中；0030/0094/0097/0098/0245 | 不必要服務不存在、LoadState=not-found，舊規則 raw FAIL；D-Bus failure 也可能無輸出 | 來源意圖可能已滿足，不能只因不存在宣告不符合。這 5 項 coverage blocked，新增 absence_unverified 治理待審；不以空輸出或文字錯誤自動 PASS。0030 原方法 disable；0094/0097/0098/0245 原方法 mask，來源核准須分別決定不存在與已安裝遮蔽的處置。 |\\n| Q1-08 | 高；0108/0141/0269/0270 | live sysctl=0 但持久=1；其他 rules.d 弱權限；sshd 預設 no、Match 情境 yes | 保留 partial、raw passed 待審。未擴充掃描、未改變來源設定方法；須核准解析／情境設計及 RHEL9 證據。 |\\n| Q1-09 | 中；policy.parse_rule／simulate | p:、複合 regex、lookahead、空 rules 舊版可默默近似；splitlines 將內嵌 CR 拆行成 PASS | 已限制現有 c:/f: 單一正向 r:、all、固定 emitted patterns 與簡單 ASCII literal；其他語法先拒絕。以 LF 分行，內嵌 CR 不自行拆出符合行。仍不是 PCRE2／Wazuh 引擎驗收。 |\\n\\n## 各實作族結論\\n\\n檔案 metadata 共 36 項（原有 0045/0046 + FILES 34 項）：權限採位元子集合，000 要求精確零，不作八進位大小比較。來源的「目錄」支持 directory predicate；來源的「檔案」不必然限定 regular，移除額外限制後必須把 symlink／FIFO／socket／device 的來源解讀交回核准，不稱它們符合。目錄型態檢查不替代 mode 檢查，owner 控制不偷偷加入 mode 限制。備份檔不存在和查詢失敗無法由空輸出區分；僅保留 metadata，不存 shadow/gshadow 內容。cron.d 未聲稱檢查內部檔案。\\n\\nRPM 存在共 5 項：0033 sudo、0132 audit + audit-libs（兩者都必要）、0174 rsyslog、0183 libselinux、0242 firewalld。queryformat 正向標記避免「否定空輸出＝未安裝」問題，仍不能保證 RPM DB 失敗而部分 stdout 不會 false PASS；不代表 AIDE 初始化或其他來源要求，未擴充 ID。\\n\\nsystemd 共 9 項：0030 autofs disabled；0094 rsyncd／0097 squid／0098 smb masked；0101 kdump／0133 auditd／0175 rsyslog／0243 firewalld enabled 且 active；0245 nftables masked 且 inactive。失敗、暫態、runtime、static、alias 都保留原始差異；沒有把 failed 當 inactive。停用組的不存在可能滿足降低攻擊面的意圖，但 mask 設定方法與合法 absence 要分別核准；D-Bus、權限與工具錯誤不能偽裝 absence。socket activation、alias canonical unit、masked-runtime 持久性與狀態競態尚未完整實作；不能自行增設 helper。\\n\\n0245 以 Firewalld profile 核准適用；nftables backend 不等於 nftables.service。來源寫明 Firewalld 相依套件與停用並遮蔽的目的，不將 Nftables 工作表納入，也不建立完整 Nftables 政策。\\n\\nsysctl 1 項與 SSH 2 項維持原部分候選，分別欠缺持久設定／路由角色與 Match／使用者／來源矩陣，不能用單次 stdout 宣告完整要求。\\n\\n## 模擬與報表的明確邊界\\n\\n模擬器不執行命令；exit_code 與 stderr 不影響 stdout regex。error 是呼叫端「無可靠觀察」診斷，只回 UNRESOLVED，並非假設 Wazuh 有相同錯誤辨識。engine_result=NOT_APPLICABLE 是明確 fixture／引擎結果；f: 內容目標 exists=False 按文件 N/A，空內容為 FAIL。all 有 FAIL 優先；未定觀察次之，再 N/A。any／none 未被發出，測試確保拒絕，不宣稱模擬它們。\\n\\nPython re.ASCII 僅替代現有有限模式的逐 LF 行 search。PCRE2 Unicode/UCP、case folding、lookaround、backreference、possessive quantifier、CRLF/newline convention、NUL、截斷、輸出編碼及 Wazuh regex flags 未驗證；未知語法拒絕。Wazuh argv／命令啟動、stdout/stderr 合併、timeout、權限、檔案競態與 N/A 真實轉換都不由模型保證。%f 的格式與 locale 無關係是離線設計依據，仍須目標 coreutils 版本實測。\\n\\n報表 `state=FAIL` 可保留候選負向觀察，只有 `verified_compliance=true` 才計完整判定。full 與 execution_review=passed 同時具備才可計分，目前無項目具備；不能靠來源命名或附上 UNVALIDATED 字樣繼續計為完整。缺失與工具錯誤 evidence_status 是明確離線輸入契約，不是新增端點探測器。未提供原因時不能自行推論 missing，也沒有由 stdout 發明原因。\\n\\n## 逐 ID 對帳\\n\\n以下 suffix 均指 TWGCB-01-012-，數字 SCA ID 為 900000 + suffix。每項 execution_review=blocked、source_approval=pending、live_validation=UNVALIDATED；問題代碼對應上表的案例、處置與殘餘風險。完整來源逐格證據見 manifest.reviewed。\\n\\n| ID | SCA ID | 實作族／實際對象 | 來源期望 | coverage | 發現 |\\n| --- | --- | --- | --- | --- | --- |\\n| 0030 | 900030 | systemd 服務 / autofs.service | 停用 | blocked | Q1-01, Q1-06, Q1-07 |\\n| 0033 | 900033 | RPM 存在 / sudo | 安裝 | partial | Q1-01 |\\n| 0045 | 900045 | 檔案 metadata / /etc/passwd owner | root:root | partial | Q1-01, Q1-03, Q1-04 |\\n| 0046 | 900046 | 檔案 metadata / /etc/passwd mode | 644或更低權限 | partial | Q1-01, Q1-03, Q1-04 |\\n| 0047 | 900047 | 檔案 metadata / /etc/shadow | root:root或root:shadow | partial | Q1-01, Q1-03, Q1-04 |\\n| 0048 | 900048 | 檔案 metadata / /etc/shadow | 000 | partial | Q1-01, Q1-03, Q1-04 |\\n| 0049 | 900049 | 檔案 metadata / /etc/group | root:root | partial | Q1-01, Q1-03, Q1-04 |\\n| 0050 | 900050 | 檔案 metadata / /etc/group | 644或更低權限 | partial | Q1-01, Q1-03, Q1-04 |\\n| 0051 | 900051 | 檔案 metadata / /etc/gshadow | root:root或root:shadow | partial | Q1-01, Q1-03, Q1-04 |\\n| 0052 | 900052 | 檔案 metadata / /etc/gshadow | 000 | partial | Q1-01, Q1-03, Q1-04 |\\n| 0053 | 900053 | 檔案 metadata / /etc/passwd- | root:root | partial | Q1-01, Q1-03, Q1-04, Q1-05 |\\n| 0054 | 900054 | 檔案 metadata / /etc/passwd- | 644或更低權限 | partial | Q1-01, Q1-03, Q1-04, Q1-05 |\\n| 0055 | 900055 | 檔案 metadata / /etc/shadow- | root:root或root:shadow | partial | Q1-01, Q1-03, Q1-04, Q1-05 |\\n| 0056 | 900056 | 檔案 metadata / /etc/shadow- | 000 | partial | Q1-01, Q1-03, Q1-04, Q1-05 |\\n| 0057 | 900057 | 檔案 metadata / /etc/group- | root:root | partial | Q1-01, Q1-03, Q1-04, Q1-05 |\\n| 0058 | 900058 | 檔案 metadata / /etc/group- | 644或更低權限 | partial | Q1-01, Q1-03, Q1-04, Q1-05 |\\n| 0059 | 900059 | 檔案 metadata / /etc/gshadow- | root:root或root:shadow | partial | Q1-01, Q1-03, Q1-04, Q1-05 |\\n| 0060 | 900060 | 檔案 metadata / /etc/gshadow- | 000 | partial | Q1-01, Q1-03, Q1-04, Q1-05 |\\n| 0094 | 900094 | systemd 服務 / rsyncd.service | 停用 | blocked | Q1-01, Q1-06, Q1-07 |\\n| 0097 | 900097 | systemd 服務 / squid.service | 停用 | blocked | Q1-01, Q1-06, Q1-07 |\\n| 0098 | 900098 | systemd 服務 / smb.service | 停用 | blocked | Q1-01, Q1-06, Q1-07 |\\n| 0101 | 900101 | systemd 服務 / kdump.service | 啟用 | partial | Q1-01, Q1-06 |\\n| 0108 | 900108 | sysctl 即時值 / IPv4/IPv6 forwarding | 0 | partial | Q1-01, Q1-08 |\\n| 0132 | 900132 | RPM 存在 / audit, audit-libs | 安裝 | partial | Q1-01 |\\n| 0133 | 900133 | systemd 服務 / auditd.service | 啟用 | partial | Q1-01, Q1-06 |\\n| 0141 | 900141 | 檔案 metadata / /etc/audit/rules.d/audit.rules | 600或更低權限 | partial | Q1-01, Q1-03, Q1-04, Q1-05, Q1-08 |\\n| 0142 | 900142 | 檔案 metadata / /etc/audit/auditd.conf | 640或更低權限 | partial | Q1-01, Q1-03, Q1-04 |\\n| 0174 | 900174 | RPM 存在 / rsyslog | 安裝 | partial | Q1-01 |\\n| 0175 | 900175 | systemd 服務 / rsyslog.service | 啟用 | partial | Q1-01, Q1-06 |\\n| 0178 | 900178 | 檔案 metadata / /var/log/messages | root:root | partial | Q1-01, Q1-03, Q1-04, Q1-05 |\\n| 0179 | 900179 | 檔案 metadata / /var/log | root:root | partial | Q1-01, Q1-03, Q1-04 |\\n| 0183 | 900183 | RPM 存在 / libselinux | 安裝 | partial | Q1-01 |\\n| 0191 | 900191 | 檔案 metadata / /etc/crontab | root:root | partial | Q1-01, Q1-03, Q1-04, Q1-05 |\\n| 0192 | 900192 | 檔案 metadata / /etc/crontab | 600或更低權限 | partial | Q1-01, Q1-03, Q1-04, Q1-05 |\\n| 0193 | 900193 | 檔案 metadata / /etc/cron.hourly | root:root | partial | Q1-01, Q1-03, Q1-04 |\\n| 0194 | 900194 | 檔案 metadata / /etc/cron.hourly | 700或更低權限 | partial | Q1-01, Q1-03, Q1-04 |\\n| 0195 | 900195 | 檔案 metadata / /etc/cron.daily | root:root | partial | Q1-01, Q1-03, Q1-04 |\\n| 0196 | 900196 | 檔案 metadata / /etc/cron.daily | 700或更低權限 | partial | Q1-01, Q1-03, Q1-04 |\\n| 0197 | 900197 | 檔案 metadata / /etc/cron.weekly | root:root | partial | Q1-01, Q1-03, Q1-04 |\\n| 0198 | 900198 | 檔案 metadata / /etc/cron.weekly | 700或更低權限 | partial | Q1-01, Q1-03, Q1-04 |\\n| 0199 | 900199 | 檔案 metadata / /etc/cron.monthly | root:root | partial | Q1-01, Q1-03, Q1-04 |\\n| 0200 | 900200 | 檔案 metadata / /etc/cron.monthly | 700或更低權限 | partial | Q1-01, Q1-03, Q1-04 |\\n| 0201 | 900201 | 檔案 metadata / /etc/cron.d | root:root | partial | Q1-01, Q1-03, Q1-04 |\\n| 0202 | 900202 | 檔案 metadata / /etc/cron.d | 700或更低權限 | partial | Q1-01, Q1-03, Q1-04 |\\n| 0301 | 900301 | 檔案 metadata / /etc/shells | root:root | partial | Q1-01, Q1-03, Q1-04 |\\n| 0302 | 900302 | 檔案 metadata / /etc/shells | 644或更低權限 | partial | Q1-01, Q1-03, Q1-04 |\\n| 0242 | 900242 | RPM 存在 / firewalld | 安裝 | partial | Q1-01 |\\n| 0243 | 900243 | systemd 服務 / firewalld.service | 啟用 | partial | Q1-01, Q1-06 |\\n| 0245 | 900245 | systemd 服務 / nftables.service | 停用 | blocked | Q1-01, Q1-06, Q1-07 |\\n| 0256 | 900256 | 檔案 metadata / /etc/ssh/sshd_config | root:root | partial | Q1-01, Q1-03, Q1-04 |\\n| 0257 | 900257 | 檔案 metadata / /etc/ssh/sshd_config | 600或更低權限 | partial | Q1-01, Q1-03, Q1-04 |\\n| 0269 | 900269 | SSH 預設有效設定 / PermitRootLogin | no | partial | Q1-01, Q1-08 |\\n| 0270 | 900270 | SSH 預設有效設定 / PermitEmptyPasswords | no | partial | Q1-01, Q1-08 |\\n\\n## 實際執行證據與重跑方式\\n\\n基線 HEAD：`ca76af50b6a2805bc8de29d6f06315639fb9daa2`。將 HEAD 已追蹤內容複製到 `/tmp` 的暫存目錄，只加入目前 `tests/test_quality_q1.py`，執行 `python3 -m unittest discover -s tests -p test_quality_q1.py -v`：11 methods，exit 1，**96 failures（包含 subtests）、1 error**。error 為基線缺少新增報表契約欄位；失敗包含既有 raw PASS 計分、missing 治理、%F、未知語法與 CR 拆行。這不是 97 個獨立測試方法。完整輸出保留於忽略產物 `out/q1-baseline-regression.txt`；未執行其中任何政策命令。\\n\\n目前版本實際重跑全部 exit 0：\\n\\n```bash\\npython3 -m linuxgcb build\\npython3 -m linuxgcb validate\\npython3 -m unittest discover -s tests -v\\npython3 -m linuxgcb report tests/fixtures/snapshot.json --out out/q1-synthetic --now 2026-10-30T00:00:00Z\\ngit diff --check\\n```\\n\\n**38 tests 全數 OK**，包含 11 個新增 Q1 methods；mode 子案例窮舉 0000–7777、來源逐格對照、53 項 positive/negative/missing/empty/error/nonzero matching、全部 9 服務的 property 狀態矩陣、7 種型態與 3 個具名合成語系、unsupported syntax、all 聚合、報表端到端。語系資料是合成，沒有實際變更 locale 或掃描開發機。\\n\\nSYNTHETIC 報表：314 列，適用 307，MANUAL_PENDING 260、NOT_SCANNED 45、候選 FAIL 1、ERROR 1、EXCLUDED 7、PASS 0；raw_observed 6、verified_decided 0、pass_rate null、attainment 0%、completeness 0%。歷史交接所寫「七筆觀察」不精確：目前及 HEAD snapshot 實際均只有 6 個 checks；沒有補造第七筆。重建僅更新 fixture policy hashes。\\n\\n來源逐位元對照 HEAD 未變：\\n\\n| 來源 | SHA256 |\\n| --- | --- |\\n| XLSX | `7d752b639a1e780df08814c6252efadd3ea2711eaa5c9d91c070b84a296c0247` |\\n| DOCX | `986effd9501b1fd97776129c6691cf8fc98246bd04514347322f3337508e0e5b` |\\n| controls.json | `a95f8358b18f57600c97c0023bb48f98a867adf09c2535f86d9be25e28643be4` |\\n| inventory.json | `b7351760043d1732aef3ebe3df38fde2d6065f63ac87dc17cd037bc1ca6d769e` |\\n\\n全部 314 數字 ID 序列與既有 53 候選 ID 集合均等於 HEAD；政策 manifest 重算對帳 53。歷史 BATCH1_REVIEW、HANDOFF、CODEX_HANDOFF、CODEX_BATCH1_HANDOFF 與來源均未重寫。\\n\\n## RHEL9 接受 gates 與架構待核准點\\n\\n依 NEXT_STEPS 固定目標版本，在核准可還原試驗環境測三份 YAML 載入與逐族正常／負向／錯誤、非零但匹配輸出、stdout/stderr／timeout／argv 與 PCRE2 的真實結果，對照 Agent log、Manager API、人工唯讀證據。先做失敗注入再談解除 blocked；不得以本機 38 tests 代替。\\n\\n來源核准另確認 metadata 的 symlink／ACL／NSS／special bits、備份缺失及 optional file、停用與 mask 的合法 absence；核對 socket、alias、static、runtime 狀態與 Firewalld 適用條件。保留真正 source identities，不推導完整 nftables 政策。\\n\\n若原生固定命令無法可靠封裝退出狀態，候選提案為「固定唯讀、失敗分支不輸出 PASS 標記的受控執行器」，需另審命令白名單、執行上限、stdout 格式、競態、集中配送／hash／權限與更新回復，並沿用已核准 bootstrap 慣例。**本次沒有實作此架構，也沒有新增端點安裝或人工步驟；此變更停止於提案，等待明確授權。** 即使引擎能辨識部分錯誤，仍需逐族證據才能解除相應阻擋。\\n\\n修改範圍：linuxgcb 的 batch1/catalog/coverage/policy/report，新增 quality；三份候選 policies；scope_registry/coverage_manifest/policy_hashes；測試與合成 fixtures；README/NEXT_STEPS/POLICIES 與本文件。保留 inspectable 未提交 diff，不 merge、不宣稱 Hermes 接受。精確檔案與增刪量以 `git status --short`、`git diff --stat` 與新檔 diff 查閱。\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./codex_fix1.log:20:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_10\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"ls scripts; head -35 tests/fixtures/rule_outputs.json; sed -n '1,100p' linuxgcb/catalog.py; rg -n 'fixtures|positive|nonzero_matching' scripts\\\"\",\"aggregated_output\":\"inventory.py\\n{\\n  \\\"label\\\": \\\"SYNTHETIC TEST ONLY\\\",\\n  \\\"checks\\\": {\\n    \\\"900045\\\": {\\n      \\\"positive\\\": {\\n        \\\"c:/usr/bin/stat -c %u:%g /etc/passwd\\\": {\\n          \\\"stdout\\\": \\\"0:0\\\",\\n          \\\"exit_code\\\": 0\\n        }\\n      },\\n      \\\"negative\\\": {\\n        \\\"c:/usr/bin/stat -c %u:%g /etc/passwd\\\": {\\n          \\\"stdout\\\": \\\"INVALID_SYNTHETIC_VALUE\\\",\\n          \\\"exit_code\\\": 0\\n        }\\n      },\\n      \\\"missing\\\": {},\\n      \\\"error\\\": {\\n        \\\"c:/usr/bin/stat -c %u:%g /etc/passwd\\\": {\\n          \\\"stdout\\\": \\\"0:0\\\",\\n          \\\"exit_code\\\": 0,\\n          \\\"error\\\": \\\"SYNTHETIC missing utility/permission/timeout; engine behavior unresolved\\\"\\n        }\\n      },\\n      \\\"empty\\\": {\\n        \\\"c:/usr/bin/stat -c %u:%g /etc/passwd\\\": {\\n          \\\"stdout\\\": 
t diff --stat; sed -n '1,65p' tests/test_fix1.py; rg '53|48|46|policy_hashes' tests -g '*.py'\\\"\",\"aggregated_output\":\"64:      - 'f:$sshd_file -> !r:^# && r:Port && !r:\\\\s*\\\\t*22$'\\n192:Rules can check for the existence of files, directories, registry keys and values, running processes, and recursively test for the existence of files inside directories. When it comes to content checking, they are able to check for file contents, recursively check for the contents of files inside directories, command output, and registry value data.\\n194:Abstractly, rules start with a location and a type of location that is the target of the test, followed by the actual test specification. Such tests fall into two categories: existence and content checks. The type of location is listed in the [Rule types](https://documentation.wazuh.com/current/user-manual/capabilities/sec-config-assessment/creating-custom-policies.html#rule-types) table below, and the location could be a file name, directory, process name, command, or a registry key.\\n231:You can place `not` at the beginning of a rule to negate it. For example:\\n292:Content check operator results can be negated by adding a `!` before then, for example:\\n297:f:/etc/ssh_config -> !r:PermitRootLogin\\n302:Be careful when negating content operators as that makes them evaluate as **Passed** for anything that does not match with the check specified. For example, rule `f:/etc/ssh_config -> !r:PermitRootLogin` is evaluated as Passed if it finds any line that does not contain `PermitRootLogin`.\\n309:f:/etc/ssh_config -> !r:^# && r:Protocol && r:2\\n323:- `c:systemctl is-enabled cups -> r:^enabled` checks that the output of the command contains a line starting with enabled.\\n365:##### Rule syntax for commands [Permalink to this headline](https://documentation.wazuh.com/current/user-manual/capabilities/sec-config-assessment/creating-custom-policies.html\\\\#rule-syntax-for-commands \\\"Permalink to this headline\\\")\\n367:- Check the output of a command `c:command -> output`\\n369:- Check the output of a command using regex `c:command -> r:REGEX`\\n371:- Check a numeric value `c:command -> n:REGEX_WITH_A_CAPTURE_GROUP compare >= number`\\n385:- Check if there is a line that does not begin with `#` and contains `Port 22``f:/etc/ssh/sshd_config -> !r:^# && r:Port\\\\.+22`\\n387:- Check if there is no line that does not begin with `#` and contains `Port 22``not f:/etc/ssh/sshd_config -> !r:^# && r:Port\\\\.+22`\\n404:- Check the running configuration of sshd for the maximum authentication tries allowed: `c:sshd -T -> !r:^\\\\s*maxauthtries\\\\s+4\\\\s*$`\\n406:- Check if root is the only account with UID 0: `f:/etc/passwd -> !r:^# && !r:^root: && r:^\\\\w+:\\\\w+:0:`\\n data/coverage_manifest.json      | 3536 ++++++++++++++++++++++++++++++++------\\n data/policy_hashes.json          |    4 +-\\n data/scope_registry.json         |  924 ++++++----\\n linuxgcb/catalog.py              |    2 +\\n linuxgcb/coverage.py             |   13 +-\\n linuxgcb/expected.py             |    4 +\\n linuxgcb/policy.py               |   43 +-\\n linuxgcb/quality.py              |    6 +\\n policies/linuxgcb_base.yml       |  304 ++++\\n policies/linuxgcb_sshd.yml       |  517 ++++++\\n tests/fixtures/rule_outputs.json | 2454 ++++++++++++++++++++++++++\\n tests/fixtures/snapshot.json     |    4 +-\\n tests/test_catalog_policy.py     |    5 +-\\n tests/test_expected.py           |    2 +\\n tests/test_quality_q1.py         |    4 +-\\n 15 files changed, 6998 insertions(+), 824 deletions(-)\\n\\\"\\\"\\\"SYNTHETIC TEST ONLY: output fixtures; never execute policy commands.\\\"\\\"\\\"\\nimport copy\\nimport itertools\\nimport json\\nimport unittest\\n\\nfrom linuxgcb.batch1 import DISABLED_SERVICES\\nfrom linuxgcb.catalog import ROOT\\nfrom linuxgcb.policy import simulate\\n\\n\\nclass Fix1Tests(unittest.TestCase):\\n    def setUp(self):\\n        self.checks = {c['id']: c for p in (ROOT/'policies').glob('*.yml')\\n                       for c in json.loads(p.read_text())['checks']}\\n        self.fixtures = json.loads((ROOT/'tests/fixtures/rule_outputs.json').read_text())\\n\\n    def test_named_service_cases_use_emitted_all_rules(self):\\n        self.assertEqual(self.fixtures['label'], 'SYNTHETIC TEST ONLY')\\n        for n in DISABLED_SERVICES:\\n            check = self.checks[900000+n]\\n            self.assertEqual(check['condition'], 'all')\\n            cases = self.fixtures['checks'][str(900000+n)]\\n            for name, want in [('not_found', 'PASS'), ('installed_enabled', 'FAIL'),\\n                               ('installed_disabled_inactive', 'PASS'),\\n                               ('installed_masked', 'PASS'), ('empty', 'FAIL'),\\n                               ('error', 'UNRESOLVED'), ('missing', 'UNRESOLVED')]:\\n                with self.subTest(id=check['id'], case=name):\\n                    self.assertEqual(simulate(check, cases[name]), want)\\n\\n    def test_every_service_state_and_samba_member(self):\\n        # Mutate each Samba member separately: smb PASS cannot hide unsafe nmb.\\n        for n, units in DISABLED_SERVICES.items():\\n            check = self.checks[900000+n]\\n            base = self.fixtures['checks'][str(900000+n)]['positive']\\n            for unit in units:\\n                cmd = 'c:/usr/bin/systemctl show '+unit+'.service'\\n                for load, state, active in itertools.product(\\n                    ('loaded', 'masked', 'error', 'bad-setting'),\\n                    ('disabled', 'masked', 'enabled', 'enabled-runtime',\\n                     'static', 'alias', 'indirect', 'masked-runtime', ''),\\n                    ('inactive', 'active', 'failed', 'activating', 'deactivating')):\\n                    obs = copy.deepcopy(base)\\n                    obs[cmd+' --property=LoadState']['stdout'] = 'LoadState='+load\\n                    obs[cmd+' --property=ActiveState']['stdout'] = 'ActiveState='+active\\n                    obs[cmd+' --property=LoadState --property=UnitFileState']['stdout'] = (\\n                        'LoadState='+load+'\\\\nUnitFileState='+state)\\n                    want = ('PASS' if load in ('loaded', 'masked') and\\n                            state in ('disabled', 'masked') and active == 'inactive' else 'FAIL')\\n                    with self.subTest(id=check['id'], unit=unit, load=load, state=state, active=active):\\n                        self.assertEqual(simulate(check, obs), want)\\n                for active in ('inactive', 'active', 'failed', 'activating'):\\n                    obs = copy.deepcopy(base)\\n                    obs[cmd+' --property=LoadState']['stdout'] = 'LoadState=not-found'\\n                    obs[cmd+' --property=ActiveState']['stdout'] = 'ActiveState='+active\\n                    # Missing properties may be omitted by systemctl show.\\n                    for suffix in ('', '\\\\nUnitFileState='):\\n                        obs[cmd+' --property=LoadState --property=UnitFileState']['stdout'] = 'LoadState=not-found'+suffix\\n                        self.assertEqual(simulate(check, obs), 'PASS' if active == 'inactive' else 'FAIL')\\n\\n    def test_absence_requires_explicit_stdout_and_errors_stay_unresolved(self):\\n        for n in DISABLED_SERVICES:\\n            check = self.checks[900000+n]\\n            cases = self.fixtures['checks'][str(900000+n)]\\n            for key in cases['positive']:\\ntests/test_quality_q1.py:        self.assertEqual(len(rows),53)\\ntests/test_quality_q1.py:        for n in (53,54,55,56,57,58,59,60,30,94,97,98,245):\\ntests/test_report.py:        self.assertTrue(by[900046]['exception_approved'])\\ntests/test_report.py:        self.assertEqual(by[900046]['state'],'FAIL')\\ntests/test_report.py:        h['not_applicable']={f'TWGCB-01-012-{n:04d}':copy.deepcopy(approved) for n in (45,46,243)}\\ntests/test_report.py:        self.assertEqual(by[900046]['state'],'FAIL')\\ntests/test_report.py:        mutations=[lambda s:s.update(source_sha256='bad'),lambda s:s.update(policy_hashes={}),\\ntests/test_report.py:            bad=next(r for r in rows if r['sca_id']=='900046')\\ntests/test_snapshot.py:        self.assertEqual(Counter(c['result'] for c in host['checks']), {'passed':46,'failed':7})\\ntests/test_expected.py:    def test_all_53_source_values_and_q1_preserved(self):\\ntests/test_expected.py:        self.assertEqual(len(checks), 53)\\ntests/test_expected.py:                self.assertEqual(len(observed), 53)\\ntests/test_catalog_policy.py:        c=next(c for c in json.loads((ROOT/'policies/linuxgcb_base.yml').read_text())['checks'] if c['id']==900046)\\ntests/test_catalog_policy.py:        self.assertEqual((m['counts']['full'],m['counts']['partial'],m['counts']['blocked']),(0,48+len(BATCH2),5))\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./codex_p2b2.log:49:{\"type\":\"item.started\",\"item\":{\"id\":\"item_26\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"cat > tests/test_batch2.py <<'PY'\\n\\\\\\\"\\\\\\\"\\\\\\\"BATCH2 synthetic contract/guard tests. Never execute any policy command.\\n\\nThe only subprocesses run shell builtins with authored printf/exit data, after\\nreplacing the entire inventory command in the emitted shell script.\\n\\\\\\\"\\\\\\\"\\\\\\\"\\nimport copy\\nimport hashlib\\nimport json\\nimport re\\nimport shlex\\nimport subprocess\\nimport unittest\\n\\nfrom linuxgcb.batch2 import ADDED, CATEGORIES, MARKER, specs, guarded, expected\\nfrom linuxgcb.catalog import ROOT, registry\\nfrom linuxgcb.policy import emit_rule, parse_rule, simulate\\nfrom scripts.batch2_fixtures import generated\\n\\n\\nclass Batch2Tests(unittest.TestCase):\\n    @classmethod\\n    def setUpClass(cls):\\n        cls.checks={c['id']:c for p in (ROOT/'policies').glob('*.yml') for c in json.loads(p.read_text())['checks']}\\n        cls.fixtures=json.loads((ROOT/'tests/fixtures/rule_outputs.json').read_text())['checks']\\n        cls.baseline=json.loads((ROOT/'tests/fixtures/batch2_baseline.json').read_text())\\n\\n    def check(self,n): return self.checks[900000+n]\\n    def positive(self,n): return copy.deepcopy(self.fixtures[str(900000+n)]['positive'])\\n\\n    def test_registry_exact_remaining_categories_and_baseline(self):\\n        before={c['id'] for c in self.baseline['checks']}\\n        rows=registry()\\n        wanted={r['sca_id'] for r in rows if r['category'] in CATEGORIES and r['sca_id'] not in before}\\n        self.assertEqual(wanted,{900000+n for n in ADDED})\\n        self.assertEqual(len(ADDED),44)\\n        self.assertEqual(len(self.checks),97)\\n        self.assertFalse(any(r['coverage']=='unimplemented' for r in rows if r['category'] in CATEGORIES))\\n        self.assertEqual({c['id']:c for c in self.baseline['checks']}, {n:self.checks[n] for n in before})\\n        for filename,digest in self.baseline['hashes'].items():\\n            self.assertEqual(hashlib.sha256((ROOT/filename).read_bytes()).hexdigest(),digest)\\n        for row in rows:\\n            if row['sca_id'] not in before and row['category'] not in CATEGORIES:\\n                self.assertNotEqual(row['implementation'],'candidate')\\n        # Existing synthetic fixtures are also preserved field for field.\\n        original=json.loads((ROOT/'tests/fixtures/batch2_legacy_rule_outputs.json').read_text())\\n        self.assertEqual({key:self.fixtures[key] for key in original['checks']}, original['checks'])\\n\\n    def test_generated_fixtures_and_every_predicate_counterexample(self):\\n        self.assertEqual(generated(),{str(900000+n):self.fixtures[str(900000+n)] for n in ADDED})\\n        for n in sorted(ADDED):\\n            cases=self.fixtures[str(900000+n)]\\n            check=self.check(n)\\n            self.assertEqual(check['regex_type'],'pcre2')\\n            self.assertEqual(check['compliance'],[{'twgcb':['TWGCB-01-012-'+format(n,'04d')]}])\\n            for name,want in [('positive','PASS'),('negative','FAIL'),('missing','UNRESOLVED'),('empty','FAIL'),('error','UNRESOLVED'),('nonzero_matching','UNRESOLVED')]:\\n                with self.subTest(n=n,case=name): self.assertEqual(simulate(check,cases[name]),want)\\n            for case in cases['predicate_negatives']:\\n                with self.subTest(n=n,rule=case['rule']):\\n                    self.assertIn(case['rule'],check['rules'])\\n                    self.assertEqual(simulate(check,case['observations']),'FAIL')\\n            for target in cases['positive']:\\n                for variant in (None,dict(error='permission denied'),dict(stdout=cases['positive'][target]['stdout'],exit_code=127)):\\n                    obs=self.positive(n)\\n                    if variant is None: del obs[target]\\n                    else: obs[target]=variant\\n                    with self.subTest(n=n,target=target,variant=variant):\\n                        self.assertNotEqual(simulate(check,obs),'PASS')\\n\\n    def test_emitted_guard_with_fake_commands_only(self):\\n        for n,items in specs().items():\\n            for command,pattern,good,bad in items:\\n                target=guarded(command)\\n                # Obtain the actual emitted wrapper then replace its full inner\\n                # inventory command with a shell containing only printf/exit.\\n                self.assertIn(target,{parse_rule(rule)[0] for rule in self.check(n)['rules']})\\n                argv=shlex.split(target[2:])\\n                self.assertEqual(argv[:2],['/bin/sh','-c'])\\n                prefix='out=\\\"'$('\\\"'+command+')'\\n                self.assertTrue(argv[2].startswith(prefix))\\n                for code in (0,1,2,126,127):\\n                    payload=good+'\\\\\\\\n'+MARKER+'\\\\\\\\n'  # Even matching stdout cannot escape a failed command.\\n                    fake='/bin/sh -c '+shlex.quote('printf \\\\\\\"%s\\\\\\\" '+shlex.quote(payload)+'; exit '+str(code))\\n                    script='out=\\\"'$('\\\"'+fake+')'+argv[2][len(prefix):]\\n                    completed=subprocess.run(['/bin/sh','-c',script],text=True,capture_output=True,timeout=5)\\n                    self.assertEqual(completed.returncode,code)\\n                    self.assertEqual(completed.stdout,payload+MARKER+'\\\\\\\\n' if code==0 else '')\\n                    if code:\\n                        obs=self.positive(n)\\n                        obs[target]=dict(stdout=completed.stdout,exit_code=completed.returncode)\\n                        self.assertNotEqual(simulate(self.check(n),obs),'PASS')\\n\\n    def test_negation_is_rule_level_not_existential_line_negation(self):\\n        for n,items in specs().items():\\n            for command,pattern,good,bad in items:\\n                if not pattern.startswith('\\\"'!'\\\"'): continue\\n                rule=emit_rule(guarded(command),pattern)\\n                self.assertTrue(rule.startswith('not c:'))\\n                self.assertNotIn('\\\"'!r:'\\\"',rule)\\n                obs=self.positive(n)\\n                # A compliant unrelated line cannot hide a prohibited member.\\n                obs[guarded(command)]['stdout']='unrelated\\\\\\\\n'+bad+'\\\\\\\\n'+MARKER\\n                self.assertEqual(simulate(self.check(n),obs),'FAIL')\\n\\n    def test_default_protocol_and_compression(self):\\n        for text,want in [('port 22','PASS'),('protocol 2','PASS'),('protocol 1','FAIL'),('protocol 2,1','FAIL')]:\\n            obs=self.positive(255);target=next(iter(obs));obs[target]['stdout']=text+'\\\\\\\\n'+MARKER\\n            self.assertEqual(simulate(self.check(255),obs),want)\\n        for value,want in [('yes','PASS'),('delayed','PASS'),('no','PASS'),('invalid','FAIL')]:\\n            obs=self.positive(279);target=next(iter(obs));obs[target]['stdout']='compression '+value+'\\\\\\\\n'+MARKER\\n            self.assertEqual(simulate(self.check(279),obs),want)\\n        for n in (255,279): self.assertIn('RHEL9 OpenSSH 8.0+',self.check(n)['description'])\\n\\n    def test_numeric_boundaries_and_crypto_components(self):\\n        for n,key,maximum in ((266,'maxauthtries',4),(272,'clientaliveinterval',600),(273,'logingracetime',60),(277,'maxsessions',4)):\\n            for value in (-1,0,1,maximum,maximum+1,99999):\\n                obs=self.positive(n);target=next(iter(obs))\\n                obs[target]['stdout']=re.sub(key+r' [0-9]+',key+' '+str(value),obs[target]['stdout'])\\n                self.assertEqual(simulate(self.check(n),obs),'PASS' if 1<=value<=maximum else 'FAIL')\\n        for key,bad in [('ciphers','aes128-cbc'),('macs','hmac-md5'),('kexalgorithms','diffie-hellman-group1-sha1')]:\\n            obs=self.positive(263);target=next(iter(obs))\\n            obs[target]['stdout']=re.sub('\\\"'^'\\\"'+key+r' .*\\\"'$'\\\"',key+' '+bad,obs[target]['stdout'],flags=re.M)\\n            self.assertEqual(simulate(self.check(263),obs),'FAIL')\\n\\n    def test_key_sets_reject_empty_and_any_bad_member(self):\\n        for n in (259,260,261,262):\\n            check=self.check(n);obs=self.positive(n);target=next(iter(obs))\\n            obs[target]['stdout']=MARKER\\n            self.assertEqual(simulate(check,obs),'FAIL')\\n            bad=specs()[n][0][-1]\\n            obs=self.positive(n);obs[target]['stdout']+='\\\\\\\\n'+bad\\n            self.assertEqual(simulate(check,obs),'FAIL')\\n        for n,mask in ((204,0o600),(260,0o640),(262,0o644)):\\n            rule=next(r for r in self.check(n)['rules'] if not r.startswith('not ') and 'stat -c %a' in r)\\n            _,pattern=parse_rule(rule)\\n            for value in range(0o10000):\\n                self.assertEqual(bool(pattern.fullmatch(format(value,'o'))),value & ~mask==0)\\n\\n    def test_current_docx_amendment_and_concrete_values(self):\\n        manifest=json.loads((ROOT/'data/coverage_manifest.json').read_text())\\n        row=next(r for r in manifest['reviewed'] if r['sca_id']==900272)\\n        self.assertTrue(all('ClientAliveCountMax 1' in c[-2] for c in row['docx
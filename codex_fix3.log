檔案時間或交接描述代替。需提供同次離線 sca_scan_info 才能完成此驗收項。\\n\\n現有政策沒有 remediation 欄，DB 匯出為 null。政策本批禁止修改，因此無法提供非空的「政策內 remediation」；7 FAIL 均明示缺漏。這是來源限制，並未完成非空修復內容驗收。未執行 Excel／DOCX 修復、政策命令、開發機掃描、SSH、API、sudo 或服務操作。build 重建後政策與來源均無 diff。\\nEOF\\n git diff --stat; git diff -- policies; sha256sum tests/fixtures/realhost_r2.json /home/skycity1010/projects/LinuxGCB/data/realhost_scan_20261031_r2.json'\",\"aggregated_output\":\" README.md            | 13 +++++++++++++\\n linuxgcb/__main__.py | 12 ++++++++++++\\n linuxgcb/report.py   |  9 +++++++++\\n 3 files changed, 34 insertions(+)\\n3ab6eaa26139f432559c6e6140aa574794296fae96c9097524814baaf9d21066  tests/fixtures/realhost_r2.json\\n3ab6eaa26139f432559c6e6140aa574794296fae96c9097524814baaf9d21066  /home/skycity1010/projects/LinuxGCB/data/realhost_scan_20261031_r2.json\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./docs/references/how-it-works.md:243:For those databases, the corresponding SHA256 hashes are:\n./codex_exp1.log:11:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_5\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc 'cat linuxgcb/snapshot.py; cat linuxgcb/report.py'\",\"aggregated_output\":\"\\\"\\\"\\\"離線 Manager SQLite 匯出轉換；不推測掃描時間或補造證據。\\\"\\\"\\\"\\nimport copy\\nimport json\\nfrom datetime import datetime, timezone\\nfrom .catalog import ROOT, digest\\nfrom .collector import timestamp\\n\\nLABEL = 'REAL EVIDENCE agent010／真實掃描證據（agent 010 / RHEL9 192.168.1.61）'\\n\\n\\ndef scan_time(value):\\n    if isinstance(value, (int, float)) and not isinstance(value, bool):\\n        return datetime.fromtimestamp(value, timezone.utc).isoformat()\\n    return timestamp(value).isoformat()\\n\\n\\ndef convert(path, scan_info=None):\\n    \\\"\\\"\\\"scan_info: {policy_id: {end_scan: UTC epoch 或含時區 ISO8601}}。\\n\\n    scan_info 必須來自同次離線 DB 匯出，按 policy_id 對應，絕不以 hash join scan_id。\\n    \\\"\\\"\\\"\\n    from pathlib import Path\\n    path = Path(path)\\n    dump = json.loads(path.read_text())\\n    policies = {}\\n    for p in sorted((ROOT/'policies').glob('*.yml')):\\n        policy = json.loads(p.read_text())\\n        policies[policy['policy']['id']] = {c['id'] for c in policy['checks']}\\n    if not isinstance(dump, dict) or not dump or not set(dump) <= set(policies):\\n        raise ValueError('未知或空白 policy 匯出')\\n    checks, scans, times, warnings, seen = [], {}, [], [], set()\\n    for pid, data in dump.items():\\n        scans[pid] = data['scan_id']\\n        info = (scan_info or {}).get(pid, data.get('sca_scan_info', {}))\\n        end = info.get('end_scan')\\n        if end is None:\\n            warnings.append(pid+': 缺少 sca_scan_info.end_scan；scanned_at 不推造')\\n        else:\\n            times.append(scan_time(end))\\n        for c in data['checks']:\\n            sid = c['id']\\n            if not isinstance(sid, int) or isinstance(sid, bool) or sid not in policies[pid] or sid in seen:\\n                raise ValueError('未知、重複或錯誤 policy 的 check ID')\\n            if 'result' not in c:\\n                raise ValueError('check 缺少 result')\\n            seen.add(sid)\\n            check = copy.deepcopy(c)\\n            check['policy_id'] = pid\\n            checks.append(check)\\n    return dict(schema_version=1, synthetic=False, label=LABEL,\\n        source_sha256=digest(next(ROOT.glob('*.xlsx'))),\\n        policy_hashes={p.name: digest(p) for p in sorted((ROOT/'policies').glob('*.yml'))},\\n        manager_dump_sha256=digest(path), scan_info=copy.deepcopy(scan_info), warnings=warnings,\\n        hosts=[dict(agent_id='010', approved_profiles=['base','firewalld','sshd'],\\n                    scanned_at=min(times) if len(times)==len(dump) else None,\\n                    policy_scanned_at={pid: scan_time((scan_info or {}).get(pid, dump[pid].get('sca_scan_info', {}))['end_scan'])\\n                                       for pid in dump if (scan_info or {}).get(pid, dump[pid].get('sca_scan_info', {})).get('end_scan') is not None},\\n                    scan_ids=scans, checks=checks)])\\n\\\"\\\"\\\"離線正規化與完整母體報表；不把原生 N/A 當成核准不適用。\\\"\\\"\\\"\\nimport csv\\nimport html\\nimport json\\nfrom collections import Counter\\nfrom pathlib import Path\\nfrom .catalog import registry, ROOT, XLSX_HASH\\nfrom .collector import timestamp\\n\\nSTATES = {'PASS', 'FAIL', 'ERROR', 'NOT_APPLICABLE', 'MANUAL_PENDING', 'NOT_SCANNED', 'EXCLUDED'}\\n\\n\\ndef approval(value, now):\\n    return (isinstance(value, dict) and all(value.get(k) for k in ('approver','reason','ticket','evidence','expires'))\\n            and timestamp(value['expires']) > now)\\n\\n\\ndef normalize(snapshot, now):\\n    \\\"\\\"\\\"只接受明確離線契約；全部 314 項逐主機保留，未核准 profile 不消失。\\\"\\\"\\\"\\n    if snapshot.get('schema_version') != 1 or not isinstance(snapshot.get('hosts'), list):\\n        raise ValueError('不支援的離線快照 schema')\\n    if snapshot.get('source_sha256') != XLSX_HASH:\\n        raise ValueError('來源 hash 不符')\\n    if snapshot.get('policy_hashes') != json.loads((ROOT/'data/policy_hashes.json').read_text()):\\n        raise ValueError('政策 hash 不符')\\n    policy_checks = {}\\n    for path in (ROOT/'policies').glob('*.yml'):\\n        policy_checks.update({c['id']: c for c in json.loads(path.read_text())['checks']})\\n    all_rows, host_ids = [], set()\\n    for host in snapshot['hosts']:\\n        agent = host['agent_id']\\n        if not isinstance(agent, str) or not agent or agent in host_ids:\\n            raise ValueError('主機 ID 空白或重複')\\n        host_ids.add(agent)\\n        profiles = host.get('approved_profiles', [])\\n        if not isinstance(profiles, list) or not set(profiles) <= {'base','firewalld','sshd'}:\\n            raise ValueError('未知 profile')\\n        raw = {}\\n        known = {r['sca_id']:r for r in registry()}\\n        for check in host.get('checks', []):\\n            sid = check['id']\\n            if not isinstance(sid, int) or sid not in known or sid in raw:\\n                raise ValueError('未知或重複 SCA-ID')\\n            if known[sid]['implementation'] != 'candidate':\\n                raise ValueError('回傳未實作控制項；拒絕冒用政策結果')\\n            raw[sid] = check\\n        scanned_at = host.get('scanned_at')\\n        stale = scanned_at is None or (now-timestamp(scanned_at)).total_seconds() > 86400\\n        if scanned_at and timestamp(scanned_at) > now:\\n            raise ValueError('掃描時間在未來')\\n        for control in known.values():\\n            c = raw.get(control['sca_id'], {})\\n            raw_result, reason = c.get('result'), c.get('reason', '')\\n            evidence_status = c.get('evidence_status')\\n            if evidence_status not in (None, 'missing', 'absence_unverified', 'symlink_unresolved', 'tool_error', 'permission_error', 'timeout'):\\n                raise ValueError('未知 evidence_status')\\n            unresolved = control['included'] and control['profile'] not in profiles\\n            na = host.get('not_applicable', {}).get(control['gcb_id'])\\n            exception = host.get('exceptions', {}).get(control['gcb_id'])\\n            approved_na = approval(na, now)\\n            if not control['included']:\\n                state = 'EXCLUDED'\\n            elif c.get('execution_error') or raw_result == 'error' or evidence_status in ('tool_error','permission_error','timeout'):\\n                state = 'ERROR'\\n            elif evidence_status in ('missing','absence_unverified','symlink_unresolved'):\\n                state = 'NOT_APPLICABLE' if approved_na else 'MANUAL_PENDING'\\n            elif raw_result == 'failed':\\n                state = 'FAIL'\\n            elif raw_result not in (None, 'passed', 'not applicable', 'not_applicable'):\\n                state = 'ERROR'\\n            elif approved_na:\\n                state = 'NOT_APPLICABLE'\\n            elif raw_result in ('not applicable', 'not_applicable'):\\n                state = 'ERROR'\\n            elif raw_result == 'passed' and (control['execution_review'] != 'passed' or control['coverage'] != 'full'):\\n                state = 'MANUAL_PENDING'\\n            elif unresolved or control['implementation'] == 'pending' or control['pending']:\\n                state = 'MANUAL_PENDING'\\n            elif raw_result == 'passed':\\n                state = 'PASS'\\n            elif raw_result is not None:\\n                state = 'ERROR'\\n            else:\\n                state = 'NOT_SCANNED'\\n            all_rows.append(dict(agent_id=agent, gcb_id=control['gcb_id'], sca_id=control['sca_id'],\\n                command=c.get('command', ','.join(r.split(' -> r:')[0][2:] for r in policy_checks.get(control['sca_id'], {}).get('rules', []))),\\n                remediation=policy_checks.get(control['sca_id'], {}).get('remediation'),\\n                raw_remediation=c.get('remediation'),\\n                remediation_status='provided' if policy_checks.get(control['sca_id'], {}).get('remediation') else '政策未提供 remediation',\\n                category=control['category'], title=control['title'], expected=control['expected'],\\n                policy_id=control['policy_id'], policy_hash=snapshot['policy_hashes'].get('linuxgcb_'+control['profile']+'.yml'),\\n                source_sha256=control['source_sha256'],\\n                state=state, raw_result=raw_result, raw_reason=reason, evidence_status=evidence_status,\\n                coverage=control['coverage'], execution_review=control['execution_review'],\\n                verified_compliance=state in ('PASS','FAIL') and control['coverage']=='full' and control['execution_review']=='passed',\\n                pending=control['pending'], unresolved=unresolved and not approved_na,\\n                exception_approved=approval(exception, now), exception=exception, na_approval=na,\\n                stale=stale, scanned_at=scanned_at, synthetic=snapshot.get('synthetic', False)))\\n    return all_rows\\n\\n\\ndef metrics(rows):\\n    counts = Counter(r['state'] for r in rows)\\n    applicable = sum(v for k,v in counts.items() if k not in ('EXCLUDED','NOT_APPLICABLE'))\\n    decided = sum(r['verified_compliance'] for r in rows)\\n    verified_pass = sum(r['verified_compliance'] and r['state']=='PASS' for r in rows)\\n    def pct(n,d):\\n        return round(100*n/d, 2) if d else None\\n    return dict(counts=dict(counts), expected=len(rows), applicable=applicable,\\n                unresolved=sum(r['unresolved'] for r in rows),\\n                raw_observed=sum(r['raw_result'] is not None for r in rows), verified_decided=decided,\\n                pass_rate=pct(verified_pass, decided),\\n                attainment=pct(verified_pass, applicable), completeness=pct(decided, applicable))\\n\\n\\ndef safe_cell(value):\\n    text = '' if value is None else str(value)\\n    # Excel 可忽略前導空白/控制字元；CSV 所有文字欄位都經此處理。\\n    probe = text\\n    while probe and (probe[0].isspace() or ord(probe[0]) < 32 or probe[0] == '\\\\ufeff'):\\n        probe = probe[1:]\\n    if probe.startswith(('=', '+', '-', '@')) or (text and ord(text[0]) < 32):\\n        return \\\"'\\\"+text\\n    return text\\n\\n\\ndef render(snapshot, output, now):\\n    rows = normalize(snapshot, now)\\n    summary = metrics(rows)\\n    out = Path(output)\\n    out.mkdir(parents=True, exist_ok=True)\\n    fields = list(rows[0]) if rows else ['agent_id','gcb_id','state']\\n    with (out/'report.csv').open('w', newline='', encoding='utf-8-sig') as f:\\n        writer = csv.writer(f)\\n        writer.writerow(fields)\\n        for r in rows:\\n            writer.writerow([safe_cell(json.dumps(r[k], ensure_ascii=False) if isinstance(r[k], dict) else r[k]) for k in fields])\\n    esc = lambda x: html.escape('' if x is None else str(x), quote=True)\\n    page = '<!doctype html><html lang=\\\"zh-Hant\\\"><meta charset=\\\"utf-8\\\"><title>LinuxGCB 離線報表</title>'\\n    page += '<h1>LinuxGCB 離線候選結果</h1><p>'+('SYNTHETIC／僅供測試，非真實掃描證據' if snapshot.get('synthetic') else '未完成 RHEL9 真機驗收；請核對原始快照與政策版本')+'</p>'\\n    page += '<p>'+esc(snapshot.get('label', ''))+'</p>'\\n    page += '<p>'+esc('; '.join(snapshot.get('warnings', [])))+'</p>'\\n    page += '<p>raw_result 是原始輸出；FAIL 可為候選失敗觀察。完整率只計 verified_compliance，部分／阻擋控制不計完整判定。None 表示 N/A；核准例外不改寫 FAIL。UNVALIDATED 政策結果不代表完整符合性。</p>'\\n    page += '<pre>'+esc(json.dumps(summary, ensure_ascii=False, indent=2))+'</pre><table><thead><tr>'\\n    page += ''.join('<th>'+esc(k)+'</th>' for k in fields)+'</tr></thead><tbody>'\\n    for r in rows:\\n        page += '<tr>'+''.join('<td>'+esc(r[k])+'</td>' for k in fields)+'</tr>'\\n    page += '</tbody></table></html>'\\n    (out/'report.html').write_text(page, encoding='utf-8')\\n    (out/'summary.json').write_text(json.dumps(summary, ensure_ascii=False, indent=2)+'\\\\n')\\n    # 原始值不經公式處理；保留匯入內容以利稽核，勿以試算表開啟此 JSON。\\n    (out/'snapshot.json').write_text(json.dumps(snapshot, ensure_ascii=False, indent=2)+'\\\\n')\\n    return summary\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./codex_exp1.log:13:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_6\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"python3 - <<'PY'\\nimport json\\nfrom linuxgcb.policy import definitions\\nx=json.load(open('data/controls.json'));print(type(x));print(str(x)[:1800])\\nPY\\ncat tests/test_report.py; cat tests/test_snapshot.py\\\"\",\"aggregated_output\":\"<class 'list'>\\n[{'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': '基本項目', 'row': 5, 'ordinal': '1', 'gcb_id': 'TWGCB-01-012-0001', 'category': '磁碟與檔案系統', 'title': 'cramfs檔案系統', 'description': '這項原則設定決定是否支援cramfs檔案系統\\\\ncramfs(compressed ROM file system，壓縮唯讀閃存檔案系統)檔案系統是一開放式之Linux檔案系統，目的是更簡單更有效率\\\\ncramfs檔案系統以zlib壓縮資料，不需載入到記憶體中，因此可節省許多記憶體空間，可直接使用cramfs映像檔案無須先解壓，使用於某些舊系統或對記憶體有限制之地方\\\\n停止支援cramfs檔案系統，以減少系統被攻擊面', 'configuration_method': '開啟終端機，執行vim指令，在/etc/modprobe.d目錄新增或編輯「cramfs.conf」檔案，範例如下：\\\\n#vim /etc/modprobe.d/cramfs.conf\\\\n並在檔案中加入以下內容：\\\\ninstall cramfs /bin/true\\\\nblacklist cramfs\\\\n開啟終端機，執行下列指令，移除cramfs模組：\\\\n#rmmod cramfs\\\\n完成後，請重新開機', 'expected': '停用', 'implementation_status': 'unreviewed'}, {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': '基本項目', 'row': 6, 'ordinal': '2', 'gcb_id': 'TWGCB-01-012-0002', 'category': '磁碟與檔案系統', 'title': 'squashfs檔案系統', 'description': '這項原則設定決定是否支援squashfs檔案系統\\\\nsquashfs是一個即時解壓縮之檔案系統，專門為唯讀壓縮檔案系統之使用而設計，常見於各Linux發行版之LiveCD\\\\n停止支援squashfs檔案系統，以減少系統被攻擊面\\\\n停止支援squashfs檔案系統，將可能導致Snap套件無法正常運作', 'configuration_method': '開啟終端機，執行vim指令，在/etc/modprobe.d目錄，新增或編輯「squashfs.conf」檔案，範例如下：\\\\n#vim /etc/modprobe.d/squashfs.conf\\\\n並在檔案中加入以下內容：\\\\ninstall squashfs /bin/true\\\\nblacklist squashfs\\\\n開啟終端機，執行下列指令，移除squashfs模組：\\\\n#rmmod squashfs\\\\n完成後，請重新開機', 'expected': '停用', 'implementation_status': 'unreviewed'}, {'source_file': 'Red Hat Enterprise Linux 9政府組態基準列表.xlsx', 'sheet': '基本項目', 'row': 7, 'ordinal': '3', 'gcb_id': 'TWGCB-01-012-0003', 'category': '磁碟與檔案系統', 'title': 'udf檔案系統', 'description': '這項原則設定決定是否支援udf檔案系統\\\\nudf(Universal disk format，通用磁碟格式)是根據ISO/IEC 13346與ECMA-167標準所實作之檔案系統，由光學儲存技術協會(OSTA)開發與維護，廣泛應用在如CD-R/RW與DVD-R/RW等可寫光學儲存媒體\\\\n停止支援udf檔案系統，以減少系統被攻擊面\\\\n系統若運行在Microsot Azure上，將可能影響系統正常運作', 'configuration_method': '開啟終端機，執行vim指令，在/etc/modprobe.d目錄，\\nimport copy\\nimport csv\\nimport json\\nimport tempfile\\nimport unittest\\nfrom datetime import datetime,timezone\\nfrom pathlib import Path\\nfrom linuxgcb.catalog import ROOT\\nfrom linuxgcb.report import normalize,metrics,render,safe_cell\\n\\nNOW=datetime(2026,10,30,tzinfo=timezone.utc)\\n\\n\\nclass ReportTests(unittest.TestCase):\\n    def setUp(self):\\n        self.fixture=json.loads((ROOT/'tests/fixtures/snapshot.json').read_text())\\n    def rows(self):return normalize(self.fixture,NOW)\\n    def test_full_inventory_status_and_denominators(self):\\n        rows=self.rows();by={r['sca_id']:r for r in rows};m=metrics(rows)\\n        self.assertEqual(len(rows),314)\\n        self.assertEqual(m['counts']['EXCLUDED'],7)\\n        self.assertEqual(m['applicable'],307)\\n        self.assertEqual(m['counts'].get('PASS',0),0)\\n        self.assertEqual(m['counts']['FAIL'],1)\\n        self.assertEqual(by[900243]['state'],'ERROR')\\n        self.assertEqual(by[900108]['state'],'MANUAL_PENDING')\\n        self.assertEqual(by[900269]['state'],'MANUAL_PENDING')\\n        self.assertEqual(by[900270]['state'],'MANUAL_PENDING')\\n        self.assertTrue(by[900046]['exception_approved'])\\n        self.assertEqual(by[900046]['state'],'FAIL')\\n        self.assertEqual(m['completeness'],0.0)\\n        self.assertEqual(m['pass_rate'],None)\\n    def test_no_scan_and_stale(self):\\n        host=self.fixture['hosts'][0];host['checks']=[];host.pop('scanned_at')\\n        rows=self.rows();self.assertTrue(all(r['stale'] for r in rows))\\n        self.assertEqual(next(r for r in rows if r['sca_id']==900045)['state'],'NOT_SCANNED')\\n        host['checks']=[dict(id=900045,result='passed')]\\n        self.assertEqual(next(r for r in self.rows() if r['sca_id']==900045)['state'],'MANUAL_PENDING')\\n    def test_zero_denominator(self):\\n        m=metrics([])\\n        self.assertIsNone(m['pass_rate']);self.assertIsNone(m['completeness']);self.assertIsNone(m['attainment'])\\n    def test_approved_na_does_not_hide_failure_or_error(self):\\n        h=self.fixture['hosts'][0]\\n        approved=next(iter(h['exceptions'].values()))\\n        h['not_applicable']={f'TWGCB-01-012-{n:04d}':copy.deepcopy(approved) for n in (45,46,243)}\\n        by={r['sca_id']:r for r in self.rows()}\\n        self.assertEqual(by[900045]['state'],'NOT_APPLICABLE')\\n        self.assertEqual(by[900046]['state'],'FAIL')\\n        self.assertEqual(by[900243]['state'],'NOT_APPLICABLE')\\n        h['checks'][3]['execution_error']=True\\n        self.assertEqual(next(r for r in self.rows() if r['sca_id']==900243)['state'],'ERROR')\\n        h['not_applicable']['TWGCB-01-012-0045']['expires']='2020-01-01T00:00:00Z'\\n        self.assertEqual(next(r for r in self.rows() if r['sca_id']==900045)['state'],'MANUAL_PENDING')\\n    def test_unapproved_profiles_conservative(self):\\n        self.fixture['hosts'][0]['approved_profiles']=[]\\n        rows=self.rows();self.assertEqual(metrics(rows)['unresolved'],307)\\n        self.assertEqual(next(r for r in rows if r['sca_id']==900045)['state'],'MANUAL_PENDING')\\n    def test_invalid_snapshots_rejected(self):\\n        mutations=[lambda s:s.update(source_sha256='bad'),lambda s:s.update(policy_hashes={}),\\n            lambda s:s['hosts'].append(copy.deepcopy(s['hosts'][0])),\\n            lambda s:s['hosts'][0]['checks'].append(dict(id=123,result='passed')),\\n            lambda s:s['hosts'][0]['checks'].append(dict(id=900045,result='passed')),\\n            lambda s:s['hosts'][0]['checks'].append(dict(id=900001,result='passed'))]\\n        for mutate in mutations:\\n            s=copy.deepcopy(self.fixture);mutate(s)\\n            with self.assertRaises(ValueError):normalize(s,NOW)\\n    def test_html_csv_raw_integrity(self):\\n        before=copy.deepcopy(self.fixture)\\n        with tempfile.TemporaryDirectory() as d:\\n            render(self.fixture,d,NOW)\\n            page=(Path(d)/'report.html').read_text()\\n            self.assertNotIn('<script>',page)\\n            self.assertIn('&lt;script&gt;',page)\\n            self.assertIn('SYNTHETIC',page)\\n            with (Path(d)/'report.csv').open(encoding='utf-8-sig',newline='') as f:\\n                rows=list(csv.DictReader(f))\\n            self.assertEqual(len(rows),314)\\n            bad=next(r for r in rows if r['sca_id']=='900046')\\n            self.assertTrue(bad['raw_reason'].startswith(\\\"'=\\\"))\\n            self.assertEqual(json.loads((Path(d)/'snapshot.json').read_text()),before)\\n        self.assertEqual(self.fixture,before)\\n    def test_formula_vectors(self):\\n        for text in ('=1',' +1','\\\\t@evil','\\\\r-1','\\\\n=1','\\\\ufeff=1','\\\\v=1','\\\\x00@evil','\\\\u2003=1'):\\n            self.assertTrue(safe_cell(text).startswith(\\\"'\\\"))\\n        self.assertEqual(safe_cell('普通文字'),'普通文字')\\n    def test_multiple_host_weighted_counts(self):\\n        other=copy.deepcopy(self.fixture['hosts'][0]);other['agent_id']='SYNTHETIC-002';other['checks']=[]\\n        self.fixture['hosts'].append(other)\\n        self.assertEqual(metrics(self.rows())['applicable'],614)\\n        self.assertEqual(len(self.rows()),628)\\n\\n    def test_authored_controls_do_not_create_evidence(self):\\n        from linuxgcb.batch1 import ADDED\\n        by={r['sca_id']:r for r in self.rows()}\\n        for n in ADDED:\\n            self.assertIsNone(by[900000+n]['raw_result'])\\n            self.assertEqual(by[900000+n]['state'],'MANUAL_PENDING' if n==141 else 'NOT_SCANNED')\\n        self.fixture['hosts'][0]['checks'].append(dict(id=900141,result='passed'))\\n        self.assertEqual(next(r for r in self.rows() if r['sca_id']==900141)['state'],'MANUAL_PENDING')\\n        self.assertEqual(metrics(self.rows())['completeness'],0.0)\\n\\\"\\\"\\\"REAL EVIDENCE agent010 R2；變異僅為記憶體中 test-only 負面測試。\\\"\\\"\\\"\\nimport copy\\nimport csv\\nimport json\\nimport tempfile\\nimport unittest\\nfrom collections import Counter\\nfrom datetime import datetime, timezone\\nfrom pathlib import Path\\nfrom linuxgcb.catalog import ROOT, digest\\nfrom linuxgcb.snapshot import convert, LABEL\\nfrom linuxgcb.report import normalize, render\\n\\nFIXTURE = ROOT/'tests/fixtures/realhost_r2.json'\\nFAIL_IDS = {900192,900194,900196,900198,900200,900202,900269}\\nNOW = datetime(2026,10,31,6,tzinfo=timezone.utc)\\n\\n\\nclass SnapshotTests(unittest.TestCase):\\n    def test_real_evidence_roundtrip(self):\\n        original = json.loads(FIXTURE.read_text())\\n        s = convert(FIXTURE)\\n        self.assertFalse(s['synthetic'])\\n        self.assertEqual(s['label'], LABEL)\\n        self.assertEqual(s['manager_dump_sha256'], digest(FIXTURE))\\n        host = s['hosts'][0]\\n        self.assertIsNone(host['scanned_at'])\\n        self.assertEqual(len(s['warnings']),3)\\n        self.assertEqual(Counter(c['result'] for c in host['checks']), {'passed':46,'failed':7})\\n        for c in host['checks']:\\n            self.assertEqual({k:v for k,v in c.items() if k!='policy_id'}, next(x for x in original[c['policy_id']]['checks'] if x['id']==c['id']))\\n        with tempfile.TemporaryDirectory() as d:\\n            summary=render(s,d,NOW)\\n            self.assertEqual(summary['counts']['FAIL'],7)\\n            self.assertEqual(summary['verified_decided'],0)\\n            self.assertIsNone(summary['pass_rate'])\\n            self.assertEqual(summary['completeness'],0)\\n            with (Path(d)/'report.csv').open(encoding='utf-8-sig',newline='') as f:\\n                failures=[r for r in csv.DictReader(f) if r['state']=='FAIL']\\n            self.assertEqual({int(r['sca_id']) for r in failures},FAIL_IDS)\\n            page=(Path(d)/'report.html').read_text()\\n            for r in failures:\\n                self.assertIn(r['gcb_id'],page)\\n                self.assertTrue(r['title'])\\n                self.assertTrue(r['command'])\\n                self.assertEqual(r['remediation_status'],'政策未提供 remediation')\\n            self.assertIn(LABEL,page)\\n    def test_scan_info_time_and_invalid_results(self):\\n        dump=json.loads(FIXTURE.read_text())\\n        info={pid:{'end_scan':'2026-10-31T12:03:00+08:00'} for pid in dump}\\n        s=convert(FIXTURE,info)\\n        self.assertEqual(s['hosts'][0]['scanned_at'],'2026-10-31T04:03:00+00:00')\\n        self.assertFalse(s['warnings'])\\n        for result in ('invalid','error','unexpected'):\\n            modified=copy.deepcopy(s)\\n            c=modified['hosts'][0]['checks'][0]\\n            c.update(result=result,reason='test-only raw reason')\\n            row=next(r for r in normalize(modified,NOW) if r['sca_id']==c['id'])\\n            self.assertEqual(row['state'],'ERROR')\\n            self.assertEqual(row['raw_result'],result)\\n            self.assertEqual(row['raw_reason'],
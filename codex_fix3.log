):\\n    return hashlib.sha256(path.read_bytes()).hexdigest()\\n\\n\\ndef registry():\\n    source = next(ROOT.glob('*.xlsx'))\\n    docx = next(ROOT.glob('*.docx'))\\n    if digest(source) != XLSX_HASH or digest(docx) != DOCX_HASH:\\n        raise ValueError('來源 hash 改變，停止產生')\\n    records = extract(source)\\n    result = []\\n    for r in records:\\n        n = int(r['gcb_id'][-4:])\\n        included = r['sheet'] != 'Nftables防火牆'\\n        profile = ('firewalld' if r['sheet'] == 'Firewalld防火牆' else\\n                   'sshd' if r['sheet'] == 'SSH伺服器' else 'base')\\n        if n in IMPLEMENTED:\\n            classification, why = 'native_sca', '候選唯讀原生命令；完整語意與引擎驗收待人工審查'\\n    \\n?? codex_report1.log\\ncodex/linuxgcb-report1\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./codex_report1.log:20:{\"type\":\"item.started\",\"item\":{\"id\":\"item_11\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"cp /home/skycity1010/projects/LinuxGCB/data/realhost_scan_20261031_r2.json tests/fixtures/realhost_r2.json\\ncat > linuxgcb/snapshot.py <<'PY'\\n\\\\\\\"\\\\\\\"\\\\\\\"離線 Manager SQLite 匯出轉換；不推測掃描時間或補造證據。\\\\\\\"\\\\\\\"\\\\\\\"\\nimport copy\\nimport json\\nfrom datetime import datetime, timezone\\nfrom .catalog import ROOT, digest\\nfrom .collector import timestamp\\n\\nLABEL = 'REAL EVIDENCE agent010／真實掃描證據（agent 010 / RHEL9 192.168.1.61）'\\n\\n\\ndef scan_time(value):\\n    if isinstance(value, (int, float)) and not isinstance(value, bool):\\n        return datetime.fromtimestamp(value, timezone.utc).isoformat()\\n    return timestamp(value).isoformat()\\n\\n\\ndef convert(path, scan_info=None):\\n    \\\\\\\"\\\\\\\"\\\\\\\"scan_info: {policy_id: {end_scan: UTC epoch 或含時區 ISO8601}}。\\n\\n    scan_info 必須來自同次離線 DB 匯出，按 policy_id 對應，絕不以 hash join scan_id。\\n    \\\\\\\"\\\\\\\"\\\\\\\"\\n    from pathlib import Path\\n    path = Path(path)\\n    dump = json.loads(path.read_text())\\n    policies = {}\\n    for p in sorted((ROOT/'policies').glob('*.yml'
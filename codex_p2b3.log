{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"cat linuxgcb/expected.py; cat linuxgcb/batch1.py | head -85; rg -n '97|53|44|reviewed|batch2_added' tests\"","aggregated_output":"\"\"\"合規值僅作文字；從來源抽取，絕不執行設定方法。\"\"\"\nimport json\nimport re\nfrom .catalog import ROOT\n\nPREFIX = '合規值: '\nUNKNOWN = '待確認（來源未提供單一基準值）'\n\n\ndef source_expected(row):\n    from .batch2 import expected as batch2_expected\n    specific = batch2_expected(row)\n    if specific is not None:\n        return specific\n    value = (row.get('expected') or '').strip()\n    method = row.get('configuration_method') or ''\n    if value == '安裝':\n        match = re.search(r'#dnf install ([a-zA-Z0-9 -]+)', method)\n        return match.group(1).strip()+' 已安裝' if match else UNKNOWN\n    if value in ('啟用', '停用'):\n        match = re.search(r'#systemctl --now (enable|disable|mask) ([a-zA-Z0-9_.-]+)', method)\n        if not match:\n            return UNKNOWN\n        action, service = match.groups()\n        return service+' '+{'enable': 'enabled+active', 'disable': 'disabled+inactive',\n                              'mask': 'masked+inactive'}[action]\n    if row['gcb_id'].endswith('0108'):\n        return 'net.ipv4.ip_forward=0；net.ipv6.conf.all.forwarding=0'\n    if row['gcb_id'].endswith('0269'):\n        return 'PermitRootLogin '+value if value else UNKNOWN\n    if row['gcb_id'].endswith('0270'):\n        return 'PermitEmptyPasswords '+value if value else UNKNOWN\n    return value or UNKNOWN\n\n\ndef values():\n    return {r['gcb_id']: source_expected(r) for r in json.loads((ROOT/'data/controls.json').read_text())}\n\n\ndef parse_description(description):\n    if not isinstance(description, str) or not description.startswith(PREFIX):\n        return ''\n    return description[len(PREFIX):].split(' ｜ ', 1)[0].strip()\n\n\ndef report_expected(raw, policy):\n    \"\"\"歷史匯出可用本地政策補充，明示其非掃描時證據。\"\"\"\n    value = parse_description(raw.get('description'))\n    if value:\n        return value, 'raw_description'\n    value = parse_description(policy.get('description'))\n    if value:\n        return value, 'policy_description_fallback; raw_prefix_missing'\n    return '', 'prefix_missing'\n\"\"\"有界批次：明列來源路徑，不以標題啟發式生成控制。\"\"\"\n# (路徑, owner 或 mode, 允許值)；mode 是位元子集合，非 umask。\nFILES = {\n 47:('/etc/shadow','owner','root:(root|shadow)'),48:('/etc/shadow','mode',0),\n 49:('/etc/group','owner','root:root'),50:('/etc/group','mode',0o644),\n 51:('/etc/gshadow','owner','root:(root|shadow)'),52:('/etc/gshadow','mode',0),\n 53:('/etc/passwd-','owner','root:root'),54:('/etc/passwd-','mode',0o644),\n 55:('/etc/shadow-','owner','root:(root|shadow)'),56:('/etc/shadow-','mode',0),\n 57:('/etc/group-','owner','root:root'),58:('/etc/group-','mode',0o644),\n 59:('/etc/gshadow-','owner','root:(root|shadow)'),60:('/etc/gshadow-','mode',0),\n 141:('/etc/audit/rules.d/audit.rules','mode',0o600),142:('/etc/audit/auditd.conf','mode',0o640),\n 178:('/var/log/messages','owner','root:root'),179:('/var/log','owner','root:root'),\n 191:('/etc/crontab','owner','root:root'),192:('/etc/crontab','mode',0o600),\n 193:('/etc/cron.hourly','owner','root:root'),194:('/etc/cron.hourly','mode',0o700),\n 195:('/etc/cron.daily','owner','root:root'),196:('/etc/cron.daily','mode',0o700),\n 197:('/etc/cron.weekly','owner','root:root'),198:('/etc/cron.weekly','mode',0o700),\n 199:('/etc/cron.monthly','owner','root:root'),200:('/etc/cron.monthly','mode',0o700),\n 201:('/etc/cron.d','owner','root:root'),202:('/etc/cron.d','mode',0o700),\n 256:('/etc/ssh/sshd_config','owner','root:root'),257:('/etc/ssh/sshd_config','mode',0o600),\n 301:('/etc/shells','owner','root:root'),302:('/etc/shells','mode',0o644),\n}\nPACKAGES = {33:['sudo'],132:['audit','audit-libs'],174:['rsyslog'],183:['libselinux'],242:['firewalld']}\n# 0036 AIDE 初始化另有要求，0231 架構需審查，本批不以套件存在充當完整實作。\nSERVICES = {30:('autofs','disabled'),94:('rsyncd','masked'),97:('squid','masked'),\n            98:('smb','masked'),101:('kdump','disabled'),133:('auditd','enabled'),\n            175:('rsyslog','enabled')}\nADDED = set(FILES) | set(PACKAGES) | set(SERVICES)\n\ndef mode_pattern(mask):\n    return '^('+'|'.join(format(n,'o') for n in range(0o10000) if n & ~mask == 0)+')$'\n\n# FIX-1: positive predicates only; no stderr/exit-code or negative-match inference.\nDISABLED_SERVICES = {30: ('autofs',), 94: ('rsyncd',), 97: ('squid',),\n                     98: ('smb', 'nmb'), 101: ('kdump',), 245: ('nftables',)}\n\ndef disabled_service_rules(unit):\n    command = 'c:/usr/bin/systemctl show '+unit+'.service'\n    return [(command+' --property=LoadState', '^LoadState=(loaded|masked|not-found)$'),\n            (command+' --property=ActiveState', '^ActiveState=inactive$'),\n            # Same output contains either explicit absence or a safe unit-file state.\n            # Empty UnitFileState on absent units is never itself a PASS marker.\n            (command+' --property=LoadState --property=UnitFileState',\n             '^(LoadState=not-found|UnitFileState=(disabled|masked))$')]\n\ndef rules():\n    result = {}\n    for n,(path,kind,value) in FILES.items():\n        result[n] = [('c:/usr/bin/stat -c '+('%U:%G' if kind=='owner' else '%a')+' '+path,\n                      '^'+value+'$' if kind=='owner' else mode_pattern(value)),\n]\n        # 來源明列目錄才限制型態；檔案來源未明定必須 regular，交由來源審查。\n        if n in (179,193,194,195,196,197,198,199,200,201,202):\n            result[n].append(('c:/usr/bin/stat -c %f '+path, '^4[0-9a-f]{3}$'))\n    for n,packages in PACKAGES.items():\n        # RPM 的成功輸出必須含正向標記；不依賴退出碼或空輸出。\n        result[n] = [('c:/usr/bin/rpm -q --queryformat %{NAME}:installed '+p,'^'+p+':installed$') for p in packages]\n    for n,(unit,state) in SERVICES.items():\n        if n in DISABLED_SERVICES:\n            result[n] = [rule for service in DISABLED_SERVICES[n] for rule in disabled_service_rules(service)]\n            continue\n        props = [('LoadState','loaded' if state!='masked' else 'masked'),\n                 ('ActiveState','active' if state=='enabled' else 'inactive'),('UnitFileState',state)]\n        result[n] = [('c:/usr/bin/systemctl show '+unit+'.service --property='+k,'^'+k+'='+v+'$') for k,v in props]\n    return result\n\ndef caveat(n):\n    common='命令啟動／stderr／權限錯誤與非零但匹配輸出之行為待真機驗證；不依賴退出碼。'\n    if n in FILES:\n        path,kind,_=FILES[n]\n        text='固定路徑 lstat；來源明列目錄才用 %f 數值型態，檔案不額外限制 regular。連結是否應解參照、NSS 與 ACL 語意未核准；不可據此宣稱完整符合。'\n        if path.endswith('-'): text+='備份檔缺失不自動視為不適用，需核准適用性。'\n        if n==141: text+='僅來源明列 audit.rules，其他 rules.d 檔案覆蓋待審。'\n        if n in (256,257): text+='僅 sshd_config metadata，不代表 Include 或 SSH 內容符合。'\n        return text+common\n    if n in PACKAGES: return '僅 RPM 資料庫套件存在；不代表服務或內容規則通過。RPM 資料庫錯誤不得以未安裝推論。'+common\n    if n in DISABLED_SERVICES:\n        detail = 'Samba 同查 smb/nmb。' if n == 98 else ''\n        if n == 101:\n            detail += '0101 依 FIX-1 任務改為停用意圖，來源啟用差異待核准。'\n        return 'FIX-1：明確 not-found 或 disabled/masked 且 inactive；'+detail+'多次查詢非原子、socket/alias 未覆蓋；UNVALIDATED。'+common\n    return '分開確認開機狀態與即時狀態；不接受 not-found、static、alias、enabled-runtime；不存在不自動通過；多次查詢非原子。'+common\ntests/test_fix2.py:21:    def test_all_44_old_commands_fail_and_new_preserve_semantics(self):\ntests/test_batch2.py:36:        self.assertEqual(len(ADDED),44)\ntests/test_batch2.py:37:        self.assertEqual(len(self.checks),97)\ntests/test_batch2.py:139:        for n,mask in ((204,0o600),(260,0o640),(262,0o644)):\ntests/test_batch2.py:147:        row=next(r for r in manifest['reviewed'] if r['sca_id']==900272)\ntests/test_quality_q1.py:43:            directory=n in (179,193,194,195,196,197,198,199,200,201,202)\ntests/test_quality_q1.py:77:        self.assertEqual(len(rows),53)\ntests/test_quality_q1.py:93:        for n in (53,54,55,56,57,58,59,60,30,94,97,98,245):\ntests/fixtures/realhost_r2.json:106:    \"id\": 900053,\ntests/fixtures/realhost_r2.json:107:    \"title\": \"TWGCB-01-012-0053 /etc/passwd-
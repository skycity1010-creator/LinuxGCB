{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc 'cat linuxgcb/batch2.py linuxgcb/coverage.py'","aggregated_output":"\"\"\"BATCH2 fixed, source-reviewed read-only candidates. Never execute at build time.\n\nOnly new commands use a stdout commit guard: buffer output, publish it and an\nexplicit success marker only after exit 0. This is new: Q1 had no such guard.\nWazuh argv/quoting and RHEL9 runtime remain UNVALIDATED.\n\"\"\"\nimport shlex\nfrom .batch1 import mode_pattern\nfrom .argv import quote_argument\n\nCATEGORIES = {'SSH設定', 'cron設定', 'SELinux', '安裝與維護軟體'}\nADDED = set(range(102,108)) | set(range(184,190)) | {190,203,204,205,254,255,258,259,260,261,262,263,264,265,266,267,268,271,272,273,274,275,276,277,278,279,280,281,282,283,284,315}\nMARKER = 'LINUXGCB_COMMAND_OK'\nABSENT_PACKAGES = {102:'ypbind',103:'telnet',104:'telnet-server',105:'rsh-server',106:'tftp-server',189:'mcstrans'}\n\n\ndef guarded(command):\n    if command in ('rpm -q '+p+' 2>/dev/null' for p in ABSENT_PACKAGES.values()):\n        script = ('out=$('+command+'); rc=$?; case $rc in '\n                  '0) echo INSTALLED;; 1) echo ABSENT;; *) exit $rc;; esac')\n        return 'c:/bin/sh -c '+quote_argument(script)\n    script = ('out=$('+command+'); rc=$?; if [ \"$rc\" -eq 0 ]; then '\n              \"printf '%s\\\\n' \\\"$out\\\" '\"+MARKER+\"'; else exit $rc; fi\")\n    return 'c:/bin/sh -c '+quote_argument(script)\n\n\n# command, predicate, compliant stdout, noncompliant stdout. These are authored\n# semantic examples, independent of the fixture generator / regex matcher.\ndef specs():\n    result = {}\n    for n,package in {188:'setroubleshoot'}.items():\n        result[n] = [('/usr/bin/rpm -qa --queryformat '+shlex.quote('%{NAME}\\\\n'),\n                      '!^'+package+'$', 'bash\\ncoreutils', package)]\n    for n,package in ABSENT_PACKAGES.items():\n        result[n] = [('rpm -q '+package+' 2>/dev/null', '^ABSENT$', 'ABSENT', 'INSTALLED')]\n    result[107] = [('/usr/bin/cat '+p, '^[ \\\\t]*clean_requirements_on_remove[ \\\\t]*=[ \\\\t]*[Tt]rue[ \\\\t]*$',\n                    '[main]\\nclean_requirements_on_remove=True', '[main]\\nclean_requirements_on_remove=False')\n                   for p in ('/etc/yum.conf','/etc/dnf/dnf.conf')]\n    result[184] = [('/usr/bin/cat /etc/default/grub',\n                    '!^[ \\\\t]*GRUB_CMDLINE_LINUX[^=]*=.*(selinux=0|enforcing=0)',\n                    'GRUB_CMDLINE_LINUX=\"quiet\"', 'GRUB_CMDLINE_LINUX=\"selinux=0\"')]\n    result[185] = [('/usr/bin/cat /etc/selinux/config', '^[ \\\\t]*SELINUXTYPE=(targeted|mls)[ \\\\t]*$',\n                    'SELINUXTYPE=targeted', 'SELINUXTYPE=minimum')]\n    result[186] = [('/usr/bin/cat /etc/selinux/config', '^[ \\\\t]*SELINUX=enforcing[ \\\\t]*$',\n                    'SELINUX=enforcing', 'SELINUX=permissive'),\n                   ('/usr/sbin/getenforce', '^Enforcing$', 'Enforcing', 'Permissive')]\n    result[187] = [('/usr/bin/ps -eZf', '!unconfined_service_t',\n                    'system_u:system_r:init_t:s0 root 1', 'system_u:system_r:unconfined_service_t:s0 root 2')]\n    for n,unit in ((190,'crond'),(254,'sshd')):\n        result[n] = [('/usr/bin/systemctl show '+unit+'.service --property='+prop,\n                      '^'+prop+'='+state+'$', prop+'='+state, prop+'=wrong')\n                     for prop,state in (('LoadState','loaded'),('ActiveState','active'),('UnitFileState','enabled'))]\n    # Source 0254 also explicitly installs openssh-server.\n    result[254].append(('/usr/bin/rpm -q --queryformat '+shlex.quote('%{NAME}:installed')+' openssh-server',\n                        '^openssh-server:installed$', 'openssh-server:installed', 'package openssh-server is not installed'))\n    for n,fmt,pattern,good,bad in ((203,'%U:%G','^root:root$','root:root','nobody:root'),\n                                  (204,'%a',mode_pattern(0o600),'600','666')):\n        result[n] = [('/usr/bin/stat -c '+fmt+' '+p,pattern,good,bad)\n                     for p in ('/etc/at.allow','/etc/cron.allow')]\n        result[n].append(('/usr/bin/find /etc -maxdepth 1 -name '+shlex.quote('*.deny'),\n                          '!^/etc/(at|cron)[.]deny$', '', '/etc/cron.deny'))\n    # Read every source configuration successfully; empty optional .conf set is\n    # allowed, but an unreadable directory or any cat/find failure is not.\n    result[205] = [('/usr/bin/cat /etc/rsyslog.conf && /usr/bin/find /etc/rsyslog.d -maxdepth 1 -type f -name '+shlex.quote('*.conf')+' -exec /usr/bin/cat {} +',\n                    r'^[ \\t]*cron[.][*][ \\t]+(/var/log/cron|action\\(type=\"omfile\"[ \\t]+file=\"/var/log/cron\"\\))[ \\t]*$', 'cron.* /var/log/cron', 'cron.none /var/log/cron')]\n    ssh = '/usr/sbin/sshd -T'\n    settings = {\n        255:('!^protocol (?!2$).+', 'port 22', 'protocol 1'),\n        258:('^(allowusers|allowgroups|denyusers|denygroups) .+', 'allowusers approved_user', 'port 22'),\n        263:('^ciphers aes128-ctr,aes192-ctr,aes256-ctr$', 'ciphers aes128-ctr,aes192-ctr,aes256-ctr', 'ciphers aes128-cbc'),\n        264:('^loglevel (VERBOSE|INFO)$','loglevel VERBOSE','loglevel DEBUG'),\n        265:('^x11forwarding no$','x11forwarding no','x11forwarding yes'),\n        266:('^maxauthtries [1-4]$','maxauthtries 4','maxauthtries 0'),\n        267:('^ignorerhosts yes$','ignorerhosts yes','ignorerhosts no'),\n        268:('^hostbasedauthentication no$','hostbasedauthentication no','hostbasedauthentication yes'),\n        271:('^permituserenvironment no$','permituserenvironment no','permituserenvironment yes'),\n        272:('^clientaliveinterval ([1-9]|[1-9][0-9]|[1-5][0-9]{2}|600)$','clientaliveinterval 600','clientaliveinterval 0'),\n        273:('^logingracetime ([1-9]|[1-5][0-9]|60)$','logingracetime 60','logingracetime 0'),\n        274:('^usepam yes$','usepam yes','usepam no'),\n        275:('^allowtcpforwarding no$','allowtcpforwarding no','allowtcpforwarding yes'),\n        276:('^maxstartups 10:30:60$','maxstartups 10:30:60','maxstartups 10:30:100'),\n        277:('^maxsessions [1-4]$','maxsessions 4','maxsessions 0'),\n        278:('^strictmodes yes$','strictmodes yes','strictmodes no'),\n        279:('^compression (delayed|no|yes)$','compression no','compression invalid'),\n        280:('^ignoreuserknownhosts yes$','ignoreuserknownhosts yes','ignoreuserknownhosts no'),\n        281:('^printlastlog yes$','printlastlog yes','printlastlog no'),\n        315:('^gssapiauthentication no$','gssapiauthentication no','gssapiauthentication yes'),\n    }\n    for n,(pattern,good,bad) in settings.items():\n        result[n] = [(ssh,pattern,good,bad)]\n    result[272].append((ssh,'^clientalivecountmax 1$','clientalivecountmax 1','clientalivecountmax 0'))\n    result[263] += [(ssh,'^macs hmac-sha2-512,hmac-sha2-256$', 'macs hmac-sha2-512,hmac-sha2-256','macs hmac-md5'),\n                    (ssh,'^kexalgorithms ecdh-sha2-nistp256,ecdh-sha2-nistp384,ecdh-sha2-nistp521,diffie-hellman-group-exchange-sha256,diffie-hellman-group14-sha256,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512$',\n                     'kexalgorithms ecdh-sha2-nistp256,ecdh-sha2-nistp384,ecdh-sha2-nistp521,diffie-hellman-group-exchange-sha256,diffie-hellman-group14-sha256,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512','kexalgorithms diffie-hellman-group1-sha1')]\n    for n,glob,fmt,pattern,good,bad in (\n        (259,'ssh_host_*_key','%U:%G','root:ssh_keys','root:ssh_keys','root:root'),\n        (260,'ssh_host_*_key','%a',mode_pattern(0o640)[1:-1],'640','666'),\n        (261,'ssh_host_*_key.pub','%U:%G','root:root','root:root','nobody:root'),\n        (262,'ssh_host_*_key.pub','%a',mode_pattern(0o644)[1:-1],'644','666')):\n        cmd='/usr/bin/find /etc/ssh -xdev -type f -name '+shlex.quote(glob)+' -exec /usr/bin/stat -c '+fmt+' {} +'\n        # Existence plus absence of any bad member: never just \"some key good\".\n        result[n]=[(cmd,'^'+pattern+'$',good,bad),\n                   (cmd,'!^(?!'+pattern+'$|'+MARKER+'$).+',good,bad)]\n    for n,name in ((282,'shosts.equiv'),(283,'*.shosts')):\n        result[n]=[('/usr/bin/find / -name '+shlex.quote(name), '!^/', '', '/home/example/'+name.replace('*',''))]\n    result[284]=[('/usr/bin/cat /etc/sysconfig/sshd','!^[ \\\\t]*CRYPTO_POLICY[ \\\\t]*=',\n                  '# CRYPTO_POLICY=', 'CRYPTO_POLICY=')]\n    assert set(result)==ADDED\n    return result\n\n\ndef rules():\n    result={}\n    for n,items in specs().items():\n        predicates=[(guarded(cmd),pattern) for cmd,pattern,_,_ in items]\n        # Tri-state absence is self-contained; other predicates require the success marker.\n        result[n]=list(dict.fromkeys(predicates+([] if n in ABSENT_PACKAGES else [(guarded(cmd),'^'+MARKER+'$') for cmd,_,_,_ in items])))\n    return result\n\n\ndef caveat(n):\n    common='BATCH2 輸出先緩衝，exit 0 才發布成功標記；shell argv/quoting、stderr、timeout 與 RHEL9 引擎待真機驗證；UNVALIDATED。'\n    if n >= 254:\n        common+='sshd -T 僅預設情境；Include/Match 與使用者/來源矩陣沿用 Q1 限制；服務啟動參數與 crypto-policy 注入尚待核對。'\n    if n==255:\n        common+='RHEL9 OpenSSH 8.0+ 僅支援 SSH2；sshd -T 不輸出 Protocol 時接受預設，輸出 protocol 1 則拒絕。'\n    if n==279:\n        common+='RHEL9 OpenSSH 8.0+ 的 compression yes 僅認證後壓縮（等同歷史 delayed）；no 亦符合。'\n    if n==258:\n        common+='來源清單依組織授權，沒有單一基準值；只檢查至少一個有效限制清單，授權正確性待人工審查。'\n    if n in (259,260,261,262):\n        common+='僅來源 find -xdev -type f 集合；至少一把鑰匙且全部 metadata 符合；ACL、連結與有效 HostKey 路徑待審。'\n    if n==260:\n        common+='來源文字提 600 但設定命令與 expected 為 640，依 F/G 欄實作 640 位元子集合，差異待核准。'\n    if n==184: common+='僅 /etc/default/grub 設定；實際開機項與已產生 grub.cfg 尚待驗證。'\n    if n in (107,185,186,205,284): common+='僅來源指定文字設定；重複指令、載入順序與執行中狀態待審。'\n    if n in (282,283): common+='全檔案系統唯讀 find 可能昂貴；權限錯誤不通過，掛載集合與 timeout 待審。'\n    return common\n\n\ndef expected(row):\n    \"\"\"Concrete values from F cells; no site-specific users or invented defaults.\"\"\"\n    suffix=row.get('gcb_id','')[-4:]\n    if not suffix.isdigit(): return None\n    n=int(suffix)\n    if n not in ADDED: return None\n    method=row.get('configuration_method','')\n    if not method: return '待確認（來源未提供單一基準值）'\n    if n==258: return '待確認（來源未提供單一基準值）'\n    if n in (102,103,104,105,106,188,189):\n        return method.split('#dnf remove ',1)[1].splitlines()[0]+' 未安裝'\n    if n==263:\n        return 'Ciphers aes128-ctr,aes192-ctr,aes256-ctr；MACS=hmac-sha2-512,hmac-sha2-256；KexAlgorithms='+method.split('-oKexAlgorithms=',1)[1].splitlines()[0]\n    return {\n        107:'clean_requirements_on_remove=True（/etc/yum.conf 與 /etc/dnf/dnf.conf）',\n        184:'所有 GRUB_CMDLINE_LINUX* 不含 selinux=0 或 enforcing=0',\n        185:'SELINUXTYPE=targeted（或來源允許之更嚴格 mls）',\n        186:'SELINUX=enforcing；即時 enforcing',187:'無 unconfined_service_t 程序',\n        190:'crond enabled+active',203:'root:root；/etc/at.deny 與 /etc/cron.deny 不存在',\n        204:'600 或更低權限；/etc/at.deny 與 /etc/cron.deny 不存在',\n        205:'cron.* /var/log/cron',254:'openssh-server 已安裝；sshd enabled+active',\n        255:'Protocol 2',259:'root:ssh_keys',260:'640 或更低權限',261:'root:root',262:'644 或更低權限',\n        264:'LogLevel VERBOSE 或 INFO',265:'X11Forwarding no',266:'MaxAuthTries 4（來源允許 1–4）',\n        267:'IgnoreRhosts yes',268:'HostbasedAuthentication no',271:'PermitUserEnvironment no',\n        272:'ClientAliveInterval 600（來源允許 1–600）；ClientAliveCountMax 1',\n        273:'LoginGraceTime 60（來源允許 1–60）',274:'UsePAM yes',275:'AllowTcpForwarding no',\n        276:'MaxStartups 10:30:60',277:'MaxSessions 4（來源允許 1–4）',278:'StrictModes yes',\n        279:'Compression delayed 或 no',280:'IgnoreUserKnownHosts yes',281:'PrintLastLog yes',\n        282:'移除所有 shosts.equiv',283:'移除所有 *.shosts',284:'不存在未註解的 CRYPTO_POLICY 設定',\n        315:'GSSAPIAuthentication no',\n    }[n]\n\"\"\"可重建的逐項來源對照與涵蓋 manifest；不執行候選命令。\"\"\"\nimport json\nfrom collections import Counter\nfrom zipfile import ZipFile\nfrom xml.etree import ElementTree as ET\nfrom .catalog import ROOT, registry, digest\nfrom .batch1 import ADDED, caveat\nfrom .quality import status\nfrom .batch2 import ADDED as BATCH2, caveat as batch2_caveat\n\ndef manifest():\n    ns={'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}\n    docx=next(ROOT.glob('*.docx'))\n    xml=ET.fromstring(ZipFile(docx).read('word/document.xml'))\n    # ID 的 runs 必須在段落內接回，cell 再以換行串接段落。\n    tables=[]\n    for tr in xml.findall('.//w:tr',ns):\n        cells=['\\n'.join(''.join(t.text or '' for t in p.findall('.//w:t',ns))\n                         for p in cell.findall('.//w:p',ns)) for cell in tr.findall('w:tc',ns)]\n        tables.append(cells)\n    entries=[]\n    for row in registry():\n        n=row['sca_id']-900000\n        if row['implementation'] != 'candidate': continue\n        matches=[c for c in tables if row['gcb_id'] in c]\n        historical=[]\n        if n in BATCH2:\n            historical=[c for c in matches if c[-1] != row['expected']]\n            matches=[c for c in matches if c[-1] == row['expected']]\n        if not matches or any(c[-2:] != matches[0][-2:] for c in matches) or row['expected'] not in matches[0]:\n            raise ValueError('DOCX ID／期望欄無法唯一核對：'+row['gcb_id'])\n        entries.append(dict(gcb_id=row['gcb_id'],sca_id=row['sca_id'],\n            source_sheet=row['source_sheet'],source_row=row['source_row'],expected=row['expected'],\n            docx_historical_cells=historical,docx_cells=matches[0],docx_occurrences=len(matches),docx_all_cells=matches,docx_sha256=digest(docx),\n            mechanism=('BATCH2 c: shell 成功輸出保護、正向/否定逐行 PCRE2、all 聚合' if n in BATCH2 else '原生 c: 絕對路徑、正向逐行 PCRE2、all 聚合；無 shell'),\n            caveats=batch2_caveat(n) if n in BATCH2 else caveat(n) if n in ADDED else row['pending'],tests=['tests/fixtures/rule_outputs.json#'+str(row['sca_id']), 'tests/test_batch2.py' if n in BATCH2 else 'tests/test_quality_q1.py'],\n            cases=['positive','negative','missing','empty','error','nonzero_matching'],\n            review_status='human_review_pending',**status(n)))\n    rows=registry();counts=Counter(r['implementation'] for r in rows)\n    return dict(schema_version=2,label='離線候選涵蓋；非實機證據',\n        counts=dict(source=len(rows),included=sum(r['included'] for r in rows),excluded=counts['excluded'],\n                    before=7,added=len(ADDED)+len(BATCH2),batch2_added=len(BATCH2),implemented=counts['candidate'],remaining=counts['pending'],\n                    full=sum(r['coverage']=='full' for r in rows),partial=sum(r['coverage']=='partial' for r in rows),\n                    blocked=sum(r['coverage']=='blocked' for r in rows),reviewed=len(entries),execution_blocked=len(entries),live_validated=0),\n        reviewed=entries)\n\ndef write():\n    m=manifest()\n    (ROOT/'data/coverage_manifest.json').write_text(json.dumps(m,ensure_ascii=False,indent=2)+'\\n')\n    return m\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc 'cat linuxgcb/policy.py linuxgcb/catalog.py linuxgcb/quality.py; cat scripts/batch2_fixtures.py tests/test_batch2.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc 'cat linuxgcb/policy.py linuxgcb/catalog.py linuxgcb/quality.py; cat scripts/batch2_fixtures.py tests/test_batch2.py'","aggregated_output":"\"\"\"以 JSON（YAML 1.2 子集）產生候選 SCA；只模擬輸出匹配，不執行命令。\"\"\"\nimport json\nimport re\nfrom functools import lru_cache\nfrom .catalog import ROOT, registry, digest\nfrom .batch1 import rules as batch_rules, disabled_service_rules\nfrom .expected import PREFIX, values, parse_description\nfrom .batch2 import rules as batch2_rules, ADDED as BATCH2\nfrom .argv import w_strtok\n\n\ndef definitions():\n    modes = '|'.join(format(n, 'o') for n in range(0o1000) if n & ~0o644 == 0)\n    return {**batch_rules(), **batch2_rules(),\n        45: [('c:/usr/bin/stat -c %u:%g /etc/passwd', '^0:0$')],\n        46: [('c:/usr/bin/stat -c %a /etc/passwd', '^('+modes+')$')],\n        108: [('c:/usr/sbin/sysctl -n net.ipv4.ip_forward', '^0$'),\n              ('c:/usr/sbin/sysctl -n net.ipv6.conf.all.forwarding', '^0$')],\n        243: [('c:/usr/bin/systemctl show firewalld.service --property=LoadState', '^LoadState=loaded$'),\n              ('c:/usr/bin/systemctl show firewalld.service --property=ActiveState', '^ActiveState=active$'),\n              ('c:/usr/bin/systemctl show firewalld.service --property=UnitFileState', '^UnitFileState=enabled$')],\n        245: disabled_service_rules('nftables'),\n        269: [('c:/usr/sbin/sshd -T', '^permitrootlogin no$')],\n        270: [('c:/usr/sbin/sshd -T', '^permitemptypasswords no$')],\n    }\n\n\ndef build():\n    rows = registry()\n    expected = values()\n    for profile in ('base', 'firewalld', 'sshd'):\n        filename = 'linuxgcb_'+profile+'.yml'\n        checks = []\n        for row in rows:\n            if row['implementation'] != 'candidate' or row['profile'] != profile:\n                continue\n            checks.append(dict(id=row['sca_id'], title=row['gcb_id']+' '+row['title'],\n                description=PREFIX+expected[row['gcb_id']]+(' ｜ BATCH2 執行審查 ' if row['sca_id']-900000 in BATCH2 else ' ｜ Q1 執行審查 ')+row['execution_review']+'；coverage='+row['coverage']+'；'+','.join(row['issue_ids'])+'；raw PASS 非已驗證符合。'+row['pending'],\n                compliance=[{'twgcb': [row['gcb_id']]}], regex_type='pcre2', condition='all',\n                rules=[emit_rule(target, pattern) for target, pattern in definitions()[int(row['gcb_id'][-4:])]]))\n        policy = dict(policy=dict(id='linuxgcb_rhel9_'+profile+'_v01', file=filename,\n                      name='RHEL9 GCB v1.2 '+profile+' v0.1 UNVALIDATED',\n                      description='未驗證候選政策；僅供核准 RHEL9 試點，非完整符合性檢核', regex_type='pcre2'),\n                      requirements=dict(title='僅 RHEL 9', description='角色由核准群組控制',\n                        condition='all', rules=['f:/etc/os-release -> r:^ID=\"?rhel\"?$',\n                                               'f:/etc/os-release -> r:^VERSION_ID=\"?9([.][0-9]+)*\"?$']),\n                      checks=checks)\n        (ROOT/'policies'/filename).write_text(json.dumps(policy, ensure_ascii=False, indent=2)+'\\n')\n    hashes = {p.name: digest(p) for p in sorted((ROOT/'policies').glob('*.yml'))}\n    (ROOT/'data/policy_hashes.json').write_text(json.dumps(hashes, indent=2)+'\\n')\n    from .coverage import write\n    write()\n    validate()\n\n\ndef require(condition):\n    if not condition:\n        raise ValueError('候選政策結構、mapping 或 hash 不符')\n\n\ndef validate():\n    rows = {r['sca_id']: r for r in registry()}\n    seen = set()\n    for path in sorted((ROOT/'policies').glob('*.yml')):\n        p = json.loads(path.read_text())\n        require(p['policy']['file'] == path.name and p['policy']['regex_type']=='pcre2')\n        require(p['requirements'] == dict(title='僅 RHEL 9', description='角色由核准群組控制',\n            condition='all', rules=['f:/etc/os-release -> r:^ID=\"?rhel\"?$',\n                                   'f:/etc/os-release -> r:^VERSION_ID=\"?9([.][0-9]+)*\"?$']))\n        for c in p['checks']:\n            require(c['id'] not in seen and rows[c['id']]['included'])\n            seen.add(c['id'])\n            require(parse_description(c.get('description')) == values()[rows[c['id']]['gcb_id']])\n            require((' ｜ BATCH2 ' if c['id']-900000 in BATCH2 else ' ｜ Q1 ') in c['description'])\n            require(c['regex_type'] == 'pcre2' and c['condition'] == 'all')\n            require(c['compliance'] == [{'twgcb': [rows[c['id']]['gcb_id']]}])\n            require(rows[c['id']]['policy_id'] == p['policy']['id'])\n            require(c['rules'] == [emit_rule(a,b) for a,b in definitions()[c['id']-900000]])\n            for rule in c['rules']:\n                target, _ = rule.split(' -> ', 1)\n                require(target.removeprefix('not ').startswith('c:/'))\n                if c['id']-900000 not in BATCH2:\n                    require(not any(x in target for x in ('|',';', '&&', '$', '`')))\n                parse_rule(rule)\n    require(seen == {900000+n for n in definitions()})\n    hashes = json.loads((ROOT/'data/policy_hashes.json').read_text())\n    require(hashes == {p.name:digest(p) for p in (ROOT/'policies').glob('*.yml')})\n    from .coverage import manifest\n    require(json.loads((ROOT/'data/coverage_manifest.json').read_text()) == manifest())\n    require(seen == {r['sca_id'] for r in rows.values() if r['implementation']=='candidate'})\n    return len(seen)\n\n\n@lru_cache(maxsize=1)\ndef supported_patterns():\n    return frozenset(p.lstrip('!') for rules in definitions().values() for _,p in rules) | {\n        '^ID=\"?rhel\"?$', '^VERSION_ID=\"?9([.][0-9]+)*\"?$'}\n\n\ndef emit_rule(target, pattern):\n    return ('not '+target+' -> r:'+pattern[1:]) if pattern.startswith('!') else target+' -> r:'+pattern\n\n\n@lru_cache(maxsize=1)\ndef batch2_emitted():\n    return {emit_rule(t,p) for rules in batch2_rules().values() for t,p in rules}\n\n\ndef parse_rule(rule):\n    \"\"\"Legacy bounded grammar plus exact allowlist of BATCH2 emitted rules.\"\"\"\n    if not isinstance(rule, str):\n        raise ValueError('不支援的規則語法')\n    if rule in batch2_emitted():\n        target, expression = rule.split(' -> ', 1)\n        argv = w_strtok(target.removeprefix('not ')[2:])\n        if len(argv) != 3 or argv[:2] != ['/bin/sh', '-c']:\n            raise ValueError('Invalid wm_exec shell argv')\n        return target.removeprefix('not '), re.compile(expression.split(':',1)[1], re.ASCII)\n    if rule.count(' -> r:') != 1:\n        raise ValueError('不支援的規則語法')\n    target, pattern = rule.split(' -> r:')\n    if not re.fullmatch(r'[cf]:/[^\\n\\r]+', target) or any(x in target for x in (' -> ', ' && ', '|', ';', '`', '$')):\n        raise ValueError('不支援的目標')\n    if pattern not in supported_patterns() and not re.fullmatch(r'\\^[A-Za-z0-9_ =:/-]+\\$', pattern):\n        raise ValueError('未驗證的 PCRE2 語法')\n    try:\n        return target, re.compile(pattern, re.ASCII)\n    except re.error as exc:\n        raise ValueError('無效模式') from exc\n\n\ndef simulate(check, observations):\n    \"\"\"僅輸出匹配模型；執行失敗資訊不足回 UNRESOLVED，不冒充 Wazuh。\n\n    FIX-3 模擬 OS_StrBreak 的前 256 行上限（wm_sca.c:1749）。\n    FIX-1 同一 command 的多行輸出仍按逐行存在匹配；alternation 是單一\n    正向 regex，規則間維持 all，不以空輸出或 stderr 推論 not-found。\n    所有項目 exit_code 不參與輸出匹配（wm_exec 正常結束仍回 0），\n    並以 emitted shell guard 確保失敗不發布輸出或成功標記。\n    明確 engine_result 可表示真機／fixture\n    的 Not applicable；error 只表示未取得可靠輸出，不能預測引擎結果。\n    \"\"\"\n    if check.get('regex_type', 'pcre2') != 'pcre2':\n        raise ValueError('只支援明確 PCRE2 候選子集')\n    if check.get('condition') != 'all':\n        raise ValueError('輸出模型只支援目前發出的 all 子集')\n    if not isinstance(check.get('rules'), list) or not check['rules']:\n        raise ValueError('規則不得為空')\n    parsed = [parse_rule(rule) for rule in check['rules']]\n    outcomes = []\n    for rule, (target, pattern) in zip(check['rules'], parsed):\n        obs = observations.get(target)\n        if target.startswith('f:') and obs is not None and obs.get('exists') is False:\n            outcomes.append('NOT_APPLICABLE')\n            continue\n        if obs is None or obs.get('error'):\n            outcomes.append('UNRESOLVED')\n        elif obs.get('engine_result') == 'NOT_APPLICABLE':\n            outcomes.append('NOT_APPLICABLE')\n        elif not isinstance(obs.get('stdout'), str):\n            raise ValueError('觀察必須提供字串 stdout')\n        else:\n            matched = any(pattern.search(line) for line in obs['stdout'].split('\\n')[:256])\n            if rule.startswith('not '):\n                matched = not matched\n            outcomes.append('PASS' if matched else 'FAIL')\n    # 官方 all：任何 FAIL 優先；未知執行不擅自轉成 N/A。\n    if 'FAIL' in outcomes:\n        return 'FAIL'\n    if 'UNRESOLVED' in outcomes:\n        return 'UNRESOLVED'\n    return 'NOT_APPLICABLE' if 'NOT_APPLICABLE' in outcomes else 'PASS'\n\"\"\"固定來源、候選範圍與保守分類。\"\"\"\nimport hashlib\nimport json\nfrom pathlib import Path\nfrom scripts.inventory import extract\nfrom .batch1 import ADDED\nfrom .quality import status\nfrom .batch2 import ADDED as BATCH2\n\nROOT = Path(__file__).resolve().parents[1]\nXLSX_HASH = '7d752b639a1e780df08814c6252efadd3ea2711eaa5c9d91c070b84a296c0247'\nDOCX_HASH = '986effd9501b1fd97776129c6691cf8fc98246bd04514347322f3337508e0e5b'\nIMPLEMENTED = {45: 'base', 46: 'base', 108: 'base', 243: 'firewalld',\n               245: 'firewalld', 269: 'sshd', 270: 'sshd'}\nIMPLEMENTED.update({n: ('sshd' if n in (256,257) else 'firewalld' if n==242 else 'base') for n in ADDED})\nIMPLEMENTED.update({n: ('sshd' if n >= 254 else 'base') for n in BATCH2})\nPARTIAL = {141: '僅來源設定方法明列 audit.rules；其餘 rules.d 規則檔集合尚未覆蓋',\n           108: '僅雙協定即時值；持久設定來源、覆寫順序與路由角色待審',\n           269: '僅 sshd -T 預設情境；Include/Match 與使用者/來源矩陣待審',\n           270: '僅 sshd -T 預設情境；Include/Match 與使用者/來源矩陣待審'}\n\n\ndef digest(path):\n    return hashlib.sha256(path.read_bytes()).hexdigest()\n\n\ndef registry():\n    source = next(ROOT.glob('*.xlsx'))\n    docx = next(ROOT.glob('*.docx'))\n    if digest(source) != XLSX_HASH or digest(docx) != DOCX_HASH:\n        raise ValueError('來源 hash 改變，停止產生')\n    records = extract(source)\n    result = []\n    for r in records:\n        n = int(r['gcb_id'][-4:])\n        included = r['sheet'] != 'Nftables防火牆'\n        profile = ('firewalld' if r['sheet'] == 'Firewalld防火牆' else\n                   'sshd' if r['sheet'] == 'SSH伺服器' else 'base')\n        if n in IMPLEMENTED:\n            classification, why = 'native_sca', '候選唯讀原生命令；完整語意與引擎驗收待人工審查'\n        elif profile != 'base' or any(k in r['title'] for k in ('GUI', '無線', '可攜', 'NFS')):\n            classification, why = 'conditional', '須先確認角色、服務與適用性，再選擇實作方式'\n        elif any(k in r['title'] for k in ('權限', '所有權', '擁有', '稽核', '密碼', '通行碼')):\n            classification, why = 'readonly_helper', '可能涉及集合、位元或載入鏈解析；尚未實作 helper'\n        else:\n            classification, why = 'manual_review', '尚未逐條語意審查，保守列人工待辦，非不可自動化結論'\n        result.append(dict(gcb_id=r['gcb_id'], source_file=r['source_file'],\n            source_sheet=r['sheet'], source_row=r['row'], source_sha256=XLSX_HASH,\n            category=r['category'], title=r['title'], expected=r['expected'],\n            included=included, scope_reason='候選，仍須主機適用性核准' if included else '明確排除 Nftables 工作表',\n            sca_id=900000+n, profile=profile, proposed_classification=classification,\n            justification=why, review_status='human_review_pending',\n            implementation='candidate' if n in IMPLEMENTED else 'pending' if included else 'excluded',\n            policy_id='linuxgcb_rhel9_'+IMPLEMENTED[n]+'_v01' if n in IMPLEMENTED else None,\n            coverage='partial' if n in PARTIAL else 'full' if n in IMPLEMENTED else 'unimplemented',\n            live_validation='UNVALIDATED', execution_review='pending',\n            pending=PARTIAL.get(n, '' if n in IMPLEMENTED else '未實作；待逐條 DOCX 語意審查')))\n        if n in IMPLEMENTED:\n            result[-1].update(status(n))\n    if (len(result), sum(r['included'] for r in result), len({r['sca_id'] for r in result}),\n        len({r['gcb_id'] for r in result})) != (314, 307, 314, 314):\n        raise ValueError('範圍或唯一性不符')\n    return result\n\n\ndef write_registry():\n    rows = registry()\n    (ROOT/'data/scope_registry.json').write_text(json.dumps(rows, ensure_ascii=False, indent=2)+'\\n')\n    return rows\n\"\"\"Q1 離線審查結論；只涵蓋原有 53 ID，非來源或真機核准。\"\"\"\nfrom .batch1 import FILES, PACKAGES, SERVICES\nfrom .batch2 import ADDED as BATCH2, caveat as batch2_caveat\n\nABSENCE_PENDING = {30,94,97,98,245}\n\ndef findings(n):\n    issues = ['Q1-01']  # 非零但匹配 stdout，無已核准的原生執行狀態保護\n    if n in FILES or n in (45,46): issues += ['Q1-03','Q1-04']\n    if n in range(53,61) or n in (141,178,191,192): issues += ['Q1-05']\n    if n in SERVICES or n in (243,245): issues += ['Q1-06']\n    if n in ABSENCE_PENDING: issues += ['Q1-07']\n    if n in (108,141,269,270): issues += ['Q1-08']\n    return issues\n\ndef family(n):\n    if n in FILES or n in (45,46): return '檔案 metadata'\n    if n in PACKAGES: return 'RPM 存在'\n    if n in SERVICES or n in (243,245): return 'systemd 服務'\n    if n == 108: return 'sysctl 即時值'\n    return 'SSH 預設有效設定'\n\ndef status(n):\n    if n in BATCH2:\n        return dict(offline_review='completed_with_findings', execution_review='blocked',\n                    coverage='partial', issue_ids=['B2-ENGINE', 'B2-SCOPE'],\n                    family='BATCH2 guarded read-only', source_approval='pending',\n                    live_validation='UNVALIDATED', pending=batch2_caveat(n))\n    return dict(offline_review='completed_with_findings',\n                execution_review='blocked',\n                coverage='blocked' if n in ABSENCE_PENDING else 'partial',\n                issue_ids=findings(n), family=family(n),\n                source_approval='pending', live_validation='UNVALIDATED')\n\"\"\"Rebuild only BATCH2 synthetic observations from emitted targets; no execution.\"\"\"\nimport copy\nimport json\nfrom linuxgcb.catalog import ROOT\nfrom linuxgcb.batch2 import ABSENT_PACKAGES, ADDED, MARKER, guarded, specs\nfrom linuxgcb.policy import emit_rule\n\n\ndef generated():\n    checks={c['id']:c for p in (ROOT/'policies').glob('*.yml') for c in json.loads(p.read_text())['checks']}\n    result={}\n    for n,items in specs().items():\n        check=checks[900000+n]\n        targets={rule.split(' -> ',1)[0].removeprefix('not ') for rule in check['rules']}\n        positive={t:dict(stdout='',exit_code=0) for t in targets}\n        for cmd,pattern,good,bad in items:\n            rule=emit_rule(guarded(cmd),pattern)\n            assert rule in check['rules'], (n,rule)\n            target=rule.split(' -> ',1)[0].removeprefix('not ')\n            positive[target]['stdout']+='\\n'+good\n        for obs in positive.values():\n            obs['stdout']=obs['stdout'].strip('\\n')+('' if n in ABSENT_PACKAGES else '\\n'+MARKER)\n        # One counterexample per source predicate, preserving all other targets.\n        mutations=[]\n        for cmd,pattern,good,bad in items:\n            obs=copy.deepcopy(positive)\n            target=guarded(cmd)\n            # Keep other predicates on the same command intact; adding an extra\n            # invalid member is the decisive negative case for collection rules.\n            if pattern.startswith('!'):\n                obs[target]['stdout']+='\\n'+bad\n            else:\n                obs[target]['stdout']=obs[target]['stdout'].replace(good,bad)\n            mutations.append(dict(rule=emit_rule(target,pattern),observations=obs))\n        result[str(check['id'])]=dict(positive=positive,negative=mutations[0]['observations'],\n            missing={},empty={t:dict(stdout='',exit_code=0) for t in targets},\n            error={t:dict(error='SYNTHETIC command error') for t in targets},\n            nonzero_matching={t:dict(stdout=o['stdout'],exit_code=1,stderr='SYNTHETIC failure despite matching stdout') for t,o in positive.items()},\n            predicate_negatives=mutations)\n    return result\n\n\ndef main():\n    path=ROOT/'tests/fixtures/rule_outputs.json'\n    data=json.loads(path.read_text())\n    for key in list(data['checks']):\n        if int(key)-900000 in ADDED: del data['checks'][key]\n    data['checks'].update(generated())\n    path.write_text(json.dumps(data,ensure_ascii=False,indent=2)+'\\n')\n\nif __name__=='__main__': main()\n\"\"\"BATCH2 synthetic contract/guard tests. Never execute any policy command.\n\nThe only subprocesses run shell builtins with authored printf/exit data, after\nreplacing the entire inventory command in the emitted shell script.\n\"\"\"\nimport copy\nimport hashlib\nimport json\nimport re\nimport shlex\nimport subprocess\nimport unittest\n\nfrom linuxgcb.argv import w_strtok\nfrom linuxgcb.batch2 import ABSENT_PACKAGES, ADDED, CATEGORIES, MARKER, specs, guarded, expected\nfrom linuxgcb.catalog import ROOT, registry\nfrom linuxgcb.policy import emit_rule, parse_rule, simulate\nfrom scripts.batch2_fixtures import generated\n\n\nclass Batch2Tests(unittest.TestCase):\n    @classmethod\n    def setUpClass(cls):\n        cls.checks={c['id']:c for p in (ROOT/'policies').glob('*.yml') for c in json.loads(p.read_text())['checks']}\n        cls.fixtures=json.loads((ROOT/'tests/fixtures/rule_outputs.json').read_text())['checks']\n        cls.baseline=json.loads((ROOT/'tests/fixtures/batch2_baseline.json').read_text())\n\n    def check(self,n): return self.checks[900000+n]\n    def positive(self,n): return copy.deepcopy(self.fixtures[str(900000+n)]['positive'])\n\n    def test_registry_exact_remaining_categories_and_baseline(self):\n        before={c['id'] for c in self.baseline['checks']}\n        rows=registry()\n        wanted={r['sca_id'] for r in rows if r['category'] in CATEGORIES and r['sca_id'] not in before}\n        self.assertEqual(wanted,{900000+n for n in ADDED})\n        self.assertEqual(len(ADDED),44)\n        self.assertEqual(len(self.checks),97)\n        self.assertFalse(any(r['coverage']=='unimplemented' for r in rows if r['category'] in CATEGORIES))\n        self.assertEqual({c['id']:c for c in self.baseline['checks']}, {n:self.checks[n] for n in before})\n        for filename,digest in self.baseline['hashes'].items():\n            self.assertEqual(hashlib.sha256((ROOT/filename).read_bytes()).hexdigest(),digest)\n        for row in rows:\n            if row['sca_id'] not in before and row['category'] not in CATEGORIES:\n                self.assertNotEqual(row['implementation'],'candidate')\n        # Existing synthetic fixtures are also preserved field for field.\n        for key,digest in self.baseline['legacy_fixture_hashes'].items():\n            self.assertEqual(hashlib.sha256(json.dumps(self.fixtures[key],sort_keys=True,ensure_ascii=False).encode()).hexdigest(),digest)\n\n    def test_generated_fixtures_and_every_predicate_counterexample(self):\n        self.assertEqual(generated(),{str(900000+n):self.fixtures[str(900000+n)] for n in ADDED})\n        for n in sorted(ADDED):\n            cases=self.fixtures[str(900000+n)]\n            check=self.check(n)\n            self.assertEqual(check['regex_type'],'pcre2')\n            self.assertEqual(check['compliance'],[{'twgcb':['TWGCB-01-012-'+format(n,'04d')]}])\n            for name,want in [('positive','PASS'),('negative','FAIL'),('missing','UNRESOLVED'),('empty','FAIL'),('error','UNRESOLVED'),('nonzero_matching','PASS')]:\n                with self.subTest(n=n,case=name): self.assertEqual(simulate(check,cases[name]),want)\n            for case in cases['predicate_negatives']:\n                with self.subTest(n=n,rule=case['rule']):\n                    self.assertIn(case['rule'],check['rules'])\n                    self.assertEqual(simulate(check,case['observations']),'FAIL')\n            self.assertIn('UNVALIDATED', next(json.loads(p.read_text())['policy']['name'] for p in (ROOT/'policies').glob('*.yml') if any(c['id']==check['id'] for c in json.loads(p.read_text())['checks'])))\n            for target in cases['positive']:\n                no_marker=self.positive(n)\n                no_marker[target]['stdout']=no_marker[target]['stdout'].replace('ABSENT' if n in ABSENT_PACKAGES else MARKER,'')\n                self.assertNotEqual(simulate(check,no_marker),'PASS')\n                for variant in (None,dict(error='permission denied')):\n                    obs=self.positive(n)\n                    if variant is None: del obs[target]\n                    else: obs[target]=variant\n                    with self.subTest(n=n,target=target,variant=variant):\n                        self.assertNotEqual(simulate(check,obs),'PASS')\n\n    def test_emitted_guard_with_fake_commands_only(self):\n        for n,items in specs().items():\n            if n in ABSENT_PACKAGES: continue  # Dedicated FIX3 tri-state tests.\n            for command,pattern,good,bad in items:\n                target=guarded(command)\n                # Obtain the actual emitted wrapper then replace its full inner\n                # inventory command with a shell containing only printf/exit.\n                self.assertIn(target,{parse_rule(rule)[0] for rule in self.check(n)['rules']})\n                argv=w_strtok(target[2:])\n                self.assertEqual(argv[:2],['/bin/sh','-c'])\n                prefix='out=$('+command+')'\n                self.assertTrue(argv[2].startswith(prefix))\n                for code in (0,1,2,126,127):\n                    payload=good+'\\n'+MARKER+'\\n'  # Even matching stdout cannot escape a failed command.\n                    fake='/bin/sh -c '+shlex.quote('printf \"%s\" '+shlex.quote(payload)+'; exit '+str(code))\n                    script='out=$('+fake+')'+argv[2][len(prefix):]\n                    completed=subprocess.run(['/bin/sh','-c',script],text=True,capture_output=True,timeout=5)\n                    self.assertEqual(completed.returncode,code)\n                    self.assertEqual(completed.stdout,payload+MARKER+'\\n' if code==0 else '')\n                    if code:\n                        obs=self.positive(n)\n                        obs[target]=dict(stdout=completed.stdout,exit_code=completed.returncode)\n                        self.assertNotEqual(simulate(self.check(n),obs),'PASS')\n\n    def test_negation_is_rule_level_not_existential_line_negation(self):\n        for n,items in specs().items():\n            if n in ABSENT_PACKAGES: continue  # Dedicated FIX3 tri-state tests.\n            for command,pattern,good,bad in items:\n                if not pattern.startswith('!'): continue\n                rule=emit_rule(guarded(command),pattern)\n                self.assertTrue(rule.startswith('not c:'))\n                self.assertNotIn('!r:',rule)\n                obs=self.positive(n)\n                # A compliant unrelated line cannot hide a prohibited member.\n                obs[guarded(command)]['stdout']='unrelated\\n'+bad+'\\n'+MARKER\n                self.assertEqual(simulate(self.check(n),obs),'FAIL')\n\n    def test_default_protocol_and_compression(self):\n        for text,want in [('port 22','PASS'),('protocol 2','PASS'),('protocol 1','FAIL'),('protocol 2,1','FAIL')]:\n            obs=self.positive(255);target=next(iter(obs));obs[target]['stdout']=text+'\\n'+MARKER\n            self.assertEqual(simulate(self.check(255),obs),want)\n        for value,want in [('yes','PASS'),('delayed','PASS'),('no','PASS'),('invalid','FAIL')]:\n            obs=self.positive(279);target=next(iter(obs));obs[target]['stdout']='compression '+value+'\\n'+MARKER\n            self.assertEqual(simulate(self.check(279),obs),want)\n        for n in (255,279): self.assertIn('RHEL9 OpenSSH 8.0+',self.check(n)['description'])\n\n    def test_numeric_boundaries_and_crypto_components(self):\n        for n,key,maximum in ((266,'maxauthtries',4),(272,'clientaliveinterval',600),(273,'logingracetime',60),(277,'maxsessions',4)):\n            for value in (-1,0,1,maximum,maximum+1,99999):\n                obs=self.positive(n);target=next(iter(obs))\n                obs[target]['stdout']=re.sub(key+r' [0-9]+',key+' '+str(value),obs[target]['stdout'])\n                self.assertEqual(simulate(self.check(n),obs),'PASS' if 1<=value<=maximum else 'FAIL')\n        for key,bad in [('ciphers','aes128-cbc'),('macs','hmac-md5'),('kexalgorithms','diffie-hellman-group1-sha1')]:\n            obs=self.positive(263);target=next(iter(obs))\n            obs[target]['stdout']=re.sub('^'+key+r' .*$',key+' '+bad,obs[target]['stdout'],flags=re.M)\n            self.assertEqual(simulate(self.check(263),obs),'FAIL')\n\n    def test_key_sets_reject_empty_and_any_bad_member(self):\n        for n in (259,260,261,262):\n            check=self.check(n);obs=self.positive(n);target=next(iter(obs))\n            obs[target]['stdout']=MARKER\n            self.assertEqual(simulate(check,obs),'FAIL')\n            bad=specs()[n][0][-1]\n            obs=self.positive(n);obs[target]['stdout']+='\\n'+bad\n            self.assertEqual(simulate(check,obs),'FAIL')\n        for n,mask in ((204,0o600),(260,0o640),(262,0o644)):\n            rule=next(r for r in self.check(n)['rules'] if not r.startswith('not ') and 'stat -c %a' in r)\n            _,pattern=parse_rule(rule)\n            for value in range(0o10000):\n                self.assertEqual(bool(pattern.fullmatch(format(value,'o'))),value & ~mask==0)\n\n    def test_current_docx_amendment_and_concrete_values(self):\n        manifest=json.loads((ROOT/'data/coverage_manifest.json').read_text())\n        row=next(r for r in manifest['reviewed'] if r['sca_id']==900272)\n        self.assertTrue(all('ClientAliveCountMax 1' in c[-2] for c in row['docx_all_cells']))\n        self.assertTrue(any('ClientAliveCountMax 0' in c[-2] for c in row['docx_historical_cells']))\n        source={r['gcb_id']:r for r in json.loads((ROOT/'data/controls.json').read_text())}\n        for n in ADDED:\n            value=expected(source['TWGCB-01-012-'+format(n,'04d')])\n            self.assertTrue(self.check(n)['description'].startswith('合規值: '+value+' ｜ '))\n        self.assertIn('待確認（來源未提供單一基準值）',self.check(258)['description'])\n\n    def test_allowlist_rejects_altered_shell_and_negation(self):\n        target=next(iter(self.positive(255)))\n        for rule in ('not c:/SYNTHETIC -> r:^bad$',target.replace('/usr/sbin/sshd','/tmp/evil')+' -> r:^good$'):\n            with self.assertRaises(ValueError): parse_rule(rule)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"agent_message","text":"已確認專案以固定 ID registry 產生政策，並有 FIX-2 引號解析與 FIX-3 的 256 行輸出模型。我也讀取了環境 runtime 技能；本次只做工作區內的離線開發，不使用網路或主機服務操作。"}}

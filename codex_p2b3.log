{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc 'cat linuxgcb/argv.py; cat tests/test_catalog_policy.py | head -130; cat tests/test_expected.py | head -100; cat linuxgcb/__main__.py | head -80'","aggregated_output":"\"\"\"Offline wm_exec argv subset: double quotes group; backslash escapes.\n\nSingle quotes are ordinary bytes. No shell expansion occurs at this layer.\nMalformed input is rejected rather than guessing an executable argv.\n\"\"\"\n\n\ndef w_strtok(command):\n    argv, word = [], []\n    quoted = active = False\n    i = 0\n    while i < len(command):\n        char = command[i]\n        if char == '\\\\':\n            i += 1\n            if i == len(command):\n                raise ValueError('Trailing escape')\n            word.append(command[i])\n            active = True\n        elif char == '\"':\n            quoted = not quoted\n            active = True\n        elif char in ' \\t\\r\\n' and not quoted:\n            if active:\n                argv.append(''.join(word))\n                word, active = [], False\n        else:\n            word.append(char)\n            active = True\n        i += 1\n    if quoted:\n        raise ValueError('Unpaired double quote')\n    if active:\n        argv.append(''.join(word))\n    return argv\n\n\ndef quote_argument(value):\n    \"\"\"Encode one argument and verify its round trip through the model.\"\"\"\n    encoded = '\"' + value.replace('\\\\', '\\\\\\\\').replace('\"', '\\\\\"') + '\"'\n    assert w_strtok(encoded) == [value]\n    return encoded\nimport json\nimport unittest\nfrom pathlib import Path\nfrom linuxgcb.catalog import ROOT, registry, digest, XLSX_HASH\nfrom linuxgcb.policy import validate, simulate, definitions\nfrom linuxgcb.batch1 import FILES, ADDED\nfrom linuxgcb.coverage import manifest\nfrom linuxgcb.batch2 import ADDED as BATCH2\nfrom scripts.inventory import extract\n\n\nclass CatalogTests(unittest.TestCase):\n    def test_scope_and_source_unchanged(self):\n        rows = registry()\n        self.assertEqual((len(rows), sum(r['included'] for r in rows)), (314,307))\n        self.assertEqual(len({r['sca_id'] for r in rows}),314)\n        self.assertEqual(len({r['gcb_id'] for r in rows}),314)\n        self.assertEqual({r['source_sheet'] for r in rows if not r['included']}, {'Nftables防火牆'})\n        self.assertTrue(next(r for r in rows if r['sca_id']==900245)['included'])\n        self.assertFalse(any(r['gcb_id'].endswith('-0180') for r in rows))\n        self.assertEqual(digest(next(ROOT.glob('*.xlsx'))), XLSX_HASH)\n        self.assertEqual(rows,json.loads((ROOT/'data/scope_registry.json').read_text()))\n\n    def test_raw_controls_unchanged(self):\n        self.assertEqual(extract(next(ROOT.glob('*.xlsx'))),json.loads((ROOT/'data/controls.json').read_text()))\n\n    def test_traceability(self):\n        source = {r['gcb_id']:r for r in extract(next(ROOT.glob('*.xlsx')))}\n        for r in registry():\n            self.assertEqual(r['source_row'],source[r['gcb_id']]['row'])\n            self.assertEqual(r['expected'],source[r['gcb_id']]['expected'])\n            self.assertEqual(r['review_status'],'human_review_pending')\n\n    def test_structural(self):\n        self.assertEqual(validate(),len(definitions()))\n\n    def test_all_positive_negative_missing_error(self):\n        fixtures=json.loads((ROOT/'tests/fixtures/rule_outputs.json').read_text())\n        self.assertEqual(fixtures['label'],'SYNTHETIC TEST ONLY')\n        checked = set()\n        for p in (ROOT/'policies').glob('*.yml'):\n            for c in json.loads(p.read_text())['checks']:\n                checked.add(str(c['id']))\n                for name, state in [('positive','PASS'),('negative','FAIL'),('missing','UNRESOLVED'),('empty','FAIL'),('error','UNRESOLVED'),('nonzero_matching','PASS')]:\n                    with self.subTest(id=c['id'],case=name):\n                        self.assertEqual(simulate(c,fixtures['checks'][str(c['id'])][name]), state)\n        self.assertEqual(checked,set(fixtures['checks']))\n\n    def test_permission_bit_subset_and_special_bits(self):\n        c=next(c for c in json.loads((ROOT/'policies/linuxgcb_base.yml').read_text())['checks'] if c['id']==900046)\n        target=c['rules'][0].split(' -> ')[0]\n        for mode in range(0o10000):\n            expected='PASS' if mode & ~0o644 == 0 else 'FAIL'\n            self.assertEqual(simulate(c,{target:dict(stdout=format(mode,'o'),exit_code=0)}),expected)\n\n    def test_exit_code_does_not_override_matching_output(self):\n        c=next(c for c in json.loads((ROOT/'policies/linuxgcb_base.yml').read_text())['checks'] if c['id']==900045)\n        target=c['rules'][0].split(' -> ')[0]\n        self.assertEqual(simulate(c,{target:dict(stdout='0:0',exit_code=1)}),'PASS')\n\n    def test_batch_manifest_reconciles_and_docx(self):\n        m=manifest();rows=registry()\n        self.assertEqual({e['sca_id'] for e in m['reviewed']},{900000+n for n in definitions()})\n        self.assertEqual(m['counts']['implemented'],len(definitions()))\n        self.assertEqual(m['counts']['remaining'],307-len(definitions()))\n        self.assertEqual(m['counts']['full']+m['counts']['partial']+m['counts']['blocked'],len(definitions()))\n        self.assertEqual((m['counts']['full'],m['counts']['partial'],m['counts']['blocked']),(0,48+len(BATCH2),5))\n        for e in m['reviewed']:\n            self.assertTrue(all(e['expected'] == c[-1] for c in e['docx_all_cells']))\n            self.assertTrue(all(e['gcb_id'] in c for c in e['docx_all_cells']))\n            n=e['sca_id']-900000\n            method=e['docx_cells'][-2]\n            if n in FILES:\n                self.assertIn(FILES[n][0],method)\n\n    def test_all_mode_masks_exhaustive(self):\n        from linuxgcb.batch1 import mode_pattern\n        import re\n        masks={v for _,kind,v in FILES.values() if kind=='mode'}\n        for mask in masks:\n            pattern=re.compile(mode_pattern(mask))\n            for value in range(0o10000):\n                self.assertEqual(bool(pattern.search(format(value,'o'))),value & ~mask == 0)\n\n    def test_batch_edges_use_emitted_rules(self):\n        import copy\n        checks={c['id']:c for p in (ROOT/'policies').glob('*.yml') for c in json.loads(p.read_text())['checks']}\n        fixtures=json.loads((ROOT/'tests/fixtures/rule_outputs.json').read_text())['checks']\n        for n in sorted(ADDED):\n            check=checks[900000+n];base=fixtures[str(900000+n)]['positive']\n            # 每個子規則必須獨立參與 all；非第一個錯誤亦不可被第一個 PASS 掩蓋。\n            for target in base:\n                obs=copy.deepcopy(base);obs[target]['stdout']='WRONG'\n                self.assertEqual(simulate(check,obs),'FAIL')\n                obs=copy.deepcopy(base);obs[target]['stdout']+='\\nWRONG'\n                self.assertEqual(simulate(check,obs),'PASS') # SCA 逐行存在匹配，不是整個輸出相等\n            if n in FILES:\n                path,kind,value=FILES[n]\n                if kind=='owner':\n                    target='c:/usr/bin/stat -c %U:%G '+path\n                    for owner in ('root:shadow','root:wheel','nobody:root','root:UNKNOWN'):\n                        obs=copy.deepcopy(base);obs[target]['stdout']=owner\n                        self.assertEqual(simulate(check,obs),'PASS' if owner=='root:shadow' and 'shadow' in value else 'FAIL')\n                type_target='c:/usr/bin/stat -c %f '+path\n                if type_target in base:\n                    for mode in ('81a4','a1ff','11a4','21a4','61a4','c1a4'):\n                        obs=copy.deepcopy(base);obs[type_target]['stdout']=mode\n                        self.assertEqual(simulate(check,obs),'FAIL')\n            from linuxgcb.batch1 import SERVICES,PACKAGES\n            if n in SERVICES:\n                target=next(t for t in base if 'UnitFileState' in t)\n                for value in ('enabled-runtime','static','alias','not-found'):\n                    obs=copy.deepcopy(base);obs[target]['stdout']='UnitFileState='+value\n                    self.assertEqual(simulate(check,obs),'FAIL')\n                obs=copy.deepcopy(base)\n                target=next(t for t in base if 'LoadState' in t);obs[target]['stdout']='LoadState=not-found'\n                self.assertEqual(simulate(check,obs),'PASS' if n in (30,94,97,98,101) else 'FAIL')\n            if n in PACKAGES:\n                obs=copy.deepcopy(base);target=next(iter(base));obs[target]['stdout']='package missing is not installed'\n                obs[target]['exit_code']=1\n                self.assertEqual(simulate(check,obs),'FAIL')\n\n    def test_documented_file_and_all_semantics(self):\n        check=dict(condition='all',rules=['f:/SYNTHETIC -> r:^ID=rhel$'])\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(exists=False)}),'NOT_APPLICABLE')\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(stdout='')}),'FAIL')\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(error='permission denied')}),'UNRESOLVED')\n        check['rules'].append('c:/SYNTHETIC -> r:^good$')\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(exists=False),'c:/SYNTHETIC':dict(stdout='bad')}),'FAIL')\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(exists=False),'c:/SYNTHETIC':dict(stdout='good')}),'NOT_APPLICABLE')\n\"\"\"EXP-1；所有變異皆為記憶體內 test-only，不改寫真實 fixture。\"\"\"\nimport csv\nimport json\nimport tempfile\nimport unittest\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom linuxgcb.catalog import ROOT\nfrom linuxgcb.batch2 import ADDED as BATCH2\nfrom linuxgcb.expected import UNKNOWN, parse_description, source_expected\nfrom linuxgcb.report import normalize, render\nfrom linuxgcb.snapshot import convert\n\n\nclass ExpectedTests(unittest.TestCase):\n    def test_all_53_source_values_and_q1_preserved(self):\n        source = {r['gcb_id']: r for r in json.loads((ROOT/'data/controls.json').read_text())}\n        checks = [c for p in (ROOT/'policies').glob('*.yml') for c in json.loads(p.read_text())['checks']]\n        checks = [c for c in checks if c['id']-900000 not in BATCH2]\n        self.assertEqual(len(checks), 53)\n        for c in checks:\n            gid = c['compliance'][0]['twgcb'][0]\n            self.assertTrue(c['description'].startswith('合規值: '))\n            self.assertIn(' ｜ Q1 執行審查 ', c['description'])\n            self.assertEqual(parse_description(c['description']), source_expected(source[gid]))\n            self.assertNotEqual(parse_description(c['description']), UNKNOWN)\n        by = {c['id']: parse_description(c['description']) for c in checks}\n        self.assertEqual(by[900242], 'firewalld 已安裝')\n        self.assertEqual(by[900245], 'nftables masked+inactive')\n        self.assertEqual(by[900132], 'audit audit-libs 已安裝')\n        self.assertEqual(by[900047], 'root:root或root:shadow')\n\n    def test_parser_and_missing_source(self):\n        self.assertEqual(parse_description('合規值: 000 ｜ Q1 review'), '000')\n        self.assertEqual(parse_description('合規值: no'), 'no')\n        for text in (None, '', 'Q1 old', ' 合規值: 0', '合規值:  ｜ Q1 old'):\n            self.assertEqual(parse_description(text), '')\n        self.assertEqual(source_expected({'gcb_id':'unknown', 'expected':None}), UNKNOWN)\n        self.assertEqual(source_expected({'gcb_id':'unknown', 'expected':'安裝'}), UNKNOWN)\n\n    def test_real_r2_r3_expected_in_snapshot_csv_html(self):\n        for filename in ('realhost_r2.json', 'realhost_r3.json'):\n            path = ROOT/'tests/fixtures'/filename\n            before = path.read_bytes()\n            snapshot = convert(path)\n            self.assertTrue(all(c['expected'] for c in snapshot['hosts'][0]['checks']))\n            with tempfile.TemporaryDirectory() as d:\n                render(snapshot, d, datetime(2026,10,31,23,tzinfo=timezone.utc))\n                with (Path(d)/'report.csv').open(encoding='utf-8-sig', newline='') as f:\n                    observed = [r for r in csv.DictReader(f) if r['raw_result']]\n                self.assertEqual(len(observed), 53)\n                self.assertTrue(all(r['expected'] for r in observed))\n                self.assertTrue(all('raw_prefix_missing' in r['expected_status'] for r in observed))\n                self.assertIn('<th>expected</th>', (Path(d)/'report.html').read_text())\n            self.assertEqual(path.read_bytes(), before)\n\n    def test_raw_description_precedes_policy_and_missing_is_marked(self):\n        snapshot = convert(ROOT/'tests/fixtures/realhost_r2.json')\n        c = snapshot['hosts'][0]['checks'][0]\n        c['description'] = '合規值: test-only 基準 ｜ Q1 test-only'\n        rows = normalize(snapshot, datetime(2026,10,31,23,tzinfo=timezone.utc))\n        row = next(r for r in rows if r['sca_id']==c['id'])\n        self.assertEqual(row['expected'], 'test-only 基準')\n        self.assertEqual(row['expected_status'], 'raw_description')\n        missing = next(r for r in rows if r['policy_id'] is None)\n        self.assertEqual(missing['expected'], '')\n        self.assertEqual(missing['expected_status'], 'prefix_missing')\n\"\"\"python3 -m linuxgcb：完全離線，不執行 SCA 命令。\"\"\"\nimport argparse\nimport json\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom .catalog import write_registry\nfrom .policy import build, validate\nfrom .report import render\nfrom .collector import timestamp\nfrom .snapshot import convert\n\n\ndef main():\n    parser = argparse.ArgumentParser(description='LinuxGCB 離線工具（未完成真機驗收）')\n    sub = parser.add_subparsers(dest='command', required=True)\n    sub.add_parser('build', help='驗證來源並重建 registry 與候選政策')\n    sub.add_parser('validate', help='離線結構與來源檢查，非引擎驗收')\n    report = sub.add_parser('report', help='匯入離線 JSON，輸出 HTML/CSV 與稽核副本')\n    report.add_argument('snapshot')\n    report.add_argument('--out', required=True)\n    report.add_argument('--now', help='固定報表時間，ISO8601 含時區')\n    snapshot = sub.add_parser('snapshot', help='離線 Manager DB JSON 轉 snapshot v1')\n    snapshot.add_argument('manager_dump')\n    snapshot.add_argument('--out', required=True)\n    snapshot.add_argument('--scan-info', help='同次離線 sca_scan_info JSON，依 policy_id 對應 end_scan')\n    args = parser.parse_args()\n    if args.command == 'build':\n        rows = write_registry()\n        build()\n        print(f'314 項；307 候選／7 排除；{validate()} 項候選規則，UNVALIDATED／人工審查待完成')\n    elif args.command == 'validate':\n        print('UNVALIDATED：離線結構檢查通過，候選控制項數', validate())\n    elif args.command == 'snapshot':\n        validate()\n        result = convert(args.manager_dump, json.loads(Path(args.scan_info).read_text()) if args.scan_info else None)\n        target = Path(args.out)\n        target.parent.mkdir(parents=True, exist_ok=True)\n        target.write_text(json.dumps(result, ensure_ascii=False, indent=2)+'\\n')\n        print(json.dumps(result['warnings'], ensure_ascii=False))\n    else:\n        validate()\n        result = render(json.loads(Path(args.snapshot).read_text()), args.out,\n                        timestamp(args.now) if args.now else datetime.now(timezone.utc))\n        print(json.dumps(result, ensure_ascii=False, indent=2))\n\nif __name__ == '__main__':\n    main()\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc 'cat tests/test_quality_q1.py; cat tests/test_catalog_policy.py'","aggregated_output":"\"\"\"SYNTHETIC Q1 回歸；不執行任何政策命令。\"\"\"\nimport copy\nimport json\nimport stat\nimport tempfile\nimport unittest\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom linuxgcb.catalog import ROOT, registry\nfrom linuxgcb.policy import simulate, definitions\nfrom linuxgcb.report import normalize, metrics, render\n\nNOW = datetime(2026,10,30,tzinfo=timezone.utc)\n\nclass QualityQ1Tests(unittest.TestCase):\n    def check(self, n):\n        return dict(condition='all', regex_type='pcre2',\n                    rules=[a+' -> r:'+b for a,b in definitions()[n]])\n\n    def snapshot(self):\n        return json.loads((ROOT/'tests/fixtures/snapshot.json').read_text())\n\n    def test_reject_unsupported_conditions_even_when_matching(self):\n        for condition in ('any','none','ALL',''):\n            with self.subTest(condition=condition), self.assertRaises(ValueError):\n                simulate(dict(condition=condition,rules=['c:/SYNTHETIC -> r:^good$']), {})\n\n    def test_reject_unsupported_rule_and_regex_syntax(self):\n        for rule in ('p:daemon -> r:^good$', 'c:/SYNTHETIC -> r:^good$ && r:bad',\n                     'c:/SYNTHETIC -> r:^(?=good)good$', 'c:/SYNTHETIC -> r:^\\\\w+$',\n                     'c:/SYNTHETIC -> r:^good.$|bad', 'c:/SYNTHETIC -> n:(\\\\d+) compare == 1'):\n            with self.subTest(rule=rule), self.assertRaises(ValueError):\n                simulate(dict(condition='all',rules=[rule]), {})\n        for check in (dict(condition='all',rules=[]),dict(condition='all',regex_type='osregex',rules=['c:/SYNTHETIC -> r:^good$'])):\n            with self.assertRaises(ValueError): simulate(check,{})\n\n    def test_stat_uses_numeric_directory_type_only(self):\n        from linuxgcb.batch1 import FILES\n        for n,(path,_,_) in FILES.items():\n            rules=self.check(n)['rules']\n            self.assertFalse(any('%F' in r for r in rules))\n            directory=n in (179,193,194,195,196,197,198,199,200,201,202)\n            self.assertEqual(any('%f ' in r for r in rules),directory)\n            # regular 是舊版額外要求；來源沒有明文限定，不能默默加嚴。\n            self.assertFalse(any('regular' in r for r in rules))\n\n    def test_numeric_type_locale_and_all_file_types(self):\n        # locale 為具名合成情境，未宣稱本機安裝這些 locale。\n        for locale in ('C','zh_TW.UTF-8','de_DE.UTF-8'):\n            for kind in (stat.S_IFDIR,stat.S_IFREG,stat.S_IFLNK,stat.S_IFIFO,stat.S_IFSOCK,stat.S_IFCHR,stat.S_IFBLK):\n                for mode in (0,0o700,0o755,0o7777):\n                    obs={'c:/usr/bin/stat -c %U:%G /var/log':dict(stdout='root:root'),\n                         'c:/usr/bin/stat -c %f /var/log':dict(stdout=format(kind|mode,'x'))}\n                    with self.subTest(locale=locale,kind=kind,mode=mode):\n                        self.assertEqual(simulate(self.check(179),obs),'PASS' if kind==stat.S_IFDIR else 'FAIL')\n\n    def test_stderr_exit_and_multiline_are_not_runtime_protection(self):\n        check=dict(condition='all',rules=['c:/SYNTHETIC -> r:^good$'])\n        for code in (0,1,127):\n            self.assertEqual(simulate(check,{'c:/SYNTHETIC':dict(stdout='bad\\ngood\\nbad',stderr='SYNTHETIC error',exit_code=code)}),'PASS')\n        for stdout in ('','bad','good bad','good\\rbad'):\n            self.assertEqual(simulate(check,{'c:/SYNTHETIC':dict(stdout=stdout,stderr='good',exit_code=1)}),'FAIL')\n        self.assertEqual(simulate(check,{}),'UNRESOLVED')\n        self.assertEqual(simulate(check,{'c:/SYNTHETIC':dict(error='SYNTHETIC unknown execution')}),'UNRESOLVED')\n\n    def test_all_aggregates_error_na_and_failure(self):\n        check=dict(condition='all',rules=['c:/A -> r:^good$','c:/B -> r:^good$'])\n        for second,want in ((dict(stdout='bad'),'FAIL'),(dict(stdout='good'),'UNRESOLVED'),(dict(engine_result='NOT_APPLICABLE'),'UNRESOLVED')):\n            self.assertEqual(simulate(check,{'c:/B':second}),want)\n        self.assertEqual(simulate(check,{'c:/A':dict(stdout='good'),'c:/B':dict(engine_result='NOT_APPLICABLE')}),'NOT_APPLICABLE')\n\n    def test_review_reconciles_exact_existing_ids(self):\n        rows=[r for r in registry() if r['implementation']=='candidate']\n        self.assertEqual({r['sca_id'] for r in rows},{900000+n for n in definitions()})\n        self.assertEqual(len(rows),53)\n        self.assertTrue(all(r['execution_review']=='blocked' for r in rows))\n        self.assertTrue(all('Q1-01' in r['issue_ids'] for r in rows))\n        self.assertEqual(sum(r['coverage']=='full' for r in rows),0)\n\n    def test_all_raw_pass_never_becomes_verified_compliance(self):\n        snapshot=self.snapshot()\n        snapshot['hosts'][0]['checks']=[dict(id=900000+n,result='passed') for n in definitions()]\n        rows=normalize(snapshot,NOW);summary=metrics(rows)\n        self.assertEqual(summary['counts'].get('PASS',0),0)\n        self.assertEqual(summary['completeness'],0)\n        self.assertEqual(summary['raw_observed'],53)\n        self.assertFalse(any(r['verified_compliance'] for r in rows))\n        self.assertEqual(sum(r['state']=='NOT_SCANNED' for r in rows if r['raw_result'] is not None),0)\n\n    def test_missing_backup_and_service_are_pending_errors_are_errors(self):\n        for n in (53,54,55,56,57,58,59,60,30,94,97,98,245):\n            for evidence,want in (('missing','MANUAL_PENDING'),('absence_unverified','MANUAL_PENDING'),('symlink_unresolved','MANUAL_PENDING'),('tool_error','ERROR'),('permission_error','ERROR'),('timeout','ERROR')):\n                snapshot=self.snapshot();snapshot['hosts'][0]['checks']=[dict(id=900000+n,result='failed',evidence_status=evidence,reason='SYNTHETIC metadata only')]\n                row=next(r for r in normalize(snapshot,NOW) if r['sca_id']==900000+n)\n                self.assertEqual((row['state'],row['raw_result']),(want,'failed'))\n                self.assertFalse(row['verified_compliance'])\n\n    def test_synthetic_report_end_to_end_no_complete_elevation(self):\n        snapshot=self.snapshot()\n        with tempfile.TemporaryDirectory() as directory:\n            summary=render(snapshot,directory,NOW)\n            self.assertEqual(summary['raw_observed'],6)\n            self.assertEqual(summary['verified_decided'],0)\n            self.assertEqual(summary['completeness'],0)\n            self.assertEqual(json.loads((Path(directory)/'snapshot.json').read_text()),snapshot)\n            self.assertIn('verified_compliance',(Path(directory)/'report.csv').read_text(encoding='utf-8-sig'))\n\n    def test_all_service_states_preserve_raw_distinctions(self):\n        from linuxgcb.batch1 import SERVICES, DISABLED_SERVICES\n        fixtures=json.loads((ROOT/'tests/fixtures/rule_outputs.json').read_text())['checks']\n        for n in set(SERVICES)|{243,245}:\n            base=fixtures[str(900000+n)]['positive']\n            # FIX-1 停用組的完整狀態矩陣移至 test_fix1；此處保留啟用組。\n            states = {'LoadState':['not-found','error','bad-setting'],\n                                'ActiveState':['active','inactive','failed','activating'],\n                                'UnitFileState':['enabled','disabled','masked','masked-runtime','enabled-runtime','static','alias','indirect']}\n            for prop,values in ({} if n in DISABLED_SERVICES else states).items():\n                target=next(k for k in base if '--property='+prop in k)\n                expected=base[target]['stdout']\n                for value in values:\n                    obs=copy.deepcopy(base);obs[target]['stdout']=prop+'='+value\n                    self.assertEqual(simulate(self.check(n),obs),'PASS' if obs[target]['stdout']==expected else 'FAIL')\n            # 查詢 .service 沒有 socket、alias 與原子快照證據；不得計完整符合。\n            snapshot=self.snapshot();snapshot['hosts'][0]['checks']=[dict(id=900000+n,result='passed')]\n            row=next(r for r in normalize(snapshot,NOW) if r['sca_id']==900000+n)\n            self.assertEqual(row['state'],'MANUAL_PENDING')\nimport json\nimport unittest\nfrom pathlib import Path\nfrom linuxgcb.catalog import ROOT, registry, digest, XLSX_HASH\nfrom linuxgcb.policy import validate, simulate, definitions\nfrom linuxgcb.batch1 import FILES, ADDED\nfrom linuxgcb.coverage import manifest\nfrom scripts.inventory import extract\n\n\nclass CatalogTests(unittest.TestCase):\n    def test_scope_and_source_unchanged(self):\n        rows = registry()\n        self.assertEqual((len(rows), sum(r['included'] for r in rows)), (314,307))\n        self.assertEqual(len({r['sca_id'] for r in rows}),314)\n        self.assertEqual(len({r['gcb_id'] for r in rows}),314)\n        self.assertEqual({r['source_sheet'] for r in rows if not r['included']}, {'Nftables防火牆'})\n        self.assertTrue(next(r for r in rows if r['sca_id']==900245)['included'])\n        self.assertFalse(any(r['gcb_id'].endswith('-0180') for r in rows))\n        self.assertEqual(digest(next(ROOT.glob('*.xlsx'))), XLSX_HASH)\n        self.assertEqual(rows,json.loads((ROOT/'data/scope_registry.json').read_text()))\n\n    def test_raw_controls_unchanged(self):\n        self.assertEqual(extract(next(ROOT.glob('*.xlsx'))),json.loads((ROOT/'data/controls.json').read_text()))\n\n    def test_traceability(self):\n        source = {r['gcb_id']:r for r in extract(next(ROOT.glob('*.xlsx')))}\n        for r in registry():\n            self.assertEqual(r['source_row'],source[r['gcb_id']]['row'])\n            self.assertEqual(r['expected'],source[r['gcb_id']]['expected'])\n            self.assertEqual(r['review_status'],'human_review_pending')\n\n    def test_structural(self):\n        self.assertEqual(validate(),len(definitions()))\n\n    def test_all_positive_negative_missing_error(self):\n        fixtures=json.loads((ROOT/'tests/fixtures/rule_outputs.json').read_text())\n        self.assertEqual(fixtures['label'],'SYNTHETIC TEST ONLY')\n        checked = set()\n        for p in (ROOT/'policies').glob('*.yml'):\n            for c in json.loads(p.read_text())['checks']:\n                checked.add(str(c['id']))\n                for name, state in [('positive','PASS'),('negative','FAIL'),('missing','UNRESOLVED'),('empty','FAIL'),('error','UNRESOLVED'),('nonzero_matching','PASS')]:\n                    with self.subTest(id=c['id'],case=name):\n                        self.assertEqual(simulate(c,fixtures['checks'][str(c['id'])][name]),state)\n        self.assertEqual(checked,set(fixtures['checks']))\n\n    def test_permission_bit_subset_and_special_bits(self):\n        c=next(c for c in json.loads((ROOT/'policies/linuxgcb_base.yml').read_text())['checks'] if c['id']==900046)\n        target=c['rules'][0].split(' -> ')[0]\n        for mode in range(0o10000):\n            expected='PASS' if mode & ~0o644 == 0 else 'FAIL'\n            self.assertEqual(simulate(c,{target:dict(stdout=format(mode,'o'),exit_code=0)}),expected)\n\n    def test_exit_code_does_not_override_matching_output(self):\n        c=next(c for c in json.loads((ROOT/'policies/linuxgcb_base.yml').read_text())['checks'] if c['id']==900045)\n        target=c['rules'][0].split(' -> ')[0]\n        self.assertEqual(simulate(c,{target:dict(stdout='0:0',exit_code=1)}),'PASS')\n\n    def test_batch_manifest_reconciles_and_docx(self):\n        m=manifest();rows=registry()\n        self.assertEqual({e['sca_id'] for e in m['reviewed']},{900000+n for n in definitions()})\n        self.assertEqual(m['counts']['implemented'],len(definitions()))\n        self.assertEqual(m['counts']['remaining'],307-len(definitions()))\n        self.assertEqual(m['counts']['full']+m['counts']['partial']+m['counts']['blocked'],len(definitions()))\n        self.assertEqual((m['counts']['full'],m['counts']['partial'],m['counts']['blocked']),(0,48,5))\n        for e in m['reviewed']:\n            self.assertTrue(all(e['expected'] == c[-1] for c in e['docx_all_cells']))\n            self.assertTrue(all(e['gcb_id'] in c for c in e['docx_all_cells']))\n            n=e['sca_id']-900000\n            method=e['docx_cells'][-2]\n            if n in FILES:\n                self.assertIn(FILES[n][0],method)\n\n    def test_all_mode_masks_exhaustive(self):\n        from linuxgcb.batch1 import mode_pattern\n        import re\n        masks={v for _,kind,v in FILES.values() if kind=='mode'}\n        for mask in masks:\n            pattern=re.compile(mode_pattern(mask))\n            for value in range(0o10000):\n                self.assertEqual(bool(pattern.search(format(value,'o'))),value & ~mask == 0)\n\n    def test_batch_edges_use_emitted_rules(self):\n        import copy\n        checks={c['id']:c for p in (ROOT/'policies').glob('*.yml') for c in json.loads(p.read_text())['checks']}\n        fixtures=json.loads((ROOT/'tests/fixtures/rule_outputs.json').read_text())['checks']\n        for n in sorted(ADDED):\n            check=checks[900000+n];base=fixtures[str(900000+n)]['positive']\n            # 每個子規則必須獨立參與 all；非第一個錯誤亦不可被第一個 PASS 掩蓋。\n            for target in base:\n                obs=copy.deepcopy(base);obs[target]['stdout']='WRONG'\n                self.assertEqual(simulate(check,obs),'FAIL')\n                obs=copy.deepcopy(base);obs[target]['stdout']+='\\nWRONG'\n                self.assertEqual(simulate(check,obs),'PASS') # SCA 逐行存在匹配，不是整個輸出相等\n            if n in FILES:\n                path,kind,value=FILES[n]\n                if kind=='owner':\n                    target='c:/usr/bin/stat -c %U:%G '+path\n                    for owner in ('root:shadow','root:wheel','nobody:root','root:UNKNOWN'):\n                        obs=copy.deepcopy(base);obs[target]['stdout']=owner\n                        self.assertEqual(simulate(check,obs),'PASS' if owner=='root:shadow' and 'shadow' in value else 'FAIL')\n                type_target='c:/usr/bin/stat -c %f '+path\n                if type_target in base:\n                    for mode in ('81a4','a1ff','11a4','21a4','61a4','c1a4'):\n                        obs=copy.deepcopy(base);obs[type_target]['stdout']=mode\n                        self.assertEqual(simulate(check,obs),'FAIL')\n            from linuxgcb.batch1 import SERVICES,PACKAGES\n            if n in SERVICES:\n                target=next(t for t in base if 'UnitFileState' in t)\n                for value in ('enabled-runtime','static','alias','not-found'):\n                    obs=copy.deepcopy(base);obs[target]['stdout']='UnitFileState='+value\n                    self.assertEqual(simulate(check,obs),'FAIL')\n                obs=copy.deepcopy(base)\n                target=next(t for t in base if 'LoadState' in t);obs[target]['stdout']='LoadState=not-found'\n                self.assertEqual(simulate(check,obs),'PASS' if n in (30,94,97,98,101) else 'FAIL')\n            if n in PACKAGES:\n                obs=copy.deepcopy(base);target=next(iter(base));obs[target]['stdout']='package missing is not installed'\n                obs[target]['exit_code']=1\n                self.assertEqual(simulate(check,obs),'FAIL')\n\n    def test_documented_file_and_all_semantics(self):\n        check=dict(condition='all',rules=['f:/SYNTHETIC -> r:^ID=rhel$'])\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(exists=False)}),'NOT_APPLICABLE')\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(stdout='')}),'FAIL')\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(error='permission denied')}),'UNRESOLVED')\n        check['rules'].append('c:/SYNTHETIC -> r:^good$')\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(exists=False),'c:/SYNTHETIC':dict(stdout='bad')}),'FAIL')\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(exists=False),'c:/SYNTHETIC':dict(stdout='good')}),'NOT_APPLICABLE')\n        self.assertEqual(simulate(check,{'c:/SYNTHETIC':dict(stdout='bad')}),'FAIL')\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc 'find .. -name AGENTS.md -print; cat tests/test_snapshot.py | head -70; cat linuxgcb/collector.py | head -130; cat scripts/inventory.py | head -110'","aggregated_output":"../open-slide-demo/AGENTS.md\nfind: ‘../soar-poc-candidate-p1/.scratch/p2’: Permission denied\nfind: ‘../soar-poc-candidate-p1/.scratch/w4b-live’: Permission denied\n\"\"\"REAL EVIDENCE agent010 R2；變異僅為記憶體中 test-only 負面測試。\"\"\"\nimport copy\nimport csv\nimport json\nimport tempfile\nimport unittest\nfrom collections import Counter\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom linuxgcb.catalog import ROOT, digest\nfrom linuxgcb.snapshot import convert, LABEL\nfrom linuxgcb.report import normalize, render\n\nFIXTURE = ROOT/'tests/fixtures/realhost_r2.json'\nFAIL_IDS = {900192,900194,900196,900198,900200,900202,900269}\nNOW = datetime(2026,10,31,6,tzinfo=timezone.utc)\n\n\nclass SnapshotTests(unittest.TestCase):\n    def test_real_evidence_roundtrip(self):\n        original = json.loads(FIXTURE.read_text())\n        s = convert(FIXTURE)\n        self.assertFalse(s['synthetic'])\n        self.assertEqual(s['label'], LABEL)\n        self.assertEqual(s['manager_dump_sha256'], digest(FIXTURE))\n        host = s['hosts'][0]\n        self.assertIsNone(host['scanned_at'])\n        self.assertEqual(len(s['warnings']),3)\n        self.assertEqual(Counter(c['result'] for c in host['checks']), {'passed':46,'failed':7})\n        for c in host['checks']:\n            self.assertEqual({k:v for k,v in c.items() if k not in ('policy_id', 'expected', 'expected_status')}, next(x for x in original[c['policy_id']]['checks'] if x['id']==c['id']))\n        with tempfile.TemporaryDirectory() as d:\n            summary=render(s,d,NOW)\n            self.assertEqual(summary['counts']['FAIL'],7)\n            self.assertEqual(summary['verified_decided'],0)\n            self.assertIsNone(summary['pass_rate'])\n            self.assertEqual(summary['completeness'],0)\n            with (Path(d)/'report.csv').open(encoding='utf-8-sig',newline='') as f:\n                failures=[r for r in csv.DictReader(f) if r['state']=='FAIL']\n            self.assertEqual({int(r['sca_id']) for r in failures},FAIL_IDS)\n            page=(Path(d)/'report.html').read_text()\n            for r in failures:\n                self.assertIn(r['gcb_id'],page)\n                self.assertTrue(r['title'])\n                self.assertTrue(r['command'])\n                self.assertEqual(r['remediation_status'],'政策未提供 remediation')\n            self.assertIn(LABEL,page)\n    def test_scan_info_time_and_invalid_results(self):\n        dump=json.loads(FIXTURE.read_text())\n        info={pid:{'end_scan':'2026-10-31T12:03:00+08:00'} for pid in dump}\n        s=convert(FIXTURE,info)\n        self.assertEqual(s['hosts'][0]['scanned_at'],'2026-10-31T04:03:00+00:00')\n        self.assertFalse(s['warnings'])\n        for result in ('invalid','error','unexpected'):\n            modified=copy.deepcopy(s)\n            c=modified['hosts'][0]['checks'][0]\n            c.update(result=result,reason='test-only raw reason')\n            row=next(r for r in normalize(modified,NOW) if r['sca_id']==c['id'])\n            self.assertEqual(row['state'],'ERROR')\n            self.assertEqual(row['raw_result'],result)\n            self.assertEqual(row['raw_reason'],'test-only raw reason')\n    def test_invalid_time_rejected(self):\n        pid=next(iter(json.loads(FIXTURE.read_text())))\n        with self.assertRaises(ValueError):\n            convert(FIXTURE,{pid:{'end_scan':'2026-10-31T12:03:00'}})\n\"\"\"Manager SCA 唯讀收集抽象；無網路實作、憑證、排程或發佈副作用。\"\"\"\nimport copy\nimport hashlib\nimport json\nfrom datetime import datetime, timezone\nfrom urllib.parse import quote\n\n\nclass CollectionError(ValueError):\n    pass\n\n\ndef timestamp(value):\n    t = datetime.fromisoformat(str(value).replace('Z', '+00:00'))\n    if t.tzinfo is None:\n        raise CollectionError('時間缺少時區，須先依已驗證 API schema 正規化')\n    return t.astimezone(timezone.utc)\n\n\nclass Collector:\n    \"\"\"transport.get(path, params) -> Wazuh data envelope。\n\n    未來 transport 必須啟用 TLS 憑證與 hostname 驗證及逾時；此版只注入離線 fake。\n    完整快照是回傳值；失敗以例外拒絕回傳，不發佈部分頁面。\n    \"\"\"\n    def __init__(self, transport, page_size=100, max_pages=10000):\n        if page_size < 1 or max_pages < 1:\n            raise ValueError('分頁界限必須為正數')\n        self.transport, self.page_size, self.max_pages = transport, page_size, max_pages\n\n    def pages(self, path):\n        items, raw, expected, offset = [], [], None, 0\n        for _ in range(self.max_pages):\n            try:\n                response = copy.deepcopy(self.transport.get(path, {'offset': offset, 'limit': self.page_size}))\n                data = response['data']\n                batch, total = data['affected_items'], data['total_affected_items']\n                if response.get('error', 0) or data.get('total_failed_items', 0) or data.get('failed_items'):\n                    raise CollectionError('API 部分失敗')\n                if not isinstance(total, int) or isinstance(total, bool) or total < 0 or not isinstance(batch, list):\n                    raise CollectionError('分頁 schema 錯誤')\n                if expected is None:\n                    expected = total\n                if total != expected or len(batch) > self.page_size or len(items)+len(batch) > total:\n                    raise CollectionError('分頁總數不一致')\n                raw.append(response)\n                items.extend(batch)\n                if len(items) == total:\n                    return items, raw\n                if not batch:\n                    raise CollectionError('分頁提早結束')\n                offset += len(batch)\n            except CollectionError:\n                raise\n            except Exception as e:\n                raise CollectionError('API/transport 讀取失敗') from e\n        raise CollectionError('超出最大頁數')\n\n    def collect(self, agent_id, policy_id, policy_hash, now=None, max_age_seconds=86400):\n        if not agent_id or not policy_id or not policy_hash or max_age_seconds < 0:\n            raise CollectionError('缺少識別、政策 hash 或時效設定錯誤')\n        now = now or datetime.now(timezone.utc)\n        if now.tzinfo is None:\n            raise CollectionError('擷取時間缺時區')\n        path = '/sca/'+quote(str(agent_id), safe='')\n        before, raw_before = self.pages(path)\n        def select(rows):\n            found = [r for r in rows if str(r.get('policy_id')) == policy_id]\n            if len(found) != 1:\n                raise CollectionError('政策不存在或重複')\n            return found[0]\n        summary = select(before)\n        try:\n            start, end = timestamp(summary['start_scan']), timestamp(summary['end_scan'])\n            if start > end or end > now:\n                raise CollectionError('掃描進行中或時間不合理')\n            if summary['hash_file'] != policy_hash:\n                raise CollectionError('政策 hash 不符')\n            expected_count = summary['total_checks']\n            if not isinstance(expected_count, int) or isinstance(expected_count, bool) or expected_count < 1:\n                raise CollectionError('摘要控制項數量不合法')\n        except (KeyError, TypeError, ValueError) as e:\n            raise CollectionError('摘要缺少已驗證掃描時間/hash/數量') from e\n        checks, raw_checks = self.pages(path+'/checks/'+quote(policy_id, safe=''))\n        ids = [str(c.get('id')) for c in checks]\n        if len(checks) != expected_count or len(set(ids)) != len(ids) or 'None' in ids:\n            raise CollectionError('控制項缺漏或重複')\n        after, raw_after = self.pages(path)\n        if summary != select(after):\n            raise CollectionError('掃描摘要變更；丟棄快照，呼叫端可有限次重試')\n        canonical = json.dumps(dict(agent_id=agent_id, policy_id=policy_id, summary=summary,\n            policy_hash=policy_hash, checks=sorted(checks, key=lambda c: str(c['id']))), sort_keys=True, separators=(',', ':'))\n        return dict(snapshot_id=hashlib.sha256(canonical.encode()).hexdigest(), agent_id=agent_id,\n                    policy_id=policy_id, policy_hash=policy_hash, summary=summary, checks=checks,\n                    collected_at=now.isoformat(), stale=(now-end).total_seconds() > max_age_seconds,\n                    complete=True, raw_pages=dict(before=raw_before, checks=raw_checks, after=raw_after))\n#!/usr/bin/env python3\n\"\"\"Read XLSX with stdlib; preserve source cells and inventory GCB IDs.\"\"\"\nimport collections\nimport hashlib\nimport json\nfrom pathlib import Path\nimport re\nimport zipfile\nimport xml.etree.ElementTree as ET\n\nROOT = Path(__file__).resolve().parents[1]\nNS = {'s': 'http://schemas.openxmlformats.org/spreadsheetml/2006/main'}\n\ndef extract(path):\n    records = []\n    with zipfile.ZipFile(path) as z:\n        strings = []\n        if 'xl/sharedStrings.xml' in z.namelist():\n            strings = [''.join(n.itertext()) for n in ET.fromstring(z.read('xl/sharedStrings.xml')).findall('s:si', NS)]\n        rels = {r.attrib['Id']: r.attrib['Target'] for r in ET.fromstring(z.read('xl/_rels/workbook.xml.rels'))}\n        wb = ET.fromstring(z.read('xl/workbook.xml'))\n        for sheet in wb.findall('s:sheets/s:sheet', NS):\n            rid = sheet.attrib['{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id']\n            target = rels[rid]\n            target = target.lstrip('/') if target.startswith('/') else 'xl/' + target\n            for row in ET.fromstring(z.read(target)).findall('s:sheetData/s:row', NS):\n                cells = {}\n                for c in row.findall('s:c', NS):\n                    match = re.match(r'[A-Z]+', c.attrib['r'])\n                    if match is None:\n                        raise ValueError('Invalid XLSX cell reference')\n                    col = match.group()\n                    v = c.find('s:v', NS)\n                    value = (v.text or '') if v is not None else ''\n                    if c.attrib.get('t') == 's':\n                        value = strings[int(value)]\n                    elif c.attrib.get('t') == 'inlineStr':\n                        value = ''.join(t.text or '' for t in c.findall('.//s:t', NS))\n                    cells[col] = value\n                if re.fullmatch(r'TWGCB-\\d{2}-\\d{3}-\\d{4}', cells.get('B', '')):\n                    records.append(dict(source_file=path.name, sheet=sheet.attrib['name'], row=int(row.attrib['r']),\n                        ordinal=cells.get('A'), gcb_id=cells['B'], category=cells.get('C'), title=cells.get('D'),\n                        description=cells.get('E'), configuration_method=cells.get('F'), expected=cells.get('G'),\n                        implementation_status='unreviewed'))\n    return records\n\ndef main():\n    sources = sorted(ROOT.glob('*.xlsx'))\n    records = [r for p in sources for r in extract(p)]\n    counts = collections.Counter(r['gcb_id'] for r in records)\n    summary = dict(total=len(records), unique_ids=len(counts), duplicate_ids=[k for k,v in counts.items() if v>1],\n        categories=dict(collections.Counter(r['category'] for r in records)),\n        sheets=dict(collections.Counter(r['sheet'] for r in records)),\n        missing_required=[r['gcb_id'] for r in records if not all(r.get(k) for k in ('title','category','expected'))],\n        source_sha256={p.name:hashlib.sha256(p.read_bytes()).hexdigest() for p in sources})\n    out = ROOT/'data'\n    out.mkdir(exist_ok=True)\n    (out/'controls.json').write_text(json.dumps(records,ensure_ascii=False,indent=2)+'\\n')\n    (out/'inventory.json').write_text(json.dumps(summary,ensure_ascii=False,indent=2)+'\\n')\n    print(json.dumps(summary,ensure_ascii=False,indent=2))\n    assert records and not summary['duplicate_ids'] and not summary['missing_required']\n\nif __name__ == '__main__':\n    main()\n","exit_code":0,"status":"completed"}}

tern):\n        raise ValueError('未驗證的 PCRE2 語法')\n    try:\n        return target, re.compile(pattern, re.ASCII)\n    except re.error as exc:\n        raise ValueError('無效模式') from exc\n''' + s[b:]\ns=s.replace('    for target, pattern in parsed:', '    for rule, (target, pattern) in zip(check[\\\\'rules\\\\'], parsed):')\ns=s.replace(\\\"        elif obs.get('engine_result')\\\", \\\"        elif rule in batch2_emitted() and obs.get('exit_code', 0) \"'!= 0:'\"\\\\n            outcomes.append('UNRESOLVED')\\\\n        elif obs.get('engine_result')\\\")\ns=s.replace(\\\"            outcomes.append('PASS' if any(pattern.search(line) for line in obs['stdout'].split('\\\\\\\\n')) else 'FAIL')\\\", \\\"            matched = any(pattern.search(line) for line in obs['stdout'].split('\\\\\\\\n'))\\\\n            if ' -> \"'!r:'\"' in rule:\\\\n                matched = not matched\\\\n            outcomes.append('PASS' if matched else 'FAIL')\\\")\n# Exact allowlist construction is fixed, cache it (old exhaustive permission tests call parser 4096 times).\ns=s.replace('def batch2_emitted():','@lru_cache(maxsize=1)\\\\ndef batch2_emitted():')\nopen(p,'w').write(s)\np='linuxgcb/coverage.py';s=open(p).read().replace('from .quality import status','from .quality import status\\\\nfrom .batch2 import ADDED as BATCH2, caveat as batch2_caveat')\ns=s.replace(\\\"mechanism='原生 c: 絕對路徑、正向逐行 PCRE2、all 聚合；無 shell',\\\", \\\"mechanism=('BATCH2 c: shell 成功輸出保護、正向/否定逐行 PCRE2、all 聚合' if n in BATCH2 else '原生 c: 絕對路徑、正向逐行 PCRE2、all 聚合；無 shell'),\\\")\ns=s.replace(\\\"caveats=caveat(n) if n in ADDED else row['pending']\\\", \\\"caveats=batch2_caveat(n) if n in BATCH2 else caveat(n) if n in ADDED else row['pending']\\\")\ns=s.replace(\\\"added=len(ADDED)\\\",\\\"added=len(ADDED)+len(BATCH2),batch2_added=len(BATCH2)\\\")\nopen(p,'w').write(s)\nPY\npython3 -m linuxgcb build\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

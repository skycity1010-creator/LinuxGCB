{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"rg -n '\"'!r:|negat|single|quote|shell|exit|command'\"' docs/references/creating-custom-policies.md | head -65; git diff --stat; sed -n '1,65p' tests/test_fix1.py; rg '53|48|46|policy_hashes' tests -g '*.py'\"","aggregated_output":"64:      - 'f:$sshd_file -> !r:^# && r:Port && !r:\\s*\\t*22$'\n192:Rules can check for the existence of files, directories, registry keys and values, running processes, and recursively test for the existence of files inside directories. When it comes to content checking, they are able to check for file contents, recursively check for the contents of files inside directories, command output, and registry value data.\n194:Abstractly, rules start with a location and a type of location that is the target of the test, followed by the actual test specification. Such tests fall into two categories: existence and content checks. The type of location is listed in the [Rule types](https://documentation.wazuh.com/current/user-manual/capabilities/sec-config-assessment/creating-custom-policies.html#rule-types) table below, and the location could be a file name, directory, process name, command, or a registry key.\n231:You can place `not` at the beginning of a rule to negate it. For example:\n292:Content check operator results can be negated by adding a `!` before then, for example:\n297:f:/etc/ssh_config -> !r:PermitRootLogin\n302:Be careful when negating content operators as that makes them evaluate as **Passed** for anything that does not match with the check specified. For example, rule `f:/etc/ssh_config -> !r:PermitRootLogin` is evaluated as Passed if it finds any line that does not contain `PermitRootLogin`.\n309:f:/etc/ssh_config -> !r:^# && r:Protocol && r:2\n323:- `c:systemctl is-enabled cups -> r:^enabled` checks that the output of the command contains a line starting with enabled.\n365:##### Rule syntax for commands [Permalink to this headline](https://documentation.wazuh.com/current/user-manual/capabilities/sec-config-assessment/creating-custom-policies.html\\#rule-syntax-for-commands \"Permalink to this headline\")\n367:- Check the output of a command `c:command -> output`\n369:- Check the output of a command using regex `c:command -> r:REGEX`\n371:- Check a numeric value `c:command -> n:REGEX_WITH_A_CAPTURE_GROUP compare >= number`\n385:- Check if there is a line that does not begin with `#` and contains `Port 22``f:/etc/ssh/sshd_config -> !r:^# && r:Port\\.+22`\n387:- Check if there is no line that does not begin with `#` and contains `Port 22``not f:/etc/ssh/sshd_config -> !r:^# && r:Port\\.+22`\n404:- Check the running configuration of sshd for the maximum authentication tries allowed: `c:sshd -T -> !r:^\\s*maxauthtries\\s+4\\s*$`\n406:- Check if root is the only account with UID 0: `f:/etc/passwd -> !r:^# && !r:^root: && r:^\\w+:\\w+:0:`\n data/coverage_manifest.json      | 3536 ++++++++++++++++++++++++++++++++------\n data/policy_hashes.json          |    4 +-\n data/scope_registry.json         |  924 ++++++----\n linuxgcb/catalog.py              |    2 +\n linuxgcb/coverage.py             |   13 +-\n linuxgcb/expected.py             |    4 +\n linuxgcb/policy.py               |   43 +-\n linuxgcb/quality.py              |    6 +\n policies/linuxgcb_base.yml       |  304 ++++\n policies/linuxgcb_sshd.yml       |  517 ++++++\n tests/fixtures/rule_outputs.json | 2454 ++++++++++++++++++++++++++\n tests/fixtures/snapshot.json     |    4 +-\n tests/test_catalog_policy.py     |    5 +-\n tests/test_expected.py           |    2 +\n tests/test_quality_q1.py         |    4 +-\n 15 files changed, 6998 insertions(+), 824 deletions(-)\n\"\"\"SYNTHETIC TEST ONLY: output fixtures; never execute policy commands.\"\"\"\nimport copy\nimport itertools\nimport json\nimport unittest\n\nfrom linuxgcb.batch1 import DISABLED_SERVICES\nfrom linuxgcb.catalog import ROOT\nfrom linuxgcb.policy import simulate\n\n\nclass Fix1Tests(unittest.TestCase):\n    def setUp(self):\n        self.checks = {c['id']: c for p in (ROOT/'policies').glob('*.yml')\n                       for c in json.loads(p.read_text())['checks']}\n        self.fixtures = json.loads((ROOT/'tests/fixtures/rule_outputs.json').read_text())\n\n    def test_named_service_cases_use_emitted_all_rules(self):\n        self.assertEqual(self.fixtures['label'], 'SYNTHETIC TEST ONLY')\n        for n in DISABLED_SERVICES:\n            check = self.checks[900000+n]\n            self.assertEqual(check['condition'], 'all')\n            cases = self.fixtures['checks'][str(900000+n)]\n            for name, want in [('not_found', 'PASS'), ('installed_enabled', 'FAIL'),\n                               ('installed_disabled_inactive', 'PASS'),\n                               ('installed_masked', 'PASS'), ('empty', 'FAIL'),\n                               ('error', 'UNRESOLVED'), ('missing', 'UNRESOLVED')]:\n                with self.subTest(id=check['id'], case=name):\n                    self.assertEqual(simulate(check, cases[name]), want)\n\n    def test_every_service_state_and_samba_member(self):\n        # Mutate each Samba member separately: smb PASS cannot hide unsafe nmb.\n        for n, units in DISABLED_SERVICES.items():\n            check = self.checks[900000+n]\n            base = self.fixtures['checks'][str(900000+n)]['positive']\n            for unit in units:\n                cmd = 'c:/usr/bin/systemctl show '+unit+'.service'\n                for load, state, active in itertools.product(\n                    ('loaded', 'masked', 'error', 'bad-setting'),\n                    ('disabled', 'masked', 'enabled', 'enabled-runtime',\n                     'static', 'alias', 'indirect', 'masked-runtime', ''),\n                    ('inactive', 'active', 'failed', 'activating', 'deactivating')):\n                    obs = copy.deepcopy(base)\n                    obs[cmd+' --property=LoadState']['stdout'] = 'LoadState='+load\n                    obs[cmd+' --property=ActiveState']['stdout'] = 'ActiveState='+active\n                    obs[cmd+' --property=LoadState --property=UnitFileState']['stdout'] = (\n                        'LoadState='+load+'\\nUnitFileState='+state)\n                    want = ('PASS' if load in ('loaded', 'masked') and\n                            state in ('disabled', 'masked') and active == 'inactive' else 'FAIL')\n                    with self.subTest(id=check['id'], unit=unit, load=load, state=state, active=active):\n                        self.assertEqual(simulate(check, obs), want)\n                for active in ('inactive', 'active', 'failed', 'activating'):\n                    obs = copy.deepcopy(base)\n                    obs[cmd+' --property=LoadState']['stdout'] = 'LoadState=not-found'\n                    obs[cmd+' --property=ActiveState']['stdout'] = 'ActiveState='+active\n                    # Missing properties may be omitted by systemctl show.\n                    for suffix in ('', '\\nUnitFileState='):\n                        obs[cmd+' --property=LoadState --property=UnitFileState']['stdout'] = 'LoadState=not-found'+suffix\n                        self.assertEqual(simulate(check, obs), 'PASS' if active == 'inactive' else 'FAIL')\n\n    def test_absence_requires_explicit_stdout_and_errors_stay_unresolved(self):\n        for n in DISABLED_SERVICES:\n            check = self.checks[900000+n]\n            cases = self.fixtures['checks'][str(900000+n)]\n            for key in cases['positive']:\ntests/test_quality_q1.py:        self.assertEqual(len(rows),53)\ntests/test_quality_q1.py:        for n in (53,54,55,56,57,58,59,60,30,94,97,98,245):\ntests/test_report.py:        self.assertTrue(by[900046]['exception_approved'])\ntests/test_report.py:        self.assertEqual(by[900046]['state'],'FAIL')\ntests/test_report.py:        h['not_applicable']={f'TWGCB-01-012-{n:04d}':copy.deepcopy(approved) for n in (45,46,243)}\ntests/test_report.py:        self.assertEqual(by[900046]['state'],'FAIL')\ntests/test_report.py:        mutations=[lambda s:s.update(source_sha256='bad'),lambda s:s.update(policy_hashes={}),\ntests/test_report.py:            bad=next(r for r in rows if r['sca_id']=='900046')\ntests/test_snapshot.py:        self.assertEqual(Counter(c['result'] for c in host['checks']), {'passed':46,'failed':7})\ntests/test_expected.py:    def test_all_53_source_values_and_q1_preserved(self):\ntests/test_expected.py:        self.assertEqual(len(checks), 53)\ntests/test_expected.py:                self.assertEqual(len(observed), 53)\ntests/test_catalog_policy.py:        c=next(c for c in json.loads((ROOT/'policies/linuxgcb_base.yml').read_text())['checks'] if c['id']==900046)\ntests/test_catalog_policy.py:        self.assertEqual((m['counts']['full'],m['counts']['partial'],m['counts']['blocked']),(0,48+len(BATCH2),5))\n","exit_code":0,"status":"completed"}}

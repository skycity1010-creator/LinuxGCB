r -s tests -v > docs/BATCH2_TEST_OUTPUT.txt 2>&1\npython3 -m linuxgcb build >> docs/BATCH2_TEST_OUTPUT.txt 2>&1\npython3 -m linuxgcb validate >> docs/BATCH2_TEST_OUTPUT.txt 2>&1\ngit diff --check\ntail -8 docs/BATCH2_TEST_OUTPUT.txt\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

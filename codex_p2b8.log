{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc 'cat linuxgcb/catalog.py linuxgcb/quality.py linuxgcb/policy.py'","aggregated_output":"\"\"\"固定來源、候選範圍與保守分類。\"\"\"\nimport hashlib\nimport json\nfrom pathlib import Path\nfrom scripts.inventory import extract\nfrom .batch1 import ADDED\nfrom .quality import status\nfrom .batch3 import ADDED as BATCH3\nfrom .batch6 import ADDED as BATCH6\nfrom .batch7 import ADDED as BATCH7\nfrom .batch2 import ADDED as BATCH2\n\nROOT = Path(__file__).resolve().parents[1]\nXLSX_HASH = '7d752b639a1e780df08814c6252efadd3ea2711eaa5c9d91c070b84a296c0247'\nDOCX_HASH = '986effd9501b1fd97776129c6691cf8fc98246bd04514347322f3337508e0e5b'\nIMPLEMENTED = {45: 'base', 46: 'base', 108: 'base', 243: 'firewalld',\n               245: 'firewalld', 269: 'sshd', 270: 'sshd'}\nIMPLEMENTED.update({n: ('sshd' if n in (256,257) else 'firewalld' if n==242 else 'base') for n in ADDED})\nIMPLEMENTED.update({n: ('sshd' if n >= 254 else 'base') for n in BATCH2})\nIMPLEMENTED.update({n: 'base' for n in BATCH3})\nIMPLEMENTED.update({n: 'base' for n in BATCH6})\nIMPLEMENTED.update({n: 'base' for n in BATCH7})\nPARTIAL = {141: '僅來源設定方法明列 audit.rules；其餘 rules.d 規則檔集合尚未覆蓋',\n           108: '僅雙協定即時值；持久設定來源、覆寫順序與路由角色待審',\n           269: '僅 sshd -T 預設情境；Include/Match 與使用者/來源矩陣待審',\n           270: '僅 sshd -T 預設情境；Include/Match 與使用者/來源矩陣待審'}\n\n\ndef digest(path):\n    return hashlib.sha256(path.read_bytes()).hexdigest()\n\n\ndef registry():\n    source = next(ROOT.glob('*.xlsx'))\n    docx = next(ROOT.glob('*.docx'))\n    if digest(source) != XLSX_HASH or digest(docx) != DOCX_HASH:\n        raise ValueError('來源 hash 改變，停止產生')\n    records = extract(source)\n    result = []\n    for r in records:\n        n = int(r['gcb_id'][-4:])\n        included = r['sheet'] != 'Nftables防火牆'\n        profile = ('firewalld' if r['sheet'] == 'Firewalld防火牆' else\n                   'sshd' if r['sheet'] == 'SSH伺服器' else 'base')\n        if n in IMPLEMENTED:\n            classification, why = 'native_sca', '候選唯讀原生命令；完整語意與引擎驗收待人工審查'\n        elif profile != 'base' or any(k in r['title'] for k in ('GUI', '無線', '可攜', 'NFS')):\n            classification, why = 'conditional', '須先確認角色、服務與適用性，再選擇實作方式'\n        elif any(k in r['title'] for k in ('權限', '所有權', '擁有', '稽核', '密碼', '通行碼')):\n            classification, why = 'readonly_helper', '可能涉及集合、位元或載入鏈解析；尚未實作 helper'\n        else:\n            classification, why = 'manual_review', '尚未逐條語意審查，保守列人工待辦，非不可自動化結論'\n        result.append(dict(gcb_id=r['gcb_id'], source_file=r['source_file'],\n            source_sheet=r['sheet'], source_row=r['row'], source_sha256=XLSX_HASH,\n            category=r['category'], title=r['title'], expected=r['expected'],\n            included=included, scope_reason='候選，仍須主機適用性核准' if included else '明確排除 Nftables 工作表',\n            sca_id=900000+n, profile=profile, proposed_classification=classification,\n            justification=why, review_status='human_review_pending',\n            implementation='candidate' if n in IMPLEMENTED else 'pending' if included else 'excluded',\n            policy_id='linuxgcb_rhel9_'+IMPLEMENTED[n]+'_v01' if n in IMPLEMENTED else None,\n            coverage='partial' if n in PARTIAL else 'full' if n in IMPLEMENTED else 'unimplemented',\n            live_validation='UNVALIDATED', execution_review='pending',\n            pending=PARTIAL.get(n, '' if n in IMPLEMENTED else '未實作；待逐條 DOCX 語意審查')))\n        if n in IMPLEMENTED:\n            result[-1].update(status(n))\n    if (len(result), sum(r['included'] for r in result), len({r['sca_id'] for r in result}),\n        len({r['gcb_id'] for r in result})) != (314, 307, 314, 314):\n        raise ValueError('範圍或唯一性不符')\n    return result\n\n\ndef write_registry():\n    rows = registry()\n    (ROOT/'data/scope_registry.json').write_text(json.dumps(rows, ensure_ascii=False, indent=2)+'\\n')\n    return rows\n\"\"\"Q1 離線審查結論；只涵蓋原有 53 ID，非來源或真機核准。\"\"\"\nfrom .batch1 import FILES, PACKAGES, SERVICES\nfrom .batch3 import ADDED as BATCH3, caveat as batch3_caveat\nfrom .batch2 import ADDED as BATCH2, caveat as batch2_caveat\n\nfrom .batch6 import ADDED as BATCH6, caveat as batch6_caveat\n\nfrom .batch7 import ADDED as BATCH7, caveat as batch7_caveat\n\nABSENCE_PENDING = {30,94,97,98,245}\n\ndef findings(n):\n    issues = ['Q1-01']  # 非零但匹配 stdout，無已核准的原生執行狀態保護\n    if n in FILES or n in (45,46): issues += ['Q1-03','Q1-04']\n    if n in range(53,61) or n in (141,178,191,192): issues += ['Q1-05']\n    if n in SERVICES or n in (243,245): issues += ['Q1-06']\n    if n in ABSENCE_PENDING: issues += ['Q1-07']\n    if n in (108,141,269,270): issues += ['Q1-08']\n    return issues\n\ndef family(n):\n    if n in FILES or n in (45,46): return '檔案 metadata'\n    if n in PACKAGES: return 'RPM 存在'\n    if n in SERVICES or n in (243,245): return 'systemd 服務'\n    if n == 108: return 'sysctl 即時值'\n    return 'SSH 預設有效設定'\n\ndef status(n):\n    if n in BATCH7:\n        return dict(offline_review='completed_with_findings', execution_review='blocked',\n                    coverage='partial', issue_ids=['B7-ENGINE', 'B7-SOURCE'],\n                    family='P2B7 embedded read-only', source_approval='pending',\n                    live_validation='UNVALIDATED', pending=batch7_caveat(n))\n    if n in BATCH6:\n        return dict(offline_review=\"completed_with_findings\", execution_review=\"blocked\",\n                    coverage=\"partial\", issue_ids=[\"B6-ENGINE\", \"B6-SCOPE\"],\n                    family=\"P2B6 embedded read-only\", source_approval=\"pending\",\n                    live_validation=\"UNVALIDATED\", pending=batch6_caveat(n))\n    if n in BATCH3:\n        return dict(offline_review='completed_with_findings', execution_review='blocked',\n                    coverage='partial', issue_ids=['B3-ENGINE', 'B3-SCOPE'],\n                    family='P2B3 embedded read-only', source_approval='pending',\n                    live_validation='UNVALIDATED', pending=batch3_caveat(n))\n    if n in BATCH2:\n        return dict(offline_review='completed_with_findings', execution_review='blocked',\n                    coverage='partial', issue_ids=['B2-ENGINE', 'B2-SCOPE'],\n                    family='BATCH2 guarded read-only', source_approval='pending',\n                    live_validation='UNVALIDATED', pending=batch2_caveat(n))\n    return dict(offline_review='completed_with_findings',\n                execution_review='blocked',\n                coverage='blocked' if n in ABSENCE_PENDING else 'partial',\n                issue_ids=findings(n), family=family(n),\n                source_approval='pending', live_validation='UNVALIDATED')\n\"\"\"以 JSON（YAML 1.2 子集）產生候選 SCA；只模擬輸出匹配，不執行命令。\"\"\"\nimport json\nimport re\nfrom functools import lru_cache\nfrom .catalog import ROOT, registry, digest\nfrom .batch1 import rules as batch_rules, disabled_service_rules\nfrom .expected import PREFIX, values, parse_description\nfrom .batch2 import rules as batch2_rules, ADDED as BATCH2\nfrom .batch3 import rules as batch3_rules, ADDED as BATCH3\nfrom .batch6 import rules as batch6_rules, ADDED as BATCH6\nfrom .batch7 import rules as batch7_rules, ADDED as BATCH7\nfrom .argv import w_strtok\n\n\ndef definitions():\n    modes = '|'.join(format(n, 'o') for n in range(0o1000) if n & ~0o644 == 0)\n    return {**batch_rules(), **batch2_rules(), **batch3_rules(), **batch6_rules(), **batch7_rules(),\n        45: [('c:/usr/bin/stat -c %u:%g /etc/passwd', '^0:0$')],\n        46: [('c:/usr/bin/stat -c %a /etc/passwd', '^('+modes+')$')],\n        108: [('c:/usr/sbin/sysctl -n net.ipv4.ip_forward', '^0$'),\n              ('c:/usr/sbin/sysctl -n net.ipv6.conf.all.forwarding', '^0$')],\n        243: [('c:/usr/bin/systemctl show firewalld.service --property=LoadState', '^LoadState=loaded$'),\n              ('c:/usr/bin/systemctl show firewalld.service --property=ActiveState', '^ActiveState=active$'),\n              ('c:/usr/bin/systemctl show firewalld.service --property=UnitFileState', '^UnitFileState=enabled$')],\n        245: disabled_service_rules('nftables'),\n        269: [('c:/usr/sbin/sshd -T', '^permitrootlogin no$')],\n        270: [('c:/usr/sbin/sshd -T', '^permitemptypasswords no$')],\n    }\n\n\ndef build():\n    rows = registry()\n    expected = values()\n    for profile in ('base', 'firewalld', 'sshd'):\n        filename = 'linuxgcb_'+profile+'.yml'\n        checks = []\n        for row in rows:\n            if row['implementation'] != 'candidate' or row['profile'] != profile:\n                continue\n            checks.append(dict(id=row['sca_id'], title=row['gcb_id']+' '+row['title'],\n                description=PREFIX+expected[row['gcb_id']]+(' ｜ P2B7 執行審查 ' if row['sca_id']-900000 in BATCH7 else ' ｜ P2B6 執行審查 ' if row['sca_id']-900000 in BATCH6 else ' ｜ P2B3 執行審查 ' if row['sca_id']-900000 in BATCH3 else ' ｜ BATCH2 執行審查 ' if row['sca_id']-900000 in BATCH2 else ' ｜ Q1 執行審查 ')+row['execution_review']+'；coverage='+row['coverage']+'；'+','.join(row['issue_ids'])+'；raw PASS 非已驗證符合。'+row['pending'],\n                compliance=[{'twgcb': [row['gcb_id']]}], regex_type='pcre2', condition='all',\n                rules=[emit_rule(target, pattern) for target, pattern in definitions()[int(row['gcb_id'][-4:])]]))\n        policy = dict(policy=dict(id='linuxgcb_rhel9_'+profile+'_v01', file=filename,\n                      name='RHEL9 GCB v1.2 '+profile+' v0.1 UNVALIDATED',\n                      description='未驗證候選政策；僅供核准 RHEL9 試點，非完整符合性檢核', regex_type='pcre2'),\n                      requirements=dict(title='僅 RHEL 9', description='角色由核准群組控制',\n                        condition='all', rules=['f:/etc/os-release -> r:^ID=\"?rhel\"?$',\n                                               'f:/etc/os-release -> r:^VERSION_ID=\"?9([.][0-9]+)*\"?$']),\n                      checks=checks)\n        (ROOT/'policies'/filename).write_text(json.dumps(policy, ensure_ascii=False, indent=2)+'\\n')\n    hashes = {p.name: digest(p) for p in sorted((ROOT/'policies').glob('*.yml'))}\n    (ROOT/'data/policy_hashes.json').write_text(json.dumps(hashes, indent=2)+'\\n')\n    from .coverage import write\n    write()\n    validate()\n\n\ndef require(condition):\n    if not condition:\n        raise ValueError('候選政策結構、mapping 或 hash 不符')\n\n\ndef validate():\n    rows = {r['sca_id']: r for r in registry()}\n    seen = set()\n    for path in sorted((ROOT/'policies').glob('*.yml')):\n        p = json.loads(path.read_text())\n        require(p['policy']['file'] == path.name and p['policy']['regex_type']=='pcre2')\n        require(p['requirements'] == dict(title='僅 RHEL 9', description='角色由核准群組控制',\n            condition='all', rules=['f:/etc/os-release -> r:^ID=\"?rhel\"?$',\n                                   'f:/etc/os-release -> r:^VERSION_ID=\"?9([.][0-9]+)*\"?$']))\n        for c in p['checks']:\n            require(c['id'] not in seen and rows[c['id']]['included'])\n            seen.add(c['id'])\n            require(parse_description(c.get('description')) == values()[rows[c['id']]['gcb_id']])\n            require((' ｜ P2B7 ' if c['id']-900000 in BATCH7 else ' ｜ P2B6 ' if c['id']-900000 in BATCH6 else ' ｜ P2B3 ' if c['id']-900000 in BATCH3 else ' ｜ BATCH2 ' if c['id']-900000 in BATCH2 else ' ｜ Q1 ') in c['description'])\n            require(c['regex_type'] == 'pcre2' and c['condition'] == 'all')\n            require(c['compliance'] == [{'twgcb': [rows[c['id']]['gcb_id']]}])\n            require(rows[c['id']]['policy_id'] == p['policy']['id'])\n            require(c['rules'] == [emit_rule(a,b) for a,b in definitions()[c['id']-900000]])\n            for rule in c['rules']:\n                target, _ = rule.split(' -> ', 1)\n                require(target.removeprefix('not ').startswith('c:/'))\n                if c['id']-900000 not in BATCH2 | BATCH3 | BATCH6 | BATCH7:\n                    require(not any(x in target for x in ('|',';', '&&', '$', '`')))\n                parse_rule(rule)\n    require(seen == {900000+n for n in definitions()})\n    hashes = json.loads((ROOT/'data/policy_hashes.json').read_text())\n    require(hashes == {p.name:digest(p) for p in (ROOT/'policies').glob('*.yml')})\n    from .coverage import manifest\n    require(json.loads((ROOT/'data/coverage_manifest.json').read_text()) == manifest())\n    require(seen == {r['sca_id'] for r in rows.values() if r['implementation']=='candidate'})\n    return len(seen)\n\n\n@lru_cache(maxsize=1)\ndef supported_patterns():\n    return frozenset(p.lstrip('!') for rules in definitions().values() for _,p in rules) | {\n        '^ID=\"?rhel\"?$', '^VERSION_ID=\"?9([.][0-9]+)*\"?$'}\n\n\ndef emit_rule(target, pattern):\n    return ('not '+target+' -> r:'+pattern[1:]) if pattern.startswith('!') else target+' -> r:'+pattern\n\n\n@lru_cache(maxsize=1)\ndef batch2_emitted():\n    return {emit_rule(t,p) for rules in batch2_rules().values() for t,p in rules}\n\n\n@lru_cache(maxsize=1)\ndef batch3_emitted():\n    return {emit_rule(t,p) for rules in batch3_rules().values() for t,p in rules}\n\n\ndef parse_rule(rule):\n    \"\"\"Legacy bounded grammar plus exact allowlist of BATCH2 emitted rules.\"\"\"\n    if not isinstance(rule, str):\n        raise ValueError('不支援的規則語法')\n    if rule in {emit_rule(t,p) for rs in [*batch6_rules().values(), *batch7_rules().values()] for t,p in rs}:\n        target, expression = rule.split(' -> ', 1)\n        argv = w_strtok(target[2:])\n        if len(argv) != 3 or argv[:2] != ['/usr/bin/python3', '-c']:\n            raise ValueError('Invalid Python argv')\n        return target, re.compile(expression.split(':',1)[1], re.ASCII)\n    if rule in batch2_emitted() or rule in batch3_emitted():\n        target, expression = rule.split(' -> ', 1)\n        argv = w_strtok(target.removeprefix('not ')[2:])\n        if len(argv) != 3 or argv[:2] != ['/bin/sh', '-c']:\n            raise ValueError('Invalid wm_exec shell argv')\n        return target.removeprefix('not '), re.compile(expression.split(':',1)[1], re.ASCII)\n    if rule.count(' -> r:') != 1:\n        raise ValueError('不支援的規則語法')\n    target, pattern = rule.split(' -> r:')\n    if not re.fullmatch(r'[cf]:/[^\\n\\r]+', target) or any(x in target for x in (' -> ', ' && ', '|', ';', '`', '$')):\n        raise ValueError('不支援的目標')\n    if pattern not in supported_patterns() and not re.fullmatch(r'\\^[A-Za-z0-9_ =:/-]+\\$', pattern):\n        raise ValueError('未驗證的 PCRE2 語法')\n    try:\n        return target, re.compile(pattern, re.ASCII)\n    except re.error as exc:\n        raise ValueError('無效模式') from exc\n\n\ndef simulate(check, observations):\n    \"\"\"僅輸出匹配模型；執行失敗資訊不足回 UNRESOLVED，不冒充 Wazuh。\n\n    FIX-3 模擬 OS_StrBreak 的前 256 行上限（wm_sca.c:1749）。\n    FIX-1 同一 command 的多行輸出仍按逐行存在匹配；alternation 是單一\n    正向 regex，規則間維持 all，不以空輸出或 stderr 推論 not-found。\n    所有項目 exit_code 不參與輸出匹配（wm_exec 正常結束仍回 0），\n    並以 emitted shell guard 確保失敗不發布輸出或成功標記。\n    明確 engine_result 可表示真機／fixture\n    的 Not applicable；error 只表示未取得可靠輸出，不能預測引擎結果。\n    \"\"\"\n    if check.get('regex_type', 'pcre2') != 'pcre2':\n        raise ValueError('只支援明確 PCRE2 候選子集')\n    if check.get('condition') != 'all':\n        raise ValueError('輸出模型只支援目前發出的 all 子集')\n    if not isinstance(check.get('rules'), list) or not check['rules']:\n        raise ValueError('規則不得為空')\n    parsed = [parse_rule(rule) for rule in check['rules']]\n    outcomes = []\n    for rule, (target, pattern) in zip(check['rules'], parsed):\n        obs = observations.get(target)\n        if target.startswith('f:') and obs is not None and obs.get('exists') is False:\n            outcomes.append('NOT_APPLICABLE')\n            continue\n        if obs is None or obs.get('error'):\n            outcomes.append('UNRESOLVED')\n        elif obs.get('engine_result') == 'NOT_APPLICABLE':\n            outcomes.append('NOT_APPLICABLE')\n        elif not isinstance(obs.get('stdout'), str):\n            raise ValueError('觀察必須提供字串 stdout')\n        else:\n            matched = any(pattern.search(line) for line in obs['stdout'].split('\\n')[:256])\n            if rule.startswith('not '):\n                matched = not matched\n            outcomes.append('PASS' if matched else 'FAIL')\n    # 官方 all：任何 FAIL 優先；未知執行不擅自轉成 N/A。\n    if 'FAIL' in outcomes:\n        return 'FAIL'\n    if 'UNRESOLVED' in outcomes:\n        return 'UNRESOLVED'\n    return 'NOT_APPLICABLE' if 'NOT_APPLICABLE' in outcomes else 'PASS'\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom scripts.inventory import extract\nfrom pathlib import Path\nfor r in extract(next(Path('.').glob('*.xlsx'))):\n n=int(r['gcb_id'][-4:])\n if n in set(range(1,30))|{31}|set(range(285,301)):\n  print(n,r['title'],r['expected']);print(r['configuration_method'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom scripts.inventory import extract\nfrom pathlib import Path\nfor r in extract(next(Path('.').glob('*.xlsx'))):\n n=int(r['gcb_id'][-4:])\n if n in set(range(1,30))|{31}|set(range(285,301)):\n  print(n,r['title'],r['expected']);print(r['configuration_method'])\nPY\"","aggregated_output":"1 cramfs檔案系統 停用\n開啟終端機，執行vim指令，在/etc/modprobe.d目錄新增或編輯「cramfs.conf」檔案，範例如下：\n#vim /etc/modprobe.d/cramfs.conf\n並在檔案中加入以下內容：\ninstall cramfs /bin/true\nblacklist cramfs\n開啟終端機，執行下列指令，移除cramfs模組：\n#rmmod cramfs\n完成後，請重新開機\n2 squashfs檔案系統 停用\n開啟終端機，執行vim指令，在/etc/modprobe.d目錄，新增或編輯「squashfs.conf」檔案，範例如下：\n#vim /etc/modprobe.d/squashfs.conf\n並在檔案中加入以下內容：\ninstall squashfs /bin/true\nblacklist squashfs\n開啟終端機，執行下列指令，移除squashfs模組：\n#rmmod squashfs\n完成後，請重新開機\n3 udf檔案系統 停用\n開啟終端機，執行vim指令，在/etc/modprobe.d目錄，新增或編輯「udf.conf」檔案，範例如下：\n#vim /etc/modprobe.d/udf.conf\n並在檔案中加入以下內容：\ninstall udf /bin/true\nblacklist udf\n開啟終端機，執行下列指令，移除udf模組：\n#rmmod udf\n完成後，請重新開機\n4 設定/tmp目錄之檔案系統 tmpfs\n執行以下任一操作以設定/tmp目錄之檔案系統：\n開啟終端機，執行下列指令，編輯/etc/fstab\n#vim /etc/fstab\n/tmp之掛載設定範例如下：\ntmpfs /tmp tmpfs defaults,rw,nosuid,nodev,noexec,relatime 0 0\n開啟終端機，執行下列指令，運用systemd掛載/tmp：\n#systemctl unmask tmp.mount\n#systemctl enable tmp.mount\n編輯/etc/systemd/system/local-fs.target.wants/tmp.mount以掛載/tmp：\n[Mount]\nWhat=tmpfs\nWhere=/tmp\nType=tmpfs\nOptions=mode=1777,strictatime,noexec,nodev,nosuid\n5 設定/tmp目錄之nodev選項 啟用\n執行以下任一操作以設定/tmp目錄之nodev選項：\n編輯/etc/fstab檔案，在掛載點為/tmp列，於第4欄加入「,nodev」\n開啟終端機，執行下列指令，重新掛載/tmp：\n#mount -o remount,nodev /tmp\n編輯/etc/systemd/system/local-fs.target.wants/tmp.mount，將nodev添加到/tmp掛載選項：\n[Mount]\nOptions=mode=1777,strictatime,noexec,nodev,nosuid\n開啟終端機，執行下列指令，重新掛載/tmp：\n#mount -o remount,nodev /tmp\n6 設定/tmp目錄之nosuid選項 啟用\n執行以下任一操作以設定/tmp目錄之nosuid選項：\n編輯/etc/fstab檔案，在掛載點為/tmp列，於第4欄加入「,nosuid」\n開啟終端機，執行下列指令，重新掛載/tmp：\n#mount -o remount,nosuid /tmp\n編輯/etc/systemd/system/local-fs.target.wants/tmp.mount，將nosuid添加到/tmp掛載選項：\n[Mount]\nOptions=mode=1777,strictatime,noexec,nodev,nosuid\n開啟終端機，執行下列指令，重新掛載/tmp：\n#mount -o remount,nosuid /tmp\n7 設定/tmp目錄之noexec選項 啟用\n執行以下任一操作以設定/tmp目錄之noexec選項：\n編輯/etc/fstab檔案，在掛載點為/tmp列，於第4欄加入「,noexec」\n開啟終端機，執行下列指令，重新掛載/tmp：\n#mount -o remount,noexec /tmp\n編輯/etc/systemd/system/local-fs.target.wants/tmp.mount將noexec添加到/tmp掛載選項：\n[Mount]\nOptions=mode=1777,strictatime,noexec,nodev,nosuid\n開啟終端機，執行下列指令，重新掛載/tmp：\n#mount -o remount,noexec /tmp\n8 設定/var目錄之檔案系統 使用獨立之分割磁區或邏輯磁區\n對於新安裝之系統，在系統安裝過程中建立自定義磁區，為/var指定一個獨立磁區\n對於已安裝之系統，請先完成全系統備份後始進行磁區分割作業，使用邏輯磁區管理員(Logical volume manager, LVM)建立獨立的/var磁區之範例如下：\n情境說明：系統擁有1顆20GB之SCSI硬碟，目前已建立2個主要磁區，合計已使用5GB空間。針對剩餘硬碟空間使用LVM建立1個256MB的/var邏輯磁區操作順序如下：\n#gdisk /dev/sda\n#n(新增磁區)\n#3(建立磁區編號)\n#enter(在First sector輸入)\n#+256M(在Last sector輸入)\n#8e00(變更Hex code，LVM磁區代碼)\n#w(寫入磁區分割表格)\n#partprobe(強制重新抓磁區分割表格)\n#pvcreate /dev/sda3(對/dev/sda3建立PV)\n#vgcreate -s 16M varvg /dev/sda3(對/dev/sda3建立1個VG，VG名稱varvg，且指定1個PE大小16MB)\n#vgdisplay(顯示目前系統VG狀態，本範例的Total PE數顯示15)\n#lvcreate -l 15 -n varlv varvg (從varvg分割出1個LV，LV名稱varlv，並將15個PE配置給varlv)\n#mkfs.xfs /dev/varvg/varlv(對/dev/varvg/varlv進行格式化)\n接著，編輯/etc/fstab檔案，新增或修改成以下內容： \n/dev/varvg/varlv /var xfs defaults  0  0\n9 設定/var/tmp目錄之檔案系統 使用獨立之分割磁區或邏輯磁區\n對於新安裝之系統，在系統安裝過程中建立自定義磁區，為/var/tmp指定一個獨立磁區\n對於已安裝之系統，請先完成全系統備份後始進行磁區分割作業，使用邏輯磁區管理員建立獨立的/var/tmp磁區之範例如下：\n情境說明：系統擁有1顆20GB之SCSI硬碟，目前已建立2個主要磁區，合計已使用5GB空間。針對剩餘硬碟空間使用LVM建立1個256MB的/var/tmp邏輯磁區操作順序如下：\n#gdisk /dev/sda\n#n(新增磁區)\n#3(建立磁區編號)\n#enter(在First sector輸入)\n#+256M(在Last sector輸入)\n#8e00(變更Hex code，LVM磁區代碼)\n#w(寫入磁區分割表格)\n#partprobe(強制重新抓磁區分割表格)\n#pvcreate /dev/sda3(對/dev/sda3建立PV)\n#vgcreate -s 16M vartmpvg /dev/sda3(對/dev/sda3建立1個VG，VG名稱vartmpvg，且指定1個PE大小16MB)\n#vgdisplay(顯示目前系統VG狀態，本範例的Total PE數顯示15)\n#lvcreate -l 15 -n vartmplv vartmpvg (從vartmpvg分割出1個LV，LV名稱vartmplv，並將15個PE配置給vartmplv)\n#mkfs.xfs /dev/vartmpvg/vartmplv(對/dev/vartmpvg/vartmplv進行格式化)\n接著，編輯/etc/fstab檔案，新增或修改成以下內容：\n/dev/vartmpvg/vartmplv /var/tmp xfs defaults 0 0\n10 設定/var/tmp目錄之nodev選項 啟用\n編輯/etc/fstab檔案，在掛載點為/var/tmp列，於第4欄加入「,nodev」\n開啟終端機，執行下列指令，重新掛載/var/tmp：\n#mount -o remount,nodev /var/tmp\n11 設定/var/tmp目錄之nosuid選項 啟用\n編輯/etc/fstab檔案，在掛載點為/var/tmp列，於第4欄加入「, nosuid」\n開啟終端機，執行下列指令，重新掛載/var/tmp：\n#mount -o remount,nosuid /var/tmp\n12 設定/var/tmp目錄之noexec選項 啟用\n編輯/etc/fstab檔案，在掛載點為/var/tmp列，於第4欄加入「,noexec」\n開啟終端機，執行下列指令，重新掛載/var/tmp：\n#mount -o remount,noexec /var/tmp\n13 設定/var/log目錄之檔案系統 使用獨立之分割磁區或邏輯磁區\n對於新安裝之系統，在系統安裝過程中建立自定義磁區，為/var/log指定一個獨立磁區\n對於已安裝之系統，請先完成全系統備份後始進行磁區分割作業，使用邏輯磁區管理員建立獨立的/var/log磁區之範例如下：\n情境說明：系統擁有1顆20GB之SCSI硬碟，目前已建立2個主要磁區，合計已使用5GB空間。針對剩餘硬碟空間使用LVM建立1個256MB的/var/log邏輯磁區操作順序如下：\n#gdisk /dev/sda\n#n(新增磁區)\n#3(建立磁區編號)\n#enter(在First sector輸入)\n#+256M(在Last sector輸入)\n#8e00(變更Hex code，LVM磁區代碼)\n#w(寫入磁區分割表格)\n#partprobe(強制重新抓磁區分割表格)\n#pvcreate /dev/sda3(對/dev/sda3建立PV)\n#vgcreate -s 16M varlogvg /dev/sda3(對/dev/sda3建立1個VG，VG名稱varlogvg，且指定1個PE大小16MB)\n#vgdisplay(顯示目前系統VG狀態，本範例的Total PE數顯示15)\n#lvcreate -l 15 -n varloglv varlogvg (從varlogvg分割出1個LV，LV名稱varloglv，並將15個PE配置給varloglv)\n#mkfs.xfs /dev/varlogvg/varloglv(對/dev/varlogvg/varloglv進行格式化)\n接著，編輯/etc/fstab檔案，新增或修改成以下內容：\n/dev/varlogvg/varloglv /var/log xfs defaults  0  0\n14 設定/var/log/audit目錄之檔案系統 使用獨立之分割磁區或邏輯磁區\n對於新安裝之系統，在系統安裝過程中建立自定義磁區，為/var/log/audit指定一個獨立磁區\n對於已安裝之系統，請先完成全系統備份後始進行磁區分割作業，使用邏輯磁區管理員建立獨立的/var/log/audit磁區之範例如下：\n情境說明：系統擁有1顆20GB之SCSI硬碟，目前已建立2個主要磁區，合計已使用5GB空間。針對剩餘硬碟空間使用LVM建立1個256MB的/var/log/audit邏輯磁區操作順序如下：\n#gdisk /dev/sda\n#n(新增磁區)\n#3(建立磁區編號)\n#enter(在First sector輸入)\n#+256M(在Last sector輸入)\n#8e00(變更Hex code，LVM磁區代碼)\n#w(寫入磁區分割表格)\n#partprobe(強制重新抓磁區分割表格)\n#pvcreate /dev/sda3(對/dev/sda3建立PV)\n#vgcreate -s 16M varlogadvg /dev/sda3(對/dev/sda3建立1個VG，VG名稱varlogadvg，且指定1個PE大小16MB)\n#vgdisplay(顯示目前系統VG狀態，本範例的Total PE數顯示15)\n#lvcreate -l 15 -n varlogadlv varlogadvg (從varlogadvg分割出1個LV，LV名稱varlogadlv，並將15個PE配置給varlogadlv)\n#mkfs.xfs /dev/varlogadvg/varlogadlv(對/dev/varlogadvg/varlogadlv進行格式化)\n接著，編輯/etc/fstab檔案，新增或修改成以下內容：\n/dev/varlogadvg/varlogadlv /var/log/audit xfs defaults 0 0\n15 設定/home目錄之檔案系統 使用獨立之分割磁區或邏輯磁區\n對於新安裝之系統，在系統安裝過程中建立自定義磁區，為/home指定一個獨立磁區\n對於已安裝之系統，請先完成全系統備份後始進行磁區分割作業，使用邏輯磁區管理員建立獨立的/home磁區之範例如下：\n情境說明：系統擁有1顆20GB之SCSI硬碟，目前已建立2個主要磁區，合計已使用5GB空間。針對剩餘硬碟空間使用LVM建立1個256MB的/home邏輯磁區操作順序如下：\n#gdisk /dev/sda\n#n(新增磁區)\n#3(建立磁區編號)\n#enter(在First sector輸入)\n#+256M(在Last sector輸入)\n#8e00(變更Hex code，LVM磁區代碼)\n#w(寫入磁區分割表格)\n#partprobe(強制重新抓磁區分割表格)\n#pvcreate /dev/sda3(對/dev/sda3建立PV)\n#vgcreate -s 16M homevg /dev/sda3(對/dev/sda3建立1個VG，VG名稱homevg，且指定1個PE大小16MB)\n#vgdisplay(顯示目前系統VG狀態，本範例的Total PE數顯示15)\n#lvcreate -l 15 -n homelv homevg (從homevg分割出1個LV，LV名稱homelv，並將15個PE配置給homelv)\n#mkfs.xfs /dev/homevg/homelv(對/dev/homevg/homelv進行格式化)\n接著，編輯/etc/fstab檔案，新增或修改成以下內容：\n/dev/homevg/homelv /home xfs defaults  0  0\n16 設定/home目錄之nodev選項 啟用\n編輯/etc/fstab檔案，在掛載點為/home列，於第4欄加入「,nodev」\n開啟終端機，執行下列指令，重新掛載/home：\n#mount -o remount,nodev /home\n17 設定/dev/shm目錄之nodev選項 啟用\n編輯/etc/fstab檔案，在掛載點為/dev/shm列，於第4欄加入「,nodev」\n若掛載點不存在，請於/etc/fstab檔案新增掛載點，並於第4欄加入「,nodev」，範例如下：\n/dev/shm tmpfs rw, nodev,seclabel 0 0\n開啟終端機，執行下列指令，重新掛載/dev/shm：\n#mount -o remount,nodev /dev/shm\n18 設定/dev/shm目錄之nosuid選項 啟用\n編輯/etc/fstab檔案，在掛載點為/dev/shm列，於第4欄加入「,nosuid」\n若掛載點不存在，請於/etc/fstab檔案新增掛載點，並於第4欄加入「,nosuid」，範例如下：\n/dev/shm tmpfs rw, nosuid,seclabel 0 0\n開啟終端機，執行下列指令，重新掛載/dev/shm：\n#mount -o remount,nosuid /dev/shm\n19 設定/dev/shm目錄之noexec選項 啟用\n編輯/etc/fstab檔案，在掛載點為/dev/shm列，於第4欄加入「,noexec」\n若掛載點不存在，請於/etc/fstab檔案新增掛載點，並於第4欄加入「,noexec」，範例如下：\n/dev/shm tmpfs rw, noexec,seclabel 0 0\n開啟終端機，執行下列指令，重新掛載/dev/shm：\n#mount -o remount,noexec /dev/shm\n20 設定可攜式儲存裝置之nodev選項 啟用\n開啟終端機，執行以下指令，檢查是否有掛載可攜式儲存裝置：\n#mount\n若發現有掛載可攜式儲存裝置，則編輯/etc/fstab檔案，在掛載點為「可攜式儲存裝置」列，於第4欄加入「,nodev」\n21 設定可攜式儲存裝置之nosuid選項 啟用\n開啟終端機，執行以下指令，檢查是否有掛載可攜式儲存裝置：\n#mount\n若發現有掛載可攜式儲存裝置，則編輯/etc/fstab檔案，在掛載點為「可攜式儲存裝置」列，於第4欄加入「,nosuid」\n22 設定可攜式儲存裝置之noexec選項 啟用\n開啟終端機，執行以下指令，檢查是否有掛載可攜式儲存裝置：\n#mount\n若發現有掛載可攜式儲存裝置，則編輯/etc/fstab檔案，在掛載點為「可攜式儲存裝置」列，於第4欄加入「,noexec」\n23 設定使用者家目錄之nodev選項 啟用\n開啟終端機，執行下列指令，尋找使用者家目錄(/home/使用者帳號)：\n#awk -F: '($3>=1000)&&($1!=\"nobody\"){print $1,$3,$6}' /etc/passwd\n執行下列指令，檢查/etc/fstab檔案，確認系統開機時掛載之檔案系統：\n#more /etc/fstab\n若發現使用者家目錄掛載在獨立檔案系統，則編輯/etc/fstab檔案，在掛載點為「使用者家目錄」列，於第4欄加入「,nodev」\n24 設定使用者家目錄之nosuid選項 啟用\n開啟終端機，執行下列指令，尋找使用者家目錄(/home/使用者帳號)：\n#awk -F: '($3>=1000)&&($1!=\"nobody\"){print $1,$3,$6}' /etc/passwd\n執行下列指令，檢查/etc/fstab檔案，確認系統開機時掛載之檔案系統：\n#more /etc/fstab\n若發現使用者家目錄掛載在獨立檔案系統，則編輯/etc/fstab檔案，在掛載點為「使用者家目錄」列，於第4欄加入「,nosuid」\n25 設定使用者家目錄之noexec選項 啟用\n開啟終端機，執行下列指令，尋找使用者家目錄(/home/使用者帳號)：\n#awk -F: '($3>=1000)&&($1!=\"nobody\"){print $1,$3,$6}' /etc/passwd\n執行下列指令，檢查/etc/fstab檔案，確認系統開機時掛載之檔案系統：\n#more /etc/fstab\n若發現使用者家目錄掛載在獨立檔案系統，則編輯/etc/fstab檔案，在掛載點為「使用者家目錄」列，於第4欄加入「,noexec」\n26 設定NFS檔案系統之nodev選項 啟用\n開啟終端機，執行下列指令，檢查/etc/fstab檔案，確認系統開機時是否有掛載NFS檔案系統：\n#grep nfs /etc/fstab\n若發現有掛載NFS檔案系統，則編輯/etc/fstab檔案，在掛載點為「NFS檔案系統」列，於第4欄加入「,nodev」\n27 設定NFS檔案系統之nosuid選項 啟用\n開啟終端機，執行下列指令，檢查/etc/fstab檔案，確認系統開機時是否有掛載NFS檔案系統：\n#grep nfs /etc/fstab\n若發現有掛載NFS檔案系統，則編輯/etc/fstab檔案，在掛載點為「NFS檔案系統」列，於第4欄加入「,nosuid」\n28 設定NFS檔案系統之noexec選項 啟用\n開啟終端機，執行下列指令，檢查/etc/fstab檔案，確認系統開機時是否有掛載NFS檔案系統：\n#grep nfs /etc/fstab\n若發現有掛載NFS檔案系統，則編輯/etc/fstab檔案，在掛載點為「NFS檔案系統」列，於第4欄加入「,noexec」\n29 設定全域寫入權限目錄之粘滯位 設定粘滯位\n開啟終端機，執行下列指令，在所有具有全域寫入(World-writable)權限之目錄設定粘滯位：\n#df --local -P | awk '{if (NR!=1) print $6}' | xargs -I '{}' find '{}' -xdev -type d \\( -perm -0002 -a ! -perm -1000 \\) 2>/dev/null | xargs -I '{}' chmod o+t '{}'\n31 USB儲存裝置 停用\n開啟終端機，執行vim指令，在/etc/modprobe.d目錄新增或編輯「usb-storage.conf」檔案，範例如下：\n#vim /etc/modprobe.d/usb-storage.conf\n並在檔案中加入以下內容：\ninstall usb-storage /bin/true\nblacklist usb-storage\n開啟終端機，執行下列指令，移除usb-storage模組：\nrmmod usb-storage\n完成後，請重新開機\n285 freevxfs檔案系統 停用\n開啟終端機，執行vim指令，在/etc/modprobe.d目錄新增或編輯「freevxfs.conf」檔案，範例如下：\n#vim /etc/modprobe.d/freevxfs.conf\n並在檔案中加入以下內容：\ninstall freevxfs /bin/true\nblacklist freevxfs\n開啟終端機，執行下列指令，移除freevxfs模組：\n#modprobe -r freevxfs\n#rmmod freevxfs\n完成後，請重新開機\n286 hfs檔案系統 停用\n開啟終端機，執行vim指令，在/etc/modprobe.d目錄新增或編輯「hfs.conf」檔案，範例如下：\n#vim /etc/modprobe.d/hfs.conf\n並在檔案中加入以下內容：\ninstall hfs /bin/true\nblacklist hfs\n開啟終端機，執行下列指令，移除hfs模組：\n#modprobe -r hfs\n#rmmod hfs\n完成後，請重新開機\n287 hfs plus檔案系統 停用\n開啟終端機，執行vim指令，在/etc/modprobe.d目錄新增或編輯「hfsplus.conf」檔案，範例如下：\n#vim /etc/modprobe.d/hfsplus.conf\n並在檔案中加入以下內容：\ninstall hfsplus /bin/true\nblacklist hfsplus\n開啟終端機，執行下列指令，移除hfsplus模組：\n#modprobe -r hfsplus\n#rmmod hfsplus\n完成後，請重新開機\n288 jffs2檔案系統 停用\n開啟終端機，執行vim指令，在/etc/modprobe.d目錄新增或編輯「jffs2.conf」檔案，範例如下：\n#vim /etc/modprobe.d/jffs2.conf\n並在檔案中加入以下內容：\ninstall jffs2 /bin/true\nblacklist jffs2\n開啟終端機，執行下列指令，移除jffs2模組：\n#modprobe -r jffs2\n#rmmod jffs2\n完成後，請重新開機\n289 afs檔案系統 停用\n開啟終端機，執行vim指令，在/etc/modprobe.d目錄新增或編輯「afs.conf」檔案，範例如下：\n#vim /etc/modprobe.d/afs.conf\n並在檔案中加入以下內容：\ninstall afs /bin/true\nblacklist afs\n開啟終端機，執行下列指令，移除afs模組：\n#modprobe -r afs\n#rmmod afs\n完成後，請重新開機\n290 ceph檔案系統 停用\n開啟終端機，執行vim指令，在/etc/modprobe.d目錄新增或編輯「ceph.conf」檔案，範例如下：\n#vim /etc/modprobe.d/ceph.conf\n並在檔案中加入以下內容：\ninstall ceph /bin/true\nblacklist ceph\n開啟終端機，執行下列指令，移除ceph模組：\n#modprobe -r ceph\n#rmmod ceph\n完成後，請重新開機\n291 cifs檔案系統 停用\n開啟終端機，執行vim指令，在/etc/modprobe.d目錄新增或編輯「cifs.conf」檔案，範例如下：\n#vim /etc/modprobe.d/cifs.conf\n並在檔案中加入以下內容：\ninstall cifs /bin/true\nblacklist cifs\n開啟終端機，執行下列指令，移除cifs模組：\n#modprobe -r cifs\n#rmmod cifs\n完成後，請重新開機\n292 exfat檔案系統 停用\n開啟終端機，執行vim指令，在/etc/modprobe.d目錄新增或編輯「exfat.conf」檔案，範例如下：\n#vim /etc/modprobe.d/exfat.conf\n並在檔案中加入以下內容：\ninstall exfat /bin/true\nblacklist exfat\n開啟終端機，執行下列指令，移除exfat模組：\n#modprobe -r exfat\n#rmmod exfat\n完成後，請重新開機\n293 ext檔案系統 停用\n開啟終端機，執行vim指令，在/etc/modprobe.d目錄新增或編輯「ext.conf」檔案，範例如下：\n#vim /etc/modprobe.d/ext.conf\n並在檔案中加入以下內容：\ninstall ext /bin/true\nblacklist ext\n開啟終端機，執行下列指令，移除ext模組：\n#modprobe -r ext\n#rmmod ext\n完成後，請重新開機\n294 fat檔案系統 停用\n開啟終端機，執行vim指令，在/etc/modprobe.d目錄新增或編輯「fat.conf」檔案，範例如下：\n#vim /etc/modprobe.d/fat.conf\n並在檔案中加入以下內容：\ninstall fat /bin/true\nblacklist fat\n開啟終
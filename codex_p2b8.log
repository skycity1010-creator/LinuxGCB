{"type":"item.completed","item":{"id":"item_11","type":"agent_message","text":"來源已核對。0001–0003、0031、0285–0300 實際共 20 條模組設定規則；加上其餘 26 條，總數仍是 46。可攜式與 NFS 的來源均寫「若有掛載」才設定；我會讓無對應掛載的情況輸出待審標記，並在 REVIEW 說明它不代表符合或違規。獨立分割檢查另用 mountinfo 的裝置與根路徑資訊排除 bind/subpath。\n"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/implement_p2b8.py <<'PY'\nfrom pathlib import Path\np=Path('linuxgcb/batch7.py').read_text()\np=p[:p.index('def script(n):')]+'''def script(n):\n    return inspect.getsource(p2b8_runtime) + '\\\\\\\\ntry:\\\\\\\\n    ok = check(' + str(n) + \\\")\\\\\\\\nexcept (OSError, ValueError, IndexError, KeyError, subprocess.SubprocessError):\\\\\\\\n    ok = False\\\\\\\\nif ok is None:\\\\\\\\n    print('REVIEW')\\\\\\\\nelif ok:\\\\\\\\n    print('PASS')\\\\\\\\n\\\"\n\n\n@lru_cache(maxsize=1)\ndef rules():\n    return {n:[('c:/usr/bin/python3 -c ' + quote_argument(script(n)), '\"'^PASS$|''^REVIEW$'\"')] for n in sorted(ADDED)}\n\n\ndef caveat(n):\n    if n in MODULES:\n        note = '精確 install 模組 /bin/true 與 blacklist 模組；不以模組不存在豁免；載入狀態與重新開機待真機。'\n    elif n in (8,9,13,14,15):\n        note = 'mountinfo 確認掛載點、裝置號不同於根與其他祖先、root=/，來源獨立裝置；bind/subpath 不算。'\n    elif n == 29:\n        note = '來源 df --local -P 逐本機磁區，find -xdev -type d -perm -0002 \"'! -perm -1000 -print -quit；24秒整體預算。'\"'\n    elif 20 <= n <= 22:\n        note = '由 sysfs 裝置 removable 與父裝置辨識可攜式掛載；無對象或裝置無法分類輸出 REVIEW，並非符合或違規；USB 固定式及非 block 可攜式辨識待批。'\n    elif 23 <= n <= 25:\n        note = '來源 passwd UID>=1000 且非 nobody，只查家目錄本身獨立掛載；無對象輸出 REVIEW；以即時值取代來源 fstab 按任務要求，待批。'\n    elif 26 <= n <= 28:\n        note = '來源條件式 NFS；查即時 nfs/nfs4 掛載選項，無對象輸出 REVIEW；fstab 尚未掛載項之適用性另審。'\n    else:\n        note = '讀 /proc/mounts 精確掛載點、類型或完整 option token；缺掛載失敗；持久設定及生效差異待真機。'\n    return note + ' P2B8 UNVALIDATED；human_review_pending；execution_review=blocked；REVIEW 在輸出匹配層為 raw passed，但 coverage partial 且 blocked，必須人工判定適用性，不是已驗證 PASS。'\n'''\np=p.replace('p2b7_runtime','p2b8_runtime').replace('ADDED = {32} | set(range(34,45)) | set(range(61,92)) | set(range(303,308))','ADDED = set(range(1,30)) | {31} | set(range(285,301))\\\\nfrom .p2b8_runtime import MODULES').replace('P2B7','P2B8')\nPath('linuxgcb/batch8.py').write_text(p)\n# Integrations preserving older branches verbatim\nfor filename in ('catalog.py','policy.py','quality.py','coverage.py'):\n path=Path('linuxgcb')/filename;s=path.read_text()\n if filename=='catalog.py':\n  s=s.replace('from .batch7 import ADDED as BATCH7','from .batch8 import ADDED as BATCH8\\\\nfrom .batch7 import ADDED as BATCH7');s=s.replace('PARTIAL =','IMPLEMENTED.update({n: \\\\'base\\\\' for n in BATCH8})\\\\nPARTIAL =')\n elif filename=='quality.py':\n  s=s.replace('ABSENCE_PENDING =','from .batch8 import ADDED as BATCH8, caveat as batch8_caveat\\\\n\\\\nABSENCE_PENDING =');a=s.index('    if n in BATCH7:',s.index('def status'));b=s.index('    if n in BATCH6:',a);s=s[:a]+s[a:b].replace('BATCH7','BATCH8').replace('B7-','B8-').replace('P2B7','P2B8').replace('batch7_caveat','batch8_caveat')+s[a:]\n elif filename=='policy.py':\n  s=s.replace('from .argv import','from .batch8 import rules as batch8_rules, ADDED as BATCH8\\\\nfrom .argv import').replace('**batch7_rules(),','**batch7_rules(), **batch8_rules(),').replace(\\\"(' ｜ P2B7 執行審查 '\\\",\\\"(' ｜ P2B8 執行審查 ' if row['sca_id']-900000 in BATCH8 else ' ｜ P2B7 執行審查 '\\\").replace(\\\"(' ｜ P2B7 ' if c\\\", \\\"(' ｜ P2B8 ' if c['id']-900000 in BATCH8 else ' ｜ P2B7 ' if c\\\").replace('BATCH6 | BATCH7:', 'BATCH6 | BATCH7 | BATCH8:').replace('*batch7_rules().values()]','*batch7_rules().values(), *batch8_rules().values()]')\n else:\n  s=s.replace('def manifest():','from .batch8 import ADDED as BATCH8, caveat as batch8_caveat, sources as batch8_sources\\\\n\\\\ndef manifest():');a=s.index('        if n in BATCH7:');b=s.index('        elif n in BATCH6:',a);s=s[:a]+s[a:b].replace('BATCH7','BATCH8').replace('batch7_sources','batch8_sources')+s[a:].replace('        if n in BATCH7:', '        elif n in BATCH7:',1)\n  s=s.replace(\\\"('P2B7 direct\\\", \\\"('P2B8 direct Python argv source predicates' if n in BATCH8 else 'P2B7 direct\\\").replace('caveats=batch7_caveat', 'caveats=batch8_caveat(n) if n in BATCH8 else batch7_caveat').replace(\\\"('tests/test_p2b7.py#'\\\", \\\"('tests/test_p2b8.py#' if n in BATCH8 else 'tests/test_p2b7.py#'\\\").replace(\\\"'tests/test_p2b7.py' if n\\\", \\\"'tests/test_p2b8.py' if n in BATCH8 else 'tests/test_p2b7.py' if n\\\").replace('BATCH6 | BATCH7 else','BATCH6 | BATCH7 | BATCH8 else').replace('added=len(ADDED)+','batch8_before=236,batch8_added=46,batch8_after=282,added=len(BATCH8)+len(ADDED)+')\n path.write_text(s)\nPY\npython3 /tmp/implement_p2b8.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

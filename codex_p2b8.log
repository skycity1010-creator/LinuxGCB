ces\": 1,\n      \"docx_all_cells\": [\n        [\n          \"206\",\n          \"TWGCB-01-012-0207\",\n          \"帳號與存取控制\",\n          \"強制root通行碼須符合通行碼規則\",\n          \"這項原則設定決定是否強制root帳號之通行碼須符合通行碼規則\\n若使用PAM模組管理通行碼，pam_pwquality.so將會檢驗通行碼相關規則，例如通行碼長度、通行碼使用字元及通行碼複雜度等，使用高強度通行碼可降低系統遭攻擊者進行字典檔查詢或暴力破解等通行碼攻擊之影響\\n啟用root帳號通行碼檢查功能，以確保即使重新設定通行碼者為root帳號，亦須符合通行碼規則，以提高通行碼強度\\nEnforce_for_root：強制root帳號之通行碼須符合通行碼規則\",\n          \"開啟終端機，執行以下指令，建立客製化profile：\\n#authselect create-profile <profile名稱> -b sssd --symlink-meta\\n#authselect select custom/<profile名稱> with-sudo with-faillock without-nullok\\n開啟終端機，執行以下腳本，更新system-auth與password-auth檔案：\\n#!/bin/bash\\nCP=$(authselect current | awk 'NR == 1 {print $3}' | grep custom/)\\nfor FN in system-auth password-auth; do\\n    [[ -n $CP ]] && PTF=/etc/authselect/$CP/$FN || PTF=/etc/authselect/$FN\\n    [[ -z $(grep -E '^\\\\s*password\\\\s+requisite\\\\s+pam_pwquality.so\\\\s+.*enforce_for_root\\\\s*.*$' $PTF) ]] && sed -ri 's/^\\\\s*(password\\\\s+requisite\\\\s+pam_pwquality.so\\\\s+)(.*)$/\\\\1\\\\2 enforce_for_root/' $PTF\\ndone\\nauthselect apply-changes\",\n          \"啟用\"\n        ]\n      ],\n      \"docx_sha256\": \"986effd9501b1fd97776129c6691cf8fc98246bd04514347322f3337508e0e5b\",\n      \"mechanism\": \"P2B6 direct Python argv source predicates\",\n      \"caveats\": \"讀 /etc/pam.d 渲染堆疊並跟隨 symlink；authselect custom profile 與執行中效力待真機。P2B6 UNVALIDATED；human_review_pending；execution_review=blocked；唯讀 Python 標準庫，錯誤/缺失無成功輸出；w_strtok/PCRE2/timeout 待真機。\",\n      \"tests\": [\n        \"tests/test_p2b6.py#900207\",\n        \"tests/test_p2b6.py\"\n      ],\n      \"cases\": [\n        \"isolated_positive\",\n        \"isolated_negative\",\n        \"missing_no_commit\",\n        \"argv_roundtrip\"\n      ],\n      \"review_status\": \"human_review_pending\",\n      \"offline_review\": \"completed_with_findings\",\n      \"execution_review\": \"blocked\",\n      \"coverage\": \"partial\",\n      \"issue_ids\": [\n        \"B
(r['review_status'],'human_review_pending')\n\n    def test_structural(self):\n        self.assertEqual(validate(),len(definitions()))\n\n    def test_all_positive_negative_missing_error(self):\n        fixtures=json.loads((ROOT/'tests/fixtures/rule_outputs.json').read_text())\n        from scripts.batch2_fixtures import generated\n        fixtures['checks']['900188'] = generated()['900188']  # Preserve historical fixture on disk.\n        fixtures['checks'].update(json.loads((ROOT/'tests/fixtures/p2b3/cases.json').read_text())['checks'])\n        self.assertEqual(fixtures['label'],'SYNTHETIC TEST ONLY')\n        checked = set()\n        for p in (ROOT/'policies').glob('*.yml'):\n            for c in json.loads(p.read_text())['checks']:\n                if c['id']-900000 in BATCH6 | BATCH7:\n                    continue  # P2B6 executes isolated input predicates in test_p2b6.py.\n                checked.add(str(c['id']))\n                for name, state in [('positive','PASS'),('negative','FAIL'),('missing','UNRESOLVED'),('empty','FAIL'),('error','UNRESOLVED'),('nonzero_matching','PASS')]:\n                    with self.subTest(id=c['id'],case=name):\n                        self.assertEqual(simulate(c,fixtures['checks'][str(c['id'])][name]), state)\n        self.assertEqual(checked,set(fixtures['checks']))\n        self.assertFalse(rt.check(39))\n        for mode,expected in [(0o644,True),(0o600,True),(0o664,False),(0o1644,False)]:\n            self.put('/etc/security/opasswd','',mode)\n            self.assertEqual(rt.check(304),expected)\n\n    def test_original_188_rules_and_evidence_unchanged(self):\n        old={};new={}\n        for p in sorted((ROOT/'policies').glob('*.yml')):\n            old.update({c['id']:c for c in json.loads(subprocess.check_output(['git','show','6788fdc:policies/'+p.name],cwd=ROOT))['checks']})\n            new.update({c['id']:c for c in json.loads(p.read_text())['checks']})\n        self.assertEqual(len(old),188);self.assertEqual(len(
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"cat tests/test_report.py; cat linuxgcb/policy.py | head -110; cat README.md; ls data; python3 - <<'PY'\nimport json\nfrom pathlib import Path\np=Path('/home/skycity1010/projects/LinuxGCB/data/realhost_scan_20261031_r2.json')\nd=json.loads(p.read_text()); print(type(d));\nfor k,v in d.items():\n print(k, str(v)[:1800])\nPY\"","aggregated_output":"import copy\nimport csv\nimport json\nimport tempfile\nimport unittest\nfrom datetime import datetime,timezone\nfrom pathlib import Path\nfrom linuxgcb.catalog import ROOT\nfrom linuxgcb.report import normalize,metrics,render,safe_cell\n\nNOW=datetime(2026,10,30,tzinfo=timezone.utc)\n\n\nclass ReportTests(unittest.TestCase):\n    def setUp(self):\n        self.fixture=json.loads((ROOT/'tests/fixtures/snapshot.json').read_text())\n    def rows(self):return normalize(self.fixture,NOW)\n    def test_full_inventory_status_and_denominators(self):\n        rows=self.rows();by={r['sca_id']:r for r in rows};m=metrics(rows)\n        self.assertEqual(len(rows),314)\n        self.assertEqual(m['counts']['EXCLUDED'],7)\n        self.assertEqual(m['applicable'],307)\n        self.assertEqual(m['counts'].get('PASS',0),0)\n        self.assertEqual(m['counts']['FAIL'],1)\n        self.assertEqual(by[900243]['state'],'ERROR')\n        self.assertEqual(by[900108]['state'],'MANUAL_PENDING')\n        self.assertEqual(by[900269]['state'],'MANUAL_PENDING')\n        self.assertEqual(by[900270]['state'],'MANUAL_PENDING')\n        self.assertTrue(by[900046]['exception_approved'])\n        self.assertEqual(by[900046]['state'],'FAIL')\n        self.assertEqual(m['completeness'],0.0)\n        self.assertEqual(m['pass_rate'],None)\n    def test_no_scan_and_stale(self):\n        host=self.fixture['hosts'][0];host['checks']=[];host.pop('scanned_at')\n        rows=self.rows();self.assertTrue(all(r['stale'] for r in rows))\n        self.assertEqual(next(r for r in rows if r['sca_id']==900045)['state'],'NOT_SCANNED')\n        host['checks']=[dict(id=900045,result='passed')]\n        self.assertEqual(next(r for r in self.rows() if r['sca_id']==900045)['state'],'MANUAL_PENDING')\n    def test_zero_denominator(self):\n        m=metrics([])\n        self.assertIsNone(m['pass_rate']);self.assertIsNone(m['completeness']);self.assertIsNone(m['attainment'])\n    def test_approved_na_does_not_hide_failure_or_error(self):\n        h=self.fixture['hosts'][0]\n        approved=next(iter(h['exceptions'].values()))\n        h['not_applicable']={f'TWGCB-01-012-{n:04d}':copy.deepcopy(approved) for n in (45,46,243)}\n        by={r['sca_id']:r for r in self.rows()}\n        self.assertEqual(by[900045]['state'],'NOT_APPLICABLE')\n        self.assertEqual(by[900046]['state'],'FAIL')\n        self.assertEqual(by[900243]['state'],'NOT_APPLICABLE')\n        h['checks'][3]['execution_error']=True\n        self.assertEqual(next(r for r in self.rows() if r['sca_id']==900243)['state'],'ERROR')\n        h['not_applicable']['TWGCB-01-012-0045']['expires']='2020-01-01T00:00:00Z'\n        self.assertEqual(next(r for r in self.rows() if r['sca_id']==900045)['state'],'MANUAL_PENDING')\n    def test_unapproved_profiles_conservative(self):\n        self.fixture['hosts'][0]['approved_profiles']=[]\n        rows=self.rows();self.assertEqual(metrics(rows)['unresolved'],307)\n        self.assertEqual(next(r for r in rows if r['sca_id']==900045)['state'],'MANUAL_PENDING')\n    def test_invalid_snapshots_rejected(self):\n        mutations=[lambda s:s.update(source_sha256='bad'),lambda s:s.update(policy_hashes={}),\n            lambda s:s['hosts'].append(copy.deepcopy(s['hosts'][0])),\n            lambda s:s['hosts'][0]['checks'].append(dict(id=123,result='passed')),\n            lambda s:s['hosts'][0]['checks'].append(dict(id=900045,result='passed')),\n            lambda s:s['hosts'][0]['checks'].append(dict(id=900001,result='passed'))]\n        for mutate in mutations:\n            s=copy.deepcopy(self.fixture);mutate(s)\n            with self.assertRaises(ValueError):normalize(s,NOW)\n    def test_html_csv_raw_integrity(self):\n        before=copy.deepcopy(self.fixture)\n        with tempfile.TemporaryDirectory() as d:\n            render(self.fixture,d,NOW)\n            page=(Path(d)/'report.html').read_text()\n            self.assertNotIn('<script>',page)\n            self.assertIn('&lt;script&gt;',page)\n            self.assertIn('SYNTHETIC',page)\n            with (Path(d)/'report.csv').open(encoding='utf-8-sig',newline='') as f:\n                rows=list(csv.DictReader(f))\n            self.assertEqual(len(rows),314)\n            bad=next(r for r in rows if r['sca_id']=='900046')\n            self.assertTrue(bad['raw_reason'].startswith(\"'=\"))\n            self.assertEqual(json.loads((Path(d)/'snapshot.json').read_text()),before)\n        self.assertEqual(self.fixture,before)\n    def test_formula_vectors(self):\n        for text in ('=1',' +1','\\t@evil','\\r-1','\\n=1','\\ufeff=1','\\v=1','\\x00@evil','\\u2003=1'):\n            self.assertTrue(safe_cell(text).startswith(\"'\"))\n        self.assertEqual(safe_cell('普通文字'),'普通文字')\n    def test_multiple_host_weighted_counts(self):\n        other=copy.deepcopy(self.fixture['hosts'][0]);other['agent_id']='SYNTHETIC-002';other['checks']=[]\n        self.fixture['hosts'].append(other)\n        self.assertEqual(metrics(self.rows())['applicable'],614)\n        self.assertEqual(len(self.rows()),628)\n\n    def test_authored_controls_do_not_create_evidence(self):\n        from linuxgcb.batch1 import ADDED\n        by={r['sca_id']:r for r in self.rows()}\n        for n in ADDED:\n            self.assertIsNone(by[900000+n]['raw_result'])\n            self.assertEqual(by[900000+n]['state'],'MANUAL_PENDING' if n==141 else 'NOT_SCANNED')\n        self.fixture['hosts'][0]['checks'].append(dict(id=900141,result='passed'))\n        self.assertEqual(next(r for r in self.rows() if r['sca_id']==900141)['state'],'MANUAL_PENDING')\n        self.assertEqual(metrics(self.rows())['completeness'],0.0)\n\"\"\"以 JSON（YAML 1.2 子集）產生候選 SCA；只模擬輸出匹配，不執行命令。\"\"\"\nimport json\nimport re\nfrom functools import lru_cache\nfrom .catalog import ROOT, registry, digest\nfrom .batch1 import rules as batch_rules, disabled_service_rules\n\n\ndef definitions():\n    modes = '|'.join(format(n, 'o') for n in range(0o1000) if n & ~0o644 == 0)\n    return {**batch_rules(),\n        45: [('c:/usr/bin/stat -c %u:%g /etc/passwd', '^0:0$')],\n        46: [('c:/usr/bin/stat -c %a /etc/passwd', '^('+modes+')$')],\n        108: [('c:/usr/sbin/sysctl -n net.ipv4.ip_forward', '^0$'),\n              ('c:/usr/sbin/sysctl -n net.ipv6.conf.all.forwarding', '^0$')],\n        243: [('c:/usr/bin/systemctl show firewalld.service --property=LoadState', '^LoadState=loaded$'),\n              ('c:/usr/bin/systemctl show firewalld.service --property=ActiveState', '^ActiveState=active$'),\n              ('c:/usr/bin/systemctl show firewalld.service --property=UnitFileState', '^UnitFileState=enabled$')],\n        245: disabled_service_rules('nftables'),\n        269: [('c:/usr/sbin/sshd -T', '^permitrootlogin no$')],\n        270: [('c:/usr/sbin/sshd -T', '^permitemptypasswords no$')],\n    }\n\n\ndef build():\n    rows = registry()\n    for profile in ('base', 'firewalld', 'sshd'):\n        filename = 'linuxgcb_'+profile+'.yml'\n        checks = []\n        for row in rows:\n            if row['implementation'] != 'candidate' or row['profile'] != profile:\n                continue\n            checks.append(dict(id=row['sca_id'], title=row['gcb_id']+' '+row['title'],\n                description='Q1 執行審查 '+row['execution_review']+'；coverage='+row['coverage']+'；'+','.join(row['issue_ids'])+'；raw PASS 非已驗證符合。'+row['pending'],\n                compliance=[{'twgcb': [row['gcb_id']]}], regex_type='pcre2', condition='all',\n                rules=[target+' -> r:'+pattern for target, pattern in definitions()[int(row['gcb_id'][-4:])]]))\n        policy = dict(policy=dict(id='linuxgcb_rhel9_'+profile+'_v01', file=filename,\n                      name='RHEL9 GCB v1.2 '+profile+' v0.1 UNVALIDATED',\n                      description='未驗證候選政策；僅供核准 RHEL9 試點，非完整符合性檢核', regex_type='pcre2'),\n                      requirements=dict(title='僅 RHEL 9', description='角色由核准群組控制',\n                        condition='all', rules=['f:/etc/os-release -> r:^ID=\"?rhel\"?$',\n                                               'f:/etc/os-release -> r:^VERSION_ID=\"?9([.][0-9]+)*\"?$']),\n                      checks=checks)\n        (ROOT/'policies'/filename).write_text(json.dumps(policy, ensure_ascii=False, indent=2)+'\\n')\n    hashes = {p.name: digest(p) for p in sorted((ROOT/'policies').glob('*.yml'))}\n    (ROOT/'data/policy_hashes.json').write_text(json.dumps(hashes, indent=2)+'\\n')\n    from .coverage import write\n    write()\n    validate()\n\n\ndef require(condition):\n    if not condition:\n        raise ValueError('候選政策結構、mapping 或 hash 不符')\n\n\ndef validate():\n    rows = {r['sca_id']: r for r in registry()}\n    seen = set()\n    for path in sorted((ROOT/'policies').glob('*.yml')):\n        p = json.loads(path.read_text())\n        require(p['policy']['file'] == path.name and p['policy']['regex_type']=='pcre2')\n        require(p['requirements'] == dict(title='僅 RHEL 9', description='角色由核准群組控制',\n            condition='all', rules=['f:/etc/os-release -> r:^ID=\"?rhel\"?$',\n                                   'f:/etc/os-release -> r:^VERSION_ID=\"?9([.][0-9]+)*\"?$']))\n        for c in p['checks']:\n            require(c['id'] not in seen and rows[c['id']]['included'])\n            seen.add(c['id'])\n            require(c['regex_type'] == 'pcre2' and c['condition'] == 'all')\n            require(c['compliance'] == [{'twgcb': [rows[c['id']]['gcb_id']]}])\n            require(rows[c['id']]['policy_id'] == p['policy']['id'])\n            require(c['rules'] == [a+' -> r:'+b for a,b in definitions()[c['id']-900000]])\n            for rule in c['rules']:\n                target, pattern = rule.split(' -> r:')\n                require(target.startswith('c:/') and not any(x in target for x in ('|',';', '&&', '$', '`')))\n                parse_rule(rule)\n    require(seen == {900000+n for n in definitions()})\n    hashes = json.loads((ROOT/'data/policy_hashes.json').read_text())\n    require(hashes == {p.name:digest(p) for p in (ROOT/'policies').glob('*.yml')})\n    from .coverage import manifest\n    require(json.loads((ROOT/'data/coverage_manifest.json').read_text()) == manifest())\n    require(seen == {r['sca_id'] for r in rows.values() if r['implementation']=='candidate'})\n    return len(seen)\n\n\n@lru_cache(maxsize=1)\ndef supported_patterns():\n    return frozenset(p for rules in definitions().values() for _,p in rules) | {\n        '^ID=\"?rhel\"?$', '^VERSION_ID=\"?9([.][0-9]+)*\"?$'}\n\n\ndef parse_rule(rule):\n    \"\"\"明確有界子集：絕對路徑 c:/f: + 單一正向 r:；拒絕其他運算子。\"\"\"\n    if not isinstance(rule, str) or rule.count(' -> r:') != 1:\n        raise ValueError('不支援的規則語法')\n    target, pattern = rule.split(' -> r:')\n    if not re.fullmatch(r'[cf]:/[^\\n\\r]+', target) or any(x in target for x in (' -> ', ' && ', '|', ';', '`', '$')):\n        raise ValueError('不支援的目標')\n    # Python 並非 PCRE2；只接受實際發出的固定模式與測試用 ASCII literal。\n    if pattern not in supported_patterns() and not re.fullmatch(r'\\^[A-Za-z0-9_ =:/-]+\\$', pattern):\n        raise ValueError('未驗證的 PCRE2 語法')\n    try:\n        return target, re.compile(pattern, re.ASCII)\n    except re.error as exc:\n        raise ValueError('無效模式') from exc\n\n\ndef simulate(check, observations):\n    \"\"\"僅輸出匹配模型；執行失敗資訊不足回 UNRESOLVED，不冒充 Wazuh。\n\n# LinuxGCB Q1：既有 53 項候選品質整併\n\n僅離線開發，分支 `codex/linuxgcb-quality1`。來源 314 項 = 307 候選 + 7 排除；固定數字 ID 不變，僅審查既有 53 項，沒有擴充控制或 Dashboard。完整結論見 [Q1 審查](docs/QUALITY_REVIEW_Q1.md)。歷史交接保留原樣，過去 full 數量不代表本次核准。\n\n目前 coverage **full 0／partial 48／blocked 5**；53 項 execution_review 均 blocked，真機驗證 0、來源核准 0。離線審查已完成並記錄問題，不表示 review pass。非零退出且 stdout 符合仍可能 raw PASS；原生命令沒有已驗證的執行狀態保護。未新增 helper 或端點人工步驟。\n\nPython 3.10+ 標準函式庫，無安裝與網路需求：\n\n```bash\npython3 -m linuxgcb build\npython3 -m linuxgcb validate\npython3 -m unittest discover -s tests -v\npython3 -m linuxgcb report tests/fixtures/snapshot.json --out out/q1-synthetic --now 2026-10-30T00:00:00Z\n```\n\nCLI 不執行政策命令。build 核對 XLSX/DOCX hash，重建 registry、三份候選政策、policy hashes 與 schema v2 coverage manifest。`reviewed` 包含全部 53 項來源 DOCX cells、問題代碼與處置；validate 重算對帳，並非 Wazuh YAML／PCRE2 驗收。原始 XLSX、DOCX、controls.json、inventory.json 不修改。\n\n報表保存 raw_result、raw_reason、evidence_status、coverage、execution_review、verified_compliance。raw passed 在 blocked／partial 時為 MANUAL_PENDING；raw failed 保留候選 FAIL 觀察，但不列完整符合判定。完整率只計 verified_compliance；目前為 0%。有效核准不適用需 approver、reason、ticket、evidence、expires；錯誤不能藉核准 N/A 隱藏。缺少備份檔或服務不自動 PASS／FAIL／核准 N/A；輸入明確 missing／absence_unverified 時列待審，tool_error／permission_error／timeout 為 ERROR。無法分類的原始結果仍保留，不能藉缺失原因推測適用性。\n\n合成 fixture 僅有 6 筆原始觀察，53 項候選的 authored 數量不算 scanned。`out/` 的 HTML、CSV、summary.json 與原始 snapshot.json 為忽略產物；同名輸出會覆寫。測試固定時間不能用於正式資料。\n\n模擬器只支援實際發出的 all、c:/f: 正向單一 r:，模式限現有規則與 ASCII literal；拒絕 any／none、其他運算子與未驗證語法。逐 LF 行搜尋，退出碼與 stderr 不提供保護；Python regex 並非 PCRE2。CRLF、Unicode、Wazuh 的緩衝／stderr／timeout／argv 與錯誤辨識都須真機驗證。\n\n有效 Wazuh 依據為 docs/references 內 creating-custom-policies、how-it-works、how-to-configure、internal-options 快照；sca-custom-policies 是 soft404，不作依據。本次無外網查詢、SSH、生產 API、秘密、sudo、安裝、服務變更或 Excel remediation。`sca.remote_commands=1` 沿用已核准的一次性 Agent 安裝 bootstrap，並非集中 agent.conf 開關。\n\nHermes 負責獨立驗收、整合與溝通。本次留下未提交 diff，不主張父代理接受；後續限 [NEXT_STEPS](NEXT_STEPS.md) 的 Q1 驗收。\ncontrols.json\ncoverage_manifest.json\ninventory.json\npolicy_hashes.json\nscope_registry.json\n<class 'dict'>\nlinuxgcb_rhel9_base_v01 {'scan_id': 124019257, 'checks': [{'id': 900030, 'title': 'TWGCB-01-012-0030 autofs服務', 'description': 'Q1 執行審查 blocked；coverage=blocked；Q1-01,Q1-06,Q1-07；raw PASS 非已驗證符合。', 'rationale': None, 'remediation': None, 'command': '/usr/bin/systemctl show autofs.service --property=LoadState,/usr/bin/systemctl show autofs.service --property=ActiveState,/usr/bin/systemctl show autofs.service --property=LoadState --property=UnitFileState', 'result': 'passed', 'reason': ''}, {'id': 900033, 'title': 'TWGCB-01-012-0033 sudo套件', 'description': 'Q1 執行審查 blocked；coverage=partial；Q1-01；raw PASS 非已驗證符合。', 'rationale': None, 'remediation': None, 'command': '/usr/bin/rpm -q --queryformat %{NAME}:installed sudo', 'result': 'passed', 'reason': ''}, {'id': 900045, 'title': 'TWGCB-01-012-0045 /etc/passwd檔案所有權', 'description': 'Q1 執行審查 blocked；coverage=partial；Q1-01,Q1-03,Q1-04；raw PASS 非已驗證符合。', 'rationale': None, 'remediation': None, 'command': '/usr/bin/stat -c %u:%g /etc/passwd', 'result': 'passed', 'reason': ''}, {'id': 900046, 'title': 'TWGCB-01-012-0046 /etc/passwd檔案權限', 'description': 'Q1 執行審查 blocked；coverage=partial；Q1-01,Q1-03,Q1-04；raw PASS 非已驗證符合。', 'rationale': None, 'remediation': None, 'command': '/usr/bin/stat -c %a /etc/passwd', 'result': 'passed', 'reason': ''}, {'id': 900047, 'title': 'TWGCB-01-012-0047 /etc/shadow檔案所有權', 'description': 'Q1 執行審查 blocked；coverage=partial；Q1-01,Q1-03,Q1-04；raw PASS 非已驗證符合。', 'rationale': None, 'remediation': None, 'command': '/usr/bin/stat -c %U:%G /etc/shadow', 'result': 'passed', 'reason': ''}, {'id': 900048, 'title': 'TWGCB-01-012-0048 /etc/shadow檔案權限', 'description': 'Q1 執行審查 blocked；coverage=partial；Q1-01,Q1-03,Q1-04；raw PASS 非已驗證符合。', 'rationale': None, 'remediation': None, 'command': '/usr/bin/stat -c %a /etc/shadow', 'result': 'passed\nlinuxgcb_rhel9_firewalld_v01 {'scan_id': 168004104, 'checks': [{'id': 900242, 'title': 'TWGCB-01-012-0242 firewalld防火牆套件', 'description': 'Q1 執行審查 blocked；coverage=partial；Q1-01；raw PASS 非已驗證符合。', 'rationale': None, 'remediation': None, 'command': '/usr/bin/rpm -q --queryformat %{NAME}:installed firewalld', 'result': 'passed', 'reason': ''}, {'id': 900243, 'title': 'TWGCB-01-012-0243 firewalld服務', 'description': 'Q1 執行審查 blocked；coverage=partial；Q1-01,Q1-06；raw PASS 非已驗證符合。', 'rationale': None, 'remediation': None, 'command': '/usr/bin/systemctl show firewalld.service --property=LoadState,/usr/bin/systemctl show firewalld.service --property=ActiveState,/usr/bin/systemctl show firewalld.service --property=UnitFileState', 'result': 'passed', 'reason': ''}, {'id': 900245, 'title': 'TWGCB-01-012-0245 nftables服務', 'description': 'Q1 執行審查 blocked；coverage=blocked；Q1-01,Q1-06,Q1-07；raw PASS 非已驗證符合。', 'rationale': None, 'remediation': None, 'command': '/usr/bin/systemctl show nftables.service --property=LoadState,/usr/bin/systemctl show nftables.service --property=ActiveState,/usr/bin/systemctl show nftables.service --property=LoadState --property=UnitFileState', 'result': 'passed', 'reason': ''}]}\nlinuxgcb_rhel9_sshd_v01 {'scan_id': 1953113830, 'checks': [{'id': 900256, 'title': 'TWGCB-01-012-0256 /etc/ssh/sshd_config檔案所有權', 'description': 'Q1 執行審查 blocked；coverage=partial；Q1-01,Q1-03,Q1-04；raw PASS 非已驗證符合。', 'rationale': None, 'remediation': None, 'command': '/usr/bin/stat -c %U:%G /etc/ssh/sshd_config', 'result': 'passed', 'reason': ''}, {'id': 900257, 'title': 'TWGCB-01-012-0257 /etc/ssh/sshd_config檔案權限', 'description': 'Q1 執行審查 blocked；coverage=partial；Q1-01,Q1-03,Q1-04；raw PASS 非已驗證符合。', 'rationale': None, 'remediation': None, 'command': '/usr/bin/stat -c %a /etc/ssh/sshd_config', 'result': 'passed', 'reason': ''}, {'id': 900269, 'title': 'TWGCB-01-012-0269 SSH PermitRootLogin參數', 'description': 'Q1 執行審查 blocked；coverage=partial；Q1-01,Q1-08；raw PASS 非已驗證符合。僅 sshd -T 預設情境；Include/Match 與使用者/來源矩陣待審', 'rationale': None, 'remediation': None, 'command': '/usr/sbin/sshd -T', 'result': 'failed', 'reason': ''}, {'id': 900270, 'title': 'TWGCB-01-012-0270 SSH PermitEmptyPasswords參數', 'description': 'Q1 執行審查 blocked；coverage=partial；Q1-01,Q1-08；raw PASS 非已驗證符合。僅 sshd -T 預設情境；Include/Match 與使用者/來源矩陣待審', 'rationale': None, 'reme
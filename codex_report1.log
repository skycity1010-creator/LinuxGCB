{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"cp /home/skycity1010/projects/LinuxGCB/data/realhost_scan_20261031_r2.json tests/fixtures/realhost_r2.json\ncat > linuxgcb/snapshot.py <<'PY'\n\\\"\\\"\\\"離線 Manager SQLite 匯出轉換；不推測掃描時間或補造證據。\\\"\\\"\\\"\nimport copy\nimport json\nfrom datetime import datetime, timezone\nfrom .catalog import ROOT, digest\nfrom .collector import timestamp\n\nLABEL = 'REAL EVIDENCE agent010／真實掃描證據（agent 010 / RHEL9 192.168.1.61）'\n\n\ndef scan_time(value):\n    if isinstance(value, (int, float)) and not isinstance(value, bool):\n        return datetime.fromtimestamp(value, timezone.utc).isoformat()\n    return timestamp(value).isoformat()\n\n\ndef convert(path, scan_info=None):\n    \\\"\\\"\\\"scan_info: {policy_id: {end_scan: UTC epoch 或含時區 ISO8601}}。\n\n    scan_info 必須來自同次離線 DB 匯出，按 policy_id 對應，絕不以 hash join scan_id。\n    \\\"\\\"\\\"\n    from pathlib import Path\n    path = Path(path)\n    dump = json.loads(path.read_text())\n    policies = {}\n    for p in sorted((ROOT/'policies').glob('*.yml')):\n        policy = json.loads(p.read_text())\n        policies[policy['policy']['id']] = {c['id'] for c in policy['checks']}\n    if not isinstance(dump, dict) or not dump or not set(dump) <= set(policies):\n        raise ValueError('未知或空白 policy 匯出')\n    checks, scans, times, warnings, seen = [], {}, [], [], set()\n    for pid, data in dump.items():\n        scans[pid] = data['scan_id']\n        info = (scan_info or {}).get(pid, data.get('sca_scan_info', {}))\n        end = info.get('end_scan')\n        if end is None:\n            warnings.append(pid+': 缺少 sca_scan_info.end_scan；scanned_at 不推造')\n        else:\n            times.append(scan_time(end))\n        for c in data['checks']:\n            sid = c['id']\n            if not isinstance(sid, int) or isinstance(sid, bool) or sid not in policies[pid] or sid in seen:\n                raise ValueError('未知、重複或錯誤 policy 的 check ID')\n            if 'result' not in c:\n                raise ValueError('check 缺少 result')\n            seen.add(sid)\n            check = copy.deepcopy(c)\n            check['policy_id'] = pid\n            checks.append(check)\n    return dict(schema_version=1, synthetic=False, label=LABEL,\n        source_sha256=digest(next(ROOT.glob('*.xlsx'))),\n        policy_hashes={p.name: digest(p) for p in sorted((ROOT/'policies').glob('*.yml'))},\n        manager_dump_sha256=digest(path), scan_info=copy.deepcopy(scan_info), warnings=warnings,\n        hosts=[dict(agent_id='010', approved_profiles=['base','firewalld','sshd'],\n                    scanned_at=min(times) if len(times)==len(dump) else None,\n                    policy_scanned_at={pid: scan_time((scan_info or {}).get(pid, dump[pid].get('sca_scan_info', {}))['end_scan'])\n                                       for pid in dump if (scan_info or {}).get(pid, dump[pid].get('sca_scan_info', {})).get('end_scan') is not None},\n                    scan_ids=scans, checks=checks)])\nPY\npython3 - <<'PY'\np='linuxgcb/__main__.py'\ns=open(p).read().replace('from .collector import timestamp','from .collector import timestamp\\\\nfrom .snapshot import convert')\ns=s.replace(\\\"    args = parser.parse_args()\\\", \\\"    snapshot = sub.add_parser('snapshot', help='離線 Manager DB JSON 轉 snapshot v1')\\\\n    snapshot.add_argument('manager_dump')\\\\n    snapshot.add_argument('--out', required=True)\\\\n    snapshot.add_argument('--scan-info', help='同次離線 sca_scan_info JSON，依 policy_id 對應 end_scan')\\\\n    args = parser.parse_args()\\\")\ns=s.replace(\\\"    else:\\\\n        validate()\\\", \\\"    elif args.command == 'snapshot':\\\\n        validate()\\\\n        result = convert(args.manager_dump, json.loads(Path(args.scan_info).read_text()) if args.scan_info else None)\\\\n        target = Path(args.out)\\\\n        target.parent.mkdir(parents=True, exist_ok=True)\\\\n        target.write_text(json.dumps(result, ensure_ascii=False, indent=2)+'\\\\\\\\n')\\\\n        print(json.dumps(result['warnings'], ensure_ascii=False))\\\\n    else:\\\\n        validate()\\\")\nopen(p,'w').write(s)\np='linuxgcb/report.py';s=open(p).read();s=s.replace(\\\"    all_rows, host_ids = [], set()\\\", \\\"    policy_checks = {}\\\\n    for path in (ROOT/'policies').glob('*.yml'):\\\\n        policy_checks.update({c['id']: c for c in json.loads(path.read_text())['checks']})\\\\n    all_rows, host_ids = [], set()\\\")\ns=s.replace(\\\"                category=control['category']\\\", \\\"                command=c.get('command', ','.join(r.split(' -> r:')[0][2:] for r in policy_checks.get(control['sca_id'], {}).get('rules', []))),\\\\n                remediation=policy_checks.get(control['sca_id'], {}).get('remediation'),\\\\n                raw_remediation=c.get('remediation'),\\\\n                remediation_status='provided' if policy_checks.get(control['sca_id'], {}).get('remediation') else '政策未提供 remediation',\\\\n                category=control['category']\\\")\ns=s.replace(\\\"    page += '<p>raw_result\\\", \\\"    page += '<p>'+esc(snapshot.get('label', ''))+'</p>'\\\\n    page += '<p>'+esc('; '.join(snapshot.get('warnings', [])))+'</p>'\\\\n    page += '<p>raw_result\\\")\nopen(p,'w').write(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc 'cat linuxgcb/batch6.py; cat linuxgcb/coverage.py; cat linuxgcb/policy.py'","aggregated_output":"\"\"\"P2B6 source-bound offline candidates, direct w_strtok Python argv.\"\"\"\nimport inspect\nimport json\nfrom functools import lru_cache\nfrom pathlib import Path\nfrom . import p2b6_runtime\nfrom .argv import quote_argument\nADDED = set(range(206,242)) | set(range(309,315))\n\n\n@lru_cache(maxsize=1)\ndef sources():\n    from scripts.inventory import extract\n    root = Path(__file__).resolve().parents[1]\n    return {int(r['gcb_id'][-4:]):r for r in extract(next(root.glob('*.xlsx'))) if int(r['gcb_id'][-4:]) in ADDED}\n\n\ndef script(n):\n    return inspect.getsource(p2b6_runtime) + '\\ntry:\\n    ok = check(' + str(n) + \")\\nexcept (OSError, ValueError, IndexError, KeyError):\\n    ok = False\\nif ok:\\n    print('PASS')\\n\"\n\n\n@lru_cache(maxsize=1)\ndef rules():\n    return {n:[('c:/usr/bin/python3 -c ' + quote_argument(script(n)), '^PASS$')] for n in sorted(ADDED)}\n\n\ndef mechanism(n):\n    return '逐條來源唯讀 predicate；直接 python3 -c argv；單一 PASS commit'\n\n\ndef caveat(n):\n    extra = {\n        206:'來源 Retry 大寫解讀為 libpwquality retry 小寫；待批。',\n        208:'同時要求來源 PASS_MIN_LEN 與 minlen；RHEL9 PASS_MIN_LEN 效力待審。',\n        220:'來源腳本與文字模組混用；採 pam_pwhistory remember>=3，單查 system-auth；待批。',\n        223:'只檢查預設值；既有帳號 chage 效果待人工證據，不讀 shadow。',\n        224:'只檢查預設值；既有帳號 chage 效果待人工證據，不讀 shadow。',\n        225:'只檢查預設值；既有帳號 chage 效果待人工證據，不讀 shadow。',\n        226:'useradd -D -f 對應 /etc/default/useradd INACTIVE；既有帳號待人工證據。',\n        227:'依來源 login.defs FAIL_DELAY>=4，未替換成 PAM delay。',\n        228:'依來源 login.defs CREATE_HOME，未改查 /etc/default/useradd。',\n        231:'rpm -q kbd：0 installed、1 absent、其他錯誤無 PASS；不用 rpm -qa。',\n        235:'依來源 UID_MIN（非 SYS_UID_MAX）；root/+ 排除，shell 另排除 sync/shutdown/halt；passwd -S 唯讀確認 L/LK。不讀 shadow。',\n        236:'同時要求 bashrc 與 profile/profile.d；保守靜態宣告子集，條件分支/載入順序與 readonly/export 效力待審。',\n        239:'同時要求 bashrc 與 profile/profile.d；umask 位元包含027，含007因不符合來源027不接受；shell 分支待審。',\n        241:'確認 wheel 包含 root；其他允許成員名單需人工核准。',\n        309:'依來源同時檢查 /root/.bash_profile 與 /root/.bashrc，缺檔失敗。',\n        312:'檢查渲染堆疊 pam_unix 無 nullok；authselect feature 狀態及 apply-changes 待真機。',\n    }.get(n,'')\n    if n in (232,233,237): extra += '只讀來源 dconf 系統來源檔；缺檔無 PASS；dconf update 編譯資料庫、profile/locks 載入與桌面有效值待真機。'\n    if n in (207,220,222,312,313,314): extra += '讀 /etc/pam.d 渲染堆疊並跟隨 symlink；authselect custom profile 與執行中效力待真機。'\n    return extra + 'P2B6 UNVALIDATED；human_review_pending；execution_review=blocked；唯讀 Python 標準庫，錯誤/缺失無成功輸出；w_strtok/PCRE2/timeout 待真機。'\n\"\"\"可重建的逐項來源對照與涵蓋 manifest；不執行候選命令。\"\"\"\nimport json\nfrom collections import Counter\nfrom zipfile import ZipFile\nfrom xml.etree import ElementTree as ET\nfrom .catalog import ROOT, registry, digest\nfrom .batch1 import ADDED, caveat\nfrom .quality import status\nfrom .batch3 import ADDED as BATCH3, caveat as batch3_caveat, mechanism as batch3_mechanism, sources as batch3_sources\nfrom .batch2 import ADDED as BATCH2, caveat as batch2_caveat\n\nfrom .batch6 import ADDED as BATCH6, caveat as batch6_caveat, sources as batch6_sources\n\ndef manifest():\n    ns={'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}\n    docx=next(ROOT.glob('*.docx'))\n    xml=ET.fromstring(ZipFile(docx).read('word/document.xml'))\n    # ID 的 runs 必須在段落內接回，cell 再以換行串接段落。\n    tables=[]\n    for tr in xml.findall('.//w:tr',ns):\n        cells=['\\n'.join(''.join(t.text or '' for t in p.findall('.//w:t',ns))\n                         for p in cell.findall('.//w:p',ns)) for cell in tr.findall('w:tc',ns)]\n        tables.append(cells)\n    entries=[]\n    for row in registry():\n        n=row['sca_id']-900000\n        if row['implementation'] != 'candidate': continue\n        matches=[c for c in tables if row['gcb_id'] in c]\n        historical=[]\n        if n in BATCH6:\n            method=batch6_sources()[n]['configuration_method']\n            historical=[c for c in matches if c[-2] != method or c[-1] != row['expected']]\n            matches=[c for c in matches if c[-2] == method and c[-1] == row['expected']]\n        elif n in BATCH3:\n            method=batch3_sources()[n]['configuration_method']\n            historical=[c for c in matches if c[-2] != method or c[-1] != row['expected']]\n            matches=[c for c in matches if c[-2] == method and c[-1] == row['expected']]\n        elif n in BATCH2:\n            historical=[c for c in matches if c[-1] != row['expected']]\n            matches=[c for c in matches if c[-1] == row['expected']]\n        if not matches or any(c[-2:] != matches[0][-2:] for c in matches) or row['expected'] not in matches[0]:\n            raise ValueError('DOCX ID／期望欄無法唯一核對：'+row['gcb_id'])\n        entries.append(dict(gcb_id=row['gcb_id'],sca_id=row['sca_id'],\n            source_sheet=row['source_sheet'],source_row=row['source_row'],expected=row['expected'],\n            docx_historical_cells=historical,docx_cells=matches[0],docx_occurrences=len(matches),docx_all_cells=matches,docx_sha256=digest(docx),\n            mechanism=('P2B6 direct Python argv source predicates' if n in BATCH6 else batch3_mechanism(n) if n in BATCH3 else 'BATCH2 c: shell 成功輸出保護、正向/否定逐行 PCRE2、all 聚合' if n in BATCH2 else '原生 c: 絕對路徑、正向逐行 PCRE2、all 聚合；無 shell'),\n            caveats=batch6_caveat(n) if n in BATCH6 else batch3_caveat(n) if n in BATCH3 else batch2_caveat(n) if n in BATCH2 else caveat(n) if n in ADDED else row['pending'],tests=[('tests/test_p2b6.py#' if n in BATCH6 else 'tests/fixtures/p2b3/cases.json#' if n in BATCH3 else 'tests/fixtures/rule_outputs.json#')+str(row['sca_id']), 'tests/test_p2b6.py' if n in BATCH6 else 'tests/test_p2b3.py' if n in BATCH3 else 'tests/test_batch2.py' if n in BATCH2 else 'tests/test_quality_q1.py'],\n            cases=(['isolated_positive','isolated_negative','missing_no_commit','argv_roundtrip'] if n in BATCH6 else ['positive','negative','missing','empty','error','nonzero_matching'])+(['commented'] if n in BATCH3 and (148 <= n <= 173 or n==145) else [])+(['rpm_other_error'] if n in (92,96,99,100) else []),\n            review_status='human_review_pending',**status(n)))\n    rows=registry();counts=Counter(r['implementation'] for r in rows)\n    return dict(schema_version=2,label='離線候選涵蓋；非實機證據',\n        counts=dict(source=len(rows),included=sum(r['included'] for r in rows),excluded=counts['excluded'],\n                    before=7,added=len(ADDED)+len(BATCH2)+len(BATCH3)+len(BATCH6),batch6_before=146,batch6_added=42,batch6_after=188,batch3_added=len(BATCH3),batch3_before=97,batch3_after=97+len(BATCH3),batch2_added=len(BATCH2),implemented=counts['candidate'],remaining=counts['pending'],\n                    full=sum(r['coverage']=='full' for r in rows),partial=sum(r['coverage']=='partial' for r in rows),\n                    blocked=sum(r['coverage']=='blocked' for r in rows),reviewed=len(entries),execution_blocked=len(entries),live_validated=0),\n        reviewed=entries)\n\ndef write():\n    m=manifest()\n    (ROOT/'data/coverage_manifest.json').write_text(json.dumps(m,ensure_ascii=False,indent=2)+'\\n')\n    return m\n\"\"\"以 JSON（YAML 1.2 子集）產生候選 SCA；只模擬輸出匹配，不執行命令。\"\"\"\nimport json\nimport re\nfrom functools import lru_cache\nfrom .catalog import ROOT, registry, digest\nfrom .batch1 import rules as batch_rules, disabled_service_rules\nfrom .expected import PREFIX, values, parse_description\nfrom .batch2 import rules as batch2_rules, ADDED as BATCH2\nfrom .batch3 import rules as batch3_rules, ADDED as BATCH3\nfrom .batch6 import rules as batch6_rules, ADDED as BATCH6\nfrom .argv import w_strtok\n\n\ndef definitions():\n    modes = '|'.join(format(n, 'o') for n in range(0o1000) if n & ~0o644 == 0)\n    return {**batch_rules(), **batch2_rules(), **batch3_rules(), **batch6_rules(),\n        45: [('c:/usr/bin/stat -c %u:%g /etc/passwd', '^0:0$')],\n        46: [('c:/usr/bin/stat -c %a /etc/passwd', '^('+modes+')$')],\n        108: [('c:/usr/sbin/sysctl -n net.ipv4.ip_forward', '^0$'),\n              ('c:/usr/sbin/sysctl -n net.ipv6.conf.all.forwarding', '^0$')],\n        243: [('c:/usr/bin/systemctl show firewalld.service --property=LoadState', '^LoadState=loaded$'),\n              ('c:/usr/bin/systemctl show firewalld.service --property=ActiveState', '^ActiveState=active$'),\n              ('c:/usr/bin/systemctl show firewalld.service --property=UnitFileState', '^UnitFileState=enabled$')],\n        245: disabled_service_rules('nftables'),\n        269: [('c:/usr/sbin/sshd -T', '^permitrootlogin no$')],\n        270: [('c:/usr/sbin/sshd -T', '^permitemptypasswords no$')],\n    }\n\n\ndef build():\n    rows = registry()\n    expected = values()\n    for profile in ('base', 'firewalld', 'sshd'):\n        filename = 'linuxgcb_'+profile+'.yml'\n        checks = []\n        for row in rows:\n            if row['implementation'] != 'candidate' or row['profile'] != profile:\n                continue\n            checks.append(dict(id=row['sca_id'], title=row['gcb_id']+' '+row['title'],\n                description=PREFIX+expected[row['gcb_id']]+(' ｜ P2B6 執行審查 ' if row['sca_id']-900000 in BATCH6 else ' ｜ P2B3 執行審查 ' if row['sca_id']-900000 in BATCH3 else ' ｜ BATCH2 執行審查 ' if row['sca_id']-900000 in BATCH2 else ' ｜ Q1 執行審查 ')+row['execution_review']+'；coverage='+row['coverage']+'；'+','.join(row['issue_ids'])+'；raw PASS 非已驗證符合。'+row['pending'],\n                compliance=[{'twgcb': [row['gcb_id']]}], regex_type='pcre2', condition='all',\n                rules=[emit_rule(target, pattern) for target, pattern in definitions()[int(row['gcb_id'][-4:])]]))\n        policy = dict(policy=dict(id='linuxgcb_rhel9_'+profile+'_v01', file=filename,\n                      name='RHEL9 GCB v1.2 '+profile+' v0.1 UNVALIDATED',\n                      description='未驗證候選政策；僅供核准 RHEL9 試點，非完整符合性檢核', regex_type='pcre2'),\n                      requirements=dict(title='僅 RHEL 9', description='角色由核准群組控制',\n                        condition='all', rules=['f:/etc/os-release -> r:^ID=\"?rhel\"?$',\n                                               'f:/etc/os-release -> r:^VERSION_ID=\"?9([.][0-9]+)*\"?$']),\n                      checks=checks)\n        (ROOT/'policies'/filename).write_text(json.dumps(policy, ensure_ascii=False, indent=2)+'\\n')\n    hashes = {p.name: digest(p) for p in sorted((ROOT/'policies').glob('*.yml'))}\n    (ROOT/'data/policy_hashes.json').write_text(json.dumps(hashes, indent=2)+'\\n')\n    from .coverage import write\n    write()\n    validate()\n\n\ndef require(condition):\n    if not condition:\n        raise ValueError('候選政策結構、mapping 或 hash 不符')\n\n\ndef validate():\n    rows = {r['sca_id']: r for r in registry()}\n    seen = set()\n    for path in sorted((ROOT/'policies').glob('*.yml')):\n        p = json.loads(path.read_text())\n        require(p['policy']['file'] == path.name and p['policy']['regex_type']=='pcre2')\n        require(p['requirements'] == dict(title='僅 RHEL 9', description='角色由核准群組控制',\n            condition='all', rules=['f:/etc/os-release -> r:^ID=\"?rhel\"?$',\n                                   'f:/etc/os-release -> r:^VERSION_ID=\"?9([.][0-9]+)*\"?$']))\n        for c in p['checks']:\n            require(c['id'] not in seen and rows[c['id']]['included'])\n            seen.add(c['id'])\n            require(parse_description(c.get('description')) == values()[rows[c['id']]['gcb_id']])\n            require((' ｜ P2B6 ' if c['id']-900000 in BATCH6 else ' ｜ P2B3 ' if c['id']-900000 in BATCH3 else ' ｜ BATCH2 ' if c['id']-900000 in BATCH2 else ' ｜ Q1 ') in c['description'])\n            require(c['regex_type'] == 'pcre2' and c['condition'] == 'all')\n            require(c['compliance'] == [{'twgcb': [rows[c['id']]['gcb_id']]}])\n            require(rows[c['id']]['policy_id'] == p['policy']['id'])\n            require(c['rules'] == [emit_rule(a,b) for a,b in definitions()[c['id']-900000]])\n            for rule in c['rules']:\n                target, _ = rule.split(' -> ', 1)\n                require(target.removeprefix('not ').startswith('c:/'))\n                if c['id']-900000 not in BATCH2 | BATCH3 | BATCH6:\n                    require(not any(x in target for x in ('|',';', '&&', '$', '`')))\n                parse_rule(rule)\n    require(seen == {900000+n for n in definitions()})\n    hashes = json.loads((ROOT/'data/policy_hashes.json').read_text())\n    require(hashes == {p.name:digest(p) for p in (ROOT/'policies').glob('*.yml')})\n    from .coverage import manifest\n    require(json.loads((ROOT/'data/coverage_manifest.json').read_text()) == manifest())\n    require(seen == {r['sca_id'] for r in rows.values() if r['implementation']=='candidate'})\n    return len(seen)\n\n\n@lru_cache(maxsize=1)\ndef supported_patterns():\n    return frozenset(p.lstrip('!') for rules in definitions().values() for _,p in rules) | {\n        '^ID=\"?rhel\"?$', '^VERSION_ID=\"?9([.][0-9]+)*\"?$'}\n\n\ndef emit_rule(target, pattern):\n    return ('not '+target+' -> r:'+pattern[1:]) if pattern.startswith('!') else target+' -> r:'+pattern\n\n\n@lru_cache(maxsize=1)\ndef batch2_emitted():\n    return {emit_rule(t,p) for rules in batch2_rules().values() for t,p in rules}\n\n\n@lru_cache(maxsize=1)\ndef batch3_emitted():\n    return {emit_rule(t,p) for rules in batch3_rules().values() for t,p in rules}\n\n\ndef parse_rule(rule):\n    \"\"\"Legacy bounded grammar plus exact allowlist of BATCH2 emitted rules.\"\"\"\n    if not isinstance(rule, str):\n        raise ValueError('不支援的規則語法')\n    if rule in {emit_rule(t,p) for rs in batch6_rules().values() for t,p in rs}:\n        target, expression = rule.split(' -> ', 1)\n        argv = w_strtok(target[2:])\n        if len(argv) != 3 or argv[:2] != ['/usr/bin/python3', '-c']:\n            raise ValueError('Invalid Python argv')\n        return target, re.compile(expression.split(':',1)[1], re.ASCII)\n    if rule in batch2_emitted() or rule in batch3_emitted():\n        target, expression = rule.split(' -> ', 1)\n        argv = w_strtok(target.removeprefix('not ')[2:])\n        if len(argv) != 3 or argv[:2] != ['/bin/sh', '-c']:\n            raise ValueError('Invalid wm_exec shell argv')\n        return target.removeprefix('not '), re.compile(expression.split(':',1)[1], re.ASCII)\n    if rule.count(' -> r:') != 1:\n        raise ValueError('不支援的規則語法')\n    target, pattern = rule.split(' -> r:')\n    if not re.fullmatch(r'[cf]:/[^\\n\\r]+', target) or any(x in target for x in (' -> ', ' && ', '|', ';', '`', '$')):\n        raise ValueError('不支援的目標')\n    if pattern not in supported_patterns() and not re.fullmatch(r'\\^[A-Za-z0-9_ =:/-]+\\$', pattern):\n        raise ValueError('未驗證的 PCRE2 語法')\n    try:\n        return target, re.compile(pattern, re.ASCII)\n    except re.error as exc:\n        raise ValueError('無效模式') from exc\n\n\ndef simulate(check, observations):\n    \"\"\"僅輸出匹配模型；執行失敗資訊不足回 UNRESOLVED，不冒充 Wazuh。\n\n    FIX-3 模擬 OS_StrBreak 的前 256 行上限（wm_sca.c:1749）。\n    FIX-1 同一 command 的多行輸出仍按逐行存在匹配；alternation 是單一\n    正向 regex，規則間維持 all，不以空輸出或 stderr 推論 not-found。\n    所有項目 exit_code 不參與輸出匹配（wm_exec 正常結束仍回 0），\n    並以 emitted shell guard 確保失敗不發布輸出或成功標記。\n    明確 engine_result 可表示真機／fixture\n    的 Not applicable；error 只表示未取得可靠輸出，不能預測引擎結果。\n    \"\"\"\n    if check.get('regex_type', 'pcre2') != 'pcre2':\n        raise ValueError('只支援明確 PCRE2 候選子集')\n    if check.get('condition') != 'all':\n        raise ValueError('輸出模型只支援目前發出的 all 子集')\n    if not isinstance(check.get('rules'), list) or not check['rules']:\n        raise ValueError('規則不得為空')\n    parsed = [parse_rule(rule) for rule in check['rules']]\n    outcomes = []\n    for rule, (target, pattern) in zip(check['rules'], parsed):\n        obs = observations.get(target)\n        if target.startswith('f:') and obs is not None and obs.get('exists') is False:\n            outcomes.append('NOT_APPLICABLE')\n            continue\n        if obs is None or obs.get('error'):\n            outcomes.append('UNRESOLVED')\n        elif obs.get('engine_result') == 'NOT_APPLICABLE':\n            outcomes.append('NOT_APPLICABLE')\n        elif not isinstance(obs.get('stdout'), str):\n            raise ValueError('觀察必須提供字串 stdout')\n        else:\n            matched = any(pattern.search(line) for line in obs['stdout'].split('\\n')[:256])\n            if rule.startswith('not '):\n                matched = not matched\n            outcomes.append('PASS' if matched else 'FAIL')\n    # 官方 all：任何 FAIL 優先；未知執行不擅自轉成 N/A。\n    if 'FAIL' in outcomes:\n        return 'FAIL'\n    if 'UNRESOLVED' in outcomes:\n        return 'UNRESOLVED'\n    return 'NOT_APPLICABLE' if 'NOT_APPLICABLE' in outcomes else 'PASS'\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"cat linuxgcb/catalog.py | head -150; cat linuxgcb/quality.py | head -130; python3 - <<'PY'\nfrom scripts.inventory import extract\nfrom pathlib import Path\nns={32,*range(34,45),*range(61,92),*range(303,308)}\nfor r in extract(next(Path('.').glob('*.xlsx'))):\n if int(r['gcb_id'][-4:]) in ns: print(r['gcb_id'],r['title'], '\\\\n',r['configuration_method'],'\\\\nEXPECTED',r['expected'],'\\\\n')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"cat linuxgcb/catalog.py | head -150; cat linuxgcb/quality.py | head -130; python3 - <<'PY'\nfrom scripts.inventory import extract\nfrom pathlib import Path\nns={32,*range(34,45),*range(61,92),*range(303,308)}\nfor r in extract(next(Path('.').glob('*.xlsx'))):\n if int(r['gcb_id'][-4:]) in ns: print(r['gcb_id'],r['title'], '\\\\n',r['configuration_method'],'\\\\nEXPECTED',r['expected'],'\\\\n')\nPY\"","aggregated_output":"\"\"\"固定來源、候選範圍與保守分類。\"\"\"\nimport hashlib\nimport json\nfrom pathlib import Path\nfrom scripts.inventory import extract\nfrom .batch1 import ADDED\nfrom .quality import status\nfrom .batch3 import ADDED as BATCH3\nfrom .batch6 import ADDED as BATCH6\nfrom .batch2 import ADDED as BATCH2\n\nROOT = Path(__file__).resolve().parents[1]\nXLSX_HASH = '7d752b639a1e780df08814c6252efadd3ea2711eaa5c9d91c070b84a296c0247'\nDOCX_HASH = '986effd9501b1fd97776129c6691cf8fc98246bd04514347322f3337508e0e5b'\nIMPLEMENTED = {45: 'base', 46: 'base', 108: 'base', 243: 'firewalld',\n               245: 'firewalld', 269: 'sshd', 270: 'sshd'}\nIMPLEMENTED.update({n: ('sshd' if n in (256,257) else 'firewalld' if n==242 else 'base') for n in ADDED})\nIMPLEMENTED.update({n: ('sshd' if n >= 254 else 'base') for n in BATCH2})\nIMPLEMENTED.update({n: 'base' for n in BATCH3})\nIMPLEMENTED.update({n: 'base' for n in BATCH6})\nPARTIAL = {141: '僅來源設定方法明列 audit.rules；其餘 rules.d 規則檔集合尚未覆蓋',\n           108: '僅雙協定即時值；持久設定來源、覆寫順序與路由角色待審',\n           269: '僅 sshd -T 預設情境；Include/Match 與使用者/來源矩陣待審',\n           270: '僅 sshd -T 預設情境；Include/Match 與使用者/來源矩陣待審'}\n\n\ndef digest(path):\n    return hashlib.sha256(path.read_bytes()).hexdigest()\n\n\ndef registry():\n    source = next(ROOT.glob('*.xlsx'))\n    docx = next(ROOT.glob('*.docx'))\n    if digest(source) != XLSX_HASH or digest(docx) != DOCX_HASH:\n        raise ValueError('來源 hash 改變，停止產生')\n    records = extract(source)\n    result = []\n    for r in records:\n        n = int(r['gcb_id'][-4:])\n        included = r['sheet'] != 'Nftables防火牆'\n        profile = ('firewalld' if r['sheet'] == 'Firewalld防火牆' else\n                   'sshd' if r['sheet'] == 'SSH伺服器' else 'base')\n        if n in IMPLEMENTED:\n            classification, why = 'native_sca', '候選唯讀原生命令；完整語意與引擎驗收待人工審查'\n        elif profile != 'base' or any(k in r['title'] for k in ('GUI', '無線', '可攜', 'NFS')):\n            classification, why = 'conditional', '須先確認角色、服務與適用性，再選擇實作方式'\n        elif any(k in r['title'] for k in ('權限', '所有權', '擁有', '稽核', '密碼', '通行碼')):\n            classification, why = 'readonly_helper', '可能涉及集合、位元或載入鏈解析；尚未實作 helper'\n        else:\n            classification, why = 'manual_review', '尚未逐條語意審查，保守列人工待辦，非不可自動化結論'\n        result.append(dict(gcb_id=r['gcb_id'], source_file=r['source_file'],\n            source_sheet=r['sheet'], source_row=r['row'], source_sha256=XLSX_HASH,\n            category=r['category'], title=r['title'], expected=r['expected'],\n            included=included, scope_reason='候選，仍須主機適用性核准' if included else '明確排除 Nftables 工作表',\n            sca_id=900000+n, profile=profile, proposed_classification=classification,\n            justification=why, review_status='human_review_pending',\n            implementation='candidate' if n in IMPLEMENTED else 'pending' if included else 'excluded',\n            policy_id='linuxgcb_rhel9_'+IMPLEMENTED[n]+'_v01' if n in IMPLEMENTED else None,\n            coverage='partial' if n in PARTIAL else 'full' if n in IMPLEMENTED else 'unimplemented',\n            live_validation='UNVALIDATED', execution_review='pending',\n            pending=PARTIAL.get(n, '' if n in IMPLEMENTED else '未實作；待逐條 DOCX 語意審查')))\n        if n in IMPLEMENTED:\n            result[-1].update(status(n))\n    if (len(result), sum(r['included'] for r in result), len({r['sca_id'] for r in result}),\n        len({r['gcb_id'] for r in result})) != (314, 307, 314, 314):\n        raise ValueError('範圍或唯一性不符')\n    return result\n\n\ndef write_registry():\n    rows = registry()\n    (ROOT/'data/scope_registry.json').write_text(json.dumps(rows, ensure_ascii=False, indent=2)+'\\n')\n    return rows\n\"\"\"Q1 離線審查結論；只涵蓋原有 53 ID，非來源或真機核准。\"\"\"\nfrom .batch1 import FILES, PACKAGES, SERVICES\nfrom .batch3 import ADDED as BATCH3, caveat as batch3_caveat\nfrom .batch2 import ADDED as BATCH2, caveat as batch2_caveat\n\nfrom .batch6 import ADDED as BATCH6, caveat as batch6_caveat\n\nABSENCE_PENDING = {30,94,97,98,245}\n\ndef findings(n):\n    issues = ['Q1-01']  # 非零但匹配 stdout，無已核准的原生執行狀態保護\n    if n in FILES or n in (45,46): issues += ['Q1-03','Q1-04']\n    if n in range(53,61) or n in (141,178,191,192): issues += ['Q1-05']\n    if n in SERVICES or n in (243,245): issues += ['Q1-06']\n    if n in ABSENCE_PENDING: issues += ['Q1-07']\n    if n in (108,141,269,270): issues += ['Q1-08']\n    return issues\n\ndef family(n):\n    if n in FILES or n in (45,46): return '檔案 metadata'\n    if n in PACKAGES: return 'RPM 存在'\n    if n in SERVICES or n in (243,245): return 'systemd 服務'\n    if n == 108: return 'sysctl 即時值'\n    return 'SSH 預設有效設定'\n\ndef status(n):\n    if n in BATCH6:\n        return dict(offline_review=\"completed_with_findings\", execution_review=\"blocked\",\n                    coverage=\"partial\", issue_ids=[\"B6-ENGINE\", \"B6-SCOPE\"],\n                    family=\"P2B6 embedded read-only\", source_approval=\"pending\",\n                    live_validation=\"UNVALIDATED\", pending=batch6_caveat(n))\n    if n in BATCH3:\n        return dict(offline_review='completed_with_findings', execution_review='blocked',\n                    coverage='partial', issue_ids=['B3-ENGINE', 'B3-SCOPE'],\n                    family='P2B3 embedded read-only', source_approval='pending',\n                    live_validation='UNVALIDATED', pending=batch3_caveat(n))\n    if n in BATCH2:\n        return dict(offline_review='completed_with_findings', execution_review='blocked',\n                    coverage='partial', issue_ids=['B2-ENGINE', 'B2-SCOPE'],\n                    family='BATCH2 guarded read-only', source_approval='pending',\n                    live_validation='UNVALIDATED', pending=batch2_caveat(n))\n    return dict(offline_review='completed_with_findings',\n                execution_review='blocked',\n                coverage='blocked' if n in ABSENCE_PENDING else 'partial',\n                issue_ids=findings(n), family=family(n),\n                source_approval='pending', live_validation='UNVALIDATED')\nTWGCB-01-012-0032 GPG簽章驗證 \n 編輯/etc/yum.conf與/etc/dnf/dnf.conf檔案，在「main」段落新增或修改成以下內容：\ngpgcheck=1\nlocalpkg_gpgcheck=1\n編輯/etc/yum.repos.d目錄下所有檔案，將全部之「gpgcheck」設定，修改成以下內容：\ngpgcheck=1\nlocalpkg_gpgcheck=1 \nEXPECTED 1 \n\nTWGCB-01-012-0034 設定sudo指令使用pty \n 開啟終端機，執行「visudo -f」指令編輯/etc/sudoers檔案或 /etc/sudoers.d/目錄下檔案，新增以下內容：\nDefaults use_pty \nEXPECTED Defaults use_pty \n\nTWGCB-01-012-0035 sudo自定義日誌檔案 \n 開啟終端機，執行「visudo -f」指令編輯/etc/sudoers檔案或 /etc/sudoers.d/目錄下檔案，新增以下內容：\nDefaults logfile=\"(日誌檔案路徑)\"\n日誌檔案路徑使用「/var/log/sudo.log」之範例如下：\nDefaults logfile=\"/var/log/sudo.log\" \nEXPECTED 啟用 \n\nTWGCB-01-012-0036 AIDE套件 \n 開啟終端機，執行以下指令安裝AIDE套件：\n#dnf install aide\n執行以下指令初始化AIDE：\n#aide --init\n#mv /var/lib/aide/aide.db.new.gz /var/lib/aide/aide.db.gz \nEXPECTED 安裝 \n\nTWGCB-01-012-0037 定期檢查檔案系統完整性 \n 開啟終端機，執行以下指令，編輯crontab：\n#crontab -u root -e\n在crontab新增以下內容，設定每天5點進行檔案系統完整性檢查：\n0 5 * * * /usr/sbin/aide --check \nEXPECTED 每天 \n\nTWGCB-01-012-0038 開機載入程式設定檔之所有權 \n 若是基於BIOS的系統，開啟終端機，執行以下指令，設定GRUB設定檔之擁有者與群組：\n#chown root:root /boot/grub2/grub.cfg\n#chown root:root /boot/grub2/grubenv\n#[ -f /boot/grub2/user.cfg ] && chown root:root /boot/grub2/user.cfg\n若是基於UEFI的系統，編輯/etc/fstab檔案，在掛載點為「/boot/efi」列，於第4欄加入「uid=0, and gid=0」，設定GRUB設定檔之擁有者與群組，範例如下：\n<device> /boot/efi vfat umask=0027,shortname=winnt, uid=0,gid=0 0 2 \nEXPECTED root:root \n\nTWGCB-01-012-0039 開機載入程式設定檔之權限 \n 若是基於BIOS的系統，開啟終端機，執行以下指令，設定GRUB設定檔之權限為600或更低權限：\n#chmod 600 /boot/grub2/grub.cfg\n#chmod 600 /boot/grub2/grubenv\n#[ -f /boot/grub2/user.cfg ] && chmod 600 /boot/grub2/user.cfg\n若是基於UEFI的系統，編輯/etc/fstab檔案，在掛載點為「/boot/efi」列，於第4欄加入「fmask=0177」，設定GRUB設定檔之權限，範例如下：\n<device> /boot/efi vfat umask=0027,shortname=winnt,fmask=0177 0 2 \nEXPECTED 600或更低權限 \n\nTWGCB-01-012-0040 開機載入程式之通行碼 \n 開啟終端機，執行以下指令，使用grub2-setpassword建立一組通行碼：\n#grub2-setpassword\nEnter password: (輸入通行碼)\nConfirm password: (再次輸入通行碼)\n執行以下指令更新grub2設定檔：\n#grub2-mkconfig -o \"$(dirname \"$(find /boot -type f \\( -name 'grubenv' -o -name 'grub.conf' -o -name 'grub.cfg' \\) -exec grep -Pl '^\\h*(kernelopts=|linux|kernel)' {} \\;)\")/grub.cfg\" \nEXPECTED 設定通行碼 \n\nTWGCB-01-012-0041 單一使用者模式身分鑑別 \n 編輯/usr/lib/systemd/system/rescue.service檔案，新增或修改成以下內容：\nExecStart=-/usr/lib/systemd/systemd-sulogin-shell rescue\n編輯/usr/lib/systemd/system/emergency.service檔案，新增或修改成以下內容：\nExecStart=-/usr/lib/systemd/systemd-sulogin-shell emergency \nEXPECTED 啟用 \n\nTWGCB-01-012-0042 核心傾印功能 \n 編輯/etc/security/limits.conf檔案或/etc/security/limits.d/目錄下檔案，新增以下內容：\n* hard core 0\n編輯/etc/sysctl.conf或/etc/sysctl.d/目錄下檔案，設定參數如下：\nfs.suid_dumpable = 0\nkernel.core_pattern = |/bin/false\n開啟終端機，執行以下指令，設定核心參數：\n#sysctl -w fs.suid_dumpable=0\n#sysctl -w kernel.core_pattern=|/bin/false\n如果已安裝coredump服務，編輯/etc/systemd/coredump.conf檔案，新增或修改成以下內容：\nStorage=none\nProcessSizeMax=0\n開啟終端機，執行以下指令重新載入systemd：\n#systemctl daemon-reload\n如果已安裝coredump服務，開啟終端機，執行以下指令，遮蔽coredump服務：\n#systemctl mask systemd-coredump.socket \nEXPECTED 停用 \n\nTWGCB-01-012-0043 記憶體位址空間配置隨機載入 \n 編輯/etc/sysctl.conf檔案或/etc/sysctl.d/目錄下檔案，設定參數如下：\nkernel.randomize_va_space = 2\n開啟終端機，執行以下指令，設定核心參數：\n#sysctl -w kernel.randomize_va_space=2 \nEXPECTED 2 \n\nTWGCB-01-012-0044 設定全系統加密原則 \n 開啟終端機，執行以下指令，確認全系統加密原則是否為FUTURE或FIPS：\n#grep -E -i '^\\s*(FUTURE|FIPS)\\s*(\\s+#.*)?$' /etc/crypto-policies/config\n若不是使用FUTURE或FIPS原則，請執行以下任一操作，變更全系統加密原則：\n執行以下指令，將系統設定為「FUTURE」原則：\n#update-crypto-policies --set FUTURE\n接續執行以下指令，以套用更新後之全系統加密原則：\n#update-crypto-policies\n執行以下指令，將系統設定為「FIPS」原則，並重新開機，以使生效：\n#fips-mode-setup --enable \nEXPECTED FUTURE或FIPS \n\nTWGCB-01-012-0061 其他使用者寫入具有全域寫入權限之檔案 \n 開啟終端機，執行以下指令，在系統上所有磁區(partition)，逐一檢查磁區所掛載之檔案目錄(如根目錄)，找出具有全域寫入權限(World-writable)之檔案：\n#find (partition) -xdev -type f -perm -0002\n針對所找到之檔案，執行下列指令，以移除其他身分寫入權限：\n#chmod o-w (檔案名稱) \nEXPECTED 禁止寫入 \n\nTWGCB-01-012-0062 檢查所有檔案與目錄之擁有者 \n 開啟終端機，執行以下指令，在系統上所有磁區(partition)，逐一檢查磁區所掛載之檔案目錄(如根目錄)，找出擁有者不是合法使用者之檔案或目錄：\n#find (partition) -xdev -nouser\n針對所找到之檔案與目錄指定合法使用者或移除：\n#chown (使用者) (檔案名稱或目錄名稱)\n或\n#rm (檔案名稱或目錄名稱) \nEXPECTED 所有檔案與目錄擁有者皆為合法使用者 \n\nTWGCB-01-012-0063 檢查所有檔案與目錄之擁有群組 \n 開啟終端機，執行以下指令，在系統上所有磁區(partition)，逐一檢查磁區所掛載之檔案目錄(如根目錄)，找出擁有群組不是合法群組之檔案或目錄：\n#find (partition) -xdev -nogroup\n針對所找到之檔案與目錄指定合法群組或移除：\n#chgrp (群組) (檔案名稱或目錄名稱)\n或\n#rm (檔案名稱或目錄名稱) \nEXPECTED 所有檔案與目錄擁有群組皆為合法群組 \n\nTWGCB-01-012-0064 所有具有全域寫入權限目錄之擁有者 \n 開啟終端機，執行以下指令，在系統上所有磁區(partition)，逐一檢查磁區所掛載之檔案目錄(如根目錄)，找出一般使用者(UID大於999)具有全域寫入(World-writable)權限之目錄\n#find (partition) -xdev -type d -perm -0002 -uid +999 -print\n針對所找到之目錄，執行以下指令，設定目錄擁有者為root或其他系統帳號\n#chown root (目錄名稱) \nEXPECTED root或其他系統帳號 \n\nTWGCB-01-012-0065 所有具有全域寫入權限目錄之擁有群組 \n 開啟終端機，執行以下指令，在系統上所有磁區(partition)，逐一檢查磁區所掛載之檔案目錄(如根目錄)，找出一般使用者群組(GID大於999)具有全域寫入(World-writable)權限之目錄\n#find (partition) -xdev -type d -perm -0002 -gid +999 -print\n針對所找到之目錄，執行以下指令，設定目錄擁有群組為root或其他系統群組(sys、bin或應用程式群組)：\n#chgrp root (目錄名稱) \nEXPECTED root或其他系統群組 \n\nTWGCB-01-012-0066 系統命令檔案權限 \n 開啟終端機，執行以下指令，檢查系統命令檔案之權限：\n#find -L /bin /sbin /usr/bin /usr/sbin /usr/local/bin /usr/local/sbin -perm /0022 -exec ls -l {} \\;\n若找到系統命令檔案權限高於755，執行以下指令，設定系統命令檔案之權限為755或更低權限：\n#chmod 755 (系統命令檔案名稱) \nEXPECTED 755或更低權限 \n\nTWGCB-01-012-0067 系統命令檔案擁有者 \n 開啟終端機，執行以下指令，檢查系統命令檔案擁有者：\n#find -L /bin /sbin /usr/bin /usr/sbin /usr/local/bin /usr/local/sbin ! -user root -exec ls -l {} \\;\n若找到系統命令檔案擁有者非root，執行以下指令，設定系統命令檔案擁有者為root：\n#chown root (系統命令檔案名稱) \nEXPECTED root \n\nTWGCB-01-012-0068 系統命令檔案擁有群組 \n 開啟終端機，執行以下指令，檢查系統命令檔案擁有群組：\n#find -L /bin /sbin /usr/bin /usr/sbin /usr/local/bin /usr/local/sbin ! -group root ! -group tty ! -group slocate ! -group lock -exec ls -l {} \\;\n若找到系統命令檔案擁有群組非root，執行以下指令，設定系統命令檔案擁有群組為root：\n#chgrp root (系統命令檔案名稱) \nEXPECTED root \n\nTWGCB-01-012-0069 程式庫檔案權限 \n 開啟終端機，執行以下指令，檢查程式庫檔案之權限：\n#find -L /lib /lib64 /usr/lib /usr/lib64 -perm /0022 -type f -exec ls -l {} \\;\n若找到程式庫檔案權限高於755，執行以下指令，設定程式庫檔案之權限為755或更低權限：\n#chmod 755 (程式庫檔案名稱) \nEXPECTED 755或更低權限 \n\nTWGCB-01-012-0070 程式庫檔案擁有者 \n 開啟終端機，執行以下指令，檢查程式庫檔案擁有者：\n#find -L /lib /lib64 /usr/lib /usr/lib64 ! -user root -exec ls -l {} \\;\n若找到程式庫檔案擁有者非root，執行以下指令，設定程式庫檔案擁有者為root：\n#chown root (程式庫檔案名稱) \nEXPECTED root \n\nTWGCB-01-012-0071 程式庫檔案擁有群組 \n 開啟終端機，執行以下指令，檢查程式庫檔案擁有群組：\n#find -L /lib /lib64 /usr/lib /usr/lib64 ! -group root -exec ls -l {} \\;\n若找到程式庫檔案擁有群組非root，執行以下指令，設定程式庫檔案擁有群組為root：\n#chgrp root (程式庫檔案名稱) \nEXPECTED root \n\nTWGCB-01-012-0072 帳號不使用空白通行碼 \n 開啟終端機，執行以下指令，列出使用空白通行碼之帳號：\n#awk -F: '($2 == \"\" ) { print $1 \" does not have a password \"}' /etc/shadow\n若有使用空白通行碼之帳號，則執行下列指令以設定通行碼：\n#passwd (帳號名稱)\n或執行下列指令以鎖定帳號：\n#passwd -l (帳號名稱) \nEXPECTED 帳號必須具有通行碼或被鎖定 \n\nTWGCB-01-012-0073 root帳號之路徑變數 \n 開啟終端機，執行以下指令，顯示PATH變數內容：\n#echo $PATH\n如出現「.」、「..」、路徑開頭不是「/」及空元素等內容，請編輯/etc/profile檔案進行修改 \nEXPECTED 不允許「.」、「..」、路徑開頭不是「/」及空元素 \n\nTWGCB-01-012-0074 root帳號之路徑變數不包含world-writable或group-writable目錄 \n 開啟終端機，執行以下指令，顯示PATH變數內容：\n#echo $PATH\n如出現具有world-writable權限或group-writable權限之目錄，請編輯/etc/profile檔案進行修改，或執行下列指令變更目錄權限：\n#chmod o-w (目錄名稱)\n或\n#chmod g-w (目錄名稱) \nEXPECTED 不包含world-writable或group-writable目錄 \n\nTWGCB-01-012-0075 /etc/passwd檔案行首之「+」符號 \n 開啟終端機，執行以下指令，確認/etc/passwd檔案行首是否存在「+」符號：\n#grep '^\\+:' /etc/passwd\n如果有，則編輯/etc/passwd檔案，將行首為「+」符號之列移除 \nEXPECTED 禁止 \n\nTWGCB-01-012-0076 /etc/shadow檔案行首之「+」符號 \n 開啟終端機，執行以下指令，確認/etc/shadow檔案行首是否存在「+」符號：\n#grep '^\\+:' /etc/shadow\n如果有，則編輯/etc/shadow檔案，將行首為「+」符號之列移除 \nEXPECTED 禁止 \n\nTWGCB-01-012-0077 /etc/group檔案行首之「+」符號 \n 開啟終端機，執行以下指令，確認/etc/group檔案行首是否存在「+」符號：\n#grep '^\\+:' /etc/group\n如果有，則編輯/etc/group檔案，將行首為「+」符號之列移除 \nEXPECTED 禁止 \n\nTWGCB-01-012-0078 UID=0之帳號 \n 開啟終端機，執行以下指令，列出UID=0之帳號：\n#awk -F: '($3 == 0) { print $1 }' /etc/passwd\n若存在非root帳號，則執行以下指令，移除帳號或重新設定UID：\n#userdel (帳號名稱)\n或\n#usermod -u (UID) (帳號名稱) \nEXPECTED 僅root帳號之UID為0 \n\nTWGCB-01-012-0079 使用者家目錄權限 \n 開啟終端機，執行以下腳本，檢查每個使用者家目錄權限：\n#!/bin/bash\ngrep -E -v '^(halt|sync|shutdown)' /etc/passwd | awk -F: '($7 != \"/sbin/nologin\" && $7 != \"/bin/false\") { print $1 \" \" $6 }' | while read user dir; do\n  if [ ! -d \"$dir\" ]; then\n    echo \"The home directory ($dir) of user $user does not exist.\"\n  else\n    dirperm=$(ls -ld $dir | cut -f1 -d\" \")\n    if [ $(echo $dirperm | cut -c5) != \"-\" ]; then\n      echo \"Group Read permission set on the home directory ($dir) of user $user\"\n    fi\n    if [ $(echo $dirperm | cut -c6) != \"-\" ]; then\n      echo \"Group Write permission set on the home directory ($dir) of user $user\"\n    fi\n    if [ $(echo $dirperm | cut -c7) != \"-\" ]; then\n      echo \"Group Execute permission set on the home directory ($dir) of user $user\"\n    fi\n    if [ $(echo $dirperm | cut -c8) != \"-\" ]; then\n      echo \"Other Read permission set on the home directory ($dir) of user $user\"\n    fi\n    if [ $(echo $dirperm | cut -c9) != \"-\" ]; then\n      echo \"Other Write permission set on the home directory ($dir) of user $user\"\n    fi\n    if [ $(echo $dirperm | cut -c10) != \"-\" ]; then\n      echo \"Other Execute permission set on the home directory ($dir) of user $user\"\n    fi\n  fi\ndone\n若出現群組具寫入權限，其他使用者具讀取、寫入及執行權限之家目錄，則可執行以下指令，變更目錄權限為700或更低權限：\n#chmod 700 /home/(使用者帳號名稱)\n注意：請先通知使用者再變更家目錄相關設定，以避免影響使用者作業 \nEXPECTED 700或更低權限 \n\nTWGCB-01-012-0080 使用者家目錄擁有者 \n 開啟終端機，執行以下腳本，檢查每個使用者家目錄擁有者：\n#!/bin/bash\ngrep -E -v '^(halt|sync|shutdown)' /etc/passwd | awk -F: '($7 != \"/sbin/nologin\" && $7 != \"/bin/false\") { print $1 \" \" $6 }' | while read user dir; do\n  if [ ! -d \"$dir\" ]; then\n    echo \"The home directory ($dir) of user $user does not exist.\"\n  else\n    owner=$(stat -L -c \"%U\" \"$dir\")\n    if [ \"$owner\" != \"$user\" ]; then\n  echo \"The home directory ($dir) of user $user is owned by $owner.\"\n  fi\nfi\ndone\n若出現使用者之家目錄非使用者擁有，則可執行以下指令，變更家目錄擁有者為使用者：\n#chown (使用者帳號名稱) /home/(使用者帳號名稱)\n注意：請先通知使用者再變更家目錄相關設定，以避免影響使用者作業 \nEXPECTED 使用者擁有 \n\nTWGCB-01-012-0081 使用者家目錄擁有群組 \n 開啟終端機，執行以下腳本，檢查每個使用者家目錄之擁有群組GID：\n#!/bin/bash\ngrep -E -v '^(halt|sync|shutdown)' /etc/passwd | awk -F: '($7 != \"/sbin/nologin\" && $7 != \"/bin/false\") { print $1 \" \" $4 \" \" $6 }' | while read user gid dir; do\n  if [ ! -d \"$dir\" ]; then\n    echo \"The home directory ($dir) of user $user does not exist.\"\n  else\n    owner=$(stat -L -c \"%g\" \"$dir\")\n    if [ \"$owner\" != \"$gid\" ]; then\n  echo \"The home directory ($dir) of group $gid is owned by group $owner.\"\n  fi\nfi\ndone\n若出現使用者家目錄非使用者群組所擁有，則可執行以下指令，變更家目錄擁有者為使用者群組：\n#chgrp (使用者群組名稱或GID) /home/(使用者帳號名稱)\n注意：請先通知使用者再變更家目錄相關設定，以避免影響使用者作業 \nEXPECTED 使用者群組擁有 \n\nTWGCB-01-012-0082 使用者家目錄之「.」檔案權限 \n 開啟終端機，執行以下腳本，檢查每個使用者家目錄之「.」檔案權限：\n#!/bin/bash\ngrep -E -v '^(halt|sync|shutdown)' /etc/passwd | awk -F: '($7 != \"/sbin/nologin\" && $7 != \"/bin/false\") { print $1 \" \" $6 }' | while read user dir; do\n  if [ ! -d \"$dir\" ]; then\n    echo \"The home directory ($dir) of user $user does not exist.\"\n  else\n    for file in $dir/.[A-Za-z0-9]*; do\n      if [ ! -h \"$file\" -a -f \"$file\" ]; then\n        fileperm=$(ls -ld $file | cut -f1 -d\" \")\n        if [ $(echo $fileperm | cut -c6) != \"-\" ]; then\n          echo \"Group Write permission set on file $file\"\n        fi\n        if [ $(echo $fileperm | cut -c9) != \"-\" ]; then\n          echo \"Other Write permission set on file $file\"\n        fi\n      fi\n    done\n  fi\ndone\n若出現具有world-writable或group-writable權限之「.」檔案，則可執行以下指令，移除群組與其他身分之寫入權限或更低權限：\n#chmod go-w (檔案名稱)\n注意：請先通知使用者再變更家目錄相關設定，以避免影響使用者作業 \nEXPECTED go-w或更低權限 \n\nTWGCB-01-012-0083 使用者家目錄之「.forward」檔案 \n 開啟終端機，執行以下腳本，檢查每個使用者家目錄是否存在「.forward」檔案：\n#!/bin/bash\ngrep -E -v '^(root|halt|sync|shutdown)' /etc/passwd | awk -F: '($7 != \"/sbin/nologin\" && $7 != \"/bin/false\") { print $1 \" \" $6 }' | while read user dir; do\n  if [ ! -d \"$dir\" ]; then\n    echo \"The home directory ($dir) of user $user does not exist.\"\n  else\n    if [ ! -h \"$dir/.forward\" -a -f \"$dir/.forward\" ]; then\n      echo \".forward file $dir/.forward exists\"\n    fi\n  fi\ndone\n若存在「.forward」檔案，則可執行以下指令移除檔案：\n#rm (檔案名稱)\n注意：請先通知使用者再變更家目錄相關設定，以避免影響使用者作業 \nEXPECTED 移除 \n\nTWGCB-01-012-0084 使用者家目錄之「.netrc」檔案 \n 開啟終端機，執行以下腳本，檢查每個使用者家目錄是否存在「.netrc」檔案：\n#!/bin/bash\ngrep -E -v '^(root|halt|sync|shutdown)' /etc/passwd | awk -F: '($7 != \"/sbin/nologin\" && $7 != \"/bin/false\") { print $1 \" \" $6 }' | while read user dir; do\n  if [ ! -d \"$dir\" ]; then\n    echo \"The home directory ($dir) of user $user does not exist.\"\n  else\n    if [ ! -h \"$dir/.netrc\" -a -f \"$dir/.netrc\" ]; then\n      echo \".netrc file $dir/.netrc exists\"\n    fi\n  fi\ndone\n若存在「.netrc」檔案，則可執行以下指令移除檔案：\n#rm (檔案名稱)\n注意：請先通知使用者再變更家目錄相關設定，以避免影響使用者作業 \nEXPECTED 移除 \n\nTWGCB-01-012-0085 使用者家目錄之「.rhosts」檔案 \n 開啟終端機，執行以下腳本，檢查每個使用者家目錄是否存在「.rhosts」檔案：\n#!/bin/bash\ngrep -E -v '^(root|halt|sync|shutdown)' /etc/passwd | awk -F: '($7 != \"/sbin/nologin\" && $7 != \"/bin/false\") { print $1 \" \" $6 }' | while read user dir; do\n  if [ ! -d \"$dir\" ]; then\n    echo \"The home directory ($dir) of user $user does not exist.\"\n  else\n    for file in $dir/.rhosts; do\n      if [ ! -h \"$file\" -a -f \"$file\" ]; then\n        echo \".rhosts file in $dir\"\n      fi\n    done\n  fi\ndone\n若存在「.rhosts」檔案，則可執行以下指令移除檔案：\n#rm (檔案名稱)\n注意：請先通知使用者再變更家目錄相關設定，以避免影響使用者作業 \nEXPECTED 移除 \n\nTWGCB-01-012-0086 檢查/etc/passwd檔案設定之群組 \n 開啟終端機，執行以下腳本，檢查/etc/passwd檔案中帳號之群組是否都存在於/etc/group檔案中：\n#!/bin/bash\nfor i in $(cut -s -d: -f4 /etc/passwd | sort -u ); do\n  grep -q -P \"^.*?:[^:]*:$i:\" /etc/group\n  if [ $? -ne 0 ]; then\n    echo \"Group $i is referenced by /etc/passwd but does not exist in /etc/group\"\n  fi\ndone\n若有帳號之群組不存在於/etc/group檔案中，則編輯/etc/passwd檔案，或執行以下指令，修改帳號之群組(GID)：\n#usermod -g (群組名稱或GID) (帳號名稱) \nEXPECTED /etc/passwd檔案中帳號之群組皆須存在於/etc/group檔案中 \n\nTWGCB-01-012-0087 唯一之UID \n 開啟終端機，執行以下腳本，尋找是否有不同帳號使用相同之UID：\n#!/bin/bash\ncut -f3 -d\":\" /etc/passwd | sort -n | uniq -c | while read x ; do\n  [ -z \"$x\" ] && break\n  set - $x\n  if [ $1 -gt 1 ]; then\n    users=$(awk -F: '($3 == n) { print $1 }' n=$2 /etc/passwd | xargs)\n    echo \"Duplicate UID ($2): $users\"\n  fi\ndone\n若有不同帳號使用相同之UID，則編輯/etc/passwd檔案，或執行以下指令，為帳號設定唯一之UID：\n#usermod -u (UID) (帳號名稱) \nEXPECTED 為每個帳號設定唯一之UID \n\nTWGCB-01-012-0088 唯一之GID \n 開啟終端機，執行以下腳本，尋找是否有群組使用相同之GID：\n#!/bin/bash\ncut -d: -f3 /etc/group | sort | uniq -d | while read x ; do\n  echo \"Duplicate GID ($x) in /etc/group\"\ndone\n若有不同群組使用相同GID，則編輯/etc/group檔案，或執行以下指令，為群組設定唯一之GID：\n#groupmod -g (GID) (群組名稱) \nEXPECTED 為每個群組設定唯一之GID \n\nTWGCB-01-012-0089 唯一之使用者帳號名稱 \n 開啟終端機，執行以下腳本，尋找是否有帳號使用重複之帳號名稱：\n#!/bin/bash\ncut -d: -f1 /etc/passwd | sort | uniq -d | while read x\ndo echo \"Duplicate login name ${x} in /etc/passwd\"\ndone\n若有帳號使用重複之帳號名稱，則編輯/etc/passwd檔案，為帳號設定唯一不重複之帳號名稱 \nEXPECTED 為每個使用者帳號設定唯一之名稱 \n\nTWGCB-01-012-0090 唯一之群組名稱 \n 開啟終端機，執行以下腳本，尋找是否有不同群組使用相同之群組名稱：\n#!/bin/bash\ncut -d: -f1 /etc/group | sort | uniq -d | while read x\ndo echo \"Duplicate group name ${x} in /etc/group\"\ndone\n若有群組使用相同之群組名稱，則編輯/etc/group檔案，為每個群組設定唯一之群組名稱 \nEXPECTED 為每個群組設定唯一之群組名稱 \n\nTWGCB-01-012-0091 shadow群組成員 \n 開啟終端機，執行以下指令，列舉shadow群組中之使用者帳號：\n#awk -F: '($1==\"shadow\") {print $NF}' /etc/group\n如shadow群組有使用者帳號，請針對每個帳號執行下列步驟：\n執行以下指令，從shadow群組移除使用者帳號：\n#sed -ri 's/(^shadow:[^:]*:[^:]*:)([^:]+$)/\\1/' /etc/group\n執行以下指令，將使用者帳號之主要群組，從shadow修改為預設群組：\n#usermod -g (預設群組名稱) (帳號名稱) \nEXPECTED shadow群組不包含任何使用者 \n\nTWGCB-01-012-0303 /etc/security/opasswd與 /etc/security/opasswd.old檔案所有權 \n 開啟終端機，執行以下指令，設定/etc/security/opasswd與/etc/security/opasswd.old檔案所有權：\n#chown root:root /etc/security/opasswd /etc/security/opasswd.old \nEXPECTED root:root \n\nTWGCB-01-012-0304 /etc/security/opasswd與 /etc/security/opasswd.old檔案權限 \n 開啟終端機，執行以下指令，設定/etc/security/opasswd與/etc/security/opasswd.old檔案權限為644或更低權限：\n#chmod 644 /etc/security/opasswd /etc/security/opasswd.old \nEXPECTED 644或更低權限 \n\nTWGCB-01-012-0305 /etc/shells中不應存在nologin \n 開啟終端機，執行以下指令，尋找/etc/shells中是否含有nologin：\n#grep -E '^[^#]*\\/nologin$' /etc/shells\n開啟終端機，執行vim指令在/etc/shells移除含有nologin的行，範例如下：\n#vim /etc/shells \nEXPECTED 移除含有nologin的行 \n\nTWGCB-01-012-0306 禁止chrony以root權限執行 \n 開啟終端機，執行vim指令，編輯/etc/sysconfig/chronyd，範例如下：\n#vim /etc/sysconfig/chronyd\n並在OPTIONS中移除「-u root」並加入以下內容：\nOPTIONS=\"-F 2\"\n開啟終端機，執行以下指令，重新啟動chrony，範例如下：\n#systemctl restart chronyd.service \nEXPECTED OPTIONS=\"-F 2\" \n\nTWGCB-01-012-0307 ptrace限制模式 \n 開啟終端機，執行vim指令，編輯/etc/sysctl.conf或/etc/sysctl.d目錄下檔案，新增或修改以下內容：\nkernel.yama.ptrace_scope=1\n開啟終端機，執行以下指令，設定核心參數：\n#sysctl -w kernel.yama.ptrace_scope=1 \nEXPECTED 啟用 \n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"agent_message","text":"來源與任務提示有幾處差異：0037 來源是 root crontab 每天執行 AIDE；0044 明列 `/etc/crypto-policies/config`；0038/0039 區分 BIOS 與 UEFI。`docs/references/` 目前只有 Wazuh 參考文件，我會沿用既有流程擷取根目錄 v1.2 DOCX/XLSX，逐條核對並在審查文件列出差異與待批解讀。"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"cat > linuxgcb/p2b7_runtime.py <<'PY'\n\\\"\\\"\\\"Read-only source predicates. ROOT is only for isolated offline tests.\\\"\\\"\\\"\nimport glob\nimport os\nimport re\nimport shlex\nimport stat\nimport subprocess\nROOT = ''\n\n\ndef path(p):\n    return ROOT + p\n\n\ndef read(p):\n    with open(path(p), encoding='utf-8') as f:\n        return f.read()\n\n\ndef files(pattern):\n    return sorted(p[len(ROOT):] if ROOT else p for p in glob.iglob(path(pattern)))\n\n\ndef lines(p):\n    return [s.split('#', 1)[0].strip() for s in read(p).splitlines() if s.split('#', 1)[0].strip()]\n\n\ndef values(paths, key):\n    out = []\n    for p in paths:\n        for s in lines(p):\n            m = re.fullmatch(re.escape(key) + r'\\\\s*=\\\\s*(.*?)\\\\s*', s)\n            if m:\n                out.append(m[1])\n    return out\n\n\ndef setting(paths, key, expected):\n    v = values(paths, key)\n    return bool(v) and all(x == expected for x in v)\n\n\ndef meta(p, mode=None, uid=None, gid=None):\n    s = os.stat(path(p))\n    return (mode is None or stat.S_IMODE(s.st_mode) & ~mode == 0) and (uid is None or s.st_uid == uid) and (gid is None or s.st_gid == gid)\n\n\ndef records(p, size):\n    rows = [s.split(':') for s in read(p).splitlines() if s]\n    if not rows or any(len(s) \"'!= size or not s[0] for s in rows):\n        raise ValueError('\"'invalid account database')\n    return rows\n\n\ndef scan_argv(n, mount=None):\n    commands = ['/bin','/sbin','/usr/bin','/usr/sbin','/usr/local/bin','/usr/local/sbin']\n    libraries = ['/lib','/lib64','/usr/lib','/usr/lib64']\n    roots = [mount] if n <= 65 else commands if n <= 68 else libraries\n    predicates = {\n        61:['-type','f','-perm','-0002'], 62:['-nouser'],63:['-nogroup'],\n        64:['-type','d','-perm','-0002','-uid','+999'],65:['-type','d','-perm','-0002','-gid','+999'],\n        66:['-perm','/0022'],67:['\"'!'\"','-user','root'],\n        68:['\"'!'\"','-group','root','\"'!'\"','-group','tty','\"'!'\"','-group','slocate','\"'!'\"','-group','lock'],\n        69:['-perm','/0022','-type','f'],70:['\"'!'\"','-user','root'],71:['\"'!'\"','-group','root']}\n    return ['/usr/bin/find'] + ([] if n <= 65 else ['-L']) + [path(p) for p in roots] + ['-xdev','(','-path',path('/proc'),'-o','-path',path('/sys'),'-o','-path',path('/dev'),'-o','-path',path('/run'),')','-prune','-o','('] + predicates[n] + [')','-print','-quit']\n\n\ndef scan(n):\n    # Source partitions are read from mountinfo; pseudo/network filesystems excluded.\n    if n <= 65:\n        local = {'ext2','ext3','ext4','xfs','btrfs','vfat','f2fs','jfs','reiserfs'}\n        roots = []\n        for s in read('/proc/self/mountinfo').splitlines():\n            left, right = s.split(' - ', 1)\n            if right.split()[0] in local:\n                mount = re.sub(r'\\\\\\\\([0-7]{3})', lambda m: chr(int(m[1],8)), left.split()[4])\n                if not any(mount == p or mount.startswith(p+'/') for p in ('/proc','/sys','/dev','/run')):\n                    roots.append(mount)\n        if not roots:\n            return False\n    else:\n        roots = [None]\n    for mount in dict.fromkeys(roots):\n        result = subprocess.run(scan_argv(n,mount), capture_output=True, text=True, timeout=24)\n        if result.returncode \"'!= 0 or result.stdout or result.stderr:\n            return False\n    return True\n\n\ndef root_path():\n    # Do not execute shell startup files. Expand only literal PATH assignments.\n    current = None\n    for p in ['\"'/etc/profile','/root/.bash_profile','/root/.bashrc']:\n        if not os.path.exists(path(p)):\n            continue\n        for s in lines(p):\n            m = re.fullmatch(r'(?:export\\\\s+)?PATH\\\\s*=\\\\s*(.*?)(?:;\\\\s*export\\\\s+PATH)?',s)\n            if not m:\n                continue\n            v = shlex.split(m[1])\n            if len(v) \"'!= 1:\n                raise ValueError('\"'ambiguous PATH')\n            v = v[0]\n            if '\"'$PATH'\"' in v or '\"'${PATH}'\"' in v:\n                if current is None:\n                    raise ValueError('unresolved PATH')\n                v = v.replace('\"'${PATH}'\"',current).replace('\"'$PATH'\"',current)\n            if any(c in v for c in '\"'$`;'\"\\\\\\\\'):\n                raise ValueError('dynamic PATH')\n            current = v\n    if current is None:\n        raise ValueError('missing PATH')\n    return current.split(':')\n\n\ndef check(n):\n    if n == 32:\n        for p in ['/etc/yum.conf','/etc/dnf/dnf.conf'] + files('/etc/yum.repos.d/*'):\n            section = None\n            seen = set()\n            for s in lines(p):\n                if s.startswith('[') and s.endswith(']'):\n                    section = s[1:-1]\n                for key in ('gpgcheck','localpkg_gpgcheck'):\n                    m = re.fullmatch(key+r'\\\\s*=\\\\s*(.*?)\\\\s*',s)\n                    if m and (p.startswith('/etc/yum.repos.d/') or section == 'main'):\n                        if int(m[1]) \"'!= 1:\n                            return False\n                        seen.add(key)\n            if seen != {'\"'gpgcheck','localpkg_gpgcheck'}:\n                return False\n        return True\n    if n in (34,35):\n        found = False\n        for p in ['/etc/sudoers'] + files('/etc/sudoers.d/*'):\n            for s in lines(p):\n                if not re.match(r'\"'^Defaults'\"\\\\s+',s):\n                    continue\n                for token in re.split(r',\\\\s*',re.sub(r'\"'^Defaults'\"\\\\s+','',s)):\n                    if n == 34 and token == '\"'!use_pty'\"':\n                        return False\n                    if n == 34 and token == 'use_pty':\n                        found = True\n                    if n == 35 and re.match(r'\"'^logfile'\"\\\\s*=',token):\n                        v = shlex.split(token.split('=',1)[1].strip())\n                        if len(v) \"'!= 1 or not v[0].startswith('\"'/'):\n                            return False\n                        found = True\n        return found\n    if n == 36:\n        r = subprocess.run(['/usr/bin/rpm','-q','aide'],capture_output=True,text=True,timeout=5)\n        if r.returncode not in (0,1):\n            raise ValueError('rpm error')\n        return r.returncode == 0 and bool(r.stdout.strip())\n    if n == 37:\n        # Root crontab is the actual source; daily directory is a task-requested alternative.\n        p = '/var/spool/cron/root'\n        if os.path.exists(path(p)) and any(re.fullmatch(r'\\\\d+\\\\s+\\\\d+\\\\s+\\\\*\\\\s+\\\\*\\\\s+\\\\*\\\\s+/usr/sbin/aide\\\\s+--check',s) for s in lines(p)):\n            return True\n        for p in files('/etc/cron.daily/*'):\n            if os.path.isfile(path(p)) and os.stat(path(p)).st_mode & 0o111:\n                if any(re.fullmatch(r'/usr/sbin/aide\\\\s+--check',s) for s in lines(p)):\n                    return True\n        return False\n    if n in (38,39):\n        efi = [s.split() for s in lines('/etc/fstab') if len(s.split()) >= 4 and s.split()[1] == '/boot/efi']\n        if efi:\n            opts = efi[-1][3].split(',')\n            return all(k in opts for k in ('uid=0','gid=0')) if n == 38 else 'fmask=0177' in opts\n        ps = ['/boot/grub2/grub.cfg','/boot/grub2/grubenv']\n        if os.path.exists(path('/boot/grub2/user.cfg')):\n            ps.append('/boot/grub2/user.cfg')\n        return all(meta(p,uid=0,gid=0) if n == 38 else meta(p,mode=0o600) for p in ps)\n    if n == 40:\n        return bool(values(['/boot/grub2/user.cfg'],'GRUB2_PASSWORD')) and all(re.fullmatch(r'grub\\\\.pbkdf2\\\\.sha512\\\\.[1-9][0-9]*\\\\.[0-9A-Fa-f]+\\\\.[0-9A-Fa-f]+',v) for v in values(['/boot/grub2/user.cfg'],'GRUB2_PASSWORD'))\n    if n == 41:\n        return all(setting(['/usr/lib/systemd/system/'+s+'.service'],'ExecStart','-/usr/lib/systemd/systemd-sulogin-shell '+s) for s in ('rescue','emergency'))\n    if n in (42,43,307):\n        ps = (['/etc/sysctl.conf'] if os.path.exists(path('/etc/sysctl.conf')) else []) + files('/etc/sysctl.d/*.conf')\n        key, val = {42:('fs.suid_dumpable',0),43:('kernel.randomize_va_space',2),307:('kernel.yama.ptrace_scope',1)}[n]\n        v = values(ps,key)\n        ok = bool(v) and all(int(x) == val for x in v)\n        if n \"'!= 42:\n            return ok\n        limits = (['\"'/etc/security/limits.conf'] if os.path.exists(path('/etc/security/limits.conf')) else []) + files('/etc/security/limits.d/*.conf')\n        core = [s.split() for p in limits for s in lines(p) if re.match(r'\"'^'\"\\\\*\\\\s+hard\\\\s+core\\\\s+',s)]\n        return ok and setting(ps,'kernel.core_pattern','|/bin/false') and bool(core) and all(len(s)==4 and int(s[3])==0 for s in core)\n    if n == 44:\n        v = lines('/etc/crypto-policies/config')\n        return bool(v) and all(s.upper() in ('FUTURE','FIPS') for s in v)\n    if 61 <= n <= 71:\n        return scan(n)\n    if n == 72:\n        return all(s[1] \"'!= '\"'' for s in records('/etc/shadow',9))\n    if n in (73,74):\n        ps = root_path()\n        if any(not p.startswith('/') or '..' in p.split('/') or p == '.' for p in ps):\n            return False\n        return True if n == 73 else all(os.path.isdir(path(p)) and meta(p,mode=0o7755) for p in ps)\n    if n in (75,76,77):\n        p = {75:'/etc/passwd',76:'/etc/shadow',77:'/etc/group'}[n]\n        return not any(s.startswith('+:') for s in read(p).splitlines())\n    if n == 78:\n        return [s[0] for s in records('/etc/passwd',7) if int(s[2]) == 0] == ['root']\n    if 79 <= n <= 85:\n        users = records('/etc/passwd',7)\n        for u in users:\n            excluded = r'\"'^(root|halt|sync|shutdown)'\"' if n >= 83 else r'\"'^(halt|sync|shutdown)'\"'\n            if re.match(excluded,u[0]) or u[6] in ('/sbin/nologin','/bin/false'):\n                continue\n            home = u[5]\n            if not home.startswith('/') or not os.path.isdir(path(home)):\n                return False\n            if n == 79 and not meta(home,mode=0o700): return False\n            if n == 80 and not meta(home,uid=int(u[2])): return False\n            if n == 81 and not meta(home,gid=int(u[3])): return False\n            if n == 82:\n                for p in files(home.rstrip('/')+'/.[A-Za-z0-9]*'):\n                    if not os.path.islink(path(p)) and os.path.isfile(path(p)) and os.stat(path(p)).st_mode & 0o022:\n                        return False\n            if n >= 83:\n                p = home.rstrip('/') + '/' + {83:'.forward',84:'.netrc',85:'.rhosts'}[n]\n                if not os.path.islink(path(p)) and os.path.isfile(path(p)):\n                    return False\n        return True\n    if n == 86:\n        groups = {int(s[2]) for s in records('/etc/group',4)}\n        return all(int(s[3]) in groups for s in records('/etc/passwd',7))\n    if n in (87,88,89,90):\n        p, size, col = {87:('/etc/passwd',7,2),88:('/etc/group',4,2),89:('/etc/passwd',7,0),90:('/etc/group',4,0)}[n]\n        v = [int(s[col]) if col == 2 else s[col] for s in records(p,size)]\n        return len(v) == len(set(v))\n    if n == 91:\n        groups = [s for s in records('/etc/group',4) if s[0] == 'shadow']\n        return len(groups)==1 and groups[0][3]=='' and all(int(s[3]) \"'!= int(groups[0][2]) for s in records('\"'/etc/passwd',7))\n    if n in (303,304):\n        return all(meta(p,uid=0,gid=0) if n == 303 else meta(p,mode=0o644) for p in ('/etc/security/opasswd','/etc/security/opasswd.old'))\n    if n == 305:\n        return not any(s.endswith('/nologin') for s in lines('/etc/shells'))\n    if n == 306:\n        v = values(['/etc/sysconfig/chronyd'],'OPTIONS')\n        if not v: return False\n        for s in v:\n            outer = shlex.split(s)\n            if len(outer) \"'!= 1: return False\n            args = shlex.split(outer[0])\n            if '\"'-u' in args and (args.index('-u')+1 == len(args) or args[args.index('-u')+1] == 'root'): return False\n            if not any(args[i:i+2] == ['-F','2'] for i in range(len(args))): return False\n        return True\n    raise ValueError('unknown candidate')\nPY\ncp linuxgcb/batch6.py /tmp/batch6-template.py\npython3 - <<'PY'\np='linuxgcb/batch7.py'\ns=open('/tmp/batch6-template.py').read().replace('P2B6','P2B7').replace('p2b6_runtime','p2b7_runtime')\ns=s[:s.index('def caveat(n):')]+'''def caveat(n):\n    return 'P2B7 UNVALIDATED；human_review_pending；execution_review=blocked；來源文字靜態唯讀子集，生效狀態/角色/覆寫需真機；缺失與錯誤無 PASS。'\n'''\ns=s.replace('set(range(206,242)) | set(range(309,315))','{32} | set(range(34,45)) | set(range(61,92)) | set(range(303,308))')\ns=s.replace('except (OSError, ValueError, IndexError, KeyError):','except (OSError, ValueError, IndexError, KeyError, subprocess.SubprocessError):')\nopen(p,'w').write(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

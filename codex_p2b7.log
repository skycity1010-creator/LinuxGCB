ertEqual(simulate(check, {target: dict(stdout=output)}), want)\n\n    def test_exact_three_rules_changed_and_protected_evidence(self):\n        before = json.loads((ROOT/'tests/fixtures/fix4_baseline.json').read_text())\n        old = {c['id']: c for c in before['checks']}\n        self.assertEqual(len(old), 146)\n        self.assertEqual(set(old), set(self.checks) - {900000+n for n in BATCH6})\n        self.assertEqual({n for n in old if old[n]['rules'] != self.checks[n]['rules']}, CHANGED | {900188})\n        for n in old.keys() - CHANGED - {900188}:\n            self.assertEqual(old[n], self.checks[n])\n        for name, sha in before['protected_hashes'].items():\n            self.assertEqual(digest(ROOT/name), sha, name)\n\n    def test_imuxsock_and_omfile_matrix(self):\n        module = 'module(load=\"imuxsock\" SysSock.Use=\"off\" FileCreateMode=\"0644\")\\n'\n        cases = [\n            (module + '$FileCreateMode 0640\\n', 'PASS'),\n      \"rules\": [\n        \"c:/usr/bin/systemctl show nftables.service --property=LoadState -> r:^LoadState=(loaded|masked|not-found)$\",\n        \"c:/usr/bin/systemctl show nftables.service --property=ActiveState -> r:^ActiveState=inactive$\",\n        \"c:/usr/bin/systemctl show nftables.service --property=LoadState --property=UnitFileState -> r:^(LoadState=not-found|UnitFileState=(disabled|masked))$\"\n      ]\n    }\n  ],\n  \"protected_hashes\": {\n    \"tests/fixtures/snapshot.json\": \"cee2a14363638662b4185f8066922e78202a86927eadf85c26b813ff417e29a6\",\n    \"tests/fixtures/rule_outputs.json\": \"57ec21e75500a5800a6e67c31e534674437a564c5aeb6dc929fa1230d65d522e\",\n    \"tests/fixtures/fix4_baseline.json\": \"d58df83ddb800b3460c672730a74ab645c6d4b770c0e2dbb721dbf1093e86025\",\n    \"tests/fixtures/batch2_baseline.json\": \"fa2cd9052fe71f2e826f10b032dac296d8d4e59058380d1594b62518bbe23499\",\n    \"tests/fixtures/fix3_baseline.json\": \"0066e4dd1c887508bf45e4b88dafe7d2065a1a63b5bf652204f81f6b638ee974\",\n    \"tests/fixt
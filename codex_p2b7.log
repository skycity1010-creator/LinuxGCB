elf):\n        self.assertEqual(validate(),len(definitions()))\n\n    def test_all_positive_negative_missing_error(self):\n        fixtures=json.loads((ROOT/'tests/fixtures/rule_outputs.json').read_text())\n        from scripts.batch2_fixtures import generated\n        fixtures['checks']['900188'] = generated()['900188']  # Preserve historical fixture on disk.\n        fixtures['checks'].update(json.loads((ROOT/'tests/fixtures/p2b3/cases.json').read_text())['checks'])\n        self.assertEqual(fixtures['label'],'SYNTHETIC TEST ONLY')\n        checked = set()\n        for p in (ROOT/'policies').glob('*.yml'):\n            for c in json.loads(p.read_text())['checks']:\n                if c['id']-900000 in BATCH6:\n                    continue  # P2B6 executes isolated input predicates in test_p2b6.py.\n                checked.add(str(c['id']))\n                for name, state in [('positive','PASS'),('negative','FAIL'),('missing','UNRESOLVED'),('empty','FAIL'),('error','UNRESOLVED'),('nonzero_matching','PASS')]:\n                    with self.subTest(id=c['id'],case=name):\n                        self.assertEqual(simulate(c,fixtures['checks'][str(c['id'])][name]), state)\n        self.assertEqual(checked,set(fixtures['checks']))\n\n    def test_permission_bit_subset_and_special_bits(self):\n        c=next(c for c in json.loads((ROOT/'policies/linuxgcb_base.yml').read_text())['checks'] if c['id']==900046)\n        target=c['rules'][0].split(' -> ')[0]\n        for mode in range(0o10000):\n            expected='PASS' if mode & ~0o644 == 0 else 'FAIL'\n            self.assertEqual(simulate(c,{target:dict(stdout=format(mode,'o'),exit_code=0)}),expected)\n\n    def test_exit_code_does_not_override_matching_output(self):\n        c=next(c for c in json.loads((ROOT/'policies/linuxgcb_base.yml').read_text())['checks'] if c['id']==900045)\n        target=c['rules'][0].split(' -> ')[0]\n        self.assertEqual(simulate(c,{target:dict(stdout='0:0',exit_code=1)}),'PASS')\n\n    def test_batch_manifest_reconciles_and_docx(self):\n        m=manifest();rows=registry()\n        self.assertEqual({e['sca_id'] for e in m['reviewed']},{900000+n for n in definitions()})\n        self.assertEqual(m['counts']['implemented'],len(definitions()))\n        self.assertEqual(m['counts']['remaining'],307-len(definitions()))\n        self.assertEqual(m['counts']['full']+m['counts']['partial']+m['counts']['blocked'],len(definitions()))\n        self.assertEqual((m['counts']['full'],m['counts']['partial'],m['counts']['blocked']),(0,48+len(BATCH2)+len(BATCH3)+len(BATCH6),5))\n        for e in m['reviewed']:\n            self.assertTrue(all(e['expected'] == c[-1] for c in e['docx_all_cells']))\n            self.assertTrue(all(e['gcb_id'] in c for c in e['docx_all_cells']))\n            n=e['sca_id']-900000\n            method=e['docx_cells'][-2]\n            if n in FILES:\n                self.assertIn(FILES[n][0],method)\n\n    def test_all_mode_masks_exhaustive(self):\n        from linuxgcb.batch1 import mode_pattern\n        import re\n        masks={v for _,kind,v in FILES.values() if kind=='mode'}\n        for mask in masks:\n            pattern=re.compile(mode_pattern(mask))\n            for value in range(0o10000):\n                self.assertEqual(bool(pattern.search(format(value,'o'))),value & ~mask == 0)\n\n    def test_batch_edges_use_emitted_rules(self):\n        import copy\n        checks={c['id']:c for p in (ROOT/'policies').glob('*.yml') for c in json.loads(p.read_text())['checks']}\n        fixtures=json.loads((ROOT/'tests/fixtures/rule_outputs.json').read_text())['checks']\n        for n in sorted(ADDED):\n            check=checks[900000+n];base=fixtures[str(900000+n)]['positive']\n            # 每個子規則必須獨立參與 all；非第一個錯誤亦不可被第一個 PASS 掩蓋。\n            for target in base:\n                obs=copy.deepcopy(base);obs[target]['stdout']='WRONG'\n                self.assertEqual(simulate(check,obs),'FAIL')\n                obs=copy.deepcopy(base);obs[target]['stdout']+='\\nWRONG'\n                self.assertEqual(simulate(check,obs),'PASS') # SCA 逐行存在匹配，不是整個輸出相等\n            if n in FILES:\n                path,kind,value=FILES[n]\n                if kind=='owner':\n                    target='c:/usr/bin/stat -c %U:%G '+path\n                    for owner in ('root:shadow','root:wheel','nobody:root','root:UNKNOWN'):\n                        obs=copy.deepcopy(base);obs[target]['stdout']=owner\n                        self.assertEqual(simulate(check,obs),'PASS' if owner=='root:shadow' and 'shadow' in value else 'FAIL')\n                type_target='c:/usr/bin/stat -c %f '+path\n                if type_target in base:\n                    for mode in ('81a4','a1ff','11a4','21a4','61a4','c1a4'):\n                        obs=copy.deepcopy(base);obs[type_target]['stdout']=mode\n                        self.assertEqual(simulate(check,obs),'FAIL')\n            from linuxgcb.batch1 import SERVICES,PACKAGES\n            if n in SERVICES:\n                target=next(t for t in base if 'UnitFileState' in t)\n                for value in ('enabled-runtime','static','alias','not-found'):\n                    obs=copy.deepcopy(base);obs[target]['stdout']='UnitFileState='+value\n                    self.assertEqual(simulate(check,obs),'FAIL')\n                obs=copy.deepcopy(base)\n                target=next(t for t in base if 'LoadState' in t);obs[target]['stdout']='LoadState=not-found'\n                self.assertEqual(simulate(check,obs),'PASS' if n in (30,94,97,98,101) else 'FAIL')\n            if n in PACKAGES:\n                obs=copy.deepcopy(base);target=next(iter(base));obs[target]['stdout']='package missing is not installed'\n                obs[target]['exit_code']=1\n                self.assertEqual(simulate(check,obs),'FAIL')\n\n    def test_documented_file_and_all_semantics(self):\n        check=dict(condition='all',rules=['f:/SYNTHETIC -> r:^ID=rhel$'])\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(exists=False)}),'NOT_APPLICABLE')\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(stdout='')}),'FAIL')\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(error='permission denied')}),'UNRESOLVED')\n        check['rules'].append('c:/SYNTHETIC -> r:^good$')\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(exists=False),'c:/SYNTHETIC':dict(stdout='bad')}),'FAIL')\n        self.assertEqual(simulate(check,{'f:/SYNTHETIC':dict(exists=False),'c:/SYNTHETIC':dict(stdout='good')}),'NOT_APPLICABLE')\n        self.assertEqual(simulate(check,{'c:/SYNTHETIC':dict(stdout='bad')}),'FAIL')\n\"\"\"FIX5: offline scope protection and synthetic rpm exit/output regression.\"\"\"\nimport json\nimport hashlib\nimport shlex\nimport subprocess\nimport unittest\n\nfrom linuxgcb.batch6 import ADDED as BATCH6\nfrom linuxgcb.argv import w_strtok\nfrom linuxgcb.catalog import ROOT, digest\nfrom linuxgcb.policy import parse_rule, simulate\n\n\nclass Fix5Tests(unittest.TestCase):\n    def test_only_900188_rules_changed_and_evidence_preserved(self):\n        before = json.loads((ROOT/'tests/fix5_baseline.json').read_text())\n        old = {c['id']: c for c in before['checks']}\n        current = {c['id']: c for p in (ROOT/'policies').glob('*.yml')\n                   for c in json.loads(p.read_text())['checks']}\n        self.assertEqual(len(current), 188)\n        current = {n:c for n,c in current.items() if n in old}\n        self.assertEqual(old.keys(), current.keys())\n        self.assertEqual({n for n in old if old[n]['rules'] != current[n]['rules']}, {900188})\n        for n in old:\n            actual = dict(current[n])\n            if n == 900188:\n                actual['rules'] = old[n]['rules']\n            self.assertEqual(actual, old[n])\n        for name, sha in before['protected_hashes'].items():\n            if name in ('data/scope_registry.json', 'data/coverage_manifest.json'):\n                original = subprocess.check_output(['git', 'show', 'HEAD:'+name], cwd=ROOT)\n                self.assertEqual(hashlib.sha256(original).hexdigest(), sha, name)\n                prior = json.loads(original)\n                now = json.loads((ROOT/name).read_text())\n                if name.endswith('scope_registry.json'):\n                    self.assertEqual([r for r in prior if r['sca_id']-900000 not in BATCH6],\n                                     [r for r in now if r['sca_id']-900000 not in BATCH6])\n                else:\n                    self.assertEqual(prior['reviewed'], [r for r in now['reviewed'] if r['sca_id']-900000 not in BATCH6])\n            else:\n                self.assertEqual(digest(ROOT/name), sha, name)\n        for p in (ROOT/'policies').glob('*.yml'):\n            self.assertIn('UNVALIDATED', json.loads(p.read_text())['policy']['name'])\n\n    def test_exact_tristate_argv_and_buffered_large_output(self):\n        check = next(c for c in json.loads((ROOT/'policies/linuxgcb_base.yml').read_text())['checks']\n                     if c['id'] == 900188)\n        body = ('out=$(rpm -q setroubleshoot 2>/dev/null); rc=$?; case $rc in '\n                if fail_read:\n                    with patch('builtins.open',side_effect=PermissionError('test-only denied')): exec(compile(program,'<test-only emitted script>','exec'),{})\n                else: exec(compile(program,'<test-only emitted script>','exec'),{})\n            return capture.getvalue()\n\n    def test_scope_baseline_sources_and_status(self):\n        before=json.loads((ROOT/'tests/fixtures/p2b3/baseline.json').read_text())\n        self.assertEqual(len(before['checks']),97)\n        for c in before['checks']:\n            actual = dict(self.checks[c['id']])\n            if c['id'] == 900188:  # FIX5 verifies its sole rule change separately.\n                actual['rules'] = c['rules']\n            self.assertEqual(actual, c)\n        for name,sha in before['protected_hashes'].items(): self.assertEqual(digest(ROOT/name),sha,name)\n        self.assertEqual(len(ADDED),49);self.assertEqual(len(self.checks),188);self.assertEqual(validate(),188)\n        rows=registry();self.assertEqual((len(rows),sum(r['included'] for r in rows)),(314,307))\n        self.assertEqual({r['sca_id'] for r in rows if r['implementation']=='candidate' and r['sca_id']-900000 not in BATCH6}-{c['id'] for c in before['checks']},{900000+n for n in ADDED})\n        for row in rows:\n            if row['sca_id']-900000 in ADDED:\n                self.assertEqual(row['review_status'],'human_review_pending')\n                self.assertEqual(row['execution_review'],'blocked');self.assertEqual(row['live_validation'],'UNVALIDATED')\n        manifest=json.loads((ROOT/'data/coverage_manifest.json').read_text())\n        self.assertEqual(manifest['counts']['implemented'],188)\n        for row in manifest['reviewed']:\n            if row['sca_id']-900000 in ADDED:\n                self.assertIn('tests/test_p2b3.py',row['tests'])\n                self.assertIn('UNVALIDATED',row['caveats'])\n\n    def test_all_49_fixture_output_matrix(self):\n        self.assertEqual(self.data['label'],'SYNTHETIC TEST ONLY')\n M data/coverage_manifest.json\n M data/policy_hashes.json\n M data/scope_registry.json\n M linuxgcb/catalog.py\n M linuxgcb/coverage.py\n M linuxgcb/policy.py\n M linuxgcb/quality.py\n M policies/linuxgcb_base.yml\n?? codex_p2b7.log\n?? linuxgcb/batch7.py\n?? linuxgcb/p2b7_runtime.py\n","exit_code":0,"status":"completed"}}
